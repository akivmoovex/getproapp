# Unified V7 production Hostinger template (blessboard.com + activeclinic.org).
# Set these in Hostinger (Website → Environment variables), not as a committed `.env`.
# When NODE_ENV=production, the app does not load repo-root `.env`.
#
# ActiveClinic and BlessBoard share ONE platform DB, identity, and session secret.
# Product selection is hostname-based under PLATFORM_DEPLOYMENT_CODE=moovex-platform-production.
# Do NOT invent separate product DATABASE_URL / DATABASE_IDENTITY values.
#
# Replace placeholders with real production values in Hostinger / gitignored `.env.production.local` only.
# Never reuse testing credentials. Never paste legacy BlessBoard V5 production URL here
# (retain that externally as ETL SOURCE only: blessboard-platform-v5 / production).
#
# Testing remains separate: moovex-platform-testing / moovex-platform-v7 / testing.
#
# Leave GETPRO_ALLOW_DB_FIXTURES* unset on real production.
# Prefer leaving BASE_DOMAIN / BLESSBOARD_* domain overrides unset so the deployment profile wins.

NODE_ENV=production
DEPLOYMENT_ENV=production
PLATFORM_DEPLOYMENT_CODE=moovex-platform-production
DATABASE_IDENTITY_EXPECTED=moovex-platform-v7
DATABASE_IDENTITY_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@NEW_V7_PRODUCTION_HOST.supabase.co:5432/postgres
SESSION_SECRET=replace-with-long-random-production-session-secret
GETPRO_PG_SSL=no-verify

# Optional listen / proxy (profile defaults usually suffice):
# PUBLIC_SCHEME=https
# PORT=3000
# HOST=0.0.0.0
# TRUST_PROXY=1

# Optional ActiveClinic transactional email (enable only after sender domain is verified):
# ACTIVECLINIC_EMAIL_DELIVERY_ADAPTER=resend
# RESEND_API_KEY=<production secret>
# ACTIVECLINIC_EMAIL_FROM=<verified sender>
# ACTIVECLINIC_EMAIL_FROM_NAME=ActiveClinic
# ACTIVECLINIC_EMAIL_REPLY_TO=<optional>

# Must remain unset on production:
# GETPRO_DATABASE_URL
# TEST_DATABASE_URL
# GETPRO_TEST_DB
# GETPRO_ALLOW_DB_FIXTURES
# GETPRO_ALLOW_DB_FIXTURES_OUTSIDE_TESTING
# GETPRO_ALLOW_DB_FIXTURES_IN_PRODUCTION
# ALLOW_DEMO_SEED_OUTSIDE_TESTING
# FOUNDATION_ALLOW_LOCALHOST
# DEBUG_HOST
# PHONE_VALIDATION_MODE
# BLESSBOARD_OTP_PROVIDER=test
# BLESSBOARD_OTP_EXPOSE_TEST_CODE
