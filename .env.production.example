# getproapp.org — real production only (not pronline.org).
# Set these in Hostinger (Website → Environment variables), not as a committed `.env`.
# When NODE_ENV=production, the app does not load repo-root `.env`. Optional disk fallbacks include
# /home/u549637099/getpro/.env.production for getproapp paths and /home/u549637099/pronline/.env.production for pronline (see bootstrap).
#
# Admin → DB seed/clear: leave GETPRO_ALLOW_DB_FIXTURES and GETPRO_ALLOW_DB_FIXTURES_IN_PRODUCTION **unset**
# (or not "1"). Real production stays blocked; use `.env.development.example` for pronline.org demo flags.

NODE_ENV=production
BASE_DOMAIN=getproapp.org
# BlessBoard apex (V4 blessboard.com defaults — keep for .com Hostinger app)
CHURCH_HOST_DOMAIN=blessboard.com
BLESSBOARD_CANONICAL_DOMAIN=blessboard.com
BLESSBOARD_PUBLIC_URL=https://blessboard.com
BLESSBOARD_ADMIN_URL=https://blessboard.com
BLESSBOARD_APEX_DOMAINS=blessboard.com,www.blessboard.com,blessboard.org,www.blessboard.org
SESSION_COOKIE_NAME=getpro_sid
DEPLOYMENT_ENV=production
# UPLOAD_ROOT=   # optional; defaults to <app>/data/uploads
# BLESSBOARD_JOBS_ENABLED=1
#
# For a separate BlessBoard.org (V5) Hostinger app — minimal permanent set:
# PLATFORM_DEPLOYMENT_CODE=blessboard-org-v5
# NODE_ENV=production
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/TESTING_DB?sslmode=require
# SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
# GETPRO_PG_SSL=no-verify   # optional
# Domains / DEPLOYMENT_ENV / cookie / jobs / TRUST_PROXY / HOST are derived from
# the blessboard-org-v5 deployment profile (see docs/deployment/V5_ENVIRONMENT_VARIABLE_REFERENCE.md).
# Do not set GETPRO_DATABASE_URL. ADMIN_PASSWORD is not required for V5 foundation.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
ADMIN_PASSWORD=REPLACE_ME
PUBLIC_SCHEME=https
PORT=3000
HOST=0.0.0.0
GETPRO_PG_SSL=no-verify
TRUST_PROXY=1

# Field agent IP rate limits (optional; per client IP incl. authed POSTs — shared NAT shares one cap; see docs/CONFIG_AND_DEPLOYMENT.md)
# GETPRO_LOGIN_RATE_WINDOW_MS=900000
# GETPRO_FIELD_AGENT_LOGIN_RATE_MAX=30
# GETPRO_FIELD_AGENT_AUTHED_POST_RATE_MAX=30

# Branding (getproapp.org — show GetPro lockup + indigo tokens)
GETPRO_PRODUCT_NAME=Pro-online
GETPRO_PRODUCT_NAME_GETPRO=GetPro
GETPRO_HTML_DATA_BRAND=getpro

# Never set these on getproapp.org (Admin → DB tools must stay off). See src/admin/dbFixturesEnv.js.
# GETPRO_ALLOW_DB_FIXTURES=1
# GETPRO_ALLOW_DB_FIXTURES_IN_PRODUCTION=1
