# Copy to repo-root .env.production.local (gitignored). Do not commit the copy.
# Used by: scripts/local/run-with-blessboard-env.sh production …
#
# Same shape as scripts/local/env.testing.local.example — only env codes + secrets differ.
# Shared platform DB for BlessBoard + ActiveClinic; product = hostname under this deployment.
#
# moovex-platform-v7 = current schema-generation / platform identity key (NOT "cloned from V7").
# Empty production DB: migrate → identity-init --env production --identity-key moovex-platform-v7.
#
# Legacy blessboard-platform-v5 is ETL SOURCE only (keep externally). Never use as runtime target.

NODE_ENV=production
DEPLOYMENT_ENV=production
PLATFORM_DEPLOYMENT_CODE=moovex-platform-production
DATABASE_IDENTITY_EXPECTED=moovex-platform-v7
DATABASE_IDENTITY_ENV=production
GETPRO_PG_SSL=no-verify

# NEW empty production Session Pooler URL (*.pooler.supabase.com:5432) — not testing, not V5.
DATABASE_URL='postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres'

# Required for Hostinger runtime; optional for DB bootstrap CLIs.
# SESSION_SECRET=

# Must remain unset:
# GETPRO_DATABASE_URL
# ACTIVECLINIC_DATABASE_URL
# BLESSBOARD_DATABASE_URL
# ALLOW_DEMO_SEED_OUTSIDE_TESTING
# GETPRO_ALLOW_DB_FIXTURES*
# FOUNDATION_ALLOW_LOCALHOST
# PHONE_VALIDATION_MODE
# DEBUG_HOST
