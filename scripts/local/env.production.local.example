# Copy to repo-root .env.production.local (gitignored). Do not commit the copy.
# Used by: scripts/local/run-with-blessboard-env.sh production …
#
# DATABASE_URL = blessboard.com production Supabase connection string
# Never reuse the testing URL here.

DATABASE_URL='postgresql://USER:PASSWORD@HOST:5432/postgres'
DATABASE_IDENTITY_EXPECTED='blessboard-platform-v5'
DATABASE_IDENTITY_ENV='production'
PLATFORM_DEPLOYMENT_CODE='blessboard-com-production'
GETPRO_PG_SSL='no-verify'
