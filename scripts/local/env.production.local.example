# Copy to repo-root .env.production.local (gitignored). Do not commit the copy.
# Used by: scripts/local/run-with-blessboard-env.sh production …
#
# Unified V7 production platform DB — shared by BlessBoard + ActiveClinic.
# Product selection is hostname-based under PLATFORM_DEPLOYMENT_CODE=moovex-platform-production.
# Never reuse testing DATABASE_URL or the legacy BlessBoard V5 production URL here.
#
# Operator must retain the legacy V5 production DATABASE_URL externally
# (identity blessboard-platform-v5 / production) for possible future ETL SOURCE only.

NODE_ENV=production
DEPLOYMENT_ENV=production
PLATFORM_DEPLOYMENT_CODE=moovex-platform-production
DATABASE_IDENTITY_EXPECTED=moovex-platform-v7
DATABASE_IDENTITY_ENV=production
GETPRO_PG_SSL=no-verify

# Replace with the NEW empty V7 production Supabase connection string.
# Do NOT paste the legacy blessboard-platform-v5 / aw*** production URL.
DATABASE_URL='postgresql://USER:PASSWORD@NEW_V7_PRODUCTION_HOST.supabase.co:5432/postgres'

# Required for Hostinger runtime; optional for DB bootstrap CLIs.
# SESSION_SECRET must be a new production secret — never reuse testing.
# SESSION_SECRET=

# Must remain unset:
# GETPRO_DATABASE_URL
# ALLOW_DEMO_SEED_OUTSIDE_TESTING
# GETPRO_ALLOW_DB_FIXTURES
# GETPRO_ALLOW_DB_FIXTURES_OUTSIDE_TESTING
# GETPRO_ALLOW_DB_FIXTURES_IN_PRODUCTION
# FOUNDATION_ALLOW_LOCALHOST
# PHONE_VALIDATION_MODE
# DEBUG_HOST
