# Isolated production-like rehearsal DB (local only). Never commit the copy.
# Used by: scripts/local/run-with-blessboard-env.sh rehearsal …

DATABASE_URL='postgresql://USER@127.0.0.1:5432/getpro_v7_prod_rehearsal'
DATABASE_IDENTITY_EXPECTED='blessboard-platform-v5'
DATABASE_IDENTITY_ENV='production'
PLATFORM_DEPLOYMENT_CODE='blessboard-com-production'
DEPLOYMENT_ENV='production'
NODE_ENV='production'
SESSION_SECRET='replace-with-local-rehearsal-secret-32chars-min'
GETPRO_PG_SSL='off'
