# Copy to repo-root .env.testing.local (gitignored). Do not commit the copy.
# Used by: scripts/local/run-with-blessboard-env.sh testing …
#
# Shared testing platform DB (blessboard.pronline.org + activeclinic.pronline.org).
# Product selection = hostname under PLATFORM_DEPLOYMENT_CODE=moovex-platform-testing.
# DATABASE_IDENTITY_EXPECTED=moovex-platform-v7 is the current platform identity key
# (same key as production; DATABASE_IDENTITY_ENV distinguishes testing vs production DBs).

DATABASE_URL='postgresql://USER:PASSWORD@HOST:5432/postgres'
DATABASE_IDENTITY_EXPECTED='moovex-platform-v7'
DATABASE_IDENTITY_ENV='testing'
PLATFORM_DEPLOYMENT_CODE='moovex-platform-testing'
DEPLOYMENT_ENV='testing'
GETPRO_PG_SSL='no-verify'

# Public website media (Hostinger CDN). Absolute https base required for CDN presentation.
MEDIA_STORAGE_ROOT='/home/u549637099/moovex-media'
MEDIA_PUBLIC_BASE_URL='https://blessboard.pronline.org/media'
MEDIA_PUBLIC_MOUNT_PATH='/media'
