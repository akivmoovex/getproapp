# Copy to repo-root .env.testing.local (gitignored). Do not commit the copy.
# Used by: scripts/local/run-with-blessboard-env.sh testing …
#
# DATABASE_URL = blessboard.org testing Supabase connection string

DATABASE_URL='postgresql://USER:PASSWORD@HOST:5432/postgres'
DATABASE_IDENTITY_EXPECTED='moovex-platform-v7'
DATABASE_IDENTITY_ENV='testing'
PLATFORM_DEPLOYMENT_CODE='moovex-platform-testing'
GETPRO_PG_SSL='no-verify'
