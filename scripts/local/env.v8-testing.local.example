# Copy to repo-root .env.v8-testing.local (gitignored). Do not commit the copy.
# Local simulation of Hostinger V8 testing — never use for production.
#
# Shares the same PostgreSQL identity as V7 testing:
#   DATABASE_IDENTITY_EXPECTED=moovex-platform-v7
#   DATABASE_IDENTITY_ENV=testing
# Product selection = hostname under PLATFORM_DEPLOYMENT_CODE=moovex-platform-v8-testing.

DATABASE_URL='postgresql://USER:PASSWORD@HOST:5432/postgres'
DATABASE_IDENTITY_EXPECTED='moovex-platform-v7'
DATABASE_IDENTITY_ENV='testing'
PLATFORM_DEPLOYMENT_CODE='moovex-platform-v8-testing'
DEPLOYMENT_ENV='testing'
NODE_ENV='production'
SESSION_SECRET='replace-with-distinct-long-random-v8-secret'
GETPRO_PG_SSL='no-verify'

# Public website media (Hostinger CDN). Prefer absolute https base for presentation.
MEDIA_STORAGE_ROOT='/home/ACCOUNT/moovex-media'
MEDIA_PUBLIC_BASE_URL='https://blessboard.neuniversity.org/media'
MEDIA_PUBLIC_MOUNT_PATH='/media'
