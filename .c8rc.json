{
  "reporter": ["text", "text-summary", "json", "json-summary", "lcov"],
  "exclude-node-modules": true,
  "check-coverage": false,
  "exclude": [
    "node_modules/**",
    "tests/**",
    "coverage/**",
    "docs/**",
    "db/migrations/**",
    "db/seeds/**",
    "db/scripts/**",
    "db/postgres/**",
    "**/*.sql",
    "scripts/**",
    "storybook-static/**",
    "storybook/**",
    "public/build/**",
    "public/uploads/**",
    "public/images/**",
    "public/fonts/**",
    "public/data/**",
    "**/*.{png,jpg,jpeg,gif,webp,svg,ico,woff,woff2,ttf,otf,eot,map}",
    "**/__screenshots__/**",
    "test-results/**",
    "playwright-report/**",
    ".cursor/**",
    ".github/**",
    "fixtures/**",
    "**/vendor/**",
    "**/node_modules/**",
    "playwright*.cjs",
    "vite.config.*",
    "**/*.config.cjs",
    "**/*.md",
    "**/*.mdc",
    "**/*.json",
    "**/*.html",
    "**/*.css",
    "**/*.ejs"
  ]
}
