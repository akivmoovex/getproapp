<article class="ac-public-section ac-doctor-profile" data-ac-page-section="tenant-doctor-profile">
  <div class="ac-doctor-profile__layout">
    <div class="ac-doctor-profile__media<%= profile.photoIsFallback ? ' ac-doctor-profile__media--fallback' : '' %>"<%= profile.photoIsFallback ? ' data-ac-asset-gap="doctor-photo"' : '' %>>
      <%- include('../partials/ac-media', {
        src: profile.photoUrl || (typeof doctorFallbackUrl === 'string' ? doctorFallbackUrl : '/activeclinic/assets/doctors/doctor-fallback.svg'),
        alt: profile.photoIsFallback ? '' : ('Portrait of ' + (profile.displayName || 'clinician')),
        decorative: Boolean(profile.photoIsFallback),
        className: 'ac-doctor-profile__photo',
        objectFit: 'cover',
        objectPosition: profile.photoObjectPosition || 'center 18%',
        aspect: '4 / 5',
        width: 640,
        height: 800,
        loading: 'eager',
        fallbackSrc: typeof doctorFallbackUrl === 'string' ? doctorFallbackUrl : '/activeclinic/assets/doctors/doctor-fallback.svg',
      }) %>
    </div>
    <div class="ac-doctor-profile__copy">
      <h1><%= profile.displayName %></h1>
      <% if (clinic && clinic.isDemonstrationClinic) { %>
      <p class="ac-public-banner" data-ac-sample-profile="1">Sample profile for demonstration only</p>
      <% } %>
      <% if (profile.title) { %><p class="ac-doctor-profile__title"><%= profile.title %></p><% } %>
      <% if (profile.bio) { %><p class="ac-doctor-profile__bio"><%= profile.bio %></p><% } %>
      <% if (clinic.publicBookingEnabled) { %>
      <p><a class="ac-btn ac-btn--primary" href="/clinics/<%= clinic.clinicKey %>/book?doctor=<%= profile.staffKey %>">Request appointment</a></p>
      <% } %>
    </div>
  </div>
</article>
