<section class="ac-public-section acp-page" data-ac-page-section="tenant-contact">
  <header class="acp-page-hero acp-page-hero--compact">
    <p class="ac-public-eyebrow"><%- include('../partials/website-editable-field', { contentKey: 'contact.eyebrow', fieldValue: clinic.contactEyebrow || 'Contact', fieldType: 'short_text' }) %></p>
    <h1><%- include('../partials/website-editable-field', { contentKey: 'contact.page_title', fieldValue: clinic.contactPageTitle || ('Contact ' + clinic.publicName), fieldType: 'short_text' }) %></h1>
    <p class="ac-public-lede"><%- include('../partials/website-editable-field', { contentKey: 'contact.intro', fieldValue: clinic.contactIntro || 'Send a message to the clinic. Staff review inquiries during business hours — this form does not send SMS or email confirmation.', fieldType: 'long_text' }) %></p>
  </header>

  <div class="acp-contact-layout">
    <div class="acp-contact-layout__main">
      <% if (typeof error === 'string' && error) { %><div class="ac-public-error" role="alert"><%= error %></div><% } %>
      <% const fd = formData || {}; %>
      <form method="post" action="/clinics/<%= clinic.clinicKey %>/contact" class="ac-public-form acp-contact-form" data-ac-loading="1">
        <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
        <div class="acp-field">
          <label for="senderName">Your name</label>
          <input id="senderName" name="senderName" required value="<%= fd.senderName || '' %>"/>
        </div>
        <div class="acp-field">
          <label for="senderEmail">Email</label>
          <input id="senderEmail" name="senderEmail" type="email" required value="<%= fd.senderEmail || '' %>"/>
        </div>
        <%- include('../partials/phone-field', {
          id: 'senderPhone',
          label: 'Phone (optional)',
          required: false,
          defaultCountry: (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || (clinic && clinic.countryCode) || 'ZM',
          selectedCountry: (fd && fd.phoneCountry) || (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || (clinic && clinic.countryCode) || 'ZM',
          nationalValue: (fd && fd.phoneNational) || '',
          e164Value: (fd && fd.senderPhone) || '',
          countries: (typeof phoneCountries !== 'undefined' && phoneCountries) || [],
          phoneValidationRelaxed: typeof phoneValidationRelaxed !== 'undefined' && phoneValidationRelaxed,
          countryFieldName: 'phone_country',
          nationalFieldName: 'phone_national',
          legacyFieldName: 'senderPhone',
          showLegacyHidden: true
        }) %>
        <div class="acp-field">
          <label for="message">Message</label>
          <textarea id="message" name="message" required maxlength="4000"><%= fd.message || '' %></textarea>
        </div>
        <button type="submit" class="ac-btn ac-btn--primary">Send message</button>
      </form>
      <p class="ac-public-note">Submitting stores your inquiry for the clinic. This form does not send SMS or email confirmation.</p>
    </div>
    <aside class="acp-contact-aside">
      <h2><%- include('../partials/website-editable-field', { contentKey: 'contact.aside_heading', fieldValue: clinic.contactAsideHeading || 'Clinic contact', fieldType: 'short_text' }) %></h2>
      <% const overlayPhone = clinic.websiteContent && clinic.websiteContent['contact.phone'] ? clinic.websiteContent['contact.phone'] : ''; %>
      <% const overlayEmail = clinic.websiteContent && clinic.websiteContent['contact.email'] ? clinic.websiteContent['contact.email'] : ''; %>
      <% const livePhone = clinic.publicPhoneDisplay || overlayPhone; %>
      <% const liveEmail = clinic.publicEmailDisplay || overlayEmail; %>
      <% if (typeof websiteEdit !== 'undefined' && websiteEdit) { %>
      <div class="ac-website-overlay-edit" data-ac-website-overlay="contact">
        <h3>Website contact overlay</h3>
        <p class="ac-website-overlay-note">Used on the public site when operations phone or email is not published. Saving here does not change clinic operations records, and does not publish.</p>
        <ul class="ac-public-list">
          <li>Phone: <%- include('../partials/website-editable-field', { contentKey: 'contact.phone', fieldValue: overlayPhone, fieldType: 'phone' }) %></li>
          <li>Email: <%- include('../partials/website-editable-field', { contentKey: 'contact.email', fieldValue: overlayEmail, fieldType: 'email' }) %></li>
        </ul>
        <% if (clinic.publicPhoneDisplay || clinic.publicEmailDisplay) { %>
        <p class="ac-public-muted">Public listing currently uses operations contact details.</p>
        <% } %>
        <%- include('../partials/website-operational-affordance', { href: '/app/settings/organization', label: 'Manage clinic contact details', manageKind: 'contact' }) %>
      </div>
      <% } else if (livePhone || liveEmail) { %>
      <ul class="ac-public-list">
        <% if (livePhone) { %><li>Phone: <%= livePhone %></li><% } %>
        <% if (liveEmail) { %><li>Email: <%= liveEmail %></li><% } %>
      </ul>
      <% } else { %>
      <p class="ac-public-muted">Public phone and email are not published. Use this form to reach the clinic.</p>
      <% } %>
      <p class="ac-public-actions">
        <a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinic.clinicKey %>/location">Location &amp; hours</a>
      </p>
    </aside>
  </div>
</section>
