<section class="ac-public-section acp-page" data-ac-page-section="tenant-location">
  <header class="acp-page-hero acp-page-hero--compact">
    <p class="ac-public-eyebrow"><%- include('../partials/website-editable-field', { contentKey: 'location.eyebrow', fieldValue: clinic.locationEyebrow || 'Visit us', fieldType: 'short_text' }) %></p>
    <h1><%- include('../partials/website-editable-field', { contentKey: 'location.page_title', fieldValue: clinic.locationPageTitle || 'Location & hours', fieldType: 'short_text' }) %></h1>
    <p class="ac-public-lede"><%- include('../partials/website-editable-field', { contentKey: 'location.intro', fieldValue: clinic.locationIntro || ('Published facility addresses and hours for ' + clinic.publicName + '.'), fieldType: 'long_text' }) %></p>
  </header>
  <% const facilityList = Array.isArray(clinic.facilities) ? clinic.facilities : []; %>
  <% const locationEditing = typeof websiteEdit !== 'undefined' && websiteEdit; %>
  <% const directionsNote = (clinic.locationDirectionsNote || clinic.locationAddressOverlay || '').trim(); %>
  <% if (!facilityList.length) { %>
  <div class="ac-public-empty acp-empty-state" data-ac-location-state="empty">
    <% if (!locationEditing) { %>
    <p>Location details have not been published for this clinic yet.</p>
    <% if (directionsNote) { %>
    <div class="ac-location-note" data-ac-location-note="1">
      <h2 class="ac-location-note__label">Directions</h2>
      <p class="ac-location-note__body"><%= directionsNote %></p>
    </div>
    <% } %>
    <% if (clinic.locationHoursOverlay) { %>
    <div class="ac-location-card acp-location-card" data-ac-template-placeholder="1">
      <p class="ac-template-placeholder">Example hours — replace with published facility hours.</p>
      <pre class="ac-location-hours-overlay"><%= clinic.locationHoursOverlay %></pre>
    </div>
    <% } %>
    <% } %>
    <p><a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinic.clinicKey %>/contact">Contact clinic</a></p>
  </div>
  <% } else { %>
  <ul class="ac-location-list acp-location-grid">
    <% facilityList.forEach(function(f) { %>
    <li class="ac-location-card acp-location-card" data-ac-facility="<%= f.facilityKey %>">
      <h2><%= f.displayName %><% if (f.isPrimary) { %> <span class="ac-location-badge">Primary</span><% } %></h2>
      <% const addressParts = [f.addressLine1, f.addressLine2, f.city, f.district, f.province, f.postalCode].filter(Boolean); %>
      <% if (addressParts.length) { %>
      <p class="ac-location-address" data-ac-facility-address="1"><%= addressParts.join(', ') %></p>
      <% } else { %>
      <p class="ac-public-muted" data-ac-facility-address-missing="1">Address not configured.</p>
      <% } %>
      <% if (f.phoneDisplay) { %><p>Phone: <%= f.phoneDisplay %></p><% } %>
      <% if (f.emailDisplay) { %><p>Email: <%= f.emailDisplay %></p><% } %>
      <% const hasFacilityHours = f.publicHours && typeof f.publicHours === 'object' && Object.keys(f.publicHours).length; %>
      <% if (hasFacilityHours) { %>
      <div class="ac-location-hours">
        <h3>Hours</h3>
        <dl class="ac-hours-list">
          <% Object.keys(f.publicHours).forEach(function(day) { %>
          <dt><%= day %></dt>
          <dd><%= f.publicHours[day] %></dd>
          <% }) %>
        </dl>
      </div>
      <% } else if (clinic.locationHoursOverlay && !locationEditing) { %>
      <div class="ac-location-hours ac-location-hours--template" data-ac-template-placeholder="1">
        <p class="ac-template-placeholder">Example hours — not published operating times for this facility.</p>
        <h3>Hours</h3>
        <div class="ac-location-hours-overlay"><%= clinic.locationHoursOverlay %></div>
      </div>
      <% } %>
    </li>
    <% }) %>
  </ul>
  <% if (!locationEditing && directionsNote) { %>
  <div class="ac-location-note" data-ac-location-note="1">
    <h2 class="ac-location-note__label">Directions</h2>
    <p class="ac-location-note__body"><%= directionsNote %></p>
  </div>
  <% } %>
  <% } %>
  <% if (locationEditing) { %>
  <div class="ac-website-overlay-edit" data-ac-website-overlay="location">
    <h2>Landmark / Directions</h2>
    <p class="ac-website-overlay-note">Optional public location note (landmark or directions). Facility address from Operations stays authoritative and is always shown when published. This field does not replace or hide the facility address. Saving here does not change operations records, and does not publish.</p>
    <p class="ac-location-note__body"><%- include('../partials/website-editable-field', { contentKey: 'location.address', fieldLabel: 'Landmark / Directions', fieldValue: clinic.locationAddressOverlay || '', fieldType: 'long_text' }) %></p>
    <h3>Hours note</h3>
    <p class="ac-website-overlay-note">Shown only when a facility has no published hours.</p>
    <div class="ac-location-hours-overlay"><%- include('../partials/website-editable-field', { contentKey: 'location.hours', fieldLabel: 'Hours note', fieldValue: clinic.locationHoursOverlay || '', fieldType: 'long_text' }) %></div>
    <%- include('../partials/website-operational-affordance', { href: '/app/facilities', label: 'Manage facility address &amp; hours', manageKind: 'location' }) %>
  </div>
  <% } %>
  <%- include('../partials/website-library-placements', { libraryPageId: 'tpl_location', librarySkipTypes: [] }) %>
</section>
