<article class="acp-page" data-ac-page-section="tenant-about">
  <header class="acp-page-hero acp-page-hero--compact">
    <p class="ac-public-eyebrow"><%- include('../partials/website-editable-field', { contentKey: 'about.eyebrow', fieldValue: clinic.aboutEyebrow || 'About', fieldType: 'short_text' }) %></p>
    <h1><%- include('../partials/website-editable-field', { contentKey: 'about.story.heading', fieldValue: clinic.aboutHeading || ('About ' + clinic.publicName), fieldType: 'short_text' }) %></h1>
    <% if (clinic.websiteTagline) { %><p class="ac-public-lede"><%= clinic.websiteTagline %></p><% } %>
  </header>
  <% const aboutBody = clinic.aboutBody || clinic.websiteAbout; %>
  <% const aboutImageSrc = clinic.aboutStoryImageSrc || ''; %>
  <% if (aboutImageSrc || (typeof websiteEdit !== 'undefined' && websiteEdit)) { %>
  <div class="ac-tenant-about-image">
    <%- include('../partials/website-editable-image', {
      contentKey: 'about.story.image',
      imageSrc: aboutImageSrc,
      imageAlt: clinic.aboutStoryImageAlt || (aboutImageSrc ? ('Photo for ' + clinic.publicName) : ''),
      imageMediaId: clinic.aboutStoryImageMediaId || '',
      imageClassName: 'ac-tenant-about-image__img',
      imageLoading: 'lazy',
      imagePlaceholderSrc: 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7',
    }) %>
  </div>
  <% } %>
  <% if (aboutBody || (typeof websiteEdit !== 'undefined' && websiteEdit)) { %>
  <div class="ac-public-prose acp-prose-card">
    <%- include('../partials/website-editable-field', { contentKey: 'about.story.body', fieldValue: aboutBody || '', fieldType: 'long_text' }) %>
  </div>
  <% } else { %>
  <div class="acp-empty-state ac-public-empty">
    <p>Public about content has not been configured for this clinic yet.</p>
  </div>
  <% } %>
  <% const aboutPhone = clinic.publicPhoneDisplay || (clinic.websiteContent && clinic.websiteContent['contact.phone']); %>
  <% const aboutEmail = clinic.publicEmailDisplay || (clinic.websiteContent && clinic.websiteContent['contact.email']); %>
  <% if (aboutPhone || aboutEmail) { %>
  <section class="acp-section">
    <h2>Contact details</h2>
    <ul class="ac-public-list">
      <% if (aboutPhone) { %><li>Phone: <%= aboutPhone %></li><% } %>
      <% if (aboutEmail) { %><li>Email: <%= aboutEmail %></li><% } %>
    </ul>
    <%- include('../partials/website-operational-affordance', { href: '/app/settings/organization', label: 'Manage clinic contact details', manageKind: 'contact' }) %>
  </section>
  <% } %>
  <p class="ac-public-actions">
    <a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinic.clinicKey %>/location">Location &amp; hours</a>
    <a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinic.clinicKey %>/contact">Send a message</a>
  </p>
</article>
