<section class="ac-public-section" data-ac-website-history="1">
  <h1>Website version history</h1>
  <p>Public visitors see the current published version only. Restore copies a historical version into a new draft. The live website does not change until you publish.</p>
  <% if (typeof notice === 'string' && notice === 'published') { %>
  <p class="ac-public-note" data-ac-website-notice="published">Website published.</p>
  <% } else if (typeof notice === 'string' && (notice === 'restored_draft' || notice === 'restored')) { %>
  <p class="ac-public-note" data-ac-website-notice="restored_draft">Restored as a new draft. The published website is unchanged. Review the draft, then publish when you are ready.</p>
  <% } %>
  <% if (typeof error === 'string' && error) { %>
  <p class="ac-public-error" role="alert"><%= error %></p>
  <% } %>
  <% var rows = versions || []; %>
  <% var canRestoreHistory = typeof websiteCanRestore !== 'undefined' && websiteCanRestore; %>
  <table class="ac-public-table">
    <thead>
      <tr>
        <th>Version</th>
        <th>Published</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (!rows.length) { %>
      <tr><td colspan="4">No published versions yet. Publish the website to create version 1.</td></tr>
      <% } %>
      <% rows.forEach(function (v, idx) { %>
      <tr data-ac-website-version="<%= v.versionNumber %>" data-ac-version-status="<%= v.status %>">
        <td>v<%= v.versionNumber %><% if (v.status === 'published') { %> — CURRENT<% } %></td>
        <td><%= v.publishedAt ? String(v.publishedAt).slice(0, 16).replace('T', ' ') : '—' %></td>
        <td><%= v.moderationStatus || v.status %></td>
        <td>
          <a href="/clinics/<%= clinic.clinicKey %>/website/versions/<%= v.id %>">Preview</a>
          <% if (canRestoreHistory && v.status !== 'published') { %>
          <form
            method="post"
            action="/clinics/<%= clinic.clinicKey %>/website/versions/<%= v.id %>/restore"
            style="display:inline"
            onsubmit="if(!confirm('Restore this version as a new draft? The live website will not change until you publish.')) return false; var b=this.querySelector('button[type=submit]'); if(b) b.disabled=true;"
          >
            <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
            <button type="submit">Restore as new draft</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <p><a href="<%= typeof websiteEditUrl !== 'undefined' && websiteEditUrl ? websiteEditUrl : ((clinic && (clinic.publicBasePath || clinic.publicPagePaths && clinic.publicPagePaths.home)) || ('/clinics/' + (clinic && clinic.clinicKey))) + '?website_edit=1&amp;website_mode=draft' %>">Back to editor</a></p>
</section>
