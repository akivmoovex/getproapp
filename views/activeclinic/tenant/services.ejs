<section class="ac-public-section ac-tenant-directory" data-ac-page-section="tenant-services">
  <header class="ac-tenant-page-header">
    <h1><%- include('../partials/website-editable-field', { contentKey: 'services.page_title', fieldValue: clinic.servicesPageTitle || 'Services', fieldType: 'short_text' }) %></h1>
    <p class="ac-public-lede"><%- include('../partials/website-editable-field', { contentKey: 'services.intro', fieldValue: clinic.servicesIntro || ('Care offerings published by ' + clinic.publicName + '.'), fieldType: 'long_text' }) %></p>
  </header>
  <% const serviceList = Array.isArray(services) ? services : []; %>
  <% const procedureList = Array.isArray(procedures) ? procedures : []; %>
  <% if (!serviceList.length && !procedureList.length) { %>
  <div class="ac-public-empty" data-ac-empty="services" data-ac-state-key="empty">
    <h2><%- include('../partials/website-editable-field', { contentKey: 'services.empty_heading', fieldValue: clinic.servicesEmptyHeading || 'Service listings are not available yet', fieldType: 'short_text' }) %></h2>
    <p><%- include('../partials/website-editable-field', { contentKey: 'services.empty_body', fieldValue: clinic.servicesEmptyBody || 'This clinic has not published service listings yet.', fieldType: 'long_text' }) %></p>
    <%- include('../partials/website-operational-affordance', { href: '/app/settings/website/catalogue', label: 'Manage public catalogue', manageKind: 'services' }) %>
    <p><a class="ac-btn ac-btn--secondary ac-btn--pill" href="<%= (clinic.publicPagePaths && clinic.publicPagePaths.home) || ('/clinics/' + clinic.clinicKey) %>">Back to clinic home</a></p>
  </div>
  <% } %>
  <% if (serviceList.length) { %>
  <h2 class="acp-section-title">Consultations</h2>
  <ul class="ac-service-cards">
    <% serviceList.forEach(function(s) { %>
    <li class="ac-service-card">
      <a class="ac-service-card__link" href="/clinics/<%= clinic.clinicKey %>/services/<%= s.serviceKey %>">
        <span class="ac-service-card__icon" aria-hidden="true">
          <img src="<%= s.iconUrl || '/activeclinic/assets/icons/general.svg' %>" alt="" width="28" height="28" loading="lazy"/>
        </span>
        <h3 class="ac-service-card__name"><%= s.displayName %></h3>
        <% if (s.summary) { %>
        <p class="ac-service-card__summary"><%= s.summary.length > 140 ? s.summary.slice(0, 140) + "…" : s.summary %></p>
        <% } %>
        <span class="ac-service-card__cta">View details</span>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>
  <% if (procedureList.length) { %>
  <h2 class="acp-section-title">Procedures &amp; diagnostics</h2>
  <ul class="ac-service-cards">
    <% procedureList.forEach(function(p) { %>
    <li class="ac-service-card">
      <a class="ac-service-card__link" href="/clinics/<%= clinic.clinicKey %>/procedures/<%= p.procedureKey %>">
        <span class="ac-service-card__icon" aria-hidden="true">
          <img src="<%= p.iconUrl || '/activeclinic/assets/icons/procedure.svg' %>" alt="" width="28" height="28" loading="lazy"/>
        </span>
        <h3 class="ac-service-card__name"><%= p.displayName %></h3>
        <% if (p.summary) { %>
        <p class="ac-service-card__summary"><%= p.summary.length > 140 ? p.summary.slice(0, 140) + "…" : p.summary %></p>
        <% } %>
        <span class="ac-service-card__cta">View details</span>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>
  <% if (serviceList.length || procedureList.length) { %>
  <%- include('../partials/website-operational-affordance', { href: '/app/settings/website/catalogue', label: 'Manage public catalogue', manageKind: 'services' }) %>
  <% } %>
  <p class="ac-public-note"><a href="<%= (clinic.publicPagePaths && clinic.publicPagePaths.pricing) || ('/clinics/' + clinic.clinicKey + '/pricing') %>">Pricing information</a> · Fees are shown only when configured by the clinic.</p>
  <%- include('../partials/website-library-placements', { libraryPageId: 'tpl_services', librarySkipTypes: [] }) %>
</section>
