<section class="acp-page" data-ac-page-section="tenant-pricing">
  <header class="acp-page-hero acp-page-hero--compact">
    <p class="ac-public-eyebrow">Pricing</p>
    <h1>Pricing</h1>
    <p class="ac-public-lede">Fees listed here are only those <%= clinic.publicName %> has chosen to publish. Contact the clinic for anything not shown.</p>
  </header>
  <% const patterns = Array.isArray(pricePatterns) ? pricePatterns : []; %>
  <% if (!patterns.length) { %>
  <div class="ac-public-empty acp-empty-state" data-ac-price-state="no-public-prices" data-ac-state-key="empty">
    <p><strong>Fees not listed online</strong></p>
    <p>Public price information has not been configured for <%= clinic.publicName %>. Contact the clinic for current fees — amounts shown here would only appear when verified by the clinic.</p>
    <p><a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinic.clinicKey %>/contact">Contact clinic for fees</a></p>
  </div>
  <% } else { %>
  <p class="ac-public-note">Prices below are published by the clinic. Final charges may vary based on your visit.</p>
  <ul class="ac-price-patterns acp-price-grid">
    <% patterns.forEach(function(p) { %>
    <li class="ac-price-pattern acp-price-card" data-ac-price-pattern="<%= p.patternKey || '' %>">
      <h2><%= p.displayName %></h2>
      <% if (p.description) { %><p><%= p.description %></p><% } %>
      <% if (p.priceLabel) { %><p class="ac-price-pattern__amount acp-price-card__amount"><%= p.priceLabel %></p><% } %>
    </li>
    <% }) %>
  </ul>
  <% } %>
  <p class="acp-price-pattern-note" data-ac-price-patterns="honesty">
    Public price patterns only list fees the clinic has chosen to publish. “Price to be confirmed” items in booking stay confirmation-based.
  </p>
  <p class="ac-public-note">ActiveClinic does not invent or estimate medical fees. <a href="/clinics/<%= clinic.clinicKey %>/services">View services</a></p>
</section>
