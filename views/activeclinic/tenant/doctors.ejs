<section class="ac-public-section ac-tenant-directory" data-ac-page-section="tenant-doctors">
  <header class="ac-tenant-page-header">
    <h1>Our Doctors</h1>
    <p class="ac-public-lede">Clinicians with profiles published by <%= clinic.publicName %>.</p>
  </header>
  <% const list = Array.isArray(profiles) ? profiles : []; %>
  <% if (!list.length) { %>
  <div class="ac-public-empty" data-ac-empty="doctors" data-ac-state-key="empty">
    <p>No public doctor profiles are published.</p>
    <p><a class="ac-btn ac-btn--secondary ac-btn--pill" href="/clinics/<%= clinic.clinicKey %>">Back to clinic home</a></p>
  </div>
  <% } else { %>
  <ul class="ac-doctor-cards acp-doctor-grid">
    <% list.forEach(function(d) { %>
    <li class="ac-doctor-card acp-doctor-card<%= d.photoIsFallback ? ' ac-doctor-card--fallback' : '' %>"<%= d.photoIsFallback ? ' data-ac-asset-gap="doctor-photo"' : '' %>>
      <div class="ac-doctor-card__media<%= d.photoIsFallback ? '' : ' ac-doctor-card__media--photo' %>">
        <%- include('../partials/ac-media', {
          src: d.photoUrl || (typeof doctorFallbackUrl === 'string' ? doctorFallbackUrl : '/activeclinic/assets/doctors/doctor-fallback.svg'),
          alt: d.photoIsFallback ? '' : ('Portrait of ' + (d.displayName || 'clinician')),
          decorative: Boolean(d.photoIsFallback),
          className: d.photoIsFallback ? 'ac-doctor-card__photo ac-doctor-card__photo--fallback' : 'ac-doctor-card__photo',
          objectFit: 'cover',
          objectPosition: d.photoObjectPosition || 'center 20%',
          width: 640,
          height: 480,
          loading: 'lazy',
          fallbackSrc: typeof doctorFallbackUrl === 'string' ? doctorFallbackUrl : '/activeclinic/assets/doctors/doctor-fallback.svg',
        }) %>
      </div>
      <div class="ac-doctor-card__body">
        <h2 class="ac-doctor-card__name"><%= d.displayName %></h2>
        <% if (d.title) { %><p class="ac-doctor-card__title"><%= d.title %></p><% } %>
        <% if (d.specialty || d.departmentName) { %>
        <p class="ac-doctor-card__tags">
          <% if (d.specialty) { %><span class="ac-doctor-card__tag"><%= d.specialty %></span><% } %>
          <% if (d.departmentName) { %><span class="ac-doctor-card__tag"><%= d.departmentName %></span><% } %>
        </p>
        <% } %>
        <div class="ac-doctor-card__actions">
          <a class="ac-btn ac-btn--primary ac-btn--block" href="/clinics/<%= clinic.clinicKey %>/book">Book appointment</a>
          <a class="ac-btn ac-btn--secondary ac-btn--block" href="/clinics/<%= clinic.clinicKey %>/doctors/<%= d.staffKey %>">View profile</a>
        </div>
      </div>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
