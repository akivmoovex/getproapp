<section class="acp-page acp-booking-status-page" data-ac-page-section="my-booking-detail">
  <header class="acp-booking-status-header">
    <p class="ac-public-eyebrow">My booking</p>
    <h1>Booking <%= booking.requestNumber %></h1>
    <% const st = booking.status || ''; %>
    <p>
      <span class="acp-status-badge acp-status-badge--<%= st.replace(/_/g, '-') %>" data-ac-booking-status="<%= st %>">
        <%= st.replace(/_/g, ' ') %>
      </span>
    </p>
  </header>

  <% if (booking.status === 'submitted_pending_confirmation') { %>
  <p class="ac-public-banner acp-status-banner acp-status-banner--pending">Your request is waiting for clinic confirmation. It is <strong>not confirmed</strong> yet.</p>
  <% } else if (booking.status === 'confirmed') { %>
  <p class="ac-public-note acp-status-banner acp-status-banner--confirmed">Your booking has been confirmed by the clinic.</p>
  <% } else if (booking.status === 'cancellation_requested') { %>
  <p class="ac-public-banner acp-status-banner acp-status-banner--pending">A cancellation request is pending clinic review. Your booking is not yet cancelled.</p>
  <% } else if (booking.status === 'reschedule_requested') { %>
  <p class="ac-public-banner acp-status-banner acp-status-banner--pending">A reschedule request is pending clinic review. Your time is not yet changed.</p>
  <% } else if (booking.status === 'cancelled') { %>
  <p class="ac-public-note acp-status-banner acp-status-banner--cancelled">This booking has been cancelled.</p>
  <% } else if (booking.status === 'completed') { %>
  <p class="ac-public-note acp-status-banner acp-status-banner--done">This visit has been marked completed.</p>
  <% } else if (booking.status === 'no_show') { %>
  <p class="ac-public-note acp-status-banner acp-status-banner--muted">This booking was marked as a no-show.</p>
  <% } %>

  <div class="acp-booking-detail-card">
    <h2 class="ac-sr-only">Booking details</h2>
    <dl class="ac-booking-summary__list">
      <% if (booking.serviceDisplayName) { %><div><dt>Service</dt><dd><%= booking.serviceDisplayName %></dd></div><% } %>
      <% if (booking.procedureDisplayName) { %><div><dt>Procedure</dt><dd><%= booking.procedureDisplayName %></dd></div><% } %>
      <% if (booking.staffDisplayName) { %><div><dt>Doctor</dt><dd><%= booking.staffDisplayName %></dd></div><% } %>
      <% if (booking.facilityDisplayName) { %><div><dt>Facility</dt><dd><%= booking.facilityDisplayName %></dd></div><% } %>
      <% if (booking.preferredStartsAt) { %><div><dt>Preferred time</dt><dd><%= booking.preferredStartsAt %></dd></div><% } %>
      <div><dt>Patient</dt><dd><%= booking.patientFirstName %> <%= booking.patientLastName %></dd></div>
    </dl>
  </div>

  <% if (canModifyBooking) { %>
  <div class="ac-booking-actions">
    <a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinic.clinicKey %>/my-booking/cancel?token=<%= encodeURIComponent(accessToken) %>">Request cancellation</a>
    <a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinic.clinicKey %>/my-booking/reschedule?token=<%= encodeURIComponent(accessToken) %>">Request reschedule</a>
  </div>
  <p class="ac-public-note">Cancellation and reschedule submit a request for clinic review — they are not immediate.</p>
  <% } else { %>
  <p class="ac-public-note" data-ac-actions-unavailable="1">Cancel and reschedule are not available for this booking status.</p>
  <% } %>

  <%- include('../partials/sms-honesty-note') %>
</section>
