<section
  class="ac-public-section acp-confirmation-panel acp-mf10"
  data-ac-page-section="booking-submitted"
  data-ac-state-key="success_terminal"
  data-ac-mf-family="MF10"
>
  <div class="acp-confirmation-panel__card acp-mf10-success">
    <p class="ac-public-eyebrow">Request received</p>
    <h1>Request submitted</h1>
    <% if (booking.procedureDisplayName) { %><p>Procedure: <strong><%= booking.procedureDisplayName %></strong></p><% } %>
    <dl class="ac-booking-summary__list">
      <div><dt>Reference</dt><dd><%= booking.requestNumber %></dd></div>
      <div><dt>Status</dt><dd>Pending clinic confirmation</dd></div>
      <% if (clinic && (clinic.publicName || clinic.displayName)) { %>
      <div><dt>Clinic</dt><dd><%= clinic.publicName || clinic.displayName %></dd></div>
      <% } %>
    </dl>
    <p class="acp-status-banner acp-status-banner--pending">This is not a confirmed appointment. Save your access link to check status.</p>
    <% if (accessToken) { %>
    <p class="ac-public-actions">
      <a class="ac-btn ac-btn--primary" href="/clinics/<%= clinic.clinicKey %>/my-booking?token=<%= encodeURIComponent(accessToken) %>">View my booking</a>
      <a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinic.clinicKey %>/patient/register?guestToken=<%= encodeURIComponent(accessToken) %>">Create a patient portal account</a>
      <a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinic.clinicKey %>">Back to clinic</a>
    </p>
    <% } else { %>
    <p class="ac-public-actions">
      <a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinic.clinicKey %>/patient/register">Create a patient portal account</a>
      <a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinic.clinicKey %>">Back to clinic</a>
    </p>
    <% } %>
    <%- include('../partials/sms-honesty-note') %>
  </div>
</section>
