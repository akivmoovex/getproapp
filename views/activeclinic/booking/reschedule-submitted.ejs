<section class="ac-public-section acp-confirmation-panel" data-ac-page-section="reschedule-submitted">
  <div class="acp-confirmation-panel__card">
    <p class="ac-public-eyebrow">My booking</p>
    <h1>Reschedule request submitted</h1>
    <p>Your reschedule request for booking <strong><%= booking.requestNumber %></strong> has been received.</p>
    <p class="ac-public-banner acp-status-banner acp-status-banner--pending">This is a request — your appointment time is <strong>not yet changed</strong>. The clinic will confirm availability.</p>
    <p class="ac-public-actions">
      <a class="ac-btn ac-btn--primary" href="/clinics/<%= clinic.clinicKey %>/my-booking?token=<%= encodeURIComponent(accessToken) %>">Return to my booking</a>
    </p>
    <%- include('../partials/sms-honesty-note') %>
  </div>
</section>
