<section class="acp-page acp-lookup-page" data-ac-page-section="my-booking-lookup">
  <header class="acp-page-hero acp-page-hero--compact">
    <p class="ac-public-eyebrow">My booking</p>
    <h1>Look up your booking</h1>
    <p class="ac-public-lede">Use the secure link or access token from your booking confirmation.</p>
  </header>
  <% const state = typeof lookupState === 'string' ? lookupState : 'form'; %>
  <div class="acp-auth-card acp-lookup-card">
    <ul class="acp-privacy-rules ac-booking-privacy">
      <li>Do not share your access token — it opens this booking request only.</li>
      <li>Lookup never shows another patient’s request or clinical record.</li>
      <li>A pending request is not a confirmed appointment until the clinic responds.</li>
    </ul>
    <% if (state === 'error' && typeof error === 'string' && error) { %>
    <div class="ac-public-error" role="alert" data-ac-lookup-state="error" data-ac-state-key="request_error"><%= error %></div>
    <% } %>
    <% if (state === 'progress') { %>
    <p class="ac-public-note" data-ac-lookup-state="progress">Looking up your booking…</p>
    <% } %>
    <form method="get" action="/clinics/<%= clinic.clinicKey %>/my-booking" class="ac-public-form" data-ac-lookup-state="<%= state %>">
      <label for="token">Access token</label>
      <input id="token" name="token" required autocomplete="off" value="<%= typeof tokenValue === 'string' ? tokenValue : '' %>"/>
      <button type="submit" class="ac-btn ac-btn--primary">Look up booking</button>
    </form>
  </div>
</section>
