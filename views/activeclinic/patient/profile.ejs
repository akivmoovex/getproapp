<section
  class="ac-patient-page acp-mf08"
  data-ac-page-section="patient-profile"
  data-ac-mf-family="MF08"
  data-ac-mf-screen="MF08-05"
>
  <header class="ac-patient-page__header">
    <p class="acp-mf08__kicker">Patient portal</p>
    <h1>Your profile</h1>
    <p class="acp-auth-card__lede">Update contact details the clinic already uses for this portal. Clinical history, insurance, and medical records are not collected here.</p>
  </header>

  <% if (error) { %>
  <div class="ac-patient-alert ac-patient-alert--error" role="alert"><%= error %></div>
  <% } %>
  <% if (success) { %>
  <div class="ac-patient-alert ac-patient-alert--success" role="status"><%= success %></div>
  <% } %>

  <form method="POST" action="/clinics/<%= clinicKey %>/patient/profile" class="acp-mf08-card" data-ac-shell="patient" data-ac-loading="1">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <p class="ac-patient-meta">
      <strong>Legal name:</strong>
      <%= escapeHtml(profile.firstName || "") %> <%= escapeHtml(profile.lastName || "") %>
      (cannot be changed here)
    </p>
    <div class="ac-patient-field">
      <label for="preferredName">Preferred name</label>
      <input type="text" id="preferredName" name="preferredName" value="<%= escapeHtml(profile.preferredName || "") %>" autocomplete="nickname"/>
    </div>
    <div class="ac-patient-field">
      <%- include('../partials/phone-field', {
        id: 'phone',
        label: 'Phone',
        required: false,
        defaultCountry: (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || 'ZM',
        selectedCountry: (typeof phoneCountry !== 'undefined' && phoneCountry) || (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || 'ZM',
        nationalValue: (typeof phoneNational !== 'undefined' && phoneNational) || '',
        e164Value: (profile && (profile.phoneNormalized || profile.phoneDisplay)) || '',
        countries: (typeof phoneCountries !== 'undefined' && phoneCountries) || [],
        phoneValidationRelaxed: typeof phoneValidationRelaxed !== 'undefined' && phoneValidationRelaxed,
        showLegacyHidden: false,
        hint: 'Changing phone updates your patient contact record. Login identity rules may still require clinic verification.'
      }) %>
    </div>
    <div class="ac-patient-field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= escapeHtml(profile.emailDisplay || "") %>" autocomplete="email"/>
    </div>
    <fieldset class="acp-mf08-fieldset">
      <legend>Address</legend>
      <div class="ac-patient-field">
        <label for="addressLine1">Address line 1</label>
        <input type="text" id="addressLine1" name="addressLine1" value="<%= escapeHtml(profile.addressLine1 || "") %>" autocomplete="address-line1"/>
      </div>
      <div class="ac-patient-field">
        <label for="addressLine2">Address line 2</label>
        <input type="text" id="addressLine2" name="addressLine2" value="<%= escapeHtml(profile.addressLine2 || "") %>" autocomplete="address-line2"/>
      </div>
      <div class="acp-mf08-grid">
        <div class="ac-patient-field">
          <label for="addressCity">City</label>
          <input type="text" id="addressCity" name="addressCity" value="<%= escapeHtml(profile.addressCity || "") %>" autocomplete="address-level2"/>
        </div>
        <div class="ac-patient-field">
          <label for="addressProvince">Province</label>
          <input type="text" id="addressProvince" name="addressProvince" value="<%= escapeHtml(profile.addressProvince || "") %>" autocomplete="address-level1"/>
        </div>
      </div>
    </fieldset>
    <button type="submit" class="ac-patient-btn ac-btn ac-btn--primary" data-loading="Saving…">Update profile</button>
  </form>

  <p class="ac-patient-links">
    <a href="/clinics/<%= clinicKey %>/patient/verify-phone">Request phone verification (no SMS code)</a>
    ·
    <a href="/clinics/<%= clinicKey %>/patient">Back to dashboard</a>
  </p>
</section>
