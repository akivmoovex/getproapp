<section class="ac-patient-page">
  <header class="ac-patient-page__header">
    <h1>My profile</h1>
  </header>

  <% if (error) { %>
  <div class="ac-patient-alert ac-patient-alert--error" role="alert"><%= error %></div>
  <% } %>
  <% if (success) { %>
  <div class="ac-patient-alert ac-patient-alert--success" role="status"><%= success %></div>
  <% } %>

  <form method="POST" action="/clinics/<%= clinicKey %>/patient/profile" data-ac-shell="patient">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <p class="ac-patient-meta">
      <strong>Name:</strong>
      <%= escapeHtml(profile.firstName || "") %> <%= escapeHtml(profile.lastName || "") %>
      (cannot be changed)
    </p>
    <div class="ac-patient-field">
      <label for="preferredName">Preferred name</label>
      <input type="text" id="preferredName" name="preferredName" value="<%= escapeHtml(profile.preferredName || "") %>"/>
    </div>
    <div class="ac-patient-field">
      <label for="phone">Phone</label>
      <input type="tel" id="phone" name="phone" value="<%= escapeHtml(profile.phoneDisplay || "") %>"/>
    </div>
    <div class="ac-patient-field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= escapeHtml(profile.emailDisplay || "") %>"/>
    </div>
    <div class="ac-patient-field">
      <label for="addressLine1">Address line 1</label>
      <input type="text" id="addressLine1" name="addressLine1" value="<%= escapeHtml(profile.addressLine1 || "") %>"/>
    </div>
    <div class="ac-patient-field">
      <label for="addressLine2">Address line 2</label>
      <input type="text" id="addressLine2" name="addressLine2" value="<%= escapeHtml(profile.addressLine2 || "") %>"/>
    </div>
    <div class="ac-patient-field">
      <label for="addressCity">City</label>
      <input type="text" id="addressCity" name="addressCity" value="<%= escapeHtml(profile.addressCity || "") %>"/>
    </div>
    <div class="ac-patient-field">
      <label for="addressProvince">Province</label>
      <input type="text" id="addressProvince" name="addressProvince" value="<%= escapeHtml(profile.addressProvince || "") %>"/>
    </div>
    <button type="submit" class="ac-patient-btn">Update profile</button>
  </form>

  <p class="ac-patient-links">
    <a href="/clinics/<%= clinicKey %>/patient/verify-phone">Verify phone (contact clinic)</a>
    ·
    <a href="/clinics/<%= clinicKey %>/patient">Back to dashboard</a>
  </p>
</section>
