<section class="ac-patient-page">
  <header class="ac-patient-page__header">
    <h1>Notifications</h1>
  </header>

  <div class="ac-patient-honesty">
    <p>
      Email and SMS notifications are not yet available for this patient portal.
      Please check your portal regularly for booking updates.
    </p>
    <p>The clinic will contact you directly by phone if urgent communication is needed.</p>
  </div>

  <div class="ac-patient-empty-state">
    <p>No notifications to display.</p>
  </div>

  <p class="ac-patient-links">
    <a href="/clinics/<%= clinicKey %>/patient">Back to dashboard</a>
  </p>
</section>
