<section class="acp-auth-card ac-patient-card ac-patient-card--auth acp-empty-state" data-ac-page-section="patient-offline" data-ac-state-key="offline">
  <header class="acp-auth-card__header">
    <p class="ac-public-eyebrow">Patient portal</p>
    <h1>Patient portal unavailable</h1>
  </header>
  <div class="ac-patient-honesty">
    <p>The patient portal is temporarily unavailable. Please try again later or contact the clinic directly.</p>
    <% if (clinic && clinic.publicName) { %>
    <p>Clinic: <strong><%= clinic.publicName %></strong></p>
    <% } %>
  </div>
  <p class="ac-patient-links ac-public-actions">
    <a class="ac-btn ac-btn--primary" href="/clinics/<%= clinicKey %>">Return to clinic website</a>
  </p>
</section>
