<section class="acp-auth-card ac-patient-card ac-patient-card--auth" data-ac-page-section="patient-register">
  <header class="acp-auth-card__header">
    <p class="ac-public-eyebrow">Patient portal</p>
    <h1>Register</h1>
  </header>
  <% if (error) { %>
  <div class="ac-patient-alert ac-patient-alert--error" role="alert"><%= error %></div>
  <% } %>
  <p class="ac-patient-hint acp-auth-card__lede">
    If you have a guest booking token, enter it below. Otherwise, enter your details to match your patient record.
  </p>
  <form method="POST" action="/clinics/<%= clinicKey %>/patient/register" data-ac-shell="patient">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <div class="ac-patient-field">
      <label for="guestToken">Guest token (optional)</label>
      <input type="text" id="guestToken" name="guestToken" autocomplete="off"/>
    </div>
    <div class="ac-patient-field">
      <%- include('../partials/phone-field', {
        id: 'phone',
        label: 'Phone',
        required: true,
        defaultCountry: (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || 'ZM',
        selectedCountry: (typeof phoneCountry !== 'undefined' && phoneCountry) || (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || 'ZM',
        nationalValue: '',
        countries: (typeof phoneCountries !== 'undefined' && phoneCountries) || [],
        phoneValidationRelaxed: typeof phoneValidationRelaxed !== 'undefined' && phoneValidationRelaxed,
        showLegacyHidden: true
      }) %>
    </div>
    <div class="ac-patient-field">
      <label for="email">Email (optional)</label>
      <input type="email" id="email" name="email" autocomplete="email"/>
    </div>
    <div class="ac-patient-field">
      <label for="firstName">First name</label>
      <input type="text" id="firstName" name="firstName" autocomplete="given-name"/>
    </div>
    <div class="ac-patient-field">
      <label for="lastName">Last name</label>
      <input type="text" id="lastName" name="lastName" autocomplete="family-name"/>
    </div>
    <div class="ac-patient-field">
      <label for="password">Password (min 10 characters)</label>
      <input type="password" id="password" name="password" autocomplete="new-password" required minlength="10"/>
    </div>
    <button type="submit" class="ac-patient-btn">Register</button>
  </form>
  <p class="ac-patient-links">
    <a href="/clinics/<%= clinicKey %>/patient/login">Already have an account? Sign in</a>
    ·
    <a href="/clinics/<%= clinicKey %>/patient/link-guest-booking">Link a guest booking</a>
  </p>
</section>
