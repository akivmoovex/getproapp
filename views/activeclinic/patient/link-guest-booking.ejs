<section class="acp-auth-card ac-patient-card ac-patient-card--auth" data-ac-page-section="patient-link-guest-booking">
  <header class="acp-auth-card__header">
    <p class="ac-public-eyebrow">Patient portal</p>
    <h1>Link guest booking</h1>
    <p class="acp-auth-card__lede">
      Enter the guest access token from your booking confirmation to link it to your patient portal account.
    </p>
  </header>

  <% if (error) { %>
  <div class="ac-patient-alert ac-patient-alert--error" role="alert"><%= error %></div>
  <% } %>
  <% if (success) { %>
  <div class="ac-patient-alert ac-patient-alert--success" role="status"><%= success %></div>
  <% } %>

  <% if (patientAuth && patientAuth.authenticated) { %>
  <form method="POST" action="/clinics/<%= clinicKey %>/patient/link-guest-booking" data-ac-shell="patient" data-ac-loading="1">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <div class="ac-patient-field">
      <label for="guestToken">Guest booking token</label>
      <input type="text" id="guestToken" name="guestToken" autocomplete="off" required aria-required="true"/>
    </div>
    <button type="submit" class="ac-patient-btn ac-btn ac-btn--primary">Link booking</button>
  </form>
  <% } else { %>
  <div class="ac-patient-honesty">
    <p>Sign in to link a guest booking to your account, or include the token when registering.</p>
  </div>
  <p class="ac-patient-links">
    <a href="/clinics/<%= clinicKey %>/patient/login">Sign in</a>
    ·
    <a href="/clinics/<%= clinicKey %>/patient/register">Register with token</a>
  </p>
  <% } %>
</section>
