<section class="acp-auth-card ac-patient-card ac-patient-card--auth" data-ac-page-section="patient-verify-phone">
  <header class="acp-auth-card__header">
    <p class="ac-public-eyebrow">Patient portal</p>
    <h1>Verify your phone</h1>
  </header>
  <div class="ac-patient-honesty">
    <p>
      SMS and automated phone verification are not yet available for this clinic.
      To verify your contact details or update your phone number, please contact the clinic directly.
    </p>
    <% if (clinic && clinic.publicName) { %>
    <p>Clinic: <strong><%= clinic.publicName %></strong></p>
    <% } %>
  </div>
  <% if (error) { %>
  <div class="ac-patient-alert ac-patient-alert--error" role="alert"><%= error %></div>
  <% } %>
  <form method="POST" action="/clinics/<%= clinicKey %>/patient/verify-phone" data-ac-shell="patient">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <div class="ac-patient-field">
      <%- include('../partials/phone-field', {
        id: 'phone',
        label: 'Phone number on your account',
        required: false,
        defaultCountry: (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || 'ZM',
        selectedCountry: (typeof phoneCountry !== 'undefined' && phoneCountry) || (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || 'ZM',
        nationalValue: '',
        countries: (typeof phoneCountries !== 'undefined' && phoneCountries) || [],
        phoneValidationRelaxed: typeof phoneValidationRelaxed !== 'undefined' && phoneValidationRelaxed,
        showLegacyHidden: true,
        placeholder: 'For reference — no SMS is sent yet',
        hint: 'SMS OTP is not active yet. Your entered number is normalized for the verification request record.'
      }) %>
    </div>
    <button type="submit" class="ac-patient-btn ac-btn ac-btn--primary">Continue</button>
  </form>
  <p class="ac-patient-hint">
    Submitting this form does not send an SMS. It records your request to contact the clinic for verification.
  </p>
  <p class="ac-patient-links">
    <a href="/clinics/<%= clinicKey %>/patient/login">Back to sign in</a>
  </p>
</section>
