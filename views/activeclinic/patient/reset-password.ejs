<section class="acp-auth-card ac-patient-card ac-patient-card--auth" data-ac-page-section="patient-reset-password">
  <header class="acp-auth-card__header">
    <p class="ac-public-eyebrow">Patient portal</p>
    <h1>Set a new password</h1>
    <p class="acp-auth-card__lede">Choose a password of at least 8 characters. You will use it to sign in to this clinic’s patient portal.</p>
  </header>
  <% if (error) { %>
  <div class="ac-patient-alert ac-patient-alert--error" role="alert"><%= error %></div>
  <% } %>
  <form method="POST" action="/clinics/<%= clinicKey %>/patient/reset-password" data-ac-shell="patient" data-ac-loading="1">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <input type="hidden" name="token" value="<%= escapeHtml(token) %>"/>
    <div class="ac-patient-field">
      <label for="newPassword">New password</label>
      <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" required aria-required="true" minlength="8"/>
    </div>
    <button type="submit" class="ac-patient-btn ac-btn ac-btn--primary">Reset password</button>
  </form>
  <p class="ac-patient-links">
    <a href="/clinics/<%= clinicKey %>/patient/login">Back to sign in</a>
  </p>
</section>
