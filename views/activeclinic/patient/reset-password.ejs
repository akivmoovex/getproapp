<section class="ac-patient-card ac-patient-card--auth">
  <h1>Reset your password</h1>
  <% if (error) { %>
  <div class="ac-patient-alert ac-patient-alert--error" role="alert"><%= error %></div>
  <% } %>
  <form method="POST" action="/clinics/<%= clinicKey %>/patient/reset-password" data-ac-shell="patient">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <input type="hidden" name="token" value="<%= escapeHtml(token) %>"/>
    <div class="ac-patient-field">
      <label for="newPassword">New password (min 8 characters)</label>
      <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" required minlength="8"/>
    </div>
    <button type="submit" class="ac-patient-btn">Reset password</button>
  </form>
</section>
