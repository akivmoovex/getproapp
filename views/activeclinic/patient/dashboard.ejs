<section class="ac-patient-page acp-portal-dashboard" data-ac-page-section="patient-dashboard">
  <header class="ac-patient-page__header acp-portal-dashboard__header">
    <p class="ac-public-eyebrow">Patient portal</p>
    <h1>Welcome, <%= escapeHtml(displayName) %></h1>
    <% if (patient.patientNumber) { %>
    <p class="ac-patient-meta">Patient number: <%= escapeHtml(patient.patientNumber) %></p>
    <% } %>
  </header>

  <div class="acp-portal-grid">
    <section class="ac-patient-section acp-portal-panel">
      <h2>Pending requests</h2>
      <% if (!pending || !pending.length) { %>
      <div class="acp-empty-state">
        <p class="ac-patient-empty">No pending requests.</p>
      </div>
      <% } else { %>
      <ul class="ac-patient-list acp-booking-list">
        <% pending.forEach(function(b) { %>
        <li class="acp-booking-list__item">
          <a href="/clinics/<%= clinicKey %>/patient/bookings/<%= escapeHtml(b.requestNumber || b.id) %>">
            <%= escapeHtml(b.requestNumber || b.id) %>
          </a>
          <span class="acp-status-badge acp-status-badge--pending"><%= escapeHtml(bookingStatusLabels[b.status] || b.status || "") %></span>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </section>

    <section class="ac-patient-section acp-portal-panel">
      <h2>Upcoming</h2>
      <% if (!upcoming || !upcoming.length) { %>
      <div class="acp-empty-state">
        <p class="ac-patient-empty">No upcoming bookings.</p>
      </div>
      <% } else { %>
      <ul class="ac-patient-list acp-booking-list">
        <% upcoming.forEach(function(b) { %>
        <li class="acp-booking-list__item">
          <a href="/clinics/<%= clinicKey %>/patient/bookings/<%= escapeHtml(b.requestNumber || b.id) %>">
            <%= escapeHtml(b.requestNumber || b.id) %>
          </a>
          <span class="acp-status-badge acp-status-badge--confirmed"><%= escapeHtml(bookingStatusLabels[b.status] || b.status || "") %></span>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </section>

    <section class="ac-patient-section acp-portal-panel">
      <h2>Past</h2>
      <% if (!past || !past.length) { %>
      <div class="acp-empty-state">
        <p class="ac-patient-empty">No past bookings yet.</p>
      </div>
      <% } else { %>
      <ul class="ac-patient-list acp-booking-list">
        <% past.forEach(function(b) { %>
        <li class="acp-booking-list__item">
          <a href="/clinics/<%= clinicKey %>/patient/bookings/<%= escapeHtml(b.requestNumber || b.id) %>">
            <%= escapeHtml(b.requestNumber || b.id) %>
          </a>
          <span class="acp-status-badge acp-status-badge--done"><%= escapeHtml(bookingStatusLabels[b.status] || b.status || "") %></span>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </section>
  </div>

  <nav class="ac-patient-actions acp-portal-actions" aria-label="Quick links">
    <a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinicKey %>/patient/bookings">View all bookings</a>
    <a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinicKey %>/patient/profile">Update my profile</a>
    <a class="ac-btn ac-btn--secondary" href="/clinics/<%= clinicKey %>/patient/link-guest-booking">Link a guest booking</a>
  </nav>
</section>
