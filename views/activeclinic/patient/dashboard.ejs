<section class="ac-patient-page">
  <header class="ac-patient-page__header">
    <h1>Welcome, <%= escapeHtml(displayName) %></h1>
    <% if (patient.patientNumber) { %>
    <p class="ac-patient-meta">Patient number: <%= escapeHtml(patient.patientNumber) %></p>
    <% } %>
  </header>

  <section class="ac-patient-section">
    <h2>Pending requests</h2>
    <% if (!pending || !pending.length) { %>
    <p class="ac-patient-empty">None.</p>
    <% } else { %>
    <ul class="ac-patient-list">
      <% pending.forEach(function(b) { %>
      <li>
        <a href="/clinics/<%= clinicKey %>/patient/bookings/<%= escapeHtml(b.requestNumber || b.id) %>">
          <%= escapeHtml(b.requestNumber || b.id) %>
        </a>
        <span class="ac-patient-badge"><%= escapeHtml(bookingStatusLabels[b.status] || b.status || "") %></span>
      </li>
      <% }); %>
    </ul>
    <% } %>
  </section>

  <section class="ac-patient-section">
    <h2>Upcoming</h2>
    <% if (!upcoming || !upcoming.length) { %>
    <p class="ac-patient-empty">None.</p>
    <% } else { %>
    <ul class="ac-patient-list">
      <% upcoming.forEach(function(b) { %>
      <li>
        <a href="/clinics/<%= clinicKey %>/patient/bookings/<%= escapeHtml(b.requestNumber || b.id) %>">
          <%= escapeHtml(b.requestNumber || b.id) %>
        </a>
        <span class="ac-patient-badge"><%= escapeHtml(bookingStatusLabels[b.status] || b.status || "") %></span>
      </li>
      <% }); %>
    </ul>
    <% } %>
  </section>

  <section class="ac-patient-section">
    <h2>Past</h2>
    <% if (!past || !past.length) { %>
    <p class="ac-patient-empty">None.</p>
    <% } else { %>
    <ul class="ac-patient-list">
      <% past.forEach(function(b) { %>
      <li>
        <a href="/clinics/<%= clinicKey %>/patient/bookings/<%= escapeHtml(b.requestNumber || b.id) %>">
          <%= escapeHtml(b.requestNumber || b.id) %>
        </a>
        <span class="ac-patient-badge"><%= escapeHtml(bookingStatusLabels[b.status] || b.status || "") %></span>
      </li>
      <% }); %>
    </ul>
    <% } %>
  </section>

  <nav class="ac-patient-actions" aria-label="Quick links">
    <a href="/clinics/<%= clinicKey %>/patient/bookings">View all bookings</a>
    <a href="/clinics/<%= clinicKey %>/patient/profile">Update my profile</a>
    <a href="/clinics/<%= clinicKey %>/patient/link-guest-booking">Link a guest booking</a>
  </nav>
</section>
