<section class="ac-patient-page">
  <header class="ac-patient-page__header">
    <h1>My bookings</h1>
  </header>

  <div class="ac-patient-filters" role="navigation" aria-label="Filter bookings by status">
    <a href="/clinics/<%= clinicKey %>/patient/bookings"<% if (!statusFilter) { %> aria-current="true"<% } %>>All</a>
    <% Object.keys(bookingStatusLabels).forEach(function(statusKey) { %>
    <a href="/clinics/<%= clinicKey %>/patient/bookings?status=<%= encodeURIComponent(statusKey) %>"
       <% if (statusFilter === statusKey) { %> aria-current="true"<% } %>>
      <%= bookingStatusLabels[statusKey] %>
    </a>
    <% }); %>
  </div>

  <% if (!bookings || !bookings.length) { %>
  <p class="ac-patient-empty">
    <% if (statusFilter) { %>
    No bookings with status “<%= escapeHtml(bookingStatusLabels[statusFilter] || statusFilter) %>”.
    <% } else { %>
    No bookings found.
    <% } %>
  </p>
  <% } else { %>
  <div class="ac-patient-table-wrap">
    <table class="ac-patient-table">
      <thead>
        <tr>
          <th scope="col">Reference</th>
          <th scope="col">Type</th>
          <th scope="col">Status</th>
        </tr>
      </thead>
      <tbody>
        <% bookings.forEach(function(b) { %>
        <tr>
          <td>
            <a href="/clinics/<%= clinicKey %>/patient/bookings/<%= escapeHtml(b.requestNumber || b.id) %>">
              <%= escapeHtml(b.requestNumber || b.id) %>
            </a>
          </td>
          <td><%= escapeHtml(b.bookingKind || "") %></td>
          <td><%= escapeHtml(bookingStatusLabels[b.status] || b.status || "") %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>

  <p class="ac-patient-links">
    <a href="/clinics/<%= clinicKey %>/patient">Back to dashboard</a>
  </p>
</section>
