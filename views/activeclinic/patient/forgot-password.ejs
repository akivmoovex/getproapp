<section class="acp-auth-card ac-patient-card ac-patient-card--auth" data-ac-page-section="patient-forgot-password">
  <header class="acp-auth-card__header">
    <p class="ac-public-eyebrow">Patient portal</p>
    <h1>Reset password</h1>
    <p class="acp-auth-card__lede">Request a password reset for your patient portal account.</p>
  </header>
  <% if (error) { %>
  <div class="ac-patient-alert ac-patient-alert--error" role="alert"><%= error %></div>
  <% } %>
  <% if (success) { %>
  <div class="ac-patient-alert ac-patient-alert--success" role="status"><%= success %></div>
  <% } %>
  <form method="POST" action="/clinics/<%= clinicKey %>/patient/forgot-password" data-ac-shell="patient" data-ac-loading="1">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <div class="ac-patient-field">
      <%- include('../partials/phone-field', {
        id: 'identifier',
        label: 'Phone or email',
        required: true,
        identifierMode: true,
        identifierName: 'identifier',
        defaultCountry: (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || 'ZM',
        selectedCountry: (typeof phoneCountry !== 'undefined' && phoneCountry) || (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || 'ZM',
        nationalValue: '',
        countries: (typeof phoneCountries !== 'undefined' && phoneCountries) || [],
        phoneValidationRelaxed: typeof phoneValidationRelaxed !== 'undefined' && phoneValidationRelaxed,
        placeholder: '97 123 4567 or email',
        showLegacyHidden: false
      }) %>
    </div>
    <button type="submit" class="ac-patient-btn ac-btn ac-btn--primary">Request reset</button>
  </form>
  <div class="ac-patient-honesty">
    <p><strong>Note:</strong> Automated password reset delivery is currently unavailable. Please contact the clinic directly for assistance.</p>
  </div>
  <p class="ac-patient-links">
    <a href="/clinics/<%= clinicKey %>/patient/login">Back to sign in</a>
    ·
    <a href="/clinics/<%= clinicKey %>/patient/recovery-verification">About recovery verification</a>
  </p>
</section>
