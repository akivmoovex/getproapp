<section class="acp-auth-card ac-patient-card ac-patient-card--auth acp-confirmation-panel__card" data-ac-page-section="patient-password-updated">
  <header class="acp-auth-card__header">
    <p class="ac-public-eyebrow">Patient portal</p>
    <h1>Password updated</h1>
    <p class="acp-auth-card__lede">Your password has been changed successfully. Sign in with your new password to continue.</p>
  </header>
  <p class="ac-patient-links ac-public-actions">
    <a href="/clinics/<%= clinicKey %>/patient/login" class="ac-patient-btn ac-btn ac-btn--primary">Sign in</a>
  </p>
</section>
