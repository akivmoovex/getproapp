<section class="acw-page" data-ac-page-section="clinic-directory" data-ac-acw-screen="ACW02">
  <header class="acw-section acw-section-header">
    <p class="acw-kicker">Clinic directory</p>
    <h1>Find Your Care</h1>
    <p>Search clinics that have published a public listing on ActiveClinic. Unpublished clinics are never shown.</p>
  </header>

  <div class="acw-section" style="padding-top:0">
    <form class="acw-search" method="get" action="/clinics" role="search" data-ac-directory-search="1">
      <div>
        <label for="q">Clinic name</label>
        <input id="q" name="q" type="search" value="<%= typeof search === 'string' ? search : '' %>" placeholder="Clinic name or keyword"/>
      </div>
      <div>
        <label for="location">Location</label>
        <input id="location" name="location" type="search" value="<%= typeof location === 'string' ? location : '' %>" placeholder="City or province"/>
      </div>
      <div>
        <label for="service">Service</label>
        <input id="service" name="service" type="search" value="<%= typeof service === 'string' ? service : '' %>" placeholder="Service name, if listed"/>
      </div>
      <% if (typeof province === 'string' && province) { %><input type="hidden" name="province" value="<%= province %>"/><% } %>
      <% if (typeof city === 'string' && city) { %><input type="hidden" name="city" value="<%= city %>"/><% } %>
      <button type="submit" class="ac-btn ac-btn--primary">Search Directory</button>
    </form>

    <div class="ac-directory-search-layout">
      <aside class="ac-directory-filters-sidebar" aria-label="Filters">
        <%- include('../partials/public-directory-filters', {
          filterFormAction: '/clinics',
          filterTitle: 'Filters',
          hideSearch: true,
          hideClose: true,
          search: typeof search === 'string' ? search : '',
          location: typeof location === 'string' ? location : '',
          service: typeof service === 'string' ? service : '',
          province: typeof province === 'string' ? province : '',
          city: typeof city === 'string' ? city : '',
        }) %>
      </aside>

      <div class="ac-directory-search-main">
        <button type="button" class="ac-btn ac-btn--secondary ac-directory-filters-toggle ac-directory-filters-toggle--mobile" data-ac-filter-open aria-expanded="false" aria-controls="ac-directory-filter-drawer">
          Filters
        </button>
        <aside id="ac-directory-filter-drawer" class="ac-directory-filter-drawer" data-ac-filter-drawer hidden>
          <div class="ac-directory-filter-drawer__backdrop" data-ac-filter-close tabindex="-1" aria-hidden="true"></div>
          <div class="ac-directory-filter-drawer__panel" role="dialog" aria-modal="true" aria-label="Filter clinics">
            <%- include('../partials/public-directory-filters', {
              filterFormAction: '/clinics',
              search: typeof search === 'string' ? search : '',
              location: typeof location === 'string' ? location : '',
              service: typeof service === 'string' ? service : '',
              province: typeof province === 'string' ? province : '',
              city: typeof city === 'string' ? city : '',
            }) %>
          </div>
        </aside>

        <% const list = Array.isArray(clinics) ? clinics : []; %>
        <% const dirState = typeof directoryState === 'string' ? directoryState : 'ready'; %>

        <% if (dirState === 'loading' || dirState === 'error' || (dirState === 'ready' && !list.length)) { %>
        <%- include('../partials/public-directory-state', {
          directoryState: dirState,
          directoryEmpty: typeof directoryEmpty !== 'undefined' ? directoryEmpty : !list.length,
          search: typeof search === 'string' ? search : '',
          location: typeof location === 'string' ? location : '',
          service: typeof service === 'string' ? service : '',
          province: typeof province === 'string' ? province : '',
          city: typeof city === 'string' ? city : '',
        }) %>
        <% } else { %>
        <p class="ac-directory-result-count" data-ac-result-count="<%= list.length %>"><%= list.length %> clinic<%= list.length === 1 ? '' : 's' %> found</p>
        <ul class="acw-clinic-grid ac-clinic-cards">
          <% list.forEach(function(c) { %>
          <%- include('../partials/public-clinic-card', { c: c }) %>
          <% }) %>
        </ul>
        <% } %>
      </div>
    </div>
  </div>
</section>
