<section class="acw-page acw-register ac-directory-state ac-directory-state--error" data-ac-page-section="register-clinic-server-error" data-ac-acw-screen="ACW09-error">
  <h1>Something went wrong</h1>
  <p class="ac-directory-state__text">We could not save your application right now. Your information was not submitted. Please try again in a few minutes.</p>
  <% if (typeof requestId === 'string' && requestId) { %>
  <p class="ac-public-note">Reference: <code data-ac-request-id="<%= requestId %>"><%= requestId %></code></p>
  <% } %>
  <% if (typeof schemaHint === 'boolean' && schemaHint) { %>
  <p class="ac-public-note">The registration service is temporarily unavailable while database setup is completed. Your details were not stored.</p>
  <% } %>
  <p class="ac-public-note">If the problem continues, contact your ActiveClinic representative or return to the registration form and try again.</p>
  <div class="ac-directory-state__actions">
    <a class="ac-btn ac-btn--primary" href="/register-clinic">Back to registration</a>
    <a class="ac-btn ac-btn--secondary" href="/about">About ActiveClinic</a>
  </div>
</section>
