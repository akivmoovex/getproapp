<%
  var bi = typeof buildInfo === "object" && buildInfo ? buildInfo : {
    productVersion: "1.3",
    version: "1.03.(unavailable)",
    build: "(unavailable)",
    available: false,
    environmentLabel: "Production",
    environment: "production",
    platformLine: "v7"
  };
  var envIsTesting = bi.environment === "testing";
  var productLabel = bi.productVersion || "1.3";
  var isV8About = bi.platformLine === "v8";
  var versionDisplay = isV8About
    ? (bi.productVersionLabel || ("Version " + productLabel))
    : bi.version;
%>
<article class="acw-page ac-about-v11" data-ac-page-section="public-about" data-ac-acw-screen="ACW06" data-product="ActiveClinic">
  <div class="ac-about-v11__inner">
    <section class="ac-about-v11__hero" aria-labelledby="ac-about-heading">
      <nav class="ac-about-v11__crumb ac-about-v11__desktop-only" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        <span aria-current="page">About</span>
      </nav>
      <p class="ac-about-v11__badge">
        <span class="ac-about-v11__badge-dot" aria-hidden="true"></span>
        <span class="ac-about-v11__desktop-only">System Overview &amp; Specifications</span>
        <span class="ac-about-v11__mobile-only">System Overview</span>
      </p>
      <h1 id="ac-about-heading">About ActiveClinic</h1>
      <p class="ac-about-v11__subtitle">Digital tools for modern clinic operations and patient services.</p>
    </section>

    <section class="ac-about-v11__intro" aria-labelledby="ac-about-intro-title">
      <div class="ac-about-v11__intro-card">
        <div class="ac-about-v11__intro-icon" aria-hidden="true">
          <span class="material-symbols-outlined ac-about-v11__desktop-only">health_and_safety</span>
          <span class="material-symbols-outlined ac-about-v11__mobile-only">medical_services</span>
        </div>
        <div class="ac-about-v11__intro-body">
          <div class="ac-about-v11__intro-title-row ac-about-v11__desktop-only">
            <h2 id="ac-about-intro-title">ActiveClinic Core Suite</h2>
            <span class="ac-about-v11__intro-tag">Enterprise v<%= productLabel %></span>
          </div>
          <p>ActiveClinic provides healthcare facilities with tools for managing patients, appointments, clinical operations, pharmacy, diagnostics, billing and their public digital presence.</p>
        </div>
        <div class="ac-about-v11__intro-pill ac-about-v11__desktop-only" aria-hidden="true">
          <span class="material-symbols-outlined">verified_user</span>
          <span>HIPAA &amp; SOC-2 Calibrated</span>
        </div>
      </div>
    </section>

    <section class="ac-about-v11__system" aria-labelledby="ac-about-system-heading">
      <div class="ac-about-v11__system-card">
        <header class="ac-about-v11__system-head">
          <div class="ac-about-v11__system-head-main">
            <span class="material-symbols-outlined" aria-hidden="true">terminal</span>
            <h2 id="ac-about-system-heading">
              <span class="ac-about-v11__desktop-only">Clinical Build Diagnostics</span>
              <span class="ac-about-v11__mobile-only">System Information</span>
            </h2>
            <span class="ac-about-v11__verified ac-about-v11__desktop-only">
              <span class="material-symbols-outlined" aria-hidden="true">format_image_left</span>
              Verified Clinical Build
            </span>
          </div>
          <p class="ac-about-v11__status-pill" role="status">
            <span class="ac-about-v11__status-dot" aria-hidden="true"></span>
            <span class="ac-about-v11__desktop-only">Operational</span>
            <span class="ac-about-v11__mobile-only"><%= bi.environmentLabel %></span>
          </p>
        </header>

        <div class="ac-about-v11__meta-grid">
          <div class="ac-about-v11__meta-tile">
            <span class="ac-about-v11__meta-label">Product</span>
            <p class="ac-about-v11__meta-value">
              <span class="material-symbols-outlined ac-about-v11__desktop-only" aria-hidden="true">domain</span>
              <span class="ac-about-v11__product-name">ActiveClinic</span>
            </p>
          </div>
          <div class="ac-about-v11__meta-tile">
            <span class="ac-about-v11__meta-label">Version</span>
            <p class="ac-about-v11__meta-value ac-about-v11__meta-value--version">
              <% if (isV8About) { %>
              <%= versionDisplay %>
              <% } else { %>
              <span class="ac-about-v11__version-prefix ac-about-v11__mobile-only">Version </span><%= versionDisplay %>
              <% } %>
            </p>
          </div>
          <div class="ac-about-v11__meta-tile">
            <span class="ac-about-v11__meta-label"><span class="ac-about-v11__desktop-only">Build Commit</span><span class="ac-about-v11__mobile-only">Build</span></span>
            <div class="ac-about-v11__build-row">
              <code class="ac-about-v11__build" id="ac-about-build"><%= bi.build %></code>
              <button type="button" class="ac-about-v11__copy" data-copy-target="ac-about-build" aria-label="Copy build SHA">
                <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
              </button>
            </div>
          </div>
          <div class="ac-about-v11__meta-tile">
            <span class="ac-about-v11__meta-label">Environment</span>
            <p class="ac-about-v11__meta-value ac-about-v11__meta-value--env">
              <span class="ac-about-v11__env-dot<%= envIsTesting ? ' ac-about-v11__env-dot--testing' : '' %>" aria-hidden="true"></span>
              <%= bi.environmentLabel %>
            </p>
          </div>
        </div>

        <footer class="ac-about-v11__system-foot">
          <p>
            <span class="material-symbols-outlined" aria-hidden="true">info</span>
            Dynamic versioning data injected automatically from Git deployment pipeline.
          </p>
          <% if (envIsTesting) { %>
          <p>
            <span class="material-symbols-outlined" aria-hidden="true">description</span>
            <a href="/release-notes">ActiveClinic Release Notes</a>
            · Testing hub only (sanitized public notes).
          </p>
          <% } %>
        </footer>
      </div>
    </section>

    <section class="ac-about-v11__caps" aria-labelledby="ac-about-caps-heading">
      <header class="ac-about-v11__caps-head">
        <h2 id="ac-about-caps-heading">
          <span class="ac-about-v11__desktop-only">Platform Information</span>
          <span class="ac-about-v11__mobile-only">Platform Capabilities</span>
        </h2>
        <p class="ac-about-v11__caps-lede ac-about-v11__desktop-only">Clinical modules and operational infrastructure</p>
        <p class="ac-about-v11__caps-lede ac-about-v11__mobile-only">6 Operational Modules</p>
      </header>
      <div class="ac-about-v11__caps-grid">
        <article class="ac-about-v11__cap-card">
          <div class="ac-about-v11__cap-icon" aria-hidden="true"><span class="material-symbols-outlined">clinical_notes</span></div>
          <h3>Patient Management</h3>
          <p class="ac-about-v11__desktop-only">Comprehensive EHR, demographics &amp; consent</p>
          <p class="ac-about-v11__mobile-only">Records, clinical histories &amp; demographics</p>
          <div class="ac-about-v11__cap-foot ac-about-v11__desktop-only">
            <span>Module ID: PM-01</span>
            <span class="ac-about-v11__active"><span aria-hidden="true"></span> Active</span>
          </div>
        </article>
        <article class="ac-about-v11__cap-card">
          <div class="ac-about-v11__cap-icon" aria-hidden="true"><span class="material-symbols-outlined">event_available</span></div>
          <h3>Appointments</h3>
          <p class="ac-about-v11__desktop-only">Multi-provider scheduling &amp; queue tracking</p>
          <p class="ac-about-v11__mobile-only">Provider calendars, triage queues &amp; bookings</p>
          <div class="ac-about-v11__cap-foot ac-about-v11__desktop-only">
            <span>Module ID: AP-02</span>
            <span class="ac-about-v11__active"><span aria-hidden="true"></span> Active</span>
          </div>
        </article>
        <article class="ac-about-v11__cap-card">
          <div class="ac-about-v11__cap-icon" aria-hidden="true"><span class="material-symbols-outlined">stethoscope</span></div>
          <h3>Clinical Services</h3>
          <p class="ac-about-v11__desktop-only">Consultations, triage &amp; care pathways</p>
          <p class="ac-about-v11__mobile-only">Charting, EHR encounter notes &amp; care plans</p>
          <div class="ac-about-v11__cap-foot ac-about-v11__desktop-only">
            <span>Module ID: CS-03</span>
            <span class="ac-about-v11__active"><span aria-hidden="true"></span> Active</span>
          </div>
        </article>
        <article class="ac-about-v11__cap-card">
          <div class="ac-about-v11__cap-icon" aria-hidden="true"><span class="material-symbols-outlined">medication</span></div>
          <h3>Pharmacy &amp; Diagnostics</h3>
          <p class="ac-about-v11__desktop-only">Lab orders, e-prescriptions &amp; inventory</p>
          <p class="ac-about-v11__mobile-only">e-Prescriptions, lab orders &amp; pathology sync</p>
          <div class="ac-about-v11__cap-foot ac-about-v11__desktop-only">
            <span>Module ID: PD-04</span>
            <span class="ac-about-v11__active"><span aria-hidden="true"></span> Active</span>
          </div>
        </article>
        <article class="ac-about-v11__cap-card">
          <div class="ac-about-v11__cap-icon" aria-hidden="true"><span class="material-symbols-outlined">payments</span></div>
          <h3>Billing</h3>
          <p class="ac-about-v11__desktop-only">Claims processing, invoicing &amp; payment tracking</p>
          <p class="ac-about-v11__mobile-only">Claims submission, fee schedules &amp; invoices</p>
          <div class="ac-about-v11__cap-foot ac-about-v11__desktop-only">
            <span>Module ID: BL-05</span>
            <span class="ac-about-v11__active"><span aria-hidden="true"></span> Active</span>
          </div>
        </article>
        <article class="ac-about-v11__cap-card">
          <div class="ac-about-v11__cap-icon" aria-hidden="true"><span class="material-symbols-outlined">web</span></div>
          <h3>Clinic Website</h3>
          <p class="ac-about-v11__desktop-only">Patient portal &amp; public appointment booking</p>
          <p class="ac-about-v11__mobile-only">Public discovery, intake forms &amp; branding</p>
          <div class="ac-about-v11__cap-foot ac-about-v11__desktop-only">
            <span>Module ID: CW-06</span>
            <span class="ac-about-v11__active"><span aria-hidden="true"></span> Active</span>
          </div>
        </article>
      </div>
    </section>

    <section class="ac-about-v11__support-bar ac-about-v11__desktop-only" aria-label="Support links">
      <p>
        <span class="material-symbols-outlined" aria-hidden="true">support_agent</span>
        Need clinical infrastructure support or custom SLA?
      </p>
      <ul>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Service</a></li>
        <li><a href="/contact">Contact / Support</a></li>
        <li><a href="/">Home</a></li>
      </ul>
    </section>

    <nav class="ac-about-v11__governance ac-about-v11__mobile-only" aria-label="Governance and support">
      <h2>Governance &amp; Support</h2>
      <a href="/privacy"><span class="material-symbols-outlined" aria-hidden="true">policy</span> Privacy Policy <span class="material-symbols-outlined" aria-hidden="true">arrow_forward_ios</span></a>
      <a href="/terms"><span class="material-symbols-outlined" aria-hidden="true">gavel</span> Terms of Service <span class="material-symbols-outlined" aria-hidden="true">arrow_forward_ios</span></a>
      <a href="/contact"><span class="material-symbols-outlined" aria-hidden="true">support_agent</span> Contact / Support <span class="material-symbols-outlined" aria-hidden="true">arrow_forward_ios</span></a>
      <a href="/"><span class="material-symbols-outlined" aria-hidden="true">home</span> Home <span class="material-symbols-outlined" aria-hidden="true">arrow_forward_ios</span></a>
    </nav>

    <p class="ac-about-v11__ops-bar ac-about-v11__mobile-only" role="status">
      <span class="ac-about-v11__status-dot" aria-hidden="true"></span>
      All Clinical Microservices Operational
    </p>
  </div>
</article>

<script>
(function () {
  var buttons = document.querySelectorAll(".ac-about-v11__copy[data-copy-target]");
  buttons.forEach(function (btn) {
    btn.addEventListener("click", function () {
      var id = btn.getAttribute("data-copy-target");
      var el = id ? document.getElementById(id) : null;
      var text = el ? (el.textContent || "").trim() : "";
      if (!text || !navigator.clipboard) return;
      navigator.clipboard.writeText(text).catch(function () {});
    });
  });
})();
</script>
