<section class="ac-public-section" data-ac-page-section="register-clinic-success" data-ac-state-key="<%= typeof reviewRequired !== 'undefined' && reviewRequired ? 'review_required' : (typeof ready !== 'undefined' && ready ? 'ready' : 'success_terminal') %>">
  <ol class="ac-onboarding-steps" aria-label="Registration progress">
    <li class="ac-onboarding-steps__item ac-onboarding-steps__item--done">Details</li>
    <li class="ac-onboarding-steps__item ac-onboarding-steps__item--done">Review</li>
    <li class="ac-onboarding-steps__item ac-onboarding-steps__item--active" aria-current="step"><%= typeof reviewRequired !== 'undefined' && reviewRequired ? 'Review' : (typeof ready !== 'undefined' && ready ? 'Ready' : 'Submitted') %></li>
  </ol>

  <% if (typeof reviewRequired !== 'undefined' && reviewRequired) { %>
  <div class="ac-success-panel" data-ac-registration-outcome="review_required">
    <h1>Registration received — review required</h1>
    <p>Your clinic registration needs a short review before it can be activated. This is uncommon and does not mean your details were rejected.</p>
    <% if (typeof applicationReference === 'string' && applicationReference) { %>
    <p>Reference: <code data-ac-application-ref="<%= applicationReference %>"><%= applicationReference %></code></p>
    <% } %>
  </div>
  <div class="ac-public-note">
    <h2 class="ac-success-panel__subtitle">What happens next</h2>
    <ul class="ac-public-list">
      <li>Platform Admin will review this exceptional registration.</li>
      <li>Your clinic is not active yet and you cannot sign in until review completes.</li>
      <li>Keep your application number to check status.</li>
    </ul>
  </div>
  <p class="ac-public-actions">
    <a class="ac-btn ac-btn--primary" href="/register-clinic/status<%= typeof applicationReference === 'string' && applicationReference ? ('?ref=' + encodeURIComponent(applicationReference)) : '' %>" data-ac-status-lookup-link="1">Check application status</a>
    <a class="ac-btn ac-btn--secondary" href="/">Return home</a>
  </p>
  <% } else if (typeof ready !== 'undefined' && ready) { %>
  <div class="ac-success-panel" data-ac-registration-outcome="ready">
    <h1>Registration successful</h1>
    <p>Your clinic organisation has been created and the administrator account is active. You can continue to onboarding now.</p>
    <% if (typeof applicationReference === 'string' && applicationReference) { %>
    <p>Reference: <code data-ac-application-ref="<%= applicationReference %>"><%= applicationReference %></code></p>
    <% } %>
  </div>
  <div class="ac-public-note">
    <h2 class="ac-success-panel__subtitle">What happens next</h2>
    <ul class="ac-public-list">
      <li>Sign in with the email or phone and password you just set.</li>
      <li>Complete clinic setup from your dashboard.</li>
      <li>Your public clinic website stays unpublished until you choose to publish it.</li>
    </ul>
  </div>
  <p class="ac-public-actions">
    <a class="ac-btn ac-btn--primary" href="/app" data-ac-continue-onboarding="1">Continue to dashboard</a>
    <a class="ac-btn ac-btn--secondary" href="/login">Go to sign in</a>
    <a class="ac-btn ac-btn--secondary" href="/">Return home</a>
  </p>
  <% } else { %>
  <div class="ac-success-panel" data-ac-registration-outcome="recorded">
    <h1>Application received</h1>
    <p>Thank you. Your clinic registration has been recorded.</p>
    <% if (typeof applicationReference === 'string' && applicationReference) { %>
    <p>Reference: <code data-ac-application-ref="<%= applicationReference %>"><%= applicationReference %></code></p>
    <% } %>
  </div>
  <p class="ac-public-actions">
    <a class="ac-btn ac-btn--primary" href="/register-clinic/status<%= typeof applicationReference === 'string' && applicationReference ? ('?ref=' + encodeURIComponent(applicationReference)) : '' %>" data-ac-status-lookup-link="1">Check application status</a>
    <a class="ac-btn ac-btn--secondary" href="/login">Go to sign in</a>
  </p>
  <% } %>
</section>
