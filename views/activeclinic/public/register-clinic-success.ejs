<section class="ac-public-section" data-ac-page-section="register-clinic-success" data-ac-state-key="success_terminal">
  <ol class="ac-onboarding-steps" aria-label="Registration progress">
    <li class="ac-onboarding-steps__item ac-onboarding-steps__item--done">Details</li>
    <li class="ac-onboarding-steps__item ac-onboarding-steps__item--done">Review</li>
    <li class="ac-onboarding-steps__item ac-onboarding-steps__item--active" aria-current="step">Submitted</li>
  </ol>

  <div class="ac-success-panel">
    <h1>Application received</h1>
    <p>Thank you. Your clinic registration has been recorded and is <strong>pending review</strong>. Your administrator password is saved and will be activated if the application is approved.</p>
    <% if (typeof applicationReference === 'string' && applicationReference) { %>
    <p>Reference: <code data-ac-application-ref="<%= applicationReference %>"><%= applicationReference %></code></p>
    <% } %>
  </div>

  <div class="ac-public-note">
    <h2 class="ac-success-panel__subtitle">What happens next</h2>
    <ul class="ac-public-list">
      <li>Our team will review your application. This may take several business days.</li>
      <li>We have <strong>not</strong> published your clinic website yet.</li>
      <li>After approval you can sign in at <a href="/login">Email or phone number</a> with the password you set.</li>
      <li>We have <strong>not</strong> sent SMS, WhatsApp, or email confirmation from this form.</li>
    </ul>
  </div>

  <p class="ac-public-actions">
    <a class="ac-btn ac-btn--primary" href="/login">Go to sign in</a>
    <a class="ac-btn ac-btn--secondary" href="/">Return home</a>
  </p>
</section>
