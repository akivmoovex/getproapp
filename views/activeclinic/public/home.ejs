<section class="acw-hero" data-ac-page-section="public-home" data-ac-acw-screen="ACW01">
  <div class="acw-hero__copy">
    <p class="acw-kicker">Healthcare platform for Zambia</p>
    <h1>Healthcare precision. <span class="acw-accent">Human warmth.</span></h1>
    <p class="acw-hero__lede">ActiveClinic helps clinics run day-to-day operations and publish a public website. Patients can find participating clinics and request appointments where a clinic has enabled booking.</p>
    <p class="ac-public-actions">
      <a class="ac-btn ac-btn--primary" href="/clinics">Find a Clinic</a>
      <a class="ac-btn ac-btn--secondary" href="/register-clinic">Register Your Clinic</a>
    </p>
  </div>
  <div class="acw-hero__media">
    <% const platformHeroMedia = (typeof platformHero === 'object' && platformHero) ? platformHero : { src: '/activeclinic/assets/platform/home-hero.jpg', objectPosition: 'center 35%' }; %>
    <%- include('../partials/ac-media', {
      src: platformHeroMedia.src,
      alt: '',
      decorative: true,
      className: 'acp-hero__image',
      objectFit: 'cover',
      objectPosition: platformHeroMedia.objectPosition || 'center 35%',
      aspect: '16 / 10',
      width: 960,
      height: 600,
      loading: 'eager',
    }) %>
    <div class="acw-hero__panel">
      <span class="acp-hero__panel-label">Built for Zambian clinics</span>
      <strong>Phone formats, provinces, and staff workflows designed for local teams</strong>
    </div>
  </div>
</section>

<section class="acw-section" data-ac-home-section="what-is">
  <header class="acw-section-header">
    <h2>What is ActiveClinic?</h2>
    <p>A clinic operations application plus an optional public website. Clinical records stay behind staff sign-in.</p>
  </header>
  <div class="acw-grid acw-grid--4" data-ac-home-section="platform-capabilities">
    <article class="acw-card">
      <h3>Staff operations</h3>
      <p>Patients, appointments, reception, and organisation settings after authorised staff sign in.</p>
      <span class="ac-capability-badge ac-capability-badge--available">Available</span>
    </article>
    <article class="acw-card">
      <h3>Published clinic websites</h3>
      <p>Clinics that publish can show services, doctors, contact details, and policies on their own site.</p>
      <span class="ac-capability-badge ac-capability-badge--available">Available</span>
    </article>
    <article class="acw-card">
      <h3>Directory discovery</h3>
      <p>Search clinics that have chosen to appear in the public directory — unpublished clinics stay hidden.</p>
      <span class="ac-capability-badge ac-capability-badge--available">Available</span>
    </article>
    <article class="acw-card">
      <h3>Responsive access</h3>
      <p>Public pages and staff tools work on phones and desktops. No extra app download is required.</p>
      <span class="ac-capability-badge ac-capability-badge--available">Available</span>
    </article>
  </div>
</section>

<section class="acw-section acw-section--band" data-ac-home-section="patient-benefits">
  <div class="acw-section__inner">
    <header class="acw-section-header">
      <h2>For patients and families</h2>
      <p>Find participating clinics. Booking is available only where a clinic has enabled it, and requests are reviewed by clinic staff.</p>
    </header>
    <div class="acw-grid acw-grid--3">
      <article class="acw-card">
        <h3>Find a clinic</h3>
        <p>Search published listings by name, location, or services the clinic has chosen to show.</p>
      </article>
      <article class="acw-card">
        <h3>Request an appointment</h3>
        <p>Where enabled, submit a preferred time. This is not an automatic confirmation.</p>
      </article>
      <article class="acw-card">
        <h3>Use your booking link</h3>
        <p>If a clinic provides a booking link, you can check request status from that link.</p>
      </article>
    </div>
    <p class="ac-public-actions" style="justify-content:center;margin-top:1.25rem">
      <a class="ac-btn ac-btn--primary" href="/for-patients">How it works for patients</a>
    </p>
  </div>
</section>

<section class="acw-section" data-ac-home-section="clinic-benefits">
  <header class="acw-section-header">
    <h2>For clinics</h2>
    <p>Register your organisation, run staff workflows, and publish a public website when you are ready.</p>
  </header>
  <div class="acw-grid acw-grid--3">
    <article class="acw-card">
      <h3>Operations in one place</h3>
      <p>Secure tools for enrolled teams. Public pages never show clinical charts.</p>
    </article>
    <article class="acw-card">
      <h3>Your clinic website</h3>
      <p>Edit pages, media, branding, and publishing from website management — included with an ActiveClinic organisation.</p>
    </article>
    <article class="acw-card">
      <h3>Honest product labels</h3>
      <p>Available, Pilot, and Planned capabilities are labelled clearly. We do not invent live slot calendars or SMS delivery.</p>
    </article>
  </div>
  <p class="ac-public-actions" style="justify-content:center;margin-top:1.25rem">
    <a class="ac-btn ac-btn--primary" href="/for-clinics">Explore clinic tools</a>
    <a class="ac-btn ac-btn--ghost" href="/clinic-website">Clinic websites</a>
  </p>
</section>

<section class="acw-cta-band" data-ac-home-section="final-cta">
  <div class="acw-cta-band__inner">
    <h2>Ready to get started?</h2>
    <p>Find a participating clinic or register your clinic on ActiveClinic.</p>
    <p class="ac-public-actions">
      <a class="ac-btn ac-btn--primary" href="/clinics">Find a Clinic</a>
      <a class="ac-btn ac-btn--secondary" href="/register-clinic">Register Your Clinic</a>
    </p>
  </div>
</section>

<section class="acw-section ac-public-privacy-note" data-ac-home-section="privacy">
  <h2>Privacy and honesty</h2>
  <p>ActiveClinic does not expose medical records on this public website. We do not claim real-time appointment availability or automated SMS delivery. Clinic websites stay unpublished until the clinic publishes them. Capabilities marked <strong>Pilot</strong> or <strong>Planned</strong> are labelled clearly.</p>
</section>
