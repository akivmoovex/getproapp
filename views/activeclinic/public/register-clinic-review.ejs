<% const fd = formData || {}; %>
<% const verr = validationErrors || {}; %>
<section
  class="acw-page acw-register"
  data-ac-page-section="register-clinic-review"
  data-ac-acw-screen="ACW09-review"
  data-ac-acw-step="review"
>
  <%- include('../partials/register-clinic-steps') %>

  <header class="acw-section acw-section-header acw-register__header">
    <p class="acw-kicker">Register clinic</p>
    <h1>Review your details</h1>
    <p>Check your details before creating your clinic. You can go back to edit if something is wrong.</p>
  </header>

  <% if (typeof error === 'string' && error) { %>
  <div class="ac-public-error acw-register__alert" role="alert"><%= error %></div>
  <% } %>
  <% if (verr.acceptTerms) { %>
  <div class="ac-public-validation-summary acw-register__alert" role="alert" data-ac-form-state="validation_error">
    <h2 class="ac-public-validation-summary__title">Please fix the following</h2>
    <ul class="ac-public-validation-summary__list">
      <li><a href="#acceptTerms"><%= verr.acceptTerms %></a></li>
    </ul>
  </div>
  <% } %>

  <dl class="ac-review-summary acw-register__summary">
    <div class="ac-review-summary__row">
      <dt>Clinic name</dt>
      <dd><%= fd.clinicName || '—' %></dd>
    </div>
    <div class="ac-review-summary__row">
      <dt>Clinic type</dt>
      <dd><%= fd.clinicTypeLabel || fd.clinicType || '—' %></dd>
    </div>
    <div class="ac-review-summary__row">
      <dt>Country</dt>
      <dd><%= fd.countryCode || '—' %></dd>
    </div>
    <% if (fd.province || fd.city || fd.address) { %>
    <div class="ac-review-summary__row">
      <dt>Location</dt>
      <dd><%= [fd.address, fd.city, fd.province].filter(Boolean).join(', ') %></dd>
    </div>
    <% } %>
    <div class="ac-review-summary__row">
      <dt>Administrator name</dt>
      <dd><%= fd.contactName || '—' %></dd>
    </div>
    <div class="ac-review-summary__row">
      <dt>Phone</dt>
      <dd><%= fd.contactPhone || '—' %></dd>
    </div>
    <div class="ac-review-summary__row">
      <dt>Email</dt>
      <dd><%= fd.contactEmail || '—' %></dd>
    </div>
    <div class="ac-review-summary__row">
      <dt>Administrator password</dt>
      <dd>Set — used to sign in after registration</dd>
    </div>
    <% if (fd.notes) { %>
    <div class="ac-review-summary__row">
      <dt>Notes</dt>
      <dd><%= fd.notes %></dd>
    </div>
    <% } %>
  </dl>

  <p class="ac-public-note acw-register__note">Creating your clinic sets up your organisation, facility, administrator account, and website foundation immediately. You can sign in after registration. Your public clinic website starts unpublished until you customize and publish it from Website Management.</p>

  <div class="ac-review-actions acw-register__actions">
    <form method="post" action="/register-clinic" class="ac-review-actions__confirm">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <input type="hidden" name="action" value="confirm"/>
      <%- include('../partials/register-clinic-hidden-fields') %>
      <div class="ac-form-field ac-form-field--checkbox<%= verr.acceptTerms ? ' ac-form-field--error' : '' %>">
        <label class="ac-form-checkbox" for="acceptTerms">
          <input
            id="acceptTerms"
            name="acceptTerms"
            type="checkbox"
            value="on"
            data-ac-terms-checkbox="1"
            aria-required="true"
            aria-invalid="<%= verr.acceptTerms ? 'true' : 'false' %>"
            <% if (verr.acceptTerms) { %>aria-describedby="acceptTerms-error"<% } %>
          />
          <span>I have read and agree to the ActiveClinic <a href="/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a> and acknowledge the <a href="/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.</span>
        </label>
        <% if (verr.acceptTerms) { %><p class="ac-form-field__error" id="acceptTerms-error"><%= verr.acceptTerms %></p><% } %>
      </div>
      <button type="submit" class="ac-btn ac-btn--primary">Create clinic</button>
    </form>
    <form method="post" action="/register-clinic" class="acw-register__edit">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <%- include('../partials/register-clinic-hidden-fields') %>
      <button type="submit" class="ac-btn ac-btn--secondary" name="action" value="edit-clinic">Edit clinic information</button>
      <button type="submit" class="ac-btn ac-btn--secondary" name="action" value="edit-admin">Edit administrator information</button>
    </form>
  </div>
</section>
