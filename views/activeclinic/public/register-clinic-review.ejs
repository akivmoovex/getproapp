<section class="ac-public-section" data-ac-page-section="register-clinic-review">
  <ol class="ac-onboarding-steps" aria-label="Registration progress">
    <li class="ac-onboarding-steps__item ac-onboarding-steps__item--done">Details</li>
    <li class="ac-onboarding-steps__item ac-onboarding-steps__item--active" aria-current="step">Review</li>
    <li class="ac-onboarding-steps__item">Clinic created</li>
  </ol>

  <h1>Review your details</h1>
  <p>Check your details before creating your clinic. You can go back to edit if something is wrong.</p>

  <% if (typeof error === 'string' && error) { %>
  <div class="ac-public-error" role="alert"><%= error %></div>
  <% } %>
  <% const verr = validationErrors || {}; %>
  <% if (verr.acceptTerms) { %>
  <div class="ac-public-validation-summary" role="alert" data-ac-form-state="validation_error">
    <h2 class="ac-public-validation-summary__title">Please fix the following</h2>
    <ul class="ac-public-validation-summary__list">
      <li><a href="#acceptTerms"><%= verr.acceptTerms %></a></li>
    </ul>
  </div>
  <% } %>

  <% const fd = formData || {}; %>
  <dl class="ac-review-summary">
    <div class="ac-review-summary__row">
      <dt>Clinic name</dt>
      <dd><%= fd.clinicName || '—' %></dd>
    </div>
    <div class="ac-review-summary__row">
      <dt>Contact name</dt>
      <dd><%= fd.contactName || '—' %></dd>
    </div>
    <div class="ac-review-summary__row">
      <dt>Contact email</dt>
      <dd><%= fd.contactEmail || '—' %></dd>
    </div>
    <div class="ac-review-summary__row">
      <dt>Contact phone</dt>
      <dd><%= fd.contactPhone || '—' %></dd>
    </div>
    <% if (fd.province || fd.city || fd.address) { %>
    <div class="ac-review-summary__row">
      <dt>Location</dt>
      <dd><%= [fd.address, fd.city, fd.province].filter(Boolean).join(', ') %></dd>
    </div>
    <% } %>
    <div class="ac-review-summary__row">
      <dt>Administrator password</dt>
      <dd>Set — used to sign in after registration</dd>
    </div>
    <% if (fd.notes) { %>
    <div class="ac-review-summary__row">
      <dt>Notes</dt>
      <dd><%= fd.notes %></dd>
    </div>
    <% } %>
  </dl>

  <p class="ac-public-note">Creating your clinic sets up your organisation and administrator account immediately. You can sign in after registration. Your public clinic website remains unpublished until you choose to publish it.</p>

  <div class="ac-review-actions">
    <form method="post" action="/register-clinic" class="ac-review-actions__confirm">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <input type="hidden" name="action" value="confirm"/>
      <input type="hidden" name="clinicName" value="<%= fd.clinicName || '' %>"/>
      <input type="hidden" name="contactName" value="<%= fd.contactName || '' %>"/>
      <input type="hidden" name="contactEmail" value="<%= fd.contactEmail || '' %>"/>
      <input type="hidden" name="contactPhone" value="<%= fd.contactPhone || '' %>"/>
      <input type="hidden" name="phone_country" value="<%= fd.phoneCountry || fd.countryCode || 'ZM' %>"/>
      <input type="hidden" name="phone_national" value="<%= fd.phoneNational || '' %>"/>
      <input type="hidden" name="province" value="<%= fd.province || '' %>"/>
      <input type="hidden" name="city" value="<%= fd.city || '' %>"/>
      <input type="hidden" name="address" value="<%= fd.address || '' %>"/>
      <input type="hidden" name="countryCode" value="<%= fd.countryCode || 'ZM' %>"/>
      <input type="hidden" name="notes" value="<%= fd.notes || '' %>"/>
      <input type="hidden" name="password" value="<%= fd.password || '' %>"/>
      <input type="hidden" name="passwordConfirm" value="<%= fd.passwordConfirm || fd.password || '' %>"/>
      <div class="ac-form-field ac-form-field--checkbox<%= verr.acceptTerms ? ' ac-form-field--error' : '' %>">
        <label class="ac-form-checkbox" for="acceptTerms">
          <input
            id="acceptTerms"
            name="acceptTerms"
            type="checkbox"
            value="on"
            data-ac-terms-checkbox="1"
            aria-required="true"
            aria-invalid="<%= verr.acceptTerms ? 'true' : 'false' %>"
            <% if (verr.acceptTerms) { %>aria-describedby="acceptTerms-error"<% } %>
          />
          <span>I have read and agree to the ActiveClinic <a href="/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a> and acknowledge the <a href="/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.</span>
        </label>
        <% if (verr.acceptTerms) { %><p class="ac-form-field__error" id="acceptTerms-error"><%= verr.acceptTerms %></p><% } %>
      </div>
      <button type="submit" class="ac-btn ac-btn--primary">Create clinic</button>
    </form>
    <a class="ac-btn ac-btn--secondary" href="/register-clinic">Edit details</a>
  </div>
</section>
