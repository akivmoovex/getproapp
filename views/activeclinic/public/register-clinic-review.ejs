<section class="ac-public-section" data-ac-page-section="register-clinic-review">
  <ol class="ac-onboarding-steps" aria-label="Registration progress">
    <li class="ac-onboarding-steps__item ac-onboarding-steps__item--done">Details</li>
    <li class="ac-onboarding-steps__item ac-onboarding-steps__item--active" aria-current="step">Review</li>
    <li class="ac-onboarding-steps__item">Submitted</li>
  </ol>

  <h1>Review your application</h1>
  <p>Check your details before submitting. You can go back to edit if something is wrong.</p>

  <% const fd = formData || {}; %>
  <dl class="ac-review-summary">
    <div class="ac-review-summary__row">
      <dt>Clinic name</dt>
      <dd><%= fd.clinicName || '—' %></dd>
    </div>
    <div class="ac-review-summary__row">
      <dt>Contact name</dt>
      <dd><%= fd.contactName || '—' %></dd>
    </div>
    <div class="ac-review-summary__row">
      <dt>Contact email</dt>
      <dd><%= fd.contactEmail || '—' %></dd>
    </div>
    <div class="ac-review-summary__row">
      <dt>Contact phone</dt>
      <dd><%= fd.contactPhone || '—' %></dd>
    </div>
    <% if (fd.province || fd.city) { %>
    <div class="ac-review-summary__row">
      <dt>Location</dt>
      <dd><%= [fd.city, fd.province].filter(Boolean).join(', ') %></dd>
    </div>
    <% } %>
    <% if (fd.notes) { %>
    <div class="ac-review-summary__row">
      <dt>Notes</dt>
      <dd><%= fd.notes %></dd>
    </div>
    <% } %>
  </dl>

  <p class="ac-public-note">Submitting creates a pending application for review. Your clinic will <strong>not</strong> be published automatically and no confirmation SMS or email is sent from this form.</p>

  <div class="ac-review-actions">
    <form method="post" action="/register-clinic" class="ac-review-actions__confirm">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <input type="hidden" name="action" value="confirm"/>
      <input type="hidden" name="clinicName" value="<%= fd.clinicName || '' %>"/>
      <input type="hidden" name="contactName" value="<%= fd.contactName || '' %>"/>
      <input type="hidden" name="contactEmail" value="<%= fd.contactEmail || '' %>"/>
      <input type="hidden" name="contactPhone" value="<%= fd.contactPhone || '' %>"/>
      <input type="hidden" name="phone_country" value="<%= fd.phoneCountry || fd.countryCode || 'ZM' %>"/>
      <input type="hidden" name="phone_national" value="<%= fd.phoneNational || '' %>"/>
      <input type="hidden" name="province" value="<%= fd.province || '' %>"/>
      <input type="hidden" name="city" value="<%= fd.city || '' %>"/>
      <input type="hidden" name="countryCode" value="<%= fd.countryCode || 'ZM' %>"/>
      <input type="hidden" name="notes" value="<%= fd.notes || '' %>"/>
      <button type="submit" class="ac-btn ac-btn--primary">Submit application</button>
    </form>
    <a class="ac-btn ac-btn--secondary" href="/register-clinic">Edit details</a>
  </div>
</section>
