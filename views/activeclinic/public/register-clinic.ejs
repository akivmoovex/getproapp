<% const step = typeof wizardStep === 'string' ? wizardStep : 'clinic'; %>
<% const fd = formData || {}; %>
<% const verr = validationErrors || {}; %>
<% const types = Array.isArray(clinicTypeOptions) ? clinicTypeOptions : []; %>
<% const countries = typeof phoneCountries !== 'undefined' && Array.isArray(phoneCountries) ? phoneCountries : []; %>
<% const provinceOptions = typeof zambiaProvinces !== 'undefined' && Array.isArray(zambiaProvinces) ? zambiaProvinces : []; %>
<% const isZambia = String(fd.countryCode || 'ZM').toUpperCase() === 'ZM'; %>
<section
  class="acw-page acw-register acw-register--with-aside gp-reg"
  data-ac-page-section="register-clinic"
  data-gp-product="activeclinic"
  data-ac-acw-screen="<%= step === 'administrator' ? 'ACW09-admin' : 'ACW09-clinic' %>"
  data-ac-acw-step="<%= step %>"
  data-ac-mf-family="MF03"
  data-ac-mf-screen="<%= step === 'administrator' ? 'MF03-03' : 'MF03-01' %>"
>

  <% if (typeof error === 'string' && error) { %>
  <div class="ac-public-error acw-register__alert" role="alert"><%= error %></div>
  <% } %>

  <% if (typeof formState === 'string' && formState === 'validation_error') { %>
  <div class="ac-public-validation-summary acw-register__alert" role="alert" data-ac-form-state="validation_error">
    <h2 class="ac-public-validation-summary__title">Please fix the following</h2>
    <ul class="ac-public-validation-summary__list">
      <% Object.keys(verr).forEach(function(field) { %>
      <li><a href="#<%= field %>"><%= verr[field] %></a></li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <% if (step === 'administrator') { %>
  <div class="acw-register__layout">
    <%- include('../partials/register-aside-admin') %>
    <div class="acw-register__panel gp-reg__panel">
  <div class="acw-register__card gp-reg__card">
  <%- include('../partials/register-clinic-steps') %>
  <h2 class="gp-reg__form-heading">Administrator Details</h2>
  <p class="gp-reg__form-lede">Create the primary administrative account for this clinic.</p>
  <form method="post" action="/register-clinic" class="ac-public-form acw-form acw-register__form" data-ac-loading="1" novalidate data-ac-register-step="administrator" data-gp-registration-form="1"<% if (typeof formState === 'string' && formState === 'validation_error') { %> data-gp-registration-dirty="1"<% } %>>
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <input type="hidden" name="clinicName" value="<%= fd.clinicName || '' %>"/>
    <input type="hidden" name="clinicType" value="<%= fd.clinicType || '' %>"/>
    <input type="hidden" name="countryCode" value="<%= fd.countryCode || 'ZM' %>"/>
    <input type="hidden" name="province" value="<%= fd.province || '' %>"/>
    <input type="hidden" name="city" value="<%= fd.city || '' %>"/>
    <input type="hidden" name="address" value="<%= fd.address || '' %>"/>
    <input type="hidden" name="notes" value="<%= fd.notes || '' %>"/>

    <div class="acw-register__grid">
      <div class="ac-form-field<%= verr.contactName ? ' ac-form-field--error' : '' %>">
        <label for="contactName">Administrator name <span class="ac-required" aria-hidden="true">*</span><span class="ac-sr-only"> required</span></label>
        <input id="contactName" name="contactName" required aria-required="true" maxlength="120" autocomplete="name" placeholder="Jane Smith" value="<%= fd.contactName || '' %>" aria-invalid="<%= verr.contactName ? 'true' : 'false' %>"<% if (verr.contactName) { %> aria-describedby="contactName-error"<% } %>/>
        <% if (verr.contactName) { %><p class="ac-form-field__error" id="contactName-error"><%= verr.contactName %></p><% } %>
      </div>
      <div class="ac-form-field<%= verr.contactPhone ? ' ac-form-field--error' : '' %>">
        <%- include('../partials/phone-field', {
          id: 'contactPhone',
          label: 'Phone',
          required: true,
          defaultCountry: fd.countryCode || (typeof defaultPhoneCountry !== 'undefined' ? defaultPhoneCountry : 'ZM'),
          selectedCountry: (fd.phoneCountry || fd.contactPhoneCountry || fd.countryCode || defaultPhoneCountry || 'ZM'),
          nationalValue: fd.phoneNational || fd.contactPhoneNational || '',
          e164Value: fd.contactPhone || '',
          countries: countries,
          phoneValidationRelaxed: typeof phoneValidationRelaxed !== 'undefined' && phoneValidationRelaxed,
          countryFieldName: 'phone_country',
          nationalFieldName: 'phone_national',
          legacyFieldName: 'contactPhone',
          showLegacyHidden: true,
          error: verr.contactPhone || null,
          placeholder: '97 123 4567'
        }) %>
      </div>
    </div>
    <div class="ac-form-field<%= verr.contactEmail ? ' ac-form-field--error' : '' %>">
      <label for="contactEmail">Professional email address <span class="ac-required" aria-hidden="true">*</span><span class="ac-sr-only"> required</span></label>
      <input id="contactEmail" name="contactEmail" type="email" required aria-required="true" autocomplete="email" placeholder="jane.smith@clinic.example" value="<%= fd.contactEmail || '' %>" aria-invalid="<%= verr.contactEmail ? 'true' : 'false' %>"<% if (verr.contactEmail) { %> aria-describedby="contactEmail-error"<% } %>/>
      <% if (verr.contactEmail) { %><p class="ac-form-field__error" id="contactEmail-error"><%= verr.contactEmail %></p><% } %>
      <p class="ac-form-hint">Required for this registration path. Sign in uses email or phone.</p>
    </div>
    <div class="acw-register__grid">
      <div class="ac-form-field<%= verr.password ? ' ac-form-field--error' : '' %>">
        <label for="password">Password <span class="ac-required" aria-hidden="true">*</span><span class="ac-sr-only"> required</span></label>
        <div class="acw-register__pw-wrap">
          <input id="password" name="password" type="password" required aria-required="true" autocomplete="new-password" minlength="10" maxlength="200" aria-invalid="<%= verr.password ? 'true' : 'false' %>"<% if (verr.password) { %> aria-describedby="password-error password-policy"<% } else { %> aria-describedby="password-policy"<% } %>/>
          <button type="button" class="acw-register__pw-toggle" data-ac-toggle-password="password" aria-label="Show password" aria-pressed="false">
            <span class="material-symbols-outlined" aria-hidden="true">visibility_off</span>
          </button>
        </div>
        <% if (verr.password) { %><p class="ac-form-field__error" id="password-error"><%= verr.password %></p><% } %>
      </div>
      <div class="ac-form-field<%= verr.passwordConfirm ? ' ac-form-field--error' : '' %>">
        <label for="passwordConfirm">Confirm password <span class="ac-required" aria-hidden="true">*</span><span class="ac-sr-only"> required</span></label>
        <div class="acw-register__pw-wrap">
          <input id="passwordConfirm" name="passwordConfirm" type="password" required aria-required="true" autocomplete="new-password" minlength="10" maxlength="200" aria-invalid="<%= verr.passwordConfirm ? 'true' : 'false' %>"<% if (verr.passwordConfirm) { %> aria-describedby="passwordConfirm-error"<% } %>/>
          <button type="button" class="acw-register__pw-toggle" data-ac-toggle-password="passwordConfirm" aria-label="Show password" aria-pressed="false">
            <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
          </button>
        </div>
        <% if (verr.passwordConfirm) { %><p class="ac-form-field__error" id="passwordConfirm-error"><%= verr.passwordConfirm %></p><% } %>
      </div>
    </div>
    <div class="acw-register__policy" id="password-policy">
      <%- include('../../platform/partials/registration-password-rules', {
        passwordRules: typeof passwordRules !== 'undefined' ? passwordRules : [],
        passwordInputId: 'password',
      }) %>
    </div>
    <div class="acw-register__actions">
      <a class="ac-btn ac-btn--secondary" href="<%= typeof registrationStepHref === 'function' ? registrationStepHref('clinic') : '/register-clinic?step=clinic&gpRegNav=1' %>" data-gp-registration-nav="1">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        Back
      </a>
      <button type="submit" class="ac-btn ac-btn--primary" name="action" value="next-admin" data-loading="Please wait…">
        Continue to Review
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </button>
    </div>
  </form>
  </div>
  <p class="acw-register__secure"><span class="material-symbols-outlined" aria-hidden="true">encrypted</span> Secure connection</p>
    </div>
  </div>
  <% } else { %>
  <div class="acw-register__layout">
    <aside class="acw-register__aside gp-reg__aside" aria-labelledby="ac-register-aside-title">
      <p class="acw-register__aside-eyebrow">ActiveClinic</p>
      <h2 class="acw-register__aside-title" id="ac-register-aside-title">Start running your clinic digitally</h2>
      <p class="acw-register__aside-lead">Your clinic workspace is created immediately after registration. Administrator access is ready to use, and your public clinic website starts as an unpublished draft you can build and publish when ready.</p>
      <ul class="acw-register__feature-list">
        <li><span class="material-symbols-outlined" aria-hidden="true">groups</span><span><strong>Patient records</strong> — register and manage patients in one place.</span></li>
        <li><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span><span><strong>Appointments</strong> — schedule visits and manage reception workflows.</span></li>
        <li><span class="material-symbols-outlined" aria-hidden="true">stethoscope</span><span><strong>Clinical workflows</strong> — consultations, triage, and care documentation.</span></li>
        <li><span class="material-symbols-outlined" aria-hidden="true">payments</span><span><strong>Billing</strong> — invoices, payments, and cashier operations.</span></li>
        <li><span class="material-symbols-outlined" aria-hidden="true">medication</span><span><strong>Pharmacy</strong> — dispensing and inventory support.</span></li>
        <li><span class="material-symbols-outlined" aria-hidden="true">biotech</span><span><strong>Diagnostics</strong> — lab and radiology request workflows.</span></li>
        <li><span class="material-symbols-outlined" aria-hidden="true">badge</span><span><strong>Staff access</strong> — role-based access for your clinic team.</span></li>
        <li><span class="material-symbols-outlined" aria-hidden="true">language</span><span><strong>Free DIY clinic mini-website</strong> — customize and publish when you are ready.</span></li>
      </ul>
      <p class="acw-register__aside-note">Registration does not automatically publish your public clinic website.</p>
    </aside>
    <div class="acw-register__panel gp-reg__panel">
  <div class="acw-register__card gp-reg__card">
  <%- include('../partials/register-clinic-steps') %>
  <h2 class="gp-reg__form-heading">Let's set up your clinic</h2>
  <p class="gp-reg__form-lede">Enter the primary details for your medical practice.</p>
  <form method="post" action="/register-clinic" class="ac-public-form acw-form acw-register__form" data-ac-loading="1" novalidate data-ac-register-step="clinic" data-gp-registration-form="1"<% if (typeof formState === 'string' && formState === 'validation_error') { %> data-gp-registration-dirty="1"<% } %>>
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <input type="hidden" name="action" value="next-clinic"/>
    <div class="ac-form-field<%= verr.clinicName ? ' ac-form-field--error' : '' %>">
      <label for="clinicName">Clinic Name <span class="ac-required" aria-hidden="true">*</span><span class="ac-sr-only"> required</span></label>
      <div class="acw-register__icon-field">
        <span class="material-symbols-outlined" aria-hidden="true">local_hospital</span>
        <input id="clinicName" name="clinicName" required aria-required="true" maxlength="200" placeholder="Enter official clinic name" value="<%= fd.clinicName || '' %>" aria-invalid="<%= verr.clinicName ? 'true' : 'false' %>"<% if (verr.clinicName) { %> aria-describedby="clinicName-error"<% } %>/>
      </div>
      <% if (verr.clinicName) { %><p class="ac-form-field__error" id="clinicName-error"><%= verr.clinicName %></p><% } %>
    </div>
    <div class="ac-form-field<%= verr.clinicType ? ' ac-form-field--error' : '' %>">
      <label for="clinicType">Clinic type <span class="ac-required" aria-hidden="true">*</span><span class="ac-sr-only"> required</span></label>
      <select id="clinicType" name="clinicType" required aria-required="true" aria-invalid="<%= verr.clinicType ? 'true' : 'false' %>"<% if (verr.clinicType) { %> aria-describedby="clinicType-error"<% } %>>
        <option value="">Select type</option>
        <% types.forEach(function(opt) { %>
        <option value="<%= opt.value %>"<%= fd.clinicType === opt.value ? ' selected' : '' %>><%= opt.label %></option>
        <% }) %>
      </select>
      <% if (verr.clinicType) { %><p class="ac-form-field__error" id="clinicType-error"><%= verr.clinicType %></p><% } %>
    </div>
    <div class="acw-register__grid">
      <div class="ac-form-field<%= verr.countryCode ? ' ac-form-field--error' : '' %>">
        <label for="countryCode">Country <span class="ac-required" aria-hidden="true">*</span><span class="ac-sr-only"> required</span></label>
        <select id="countryCode" name="countryCode" required aria-required="true" aria-invalid="<%= verr.countryCode ? 'true' : 'false' %>"<% if (verr.countryCode) { %> aria-describedby="countryCode-error"<% } %>>
          <% countries.forEach(function(c) { %>
          <option value="<%= c.iso %>"<%= String(fd.countryCode || 'ZM').toUpperCase() === c.iso ? ' selected' : '' %>><%= c.name %> (<%= c.iso %>)</option>
          <% }) %>
        </select>
        <% if (verr.countryCode) { %><p class="ac-form-field__error" id="countryCode-error"><%= verr.countryCode %></p><% } %>
      </div>
      <div class="ac-form-field<%= verr.city ? ' ac-form-field--error' : '' %> acw-location-field">
        <label for="city">City/Location</label>
        <input
          id="city"
          name="city"
          maxlength="100"
          placeholder="Start typing a city or town"
          value="<%= fd.city || '' %>"
          autocomplete="off"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="cityListbox"
          aria-invalid="<%= verr.city ? 'true' : 'false' %>"
          <% if (verr.city) { %>aria-describedby="city-error"<% } %>
        />
        <input type="hidden" name="locationId" id="locationId" value="<%= fd.locationId || '' %>"/>
        <div id="cityListbox" class="acw-location-listbox" data-ac-city-listbox="1" role="listbox" hidden></div>
        <% if (verr.city) { %><p class="ac-form-field__error" id="city-error"><%= verr.city %></p><% } %>
      </div>
    </div>
    <div class="acw-register__grid">
      <div class="ac-form-field<%= verr.province ? ' ac-form-field--error' : '' %>" data-ac-province-field="1">
        <label for="provinceSelect">Province/Region</label>
        <select id="provinceSelect" name="<%= isZambia ? 'province' : '' %>"<%= isZambia ? '' : ' hidden' %>>
          <option value="">Select province</option>
          <% provinceOptions.forEach(function(province) { %>
          <option value="<%= province %>"<%= String(fd.province || '') === province ? ' selected' : '' %>><%= province %></option>
          <% }) %>
        </select>
        <input id="provinceText" name="<%= isZambia ? '' : 'province' %>" maxlength="100" value="<%= fd.province || '' %>"<%= isZambia ? ' hidden' : '' %>/>
        <% if (verr.province) { %><p class="ac-form-field__error" id="province-error"><%= verr.province %></p><% } %>
      </div>
      <div class="ac-form-field<%= verr.address ? ' ac-form-field--error' : '' %>">
        <label for="address">Address / location</label>
        <div class="acw-register__icon-field acw-register__icon-field--top">
          <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
          <textarea id="address" name="address" maxlength="300" rows="3" placeholder="Enter street address" aria-invalid="<%= verr.address ? 'true' : 'false' %>"<% if (verr.address) { %> aria-describedby="address-error"<% } %>><%= fd.address || '' %></textarea>
        </div>
        <% if (verr.address) { %><p class="ac-form-field__error" id="address-error"><%= verr.address %></p><% } %>
      </div>
    </div>
    <div class="ac-form-field">
      <label for="notes">Notes (optional)</label>
      <textarea id="notes" name="notes" maxlength="2000" rows="3"><%= fd.notes || '' %></textarea>
    </div>
    <div class="acw-register__actions">
      <a class="ac-btn ac-btn--secondary" href="/">Cancel</a>
      <button type="submit" class="ac-btn ac-btn--primary" data-loading="Please wait…">
        Continue to Staff Setup
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </button>
    </div>
  </form>
  </div>
  </div>
  </div>
  <script src="/platform/location-autocomplete.js?v=1" defer></script>
  <script src="/activeclinic/register-clinic.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 'v7' %>" defer></script>
  <script>
  document.addEventListener("DOMContentLoaded", function () {
    if (window.GpRegistrationPasswordRules && document.getElementById("password")) {
      window.GpRegistrationPasswordRules.init({
        passwordInput: "#password",
        rulesRoot: ".gp-registration-password-rules",
        minLength: <%= typeof passwordMin !== 'undefined' ? passwordMin : 10 %>,
        maxLength: <%= typeof passwordMax !== 'undefined' ? passwordMax : 200 %>,
      });
    }
  });
  </script>
  <% } %>
</section>
