<section class="ac-public-section acp-page acp-onboarding" data-ac-page-section="register-clinic">
  <ol class="ac-onboarding-steps" aria-label="Registration progress">
    <li class="ac-onboarding-steps__item ac-onboarding-steps__item--active" aria-current="step">Details</li>
    <li class="ac-onboarding-steps__item">Review</li>
    <li class="ac-onboarding-steps__item">Submitted</li>
  </ol>

  <header class="acp-page-hero acp-page-hero--compact">
    <p class="ac-public-eyebrow">Clinic onboarding</p>
    <h1>Register your clinic</h1>
    <p class="ac-public-lede">Submit your clinic for review. After approval, you can sign in with this email or phone number and the password you set here.</p>
  </header>

  <% if (typeof error === 'string' && error) { %>
  <div class="ac-public-error" role="alert"><%= error %></div>
  <% } %>

  <% if (typeof formState === 'string' && formState === 'validation_error') { %>
  <div class="ac-public-validation-summary" role="alert" data-ac-form-state="validation_error">
    <h2 class="ac-public-validation-summary__title">Please fix the following</h2>
    <ul class="ac-public-validation-summary__list">
      <% const verr = validationErrors || {}; %>
      <% Object.keys(verr).forEach(function(field) { %>
      <li><a href="#<%= field %>"><%= verr[field] %></a></li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <% const fd = formData || {}; %>
  <% const verr = validationErrors || {}; %>
  <form method="post" action="/register-clinic" class="ac-public-form" data-ac-loading="1" novalidate>
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <div class="ac-form-field<%= verr.clinicName ? ' ac-form-field--error' : '' %>">
      <label for="clinicName">Clinic name <span class="ac-required" aria-hidden="true">*</span><span class="ac-sr-only"> required</span></label>
      <input id="clinicName" name="clinicName" required aria-required="true" maxlength="200" value="<%= fd.clinicName || '' %>" aria-invalid="<%= verr.clinicName ? 'true' : 'false' %>"<% if (verr.clinicName) { %> aria-describedby="clinicName-error"<% } %>/>
      <% if (verr.clinicName) { %><p class="ac-form-field__error" id="clinicName-error"><%= verr.clinicName %></p><% } %>
    </div>
    <div class="ac-form-field<%= verr.contactName ? ' ac-form-field--error' : '' %>">
      <label for="contactName">Contact name <span class="ac-required" aria-hidden="true">*</span><span class="ac-sr-only"> required</span></label>
      <input id="contactName" name="contactName" required aria-required="true" maxlength="120" value="<%= fd.contactName || '' %>" aria-invalid="<%= verr.contactName ? 'true' : 'false' %>"<% if (verr.contactName) { %> aria-describedby="contactName-error"<% } %>/>
      <% if (verr.contactName) { %><p class="ac-form-field__error" id="contactName-error"><%= verr.contactName %></p><% } %>
    </div>
    <div class="ac-form-field<%= verr.contactEmail ? ' ac-form-field--error' : '' %>">
      <label for="contactEmail">Contact email <span class="ac-required" aria-hidden="true">*</span><span class="ac-sr-only"> required</span></label>
      <input id="contactEmail" name="contactEmail" type="email" required aria-required="true" value="<%= fd.contactEmail || '' %>" aria-invalid="<%= verr.contactEmail ? 'true' : 'false' %>"<% if (verr.contactEmail) { %> aria-describedby="contactEmail-error"<% } %>/>
      <% if (verr.contactEmail) { %><p class="ac-form-field__error" id="contactEmail-error"><%= verr.contactEmail %></p><% } %>
    </div>
    <div class="ac-form-field<%= verr.contactPhone ? ' ac-form-field--error' : '' %>">
      <%- include('../partials/phone-field', {
        id: 'contactPhone',
        label: 'Contact phone',
        required: true,
        defaultCountry: typeof defaultPhoneCountry !== 'undefined' ? defaultPhoneCountry : 'ZM',
        selectedCountry: (fd.phoneCountry || fd.contactPhoneCountry || defaultPhoneCountry || 'ZM'),
        nationalValue: fd.phoneNational || fd.contactPhoneNational || '',
        e164Value: fd.contactPhone || '',
        countries: typeof phoneCountries !== 'undefined' ? phoneCountries : [],
        phoneValidationRelaxed: typeof phoneValidationRelaxed !== 'undefined' && phoneValidationRelaxed,
        countryFieldName: 'phone_country',
        nationalFieldName: 'phone_national',
        legacyFieldName: 'contactPhone',
        showLegacyHidden: true,
        error: verr.contactPhone || null,
        placeholder: '97 123 4567'
      }) %>
    </div>
    <div class="ac-form-field">
      <label for="province">Province</label>
      <input id="province" name="province" value="<%= fd.province || '' %>"/>
    </div>
    <div class="ac-form-field">
      <label for="city">City</label>
      <input id="city" name="city" value="<%= fd.city || '' %>"/>
    </div>
    <div class="ac-form-field<%= verr.address ? ' ac-form-field--error' : '' %>">
      <label for="address">Street address</label>
      <input id="address" name="address" maxlength="300" value="<%= fd.address || '' %>" aria-invalid="<%= verr.address ? 'true' : 'false' %>"<% if (verr.address) { %> aria-describedby="address-error"<% } %>/>
      <% if (verr.address) { %><p class="ac-form-field__error" id="address-error"><%= verr.address %></p><% } %>
    </div>
    <input type="hidden" name="countryCode" value="<%= fd.countryCode || 'ZM' %>"/>
    <fieldset class="ac-form-fieldset">
      <legend>Administrator sign-in</legend>
      <p class="ac-form-hint">Use this email or phone number after your clinic is approved.</p>
      <div class="ac-form-field<%= verr.password ? ' ac-form-field--error' : '' %>">
        <label for="password">Password <span class="ac-required" aria-hidden="true">*</span><span class="ac-sr-only"> required</span></label>
        <input id="password" name="password" type="password" required aria-required="true" autocomplete="new-password" minlength="10" maxlength="200" aria-invalid="<%= verr.password ? 'true' : 'false' %>"<% if (verr.password) { %> aria-describedby="password-error"<% } %>/>
        <% if (verr.password) { %><p class="ac-form-field__error" id="password-error"><%= verr.password %></p><% } %>
      </div>
      <div class="ac-form-field<%= verr.passwordConfirm ? ' ac-form-field--error' : '' %>">
        <label for="passwordConfirm">Confirm password <span class="ac-required" aria-hidden="true">*</span><span class="ac-sr-only"> required</span></label>
        <input id="passwordConfirm" name="passwordConfirm" type="password" required aria-required="true" autocomplete="new-password" minlength="10" maxlength="200" aria-invalid="<%= verr.passwordConfirm ? 'true' : 'false' %>"<% if (verr.passwordConfirm) { %> aria-describedby="passwordConfirm-error"<% } %>/>
        <% if (verr.passwordConfirm) { %><p class="ac-form-field__error" id="passwordConfirm-error"><%= verr.passwordConfirm %></p><% } %>
      </div>
    </fieldset>
    <div class="ac-form-field">
      <label for="notes">Notes (optional)</label>
      <textarea id="notes" name="notes" maxlength="2000"><%= fd.notes || '' %></textarea>
    </div>
    <button type="submit" class="ac-btn ac-btn--primary">Continue to review</button>
  </form>
</section>
