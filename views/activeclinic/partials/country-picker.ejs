<%#
  Searchable country picker (no national number).
  Locals: id, label, fieldName, selectedCountry, countries, required, hint, error
#%>
<%
  var fieldId = (typeof id === 'string' && id) ? id : 'country';
  var name = (typeof fieldName === 'string' && fieldName) ? fieldName : 'country_code';
  var countryVal = String(
    (typeof selectedCountry !== 'undefined' && selectedCountry) || 'ZM'
  ).toUpperCase();
  var countryList = (typeof countries !== 'undefined' && Array.isArray(countries)) ? countries : [];
  var callingHint = '';
  var countryName = countryVal;
  var isRequired = typeof required !== 'undefined' && required === true;
  var hintText = (typeof hint === 'string') ? hint : '';
  var errorText = (typeof error !== 'undefined' && error) ? error : '';
  var labelText = (typeof label === 'string') ? label : '';
  for (var i = 0; i < countryList.length; i++) {
    if (String(countryList[i].iso).toUpperCase() === countryVal) {
      callingHint = countryList[i].callingCode || '';
      countryName = countryList[i].name || countryVal;
      break;
    }
  }
%>
<div class="ac-phone-field ac-country-picker" data-ac-phone-field="1" data-default-country="<%= countryVal %>">
  <% if (labelText) { %>
  <label class="ac-label" for="<%= fieldId %>-btn"><%= labelText %><% if (isRequired) { %> <span class="ac-required" aria-hidden="true">*</span><% } %></label>
  <% } %>
  <div class="ac-phone-field__country">
    <input type="hidden" name="<%= name %>" id="<%= fieldId %>-value" value="<%= countryVal %>" data-ac-phone-country-value="1"/>
    <button
      type="button"
      class="ac-phone-field__country-btn"
      id="<%= fieldId %>-btn"
      data-ac-phone-country-btn="1"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="<%= fieldId %>-list"
        aria-label="Country, currently <%= countryName %> <%= callingHint %>"
      style="width:100%"
    >
      <span class="ac-phone-field__flag" data-ac-phone-flag="1" aria-hidden="true"><%= countryVal %></span>
      <span class="ac-phone-field__code" data-ac-phone-code="1"><%= countryName %> <%= callingHint %></span>
      <span class="ac-phone-field__chevron" aria-hidden="true">▾</span>
    </button>
    <div class="ac-phone-field__backdrop" hidden data-ac-phone-backdrop="1"></div>
    <div class="ac-phone-field__popover" id="<%= fieldId %>-list" hidden data-ac-phone-popover="1" role="dialog" aria-modal="true" aria-label="Select country">
      <label class="ac-sr-only" for="<%= fieldId %>-search">Search countries</label>
      <input type="search" class="ac-input ac-phone-field__search" id="<%= fieldId %>-search" data-ac-phone-search="1" placeholder="Search Zambia, ZM, +260" autocomplete="off"/>
      <ul class="ac-phone-field__options" data-ac-phone-options="1" role="listbox" aria-label="Countries">
        <% countryList.forEach(function (c) {
          var iso = String(c.iso || '').toUpperCase();
          var selected = iso === countryVal;
        %>
        <li role="presentation">
          <button
            type="button"
            class="ac-phone-field__option<%= selected ? ' is-selected' : '' %>"
            role="option"
            data-iso="<%= iso %>"
            data-code="<%= c.callingCode || '' %>"
            data-name="<%= c.name || iso %>"
            data-search="<%= (c.searchText || ((c.name || '') + ' ' + iso + ' ' + (c.callingCode || ''))).toLowerCase() %>"
            aria-selected="<%= selected ? 'true' : 'false' %>"
          >
            <span class="ac-phone-field__option-flag" aria-hidden="true"><%= iso %></span>
            <span class="ac-phone-field__option-name"><%= c.name || iso %></span>
            <span class="ac-phone-field__option-code"><%= c.callingCode || '' %></span>
          </button>
        </li>
        <% }) %>
      </ul>
    </div>
  </div>
  <% if (hintText) { %><p class="ac-hint"><%= hintText %></p><% } %>
  <% if (errorText) { %><p class="ac-field-error" role="status"><%= errorText %></p><% } %>
</div>
