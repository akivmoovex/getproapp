<%
  var state = typeof directoryState === 'string' ? directoryState : 'ready';
  var hasFilters = !!(typeof search === 'string' && search) || !!(typeof province === 'string' && province) || !!(typeof city === 'string' && city);
%>
<% if (state === 'loading') { %>
<div class="ac-directory-state ac-directory-state--loading" data-ac-directory-state="loading" role="status" aria-live="polite">
  <div class="ac-directory-state__spinner" aria-hidden="true"></div>
  <h2 class="ac-directory-state__title">Loading clinics</h2>
  <p class="ac-directory-state__text">Fetching published clinics from the directory…</p>
</div>
<% } else if (state === 'error') { %>
<div class="ac-directory-state ac-directory-state--error" data-ac-directory-state="error" role="alert">
  <h2 class="ac-directory-state__title">Directory temporarily unavailable</h2>
  <p class="ac-directory-state__text">We could not load the clinic directory right now. Please try again in a moment.</p>
  <div class="ac-directory-state__actions">
    <a class="ac-btn ac-btn--primary" href="/clinics">Retry</a>
    <a class="ac-btn ac-btn--secondary" href="/about">Contact support</a>
  </div>
</div>
<% } else if (typeof directoryEmpty !== 'undefined' && directoryEmpty) { %>
<div class="ac-directory-state ac-directory-state--empty" data-ac-directory-state="empty" data-ac-empty="clinics" role="status">
  <h2 class="ac-directory-state__title">No clinics match your search</h2>
  <p class="ac-directory-state__text">
    <% if (hasFilters) { %>
    Try clearing your filters or searching with a different clinic name or city.
    <% } else { %>
    No clinics have published a public directory listing yet. Check back as more clinics join ActiveClinic.
    <% } %>
  </p>
  <div class="ac-directory-state__actions">
    <% if (hasFilters) { %>
    <a class="ac-btn ac-btn--primary" href="/clinics">View all clinics</a>
    <a class="ac-btn ac-btn--secondary" href="/clinics">Clear filters</a>
    <% } else { %>
    <a class="ac-btn ac-btn--primary" href="/register-clinic">Register your clinic</a>
    <% } %>
    <a class="ac-btn ac-btn--ghost" href="/about">Learn about ActiveClinic</a>
  </div>
</div>
<% } %>
