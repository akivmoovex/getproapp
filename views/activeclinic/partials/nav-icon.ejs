<%#
  Inline SVG nav icons (no remote Stitch / Material CDN).
  locals: name
%>
<% var n = typeof name !== 'undefined' ? name : 'circle'; %>
<span class="ac-nav-icon" aria-hidden="true">
<% if (n === 'home') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 10.5L12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5z"/></svg>
<% } else if (n === 'apartment') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 21V5a1 1 0 0 1 1-1h8v17M13 9h6a1 1 0 0 1 1 1v11M8 8h2M8 12h2M8 16h2M16 13h2M16 17h2"/></svg>
<% } else if (n === 'groups') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 19c0-3 2.5-5 6-5s6 2 6 5M14 19c.5-2 2-3.5 4.5-3.5 2 0 3.5 1 4 3.5"/></svg>
<% } else if (n === 'admin_panel_settings') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 3l8 3v5c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V6l8-3z"/><path d="M9.5 12.2l1.8 1.8 3.5-3.6"/></svg>
<% } else if (n === 'settings') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="3"/><path d="M12 3v2M12 19v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M3 12h2M19 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
<% } else if (n === 'public' || n === 'language') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
<% } else if (n === 'personal_injury') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="8" r="3"/><path d="M5 20c1.5-3.5 4-5 7-5s5.5 1.5 7 5"/><path d="M16 4.5l1.5 1.5M18.5 3l.5 2"/></svg>
<% } else if (n === 'event' || n === 'event_available') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/><path d="M9 15l2 2 4-4"/></svg>
<% } else if (n === 'desk') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 10h18v8H3zM5 10V7h4v3M15 18v3M9 18v3"/></svg>
<% } else if (n === 'medical_services' || n === 'stethoscope') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M8 4h2v6a2 2 0 1 0 4 0V4h2"/><path d="M12 14v2a4 4 0 1 0 4 4"/><circle cx="16" cy="20" r="1.5"/></svg>
<% } else if (n === 'medication') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="7" y="3" width="10" height="18" rx="5"/><path d="M7 10h10"/></svg>
<% } else if (n === 'biotech') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 3v10a3 3 0 1 0 6 0V3"/><path d="M9 7h6M8 17h8M10 21h4"/></svg>
<% } else if (n === 'receipt') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M6 3h12v18l-2-1.5L14 21l-2-1.5L10 21l-2-1.5L6 21V3z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>
<% } else if (n === 'payments') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 14h3"/></svg>
<% } else if (n === 'catalog') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 0-3 3V4z"/><path d="M8 8h8M8 12h6"/></svg>
<% } else if (n === 'menu') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
<% } else if (n === 'search') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></svg>
<% } else if (n === 'notifications') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M6 16V10a6 6 0 1 1 12 0v6l1.5 2H4.5L6 16z"/><path d="M10 19a2 2 0 0 0 4 0"/></svg>
<% } else if (n === 'person_add') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="9" cy="8" r="3"/><path d="M3 19c1.2-3.2 3.5-5 6-5s4.8 1.8 6 5M17 8v6M14 11h6"/></svg>
<% } else if (n === 'event_repeat') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M17 3v4h4"/><path d="M7 21v-4H3"/><path d="M20 7a8 8 0 0 0-14.5-2M4 17a8 8 0 0 0 14.5 2"/><path d="M9 11h6M12 8v6"/></svg>
<% } else { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="8"/></svg>
<% } %>
</span>
