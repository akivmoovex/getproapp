<% if (typeof websiteCanEdit !== 'undefined' && websiteCanEdit) { %>
<%
  var statusKey = typeof websiteWorkflowStatus !== 'undefined' && websiteWorkflowStatus
    ? websiteWorkflowStatus
    : 'live';
  var unpublished = Number(typeof websiteUnpublishedCount !== 'undefined' ? websiteUnpublishedCount : 0) || 0;
  var reviewNote = typeof websiteReviewNote !== 'undefined' && websiteReviewNote ? websiteReviewNote : '';
  var submittedAt = typeof websiteSubmittedAtLabel !== 'undefined' && websiteSubmittedAtLabel ? websiteSubmittedAtLabel : '';
  var canResubmit = statusKey === 'changes_requested' && unpublished > 0;
  var waitingReview = statusKey === 'submitted';
  var lifecycle = typeof websiteLifecycleStatus !== 'undefined' ? websiteLifecycleStatus : '';
  var lifecycleLabel = typeof websiteLifecycleLabel !== 'undefined' ? websiteLifecycleLabel : '';
  var policyLabel = typeof websitePublishPolicyLabel !== 'undefined' ? websitePublishPolicyLabel : '';
  var editLocked = typeof websiteEditLocked !== 'undefined' && websiteEditLocked;
  var moderationNote = typeof websiteModerationNote !== 'undefined' && websiteModerationNote ? websiteModerationNote : '';
%>
<div
  class="ac-website-chrome"
  data-website-chrome="1"
  data-clinic-key="<%= clinic && clinic.clinicKey %>"
  data-website-status="<%= statusKey %>"
>
  <div class="ac-website-chrome__status" data-website-chrome-status="1">
    <p><strong><%= lifecycleLabel || (websiteEdit ? 'Editing draft.' : 'Live view.') %></strong>
      <% if (policyLabel) { %> Policy: <%= policyLabel %>.<% } %>
      <% if (lifecycle === 'offline') { %> The public website is offline. You can still use clinic operations.<% } %>
      <% if (lifecycle === 'suspended') { %> The public website is suspended. Contact Platform Admin to restore it.<% } %>
      <% if (lifecycle === 'provisional') { %> This is a temporary website.<% } %>
      <% if (editLocked) { %> Editing is locked.<% } %>
    </p>
    <% if (moderationNote) { %>
    <p class="ac-website-chrome__note" data-website-moderation-note="1"><%= moderationNote %></p>
    <% } %>
    <ul class="ac-website-chrome__pills">
      <li data-website-pill="live"<%= statusKey === 'live' || statusKey === 'published' ? ' class="is-current"' : '' %>>Live</li>
      <li data-website-pill="draft"<%= unpublished > 0 && statusKey !== 'submitted' ? ' class="is-current"' : '' %>>
        Draft changes<% if (unpublished > 0) { %> (<%= unpublished %>)<% } %>
      </li>
      <li data-website-pill="submitted"<%= waitingReview ? ' class="is-current"' : '' %>>Submitted for approval</li>
      <li data-website-pill="changes_requested"<%= statusKey === 'changes_requested' ? ' class="is-current"' : '' %>>Changes requested</li>
      <li data-website-pill="published"<%= statusKey === 'published' ? ' class="is-current"' : '' %>>Approved / published</li>
    </ul>
    <% if (submittedAt) { %>
    <p data-website-submitted-at="1">Submitted <%= submittedAt %></p>
    <% } %>
    <% if (reviewNote) { %>
    <p class="ac-website-chrome__note" data-website-review-note="1"><%= reviewNote %></p>
    <% } %>
    <% if (waitingReview) { %>
    <p>This draft is waiting for Platform Admin review. The submitted snapshot cannot be edited.</p>
    <% } %>
  </div>
  <div class="ac-website-chrome__actions">
    <% if (websiteEdit) { %>
    <a class="ac-website-chrome__link" href="?website_mode=live">View live</a>
    <a class="ac-website-chrome__link" href="/clinics/<%= clinic.clinicKey %>/website/preview">Preview draft</a>
    <form method="post" action="/clinics/<%= clinic.clinicKey %>/website/edit-session/finish" class="ac-website-chrome__submit">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <button type="submit">Finish editing</button>
    </form>
    <% if (websiteCanSubmit && !waitingReview) { %>
    <form method="post" action="/clinics/<%= clinic.clinicKey %>/website/submit" class="ac-website-chrome__submit">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <button type="submit"><%= canResubmit ? 'Resubmit for approval' : 'Submit for approval' %></button>
    </form>
    <% } %>
    <% } else if (!editLocked) { %>
    <a class="ac-website-chrome__link" href="?website_edit=1&amp;website_mode=draft">Edit website</a>
    <% } %>
  </div>
</div>
<% } %>
