<header class="ac-public-header" data-ac-public-header="platform" data-ac-acw-chrome="ACW12">
  <div class="ac-public-header__inner">
    <button type="button" class="ac-public-nav-toggle" data-ac-nav-open aria-expanded="false" aria-controls="ac-public-drawer" aria-haspopup="dialog">
      <span class="ac-sr-only">Open menu</span>
      <span aria-hidden="true">☰</span>
    </button>
    <a class="ac-public-brand" href="/" aria-label="ActiveClinic home">
      <span class="ac-public-brand__mark" aria-hidden="true"></span>
      <span class="ac-public-brand__name">ActiveClinic</span>
    </a>
    <nav class="ac-public-nav ac-public-nav--desktop" aria-label="Primary">
      <%- include('./public-platform-primary-nav') %>
    </nav>
    <div class="ac-public-header__actions">
      <%- include('./public-platform-nav-actions', { variant: 'header' }) %>
    </div>
  </div>
</header>
<aside id="ac-public-drawer" class="ac-public-drawer" data-ac-nav-drawer data-ac-acw-chrome="ACW12" hidden>
  <div class="ac-public-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <button type="button" class="ac-public-drawer__close" data-ac-nav-close aria-label="Close menu">Close</button>
    <nav aria-label="Mobile">
      <%- include('./public-platform-primary-nav') %>
      <%- include('./public-platform-nav-actions', { variant: 'drawer' }) %>
    </nav>
  </div>
</aside>
