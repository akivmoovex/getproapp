<%
  var pageId = typeof libraryPageId !== "undefined" ? libraryPageId : "";
  var skipTypes = typeof librarySkipTypes !== "undefined" && Array.isArray(librarySkipTypes) ? librarySkipTypes : [];
  var placements = (clinic && Array.isArray(clinic.cmsLibraryPlacements)) ? clinic.cmsLibraryPlacements : [];
  var items = (clinic && Array.isArray(clinic.cmsLibrary)) ? clinic.cmsLibrary : [];
  var placed = placements
    .filter(function (placement) { return placement && placement.page_id === pageId; })
    .map(function (placement) {
      return items.find(function (item) { return item && item.id === placement.item_id; }) || null;
    })
    .filter(function (item) {
      if (!item || item.visible === false) return false;
      if (skipTypes.indexOf(item.type) !== -1) return false;
      return true;
    });
  var editing = typeof websiteEdit !== "undefined" && websiteEdit;
%>
<% if (placed.length) { %>
<section class="ac-public-section ac-tenant-library" data-ac-page-section="tenant-library">
  <% placed.forEach(function (item) { %>
  <article class="ac-tenant-library-item" data-ac-library-type="<%= item.type %>">
    <% if (item.type === "faq") { %>
    <h2><%= item.title %></h2>
    <% if (item.body) { %><p><%= item.body %></p><% } %>
    <% } else if (item.type === "testimonial") { %>
    <blockquote>
      <p><%= item.body || item.summary || "" %></p>
      <% if (item.attribution) { %><footer><%= item.attribution %></footer><% } %>
    </blockquote>
    <% } else { %>
    <% if (item.title) { %><h2><%= item.title %></h2><% } %>
    <% if (item.summary) { %><p><%= item.summary %></p><% } %>
    <% if (item.body && item.body !== item.summary) { %><p><%= item.body %></p><% } %>
    <% } %>
    <% var libImg = item.image && (item.image.src || item.image.publicSrc) ? (item.image.src || item.image.publicSrc) : ""; %>
    <% if (libImg) { %>
    <p class="ac-tenant-library-item__media">
      <img src="<%= libImg %>" alt="<%= (item.image && item.image.alt) || item.title || '' %>" width="960" height="540" loading="lazy" decoding="async" />
    </p>
    <% } %>
    <% if (editing && item.id) { %>
    <p class="ac-website-manage" data-ac-website-manage="library-image">
      <a class="ac-btn ac-btn--secondary ac-btn--pill" href="/app/settings/website/library/<%= item.id %>"><%= libImg ? "Replace image" : "Add image" %></a>
    </p>
    <% } %>
  </article>
  <% }) %>
</section>
<% } %>
