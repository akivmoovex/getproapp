<%
  const pid = typeof pageId === "string" ? pageId : "";
  const pages = (clinic && clinic.publicPagePaths) || {};
  const pubHome = pages.home || (clinic && clinic.publicBasePath) || ("/clinics/" + (clinic && clinic.clinicKey ? clinic.clinicKey : ""));
  function pub(name) {
    if (pages[name]) return pages[name];
    if (!name || name === "home") return pubHome;
    var extras = {
      privacy: "/privacy",
      terms: "/terms",
      patientLogin: "/patient/login",
      myBooking: "/my-booking",
      patientInformation: "/patient-information"
    };
    return pubHome + (extras[name] || ("/" + name));
  }
  function tenantCurrent(kind) {
    var on = false;
    if (kind === "about") on = /tenant-about/.test(pid);
    else if (kind === "doctors") on = /tenant-doctor/.test(pid);
    else if (kind === "services") on = /tenant-service|tenant-procedure/.test(pid);
    else if (kind === "pricing") on = /tenant-pricing/.test(pid);
    else if (kind === "contact") on = /tenant-contact/.test(pid);
    else if (kind === "book") on = /booking-|appointment-entry|procedures-list/.test(pid);
    return on ? ' aria-current="page"' : "";
  }
%>
<header class="ac-public-header ac-public-header--tenant" data-ac-public-header="tenant">
  <% if (clinic && clinic.isDemonstrationClinic) { %>
  <div class="ac-public-banner ac-public-banner--demo" data-ac-demo-banner="1" role="status">
    Demonstration clinic — sample information only
  </div>
  <% } %>
  <div class="ac-public-header__inner ac-public-header__inner--tenant">
    <% if (typeof websiteEdit !== 'undefined' && websiteEdit) { %>
    <div class="ac-public-brand ac-public-brand--tenant ac-public-brand--editing">
      <%- include('./website-editable-image', {
        contentKey: 'home.logo',
        imageSrc: clinic.websiteLogoUrl || '',
        imageAlt: clinic.websiteLogoAlt || '',
        imageMediaId: clinic.websiteLogoMediaId || '',
        imageClassName: 'ac-public-brand__logo',
        imageVariant: 'logo',
        imageWidth: 36,
        imageHeight: 36,
        imagePlaceholderSrc: 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7',
      }) %>
      <a href="<%= pub('home') %>" aria-label="<%= clinic.publicName %> home">
        <span class="ac-public-brand__name"><%= clinic.publicName %></span>
      </a>
    </div>
    <% } else { %>
    <a class="ac-public-brand ac-public-brand--tenant" href="<%= pub('home') %>" aria-label="<%= clinic.publicName %> home">
      <% if (clinic.websiteLogoUrl) { %>
      <img class="ac-public-brand__logo" src="<%= clinic.websiteLogoUrl %>" alt="<%= clinic.websiteLogoAlt || '' %>" width="36" height="36"/>
      <% } else { %>
      <span class="ac-public-brand__mark" aria-hidden="true"><%= String(clinic.publicName || "C").charAt(0).toUpperCase() %></span>
      <% } %>
      <span class="ac-public-brand__name"><%= clinic.publicName %></span>
    </a>
    <% } %>
    <nav class="ac-public-nav ac-public-nav--desktop ac-public-nav--tenant" aria-label="Clinic">
      <a href="<%= pub('about') %>"<%- tenantCurrent("about") %>>About</a>
      <a href="<%= pub('doctors') %>"<%- tenantCurrent("doctors") %>>Doctors</a>
      <a href="<%= pub('services') %>"<%- tenantCurrent("services") %>>Services</a>
      <% if (clinic.showPricing !== false) { %>
      <a href="<%= pub('pricing') %>"<%- tenantCurrent("pricing") %>>Pricing</a>
      <% } %>
      <a href="<%= pub('contact') %>"<%- tenantCurrent("contact") %>>Contact</a>
      <a class="ac-public-nav__login" href="<%= pub('patientLogin') %>">Login</a>
      <a class="ac-public-nav__cta" href="<%= pub('book') %>"<%- tenantCurrent("book") %>><%= clinic.publicBookingEnabled ? "Book appointment" : "Request appointment" %></a>
    </nav>
    <button type="button" class="ac-public-nav-toggle" data-ac-nav-open aria-expanded="false" aria-controls="ac-public-drawer">
      <span class="ac-sr-only">Open menu</span>
      <span aria-hidden="true">☰</span>
    </button>
  </div>
</header>
<aside id="ac-public-drawer" class="ac-public-drawer" data-ac-nav-drawer hidden>
  <div class="ac-public-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <button type="button" class="ac-public-drawer__close" data-ac-nav-close>Close</button>
    <nav aria-label="Mobile clinic">
      <a href="<%= pub('about') %>"<%- tenantCurrent("about") %>>About</a>
      <a href="<%= pub('doctors') %>"<%- tenantCurrent("doctors") %>>Doctors</a>
      <a href="<%= pub('services') %>"<%- tenantCurrent("services") %>>Services</a>
      <% if (clinic.showPricing !== false) { %>
      <a href="<%= pub('pricing') %>"<%- tenantCurrent("pricing") %>>Pricing</a>
      <% } %>
      <a href="<%= pub('location') %>">Location</a>
      <a href="<%= pub('contact') %>"<%- tenantCurrent("contact") %>>Contact</a>
      <a href="<%= pub('patientInformation') %>">Patient information</a>
      <a href="<%= pub('book') %>"<%- tenantCurrent("book") %>><%= clinic.publicBookingEnabled ? "Book appointment" : "Request appointment" %></a>
      <a href="<%= pub('myBooking') %>">My booking</a>
      <a href="<%= pub('patientLogin') %>">Patient portal</a>
      <a href="/">Back to ActiveClinic</a>
      <a href="/clinics">All clinics</a>
    </nav>
  </div>
</aside>
