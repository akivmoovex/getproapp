<%
  var filterAction = typeof filterFormAction === 'string' ? filterFormAction : '/clinics';
  var qVal = typeof search === 'string' ? search : '';
  var locVal = typeof location === 'string' ? location : '';
  var svcVal = typeof service === 'string' ? service : '';
  var provVal = typeof province === 'string' && province ? province : '';
  var cityVal = typeof city === 'string' && city ? city : '';
  var title = typeof filterTitle === 'string' ? filterTitle : 'Filter clinics';
  var hideSearchField = Boolean(typeof hideSearch !== 'undefined' && hideSearch);
  var hideCloseBtn = Boolean(typeof hideClose !== 'undefined' && hideClose);
  var idPrefix = hideSearchField ? 'ac-side' : 'ac-filter';
%>
<form class="ac-directory-filters" method="get" action="<%= filterAction %>" role="search" data-ac-directory-filters>
  <div class="ac-directory-filters__header">
    <h2 class="ac-directory-filters__title"><%= title %></h2>
    <% if (!hideCloseBtn) { %>
    <button type="button" class="ac-directory-filters__close ac-btn ac-btn--ghost" data-ac-filter-close aria-label="Close filters">Close</button>
    <% } %>
  </div>
  <% if (!hideSearchField) { %>
  <label for="<%= idPrefix %>-q">Clinic name</label>
  <input id="<%= idPrefix %>-q" name="q" type="search" value="<%= qVal %>" placeholder="Clinic name"/>
  <% } else if (qVal) { %>
  <input type="hidden" name="q" value="<%= qVal %>"/>
  <% } %>
  <% if (locVal) { %><input type="hidden" name="location" value="<%= locVal %>"/><% } %>
  <p class="ac-directory-filters__legend" id="<%= idPrefix %>-location-legend">Location</p>
  <fieldset class="ac-directory-filters__location" aria-labelledby="<%= idPrefix %>-location-legend">
  <legend class="ac-sr-only">Location</legend>
  <label for="<%= idPrefix %>-province">Province</label>
  <input id="<%= idPrefix %>-province" name="province" value="<%= provVal %>" placeholder="e.g. Lusaka"/>
  <label for="<%= idPrefix %>-city">City</label>
  <input id="<%= idPrefix %>-city" name="city" value="<%= cityVal %>" placeholder="e.g. Lusaka"/>
  </fieldset>
  <label for="<%= idPrefix %>-service">Service</label>
  <input id="<%= idPrefix %>-service" name="service" type="search" value="<%= svcVal %>" placeholder="If the clinic lists it"/>
  <div class="ac-directory-filters__actions">
    <button type="submit" class="ac-btn ac-btn--primary">Apply filters</button>
    <a class="ac-btn ac-btn--secondary" href="/clinics">Clear all</a>
  </div>
</form>
