<%
  var canEdit = typeof websiteEdit !== 'undefined' && websiteEdit;
  var key = contentKey;
  var src = typeof imageSrc !== 'undefined' && imageSrc ? imageSrc : '';
  var alt = typeof imageAlt !== 'undefined' && imageAlt ? imageAlt : '';
  var mediaId = typeof imageMediaId !== 'undefined' && imageMediaId ? imageMediaId : '';
  var variant = typeof imageVariant !== 'undefined' && imageVariant ? String(imageVariant) : '';
  var imgClass = typeof imageClassName !== 'undefined' && imageClassName ? String(imageClassName) : '';
  var placeholderSrc = typeof imagePlaceholderSrc !== 'undefined' && imagePlaceholderSrc
    ? String(imagePlaceholderSrc)
    : '/activeclinic/assets/clinic-hero-default.jpg';
  var imgWidth = typeof imageWidth !== 'undefined' && imageWidth ? Number(imageWidth) : 960;
  var imgHeight = typeof imageHeight !== 'undefined' && imageHeight ? Number(imageHeight) : 600;
  var displaySrc = src || placeholderSrc;
  var logo = variant === 'logo' || key === 'home.logo';
  var label = logo ? 'Edit logo' : 'Edit image';
%>
<% if (canEdit) { %>
<div
  class="gp-website-editable ac-website-editable ac-website-editable--image<%= variant ? ' ac-website-editable--' + variant : '' %>"
  data-website-key="<%= key %>"
  data-website-type="image"
  data-website-variant="<%= logo ? 'logo' : 'image' %>"
  data-website-label="<%= label %>"
  data-website-media-id="<%= mediaId %>"
>
  <div class="gp-website-editable__preview ac-website-editable__preview">
    <img
      data-website-image="1"
      class="<%= imgClass %>"
      src="<%= displaySrc %>"
      alt="<%= alt %>"
      width="<%= imgWidth %>"
      height="<%= imgHeight %>"
    />
    <button
      type="button"
      class="gp-website-editable__pencil ac-website-editable__pencil"
      data-website-start="1"
      aria-label="<%= label %>"
    >
      <span class="material-symbols-outlined" aria-hidden="true"><%= logo ? 'badge' : 'image' %></span>
    </button>
  </div>
</div>
<% } else { %>
<%- include('./ac-media', {
  src: src || '/activeclinic/assets/clinic-hero-default.jpg',
  alt: alt,
  className: typeof imageClassName !== 'undefined' ? imageClassName : 'ac-tenant-hero__image',
  objectFit: 'cover',
  objectPosition: typeof imagePosition !== 'undefined' ? imagePosition : 'center 42%',
  aspect: '16 / 10',
  width: 960,
  height: 600,
  loading: typeof imageLoading !== 'undefined' ? imageLoading : 'eager',
  fallbackSrc: typeof clinicHeroDefaultUrl === 'string' ? clinicHeroDefaultUrl : '/activeclinic/assets/clinic-hero-default.jpg',
}) %>
<% } %>
