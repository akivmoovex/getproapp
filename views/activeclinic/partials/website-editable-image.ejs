<%
  var canEdit = typeof websiteEdit !== 'undefined' && websiteEdit;
  var key = contentKey;
  var src = typeof imageSrc !== 'undefined' && imageSrc ? imageSrc : '';
  var alt = typeof imageAlt !== 'undefined' && imageAlt ? imageAlt : '';
  var mediaId = typeof imageMediaId !== 'undefined' && imageMediaId ? imageMediaId : '';
%>
<% if (canEdit) { %>
<div
  class="ac-website-editable ac-website-editable--image"
  data-website-key="<%= key %>"
  data-website-type="image"
  data-website-media-id="<%= mediaId %>"
>
  <div class="ac-website-editable__preview">
    <% if (src) { %>
    <img data-website-image="1" src="<%= src %>" alt="<%= alt %>" width="960" height="600"/>
    <% } else { %>
    <img data-website-image="1" src="/activeclinic/assets/clinic-hero-default.jpg" alt="<%= alt %>" width="960" height="600"/>
    <% } %>
  </div>
  <div class="ac-website-editable__image-tools">
    <label class="ac-website-editable__file">
      <span>Choose or replace image</span>
      <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" data-website-file="1"/>
    </label>
    <label class="ac-website-editable__alt">
      Alt text
      <input type="text" maxlength="240" value="<%= alt %>" data-website-alt="1"/>
    </label>
    <span class="ac-website-editable__controls">
      <button type="button" class="ac-website-editable__save" data-website-save="1" aria-label="Save image to draft" title="Save to draft">
        <span class="ac-website-editable__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" focusable="false"><path fill="currentColor" d="M9.2 16.6 4.8 12.2l1.4-1.4 3 3 8.6-8.6 1.4 1.4z"/></svg>
        </span>
        <span class="ac-sr-only">Save to draft</span>
      </button>
      <button type="button" class="ac-website-editable__cancel" data-website-cancel="1" aria-label="Cancel image edit" title="Cancel edit">
        <span class="ac-website-editable__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" focusable="false"><path fill="currentColor" d="M18.3 5.7 13 11l5.3 5.3-1.4 1.4L11.6 12.4 6.3 17.7 4.9 16.3 10.2 11 4.9 5.7 6.3 4.3l5.3 5.3 5.3-5.3z"/></svg>
        </span>
        <span class="ac-sr-only">Cancel edit</span>
      </button>
    </span>
    <span class="ac-website-editable__status" data-website-status-msg="1" aria-live="polite"></span>
    <progress class="ac-website-editable__progress" data-website-progress="1" hidden max="100" value="0"></progress>
  </div>
</div>
<% } else { %>
<%- include('./ac-media', {
  src: src || '/activeclinic/assets/clinic-hero-default.jpg',
  alt: alt,
  className: typeof imageClassName !== 'undefined' ? imageClassName : 'ac-tenant-hero__image',
  objectFit: 'cover',
  objectPosition: typeof imagePosition !== 'undefined' ? imagePosition : 'center 42%',
  aspect: '16 / 10',
  width: 960,
  height: 600,
  loading: typeof imageLoading !== 'undefined' ? imageLoading : 'eager',
  fallbackSrc: typeof clinicHeroDefaultUrl === 'string' ? clinicHeroDefaultUrl : '/activeclinic/assets/clinic-hero-default.jpg',
}) %>
<% } %>
