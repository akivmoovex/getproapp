<%#
  Password field with accessible visibility toggle.
  locals: id, name, label, autocomplete, minlength, describedBy, invalid
%>
<div class="ac-auth-field">
  <label for="<%= id %>"><%= label %></label>
  <div class="ac-auth-password-wrap">
    <input
      class="ac-auth-input"
      id="<%= id %>"
      name="<%= name %>"
      type="password"
      autocomplete="<%= autocomplete || 'current-password' %>"
      required
      <% if (minlength) { %>minlength="<%= minlength %>"<% } %>
      <% if (describedBy) { %>aria-describedby="<%= describedBy %>"<% } %>
      <% if (invalid) { %>aria-invalid="true"<% } %>
    />
    <button
      type="button"
      class="ac-auth-password-toggle"
      data-ac-toggle-password="<%= id %>"
      aria-label="Show password"
      aria-pressed="false"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
        <circle cx="12" cy="12" r="3"/>
      </svg>
      <span class="ac-auth-sr-only" data-ac-toggle-label>Show</span>
    </button>
  </div>
</div>
