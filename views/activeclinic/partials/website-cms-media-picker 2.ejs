<dialog class="ac-mw-dialog" id="ac-mw-select-media" data-ac-mw-media-picker="1" data-ac-mw-media-url="<%= typeof mediaListUrl !== 'undefined' ? mediaListUrl : '' %>">
  <div class="ac-mw-dialog__body">
    <h3>Select Media</h3>
    <p class="ac-mw-muted">Reuse an image already uploaded for this clinic.</p>
    <div class="ac-mw-media-grid" data-ac-mw-picker-grid="1"></div>
    <div class="ac-mw-actions">
      <a class="ac-mw-btn" href="/app/settings/website/media">Open media library</a>
      <button type="button" class="ac-mw-btn" data-ac-mw-close="1">Close</button>
    </div>
  </div>
</dialog>
