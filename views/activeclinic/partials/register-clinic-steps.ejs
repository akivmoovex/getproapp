<%
  var step = typeof wizardStep === 'string' ? wizardStep : 'clinic';
  function stepClass(key) {
    var order = { clinic: 1, administrator: 2, review: 3, success: 4, error: 4 };
    var current = order[step] || 1;
    var here = order[key] || 1;
    if (here < current) return ' ac-onboarding-steps__item--done';
    if (here === current) return ' ac-onboarding-steps__item--active';
    return '';
  }
%>
<ol class="ac-onboarding-steps acw-register-steps" aria-label="Registration progress">
  <li class="ac-onboarding-steps__item<%= stepClass('clinic') %>"<%= step === 'clinic' ? ' aria-current="step"' : '' %>>Clinic</li>
  <li class="ac-onboarding-steps__item<%= stepClass('administrator') %>"<%= step === 'administrator' ? ' aria-current="step"' : '' %>>Administrator</li>
  <li class="ac-onboarding-steps__item<%= stepClass('review') %>"<%= step === 'review' ? ' aria-current="step"' : '' %>>Review</li>
  <li class="ac-onboarding-steps__item<%= stepClass('success') %>"<%= step === 'success' ? ' aria-current="step"' : '' %>>Clinic created</li>
</ol>
