<%
  const pid = typeof pageId === "string" ? pageId : "";
  const featuresOn = /public-features/.test(pid);
%>
<footer class="ac-public-footer" data-ac-public-footer="platform" data-ac-acw-chrome="ACW12">
  <div class="ac-public-footer__inner">
    <div class="ac-public-footer__grid">
      <div class="ac-public-footer__col">
        <p><strong>ActiveClinic</strong></p>
        <p>Healthcare operations and public clinic websites for organisations in Zambia.</p>
      </div>
      <div class="ac-public-footer__col">
        <h3>Platform</h3>
        <%- include('./public-platform-primary-nav') %>
        <a href="/features"<%- featuresOn ? ' aria-current="page"' : "" %>>Features</a>
      </div>
      <div class="ac-public-footer__col">
        <h3>Company</h3>
        <%- include('./public-platform-nav-actions', { variant: 'footer' }) %>
      </div>
      <div class="ac-public-footer__col">
        <h3>Legal</h3>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <p class="ac-public-footer__note">Clinical records stay in the authenticated app. Public pages show only what clinics publish.</p>
      </div>
    </div>
    <p class="ac-public-footer__note">© ActiveClinic. Powered by GetPro.</p>
  </div>
</footer>
