<%
  var canEdit = typeof websiteEdit !== 'undefined' && websiteEdit;
  var key = contentKey;
  var value = typeof fieldValue !== 'undefined' && fieldValue != null ? String(fieldValue) : '';
  var fType = typeof fieldType !== 'undefined' ? String(fieldType) : 'short_text';
  var multiline = (fType === 'long_text' || fType === 'rich_text' || fType === 'textarea' || fType === 'paragraph');
  var fieldId = 'website-field-' + String(key).replace(/[^a-z0-9]+/gi, '-');
  function escAttr(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }
%>
<% if (canEdit) { %>
<span
  class="ac-website-editable"
  data-website-inline="1"
  data-website-key="<%= key %>"
  data-website-type="<%= multiline ? 'textarea' : 'text' %>"
  data-website-value="<%= escAttr(value) %>"
>
  <span class="ac-website-editable__display" data-website-display="1">
    <span
      class="ac-website-editable__value"
      id="<%= fieldId %>"
      data-website-value-text="1"
      aria-label="<%= key %>"
    ><%= value %></span>
    <button
      type="button"
      class="ac-website-editable__pencil"
      data-website-start="1"
      aria-label="Edit field"
      title="Edit"
    >
      <span class="ac-website-editable__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" focusable="false"><path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
      </span>
      <span class="ac-sr-only">Edit</span>
    </button>
  </span>
  <span class="ac-website-editable__editor" data-website-editor="1" hidden>
    <span class="ac-website-editable__current">
      <span class="ac-website-editable__current-label">Current</span>
      <span class="ac-website-editable__current-value" data-website-current="1"><%= value %></span>
    </span>
    <% if (multiline) { %>
    <textarea
      class="ac-website-editable__input"
      data-website-input="1"
      rows="4"
      maxlength="8000"
      enterkeyhint="enter"
      aria-label="Edit <%= key %>"
    ><%= value %></textarea>
    <% } else { %>
    <input
      type="<%= fType === 'email' ? 'email' : (fType === 'phone' ? 'tel' : 'text') %>"
      class="ac-website-editable__input"
      data-website-input="1"
      maxlength="500"
      value="<%= escAttr(value) %>"
      enterkeyhint="done"
      autocomplete="off"
      aria-label="Edit <%= key %>"
    />
    <% } %>
    <span class="ac-website-editable__controls">
      <button
        type="button"
        class="ac-website-editable__save"
        data-website-save="1"
        aria-label="Save field to draft"
        title="Save to draft"
      >
        <span class="ac-website-editable__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" focusable="false"><path fill="currentColor" d="M9.2 16.6 4.8 12.2l1.4-1.4 3 3 8.6-8.6 1.4 1.4z"/></svg>
        </span>
        <span class="ac-sr-only">Save to draft</span>
      </button>
      <button
        type="button"
        class="ac-website-editable__cancel"
        data-website-cancel="1"
        aria-label="Cancel unsaved edit"
        title="Cancel edit"
      >
        <span class="ac-website-editable__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" focusable="false"><path fill="currentColor" d="M18.3 5.7 13 11l5.3 5.3-1.4 1.4L11.6 12.4 6.3 17.7 4.9 16.3 10.2 11 4.9 5.7 6.3 4.3l5.3 5.3 5.3-5.3z"/></svg>
        </span>
        <span class="ac-sr-only">Cancel edit</span>
      </button>
    </span>
  </span>
  <span class="ac-website-editable__status" data-website-status-msg="1" aria-live="polite"></span>
</span>
<% } else { %>
<%= value %>
<% } %>
