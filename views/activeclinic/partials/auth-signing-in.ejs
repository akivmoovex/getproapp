<div
  id="ac-auth-signing-in"
  class="ac-auth-signing-in"
  hidden
  data-ac-signing-in="1"
  data-ac-auth-screen="signing-in"
  role="status"
  aria-live="polite"
  aria-busy="false"
>
  <div class="ac-auth-signing-in__card">
    <%- include('auth-mark') %>
    <p class="ac-auth-signing-in__brand">ActiveClinic</p>
    <p class="ac-auth-signing-in__tagline">Clinical Precision with Human Warmth.</p>
    <h1 class="ac-auth-signing-in__title">Signing you in...</h1>
    <p class="ac-auth-signing-in__copy">Authenticating your credentials and preparing your secure clinical environment.</p>
  </div>
</div>
