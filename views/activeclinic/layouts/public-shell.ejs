<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <title><%= pageTitle %> · ActiveClinic</title>
  <% if (typeof metaDescription === 'string' && metaDescription) { %>
  <meta name="description" content="<%= metaDescription %>"/>
  <% } %>
  <% if (typeof canonicalUrl === 'string' && canonicalUrl) { %>
  <link rel="canonical" href="<%= canonicalUrl %>"/>
  <% } %>
  <% if (typeof robots === 'string' && robots) { %>
  <meta name="robots" content="<%= robots %>"/>
  <% } %>
  <meta property="og:title" content="<%= pageTitle %> · ActiveClinic"/>
  <% if (typeof metaDescription === 'string' && metaDescription) { %>
  <meta property="og:description" content="<%= metaDescription %>"/>
  <% } %>
  <meta property="og:type" content="website"/>
  <% var shareImage = (typeof ogImageUrl === "string" && ogImageUrl) ? ogImageUrl : (clinic && clinic.seoImageUrl) || ""; %>
  <% if (shareImage) { %>
  <meta property="og:image" content="<%= shareImage %>"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:image" content="<%= shareImage %>"/>
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <% if (shellVariant === "platform") { %>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <% } else { %>
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <% } %>
  <link rel="stylesheet" href="/activeclinic/ac-tokens.css?v=<%= assetVersion %>"/>
  <link rel="stylesheet" href="/activeclinic/ac-public.css?v=<%= assetVersion %>"/>
  <% if (shellVariant === "platform") { %>
  <link rel="stylesheet" href="/activeclinic/acw-platform.css?v=<%= assetVersion %>"/>
  <% } %>
  <link rel="stylesheet" href="/activeclinic/ac-phone-field.css?v=<%= assetVersion %>"/>
  <% if (typeof websiteCanEdit !== 'undefined' && websiteCanEdit) { %>
  <link rel="stylesheet" href="/platform/website-inline-edit.css?v=<%= assetVersion %>"/>
  <meta name="csrf-token" content="<%= csrfToken %>"/>
  <% } %>
</head>
<%
  var brandStyle = "";
  if (shellVariant === "tenant" && clinic) {
    if (clinic.brandPrimary) {
      brandStyle += "--acp-primary:" + clinic.brandPrimary + ";--acp-primary-strong:" + clinic.brandPrimary + ";";
    }
    if (clinic.brandAccent) {
      brandStyle += "--acp-primary-hover:" + clinic.brandAccent + ";";
    }
  }
%>
<body
  class="ac-public-body <%= shellVariant === 'tenant' ? 'ac-public--tenant' : 'ac-public--platform' %><%= typeof websiteCanEdit !== 'undefined' && websiteCanEdit ? ' ac-public-body--website-can-edit' : '' %><%= typeof websiteEdit !== 'undefined' && websiteEdit ? ' ac-public-body--website-editing' : '' %>"
  data-ac-product="activeclinic"
  data-ac-shell="public"
  data-ac-page="<%= pageId %>"
  data-ac-public-variant="<%= shellVariant || 'platform' %>"
  <% if (clinic && clinic.clinicKey) { %>data-pw-clinic-key="<%= clinic.clinicKey %>"<% } %>
  <% if (typeof websiteEdit !== 'undefined' && websiteEdit) { %>data-website-editing="1"<% } %>
  <% if (brandStyle) { %>style="<%= brandStyle %>"<% } %>
>
  <a class="ac-public-skip" href="#ac-public-main">Skip to content</a>
  <%- include('../partials/website-version-preview-banner') %>
  <%- headerHtml %>
  <% if (typeof websiteCanEdit !== 'undefined' && websiteCanEdit) { %>
  <div class="gp-website-chrome-stack" data-website-chrome-stack="1">
    <%- include('../partials/website-editor-chrome') %>
  </div>
  <% } %>
  <main id="ac-public-main" class="ac-public-main" tabindex="-1">
    <%- bodyHtml %>
  </main>
  <%- footerHtml %>
  <% if (shellVariant === 'tenant' && clinic) { %>
  <%- include('../partials/ac-mobile-bottom-nav') %>
  <% } else if (shellVariant === 'platform') { %>
  <%- include('../partials/ac-mobile-bottom-nav-platform') %>
  <% } %>
  <div id="ac-public-live" class="ac-sr-only" aria-live="polite"></div>
  <script src="/activeclinic/ac-a11y.js?v=<%= assetVersion %>" defer></script>
  <script src="/activeclinic/ac-public.js?v=<%= assetVersion %>" defer></script>
  <script src="/activeclinic/ac-phone-field.js?v=<%= assetVersion %>" defer></script>
  <% if (typeof websiteCanEdit !== 'undefined' && websiteCanEdit) { %>
  <script src="/platform/website-inline-edit.js?v=<%= assetVersion %>" defer></script>
  <script src="/platform/website-editor-mobile.js?v=<%= assetVersion %>" defer></script>
  <script src="/activeclinic/website-collection-edit.js?v=<%= assetVersion %>" defer></script>
  <% } %>
</body>
</html>
