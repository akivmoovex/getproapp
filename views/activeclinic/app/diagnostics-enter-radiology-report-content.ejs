<div data-ac-stitch="41a0f1b3e1974e7ca26599bf8a37fc5f" data-ac-screen="enter-radiology-report">
  <form class="ac-panel ac-form-section" method="POST">
    <input type="hidden" name="<%= (shell && shell.csrf && shell.csrf.field) || "_csrf" %>" value="<%= (shell && shell.csrf && shell.csrf.token) || "" %>" />

    <div class="ac-clinical-banner">
      <p class="ac-patient-banner__name">Request <%= pageData.reportEntry.request.requestNumber %></p>
      <p class="ac-muted"><%= pageData.reportEntry.request.patientDisplayName %> · <%= pageData.reportEntry.request.studyType %></p>
      <% if (pageData.reportEntry.request.clinicalIndication) { %>
      <p><strong>Clinical indication:</strong> <%= pageData.reportEntry.request.clinicalIndication %></p>
      <% } %>
    </div>

    <div class="ac-field ac-form-group">
      <label for="technique">Technique</label>
      <textarea name="technique" id="technique" rows="2"></textarea>
    </div>

    <div class="ac-field ac-form-group">
      <label for="findings">Findings</label>
      <textarea name="findings" id="findings" rows="6"></textarea>
    </div>

    <div class="ac-field ac-form-group">
      <label for="impression">Impression</label>
      <textarea name="impression" id="impression" rows="3"></textarea>
    </div>

    <div class="ac-field ac-form-group">
      <label class="ac-public-check">
        <input type="checkbox" name="is_critical" value="1" />
        Critical finding (requires acknowledgment)
      </label>
    </div>

    <% if (pageData.reportEntry.error) { %>
    <p class="ac-alert ac-alert--danger" role="alert"><%= pageData.reportEntry.error %></p>
    <% } %>

    <button type="submit" class="ac-btn">Enter report</button>
  </form>
</div>
