<%
  var hub = (pageData && pageData.hub) || {};
  var showLaboratory = hub.showLaboratory !== false;
  var showRadiology = hub.showRadiology !== false;
%>
<section class="ac-diagnostics-hub" data-ac-page-section="diagnostics-hub" data-ac-visual="stitch-aligned">
  <div class="ac-panel">
    <header class="ac-section-header">
      <h2 class="ac-dashboard__card-title" style="margin-top:0">Diagnostics</h2>
    </header>
    <p class="ac-muted">
      Open the diagnostic workflows you are authorized to use for the selected facility.
    </p>
    <% if (!showLaboratory && !showRadiology) { %>
    <p class="ac-muted" data-ac-diagnostics-empty="1">No diagnostic modules are available for your account.</p>
    <% } else { %>
    <div class="ac-action-grid" data-ac-diagnostics-hub="1">
      <% if (showLaboratory) { %>
      <a class="ac-action-card" href="/app/diagnostics/laboratory" data-ac-diagnostics-card="laboratory" data-ac-diagnostics-link="laboratory">
        <span class="ac-action-title">Laboratory</span>
        <span class="ac-action-description">Queues, specimens, and laboratory results</span>
      </a>
      <% } %>
      <% if (showRadiology) { %>
      <a class="ac-action-card" href="/app/diagnostics/radiology" data-ac-diagnostics-card="radiology" data-ac-diagnostics-link="radiology">
        <span class="ac-action-title">Radiology</span>
        <span class="ac-action-description">Imaging queues and radiology reports</span>
      </a>
      <% } %>
    </div>
    <% } %>
  </div>
</section>
