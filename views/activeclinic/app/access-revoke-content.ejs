<%
  var revoke = (pageData && pageData.revoke) || {};
  var assignment = revoke.assignment || {};
  var staff = revoke.staff || {};
  var csrf = (shell && shell.csrf) || { field: '_csrf', token: '' };
%>
<section class="ac-access-revoke" data-ac-page-section="access-revoke" data-ac-visual="stitch-gap">
  <div class="ac-panel">
    <h2 class="ac-dashboard__card-title" style="margin-top:0">Confirm revocation</h2>
    <p>
      Revoke <strong><%= assignment.roleLabel || 'this role' %></strong>
      (<%= assignment.scopeLabel || 'scoped access' %>)
      for <strong><%= staff.displayName || 'this staff member' %></strong>?
    </p>
    <p class="ac-muted">
      Access ends immediately. The assignment remains in history for audit and is not hard-deleted.
      Other role assignments for this staff member are unchanged.
    </p>

    <form method="post" action="<%= revoke.formAction %>" data-ac-loading="1">
      <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
      <div class="ac-field">
        <label class="ac-label" for="reason">Reason <span class="ac-muted">(optional)</span></label>
        <input class="ac-input" id="reason" name="reason" maxlength="500" placeholder="e.g. role change, left facility"/>
      </div>
      <div class="ac-actions-row">
        <button type="submit" class="ac-btn ac-btn--danger">Revoke access</button>
        <a class="ac-btn ac-btn--ghost" href="<%= revoke.cancelHref || '/app/access' %>">Cancel</a>
      </div>
    </form>
  </div>
</section>
