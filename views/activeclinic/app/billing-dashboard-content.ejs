<%
  var dash = (pageData && pageData.dashboard) || {};
  var unpaid = dash.unpaidInvoices || {};
  var todayPayments = dash.todayPayments || {};
  var stitch = (pageData && pageData.stitch) || {};
%>
<section class="ac-billing-dashboard" data-ac-page-section="billing-dashboard" data-ac-stitch-desktop="<%= stitch.desktop || '' %>" data-ac-stitch-mobile="<%= stitch.mobile || '' %>">
  <article class="ac-panel">
    <header class="ac-section-header">
      <h2 class="ac-dashboard__card-title">Billing overview</h2>
    </header>
    <p class="ac-dashboard__lead">Revenue, invoices, and outstanding balances.</p>
  </article>

  <div class="ac-dashboard__summaries ac-metric-grid">
    <article class="ac-panel ac-stat-card">
      <p class="ac-stat-card__label">Unpaid invoices</p>
      <p class="ac-stat-card__value"><%= unpaid.count || 0 %></p>
      <p class="ac-muted ac-money"><%= unpaid.totalFormatted || 'ZMW 0.00' %> outstanding</p>
      <a class="ac-stat-card__link" href="/app/billing/invoices?status=unpaid">View unpaid</a>
    </article>

    <article class="ac-panel ac-stat-card">
      <p class="ac-stat-card__label">Today's payments</p>
      <p class="ac-stat-card__value"><%= todayPayments.count || 0 %></p>
      <p class="ac-muted ac-money"><%= todayPayments.totalFormatted || 'ZMW 0.00' %> collected</p>
      <a class="ac-stat-card__link" href="/app/cashier">Open cashier</a>
    </article>
  </div>

  <article class="ac-panel">
    <header class="ac-section-header">
      <h2 class="ac-dashboard__card-title">Quick actions</h2>
    </header>
    <div class="ac-action-grid">
      <a class="ac-action-card" href="/app/billing/catalog">
        <span class="ac-action-title">Charge catalog</span>
        <span class="ac-action-description">Manage billable items</span>
      </a>
      <a class="ac-action-card" href="/app/billing/invoices">
        <span class="ac-action-title">Invoices</span>
        <span class="ac-action-description">Browse patient invoices</span>
      </a>
      <a class="ac-action-card" href="/app/cashier">
        <span class="ac-action-title">Cashier</span>
        <span class="ac-action-description">Collect payments</span>
      </a>
    </div>
  </article>
</section>
