<div data-ac-stitch="f8b17233f1f7457ea5fe5179207aa0d1" data-ac-screen="laboratory-queue">
  <% if (pageData.queue.requests.length === 0) { %>
  <%- include('../partials/ac-inline-state', {
    inlineState: {
      stateKey: 'empty',
      marker: 'lab-queue-empty',
      title: 'No pending laboratory requests',
      description: 'New lab orders from clinical encounters will appear here.'
    }
  }) %>
  <% } else { %>
  <div class="ac-panel ac-table-wrap ac-desktop-table">
    <table class="ac-table">
      <thead>
        <tr>
          <th>Request #</th>
          <th>Patient</th>
          <th>Test panel</th>
          <th>Urgency</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% pageData.queue.requests.forEach(function (req) { %>
        <tr>
          <td><a href="/app/diagnostics/laboratory/request/<%= req.id %>"><%= req.requestNumber %></a></td>
          <td><%= req.patientDisplayName %></td>
          <td><%= req.testPanelName %></td>
          <td><%= req.urgency %></td>
          <td><span class="ac-status" data-ac-status="<%= req.status %>"><%= req.status %></span></td>
          <td>
            <a class="ac-btn ac-btn--ghost ac-btn--table" href="/app/diagnostics/laboratory/request/<%= req.id %>">View</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <ul class="ac-card-list ac-mobile-table-cards" data-ac-cards="lab-queue">
    <% pageData.queue.requests.forEach(function (req) { %>
    <li class="ac-card ac-mobile-record-card">
      <a class="ac-card__link" href="/app/diagnostics/laboratory/request/<%= req.id %>">
        <p class="ac-card__title"><%= req.requestNumber %></p>
        <p class="ac-muted"><%= req.patientDisplayName %></p>
        <p class="ac-muted"><%= req.testPanelName %> · <%= req.urgency %></p>
        <p><span class="ac-status" data-ac-status="<%= req.status %>"><%= req.status %></span></p>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>
</div>
