<%
  var items = (pageData && pageData.items) || [];
  var caps = (pageData && pageData.capabilities) || {};
  var stitch = (pageData && pageData.stitch) || {};
%>
<section class="ac-billing-credit-notes" data-ac-page-section="billing-credit-notes" data-ac-stitch-desktop="<%= stitch.desktop || '' %>">
  <article class="ac-panel">
    <% if (items.length === 0) { %>
      <%- include('../partials/ac-inline-state', {
        inlineState: {
          stateKey: 'empty',
          marker: 'credit-notes-empty',
          title: 'No credit notes',
          description: 'Issued credit notes will appear here.',
          primaryAction: caps.canCreate
            ? { href: '/app/billing/credit-notes/new', label: 'New credit note' }
            : null
        }
      }) %>
    <% } else { %>
      <table class="ac-table">
        <thead>
          <tr>
            <th>Number</th>
            <th>Patient</th>
            <th>Invoice</th>
            <th>Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function (row) { %>
          <tr>
            <td><a href="/app/billing/credit-notes/<%= row.id %>"><%= row.creditNoteNumber %></a></td>
            <td><%= row.patientName %> · <%= row.patientNumber %></td>
            <td><%= row.invoiceNumber || '—' %></td>
            <td class="ac-money"><%= row.amountFormatted %></td>
            <td><span class="ac-status" data-status="<%= row.status %>"><%= row.status %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </article>
</section>
