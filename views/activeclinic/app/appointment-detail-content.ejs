<%
  var detail = (pageData && pageData.detail) || {};
  var a = detail.appointment || {};
  var actions = detail.actions || {};
  var events = detail.statusEvents || [];
  var lifecycle = detail.lifecycle || [];
  var reminders = detail.reminders || [];
  var stitch = detail.stitch || {};
  var csrf = (shell && shell.csrf) || { field: '_csrf', token: '' };
%>
<section
  class="ac-batch1a ac-appointment-detail"
  data-ac-page-section="appointment-detail"
  data-ac-stitch="ACN08"
  data-ac-stitch-desktop="<%= stitch.desktop || '' %>"
  data-ac-status="<%= a.status || '' %>"
>
  <div class="ac-panel">
    <div class="ac-batch1a__profile-head">
      <div>
        <h2 class="ac-batch1a__section-title">Appointment</h2>
        <p class="ac-muted"><%= (a.when && a.when.dateLabel) || '' %> · <%= (a.when && a.when.timeLabel) || '' %></p>
      </div>
      <span class="ac-status" data-ac-status="<%= a.status %>"><%= a.statusLabel || a.status %></span>
    </div>

    <ol class="ac-lifecycle" data-ac-lifecycle="1" aria-label="Appointment status lifecycle">
      <% lifecycle.forEach(function (step) { %>
      <li class="ac-lifecycle__step<%= step.current ? ' is-current' : '' %><%= step.reached ? ' is-reached' : '' %>" data-ac-lifecycle-step="<%= step.key %>">
        <span class="ac-lifecycle__dot" aria-hidden="true"></span>
        <span class="ac-lifecycle__label"><%= step.label %></span>
      </li>
      <% }) %>
    </ol>

    <dl class="ac-dl">
      <div><dt>Patient</dt><dd>
        <% if (a.patient) { %>
        <a href="/app/patients/<%= encodeURIComponent(a.patient.patientNumber) %>"><%= a.patient.displayName %></a>
        (<%= a.patient.patientNumber %>)
        <% } else { %>—<% } %>
      </dd></div>
      <div><dt>Location</dt><dd><%= (a.facility && a.facility.displayName) || '—' %></dd></div>
      <div><dt>Service</dt><dd><%= (a.service && a.service.displayName) || '—' %></dd></div>
      <div><dt>Practitioner</dt><dd><%= (a.assignedStaff && a.assignedStaff.displayName) || 'Unassigned' %></dd></div>
      <div><dt>Note</dt><dd><%= a.schedulingNote || '—' %></dd></div>
      <% if (a.cancellationReason) { %>
      <div><dt>Cancellation reason</dt><dd><%= a.cancellationReason %></dd></div>
      <% } %>
    </dl>
  </div>

  <div class="ac-panel ac-appointment-actions" data-ac-appointment-actions="1">
    <h2 class="ac-batch1a__section-title">Actions</h2>
    <div class="ac-form-actions ac-form-actions--wrap">
      <% if (actions.canConfirm) { %>
      <form method="post" action="/app/appointments/<%= a.id %>/confirm" class="ac-inline-form">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn">Confirm</button>
      </form>
      <% } %>
      <% if (actions.canCheckIn) { %>
      <form method="post" action="/app/appointments/<%= a.id %>/check-in" class="ac-inline-form">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn">Mark arrived</button>
      </form>
      <% } %>
      <% if (actions.canWaiting) { %>
      <form method="post" action="/app/appointments/<%= a.id %>/waiting" class="ac-inline-form">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn">Waiting</button>
      </form>
      <% } %>
      <% if (actions.canWithPractitioner) { %>
      <form method="post" action="/app/appointments/<%= a.id %>/with-practitioner" class="ac-inline-form">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn">With practitioner</button>
      </form>
      <% } %>
      <% if (actions.canComplete) { %>
      <form method="post" action="/app/appointments/<%= a.id %>/complete" class="ac-inline-form">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn">Complete</button>
      </form>
      <% } %>
      <% if (actions.canEdit) { %>
      <a class="ac-btn ac-btn--ghost" href="<%= actions.editHref %>">Reschedule</a>
      <% } %>
      <% if (actions.canNoShow) { %>
      <form method="post" action="/app/appointments/<%= a.id %>/no-show" class="ac-inline-form">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn ac-btn--ghost">No-show</button>
      </form>
      <% } %>
      <% if (actions.canCancel) { %>
      <a class="ac-btn ac-btn--danger" href="<%= actions.cancelHref %>">Cancel</a>
      <% } %>
    </div>
  </div>

  <div class="ac-panel">
    <h2 class="ac-batch1a__section-title">Audit trail &amp; status history</h2>
    <% if (!events.length) { %>
    <p class="ac-muted">No events yet.</p>
    <% } else { %>
    <ol class="ac-timeline" data-ac-status-history="1">
      <% events.forEach(function (e) { %>
      <li>
        <strong><%= e.toStatusLabel || e.toStatus %></strong>
        <% if (e.fromStatusLabel) { %> <span class="ac-muted">from <%= e.fromStatusLabel %></span><% } %>
        <% if (e.reasonCode) { %> · <%= e.reasonCode %><% } %>
        <% if (e.createdAtLabel) { %> · <span class="ac-muted"><%= e.createdAtLabel %></span><% } %>
      </li>
      <% }) %>
    </ol>
    <% } %>
  </div>

  <% if (reminders.length) { %>
  <div class="ac-panel">
    <h2 class="ac-batch1a__section-title">Reminder metadata</h2>
    <ul>
      <% reminders.forEach(function (r) { %>
      <li><%= r.channel %> · <%= r.deliveryState %></li>
      <% }) %>
    </ul>
  </div>
  <% } %>
</section>
