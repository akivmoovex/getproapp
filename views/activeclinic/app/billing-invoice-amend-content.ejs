<%
  var invoice = (pageData && pageData.invoice) || {};
  var csrf = (shell && shell.csrf) || { field: '_csrf', token: '' };
%>
<section class="ac-panel" data-ac-page-section="invoice-amend">
  <h2 class="ac-dashboard__card-title">Amend invoice <%= invoice.invoice_number %></h2>
  <p class="ac-muted">Elevated action. Adjust notes or adjustment amount on a posted invoice.</p>
  <form method="POST" action="/app/billing/invoices/<%= invoice.id %>/amend">
    <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>" />
    <div class="ac-form-group">
      <label for="notes">Notes</label>
      <textarea id="notes" name="notes" rows="3"><%= invoice.notes || '' %></textarea>
    </div>
    <div class="ac-form-group">
      <label for="adjustment">Adjustment amount</label>
      <input id="adjustment" name="adjustment" type="text" value="<%= ((invoice.adjustment_minor || 0) / 100).toFixed(2) %>" />
    </div>
    <div class="ac-form-group">
      <label for="reason">Reason *</label>
      <textarea id="reason" name="reason" rows="2" required></textarea>
    </div>
    <button type="submit" class="ac-btn" data-ac-finance-action="amend-invoice">Save amendment</button>
  </form>
</section>
