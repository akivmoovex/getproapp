<%
  var session = (pageData && pageData.session) || {};
  var stitch = (pageData && pageData.stitch) || {};
  var csrf = (shell && shell.csrf) || { field: '_csrf', token: '' };
%>
<section class="ac-cashier-close" data-ac-page-section="cashier-close" data-ac-stitch-desktop="<%= stitch.desktop || '' %>">
  <form method="post" action="/app/cashier/close" class="ac-panel" data-ac-loading="1">
    <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>" />

    <p class="ac-flash ac-flash--warning" role="alert">
      <strong>Closing this session will finalize the cash count.</strong>
      Count all cash in your drawer and enter the actual amount below.
    </p>

    <article class="ac-field-group">
      <h3 class="ac-label">Session summary</h3>
      <dl class="ac-dl">
        <div><dt>Session number</dt><dd><strong><%= session.sessionNumber %></strong></dd></div>
        <div><dt>Opening cash</dt><dd><%= session.openingCashFormatted %></dd></div>
        <div><dt>Total payments collected</dt><dd><%= session.totalPaymentsFormatted %></dd></div>
        <div><dt>Expected cash</dt><dd><strong><%= session.expectedCashFormatted %></strong></dd></div>
      </dl>
    </article>

    <div class="ac-field">
      <label class="ac-label" for="actual_cash">Actual cash count (ZMW) *</label>
      <input class="ac-input" id="actual_cash" name="actual_cash" required inputmode="decimal" pattern="[0-9]+(\.[0-9]{1,2})?" placeholder="e.g., <%= session.expectedCashFormatted %>" autofocus />
      <p class="ac-help">Count all cash in your drawer and enter the total amount.</p>
    </div>

    <div class="ac-field">
      <label class="ac-label" for="notes">Closing notes (optional)</label>
      <textarea class="ac-textarea" id="notes" name="notes" rows="3" maxlength="500"></textarea>
    </div>

    <div class="ac-form-actions">
      <button type="submit" class="ac-btn">Close session</button>
      <a href="/app/cashier/session" class="ac-btn ac-btn--ghost">Cancel</a>
    </div>
  </form>
</section>
