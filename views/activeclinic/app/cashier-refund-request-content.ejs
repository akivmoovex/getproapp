<%
  var payment = (pageData && pageData.payment) || {};
  var error = pageData && pageData.error;
  var stitch = (pageData && pageData.stitch) || {};
  var csrf = (shell && shell.csrf) || { field: '_csrf', token: '' };
%>
<section class="ac-refund-request" data-ac-page-section="refund-request" data-ac-stitch-desktop="<%= stitch.desktop || '' %>" data-ac-stitch-mobile="<%= stitch.mobile || '' %>">
  <% if (error) { %>
  <div class="ac-panel ac-alert ac-alert--error" role="alert"><%= error %></div>
  <% } %>

  <nav class="ac-stepper" aria-label="Refund steps">
    <ol class="ac-stepper__list">
      <li class="ac-stepper__item ac-stepper__item--active" aria-current="step">Request</li>
      <li class="ac-stepper__item">Review</li>
      <li class="ac-stepper__item">Outcome</li>
    </ol>
  </nav>

  <article class="ac-panel">
    <p class="ac-muted">Payment <strong><%= payment.paymentNumber %></strong> · <%= payment.patientName %> · <%= payment.amountFormatted %></p>
  </article>

  <form method="post" action="/app/cashier/refunds/request" class="ac-panel" data-ac-loading="1">
    <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>" />
    <input type="hidden" name="payment_id" value="<%= payment.id %>" />

    <div class="ac-field">
      <label class="ac-label" for="amount">Refund amount (ZMW) *</label>
      <input class="ac-input" id="amount" name="amount" required inputmode="decimal" pattern="[0-9]+(\.[0-9]{1,2})?" />
    </div>

    <div class="ac-field">
      <label class="ac-label" for="reason">Reason *</label>
      <textarea class="ac-textarea" id="reason" name="reason" rows="3" required maxlength="500"></textarea>
    </div>

    <div class="ac-form-actions">
      <button type="submit" class="ac-btn">Submit refund request</button>
      <a href="/app/cashier/session" class="ac-btn ac-btn--ghost">Cancel</a>
    </div>
  </form>
</section>
