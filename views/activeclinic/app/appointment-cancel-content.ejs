<%
  var cancel = (pageData && pageData.cancel) || {};
  var a = cancel.appointment || {};
  var csrf = (shell && shell.csrf) || { field: '_csrf', token: '' };
%>
<section class="ac-appointment-cancel" data-ac-page-section="appointment-cancel" data-ac-stitch-cancel="<%= cancel.stitch || '' %>">
  <div class="ac-panel">
    <h2 class="ac-panel__title">Cancel this appointment?</h2>
    <p><strong><%= (a.patient && a.patient.displayName) || 'Patient appointment' %></strong></p>
    <p class="ac-muted"><%= (a.when && a.when.dateLabel) || '' %> · <%= (a.when && a.when.timeLabel) || '' %></p>
    <form method="post" action="/app/appointments/<%= a.id %>/cancel">
      <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
      <label class="ac-label" for="cancel_reason">Cancellation reason</label>
      <textarea class="ac-input" id="cancel_reason" name="reason" required maxlength="200" rows="3"></textarea>
      <div class="ac-form-actions">
        <button type="submit" class="ac-btn ac-btn--danger">Confirm cancellation</button>
        <a class="ac-btn ac-btn--ghost" href="/app/appointments/<%= a.id %>">Keep appointment</a>
      </div>
    </form>
  </div>
</section>
