<%
  var overview = (pageData && pageData.overview) || {};
  var staffRows = overview.staffRows || [];
  var assignments = overview.assignments || [];
  var filters = overview.filters || {};
  var filterOptions = overview.filterOptions || {};
  var roles = overview.roles || [];
  var emptyMode = overview.emptyMode;
  var actions = overview.actions || {};
  var tab = overview.tab || 'staff';
  var viewMode = overview.viewMode || 'staff';
%>
<section class="ac-access" data-ac-page-section="access-overview" data-ac-visual="stitch-gap" data-ac-access-tab="<%= tab %>">
  <nav class="ac-segmented" aria-label="Roles and access sections" data-ac-access-tabs="1">
    <a class="ac-segmented__item <%= tab === 'staff' ? 'is-active' : '' %>" href="/app/access?tab=staff" data-ac-tab="staff">Staff access</a>
    <a class="ac-segmented__item <%= tab === 'catalogue' ? 'is-active' : '' %>" href="/app/access?tab=catalogue" data-ac-tab="catalogue">Role catalogue</a>
  </nav>

  <% if (tab === 'catalogue') { %>
  <div class="ac-panel" data-ac-access-catalogue="1">
    <h2 class="ac-dashboard__card-title" style="margin-top:0">ActiveClinic role catalogue</h2>
    <p class="ac-muted">System roles and their operational responsibilities. Custom roles are not available.</p>
    <div class="ac-access-catalogue">
      <% roles.forEach(function (role) { %>
      <article class="ac-access-catalogue__role" data-ac-role-key="<%= role.key %>">
        <header>
          <h3 style="margin:0;font-size:1rem"><%= role.label %></h3>
          <p class="ac-muted" style="margin:.25rem 0 0">
            <%= role.scopeLabel %>
            · <%= role.staffCount %> staff
            <% if (role.compatibility) { %> · Compatibility / legacy<% } %>
          </p>
        </header>
        <p style="margin:.75rem 0"><%= role.description %></p>
        <% if (role.capabilityGroups && role.capabilityGroups.length) { %>
        <ul class="ac-role-chips" aria-label="Capability groups">
          <% role.capabilityGroups.forEach(function (g) { %>
          <li class="ac-chip"><%= g.label %> (<%= g.count %>)</li>
          <% }) %>
        </ul>
        <% } %>
      </article>
      <% }) %>
    </div>
  </div>
  <% } else { %>

  <form class="ac-panel ac-filter-bar" method="get" action="/app/access" data-ac-access-filters="1">
    <input type="hidden" name="tab" value="staff"/>
    <div class="ac-filter-bar__grid ac-filter-bar__grid--staff">
      <div>
        <label class="ac-label" for="access_search">Search</label>
        <input class="ac-input" id="access_search" name="q" type="search" value="<%= filters.q || '' %>" placeholder="Name or role" autocomplete="off"/>
      </div>
      <div>
        <label class="ac-label" for="access_status">Status</label>
        <select class="ac-select" id="access_status" name="status">
          <% (filterOptions.statuses || []).forEach(function (s) { %>
          <option value="<%= s.value %>" <%= filters.status === s.value ? 'selected' : '' %>><%= s.label %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="ac-label" for="access_role">Role</label>
        <select class="ac-select" id="access_role" name="role">
          <option value="">All roles</option>
          <% (filterOptions.roles || []).forEach(function (r) { %>
          <option value="<%= r.value %>" <%= filters.role === r.value ? 'selected' : '' %>><%= r.label %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="ac-label" for="access_facility">Facility</label>
        <select class="ac-select" id="access_facility" name="facility">
          <option value="">All facilities</option>
          <% (filterOptions.facilities || []).forEach(function (f) { %>
          <option value="<%= f.value %>" <%= filters.facility === f.value ? 'selected' : '' %>><%= f.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="ac-filter-bar__checks">
        <button type="submit" class="ac-btn">Apply</button>
        <% if (filters.active) { %>
        <a class="ac-btn ac-btn--ghost" href="/app/access?tab=staff">Clear</a>
        <% } %>
      </div>
    </div>
  </form>

  <% if (overview.resultCount != null && !emptyMode) { %>
  <p class="ac-muted" data-ac-result-count="<%= overview.resultCount %>">
    <%= overview.resultCount %>
    <%= viewMode === 'assignments' ? 'assignment' : 'staff member' %><%= overview.resultCount === 1 ? '' : (viewMode === 'assignments' ? 's' : 's') %>
  </p>
  <% } %>

  <% if (emptyMode === 'none') { %>
  <%- include('../partials/ac-inline-state', {
    inlineState: {
      stateKey: 'empty',
      marker: 'access-none',
      title: 'No staff access records yet',
      description: 'Invite staff from the directory, then assign ActiveClinic roles here.',
      primaryAction: actions.staffDirectoryHref
        ? { href: actions.staffDirectoryHref, label: 'Open staff directory' }
        : null
    }
  }) %>
  <% } else if (emptyMode === 'filtered') { %>
  <%- include('../partials/ac-inline-state', {
    inlineState: {
      stateKey: 'no_results',
      marker: 'access-filtered',
      title: 'No staff match these filters',
      description: 'Try different search terms, or clear filters to see all staff you can manage.',
      secondaryAction: { href: '/app/access?tab=staff', label: 'Clear filters' }
    }
  }) %>
  <% } else if (viewMode === 'assignments') { %>
  <div class="ac-table-wrap" data-ac-access-table="1">
    <table class="ac-table">
      <caption class="ac-sr-only">ActiveClinic role assignments</caption>
      <thead>
        <tr>
          <th scope="col">Staff</th>
          <th scope="col">Role</th>
          <th scope="col">Scope</th>
          <th scope="col">Effective</th>
          <th scope="col">Expires</th>
          <th scope="col"><span class="ac-sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% assignments.forEach(function (row) { %>
        <tr data-ac-access-row="1" data-effective="<%= row.effective ? '1' : '0' %>">
          <td>
            <a href="<%= row.detailHref %>"><%= row.staff.displayName %></a>
            <div class="ac-muted"><%= row.staff.jobTitle || row.staff.status || '' %></div>
          </td>
          <td><%= row.roleLabel %></td>
          <td><%= row.scopeLabel %></td>
          <td>
            <% if (row.effective) { %>
            <span class="ac-badge ac-badge--success">Effective</span>
            <% } else { %>
            <span class="ac-badge ac-badge--warning">Not effective</span>
            <% } %>
          </td>
          <td><%= row.expiresAt ? new Date(row.expiresAt).toLocaleString() : 'No expiry' %></td>
          <td><a class="ac-btn ac-btn--ghost" href="<%= row.detailHref %>">Manage</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <ul class="ac-card-list ac-card-list--mobile" data-ac-access-cards="1" aria-label="Role assignments">
    <% assignments.forEach(function (row) { %>
    <li class="ac-panel">
      <a class="ac-card-link" href="<%= row.detailHref %>">
        <strong><%= row.staff.displayName %></strong>
        <div><%= row.roleLabel %> · <%= row.scopeLabel %></div>
        <div class="ac-muted"><%= row.effective ? 'Effective' : 'Not effective' %></div>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } else { %>
  <div class="ac-table-wrap" data-ac-access-table="1" data-ac-staff-access-table="1">
    <table class="ac-table">
      <caption class="ac-sr-only">Staff access</caption>
      <thead>
        <tr>
          <th scope="col">Staff member</th>
          <th scope="col">Job title</th>
          <th scope="col">Account</th>
          <th scope="col">Facilities</th>
          <th scope="col">Roles</th>
          <th scope="col">Access</th>
          <th scope="col"><span class="ac-sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% staffRows.forEach(function (row) { %>
        <tr data-ac-staff-access-row="1" data-account="<%= (row.accountStatus && row.accountStatus.key) || '' %>">
          <td><a href="<%= row.detailHref %>"><%= row.displayName %></a></td>
          <td><%= row.jobTitle || '—' %></td>
          <td><%= (row.accountStatus && row.accountStatus.label) || '—' %></td>
          <td>
            <% if (!(row.facilities || []).length) { %>—<% } else { %>
            <ul class="ac-role-chips">
              <% row.facilities.forEach(function (f) { %>
              <li class="ac-chip"><%= f.displayName %></li>
              <% }) %>
            </ul>
            <% } %>
          </td>
          <td>
            <% if (!(row.roles || []).length) { %><span class="ac-muted">None</span><% } else { %>
            <ul class="ac-role-chips">
              <% row.roles.forEach(function (r) { %>
              <li class="ac-chip"><%= r.roleLabel %></li>
              <% }) %>
            </ul>
            <% } %>
          </td>
          <td><%= (row.accessStatus && row.accessStatus.label) || '—' %></td>
          <td><a class="ac-btn ac-btn--ghost" href="<%= row.detailHref %>">Manage</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <ul class="ac-card-list ac-card-list--mobile" data-ac-access-cards="1" aria-label="Staff access">
    <% staffRows.forEach(function (row) { %>
    <li class="ac-panel">
      <a class="ac-card-link" href="<%= row.detailHref %>">
        <strong><%= row.displayName %></strong>
        <div class="ac-muted"><%= row.jobTitle || 'No job title' %> · <%= (row.accountStatus && row.accountStatus.label) || '' %></div>
        <div class="ac-role-chips" style="margin-top:.5rem">
          <% (row.roles || []).forEach(function (r) { %>
          <span class="ac-chip"><%= r.roleLabel %></span>
          <% }) %>
          <% if (!(row.roles || []).length) { %><span class="ac-chip">No roles</span><% } %>
        </div>
        <div class="ac-muted" style="margin-top:.5rem">
          <% (row.facilities || []).forEach(function (f, idx) { %><%= idx ? ' · ' : '' %><%= f.displayName %><% }) %>
          <% if (!(row.facilities || []).length) { %>No facilities<% } %>
        </div>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>
  <% } %>
</section>
