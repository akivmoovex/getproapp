<%
  var patient = (pageData && pageData.patient) || {};
  var charges = (pageData && pageData.charges) || [];
  var invoices = (pageData && pageData.invoices) || [];
  var stitch = (pageData && pageData.stitch) || {};
%>
<section class="ac-patient-billing-account" data-ac-page-section="patient-billing" data-ac-stitch-desktop="<%= stitch.desktop || '' %>" data-ac-stitch-mobile="<%= stitch.mobile || '' %>">
  <article class="ac-panel">
    <h2 class="ac-dashboard__card-title">Patient</h2>
    <dl class="ac-dl">
      <div><dt>Patient number</dt><dd><%= patient.patientNumber %></dd></div>
      <div><dt>Name</dt><dd><%= patient.displayName %></dd></div>
    </dl>
  </article>

  <article class="ac-panel">
    <h2 class="ac-dashboard__card-title">Invoices</h2>
    <% if (invoices.length === 0) { %>
      <p class="ac-muted">No invoices on file.</p>
    <% } else { %>
      <table class="ac-table">
        <thead>
          <tr>
            <th>Invoice number</th>
            <th>Date</th>
            <th>Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% invoices.forEach(function (inv) { %>
          <tr>
            <td><a href="/app/billing/invoices/<%= inv.id %>"><%= inv.invoice_number %></a></td>
            <td><%= inv.invoice_date %></td>
            <td><%= inv.totalAmountFormatted %></td>
            <td><span class="ac-status" data-status="<%= inv.status %>"><%= inv.status %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </article>

  <article class="ac-panel">
    <h2 class="ac-dashboard__card-title">Charges</h2>
    <% if (charges.length === 0) { %>
      <p class="ac-muted">No charges on file.</p>
    <% } else { %>
      <ul class="ac-simple-list">
        <% charges.forEach(function (c) { %>
        <li>
          <strong><%= c.description %></strong>
          <span><%= c.totalAmountFormatted %></span>
          <span class="ac-status" data-status="<%= c.status %>"><%= c.status %></span>
        </li>
        <% }) %>
      </ul>
    <% } %>
  </article>
</section>
