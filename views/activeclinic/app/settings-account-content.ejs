<%
  var account = (pageData && pageData.account) || {};
  var csrf = (shell && shell.csrf) || { field: '_csrf', token: '' };
%>
<section class="ac-settings-account" data-ac-page-section="settings-account" data-ac-visual="stitch-gap">
  <div class="ac-panel">
    <h2 class="ac-dashboard__card-title" style="margin-top:0">Signed-in context</h2>
    <dl class="ac-dl">
      <div><dt>Staff profile</dt><dd><%= account.staffDisplayName || '—' %></dd></div>
      <div><dt>Organization</dt><dd><%= account.organizationName || '—' %></dd></div>
    </dl>
    <% if (account.mustChangePassword) { %>
    <p class="ac-flash ac-flash--warning" data-ac-must-change="1">Your account requires a password change before continuing normal use.</p>
    <% } %>
  </div>

  <div class="ac-panel">
    <h2 class="ac-dashboard__card-title" style="margin-top:0">Security actions</h2>
    <div class="ac-actions-row ac-actions--stack-mobile">
      <a class="ac-btn" href="<%= account.changePasswordHref || '/account/change-password' %>">Change password</a>
      <form method="post" action="<%= account.logoutHref || '/logout' %>" style="margin:0">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn ac-btn--ghost">Sign out</button>
      </form>
    </div>
  </div>

  <p><a class="ac-btn ac-btn--ghost" href="/app/settings">Back to settings</a></p>
</section>
