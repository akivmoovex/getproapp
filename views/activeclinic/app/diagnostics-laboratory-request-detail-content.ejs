<div data-ac-stitch="51c3b93fec6e40aebc327a4998fb29ea" data-ac-screen="laboratory-request-detail" id="laboratory-request-print" data-ac-print-region="laboratory-request">
  <div class="ac-form-actions">
    <button type="button" class="ac-btn ac-btn--ghost" data-ac-print="laboratory-request" onclick="window.print()">Print laboratory request</button>
  </div>
  <div class="ac-panel ac-form-section ac-detail">
    <dl class="ac-dl">
      <div><dt>Request</dt><dd><%= pageData.request.requestNumber %></dd></div>
      <div><dt>Patient</dt><dd><%= pageData.request.patientDisplayName %></dd></div>
      <div><dt>Test panel</dt><dd><%= pageData.request.testPanelName %></dd></div>
      <div><dt>Status</dt><dd><span class="ac-status" data-ac-status="<%= pageData.request.status %>"><%= pageData.request.status %></span></dd></div>
      <div><dt>Urgency</dt><dd><%= pageData.request.urgency %></dd></div>
      <% if (pageData.request.clinicalNotes) { %>
      <div><dt>Clinical notes</dt><dd><%= pageData.request.clinicalNotes %></dd></div>
      <% } %>
    </dl>
  </div>

  <% if (pageData.request.events.length > 0) { %>
  <div class="ac-panel ac-table-wrap">
    <h3>Specimen events</h3>
    <table class="ac-table">
      <thead>
        <tr>
          <th>Event type</th>
          <th>Specimen ID</th>
          <th>Note</th>
          <th>Time</th>
        </tr>
      </thead>
      <tbody>
        <% pageData.request.events.forEach(function (evt) { %>
        <tr>
          <td><%= evt.event_type %></td>
          <td><%= evt.specimen_identifier %></td>
          <td><%= evt.event_note || evt.rejection_reason || '' %></td>
          <td><%= new Date(evt.created_at).toLocaleString() %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <% if (pageData.request.result) { %>
  <div class="ac-panel" id="laboratory-result-print" data-ac-lab-result="1" data-ac-print-region="laboratory-result">
    <h3>Laboratory result</h3>
    <% if (pageData.request.result.summary) { %>
    <p data-ac-lab-result-summary="1"><%= pageData.request.result.summary %></p>
    <% } %>
    <% if (pageData.request.result.components && pageData.request.result.components.length) { %>
    <table class="ac-table" data-ac-lab-components="1">
      <thead>
        <tr>
          <th>Test</th>
          <th>Value</th>
          <th>Unit</th>
          <th>Interpretation</th>
        </tr>
      </thead>
      <tbody>
        <% pageData.request.result.components.forEach(function (comp) { %>
        <tr data-ac-lab-component="1" data-ac-lab-component-name="<%= comp.testName %>">
          <td><%= comp.testName %><% if (comp.testCode) { %> (<%= comp.testCode %>)<% } %></td>
          <td data-ac-lab-component-value="1"><%= comp.valueNumeric != null ? comp.valueNumeric : (comp.valueText || '') %></td>
          <td><%= comp.unit || '' %></td>
          <td><%= comp.interpretation || '' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
    <p class="ac-muted">Status <%= pageData.request.result.status %></p>
    <% if (pageData.request.actions.canPrint) { %>
    <button type="button" class="ac-btn" data-ac-print="laboratory-result" onclick="window.print()">Print result</button>
    <% } %>
    <% if (pageData.request.actions.canVerify) { %>
    <form method="post" action="/app/diagnostics/laboratory/results/<%= pageData.request.result.id %>/verify">
      <input type="hidden" name="<%= (shell && shell.csrf && shell.csrf.field) || "_csrf" %>" value="<%= (shell && shell.csrf && shell.csrf.token) || "" %>" />
      <input type="hidden" name="request_id" value="<%= pageData.request.id %>" />
      <button type="submit" class="ac-btn">Verify result</button>
    </form>
    <% } %>
  </div>
  <% } %>
</div>
