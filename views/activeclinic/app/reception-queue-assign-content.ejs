<%
  var action = (pageData && pageData.action) || {};
  var e = action.queueEntry || {};
  var csrf = (shell && shell.csrf) || { field: '_csrf', token: '' };
%>
<section class="ac-queue-assign" data-ac-page-section="reception-queue-assign" data-ac-stitch-assignment="<%= action.stitch || '' %>">
  <div class="ac-panel">
    <h2 class="ac-panel__title">Assign room or desk</h2>
    <p>Queue <strong><%= e.queueNumber || '—' %></strong> remains <%= e.statusLabel || e.status %>.</p>
    <form method="post" action="/app/reception/queue/<%= e.id %>/assign">
      <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
      <label class="ac-label" for="assigned_room">Room / desk</label>
      <input class="ac-input" id="assigned_room" name="assigned_room" maxlength="64" value="<%= e.assignedRoom || '' %>" placeholder="e.g. Room 3"/>
      <div class="ac-form-actions">
        <button type="submit" class="ac-btn">Save assignment</button>
        <a class="ac-btn ac-btn--ghost" href="/app/reception/queue/<%= e.id %>">Cancel</a>
      </div>
    </form>
  </div>
</section>
