<% var cms = (pageData && pageData.cms) || {}; var media = cms.media || []; var selected = cms.selected || null; var selectMode = cms.selectMode === true; %>
<section class="ac-mw" data-ac-page-section="website-media" data-ac-mw-screen="<%= selectMode ? 'select-media' : 'media' %>">
  <%- include('../partials/website-cms-nav') %>
  <div class="ac-mw-head">
    <div>
      <h2><%= selectMode ? 'Select from Media Library' : 'Media Library' %></h2>
      <p class="ac-mw-muted"><%= selectMode ? 'Reuse an image already uploaded for this clinic.' : 'Images belong to this clinic only. Other clinics cannot see or reuse this media.' %></p>
    </div>
    <% if (cms.canUpload && !selectMode) { %>
    <button type="button" class="ac-mw-btn ac-mw-btn--primary" data-ac-mw-open="ac-mw-upload-media">Upload Media</button>
    <% } %>
  </div>
  <% if (cms.canUpload) { %>
  <dialog class="ac-mw-dialog" id="ac-mw-upload-media">
    <form class="ac-mw-dialog__body ac-mw-form" method="post" action="<%= cms.uploadAction %>" enctype="multipart/form-data" data-ac-mw-upload="1" data-ac-mw-ajax="1">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <h3>Upload Media</h3>
      <label class="ac-mw-upload-drop">
        Drag &amp; drop files here
        <span>Or Browse Files</span>
        <input type="file" name="file" accept="image/jpeg,image/png,image/webp,image/gif" required/>
      </label>
      <label>
        Alt text
        <input type="text" name="altText" maxlength="240" placeholder="Describe the image for screen readers..."/>
      </label>
      <p class="ac-mw-muted" data-ac-mw-upload-status="1">JPEG, PNG, WebP, or GIF. Maximum 5 MB.</p>
      <div class="ac-mw-actions">
        <button type="button" class="ac-mw-btn" data-ac-mw-close="1">Cancel</button>
        <button type="submit" class="ac-mw-btn ac-mw-btn--primary">Done</button>
      </div>
    </form>
  </dialog>
  <% } %>
  <div class="ac-mw-media-grid" data-ac-mw-media-grid="1">
    <% if (!media.length) { %>
    <p class="ac-mw-muted">No media uploaded yet.</p>
    <% } %>
    <% media.forEach(function (item) { %>
    <figure class="ac-mw-media-card" data-ac-media-id="<%= item.id %>">
      <% if (item.publicSrc) { %>
      <img src="<%= item.publicSrc %>" alt="<%= item.altText || item.originalFilename || '' %>"/>
      <% } %>
      <figcaption>
        <strong><%= item.originalFilename || 'Image' %></strong>
        <p class="ac-mw-muted"><%= item.mediaKind %> · <%= Math.round((item.sizeBytes || 0) / 1024) %> KB</p>
        <a class="ac-mw-btn" href="/app/settings/website/media/<%= item.id %>">Details</a>
      </figcaption>
    </figure>
    <% }) %>
  </div>
  <% if (selected) { %>
  <form class="ac-mw-form" method="post" action="/app/settings/website/media/<%= selected.id %>">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <h3>Media Details</h3>
    <% if (selected.publicSrc) { %><p><img src="<%= selected.publicSrc %>" alt="" style="max-width:20rem"/></p><% } %>
    <label>
      Alt text
      <input type="text" name="altText" maxlength="240" value="<%= selected.altText || '' %>" placeholder="Describe the image for screen readers..."/>
    </label>
    <p class="ac-mw-muted"><%= selected.originalFilename %> · <%= selected.mimeType %></p>
    <button type="submit" class="ac-mw-btn ac-mw-btn--primary">Save metadata</button>
  </form>
  <% } %>
</section>
