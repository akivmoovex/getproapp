<% var cms = (pageData && pageData.cms) || {}; var page = cms.page || {}; var error = cms.error || ""; %>
<section class="ac-mw" data-ac-page-section="website-page-settings" data-ac-mw-screen="page-settings">
  <%- include('../partials/website-cms-nav') %>
  <div class="ac-mw-head">
    <div>
      <h2>Edit Page Settings</h2>
      <p class="ac-mw-muted"><%= page.title || 'Page' %> · <code><%= page.href || '' %></code></p>
    </div>
  </div>
  <% if (error) { %><p class="ac-mw-error" role="alert"><%= error %></p><% } %>
  <form class="ac-mw-form" method="post" action="/app/settings/website/pages/<%= page.id %>">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <label>
      Page title
      <input type="text" name="title" required maxlength="120" value="<%= page.title || '' %>"/>
    </label>
    <label>
      Navigation label
      <input type="text" name="navLabel" maxlength="40" value="<%= page.nav_label || '' %>"/>
    </label>
    <% if (page.kind === 'custom') { %>
    <label>
      URL slug
      <input type="text" name="slug" maxlength="64" value="<%= page.slug || '' %>"/>
    </label>
    <% } %>
    <label>
      Status
      <select name="status">
        <option value="draft" <%= page.status === 'draft' ? 'selected' : '' %>>Draft</option>
        <option value="published" <%= page.status === 'published' ? 'selected' : '' %>>Published</option>
        <option value="hidden" <%= page.status === 'hidden' ? 'selected' : '' %>>Hidden</option>
      </select>
    </label>
    <label class="ac-mw-check">
      <input type="checkbox" name="inNav" value="1" <%= page.in_nav ? 'checked' : '' %>/>
      Show in navigation
    </label>
    <label>
      Page title (browser / search)
      <input type="text" name="metaTitle" maxlength="160" value="<%= page.meta_title || '' %>"/>
    </label>
    <label>
      Meta description
      <textarea name="metaDescription" maxlength="320"><%= page.meta_description || '' %></textarea>
    </label>
    <div class="ac-mw-actions">
      <a class="ac-mw-btn" href="/app/settings/website/pages">Back</a>
      <button type="submit" class="ac-mw-btn ac-mw-btn--primary">Save settings</button>
    </div>
  </form>
</section>
