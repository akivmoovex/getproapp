<%
  var list = (pageData && pageData.list) || {};
  var appointments = list.appointments || [];
  var filters = list.filters || {};
  var filterOptions = list.filterOptions || {};
  var actions = list.actions || {};
  var emptyMode = list.emptyMode;
  var stitch = list.stitch || {};
  var statusSummary = list.statusSummary || {};
%>
<section
  class="ac-appointments ac-appointments--b2"
  data-ac-page-section="appointment-list"
  data-ac-stitch="AC-B2-04"
  data-ac-stitch-desktop="<%= stitch.desktop || '6bf6da61f93a4e12972d7c3ab649549c' %>"
  data-ac-stitch-mobile="<%= stitch.mobile || 'b7ccd0f78b8a491580554999c8d1e1b9' %>"
  data-ac-stitch-shared="<%= stitch.shared || '' %>"
>
  <header class="ac-appointments-toolbar" data-ac-appointments-toolbar="1">
    <div>
      <p class="ac-appointments-toolbar__kicker ac-muted">Scheduling</p>
      <p class="ac-appointments-toolbar__count" data-ac-result-count="<%= list.resultCount != null ? list.resultCount : 0 %>">
        <%= list.resultCount != null ? list.resultCount : 0 %> appointment<%= (list.resultCount === 1) ? '' : 's' %>
      </p>
    </div>
    <div class="ac-appointments-toolbar__actions">
      <a class="ac-btn ac-btn--ghost" href="<%= actions.calendarHref || '/app/appointments/calendar' %>">Calendar</a>
      <a class="ac-btn ac-btn--ghost" href="<%= actions.scheduleHref || '/app/appointments/schedule' %>">Schedule</a>
      <% if (actions.canCreate) { %>
      <a class="ac-btn" href="<%= actions.createHref || '/app/appointments/new' %>" data-ac-appointments-action="book">+ New Appt</a>
      <% } %>
    </div>
  </header>

  <form class="ac-panel ac-filter-bar gp-ops-filter-bar" method="get" action="/app/appointments" data-ac-appointment-filters="1" data-gp-ops="filter-bar" role="search">
    <div class="ac-filter-bar__grid ac-filter-bar__grid--appointments">
      <div>
        <label class="ac-label" for="appt_date">From date</label>
        <input class="ac-input" id="appt_date" name="date" type="date" value="<%= filters.date || '' %>"/>
      </div>
      <div>
        <label class="ac-label" for="appt_date_to">To date</label>
        <input class="ac-input" id="appt_date_to" name="date_to" type="date" value="<%= filters.dateTo || '' %>"/>
      </div>
      <div>
        <label class="ac-label" for="appt_facility">Facility</label>
        <select class="ac-select" id="appt_facility" name="facility">
          <option value="">All authorized</option>
          <% (filterOptions.facilities || []).forEach(function (f) { %>
          <option value="<%= f.value %>" <%= filters.facilityId === f.value ? 'selected' : '' %>><%= f.label %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="ac-label" for="appt_status">Status</label>
        <select class="ac-select" id="appt_status" name="status">
          <option value="">All</option>
          <% (filterOptions.statuses || []).forEach(function (s) { %>
          <option value="<%= s.value %>" <%= filters.status === s.value ? 'selected' : '' %>><%= s.label %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="ac-label" for="appt_staff">Provider</label>
        <select class="ac-select" id="appt_staff" name="staff">
          <option value="">Any</option>
          <% (filterOptions.staff || []).forEach(function (s) { %>
          <option value="<%= s.value %>" <%= filters.assignedStaffId === s.value ? 'selected' : '' %>><%= s.label %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="ac-label" for="appt_service">Service</label>
        <select class="ac-select" id="appt_service" name="service">
          <option value="">Any</option>
          <% (filterOptions.services || []).forEach(function (s) { %>
          <option value="<%= s.value %>" <%= filters.serviceTypeId === s.value ? 'selected' : '' %>><%= s.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="ac-filter-bar__checks">
        <button type="submit" class="ac-btn">Filter</button>
        <% if (filters.active) { %>
        <a class="ac-btn ac-btn--ghost" href="/app/appointments">Clear</a>
        <% } %>
      </div>
    </div>
  </form>

  <div class="ac-appointments-summary" data-ac-status-summary="appointments">
    <article class="ac-stat-card"><p class="ac-stat-card__label">Scheduled</p><p class="ac-stat-card__value"><%= statusSummary.scheduled || 0 %></p></article>
    <article class="ac-stat-card"><p class="ac-stat-card__label">Confirmed</p><p class="ac-stat-card__value"><%= statusSummary.confirmed || 0 %></p></article>
    <article class="ac-stat-card"><p class="ac-stat-card__label">Checked in</p><p class="ac-stat-card__value"><%= statusSummary.checked_in || 0 %></p></article>
    <article class="ac-stat-card"><p class="ac-stat-card__label">In progress</p><p class="ac-stat-card__value"><%= statusSummary.in_progress || 0 %></p></article>
    <article class="ac-stat-card"><p class="ac-stat-card__label">No-show</p><p class="ac-stat-card__value"><%= statusSummary.no_show || 0 %></p></article>
    <article class="ac-stat-card"><p class="ac-stat-card__label">Cancelled</p><p class="ac-stat-card__value"><%= statusSummary.cancelled || 0 %></p></article>
  </div>
  <p class="ac-appointments-summary__links">
    <a class="ac-btn ac-btn--ghost" href="<%= actions.missedHref || '/app/appointments/missed' %>">Missed appointments</a>
  </p>

  <% if (emptyMode === 'none') { %>
  <%- include('../partials/ac-inline-state', {
    inlineState: {
      stateKey: 'empty',
      marker: 'appointments-none',
      title: 'No appointments in this range',
      description: 'Book an appointment or widen the date filters.',
      primaryAction: actions.canCreate
        ? { href: actions.createHref || '/app/appointments/new', label: 'Book appointment' }
        : null
    }
  }) %>
  <% } else if (emptyMode === 'filtered') { %>
  <%- include('../partials/ac-inline-state', {
    inlineState: {
      stateKey: 'no_results',
      marker: 'appointments-filtered',
      title: 'No appointments match these filters',
      description: 'Try a different facility, status, provider, or date range.',
      secondaryAction: { href: '/app/appointments', label: 'Clear filters' }
    }
  }) %>
  <% } else { %>
  <div class="ac-panel ac-table-wrap ac-appointments-desktop gp-ops-table-wrap" data-ac-table="appointments" data-gp-ops="table">
    <div class="gp-ops-table-scroll">
      <table class="ac-table gp-ops-table">
        <caption class="ac-sr-only">Appointments</caption>
        <thead>
          <tr>
            <th scope="col">When</th>
            <th scope="col">Patient</th>
            <th scope="col">Service</th>
            <th scope="col">Provider</th>
            <th scope="col">Facility</th>
            <th scope="col">Status</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% appointments.forEach(function (a) { %>
          <tr data-ac-appointment-row="<%= a.id %>">
            <td>
              <a href="/app/appointments/<%= a.id %>"><%= a.when.dateLabel %></a>
              <div class="ac-muted"><%= a.when.timeLabel %></div>
            </td>
            <td>
              <% if (a.patient) { %>
              <a href="/app/patients/<%= encodeURIComponent(a.patient.patientNumber) %>"><%= a.patient.displayName %></a>
              <div class="ac-muted"><%= a.patient.patientNumber %></div>
              <% } else { %>—<% } %>
            </td>
            <td><%= (a.service && a.service.displayName) || '—' %></td>
            <td><%= (a.assignedStaff && a.assignedStaff.displayName) || '—' %></td>
            <td><%= (a.facility && a.facility.displayName) || '—' %></td>
            <td>
              <%- include('../../platform/partials/gp-ops-status-badge', {
                label: a.statusLabel || a.status,
                tone: a.status === 'confirmed' || a.status === 'completed' ? 'success'
                  : (a.status === 'arrived' || a.status === 'waiting' ? 'info'
                  : (a.status === 'cancelled' || a.status === 'no_show' ? 'danger'
                  : (a.status === 'with_practitioner' ? 'warning' : 'neutral')))
              }) %>
            </td>
            <td>
              <a class="ac-btn ac-btn--ghost" href="/app/appointments/<%= a.id %>">Open</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <ul class="ac-appointments-mobile ac-card-list" data-ac-card-list="appointments" aria-label="Appointments">
    <% appointments.forEach(function (a) { %>
    <li class="ac-card ac-appointments-card">
      <div class="ac-appointments-card__head">
        <div>
          <p class="ac-appointments-card__time"><%= a.when.timeLabel %></p>
          <p class="ac-card__title"><%= (a.patient && a.patient.displayName) || 'Appointment' %></p>
          <% if (a.patient) { %>
          <p class="ac-muted"><%= a.patient.patientNumber %></p>
          <% } %>
        </div>
        <%- include('../../platform/partials/gp-ops-status-badge', {
          label: a.statusLabel || a.status,
          tone: a.status === 'confirmed' || a.status === 'completed' ? 'success'
            : (a.status === 'arrived' || a.status === 'waiting' ? 'info'
            : (a.status === 'cancelled' || a.status === 'no_show' ? 'danger'
            : (a.status === 'with_practitioner' ? 'warning' : 'neutral')))
        }) %>
      </div>
      <dl class="ac-appointments-card__facts">
        <div><dt>When</dt><dd><%= a.when.dateLabel %></dd></div>
        <div><dt>Service</dt><dd><%= (a.service && a.service.displayName) || '—' %></dd></div>
        <div><dt>Provider</dt><dd><%= (a.assignedStaff && a.assignedStaff.displayName) || '—' %></dd></div>
        <div><dt>Facility</dt><dd><%= (a.facility && a.facility.displayName) || '—' %></dd></div>
      </dl>
      <a class="ac-appointments-card__cta" href="/app/appointments/<%= a.id %>">
        Open appointment
        <span aria-hidden="true">›</span>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>
  <p class="ac-sr-only">This view does not include clinical diagnoses or clinical notes.</p>
</section>
