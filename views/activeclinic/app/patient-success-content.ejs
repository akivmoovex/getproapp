<%
  var success = (pageData && pageData.success) || {};
  var patient = success.patient || {};
  var stitch = success.stitch || {};
  var nextActions = success.nextActions || [];
%>
<section class="ac-patient-success" data-ac-page-section="patient-success" data-ac-stitch-desktop="<%= stitch.desktop || '' %>" data-ac-stitch-mobile="<%= stitch.mobile || '' %>">
  <div class="ac-panel">
    <h2 class="ac-dashboard__card-title">Patient created</h2>
    <p>Patient <strong><%= patient.displayName || (patient.firstName + ' ' + patient.lastName) %></strong> was registered.</p>
    <p class="ac-muted">Patient number: <strong data-ac-patient-number="1"><%= patient.patientNumber %></strong></p>
    <% if (success.incomplete || patient.registrationStatus === 'incomplete') { %>
    <p class="ac-flash ac-flash--warning" role="status">Registration incomplete — reception or records can complete demographics later.</p>
    <% } %>
    <p class="ac-muted">No clinical encounter was created automatically.</p>
    <div class="ac-form-actions" style="margin-top:1.25rem">
      <% if (nextActions.length) { %>
        <% nextActions.forEach(function (a) { %>
        <a class="ac-btn<%= a.primary ? '' : ' ac-btn--ghost' %>" href="<%= a.href %>"><%= a.label %></a>
        <% }) %>
      <% } else { %>
      <a class="ac-btn" href="<%= success.profileHref %>">Open patient</a>
      <a class="ac-btn ac-btn--ghost" href="/app/patients/new">Register another</a>
      <a class="ac-btn ac-btn--ghost" href="/app/patients">Back to patients</a>
      <% } %>
    </div>
  </div>
</section>
