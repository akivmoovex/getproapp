<%
  var invoices = (pageData && pageData.invoices) || [];
  var stitch = (pageData && pageData.stitch) || {};
%>
<section class="ac-invoice-list" data-ac-page-section="invoice-list" data-ac-stitch-desktop="<%= stitch.desktop || '' %>" data-ac-stitch-mobile="<%= stitch.mobile || '' %>">
  <div class="ac-panel">
    <% if (invoices.length === 0) { %>
      <%- include('../partials/ac-inline-state', {
        inlineState: {
          stateKey: 'empty',
          marker: 'invoices-empty',
          title: 'No invoices yet',
          description: 'Create patient invoices from charges.',
          primaryAction: { href: '/app/billing/invoices/new', label: 'Create invoice' }
        }
      }) %>
    <% } else { %>
      <table class="ac-table">
        <thead>
          <tr>
            <th>Invoice number</th>
            <th>Patient</th>
            <th>Date</th>
            <th>Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% invoices.forEach(function (inv) { %>
          <tr>
            <td><a href="/app/billing/invoices/<%= inv.id %>"><%= inv.invoice_number %></a></td>
            <td><%= inv.patientName %> · <%= inv.patient_number %></td>
            <td><%= inv.invoice_date %></td>
            <td><%= inv.totalAmountFormatted %></td>
            <td><span class="ac-status" data-status="<%= inv.status %>"><%= inv.status %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</section>
