<%
  var page = (pageData && pageData) || {};
  var values = page.values || {};
  var medications = page.medications || [];
  var error = page.error;
  var stitch = page.stitch || {};
%>
<section class="ac-pharmacy-purchase-order-form" data-ac-page-section="pharmacy-purchase-order-form" data-ac-stitch-desktop="<%= stitch.desktop || '' %>">
  <%- include('../partials/ac-form-error', { error: error }) %>

  <form method="post" action="/app/pharmacy/purchase-orders/new" class="ac-form" data-ac-loading="1">
    <%- include('../partials/ac-csrf-field') %>

    <div class="ac-panel">
      <div class="ac-form-field">
        <label for="supplierName" class="ac-form-label">Supplier <span class="ac-required">*</span></label>
        <input type="text" id="supplierName" name="supplierName" value="<%= values.supplierName || '' %>" required maxlength="200" class="ac-form-input">
      </div>

      <div class="ac-form-field">
        <label for="notes" class="ac-form-label">Notes</label>
        <textarea id="notes" name="notes" class="ac-form-input" rows="2" maxlength="2000"><%= values.notes || '' %></textarea>
      </div>
    </div>

    <div class="ac-panel">
      <h3>Line items</h3>
      <div class="ac-form-field">
        <label for="medicationCatalogueItemId" class="ac-form-label">Medication <span class="ac-required">*</span></label>
        <select id="medicationCatalogueItemId" name="medicationCatalogueItemId" required class="ac-form-input">
          <option value="">Select medication</option>
          <% medications.forEach(function (med) { %>
          <option value="<%= med.id %>" <%= values.medicationCatalogueItemId === med.id ? 'selected' : '' %>>
            <%= med.genericName %> - <%= med.strength %> (<%= med.dosageForm %>)
          </option>
          <% }) %>
        </select>
      </div>

      <div class="ac-form-field">
        <label for="quantityOrdered" class="ac-form-label">Quantity ordered <span class="ac-required">*</span></label>
        <input type="number" id="quantityOrdered" name="quantityOrdered" value="<%= values.quantityOrdered || '' %>" required min="1" class="ac-form-input">
      </div>

      <div class="ac-form-field">
        <label for="unitCost" class="ac-form-label">Unit cost (optional)</label>
        <input type="number" id="unitCost" name="unitCost" value="<%= values.unitCost || '' %>" step="0.01" min="0" class="ac-form-input">
      </div>
    </div>

    <div class="ac-panel ac-form-actions">
      <button type="submit" class="ac-btn ac-btn--primary">Create draft</button>
      <a href="/app/pharmacy/purchase-orders" class="ac-btn ac-btn--secondary">Cancel</a>
    </div>
  </form>
</section>
