<div data-ac-stitch="5e4dbc7265ad4e17b060b1f641996db3" data-ac-screen="consultation-workspace" class="ac-workspace">
  <section class="ac-clinical-banner ac-workspace-section">
    <h2 class="ac-patient-banner__name"><%= pageData.workspace.encounter.patientDisplayName %></h2>
    <p class="ac-muted"><%= pageData.workspace.encounter.patientNumber %> · <%= pageData.workspace.encounter.encounterNumber %> · <%= pageData.workspace.encounter.encounterType %></p>
    <p><span class="ac-status" data-ac-status="<%= pageData.workspace.encounter.status %>"><%= pageData.workspace.encounter.status %></span></p>
  </section>

  <% if (pageData.workspace.triage) { %>
  <section class="ac-panel ac-form-section ac-workspace-section">
    <h2>Triage</h2>
    <p><strong>Chief complaint:</strong> <%= pageData.workspace.triage.chief_complaint %></p>
    <% if (pageData.workspace.triage.triage_category) { %>
    <p><strong>Category:</strong> <span class="ac-status"><%= pageData.workspace.triage.triage_category %></span></p>
    <% } %>
    <p><a class="ac-btn ac-btn--ghost ac-btn--table" href="/app/clinical/encounter/<%= pageData.workspace.encounter.id %>/triage">View/edit triage</a></p>
  </section>
  <% } %>

  <section class="ac-panel ac-form-section ac-workspace-section">
    <h2>Vital signs</h2>
    <% if (pageData.workspace.vitals.length === 0) { %>
    <p class="ac-empty">No vitals recorded. <a href="/app/clinical/encounter/<%= pageData.workspace.encounter.id %>/vitals">Record vitals</a></p>
    <% } else { %>
    <p><%= pageData.workspace.vitals.length %> observation(s) recorded. <a class="ac-btn ac-btn--ghost ac-btn--table" href="/app/clinical/encounter/<%= pageData.workspace.encounter.id %>/vitals">View vitals</a></p>
    <% } %>
  </section>

  <section class="ac-panel ac-form-section ac-workspace-section">
    <h2>Consultation notes</h2>
    <% if (pageData.workspace.consultationNotes.length === 0) { %>
    <p class="ac-empty">No consultation notes.</p>
    <% } else { %>
    <% pageData.workspace.consultationNotes.forEach(function (note) { %>
    <div class="ac-consultation-note">
      <p><strong>Status:</strong> <span class="ac-status"><%= note.status %></span></p>
      <% if (note.subjective_text) { %>
      <p><strong>Subjective:</strong> <%= note.subjective_text.substring(0, 200) %><%= note.subjective_text.length > 200 ? '...' : '' %></p>
      <% } %>
    </div>
    <% }) %>
    <% } %>

    <form method="post" action="/app/clinical/encounter/<%= pageData.workspace.encounter.id %>/consultation">
      <input type="hidden" name="<%= shell.csrf.field %>" value="<%= shell.csrf.token %>" />
      <div class="ac-soap-grid">
        <div class="ac-field">
          <label for="subjective_text">Subjective</label>
          <textarea id="subjective_text" name="subjective_text" rows="3"></textarea>
        </div>
        <div class="ac-field">
          <label for="objective_text">Objective</label>
          <textarea id="objective_text" name="objective_text" rows="3"></textarea>
        </div>
        <div class="ac-field">
          <label for="assessment_text">Assessment</label>
          <textarea id="assessment_text" name="assessment_text" rows="3"></textarea>
        </div>
        <div class="ac-field">
          <label for="plan_text">Plan</label>
          <textarea id="plan_text" name="plan_text" rows="3"></textarea>
        </div>
      </div>
      <button type="submit" class="ac-btn">Save draft</button>
    </form>
  </section>

  <section class="ac-panel ac-form-section ac-workspace-section">
    <h2>Orders</h2>
    <% if (pageData.workspace.orders.length === 0) { %>
    <p class="ac-empty">No orders.</p>
    <% } else { %>
    <ul class="ac-order-list">
      <% pageData.workspace.orders.forEach(function (order) { %>
      <li><%= order.order_type %> · <span class="ac-status"><%= order.status %></span></li>
      <% }) %>
    </ul>
    <% } %>
  </section>

  <% if (pageData.workspace.actions.canCloseEncounter) { %>
  <form class="ac-panel ac-form-section" method="post" action="/app/clinical/encounter/<%= pageData.workspace.encounter.id %>/close">
    <input type="hidden" name="<%= shell.csrf.field %>" value="<%= shell.csrf.token %>" />
    <input type="hidden" name="version" value="<%= pageData.workspace.encounter.version %>" />
    <div class="ac-field">
      <label for="closure_note">Closure note (optional)</label>
      <textarea id="closure_note" name="closure_note" rows="2"></textarea>
    </div>
    <button type="submit" class="ac-btn">Close encounter</button>
  </form>
  <% } %>
</div>
