<%
  var detail = (pageData && pageData.detail) || {};
  var s = detail.staff || {};
  var account = detail.account || {};
  var facilities = detail.facilities || { active: [], history: [] };
  var access = detail.access || [];
  var actions = detail.actions || {};
  var csrf = (shell && shell.csrf) || { field: '_csrf', token: '' };
%>
<section class="ac-staff-detail" data-ac-page-section="staff-detail" data-ac-visual="stitch-gap" data-ac-staff-id="<%= s.id || '' %>">
  <div class="ac-panel">
    <div class="ac-staff-name ac-staff-name--detail">
      <%- include('../partials/staff-badges', { initials: s.initials, size: 'lg', status: null, accountKey: null }) %>
      <div>
        <div class="ac-actions" style="margin-bottom:.5rem">
          <%- include('../partials/staff-badges', { status: s.status, statusLabel: s.statusLabel, accountKey: account.key, accountLabel: account.label, initials: null }) %>
        </div>
        <% if (s.preferredName) { %><p class="ac-muted" style="margin:0">Preferred name: <%= s.preferredName %></p><% } %>
      </div>
    </div>
    <h2 class="ac-dashboard__card-title">Profile</h2>
    <dl class="ac-dl">
      <div>
        <dt>Display name</dt>
        <dd><%= s.displayName || '' %></dd>
      </div>
      <div>
        <dt>Job title</dt>
        <dd><%= s.jobTitle || '—' %></dd>
      </div>
      <div>
        <dt>Employment type</dt>
        <dd><%= s.employmentTypeLabel || '—' %></dd>
      </div>
      <% if (s.staffNumber) { %>
      <div>
        <dt>Staff number</dt>
        <dd><%= s.staffNumber %></dd>
      </div>
      <% } %>
      <div>
        <dt>Start date</dt>
        <dd><%= s.startDate || '—' %></dd>
      </div>
      <div>
        <dt>End date</dt>
        <dd><%= s.endDate || '—' %></dd>
      </div>
    </dl>
  </div>

  <div class="ac-panel" style="margin-top:1rem" data-ac-staff-contact="1">
    <h2 class="ac-dashboard__card-title">Contact</h2>
    <dl class="ac-dl">
      <div>
        <dt>Phone</dt>
        <dd><%= s.phoneDisplay || '—' %></dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd><%= s.emailDisplay || '—' %></dd>
      </div>
    </dl>
  </div>

  <div class="ac-panel" style="margin-top:1rem" data-ac-staff-facilities="1">
    <h2 class="ac-dashboard__card-title">Facility assignments</h2>
    <% if (!(facilities.active || []).length) { %>
    <p class="ac-muted">No active facility assignments.</p>
    <% } else { %>
    <ul class="ac-assignment-list">
      <% (facilities.active || []).forEach(function (f) { %>
      <li class="<%= f.isSelected ? 'is-selected' : '' %>">
        <strong><%= f.displayName || 'Facility' %></strong>
        <%- include('../partials/staff-badges', { status: f.status, statusLabel: f.statusLabel, initials: null, accountKey: null }) %>
        <% if (f.isPrimary) { %><span class="ac-badge ac-badge--active" data-ac-facility-primary="1">Primary</span><% } %>
        <% if (f.isSelected) { %><span class="ac-badge">Current</span><% } %>
      </li>
      <% }) %>
    </ul>
    <% } %>
    <% if ((facilities.history || []).length) { %>
    <h3 class="ac-dashboard__card-title" style="margin-top:1rem;font-size:1rem">Assignment history</h3>
    <ul class="ac-assignment-list ac-muted">
      <% (facilities.history || []).forEach(function (f) { %>
      <li><%= f.displayName || 'Facility' %> · <%= f.status %></li>
      <% }) %>
    </ul>
    <% } %>
    <% if (actions.canAssignFacility) { %>
    <p class="ac-muted" style="margin-top:.75rem">Facility assignment editing is available in a later wave.</p>
    <% } %>
  </div>

  <div class="ac-panel" style="margin-top:1rem" data-ac-staff-access="1">
    <h2 class="ac-dashboard__card-title">Access summary</h2>
    <% if (!access.length) { %>
    <p class="ac-muted">No active role assignments.</p>
    <% } else { %>
    <ul class="ac-assignment-list">
      <% access.forEach(function (r) { %>
      <li>
        <strong><%= r.label %></strong>
        <span class="ac-muted"><%= r.scopeLabel %></span>
        <% if (r.expiresAt) { %><span class="ac-muted">Expires <%= r.expiresAt %></span><% } %>
      </li>
      <% }) %>
    </ul>
    <% } %>
    <% if (actions.canAssignAccess) { %>
    <p class="ac-muted" style="margin-top:.75rem">Role assignment editing is available from Roles &amp; access in a later wave.</p>
    <% } %>
  </div>

  <div class="ac-panel" style="margin-top:1rem" data-ac-staff-account="1">
    <h2 class="ac-dashboard__card-title">Account</h2>
    <dl class="ac-dl">
      <div>
        <dt>Account state</dt>
        <dd><%= account.label || '—' %></dd>
      </div>
      <div>
        <dt>Invitation</dt>
        <dd><%= account.invitationStatus || (account.hasIdentity ? '—' : 'No invitation on file') %></dd>
      </div>
    </dl>
  </div>

  <div class="ac-panel ac-facility-actions" style="margin-top:1rem" data-ac-staff-actions="1">
    <h2 class="ac-dashboard__card-title">Lifecycle actions</h2>
    <div class="ac-actions ac-actions--stack-mobile">
      <% if (actions.editHref) { %>
      <a class="ac-btn" href="<%= actions.editHref %>">Edit staff</a>
      <% } %>
      <% if (actions.reissueInvitation) { %>
      <form method="post" action="<%= actions.reissueInvitation %>" data-ac-loading="1">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn">Reissue invitation</button>
      </form>
      <% } %>
      <% if (actions.revokeInvitation) { %>
      <form method="post" action="<%= actions.revokeInvitation %>" data-ac-loading="1">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn ac-btn--ghost">Revoke invitation</button>
      </form>
      <% } %>
      <% if (actions.sendReset) { %>
      <form method="post" action="<%= actions.sendReset %>" data-ac-loading="1">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn ac-btn--ghost">Send password reset</button>
      </form>
      <% } %>
      <% if (actions.requirePasswordChange) { %>
      <form method="post" action="<%= actions.requirePasswordChange %>" data-ac-loading="1">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn ac-btn--ghost">Require password change</button>
      </form>
      <% } %>
      <% if (actions.revokeSessions) { %>
      <form method="post" action="<%= actions.revokeSessions %>" data-ac-loading="1">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn ac-btn--ghost">Revoke ActiveClinic sessions</button>
      </form>
      <% } %>
      <% if (actions.unlock) { %>
      <form method="post" action="<%= actions.unlock %>" data-ac-loading="1">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn">Unlock temporary lock</button>
      </form>
      <% } %>
      <% if (actions.suspend) { %>
      <a class="ac-btn ac-btn--danger" href="<%= actions.suspend %>" data-ac-suspend-link="1">Suspend staff…</a>
      <% } %>
      <% if (actions.restore) { %>
      <form method="post" action="<%= actions.restore %>" data-ac-loading="1">
        <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>"/>
        <button type="submit" class="ac-btn">Restore staff</button>
      </form>
      <% } %>
      <% if (!actions.reissueInvitation && !actions.sendReset && !actions.suspend && !actions.restore && !actions.revokeSessions && !actions.unlock && !actions.requirePasswordChange && !actions.revokeInvitation) { %>
      <p class="ac-muted">No lifecycle actions are available for your permissions or this staff state.</p>
      <% } %>
    </div>
    <p class="ac-muted" style="margin-top:.75rem">Activation and reset links are never embedded on this page. Reissue and reset flows return a one-time result only to authorized administrators.</p>
  </div>
</section>
<p class="ac-muted" style="margin-top:1rem">Clinical workload and patient interactions are not part of this foundation staff profile.</p>
