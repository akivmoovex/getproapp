<%
  var catalogue = (pageData && pageData) || {};
  var medications = catalogue.medications || [];
  var actions = catalogue.actions || {};
  var stitch = catalogue.stitch || {};
%>
<section class="ac-pharmacy-catalogue" data-ac-page-section="pharmacy-catalogue" data-ac-stitch-desktop="<%= stitch.desktop || '' %>">
  <% if (actions.canManageInventory) { %>
  <div class="ac-panel">
    <a href="/app/pharmacy/catalogue/new" class="ac-btn ac-btn--primary">Add Medicine</a>
  </div>
  <% } %>

  <% if (!medications.length) { %>
  <%- include('../partials/ac-inline-state', {
    inlineState: {
      stateKey: 'empty',
      marker: 'catalogue-empty',
      title: 'No medications in catalogue',
      description: 'Add medications to the catalogue to start managing inventory.',
      primaryAction: actions.canManageInventory ? { href: '/app/pharmacy/catalogue/new', label: 'Add medicine' } : null
    }
  }) %>
  <% } else { %>
  <div class="ac-panel ac-table-wrap ac-desktop-table">
    <table class="ac-table">
      <caption class="ac-sr-only">Medicine Catalogue</caption>
      <thead>
        <tr>
          <th scope="col">Generic Name</th>
          <th scope="col">Strength</th>
          <th scope="col">Form</th>
          <th scope="col">Unit</th>
          <th scope="col">Status</th>
          <th scope="col" class="ac-sr-only">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% medications.forEach(function (med) { %>
        <tr>
          <td><strong><%= med.genericName %></strong></td>
          <td><%= med.strength %></td>
          <td><%= med.dosageForm %></td>
          <td><%= med.unitOfMeasure %></td>
          <td><span class="ac-status" data-ac-status="<%= med.status %>"><%= med.status %></span></td>
          <td><a href="/app/pharmacy/catalogue/<%= med.id %>" class="ac-link">View</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <ul class="ac-card-list ac-mobile-table-cards" data-ac-cards="pharmacy-catalogue">
    <% medications.forEach(function (med) { %>
    <li class="ac-card ac-mobile-record-card">
      <a class="ac-card__link" href="/app/pharmacy/catalogue/<%= med.id %>">
        <p class="ac-card__title"><%= med.genericName %></p>
        <p class="ac-muted"><%= med.strength %> · <%= med.dosageForm %> · <%= med.unitOfMeasure %></p>
        <p><span class="ac-status" data-ac-status="<%= med.status %>"><%= med.status %></span></p>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
