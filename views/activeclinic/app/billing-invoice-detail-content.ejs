<%
  var invoice = (pageData && pageData.invoice) || {};
  var lines = (pageData && pageData.lines) || [];
  var stitch = (pageData && pageData.stitch) || {};
%>
<section class="ac-invoice-detail" data-ac-page-section="invoice-detail" data-ac-stitch-desktop="<%= stitch.desktop || '' %>" data-ac-stitch-mobile="<%= stitch.mobile || '' %>">
  <article class="ac-panel">
    <h2 class="ac-dashboard__card-title">Invoice details</h2>
    <dl class="ac-dl">
      <div><dt>Invoice number</dt><dd><strong><%= invoice.invoice_number %></strong></dd></div>
      <div><dt>Patient</dt><dd><a href="/app/billing/patients/<%= invoice.patientNumber %>"><%= invoice.patientName %></a> · <%= invoice.patientNumber %></dd></div>
      <div><dt>Invoice date</dt><dd><%= invoice.invoice_date %></dd></div>
      <div><dt>Status</dt><dd><span class="ac-status" data-status="<%= invoice.status %>"><%= invoice.status %></span></dd></div>
    </dl>
  </article>

  <article class="ac-panel">
    <h2 class="ac-dashboard__card-title">Line items</h2>
    <% if (lines.length === 0) { %>
      <p class="ac-muted">No line items.</p>
    <% } else { %>
      <table class="ac-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Description</th>
            <th>Quantity</th>
            <th>Unit amount</th>
            <th>Line total</th>
          </tr>
        </thead>
        <tbody>
          <% lines.forEach(function (line) { %>
          <tr>
            <td><%= line.line_number %></td>
            <td><%= line.description %></td>
            <td><%= line.quantity %></td>
            <td><%= line.unitAmountFormatted %></td>
            <td><%= line.lineTotalFormatted %></td>
          </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="4" style="text-align:right"><strong>Subtotal</strong></td>
            <td><strong><%= invoice.subtotalFormatted %></strong></td>
          </tr>
          <% if (parseInt(invoice.tax_amount_minor) > 0) { %>
          <tr>
            <td colspan="4" style="text-align:right">Tax</td>
            <td><%= invoice.taxAmountFormatted %></td>
          </tr>
          <% } %>
          <tr>
            <td colspan="4" style="text-align:right"><strong>Total</strong></td>
            <td><strong><%= invoice.totalAmountFormatted %></strong></td>
          </tr>
        </tfoot>
      </table>
    <% } %>
  </article>

  <% if (invoice.notes) { %>
  <article class="ac-panel">
    <h2 class="ac-dashboard__card-title">Notes</h2>
    <p><%= invoice.notes %></p>
  </article>
  <% } %>
</section>
