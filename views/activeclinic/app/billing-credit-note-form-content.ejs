<%
  var prefill = (pageData && pageData.prefill) || {};
  var stitch = (pageData && pageData.stitch) || {};
%>
<section class="ac-billing-credit-note-form" data-ac-page-section="billing-credit-note-form" data-ac-stitch-desktop="<%= stitch.desktop || '' %>">
  <article class="ac-panel">
    <form method="POST" action="/app/billing/credit-notes/new" data-ac-loading="1">
      <%- include('../partials/ac-csrf-field') %>
      <div class="ac-form-group">
        <label for="patientId">Patient ID *</label>
        <input id="patientId" name="patientId" type="text" required value="<%= prefill.patientId || '' %>" />
      </div>
      <div class="ac-form-group">
        <label for="invoiceId">Invoice ID</label>
        <input id="invoiceId" name="invoiceId" type="text" value="<%= prefill.invoiceId || '' %>" />
      </div>
      <div class="ac-form-group">
        <label for="amount">Amount *</label>
        <input id="amount" name="amount" type="text" inputmode="decimal" required placeholder="0.00" />
      </div>
      <div class="ac-form-group">
        <label for="reason">Reason *</label>
        <textarea id="reason" name="reason" rows="3" required></textarea>
      </div>
      <button type="submit" class="ac-btn">Create credit note</button>
    </form>
  </article>
</section>
