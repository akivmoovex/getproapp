<%
  var sessions = (pageData && pageData.sessions) || [];
  var currentSessionId = pageData && pageData.currentSessionId;
  var stitch = (pageData && pageData.stitch) || {};
  var csrf = (shell && shell.csrf) || { field: '_csrf', token: '' };
%>
<section class="ac-account-sessions" data-ac-page-section="account-sessions" data-ac-stitch-desktop="<%= stitch.desktop || '' %>">
  <article class="ac-panel">
    <h2 class="ac-dashboard__card-title" style="margin-top:0">Active sessions</h2>
    <p class="ac-muted">Sessions for your ActiveClinic login. Sign out other devices if you no longer recognize them.</p>

    <% if (!sessions.length) { %>
    <p class="ac-muted">No other active sessions found.</p>
    <% } else { %>
    <ul class="ac-list ac-session-list">
      <% sessions.forEach(function (s) { %>
      <li class="ac-session-list__item" data-current="<%= s.id === currentSessionId ? '1' : '0' %>">
        <div>
          <strong><%= s.isCurrent ? 'This device' : 'Other session' %></strong>
          <p class="ac-muted" style="margin:.25rem 0 0">
            Started <%= s.createdAtLabel %> · Last seen <%= s.lastSeenLabel %>
            <% if (s.expiresAtLabel) { %> · Expires <%= s.expiresAtLabel %><% } %>
          </p>
        </div>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </article>

  <form method="post" action="/app/settings/account/sessions/revoke-others" class="ac-panel ac-form-actions" data-ac-loading="1">
    <input type="hidden" name="<%= csrf.field %>" value="<%= csrf.token %>" />
    <button type="submit" class="ac-btn ac-btn--ghost">Sign out other sessions</button>
    <a href="/app/settings/account" class="ac-btn ac-btn--ghost">Back to account security</a>
  </form>
</section>
