<%
  var departmentsPage = (pageData && pageData.departmentsPage) || {};
  var departments = departmentsPage.departments || [];
  var facilities = departmentsPage.facilities || [];
  var facilityTabs = departmentsPage.facilityTabs || [];
  var types = departmentsPage.types || [];
  var filters = departmentsPage.filters || {};
  var metrics = departmentsPage.metrics || {};
  var gaps = departmentsPage.gaps || [];
  var actions = departmentsPage.actions || {};
  var stitch = departmentsPage.stitch || {};
  var flash = typeof flash !== 'undefined' ? flash : null;
  var csrf = (typeof csrf !== 'undefined' && csrf) || {};
  var filterQs = '';
  (function () {
    var parts = [];
    if (filters.facility) parts.push('facility=' + encodeURIComponent(filters.facility));
    if (filters.status) parts.push('status=' + encodeURIComponent(filters.status));
    if (filters.type) parts.push('type=' + encodeURIComponent(filters.type));
    if (filters.q) parts.push('q=' + encodeURIComponent(filters.q));
    filterQs = parts.length ? '?' + parts.join('&') : '';
  })();
%>
<section
  class="ac-departments ac-facilities-workspace--b2 ac-ops-queue"
  data-ac-page-section="clinic-departments"
  data-ac-stitch="AC-B2-10"
  data-ac-stitch-desktop="<%= stitch.desktop || 'fb88329aa6af454a8e7b6675c6070b78' %>"
  data-ac-stitch-mobile="<%= stitch.mobile || '4c70614fd2534fa3a5baee0f61f1f964' %>"
>
  <% if (flash && flash.message) { %>
  <div class="ac-panel" data-ac-flash="<%= flash.type || 'info' %>">
    <p><%= flash.message %></p>
  </div>
  <% } %>

  <header class="ac-ops-queue__header ac-facilities-workspace__header">
    <div>
      <p class="ac-ops-queue__kicker">Settings &amp; administration</p>
      <h2 class="ac-ops-queue__title">Departments &amp; facilities</h2>
      <p class="ac-muted">Configure operational departments and status within clinic facilities. Staff access and RBAC stay separate.</p>
    </div>
    <div class="ac-facilities-workspace__header-actions">
      <% if (actions.canManage) { %>
      <a class="ac-btn ac-btn--primary" href="#ac-dept-add-drawer">Add department</a>
      <% } %>
      <% if (actions.canViewFacilities) { %>
      <a class="ac-btn ac-btn--ghost" href="/app/facilities">Manage facilities</a>
      <% } %>
    </div>
  </header>

  <% if (facilityTabs.length) { %>
  <nav class="ac-facility-switcher" aria-label="Facility context" data-ac-facility-switcher="1">
    <% facilityTabs.forEach(function (tab) { %>
    <a
      class="ac-facility-switcher__chip<%= tab.active ? ' is-active' : '' %>"
      href="<%= tab.href %>"
      <% if (tab.active) { %>aria-current="page"<% } %>
      data-ac-facility-tab="<%= tab.key %>"
    >
      <span><%= tab.label %></span>
      <% if (tab.count != null) { %><span class="ac-facility-switcher__count"><%= tab.count %></span><% } %>
    </a>
    <% }) %>
  </nav>
  <% } %>

  <div class="ac-dashboard__summaries ac-metric-grid" data-ac-dept-metrics="1">
    <article class="ac-panel ac-stat-card">
      <p class="ac-stat-card__label">Configured departments</p>
      <p class="ac-stat-card__value"><%= metrics.departmentTotal || 0 %></p>
      <p class="ac-muted"><%= metrics.activeCount || 0 %> active · <%= metrics.inactiveCount || 0 %> inactive</p>
    </article>
    <article class="ac-panel ac-stat-card">
      <p class="ac-stat-card__label">Operational footprint</p>
      <p class="ac-stat-card__value"><%= metrics.facilityCount || 0 %></p>
      <p class="ac-muted">Facilities in this organization</p>
      <% if (actions.canViewFacilities) { %>
      <a class="ac-stat-card__link" href="/app/facilities">Open facilities</a>
      <% } %>
    </article>
  </div>

  <% if (gaps.length) { %>
  <details class="ac-panel ac-facilities-workspace__gaps" data-ac-stitch-gaps="1">
    <summary>Stitch fields not in the current model</summary>
    <ul class="ac-muted">
      <% gaps.forEach(function (g) { %>
      <li data-ac-gap="<%= g.key %>"><strong><%= g.stitchLabel %></strong> — <%= g.note %></li>
      <% }) %>
    </ul>
  </details>
  <% } %>

  <%- include('../../platform/partials/gp-ops-filter-bar', {
    action: '/app/settings/clinic-setup/departments',
    method: 'get',
    q: filters.q || '',
    qName: 'q',
    submitLabel: 'Search',
    filtersHtml:
      (filters.facility ? '<input type="hidden" name="facility" value="' + String(filters.facility).replace(/"/g, '&quot;') + '" />' : '') +
      '<label class="gp-ops-filter-bar__field"><span class="gp-ops-visually-hidden">Type</span>' +
      '<select class="gp-ops-input" name="type">' +
      '<option value="">All types</option>' +
      types.map(function (t) {
        return '<option value="' + t.value + '"' + (filters.type === t.value ? ' selected' : '') + '>' + t.label + '</option>';
      }).join('') +
      '</select></label>' +
      '<label class="gp-ops-filter-bar__field"><span class="gp-ops-visually-hidden">Status</span>' +
      '<select class="gp-ops-input" name="status">' +
      '<option value="">All statuses</option>' +
      '<option value="active"' + (filters.status === 'active' ? ' selected' : '') + '>Enabled / active</option>' +
      '<option value="inactive"' + (filters.status === 'inactive' ? ' selected' : '') + '>Disabled / inactive</option>' +
      '</select></label>'
  }) %>

  <% if (!departments.length) { %>
  <%- include('../partials/ac-inline-state', {
    inlineState: {
      stateKey: 'empty',
      marker: 'departments-empty',
      title: filters.q || filters.type || filters.status || filters.facility
        ? 'No matching departments'
        : 'No departments configured',
      description: filters.q || filters.type || filters.status || filters.facility
        ? 'Try a different filter or clear search.'
        : 'Add Reception, OPD, Pharmacy, and other departments for each facility.',
      primaryAction: actions.canManage
        ? { href: '#ac-dept-add-drawer', label: 'Add department' }
        : null
    }
  }) %>
  <% } else { %>
  <div class="ac-panel ac-table-wrap ac-desktop-table gp-ops-table-wrap ac-ops-queue__desktop" data-gp-ops="table" data-ac-departments-table="1">
    <div class="gp-ops-table-scroll">
      <table class="ac-table gp-ops-table">
        <caption class="ac-sr-only">Clinic departments</caption>
        <thead>
          <tr>
            <th scope="col">Department name &amp; key</th>
            <th scope="col">Type</th>
            <th scope="col">Facility / location</th>
            <th scope="col">Lead</th>
            <th scope="col">Status</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% departments.forEach(function (d) { %>
          <tr data-ac-department-id="<%= d.id %>" data-ac-department-status="<%= d.status %>">
            <td>
              <strong><%= d.displayName %></strong>
              <div class="ac-muted"><code><%= d.departmentKey %></code></div>
            </td>
            <td><%= d.typeLabel %></td>
            <td>
              <%= d.facilityDisplayName || '—' %>
              <% if (d.locationSummary) { %>
              <div class="ac-muted"><%= d.locationSummary %></div>
              <% } %>
            </td>
            <td>
              <span class="ac-muted" data-ac-gap="department-lead">—</span>
            </td>
            <td>
              <%- include('../../platform/partials/gp-ops-status-badge', {
                label: d.status === 'active' ? 'Enabled' : 'Disabled',
                tone: d.status === 'active' ? 'success' : 'neutral'
              }) %>
            </td>
            <td>
              <% if (actions.canManage) { %>
              <a class="ac-btn ac-btn--ghost ac-btn--table" href="#ac-dept-edit-<%= d.id %>">Edit</a>
              <% if (d.status === 'active') { %>
              <form method="post" action="/app/settings/clinic-setup/departments/<%= d.id %>/deactivate" class="ac-inline-form" onsubmit="return confirm('Deactivate this department? Historical records are kept.');">
                <input type="hidden" name="<%= csrf.field || '_csrf' %>" value="<%= csrf.token || '' %>" />
                <% if (filters.facility) { %><input type="hidden" name="return_facility" value="<%= filters.facility %>" /><% } %>
                <button type="submit" class="ac-btn ac-btn--ghost ac-btn--table">Disable</button>
              </form>
              <% } else { %>
              <form method="post" action="/app/settings/clinic-setup/departments/<%= d.id %>/activate" class="ac-inline-form">
                <input type="hidden" name="<%= csrf.field || '_csrf' %>" value="<%= csrf.token || '' %>" />
                <% if (filters.facility) { %><input type="hidden" name="return_facility" value="<%= filters.facility %>" /><% } %>
                <button type="submit" class="ac-btn ac-btn--ghost ac-btn--table">Enable</button>
              </form>
              <% } %>
              <% } else { %>
              <span class="ac-muted">—</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <ul class="ac-card-list ac-mobile-table-cards ac-ops-queue__mobile ac-dept-cards" data-ac-cards="departments">
    <% departments.forEach(function (d) { %>
    <li class="ac-card ac-mobile-record-card ac-ops-queue-card" data-ac-department-id="<%= d.id %>">
      <div class="ac-ops-queue-card__head">
        <p class="ac-card__title"><%= d.displayName %></p>
        <%- include('../../platform/partials/gp-ops-status-badge', {
          label: d.status === 'active' ? 'Enabled' : 'Disabled',
          tone: d.status === 'active' ? 'success' : 'neutral'
        }) %>
      </div>
      <p class="ac-muted"><%= d.typeLabel %> · <code><%= d.departmentKey %></code></p>
      <p class="ac-muted"><%= d.facilityDisplayName || '—' %><% if (d.locationSummary) { %> · <%= d.locationSummary %><% } %></p>
      <p class="ac-muted" data-ac-gap="department-lead">Lead —</p>
      <% if (actions.canManage) { %>
      <div class="ac-ops-queue-card__actions">
        <a class="ac-btn ac-btn--ghost" href="#ac-dept-edit-<%= d.id %>">Edit</a>
        <% if (d.status === 'active') { %>
        <form method="post" action="/app/settings/clinic-setup/departments/<%= d.id %>/deactivate" class="ac-inline-form" onsubmit="return confirm('Deactivate this department? Historical records are kept.');">
          <input type="hidden" name="<%= csrf.field || '_csrf' %>" value="<%= csrf.token || '' %>" />
          <% if (filters.facility) { %><input type="hidden" name="return_facility" value="<%= filters.facility %>" /><% } %>
          <button type="submit" class="ac-btn ac-btn--ghost">Disable</button>
        </form>
        <% } else { %>
        <form method="post" action="/app/settings/clinic-setup/departments/<%= d.id %>/activate" class="ac-inline-form">
          <input type="hidden" name="<%= csrf.field || '_csrf' %>" value="<%= csrf.token || '' %>" />
          <% if (filters.facility) { %><input type="hidden" name="return_facility" value="<%= filters.facility %>" /><% } %>
          <button type="submit" class="ac-btn ac-btn--ghost">Enable</button>
        </form>
        <% } %>
      </div>
      <% } %>
    </li>
    <% }) %>
  </ul>
  <% } %>

  <% if (actions.canManage) { %>
  <dialog class="ac-form-drawer" id="ac-dept-add-drawer" data-ac-department-drawer="add">
    <form method="post" action="/app/settings/clinic-setup/departments" class="ac-form ac-form-drawer__form">
      <header class="ac-form-drawer__head">
        <h2 class="ac-dashboard__card-title">Add department</h2>
        <button type="button" class="ac-btn ac-btn--ghost" onclick="this.closest('dialog').close()" aria-label="Close">Close</button>
      </header>
      <input type="hidden" name="<%= csrf.field || '_csrf' %>" value="<%= csrf.token || '' %>" />
      <% if (filters.facility) { %><input type="hidden" name="return_facility" value="<%= filters.facility %>" /><% } %>
      <div class="ac-form-row">
        <label for="facility_id">Facility</label>
        <select id="facility_id" name="facility_id" required>
          <% facilities.forEach(function (f) { %>
          <option value="<%= f.id %>" <%= (filters.facility ? filters.facility === f.id : f.selected) ? 'selected' : '' %>><%= f.displayName %></option>
          <% }) %>
        </select>
      </div>
      <div class="ac-form-row">
        <label for="department_type">Type</label>
        <select id="department_type" name="department_type" required>
          <% types.forEach(function (t) { %>
          <option value="<%= t.value %>"><%= t.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="ac-form-row">
        <label for="display_name">Display name</label>
        <input id="display_name" name="display_name" type="text" maxlength="100" required placeholder="e.g. Main Pharmacy" />
      </div>
      <div class="ac-form-row">
        <label for="department_key">Key (optional)</label>
        <input id="department_key" name="department_key" type="text" maxlength="64" pattern="[a-z][a-z0-9_]{0,63}" placeholder="main_pharmacy" />
      </div>
      <p class="ac-muted" data-ac-gap="department-lead">Operational lead is not configured in this model.</p>
      <button type="submit" class="ac-btn ac-btn--primary">Add department</button>
    </form>
  </dialog>

  <% departments.forEach(function (d) { %>
  <dialog class="ac-form-drawer" id="ac-dept-edit-<%= d.id %>" data-ac-department-drawer="edit">
    <form method="post" action="/app/settings/clinic-setup/departments/<%= d.id %>/edit" class="ac-form ac-form-drawer__form">
      <header class="ac-form-drawer__head">
        <h2 class="ac-dashboard__card-title">Edit department</h2>
        <button type="button" class="ac-btn ac-btn--ghost" onclick="this.closest('dialog').close()" aria-label="Close">Close</button>
      </header>
      <input type="hidden" name="<%= csrf.field || '_csrf' %>" value="<%= csrf.token || '' %>" />
      <% if (filters.facility) { %><input type="hidden" name="return_facility" value="<%= filters.facility %>" /><% } %>
      <div class="ac-form-row">
        <label for="name_<%= d.id %>">Display name</label>
        <input id="name_<%= d.id %>" name="display_name" type="text" maxlength="100" value="<%= d.displayName %>" required />
      </div>
      <p class="ac-muted">Type: <%= d.typeLabel %> · Key: <code><%= d.departmentKey %></code></p>
      <p class="ac-muted">Facility: <%= d.facilityDisplayName || '—' %></p>
      <button type="submit" class="ac-btn ac-btn--primary">Save</button>
    </form>
  </dialog>
  <% }) %>
  <% } %>
</section>
<script>
(function () {
  function openHashDrawer() {
    var id = (location.hash || "").replace(/^#/, "");
    if (!id) return;
    var el = document.getElementById(id);
    if (el && typeof el.showModal === "function" && !el.open) {
      try { el.showModal(); } catch (e) { /* ignore */ }
    }
  }
  document.querySelectorAll("dialog.ac-form-drawer").forEach(function (dlg) {
    dlg.addEventListener("click", function (ev) {
      if (ev.target === dlg) dlg.close();
    });
  });
  window.addEventListener("hashchange", openHashDrawer);
  openHashDrawer();
})();
</script>
