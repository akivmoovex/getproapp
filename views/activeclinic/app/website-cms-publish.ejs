<%
  var website = (pageData && pageData.website) || {};
  var ux = website.ux || website;
  var actions = (ux.actions || website.actions) || {};
  var changes = (pageData && pageData.changes) || [];
%>
<section class="ac-mw" data-ac-page-section="website-publish" data-ac-mw-screen="publish">
  <%- include('../partials/website-cms-nav') %>
  <div class="ac-mw-head">
    <div>
      <h2>Site Status &amp; Publishing</h2>
      <p class="ac-mw-muted">Review pending changes and manage your clinic’s live website.</p>
    </div>
  </div>
  <div class="ac-mw-status-grid">
    <article class="ac-mw-status-card">
      <h3>Current Status</h3>
      <p class="ac-mw-muted">LAST PUBLISHED / <span data-ac-website-last-published="1"><%= website.lastPublishedLabel || 'Not published yet' %></span></p>
      <p><strong data-ac-website-status-label="1"><%= ux.statusLabel || 'Website not published yet' %></strong></p>
      <p class="ac-mw-muted" data-ac-website-status-hint="1"><%= ux.statusHint || '' %></p>
      <div class="ac-mw-actions">
        <% if (website.canPublish && actions.publishPath) { %>
        <form
          id="ac-mw-publish-form"
          method="post"
          action="<%= actions.publishPath %>"
          data-ac-mw-publish-form="1"
        >
          <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
          <input type="hidden" name="makePublic" value="1"/>
          <input type="hidden" name="returnTo" value="/app/settings/website/publish"/>
          <button type="submit" class="ac-mw-btn ac-mw-btn--primary" data-ac-website-action="publish">Publish All Changes</button>
        </form>
        <p class="ac-mw-muted" data-ac-mw-publish-status hidden role="status"></p>
        <% } %>
        <% if (actions.preview) { %><a class="ac-mw-btn" href="<%= actions.preview %>">Preview Site</a><% } %>
      </div>
    </article>
    <article class="ac-mw-status-card">
      <h3>Environment</h3>
      <p>Live URL: <code data-ac-website-public-url="1"><%= website.publicUrl || website.publicPath || '—' %></code></p>
      <% if (actions.editWebsite) { %>
      <p><a class="ac-mw-btn" href="<%= actions.editWebsite %>">Edit website</a></p>
      <% } %>
    </article>
  </div>
  <h3>Unpublished Changes (<%= changes.length %>)</h3>
  <div class="ac-mw-list">
    <% if (!changes.length) { %>
    <p class="ac-mw-muted">No unpublished draft changes.</p>
    <% } %>
    <% changes.forEach(function (change) { %>
    <article class="ac-mw-card" style="grid-template-columns:1fr">
      <div>
        <h3><%= change.contentKey %></h3>
        <p class="ac-mw-card__meta"><%= change.changeType || 'changed' %></p>
      </div>
    </article>
    <% }) %>
  </div>
</section>
