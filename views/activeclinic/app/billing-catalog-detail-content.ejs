<%
  var item = (pageData && pageData.item) || {};
  var stitch = (pageData && pageData.stitch) || {};
%>
<section class="ac-catalog-detail" data-ac-page-section="catalog-detail" data-ac-stitch-desktop="<%= stitch.desktop || '' %>">
  <article class="ac-panel">
    <h2 class="ac-dashboard__card-title"><%= item.name %></h2>
    <dl class="ac-dl">
      <div><dt>Code</dt><dd><code><%= item.code %></code></dd></div>
      <div><dt>Category</dt><dd><%= item.category || '—' %></dd></div>
      <div><dt>Amount</dt><dd class="ac-money"><strong><%= item.amountFormatted %></strong></dd></div>
      <div><dt>Taxable</dt><dd><%= item.isTaxable ? 'Yes (' + item.taxRatePercent + '%)' : 'No' %></dd></div>
      <div><dt>Status</dt><dd><span class="ac-status" data-status="<%= item.isActive ? 'active' : 'inactive' %>"><%= item.isActive ? 'Active' : 'Inactive' %></span></dd></div>
    </dl>
    <% if (item.description) { %>
    <p><%= item.description %></p>
    <% } %>
    <div class="ac-form-actions">
      <a href="/app/billing/catalog" class="ac-btn ac-btn--ghost">Back to catalog</a>
    </div>
  </article>
</section>
