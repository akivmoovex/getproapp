<div class="ac-clinical-queue" data-ac-stitch="b8d47f05a83c4959ac2d3d6ca83c7dfb" data-ac-screen="clinical-queue" data-ac-page-section="clinical-queue">
  <% const clinicalQueue = (pageData && pageData.queue) || {}; %>
  <% const encounters = Array.isArray(clinicalQueue.encounters) ? clinicalQueue.encounters : []; %>
  <% if (encounters.length === 0) { %>
  <div class="ac-empty-state ac-empty">
    <p>No open encounters. Start a new encounter to begin clinical workflow.</p>
  </div>
  <% } else { %>
  <div class="ac-panel ac-table-wrap ac-clinical-desktop">
    <table class="ac-table">
      <thead>
        <tr>
          <th>Encounter #</th>
          <th>Patient</th>
          <th>Opened</th>
          <th>Opened by</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% encounters.forEach(function (enc) { %>
        <tr>
          <td><a href="/app/clinical/encounter/<%= enc.id %>"><%= enc.encounterNumber %></a></td>
          <td><%= enc.patientDisplayName %> (<%= enc.patientNumber %>)</td>
          <td><%= new Date(enc.openedAt).toLocaleString() %></td>
          <td><%= enc.openedByStaffDisplayName %></td>
          <td>
            <a href="/app/clinical/encounter/<%= enc.id %>">View</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <ul class="ac-card-list ac-clinical-mobile">
    <% encounters.forEach(function (enc) { %>
    <li class="ac-card ac-mobile-record-card">
      <a class="ac-card__link" href="/app/clinical/encounter/<%= enc.id %>">
        <p class="ac-card__title"><%= enc.encounterNumber %></p>
        <p class="ac-muted"><%= enc.patientDisplayName %> · <%= enc.patientNumber %></p>
        <p class="ac-muted"><%= new Date(enc.openedAt).toLocaleString() %></p>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>
</div>
