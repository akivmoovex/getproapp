<%
  var receipt = (pageData && pageData.receipt) || {};
  var stitch = (pageData && pageData.stitch) || {};
  var success = (pageData && pageData.success) || false;
%>
<section class="ac-cashier-receipt" data-ac-page-section="cashier-receipt" data-ac-stitch-desktop="<%= stitch.desktop || '' %>">
  <% if (success) { %>
  <p class="ac-flash ac-flash--success" role="status">Payment recorded successfully.</p>
  <% } %>

  <article class="ac-panel ac-receipt">
    <h2 class="ac-receipt__title">Payment Receipt</h2>
    <p class="ac-receipt__number"><strong>Receipt #<%= receipt.receiptNumber %></strong></p>

    <dl class="ac-dl">
      <div><dt>Receipt date</dt><dd><%= receipt.receiptDate %></dd></div>
      <div><dt>Amount paid</dt><dd><strong><%= receipt.amountFormatted %></strong></dd></div>
      <div><dt>Payment method</dt><dd><%= receipt.paymentMethod %></dd></div>
      <div><dt>Payment number</dt><dd><%= receipt.paymentNumber %></dd></div>
      <div><dt>Patient</dt><dd><%= receipt.issuedToPatientName %> · <%= receipt.patientNumber %></dd></div>
    </dl>

    <div class="ac-actions" style="margin-top:1.5rem">
      <button type="button" class="ac-btn" onclick="window.print()">Print receipt</button>
      <a href="/app/cashier/payment" class="ac-btn ac-btn--ghost">Record another payment</a>
      <a href="/app/cashier" class="ac-btn ac-btn--ghost">Back to cashier</a>
    </div>
  </article>
</section>
