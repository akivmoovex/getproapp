<%
  var expiryAlerts = (pageData && pageData) || {};
  var batches = expiryAlerts.batches || [];
  var facility = expiryAlerts.facility || {};
  var actions = expiryAlerts.actions || {};
  var stitch = expiryAlerts.stitch || {};
%>
<section class="ac-pharmacy-expiry-alerts" data-ac-page-section="pharmacy-expiry-alerts" data-ac-stitch-desktop="<%= stitch.desktop || '' %>">
  <div class="ac-panel">
    <p class="ac-muted">Batches expiring within 90 days for <%= facility.displayName || 'this facility' %>.</p>
  </div>

  <% if (!batches.length) { %>
  <%- include('../partials/ac-inline-state', {
    inlineState: {
      stateKey: 'empty',
      marker: 'expiry-alerts-empty',
      title: 'No expiring batches',
      description: 'No batches are expiring within the next 90 days.',
      secondaryAction: { href: '/app/pharmacy/inventory', label: 'View inventory' }
    }
  }) %>
  <% } else { %>
  <div class="ac-panel ac-table-wrap ac-desktop-table">
    <table class="ac-table">
      <caption class="ac-sr-only">Expiry Alerts</caption>
      <thead>
        <tr>
          <th scope="col">Medication</th>
          <th scope="col">Strength</th>
          <th scope="col">Batch Number</th>
          <th scope="col">Quantity</th>
          <th scope="col">Expiry Date</th>
        </tr>
      </thead>
      <tbody>
        <% batches.forEach(function (batch) { %>
        <tr>
          <td><strong><%= batch.medicationGenericName || '—' %></strong></td>
          <td><%= batch.medicationStrength || '—' %></td>
          <td><a href="/app/pharmacy/inventory/batches/<%= batch.id %>"><%= batch.batchNumber %></a></td>
          <td><%= batch.quantityInBatch %></td>
          <td class="ac-text-warning"><%= batch.expiryDate ? new Date(batch.expiryDate).toLocaleDateString() : '—' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <ul class="ac-card-list ac-mobile-table-cards" data-ac-cards="pharmacy-expiry">
    <% batches.forEach(function (batch) { %>
    <li class="ac-card ac-mobile-record-card">
      <a class="ac-card__link" href="/app/pharmacy/inventory/batches/<%= batch.id %>">
        <p class="ac-card__title"><%= batch.medicationGenericName || '—' %></p>
        <p class="ac-muted"><%= batch.medicationStrength || '—' %> · batch <%= batch.batchNumber %></p>
        <p class="ac-text-warning">Qty <%= batch.quantityInBatch %> · expires <%= batch.expiryDate ? new Date(batch.expiryDate).toLocaleDateString() : '—' %></p>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
