<%
  var page = (pageData && pageData) || {};
  var purchaseOrders = page.purchaseOrders || [];
  var canManage = page.canManage;
  var stitch = page.stitch || {};
%>
<section class="ac-pharmacy-purchase-orders" data-ac-page-section="pharmacy-purchase-orders" data-ac-stitch-desktop="<%= stitch.desktop || '' %>">
  <% if (canManage) { %>
  <div class="ac-panel">
    <a href="/app/pharmacy/purchase-orders/new" class="ac-btn ac-btn--primary">New purchase order</a>
  </div>
  <% } %>

  <% if (!purchaseOrders.length) { %>
  <%- include('../partials/ac-inline-state', {
    inlineState: {
      stateKey: 'empty',
      marker: 'pharmacy-po-empty',
      title: 'No purchase orders yet',
      description: 'Create a purchase order when this facility needs to restock.',
      primaryAction: canManage
        ? { href: '/app/pharmacy/purchase-orders/new', label: 'New purchase order' }
        : null
    }
  }) %>
  <% } else { %>
  <div class="ac-panel ac-table-wrap ac-desktop-table">
    <table class="ac-table">
      <caption class="ac-sr-only">Purchase orders</caption>
      <thead>
        <tr>
          <th scope="col">PO number</th>
          <th scope="col">Supplier</th>
          <th scope="col">Status</th>
          <th scope="col">Items</th>
          <th scope="col">Created</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% purchaseOrders.forEach(function (po) { %>
        <tr>
          <td><strong><%= po.poNumber %></strong></td>
          <td><%= po.supplierName %></td>
          <td><span class="ac-status" data-ac-status="<%= po.status %>"><%= po.status %></span></td>
          <td><%= po.itemCount != null ? po.itemCount : '—' %></td>
          <td><%= po.createdAt ? new Date(po.createdAt).toLocaleString() : '—' %></td>
          <td><a href="/app/pharmacy/purchase-orders/<%= po.id %>" class="ac-stat-link">View</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <ul class="ac-card-list ac-mobile-table-cards" data-ac-cards="pharmacy-po">
    <% purchaseOrders.forEach(function (po) { %>
    <li class="ac-card ac-mobile-record-card">
      <a class="ac-card__link" href="/app/pharmacy/purchase-orders/<%= po.id %>">
        <p class="ac-card__title"><%= po.poNumber %></p>
        <p class="ac-muted"><%= po.supplierName %> · <%= po.itemCount != null ? po.itemCount : '—' %> items</p>
        <p><span class="ac-status" data-ac-status="<%= po.status %>"><%= po.status %></span></p>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
