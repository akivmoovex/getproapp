<main id="ac-auth-main" class="ac-auth-main" data-ac-auth-main="1">
  <div class="ac-auth-card ac-auth-card--single" data-ac-acw-screen="ACW10-success" data-ac-visual="stitch-gap">
    <div class="ac-auth-form-panel" style="text-align:center">
      <header class="ac-auth-mobile-header ac-auth-mobile-header--always">
        <%- include('../partials/auth-mark') %>
        <h1 class="ac-auth-mobile-header__brand">Password updated</h1>
        <p class="ac-auth-mobile-header__sub">You can sign in now</p>
      </header>
      <div class="ac-auth-state-icon ac-auth-state-icon--success" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
      </div>
      <p class="ac-auth-alert ac-auth-alert--success" role="status">
        Your password was updated. Sign in with your new password.
      </p>
      <p class="ac-auth-hint">
        <a class="ac-auth-btn" href="/login">Sign in</a>
      </p>
    </div>
  </div>
</main>
