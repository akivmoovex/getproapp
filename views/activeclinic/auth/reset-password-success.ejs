<main id="ac-auth-main" class="ac-auth-main" data-ac-auth-main="1">
  <div
    class="ac-auth-card ac-auth-card--mf ac-auth-card--access"
    data-ac-acw-screen="ACW10-success"
    data-ac-composition="mf04-success"
    data-ac-auth-screen="reset-password-success"
    data-ac-mf-family="MF04"
  >
    <div class="ac-auth-form-panel ac-auth-form-panel--center">
      <div class="ac-auth-state-icon ac-auth-state-icon--success" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
      </div>
      <h1 class="ac-auth-h1 ac-auth-h1--mf">Password Reset Successful</h1>
      <p class="ac-auth-alert ac-auth-alert--success" role="status">
        Your password has been updated. You can now sign in to your clinical portal.
      </p>
      <p class="ac-auth-hint">
        <a class="ac-auth-btn" href="/login">Sign In</a>
      </p>
    </div>
  </div>
  <%- include('../partials/auth-mf-footer') %>
</main>
