<main id="ac-auth-main" class="ac-auth-main" data-ac-auth-main="1">
  <div class="ac-auth-card ac-auth-card--single" data-ac-visual="stitch-gap">
    <div class="ac-auth-form-panel">
      <header class="ac-auth-mobile-header ac-auth-mobile-header--always">
        <%- include('../partials/auth-mark') %>
        <h1 class="ac-auth-mobile-header__brand">Change password</h1>
        <p class="ac-auth-mobile-header__sub">A password change is required before continuing</p>
      </header>
      <% if (error) { %>
        <div id="ac-auth-error-summary" class="ac-auth-alert ac-auth-alert--error" role="alert" tabindex="-1"><%= error %></div>
      <% } %>
      <form method="post" action="/account/change-password" data-ac-loading="1">
        <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
        <%- include('../partials/auth-password-field', {
          id: 'current_password',
          name: 'current_password',
          label: 'Current password',
          autocomplete: 'current-password',
          minlength: null,
          describedBy: null,
          invalid: Boolean(error)
        }) %>
        <%- include('../partials/auth-password-field', {
          id: 'new_password',
          name: 'new_password',
          label: 'New password',
          autocomplete: 'new-password',
          minlength: passwordMin,
          describedBy: 'password-policy',
          invalid: Boolean(error)
        }) %>
        <%- include('../partials/auth-password-field', {
          id: 'confirm_password',
          name: 'confirm_password',
          label: 'Confirm new password',
          autocomplete: 'new-password',
          minlength: passwordMin,
          describedBy: 'password-policy',
          invalid: Boolean(error)
        }) %>
        <p id="password-policy" class="ac-auth-hint">Use at least <%= passwordMin %> characters.</p>
        <button type="submit" class="ac-auth-btn" data-loading="Updating…">Update password</button>
      </form>
      <form method="post" action="/logout" style="margin-top:1rem">
        <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
        <button type="submit" class="ac-auth-btn ac-auth-btn--ghost">Sign out</button>
      </form>
    </div>
  </div>
</main>
