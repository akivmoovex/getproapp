<main id="ac-auth-main" class="ac-auth-main ac-auth-main--access" data-ac-auth-main="1">
  <% if (variant === 'no-access' || variant === 'access-disabled') { %>
    <%- include('../partials/auth-mf-topbar') %>
  <% } %>
  <div
    class="ac-auth-card ac-auth-card--mf ac-auth-card--access"
    data-ac-lifecycle-state="<%= stateCode || 'invalid' %>"
    data-ac-auth-screen="<%= variant === 'access-disabled' ? 'access-disabled' : (variant === 'no-access' ? 'no-access' : 'lifecycle') %>"
    data-ac-mf-family="<%= variant === 'access-disabled' || variant === 'no-access' ? 'MF02' : '' %>"
  >
    <div class="ac-auth-form-panel ac-auth-form-panel--center">
      <div class="ac-auth-state-icon ac-auth-state-icon--<%= tone || 'error' %>" aria-hidden="true">
        <% if (tone === 'success') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
        <% } else if (variant === 'access-disabled') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="5" y="11" width="14" height="10" rx="2"/>
            <path d="M8 11V8a4 4 0 0 1 8 0v3"/>
          </svg>
        <% } else { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
        <% } %>
      </div>
      <h1 class="ac-auth-h1 ac-auth-h1--mf"><%= heading %></h1>
      <p class="ac-auth-alert ac-auth-alert--<%= tone === 'success' ? 'success' : 'error' %>" role="<%= tone === 'success' ? 'status' : 'alert' %>">
        <%= message %>
      </p>
      <div class="ac-auth-access-actions">
        <% if (primaryHref) { %><a class="ac-auth-btn" href="<%= primaryHref %>"><%= primaryLabel || 'Continue' %></a><% } %>
        <% if (secondaryHref) { %><a class="ac-auth-btn ac-auth-btn--ghost" href="<%= secondaryHref %>"><%= secondaryLabel %></a><% } %>
        <% if (typeof tertiaryHref !== 'undefined' && tertiaryHref) { %>
          <p class="ac-auth-hint"><a class="ac-auth-link" href="<%= tertiaryHref %>"><%= tertiaryLabel || 'Continue' %></a></p>
        <% } %>
      </div>
    </div>
  </div>
  <% if (variant === 'no-access' || variant === 'access-disabled') { %>
    <%- include('../partials/auth-mf-footer') %>
  <% } %>
</main>
