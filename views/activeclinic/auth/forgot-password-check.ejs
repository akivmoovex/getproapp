<main id="ac-auth-main" class="ac-auth-main" data-ac-auth-main="1">
  <div class="ac-auth-card ac-auth-card--single" data-ac-acw-screen="ACW10-verification" data-ac-visual="stitch-gap">
    <div class="ac-auth-form-panel" style="text-align:center">
      <header class="ac-auth-mobile-header ac-auth-mobile-header--always">
        <%- include('../partials/auth-mark') %>
        <h1 class="ac-auth-mobile-header__brand">Check for reset instructions</h1>
        <p class="ac-auth-mobile-header__sub">Password recovery</p>
      </header>
      <p class="ac-auth-alert ac-auth-alert--success" role="status"><%= message %></p>
      <p class="ac-auth-hint">
        This page is the same whether or not an account exists. Automated email or SMS delivery may be unavailable.
      </p>
      <p class="ac-auth-hint">
        <a class="ac-auth-link" href="/login">Back to sign in</a>
        ·
        <a class="ac-auth-link" href="/forgot-password">Request again</a>
      </p>
    </div>
  </div>
</main>
