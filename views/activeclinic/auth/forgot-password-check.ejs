<main id="ac-auth-main" class="ac-auth-main" data-ac-auth-main="1">
  <div
    class="ac-auth-card ac-auth-card--mf"
    data-ac-acw-screen="ACW10-verification"
    data-ac-composition="mf04-check"
    data-ac-auth-screen="forgot-password-check"
    data-ac-mf-family="MF04"
  >
    <header class="ac-auth-mf-brand">
      <%- include('../partials/auth-mark') %>
      <p class="ac-auth-mf-brand__name">ActiveClinic</p>
    </header>
    <h1 class="ac-auth-h1 ac-auth-h1--mf">Check for reset instructions</h1>
    <p class="ac-auth-alert ac-auth-alert--success" role="status"><%= message %></p>
    <p class="ac-auth-hint">
      This page is the same whether or not an account exists. If a reset message is delivered, open the link in that message to choose a new password.
    </p>
    <p class="ac-auth-hint">
      <a class="ac-auth-link" href="/login">Back to Login</a>
      ·
      <a class="ac-auth-link" href="/forgot-password">Request again</a>
    </p>
  </div>
  <%- include('../partials/auth-mf-footer') %>
</main>
