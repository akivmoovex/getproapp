<main id="ac-auth-main" class="ac-auth-main" data-ac-auth-main="1">
  <div class="ac-auth-card ac-auth-card--single" data-ac-visual="stitch-gap">
    <div class="ac-auth-form-panel">
      <header class="ac-auth-mobile-header ac-auth-mobile-header--always">
        <%- include('../partials/auth-mark') %>
        <h1 class="ac-auth-mobile-header__brand">Forgot password</h1>
        <p class="ac-auth-mobile-header__sub">Request a password reset</p>
      </header>
      <% if (error) { %>
        <div id="ac-auth-error-summary" class="ac-auth-alert ac-auth-alert--error" role="alert" tabindex="-1"><%= error %></div>
      <% } %>
      <% if (message) { %>
        <p class="ac-auth-alert ac-auth-alert--success" role="status"><%= message %></p>
      <% } %>
      <form method="post" action="/forgot-password" data-ac-loading="1">
        <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
        <div class="ac-auth-field">
          <label for="identifier">Phone number or email</label>
          <div class="ac-auth-phone">
            <span class="ac-auth-phone__prefix" aria-hidden="true">+260</span>
            <input
              class="ac-auth-input"
              id="identifier"
              name="identifier"
              type="text"
              autocomplete="username"
              inputmode="tel"
              required
              placeholder="97 123 4567 or email"
            />
          </div>
        </div>
        <button type="submit" class="ac-auth-btn" data-loading="Submitting…">Continue</button>
      </form>
      <p class="ac-auth-hint">
        For security, the same response is shown whether or not an account exists. Automated delivery may be unavailable.
      </p>
      <p class="ac-auth-hint"><a class="ac-auth-link" href="/login">Back to sign in</a></p>
    </div>
  </div>
</main>
