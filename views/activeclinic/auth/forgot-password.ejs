<main id="ac-auth-main" class="ac-auth-main" data-ac-auth-main="1">
  <div
    class="ac-auth-card ac-auth-card--mf"
    data-ac-acw-screen="ACW10-forgot"
    data-ac-composition="mf04-forgot"
    data-ac-auth-screen="forgot-password"
    data-ac-mf-family="MF04"
  >
    <header class="ac-auth-mf-brand">
      <%- include('../partials/auth-mark') %>
      <p class="ac-auth-mf-brand__name">ActiveClinic</p>
    </header>
    <div class="ac-auth-state-icon ac-auth-state-icon--reset" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="5" y="11" width="14" height="10" rx="2"/>
        <path d="M8 11V8a4 4 0 0 1 8 0v3"/>
        <path d="M12 15v2"/>
      </svg>
    </div>
    <h1 class="ac-auth-h1 ac-auth-h1--mf">Forgot Password</h1>
    <p class="ac-auth-desc ac-auth-desc--mf">
      Enter your email address or phone number. If an eligible account exists, a reset link will be sent. Automated delivery may be unavailable.
    </p>
    <% if (error) { %>
      <div id="ac-auth-error-summary" class="ac-auth-alert ac-auth-alert--error" role="alert" tabindex="-1"><%= error %></div>
    <% } %>
    <form method="post" action="/forgot-password" data-ac-loading="1">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <div class="ac-auth-field">
        <%- include('../partials/phone-field', {
          id: 'identifier',
          label: 'Email address or phone number',
          required: true,
          identifierMode: true,
          identifierName: 'identifier',
          defaultCountry: defaultPhoneCountry || 'ZM',
          selectedCountry: phoneCountry || defaultPhoneCountry || 'ZM',
          nationalValue: typeof identifier !== 'undefined' ? identifier : '',
          countries: phoneCountries,
          phoneValidationRelaxed: phoneValidationRelaxed,
          placeholder: '97 123 4567 or email',
          showLegacyHidden: false
        }) %>
      </div>
      <button type="submit" class="ac-auth-btn" data-loading="Submitting…">Send reset link</button>
    </form>
    <p class="ac-auth-hint">
      For security, the next screen is the same whether or not an account exists.
    </p>
    <p class="ac-auth-hint"><a class="ac-auth-link" href="/login">Back to Login</a></p>
  </div>
  <%- include('../partials/auth-mf-footer') %>
</main>
