<main id="ac-auth-main" class="ac-auth-main" data-ac-auth-main="1">
  <div class="ac-auth-card ac-auth-card--single" data-ac-visual="stitch-gap">
    <div class="ac-auth-form-panel">
      <header class="ac-auth-mobile-header ac-auth-mobile-header--always">
        <%- include('../partials/auth-mark') %>
        <h1 class="ac-auth-mobile-header__brand">Select organization</h1>
        <p class="ac-auth-mobile-header__sub">Choose the healthcare organization to open</p>
      </header>
      <% if (error) { %>
        <div id="ac-auth-error-summary" class="ac-auth-alert ac-auth-alert--error" role="alert" tabindex="-1"><%= error %></div>
      <% } %>
      <% if (!organizations || organizations.length === 0) { %>
        <p class="ac-auth-alert ac-auth-alert--warning" role="status">No eligible organizations are available for this sign-in.</p>
        <p class="ac-auth-hint"><a class="ac-auth-link" href="/login">Back to sign in</a></p>
      <% } else { %>
        <form method="post" action="/login/select-organization" data-ac-loading="1">
          <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
          <fieldset style="border:0;margin:0;padding:0">
            <legend class="ac-auth-sr-only">Healthcare organization</legend>
            <ul class="ac-auth-org-list">
              <% organizations.forEach(function (o, idx) { %>
                <li>
                  <label class="ac-auth-org-option">
                    <input
                      type="radio"
                      name="organization_id"
                      value="<%= o.organizationId %>"
                      required
                      <%= idx === 0 ? 'checked' : '' %>
                    />
                    <span class="ac-auth-org-option__name"><%= o.healthcareOrganizationName || o.displayName %></span>
                    <% if (o.staffDisplayName) { %>
                      <span class="ac-auth-org-option__meta">Signed in as <%= o.staffDisplayName %></span>
                    <% } %>
                  </label>
                </li>
              <% }) %>
            </ul>
          </fieldset>
          <button type="submit" class="ac-auth-btn" data-loading="Continuing…">Continue</button>
        </form>
      <% } %>
    </div>
  </div>
</main>
