<%
  var shell = typeof editorShell !== 'undefined' && editorShell ? editorShell : {};
  var pages = Array.isArray(shell.pages) ? shell.pages : [];
  var currentPage = shell.pageKey || 'home';
  var productCode = shell.productCode || '';
  var prefix = typeof editorPathPrefix !== 'undefined' && editorPathPrefix ? String(editorPathPrefix) : '';
  function pageEditHref(page) {
    var pathPart = page && page.path ? String(page.path) : '';
    var href = pathPart ? (prefix + '/' + pathPart.replace(/^\//, '')) : (prefix || '/');
    var sep = href.indexOf('?') >= 0 ? '&' : '?';
    return href + sep + 'website_edit=1&website_mode=draft';
  }
%>
<nav
  class="gp-website-engine-shell"
  data-website-engine-shell="1"
  data-website-chrome="1"
  data-product="<%= productCode %>"
  data-page-key="<%= currentPage %>"
  data-draft="<%= shell.draft ? '1' : '0' %>"
  data-website-save-url="<%= shell.saveUrl || '' %>"
  data-website-media-url="<%= shell.mediaUrl || '' %>"
  data-website-max-bytes="5242880"
  aria-label="Website editor"
>
  <div class="gp-website-engine-shell__pages" data-website-engine-pages="1">
    <label class="gp-website-engine-shell__label" for="gp-website-engine-page"><%= shell.pageSelectLabel || 'Page' %></label>
    <% if (pages.length) { %>
    <select id="gp-website-engine-page" data-website-engine-page-select="1">
      <% pages.forEach(function (page) { %>
      <option
        value="<%= page.key %>"
        data-href="<%= pageEditHref(page) %>"
        <%= page.key === currentPage ? ' selected' : '' %>
      ><%= page.label || page.key %></option>
      <% }); %>
    </select>
    <% } else { %>
    <span data-website-engine-page-current="1"><%= currentPage %></span>
    <% } %>
  </div>
  <p class="gp-website-engine-shell__draft" data-website-engine-draft="1"><%= shell.draftLabel || '' %></p>
  <p class="gp-website-engine-shell__save-state" data-website-engine-save-state="1"><%= shell.saveStateLabel || '' %></p>
  <div class="gp-website-engine-shell__viewport" data-website-engine-viewport="1" role="group" aria-label="Desktop or mobile preview">
    <button type="button" class="gp-website-engine-shell__viewport-btn is-current" data-website-viewport="desktop">Desktop</button>
    <button type="button" class="gp-website-engine-shell__viewport-btn" data-website-viewport="mobile">Mobile</button>
  </div>
  <div class="gp-website-engine-shell__actions" data-website-engine-toolbar="1">
    <% if (shell.canEdit) { %>
    <span class="gp-website-engine-shell__save" data-website-engine-save="1"><%= shell.saveLabel || 'Save draft' %></span>
    <% } %>
    <% if (shell.previewHref) { %>
    <a class="gp-website-engine-shell__link" href="<%= shell.previewHref %>" data-website-engine-preview="1" data-website-preview="1"><%= shell.previewLabel || 'Preview' %></a>
    <% } %>
    <% if (shell.historyHref) { %>
    <a class="gp-website-engine-shell__link" href="<%= shell.historyHref %>" data-website-engine-history="1">Version history</a>
    <% } %>
    <% if (shell.canPublish && (shell.publishHref || shell.publishPath)) { %>
    <form
      method="post"
      action="<%= shell.publishHref || shell.publishPath %>"
      class="gp-website-engine-shell__publish"
      data-website-publish-confirm="1"
      data-website-engine-publish-form="1"
      data-website-publish-message="Publish this website? Public visitors will see the current draft."
    >
      <input type="hidden" name="<%= shell.csrfField || '_csrf' %>" value="<%= shell.csrfToken || '' %>"/>
      <input type="hidden" name="confirm_publish" value="1"/>
      <input type="hidden" name="makePublic" value="1"/>
      <button type="submit" class="gp-website-engine-shell__link gp-website-engine-shell__link--primary" data-website-engine-publish="1" data-bb-review-publish="1">
        <%= shell.publishLabel || 'Publish' %>
      </button>
    </form>
    <% } %>
    <% if (shell.hubHref) { %>
    <a class="gp-website-engine-shell__link" href="<%= shell.hubHref %>" data-website-engine-hub="1">Website management</a>
    <% } %>
    <% if (shell.exitHref) { %>
    <a class="gp-website-engine-shell__link" href="<%= shell.exitHref %>" data-website-engine-exit="1" data-bb-exit-editing="1"><%= shell.exitLabel || 'Exit Editing' %></a>
    <% } %>
  </div>
</nav>
