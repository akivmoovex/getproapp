<%#
  Platform person card — PersonPresentation only (no Doctor/Pastor semantics).
  Locals: person, editEnabled, edit, className
%>
<%
  var p = typeof person !== 'undefined' && person ? person : {};
  if (p.visibility === false) { /* hidden */ } else {
  var extraClass = typeof className !== 'undefined' && className ? (' ' + className) : '';
  var featured = p.featured === true;
  var imgSrc = '';
  if (typeof p.image === 'string') imgSrc = p.image;
  else if (p.image && p.image.src) imgSrc = String(p.image.src);
%>
<article
  class="gp-website-pc gp-website-pc--person-card<%= featured ? ' is-featured' : '' %><%= extraClass %>"
  data-gp-website-component="person_card"
  <% if (p.sourceDomain) { %>data-gp-source-domain="<%= p.sourceDomain %>"<% } %>
  <% if (p.sourceId) { %>data-gp-source-id="<%= p.sourceId %>"<% } %>
>
  <div class="gp-website-pc__person-media<%= imgSrc ? '' : ' is-empty' %>">
    <% if (imgSrc) { %>
    <img class="gp-website-pc__img gp-website-pc__img--avatar" src="<%= imgSrc %>" alt="<%= p.name || '' %>" />
    <% } else { %>
    <div class="gp-website-pc__img-placeholder gp-website-pc__img-placeholder--avatar" aria-hidden="true"></div>
    <% } %>
  </div>
  <div class="gp-website-pc__person-body">
    <h3 class="gp-website-pc__person-name"><%= p.name %></h3>
    <% if (p.title) { %><p class="gp-website-pc__person-title"><%= p.title %></p><% } %>
    <% if (p.subtitle) { %><p class="gp-website-pc__person-subtitle"><%= p.subtitle %></p><% } %>
    <% if (p.description) { %><p class="gp-website-pc__person-description"><%= p.description %></p><% } %>
    <% if (p.cta && p.cta.label) { %>
    <a class="gp-website-pc__link" href="<%= p.cta.url || '#' %>"><%= p.cta.label %></a>
    <% } %>
  </div>
</article>
<% } %>
