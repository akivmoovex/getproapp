<%
  var m = typeof model !== 'undefined' && model ? model : {};
  var editMap = (typeof edit !== 'undefined' && edit && edit.keys) ? edit.keys : {};
  var canEdit = typeof editEnabled !== 'undefined' && editEnabled;
  var extraClass = typeof className !== 'undefined' && className ? (' ' + className) : '';
  var pos = m.imagePosition === 'end' ? 'end' : 'start';
%>
<section class="gp-website-pc gp-website-pc--image-text gp-website-pc--image-<%= pos %><%= extraClass %>" data-gp-website-component="image_text">
  <div class="gp-website-pc__media">
    <%- include('./editable-image', {
      editEnabled: canEdit && !!editMap.image,
      contentKey: editMap.image || '',
      image: m.image,
      className: 'gp-website-pc__img'
    }) %>
  </div>
  <div class="gp-website-pc__copy">
    <% if (m.heading || (canEdit && editMap.heading)) { %>
    <%- include('./editable-field', {
      editEnabled: canEdit && !!editMap.heading,
      contentKey: editMap.heading || '',
      value: m.heading || '',
      tag: 'h2',
      className: 'gp-website-pc__title',
      fieldType: 'short_text'
    }) %>
    <% } %>
    <%- include('./editable-field', {
      editEnabled: canEdit && !!editMap.body,
      contentKey: editMap.body || '',
      value: m.body || '',
      tag: 'p',
      className: 'gp-website-pc__body',
      fieldType: 'long_text'
    }) %>
    <% if (m.cta && m.cta.label) { %>
    <a class="gp-website-pc__btn gp-website-pc__btn--primary" href="<%= m.cta.url || '#' %>"><%= m.cta.label %></a>
    <% } %>
  </div>
</section>
