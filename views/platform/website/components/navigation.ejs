<%#
  Navigation presentation list — chrome/styling remains product-owned when opted in.
  Desktop + mobile share this component; sticky mobile CTA uses primaryCta when present.
%>
<%
  var m = typeof model !== 'undefined' && model ? model : {};
  var items = Array.isArray(m.items) ? m.items.filter(function (i) { return !i || i.visible !== false; }) : [];
  var extraClass = typeof className !== 'undefined' && className ? (' ' + className) : '';
  var logoSrc = '';
  if (typeof m.logo === 'string') logoSrc = m.logo;
  else if (m.logo && m.logo.src) logoSrc = String(m.logo.src);
%>
<nav class="gp-website-pc gp-website-pc--navigation<%= extraClass %>" data-gp-website-component="navigation" aria-label="Site">
  <div class="gp-website-pc__nav-bar">
    <% if (logoSrc || m.brandName) { %>
    <div class="gp-website-pc__nav-brand">
      <% if (logoSrc) { %><img class="gp-website-pc__nav-logo" src="<%= logoSrc %>" alt="<%= m.brandName || '' %>" /><% } %>
      <% if (m.brandName) { %><span class="gp-website-pc__nav-brand-name"><%= m.brandName %></span><% } %>
    </div>
    <% } %>
    <ul class="gp-website-pc__nav-list">
      <% items.forEach(function (item) { %>
      <li class="gp-website-pc__nav-item">
        <a class="gp-website-pc__nav-link" href="<%= item.href || '#' %>"><%= item.label %></a>
      </li>
      <% }) %>
    </ul>
    <% if (m.primaryCta && m.primaryCta.label) { %>
    <a class="gp-website-pc__btn gp-website-pc__btn--primary gp-website-pc__nav-cta" href="<%= m.primaryCta.url || '#' %>"><%= m.primaryCta.label %></a>
    <% } %>
  </div>
</nav>
