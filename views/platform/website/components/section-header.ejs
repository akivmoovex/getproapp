<%
  var m = typeof model !== 'undefined' && model ? model : {};
  var editMap = (typeof edit !== 'undefined' && edit && edit.keys) ? edit.keys : {};
  var canEdit = typeof editEnabled !== 'undefined' && editEnabled;
  var extraClass = typeof className !== 'undefined' && className ? (' ' + className) : '';
%>
<header class="gp-website-pc gp-website-pc--section-header<%= extraClass %>" data-gp-website-component="section_header">
  <% if (m.eyebrow || (canEdit && editMap.eyebrow)) { %>
  <p class="gp-website-pc__eyebrow">
    <%- include('./editable-field', {
      editEnabled: canEdit && !!editMap.eyebrow,
      contentKey: editMap.eyebrow || '',
      value: m.eyebrow || '',
      tag: 'span',
      className: 'gp-website-pc__eyebrow-text',
      fieldType: 'short_text'
    }) %>
  </p>
  <% } %>
  <%- include('./editable-field', {
    editEnabled: canEdit && !!editMap.title,
    contentKey: editMap.title || '',
    value: m.title || '',
    tag: 'h2',
    className: 'gp-website-pc__title',
    fieldType: 'short_text',
    label: 'Edit section title'
  }) %>
  <% if (m.lead || (canEdit && editMap.lead)) { %>
  <%- include('./editable-field', {
    editEnabled: canEdit && !!editMap.lead,
    contentKey: editMap.lead || '',
    value: m.lead || '',
    tag: 'p',
    className: 'gp-website-pc__lead',
    fieldType: 'long_text'
  }) %>
  <% } %>
  <% if (m.cta && m.cta.label) { %>
  <a class="gp-website-pc__link" href="<%= m.cta.url || '#' %>"><%= m.cta.label %></a>
  <% } %>
</header>
