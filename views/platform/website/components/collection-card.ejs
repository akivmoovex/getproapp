<%#
  Platform collection card (single offering/generic item) OR first visible item when single=true.
  Locals: collection, single?, editEnabled, edit, className
%>
<%
  var c = typeof collection !== 'undefined' && collection ? collection : { items: [] };
  var items = Array.isArray(c.items) ? c.items.filter(function (item) { return !item || item.visibility !== false; }) : [];
  var extraClass = typeof className !== 'undefined' && className ? (' ' + className) : '';
  var only = typeof single !== 'undefined' && single;
  var renderItems = only ? items.slice(0, 1) : items;
%>
<% if (only) { %>
  <% var item = renderItems[0]; if (item) {
    var imgSrc = '';
    if (typeof item.image === 'string') imgSrc = item.image;
    else if (item.image && item.image.src) imgSrc = String(item.image.src);
  %>
<article
  class="gp-website-pc gp-website-pc--collection-card<%= item.featured ? ' is-featured' : '' %><%= extraClass %>"
  data-gp-website-component="collection_card"
  data-gp-card-kind="<%= item.kind || c.cardKind || 'generic' %>"
  <% if (item.sourceDomain) { %>data-gp-source-domain="<%= item.sourceDomain %>"<% } %>
>
  <div class="gp-website-pc__card-media<%= imgSrc ? '' : ' is-empty' %>">
    <% if (imgSrc) { %><img class="gp-website-pc__img" src="<%= imgSrc %>" alt="<%= item.title || '' %>" /><% } %>
  </div>
  <div class="gp-website-pc__card-body">
    <h3 class="gp-website-pc__card-title"><%= item.title %></h3>
    <% if (item.subtitle) { %><p class="gp-website-pc__card-subtitle"><%= item.subtitle %></p><% } %>
    <% if (item.description) { %><p class="gp-website-pc__card-description"><%= item.description %></p><% } %>
    <% if (item.cta && item.cta.label) { %>
    <a class="gp-website-pc__link" href="<%= item.cta.url || '#' %>"><%= item.cta.label %></a>
    <% } %>
  </div>
</article>
  <% } %>
<% } else { %>
<%- include('./collection-grid', { collection: c, editEnabled: false, className: className || '' }) %>
<% } %>
