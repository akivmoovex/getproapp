<%#
  Platform hero — presentation DTO only.
  Locals: model (hero), editEnabled, edit { keys: { eyebrow, title, subtitle, image, primaryLabel, primaryUrl } }, className
%>
<%
  var m = typeof model !== 'undefined' && model ? model : {};
  var editMap = (typeof edit !== 'undefined' && edit && edit.keys) ? edit.keys : {};
  var canEdit = typeof editEnabled !== 'undefined' && editEnabled;
  var extraClass = typeof className !== 'undefined' && className ? (' ' + className) : '';
%>
<section class="gp-website-pc gp-website-pc--hero<%= extraClass %>" data-gp-website-component="hero">
  <div class="gp-website-pc__hero-copy">
    <% if (m.eyebrow || (canEdit && editMap.eyebrow)) { %>
    <p class="gp-website-pc__eyebrow">
      <%- include('./editable-field', {
        editEnabled: canEdit && !!editMap.eyebrow,
        contentKey: editMap.eyebrow || '',
        value: m.eyebrow || '',
        tag: 'span',
        className: 'gp-website-pc__eyebrow-text',
        fieldType: 'short_text',
        label: 'Edit eyebrow'
      }) %>
    </p>
    <% } %>
    <%- include('./editable-field', {
      editEnabled: canEdit && !!editMap.title,
      contentKey: editMap.title || '',
      value: m.title || '',
      tag: 'h1',
      className: 'gp-website-pc__title',
      fieldType: 'short_text',
      label: 'Edit hero title'
    }) %>
    <% if (m.subtitle || (canEdit && editMap.subtitle)) { %>
    <%- include('./editable-field', {
      editEnabled: canEdit && !!editMap.subtitle,
      contentKey: editMap.subtitle || '',
      value: m.subtitle || '',
      tag: 'p',
      className: 'gp-website-pc__lead',
      fieldType: 'long_text',
      label: 'Edit hero subtitle'
    }) %>
    <% } %>
    <div class="gp-website-pc__actions">
      <% if ((m.primaryCta && m.primaryCta.label) || (canEdit && editMap.primaryLabel)) { %>
      <%- include('./editable-field', {
        editEnabled: canEdit && !!editMap.primaryLabel,
        contentKey: editMap.primaryLabel || '',
        value: (m.primaryCta && m.primaryCta.label) || '',
        tag: 'a',
        href: (m.primaryCta && m.primaryCta.url) || '#',
        className: 'gp-website-pc__btn gp-website-pc__btn--primary',
        fieldType: 'short_text',
        label: 'Edit primary CTA'
      }) %>
      <% } %>
      <% if (m.secondaryCta && m.secondaryCta.label) { %>
      <a class="gp-website-pc__btn gp-website-pc__btn--secondary" href="<%= m.secondaryCta.url || '#' %>"><%= m.secondaryCta.label %></a>
      <% } %>
    </div>
  </div>
  <div class="gp-website-pc__hero-media">
    <%- include('./editable-image', {
      editEnabled: canEdit && !!editMap.image,
      contentKey: editMap.image || '',
      image: m.image,
      className: 'gp-website-pc__img gp-website-pc__img--hero',
      label: 'Edit hero image'
    }) %>
  </div>
</section>
