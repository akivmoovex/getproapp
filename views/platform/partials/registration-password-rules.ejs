<%#
  Shared registration password rule list.
  Locals: passwordRules (from registrationPasswordPolicy.js), passwordInputId
%>
<%
  var rules = Array.isArray(passwordRules) ? passwordRules : [];
  var inputId = typeof passwordInputId !== 'undefined' && passwordInputId ? passwordInputId : 'password';
%>
<div
  class="gp-registration-password-rules"
  id="password-policy"
  role="group"
  aria-labelledby="password-policy-title"
  aria-describedby="<%= inputId %>"
>
  <p class="gp-registration-password-rules__title" id="password-policy-title">Password requirements</p>
  <ul class="gp-registration-password-rules__list">
    <% rules.forEach(function (rule) { %>
    <li
      class="gp-registration-password-rules__item"
      data-gp-password-rule="<%= rule.id %>"
      role="checkbox"
      aria-checked="false"
    >
      <span class="gp-registration-password-rules__mark" aria-hidden="true">○</span>
      <span class="gp-registration-password-rules__label"><%= rule.label %></span>
    </li>
    <% }) %>
  </ul>
</div>
