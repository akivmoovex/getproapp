<%#
  Self-hosted product fonts. Locals:
    fontFamily: 'hanken' | 'inter' | 'hanken-inter' | 'public-sans'
    iconFont: 'subset' | 'full' | 'none'  (default subset)
    fontAssetVersion: optional cache-bust
%>
<%
  var _fontFamily = typeof fontFamily !== 'undefined' && fontFamily ? String(fontFamily) : 'hanken';
  var _iconFont = typeof iconFont !== 'undefined' && iconFont ? String(iconFont) : 'subset';
  var _fontV = typeof fontAssetVersion !== 'undefined' && fontAssetVersion ? String(fontAssetVersion) : '1';
  var _wantHanken = _fontFamily === 'hanken' || _fontFamily === 'hanken-inter';
  var _wantInter = _fontFamily === 'inter' || _fontFamily === 'hanken-inter';
  var _wantPublicSans = _fontFamily === 'public-sans';
%>
<link rel="stylesheet" href="/platform/gp-fonts.css?v=<%= _fontV %>"/>
<% if (_wantHanken) { %>
<link rel="preload" href="/fonts/hanken-grotesk-4.woff2" as="font" type="font/woff2" crossorigin/>
<% } %>
<% if (_wantInter) { %>
<link rel="preload" href="/fonts/inter-7.woff2" as="font" type="font/woff2" crossorigin/>
<% } %>
<% if (_wantPublicSans) { %>
<link rel="preload" href="/fonts/public-sans-3.woff2" as="font" type="font/woff2" crossorigin/>
<% } %>
<% if (_iconFont === 'subset') { %>
<link rel="stylesheet" href="/platform/gp-icon-font.css?v=<%= _fontV %>"/>
<% } else if (_iconFont === 'full') { %>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0&display=swap" rel="stylesheet"/>
<% } %>
