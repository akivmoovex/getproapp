<%#
  Shared success state panel (product-neutral).
  Locals: title?, body?, actionHref?, actionLabel?, className?
%>
<%
  var _title = typeof title !== 'undefined' && title ? String(title) : 'Success';
  var _body = typeof body !== 'undefined' && body ? String(body) : '';
  var _cls = 'gp-ops-state gp-ops-state--success' + (typeof className !== 'undefined' && className ? ' ' + className : '');
%>
<div class="<%= _cls %>" role="status" data-gp-ops="success-state">
  <div class="gp-ops-state__icon" aria-hidden="true">
    <span class="gp-ops-state__mark">✓</span>
  </div>
  <h2 class="gp-ops-state__title"><%= _title %></h2>
  <% if (_body) { %>
  <p class="gp-ops-state__body"><%= _body %></p>
  <% } %>
  <% if (typeof actionHref !== 'undefined' && actionHref) { %>
  <p class="gp-ops-state__action">
    <a class="gp-ops-btn gp-ops-btn--primary" href="<%= actionHref %>">
      <%= typeof actionLabel !== 'undefined' && actionLabel ? actionLabel : 'Continue' %>
    </a>
  </p>
  <% } %>
</div>
