<%
  const pageTitle = 'Activity registration';
  const fieldsHint = 'Publish visitor, event, or ministry registration forms. Public submit uses shared forms with consent and duplicate protection.';
%>
<div class="mx-forms-shell" data-screen="BB08" data-bb-activity="admin-forms" data-bb-screen-desktop="BB08-D" data-bb-screen-mobile="BB08-M">
  <div class="mx-forms-top">
    <div>
      <div class="mx-forms-brand">BlessBoard · Activity registration</div>
      <h1 class="mx-forms-title">Visitor, event &amp; ministry forms</h1>
      <p class="mx-forms-sub"><%= fieldsHint %></p>
    </div>
  </div>

  <div class="mx-forms-panel" style="margin-bottom:1rem">
    <h2>Publish form</h2>
    <form method="post" action="<%= basePath %>">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />
      <label for="kind">Type</label>
      <select id="kind" name="kind" required>
        <option value="visitor">Visitor (BB08)</option>
        <option value="event">Event (BB09)</option>
        <option value="ministry">Ministry (BB10)</option>
      </select>
      <label for="title">Title (optional)</label>
      <input id="title" name="title" type="text" maxlength="200" />
      <label for="event_id">Event ID (required for event)</label>
      <input id="event_id" name="event_id" type="text" maxlength="64" />
      <label for="ministry_id">Ministry ID (required for ministry)</label>
      <input id="ministry_id" name="ministry_id" type="text" maxlength="64" />
      <label for="max_submissions">Capacity override (optional)</label>
      <input id="max_submissions" name="max_submissions" type="number" min="1" />
      <p class="mx-forms-sub">Ministry approval never grants privileged roles or login accounts.</p>
      <div class="mx-forms-actions">
        <button class="mx-forms-btn mx-forms-btn--primary" type="submit">Publish</button>
      </div>
    </form>
  </div>
</div>
