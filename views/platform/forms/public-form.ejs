<%
  const pageTitle = form ? form.title : 'Form';
  const fields = (form && form.schemaJson && form.schemaJson.fields) || [];
  const priorAnswers = typeof answers !== 'undefined' && answers ? answers : {};
  const errs = typeof fieldErrors !== 'undefined' && fieldErrors ? fieldErrors : {};
  const errKeys = Object.keys(errs);
  const hasFieldErrors = errKeys.length > 0;
  const hasBannerError = typeof error !== 'undefined' && error;
  const isValidationState = hasFieldErrors || hasBannerError;
  const idem = typeof idempotencyKey !== 'undefined' ? idempotencyKey : '';
  let activityScreen = typeof stitchScreen !== 'undefined' ? stitchScreen : (isValidationState ? 'SH09' : 'SH08');
  // Category screens only on the ready (SH08) surface — keep SH09 for validation.
  if (activityScreen === 'SH08' && form) {
    if (form.category === 'visitor') activityScreen = 'BB08';
    if (form.category === 'event') activityScreen = 'BB09';
    if (form.category === 'ministry') activityScreen = 'BB10';
  }
  const stitchDesktop = isValidationState ? 'SH09-D' : 'SH08-D';
  const stitchMobile = isValidationState ? 'SH09-M' : 'SH08-M';
  const stitchDesktopId = isValidationState
    ? 'c78a75e9d52c4a0d8be9ffdd019ea598'
    : '68c27d624adc4bca9dac5f61cf9ef8be';
  const stitchMobileId = isValidationState
    ? '95eaf5ae3c93424996906f04e488620c'
    : 'e56e8d43648e4299a75ab0c0bfeb1033';
  function fieldLabel(key) {
    for (var i = 0; i < fields.length; i++) {
      if (fields[i].key === key) return fields[i].label || key;
    }
    return key;
  }
%>
<div
  class="mx-forms-shell mx-forms-public<%= isValidationState ? ' mx-forms-public--errors' : '' %>"
  data-screen="<%= activityScreen %>"
  data-stitch-desktop="<%= stitchDesktop %>"
  data-stitch-mobile="<%= stitchMobile %>"
  data-stitch-desktop-id="<%= stitchDesktopId %>"
  data-stitch-mobile-id="<%= stitchMobileId %>"
  data-bb-form-category="<%= form && form.category ? form.category : '' %>"
>
  <% if (!form) { %>
    <div class="mx-forms-alert mx-forms-alert--danger" role="alert"><%= error || 'Unavailable' %></div>
  <% } else { %>
    <div class="mx-forms-brand"><%= brand.productName %></div>
    <h1 class="mx-forms-title"><%= form.title %></h1>
    <% if (form.description) { %><p class="mx-forms-sub"><%= form.description %></p><% } %>

    <% if (isValidationState) { %>
      <div
        id="mx-forms-error-summary"
        class="mx-forms-alert mx-forms-alert--danger mx-forms-error-summary"
        role="alert"
        tabindex="-1"
        data-mx-forms-error-summary="1"
      >
        <strong>Please check the highlighted fields.</strong>
        <% if (hasBannerError) { %>
          <p class="mx-forms-error-summary__banner"><%= error %></p>
        <% } %>
        <% if (hasFieldErrors) { %>
          <ul class="mx-forms-error-summary__list">
            <% errKeys.forEach(function (key) { %>
              <li><a href="#f_<%= key %>"><%= fieldLabel(key) %></a></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    <% } %>

    <form
      class="mx-forms-panel mx-forms-public-form"
      method="post"
      action="/f/<%= form.publicToken %>"
      style="max-width:560px;margin-top:1rem"
      novalidate
      data-mx-forms-public="1"
    >
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />
      <input type="hidden" name="idempotency_key" value="<%= idem %>" />
      <% if (form.accessMode === 'email_token') { %>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required value="<%= typeof email !== 'undefined' ? email : '' %>" autocomplete="email" />
        <label for="access_token">Access token</label>
        <input id="access_token" name="access_token" type="text" required value="<%= typeof accessToken !== 'undefined' ? accessToken : '' %>" autocomplete="off" />
      <% } %>
      <% fields.forEach(function (field) { %>
        <label for="f_<%= field.key %>" class="<%= errs[field.key] ? 'mx-forms-field-error-label' : '' %>">
          <%= field.label %><% if (field.required) { %> *<% } %>
        </label>
        <% if (field.type === 'textarea') { %>
          <textarea id="f_<%= field.key %>" name="<%= field.key %>" rows="3" <%= field.required ? 'required' : '' %>
            class="<%= errs[field.key] ? 'mx-forms-input-error' : '' %>"
            aria-invalid="<%= errs[field.key] ? 'true' : 'false' %>"><%= priorAnswers[field.key] || '' %></textarea>
        <% } else if (field.type === 'select') { %>
          <select id="f_<%= field.key %>" name="<%= field.key %>" <%= field.required ? 'required' : '' %>
            class="<%= errs[field.key] ? 'mx-forms-input-error' : '' %>"
            aria-invalid="<%= errs[field.key] ? 'true' : 'false' %>">
            <option value="">Select…</option>
            <% (field.options || []).forEach(function (opt) { %>
              <option value="<%= opt %>" <%= priorAnswers[field.key] === opt ? 'selected' : '' %>><%= opt %></option>
            <% }) %>
          </select>
        <% } else if (field.type === 'checkbox') { %>
          <input id="f_<%= field.key %>" name="<%= field.key %>" type="checkbox" value="true"
            <%= priorAnswers[field.key] ? 'checked' : '' %>
            aria-invalid="<%= errs[field.key] ? 'true' : 'false' %>" />
        <% } else { %>
          <input id="f_<%= field.key %>" name="<%= field.key %>"
            type="<%= field.type === 'email' ? 'email' : field.type === 'number' ? 'number' : field.type === 'date' ? 'date' : field.type === 'phone' ? 'tel' : 'text' %>"
            <%= field.required ? 'required' : '' %>
            class="<%= errs[field.key] ? 'mx-forms-input-error' : '' %>"
            aria-invalid="<%= errs[field.key] ? 'true' : 'false' %>"
            value="<%= priorAnswers[field.key] != null ? priorAnswers[field.key] : '' %>" />
        <% } %>
        <% if (errs[field.key]) { %>
          <p class="mx-forms-field-hint" id="hint_<%= field.key %>">Check this field.</p>
        <% } %>
      <% }) %>

      <% if (form.requireConsent !== false) { %>
        <label style="margin-top:1rem;font-weight:500">
          <input type="checkbox" name="consent" value="1" required />
          I consent to submit this information for the stated purpose (not clinical records).
        </label>
      <% } %>

      <div class="mx-forms-actions">
        <button
          class="mx-forms-btn mx-forms-btn--primary"
          type="submit"
          data-mx-forms-submit="1"
        >Submit</button>
      </div>
      <p class="mx-forms-submitting-hint" data-mx-forms-submitting-hint hidden aria-live="polite">
        Submitting… please wait.
      </p>
    </form>
    <script>
      (function () {
        var form = document.querySelector("[data-mx-forms-public]");
        if (!form) return;
        var btn = form.querySelector("[data-mx-forms-submit]");
        var hint = form.querySelector("[data-mx-forms-submitting-hint]");
        var summary = document.querySelector("[data-mx-forms-error-summary]");
        if (summary) {
          try { summary.focus(); } catch (e) {}
        }
        form.addEventListener("submit", function () {
          if (btn) {
            btn.disabled = true;
            btn.setAttribute("aria-busy", "true");
            btn.classList.add("is-submitting");
            btn.textContent = "Submitting…";
          }
          if (hint) hint.hidden = false;
        });
      })();
    </script>
  <% } %>
</div>
