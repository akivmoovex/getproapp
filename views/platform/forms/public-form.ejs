<%
  const pageTitle = form ? form.title : 'Form';
  const fields = (form && form.schemaJson && form.schemaJson.fields) || [];
  const priorAnswers = typeof answers !== 'undefined' && answers ? answers : {};
  const errs = typeof fieldErrors !== 'undefined' && fieldErrors ? fieldErrors : {};
  const idem = typeof idempotencyKey !== 'undefined' ? idempotencyKey : '';
  let activityScreen = typeof stitchScreen !== 'undefined' ? stitchScreen : 'SH08';
  if (form && form.category === 'visitor') activityScreen = 'BB08';
  if (form && form.category === 'event') activityScreen = 'BB09';
  if (form && form.category === 'ministry') activityScreen = 'BB10';
%>
<div class="mx-forms-shell" data-screen="<%= activityScreen %>" data-bb-form-category="<%= form && form.category ? form.category : '' %>">
  <% if (!form) { %>
    <div class="mx-forms-alert mx-forms-alert--danger"><%= error || 'Unavailable' %></div>
  <% } else { %>
    <div class="mx-forms-brand"><%= brand.productName %></div>
    <h1 class="mx-forms-title"><%= form.title %></h1>
    <% if (form.description) { %><p class="mx-forms-sub"><%= form.description %></p><% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mx-forms-alert mx-forms-alert--danger" role="alert"><%= error %></div>
    <% } %>

    <form class="mx-forms-panel" method="post" action="/f/<%= form.publicToken %>" style="max-width:560px;margin-top:1rem" novalidate>
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />
      <input type="hidden" name="idempotency_key" value="<%= idem %>" />
      <% if (form.accessMode === 'email_token') { %>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required value="<%= typeof email !== 'undefined' ? email : '' %>" />
        <label for="access_token">Access token</label>
        <input id="access_token" name="access_token" type="text" required value="<%= typeof accessToken !== 'undefined' ? accessToken : '' %>" />
      <% } %>
      <% fields.forEach(function (field) { %>
        <label for="f_<%= field.key %>" class="<%= errs[field.key] ? 'mx-forms-field-error-label' : '' %>">
          <%= field.label %><% if (field.required) { %> *<% } %>
        </label>
        <% if (field.type === 'textarea') { %>
          <textarea id="f_<%= field.key %>" name="<%= field.key %>" rows="3" <%= field.required ? 'required' : '' %>
            class="<%= errs[field.key] ? 'mx-forms-input-error' : '' %>"><%= priorAnswers[field.key] || '' %></textarea>
        <% } else if (field.type === 'select') { %>
          <select id="f_<%= field.key %>" name="<%= field.key %>" <%= field.required ? 'required' : '' %>
            class="<%= errs[field.key] ? 'mx-forms-input-error' : '' %>">
            <option value="">Select…</option>
            <% (field.options || []).forEach(function (opt) { %>
              <option value="<%= opt %>" <%= priorAnswers[field.key] === opt ? 'selected' : '' %>><%= opt %></option>
            <% }) %>
          </select>
        <% } else if (field.type === 'checkbox') { %>
          <input id="f_<%= field.key %>" name="<%= field.key %>" type="checkbox" value="true"
            <%= priorAnswers[field.key] ? 'checked' : '' %> />
        <% } else { %>
          <input id="f_<%= field.key %>" name="<%= field.key %>"
            type="<%= field.type === 'email' ? 'email' : field.type === 'number' ? 'number' : field.type === 'date' ? 'date' : field.type === 'phone' ? 'tel' : 'text' %>"
            <%= field.required ? 'required' : '' %>
            class="<%= errs[field.key] ? 'mx-forms-input-error' : '' %>"
            value="<%= priorAnswers[field.key] != null ? priorAnswers[field.key] : '' %>" />
        <% } %>
        <% if (errs[field.key]) { %>
          <p class="mx-forms-field-hint">Check this field.</p>
        <% } %>
      <% }) %>

      <% if (form.requireConsent !== false) { %>
        <label style="margin-top:1rem;font-weight:500">
          <input type="checkbox" name="consent" value="1" required />
          I consent to submit this information for the stated purpose (not clinical records).
        </label>
      <% } %>

      <div class="mx-forms-actions">
        <button class="mx-forms-btn mx-forms-btn--primary" type="submit">Submit</button>
      </div>
    </form>
  <% } %>
</div>
