<% const pageTitle = 'Access denied'; %>
<div
  class="mx-forms-shell"
  data-screen="SH15"
  data-stitch-desktop="SH15-D"
  data-stitch-mobile="SH15-M"
  data-stitch-desktop-id="63988d9e71c4488e8f213d76d09b164e"
  data-stitch-mobile-id="df0a248d1a824278aea48dd8db1260cc"
>
  <div class="mx-forms-panel mx-forms-empty mx-forms-denied">
    <p class="mx-forms-denied__badge" aria-label="HTTP status">
      <span class="mx-forms-denied__code">HTTP 403</span>
      <span class="mx-forms-denied__label">Unauthorized resource action</span>
    </p>
    <h1 class="mx-forms-title">Access Denied: Form or Action Unavailable</h1>
    <p class="mx-forms-sub" style="margin-left:auto;margin-right:auto">
      The requested form schema, submission payload, or administrative operation
      cannot be accessed with your current tenant credentials.
    </p>
    <p class="mx-forms-denied__reason">
      Reason: This resource either does not exist within your assigned organization,
      or your role does not possess the required permissions to view or execute this action.
    </p>
    <div class="mx-forms-denied__notice" role="note">
      <strong>Multi-tenant isolation notice.</strong>
      Details about resources outside your organization are concealed and cannot be disclosed.
    </div>
    <div class="mx-forms-actions" style="justify-content:center">
      <a class="mx-forms-btn" href="<%= adminBasePath %>">Return to Forms Dashboard</a>
    </div>
  </div>
</div>
