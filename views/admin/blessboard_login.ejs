<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
  <title>BlessBoard Admin — Sign in</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=43"/>
</head>
<body class="church-body church-body--platform-login" data-platform-shell="stitch-v42">
  <main class="church-platform-login">
    <section class="church-platform-login__card">
      <div class="church-platform-login__brand">
        <span class="church-platform-login__icon" aria-hidden="true">
          <span class="material-symbols-outlined">dashboard_customize</span>
        </span>
        <h1>BlessBoard Admin</h1>
        <p>Powered by GetPro</p>
      </div>
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="church-alert church-alert--error" role="alert"><%= error %></div>
      <% } %>
      <form method="post" action="/admin/login" class="church-platform-login__form">
        <label class="church-field">
          <span class="church-field__label">Username</span>
          <input class="church-input" id="username" name="username" type="text" autocomplete="username" required/>
        </label>
        <label class="church-field">
          <span class="church-field__label">Password</span>
          <input class="church-input" id="password" name="password" type="password" autocomplete="current-password" required/>
        </label>
        <div class="church-platform-login__actions">
          <button class="church-btn church-btn--primary church-btn--block" type="submit">Sign in</button>
          <a class="church-btn church-btn--outline church-btn--block" href="<%= typeof cancelHref !== 'undefined' && cancelHref ? cancelHref : '/' %>">Back to site</a>
        </div>
      </form>
      <p class="church-platform-login__hint">
        Church branch admins sign in at <code>yourchurch.blessboard.com/branch/login</code>.
      </p>
    </section>
  </main>
</body>
</html>
