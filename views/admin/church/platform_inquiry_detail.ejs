<%- include('../../partials/platform_admin_shell_start', { navTitle: 'Inquiry detail', activeNav: activeNav || 'church_platform_inquiries', pageTitle: 'Inquiry detail' }) %>
<% var item = inquiry; %>

        <header class="admin-dashboard__header">
          <div>
            <h1 class="admin-dashboard__title">Platform Inquiry #<%= item.id %></h1>
            <p class="admin-dashboard__subtitle muted">
              <%= inquiryTypeLabel(item.inquiry_type) %>
              · <%= inquiryStatusLabel(item.status) %>
              · Submitted <%= formatDateTime(item.created_at) %>
            </p>
          </div>
          <div class="admin-toolbar">
            <%- include('../../partials/components/button', { variant: 'default', href: returnTo, label: 'Back to inquiries' }) %>
          </div>
        </header>

        <% if (statusError) { %>
        <div class="flash flash--error" role="alert"><%= statusError %></div>
        <% } %>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Contact details</h2>
          <dl class="admin-dl">
            <dt>Name</dt><dd><%= item.full_name %></dd>
            <dt>Email</dt><dd><%= item.email || '—' %></dd>
            <dt>Phone</dt><dd><%= item.phone || '—' %></dd>
            <% if (item.whatsapp) { %>
            <dt>WhatsApp</dt><dd><%= item.whatsapp %></dd>
            <% } %>
            <dt>Consent to contact</dt><dd><%= item.consent_contact ? 'Yes' : 'No' %></dd>
          </dl>
        </section>

        <% if (item.inquiry_type === 'register_church') { %>
        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Church details</h2>
          <dl class="admin-dl">
            <dt>Church name</dt><dd><%= item.church_name || '—' %></dd>
            <dt>Branch name</dt><dd><%= item.branch_name || '—' %></dd>
            <dt>City</dt><dd><%= item.city || '—' %></dd>
            <dt>Country</dt><dd><%= item.country || '—' %></dd>
            <dt>Role in church</dt><dd><%= item.role_in_church || '—' %></dd>
            <dt>Number of branches</dt><dd><%= item.branch_count || '—' %></dd>
          </dl>
        </section>
        <% } else { %>
        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Message</h2>
          <dl class="admin-dl">
            <dt>Subject</dt><dd><%= item.subject || '—' %></dd>
          </dl>
        </section>
        <% } %>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Message body</h2>
          <p style="white-space:pre-wrap;margin:0;"><%= item.message %></p>
        </section>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Submission metadata</h2>
          <dl class="admin-dl">
            <dt>Source IP</dt><dd><%= item.source_ip || '—' %></dd>
            <dt>User agent</dt><dd style="word-break:break-word;"><%= item.user_agent || '—' %></dd>
            <dt>Last updated</dt><dd><%= formatDateTime(item.updated_at) %></dd>
          </dl>
        </section>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Update status</h2>
          <p class="muted" style="margin-top:0;">Mark when you have contacted the submitter or closed the request.</p>
          <form method="post" action="/admin/church/platform-inquiries/<%= item.id %>/status" class="admin-filter-form" style="margin-top:1rem;">
            <input type="hidden" name="_csrf" value="<%= platformAdminCsrfToken %>"/>
            <div class="input-field">
              <label class="input-field__label" for="status">Status</label>
              <select class="input-field__input" id="status" name="status">
                <% inquiryStatuses.forEach(function (s) { %>
                <option value="<%= s %>"<%= item.status === s ? ' selected' : '' %>><%= inquiryStatusLabel(s) %></option>
                <% }); %>
              </select>
            </div>
            <button type="submit" class="btn btn--primary">Save status</button>
          </form>
        </section>

<%- include('../../partials/platform_admin_shell_end') %>
