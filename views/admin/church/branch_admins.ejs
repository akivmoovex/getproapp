<%- include('../../partials/platform_admin_shell_start', { navTitle: 'Branch admins', activeNav: activeNav || 'church_platform_branches', pageTitle: 'Branch admins' }) %>
<header class="admin-dashboard__header">
          <div>
            <h1 class="admin-dashboard__title">Branch admins</h1>
            <p class="admin-dashboard__subtitle muted">
              <a href="/admin/church/branches/<%= branch.id %>"><%= branch.name %></a>
              · <%= activeAdminCount != null ? activeAdminCount : 0 %> active
            </p>
          </div>
          <div class="admin-toolbar">
            <%- include('../../partials/components/button', { variant: 'primary', href: '/admin/church/branches/' + branch.id + '/admins/new', label: 'Add branch admin' }) %>
            <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/branches/' + branch.id, label: 'Branch detail' }) %>
          </div>
        </header>

        <% if (typeof flashNotice !== 'undefined' && flashNotice) { %>
          <div class="flash flash--success" role="status"><%= flashNotice %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="flash flash--error" role="alert"><%= error %></div>
        <% } %>

        <section class="card card--mb-xl" style="padding:1rem;">
          <p class="muted" style="margin:0;">
            Branch admin login: <code>https://<%= churchPublicHost(branchHostSlug) %>/branch/login</code>
          </p>
        </section>

        <div class="card card--mb-xl">
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Role</th>
                  <th>Status</th>
                  <th>Last updated</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% if (!admins || admins.length === 0) { %>
                  <tr><td colspan="7" class="muted">No branch admins yet.</td></tr>
                <% } else { admins.forEach(function (a) { %>
                  <tr>
                    <td><%= a.full_name %></td>
                    <td><%= a.email || '—' %></td>
                    <td><%= a.phone || '—' %></td>
                    <td><%= a.role %></td>
                    <td><%- include('../../partials/admin/church_status_badge', { status: a.status }) %></td>
                    <td><%= formatDate(a.updated_at || a.created_at) %></td>
                    <td>
                      <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/branches/' + branch.id + '/admins/' + a.id, label: 'View' }) %>
                      <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/branches/' + branch.id + '/admins/' + a.id + '/edit', label: 'Edit' }) %>
                    </td>
                  </tr>
                <% }); } %>
              </tbody>
            </table>
          </div>
        </div>
<%- include('../../partials/platform_admin_shell_end') %>
