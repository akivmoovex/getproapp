<!doctype html>
<html lang="en">
  <head>
    <%- include('../../partials/brand_resolve') %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>HQ admin password resets | <%= _bn %> Admin</title>
    <link rel="stylesheet" href="<%= asset('styles') %>" />
  </head>
  <body class="admin-app<%- bodyEmbedClass %>">
    <%- include('../../partials/admin_nav', { navTitle: 'HQ admin resets', activeNav: activeNav || 'church_platform_hq_admin_resets' }) %>
    <main class="admin-main">
      <div class="container admin-main__pad">
        <header class="admin-dashboard__header">
          <div>
            <h1 class="admin-dashboard__title">HQ admin password reset requests</h1>
            <p class="admin-dashboard__subtitle muted">Review forgot-password requests from HQ administrators</p>
          </div>
          <div class="admin-toolbar">
            <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/reset-requests?request_type=hq_admin', label: 'Unified reset inbox' }) %>
            <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church', label: 'Church dashboard' }) %>
            <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/security', label: 'Church Security' }) %>
          </div>
        </header>

        <% if (typeof flashNotice !== 'undefined' && flashNotice) { %>
          <div class="flash flash--success" role="status"><%= flashNotice %></div>
        <% } %>

        <form method="get" action="/admin/church/hq-admin-password-reset-requests" class="card card--mb-xl admin-filter-form" style="padding:1rem;">
          <div class="input-field">
            <label class="input-field__label" for="status">Status</label>
            <select id="status" class="input-field__control" name="status">
              <% (passwordResetFilters || ['all']).forEach(function (f) { %>
                <option value="<%= f %>" <%= (filters.status || 'all') === f ? 'selected' : '' %>><%= f === 'all' ? 'All' : passwordResetStatusLabel(f) %></option>
              <% }); %>
            </select>
          </div>
          <div class="input-field">
            <label class="input-field__label" for="organization_id">Organization ID</label>
            <input id="organization_id" class="input-field__control" name="organization_id" type="number" min="1" value="<%= filters.organization_id || '' %>" placeholder="Optional" />
          </div>
          <%- include('../../partials/components/button', { variant: 'primary', type: 'submit', label: 'Filter' }) %>
        </form>

        <div class="card card--mb-xl">
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Submitted</th>
                  <th>Organization</th>
                  <th>Branch host</th>
                  <th>Identifier</th>
                  <th>Name / contact</th>
                  <th>Matched HQ admin</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% if (!requests || requests.length === 0) { %>
                  <tr><td colspan="8" class="muted">No password reset requests in this filter.</td></tr>
                <% } else { requests.forEach(function (r) { %>
                  <tr>
                    <td><%= formatDate(r.created_at) %></td>
                    <td><a href="/admin/church/organizations/<%= r.organization_id %>"><%= r.organization_name %></a></td>
                    <td><%= r.branch_name ? r.branch_name : '—' %></td>
                    <td><%= maskIdentifier(r.identifier_submitted) %></td>
                    <td>
                      <% if (r.full_name_submitted) { %><%= r.full_name_submitted %><br /><% } %>
                      <% if (r.phone_submitted) { %><%= r.phone_submitted %><br /><% } %>
                      <% if (r.email_submitted) { %><%= r.email_submitted %><% } %>
                      <% if (!r.full_name_submitted && !r.phone_submitted && !r.email_submitted) { %>—<% } %>
                    </td>
                    <td><%= r.hq_admin_id ? (r.hq_admin_name || 'Admin #' + r.hq_admin_id) : '—' %></td>
                    <td><%- include('../../partials/reset_request_status_badge', { status: r.status }) %></td>
                    <td>
                      <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/hq-admin-password-reset-requests/' + r.id, label: 'View' }) %>
                    </td>
                  </tr>
                <% }); } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
