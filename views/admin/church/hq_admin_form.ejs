<%- include('../../partials/platform_admin_shell_start', { navTitle: 'BlessBoard Admin', activeNav: activeNav || 'church_platform', pageTitle: 'BlessBoard Admin' }) %>
<% var _hqBase = typeof hqAdminsBasePath !== 'undefined' && hqAdminsBasePath ? hqAdminsBasePath : ('/admin/church/organizations/' + organization.id + '/hq-admins'); %>
<% var _orgDetail = typeof organizationDetailPath !== 'undefined' && organizationDetailPath ? organizationDetailPath : ('/admin/church/organizations/' + organization.id); %>
<% var _formValues = typeof form !== 'undefined' && form ? form : {}; %>
<% var _formAction = typeof formAction !== 'undefined' && formAction
  ? formAction
  : (mode === 'edit' && admin ? (_hqBase + '/' + admin.id) : _hqBase); %>
<header class="admin-dashboard__header">
          <div>
            <h1 class="admin-dashboard__title"><%= mode === 'edit' ? 'Edit HQ admin' : 'Add HQ admin' %></h1>
            <p class="admin-dashboard__subtitle muted">
              <a href="<%= _orgDetail %>"><%= organization.name %></a>
              <% if (organization.slug) { %>
                · slug <code><%= organization.slug %></code>
              <% } %>
              <% if (typeof hqLoginHostSlug !== 'undefined' && hqLoginHostSlug) { %>
                · host <code><%= hqLoginHostSlug %></code>
              <% } %>
              <% if (mode === 'edit' && admin) { %>
                · <%- include('../../partials/admin/church_status_badge', { status: admin.status }) %>
              <% } %>
            </p>
          </div>
          <div class="admin-toolbar">
            <% if (mode === 'edit' && admin) { %>
              <%- include('../../partials/components/button', { variant: 'default', href: _hqBase + '/' + admin.id, label: 'HQ admin detail' }) %>
            <% } %>
            <%- include('../../partials/components/button', { variant: 'default', href: _hqBase, label: 'All HQ admins' }) %>
          </div>
        </header>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="flash flash--error" role="alert"><%= error %></div>
        <% } %>

        <form id="hq-admin-create-form" method="post" action="<%= _formAction %>" class="card card--mb-xl" style="padding:1.25rem;" novalidate>
          <%- include('partials/csrf_field') %>
          <div class="admin-form-grid">
            <div class="input-field">
              <label class="input-field__label" for="full_name">Full name *</label>
              <input id="full_name" class="input-field__control" name="full_name" required value="<%= _formValues.full_name || '' %>" autocomplete="name" />
            </div>
            <div class="input-field">
              <label class="input-field__label" for="email">Email *</label>
              <input id="email" class="input-field__control" name="email" type="email" required value="<%= _formValues.email || '' %>" autocomplete="email" />
            </div>
            <div class="input-field">
              <label class="input-field__label" for="phone">Phone</label>
              <input id="phone" class="input-field__control" name="phone" value="<%= _formValues.phone || '' %>" autocomplete="tel" />
            </div>
            <div class="input-field">
              <label class="input-field__label" for="role">Role</label>
              <select id="role" class="input-field__control" name="role">
                <% (hqAdminRoles || ['hq_admin']).forEach(function (r) { %>
                  <option value="<%= r %>" <%= (_formValues.role || 'hq_admin') === r ? 'selected' : '' %>><%= r %></option>
                <% }); %>
              </select>
            </div>
            <% if (mode !== 'edit') { %>
            <div class="input-field">
              <label class="input-field__label" for="temporary_password">Temporary password *</label>
              <input id="temporary_password" class="input-field__control" name="temporary_password" type="password" required minlength="8" autocomplete="new-password" />
              <p class="muted" style="font-size:0.85rem;margin-top:0.25rem;">Minimum 8 characters. Share securely after creation.</p>
            </div>
            <div class="input-field">
              <label class="input-field__label" for="confirm_password">Confirm password *</label>
              <input id="confirm_password" class="input-field__control" name="confirm_password" type="password" required minlength="8" autocomplete="new-password" />
            </div>
            <% } %>
            <div class="input-field" style="grid-column:1/-1;">
              <label class="input-field__label" for="notes">Notes</label>
              <textarea id="notes" class="input-field__control" name="notes" rows="3"><%= _formValues.notes || '' %></textarea>
            </div>
          </div>

          <p class="muted" style="margin-top:0.75rem;font-size:0.9rem;">HQ admins are created by BlessBoard platform admin (not branch admin).</p>

          <div class="admin-toolbar" style="margin-top:1.5rem;">
            <button type="submit" class="c-button btn btn--primary"><%= mode === 'edit' ? 'Save changes' : 'Create HQ Admin' %></button>
            <%- include('../../partials/components/button', { variant: 'default', href: mode === 'edit' && admin ? (_hqBase + '/' + admin.id) : _hqBase, label: 'Cancel' }) %>
          </div>
        </form>
<%- include('../../partials/platform_admin_shell_end') %>
