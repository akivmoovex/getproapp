<%- include('../../partials/platform_admin_shell_start', { navTitle: 'Organization Governance', activeNav: activeNav || 'church_platform_orgs', pageTitle: 'Church organizations' }) %>
<% var _bb = typeof blessboardAdminMode !== 'undefined' && blessboardAdminMode; %>
<% var _newHref = _bb ? '/admin/churches/new' : '/admin/church/organizations/new'; %>
<% var _dashHref = _bb ? '/admin/dashboard' : '/admin/church'; %>
<% var _listAction = _bb ? '/admin/churches' : '/admin/church/organizations'; %>
<header class="church-platform-page-hero">
  <div>
    <h1 class="church-platform-page-hero__title">Organization Governance</h1>
    <p class="church-platform-page-hero__subtitle">Manage, audit, and provision church networks across BlessBoard.</p>
  </div>
  <div class="church-platform-page-hero__actions">
    <a class="church-btn church-btn--primary" href="<%= _newHref %>"><span class="material-symbols-outlined" aria-hidden="true">add</span> Create New Organization</a>
    <a class="church-btn church-btn--outline" href="<%= _dashHref %>">Dashboard</a>
  </div>
</header>

<form method="get" action="<%= _listAction %>" class="church-platform-panel church-platform-filters">
  <label class="church-field">
    <span class="church-field__label">Search</span>
    <input class="church-input" id="q" name="q" type="search" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Name, slug, country…"/>
  </label>
  <label class="church-field">
    <span class="church-field__label">Status</span>
    <select class="church-input" id="status" name="status">
      <option value="all" <%= (typeof statusFilter === 'undefined' || statusFilter === 'all') ? 'selected' : '' %>>All</option>
      <% (orgBranchStatuses || ['active','suspended','archived']).forEach(function (s) { %>
        <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
      <% }); %>
    </select>
  </label>
  <button class="church-btn church-btn--outline" type="submit">Filters</button>
</form>

<section class="church-platform-panel">
  <div class="church-platform-table-wrap">
    <table class="church-platform-table">
      <thead>
        <tr>
          <th>Organization</th>
          <th>Country</th>
          <th>HQ contact</th>
          <th>Branches</th>
          <th>Plan</th>
          <th>Status</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!organizations || organizations.length === 0) { %>
          <tr><td colspan="8" class="church-platform-empty">No organizations found.</td></tr>
        <% } else { organizations.forEach(function (org) { %>
          <tr>
            <td>
              <div class="church-platform-org-cell">
                <span class="church-platform-org-icon" aria-hidden="true"><span class="material-symbols-outlined">church</span></span>
                <div>
                  <strong><%= org.name %></strong>
                  <span class="church-platform-meta">ID: <%= org.slug %></span>
                </div>
              </div>
            </td>
            <td><%= org.country || '—' %></td>
            <td>
              <% if (org.primary_contact_name || org.primary_contact_email) { %>
                <%= org.primary_contact_name || '—' %><% if (org.primary_contact_email) { %><br /><span class="church-platform-meta"><%= org.primary_contact_email %></span><% } %>
              <% } else { %>—<% } %>
            </td>
            <td><span class="church-platform-chip"><%= org.branch_count || 0 %> units</span></td>
            <td><span class="church-platform-chip church-platform-chip--plan"><%= getPlanDisplay(org.plan_code || 'free').label %></span></td>
            <td><%- include('../../partials/admin/church_status_badge', { status: org.status }) %></td>
            <td><%= formatDate(org.created_at) %></td>
            <td>
              <% var _viewHref = _bb ? '/admin/churches/' + org.id : '/admin/church/organizations/' + org.id; %>
              <% var _editHref = _bb ? '/admin/churches/' + org.id + '/edit' : '/admin/church/organizations/' + org.id + '/edit'; %>
              <a class="church-btn church-btn--ghost church-btn--sm" href="<%= _viewHref %>">View</a>
              <a class="church-btn church-btn--ghost church-btn--sm" href="<%= _editHref %>">Edit</a>
              <a class="church-btn church-btn--ghost church-btn--sm" href="/admin/church/organizations/<%= org.id %>/plan">Plan</a>
            </td>
          </tr>
        <% }); } %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../../partials/platform_admin_shell_end') %>
