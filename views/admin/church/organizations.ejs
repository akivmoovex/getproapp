<!doctype html>
<html lang="en">
  <head>
    <%- include('../../partials/brand_resolve') %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Church organizations | <%= _bn %> Admin</title>
    <link rel="stylesheet" href="<%= asset('styles') %>" />
  </head>
  <body class="admin-app<%- bodyEmbedClass %>">
    <%- include('../../partials/admin_nav', { navTitle: 'Church organizations', activeNav: activeNav || 'church_platform_orgs' }) %>
    <main class="admin-main">
      <div class="container admin-main__pad">
        <header class="admin-dashboard__header">
          <div>
            <h1 class="admin-dashboard__title">Church organizations</h1>
            <p class="admin-dashboard__subtitle muted">Registry of provisioned church organizations on GetPro Church.</p>
          </div>
          <div class="admin-toolbar">
            <%- include('../../partials/components/button', { variant: 'primary', href: '/admin/church/organizations/new', label: 'Create organization' }) %>
            <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church', label: 'Church dashboard' }) %>
          </div>
        </header>

        <form method="get" action="/admin/church/organizations" class="admin-filter-form card card--mb-xl" style="padding:1rem;">
          <div class="input-field">
            <label class="input-field__label" for="q">Search</label>
            <input id="q" class="input-field__control" name="q" type="search" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Name, slug, country…" />
          </div>
          <div class="input-field">
            <label class="input-field__label" for="status">Status</label>
            <select id="status" class="input-field__control" name="status">
              <option value="all" <%= (typeof statusFilter === 'undefined' || statusFilter === 'all') ? 'selected' : '' %>>All</option>
              <% (orgBranchStatuses || ['active','suspended','archived']).forEach(function (s) { %>
                <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
              <% }); %>
            </select>
          </div>
          <%- include('../../partials/components/button', { variant: 'default', type: 'submit', label: 'Search' }) %>
        </form>

        <div class="card card--mb-xl">
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Organization</th>
                  <th>Slug</th>
                  <th>Location</th>
                  <th>Primary contact</th>
                  <th>Plan</th>
                  <th>Branches</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% if (!organizations || organizations.length === 0) { %>
                  <tr><td colspan="9" class="muted">No organizations found.</td></tr>
                <% } else { organizations.forEach(function (org) { %>
                  <tr>
                    <td><%= org.name %></td>
                    <td class="muted"><%= org.slug %></td>
                    <td><%= [org.city, org.country].filter(Boolean).join(', ') || '—' %></td>
                    <td>
                      <% if (org.primary_contact_name || org.primary_contact_email) { %>
                        <%= org.primary_contact_name || '—' %><% if (org.primary_contact_email) { %><br /><span class="muted"><%= org.primary_contact_email %></span><% } %>
                      <% } else { %>
                        —
                      <% } %>
                    </td>
                    <td><%= getPlanDisplay(org.plan_code || 'free').label %></td>
                    <td><%= org.branch_count || 0 %></td>
                    <td><%- include('../../partials/admin/church_status_badge', { status: org.status }) %></td>
                    <td><%= formatDate(org.created_at) %></td>
                    <td>
                      <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/organizations/' + org.id, label: 'View' }) %>
                      <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/organizations/' + org.id + '/edit', label: 'Edit' }) %>
                      <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/organizations/' + org.id + '/plan', label: 'Plan' }) %>
                    </td>
                  </tr>
                <% }); } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
