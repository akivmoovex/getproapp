<%- include('../../partials/platform_admin_shell_start', { navTitle: 'BlessBoard Admin', activeNav: activeNav || 'church_platform', pageTitle: 'BlessBoard Admin' }) %>
<% var _hqBase = typeof hqAdminsBasePath !== 'undefined' && hqAdminsBasePath ? hqAdminsBasePath : ('/admin/church/organizations/' + organization.id + '/hq-admins'); %>
<% var _orgDetail = typeof organizationDetailPath !== 'undefined' && organizationDetailPath ? organizationDetailPath : ('/admin/church/organizations/' + organization.id); %>
<header class="admin-dashboard__header">
          <div>
            <h1 class="admin-dashboard__title"><%= admin.full_name %></h1>
            <p class="admin-dashboard__subtitle muted">
              <a href="<%= _orgDetail %>"><%= organization.name %></a>
              · <%- include('../../partials/admin/church_status_badge', { status: admin.status }) %>
            </p>
          </div>
          <div class="admin-toolbar">
            <%- include('../../partials/components/button', { variant: 'primary', href: _hqBase + '/' + admin.id + '/edit', label: 'Edit' }) %>
            <%- include('../../partials/components/button', { variant: 'default', href: _hqBase, label: 'All HQ admins' }) %>
          </div>
        </header>

        <% if (typeof flashNotice !== 'undefined' && flashNotice) { %>
          <div class="flash flash--success" role="status"><%= flashNotice %></div>
        <% } %>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Account</h2>
          <dl class="admin-dl">
            <dt>Full name</dt><dd><%= admin.full_name %></dd>
            <dt>Email</dt><dd><%= admin.email || '—' %></dd>
            <dt>Phone</dt><dd><%= admin.phone || '—' %></dd>
            <dt>Role</dt><dd><%= admin.role %></dd>
            <dt>Status</dt><dd><%- include('../../partials/admin/church_status_badge', { status: admin.status }) %></dd>
            <dt>Notes</dt><dd><%= admin.notes || '—' %></dd>
            <dt>Organization</dt><dd><a href="<%= _orgDetail %>"><%= organization.name %></a></dd>
            <% if (hqLoginHostSlug) { %>
              <dt>Example HQ login URL</dt><dd><code>https://<%= churchPublicHost(hqLoginHostSlug) %>/hq/login</code></dd>
            <% } else { %>
              <dt>Example HQ login URL</dt><dd class="muted">No branch host available — add a branch first.</dd>
            <% } %>
            <dt>Created</dt><dd><%= formatDate(admin.created_at) %></dd>
            <dt>Last updated</dt><dd><%= formatDate(admin.updated_at) %></dd>
            <% if (admin.last_password_reset_at) { %>
              <dt>Last password reset</dt><dd><%= formatDate(admin.last_password_reset_at) %></dd>
            <% } %>
            <%- include('./partials/login_protection_summary', { loginProtection: typeof loginProtection !== 'undefined' ? loginProtection : null, formatDate: formatDate }) %>
          </dl>
        </section>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Status actions</h2>
          <div class="admin-toolbar">
            <% if (admin.status === 'active') { %>
              <%- include('../../partials/components/button', { variant: 'default', href: _hqBase + '/' + admin.id + '/deactivate', label: 'Deactivate…' }) %>
            <% } else { %>
              <form method="post" action="<%= _hqBase %>/<%= admin.id %>/activate">
                <%- include('partials/csrf_field') %>
                <%- include('../../partials/components/button', { variant: 'primary', type: 'submit', label: 'Activate' }) %>
              </form>
            <% } %>
          </div>
        </section>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Reset password</h2>
          <% if (typeof resetError !== 'undefined' && resetError) { %>
            <div class="flash flash--error" role="alert"><%= resetError %></div>
          <% } %>
          <form method="post" action="<%= _hqBase %>/<%= admin.id %>/reset-password">
            <%- include('partials/csrf_field') %>
            <div class="admin-form-grid">
              <div class="input-field">
                <label class="input-field__label" for="new_password">New password *</label>
                <input id="new_password" class="input-field__control" name="new_password" type="password" required minlength="8" autocomplete="new-password" />
              </div>
              <div class="input-field">
                <label class="input-field__label" for="confirm_password">Confirm password *</label>
                <input id="confirm_password" class="input-field__control" name="confirm_password" type="password" required minlength="8" autocomplete="new-password" />
              </div>
            </div>
            <p class="muted" style="margin-top:0.75rem;font-size:0.9rem;">Password is hashed and never displayed after save.</p>
            <div class="admin-toolbar" style="margin-top:1rem;">
              <%- include('../../partials/components/button', { variant: 'primary', type: 'submit', label: 'Save reset' }) %>
            </div>
          </form>
        </section>

        <%- include('partials/support_notes_panel', {
          supportNotes: typeof supportNotes !== 'undefined' ? supportNotes : [],
          supportNoteEntityType: typeof supportNoteEntityType !== 'undefined' ? supportNoteEntityType : 'hq_admin',
          supportNoteEntityId: typeof supportNoteEntityId !== 'undefined' ? supportNoteEntityId : admin.id,
          supportNoteReturnTo: typeof supportNoteReturnTo !== 'undefined' ? supportNoteReturnTo : (_hqBase + '/' + admin.id),
          supportNoteNotice: typeof supportNoteNotice !== 'undefined' ? supportNoteNotice : null,
          supportNoteError: typeof supportNoteError !== 'undefined' ? supportNoteError : null,
          formatDate: formatDate
        }) %>
<%- include('../../partials/platform_admin_shell_end') %>
