<!doctype html>
<html lang="en">
  <head>
    <%- include('../../partials/brand_resolve') %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Member reset request #<%= requestItem.id %> | <%= _bn %> Admin</title>
    <link rel="stylesheet" href="<%= asset('styles') %>" />
  </head>
  <body class="admin-app<%- bodyEmbedClass %>">
    <%- include('../../partials/admin_nav', { navTitle: 'Member reset detail', activeNav: activeNav || 'church_platform_reset_requests' }) %>
    <main class="admin-main">
      <div class="container admin-main__pad">
        <% var host = requestItem.branch_host_slug; %>

        <header class="admin-dashboard__header">
          <div>
            <h1 class="admin-dashboard__title">Member Password Reset Request</h1>
            <p class="admin-dashboard__subtitle muted">
              Request #<%= requestItem.id %>
              · <%- include('../../partials/reset_request_status_badge', { status: requestItem.status }) %>
              · Submitted <%= formatDateTime(requestItem.created_at) %>
            </p>
            <p class="admin-dashboard__subtitle muted">
              <a href="/admin/church/organizations/<%= requestItem.organization_id %>"><%= requestItem.organization_name %></a>
              · <a href="/admin/church/branches/<%= requestItem.branch_id %>"><%= requestItem.branch_name %></a>
            </p>
            <p class="muted" style="margin-top:0.5rem;">Member password reset requests are handled by branch admins. This platform view is read-only.</p>
          </div>
          <div class="admin-toolbar">
            <%- include('../../partials/components/button', { variant: 'default', href: returnTo, label: 'Back to reset inbox' }) %>
          </div>
        </header>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Submitted details</h2>
          <dl class="admin-dl">
            <dt>Identifier</dt><dd><%= requestItem.identifier_submitted_masked %></dd>
            <dt>Full name</dt><dd><%= requestItem.full_name_submitted || '—' %></dd>
            <dt>Phone</dt><dd><%= requestItem.phone_submitted_masked || '—' %></dd>
            <dt>Email</dt><dd><%= requestItem.email_submitted_masked || '—' %></dd>
            <dt>Created</dt><dd><%= formatDateTime(requestItem.created_at) %></dd>
          </dl>
        </section>

        <% if (requestItem.member_id) { %>
        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Matched member</h2>
          <dl class="admin-dl">
            <dt>Name</dt><dd><%= requestItem.member_name %></dd>
            <dt>Status</dt><dd><%- include('../../partials/admin/church_status_badge', { status: requestItem.member_status }) %></dd>
            <dt>Email</dt><dd><%= requestItem.member_email_masked || '—' %></dd>
            <dt>Phone</dt><dd><%= requestItem.member_phone_masked || '—' %></dd>
          </dl>
          <p style="margin-top:1rem;">
            <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/members/' + requestItem.member_id + '?return_to=' + encodeURIComponent('/admin/church/member-password-reset-requests/' + requestItem.id), label: 'View member support detail' }) %>
          </p>
        </section>
        <% } else { %>
        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">No matched member</h2>
          <p class="flash flash--error" style="display:inline-block;padding:0.5rem 0.75rem;margin:0;">No matching member account was found. Do not disclose this publicly.</p>
        </section>
        <% } %>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Branch handling status</h2>
          <dl class="admin-dl">
            <dt>Status</dt><dd><%- include('../../partials/reset_request_status_badge', { status: requestItem.status }) %></dd>
            <% if (requestItem.review_comment) { %>
              <dt>Review comment</dt><dd><%= requestItem.review_comment %></dd>
            <% } %>
            <% if (requestItem.resolved_by_name) { %>
              <dt>Resolved by branch admin</dt><dd><%= requestItem.resolved_by_name %></dd>
            <% } %>
            <dt>Resolved at</dt><dd><%= requestItem.resolved_at ? formatDateTime(requestItem.resolved_at) : '—' %></dd>
            <dt>Last updated</dt><dd><%= formatDateTime(requestItem.updated_at) %></dd>
          </dl>
        </section>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <%- include('../../partials/reset_request_timeline', { resetTimeline: resetTimeline, resetTimelineError: resetTimelineError, formatDateTime: formatDateTime }) %>
        </section>

        <% var recent = typeof recentForMember !== 'undefined' && recentForMember ? recentForMember : []; %>
        <% if (recent.length > 0) { %>
        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Other reset requests for this member</h2>
          <ul class="admin-list">
            <% recent.forEach(function (row) { %>
              <li>
                <a href="/admin/church/member-password-reset-requests/<%= row.id %>">Request #<%= row.id %></a>
                · <%- include('../../partials/reset_request_status_badge', { status: row.status }) %>
                · <%= formatDateTime(row.created_at) %>
              </li>
            <% }); %>
          </ul>
        </section>
        <% } %>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Related links</h2>
          <div class="admin-toolbar" style="flex-wrap:wrap;">
            <% if (requestItem.member_id) { %>
              <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/members/' + requestItem.member_id, label: 'View member support detail' }) %>
            <% } %>
            <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/branches/' + requestItem.branch_id, label: 'View branch detail' }) %>
            <%- include('../../partials/components/button', { variant: 'default', href: 'https://' + churchPublicHost(host) + '/', label: 'Open branch public site', extraAttrs: 'target="_blank" rel="noopener noreferrer"' }) %>
          </div>
          <p class="muted" style="margin-top:1rem;font-size:0.9rem;">
            Branch admin queue path (branch portal, separate session):
            <code><%= requestItem.branch_admin_queue_path %></code>
          </p>
        </section>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Security and privacy</h2>
          <ul class="admin-list muted">
            <li>Do not reveal whether an account exists to the requester unless branch policy permits.</li>
            <li>Temporary passwords are handled by branch admins.</li>
            <li>This page is read-only. Platform admins cannot complete member password resets here.</li>
          </ul>
        </section>
      </div>
    </main>
  </body>
</html>
