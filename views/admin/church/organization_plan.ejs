<%- include('../../partials/platform_admin_shell_start', { navTitle: 'Organization plan', activeNav: activeNav || 'church_platform_orgs', pageTitle: 'Organization plan' }) %>
<header class="admin-dashboard__header">
          <div>
            <h1 class="admin-dashboard__title"><%= planSummary.organization.name %> — Plan</h1>
            <p class="admin-dashboard__subtitle muted">Manage church organization plan metadata (no billing).</p>
          </div>
          <div class="admin-toolbar">
            <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/organizations/' + planSummary.organization.id, label: 'Organization detail' }) %>
          </div>
        </header>

        <% if (saved) { %>
          <div class="flash flash--info" role="status">Plan updated successfully.</div>
        <% } %>
        <% if (error) { %>
          <div class="flash" role="alert"><%= error %></div>
        <% } %>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Current plan</h2>
          <dl class="admin-dl">
            <dt>Plan</dt><dd><strong><%= planSummary.planDisplay.label %></strong> (<%= planSummary.planCode %>)</dd>
            <dt>Status</dt><dd><%= planSummary.planStatus %></dd>
            <dt>Started</dt><dd><%= planSummary.planStartedAt ? formatDate(planSummary.planStartedAt) : '—' %></dd>
            <dt>Notes</dt><dd><%= planSummary.planNotes || '—' %></dd>
          </dl>
        </section>

        <% if (typeof packageDiagnostic !== 'undefined' && packageDiagnostic) { %>
        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Package entitlement diagnostic</h2>
          <p class="muted" style="margin-top:0;">Read-only resolution from the BlessBoard package catalogue plus usage meters.</p>
          <dl class="admin-dl">
            <dt>Organisation</dt>
            <dd><%= packageDiagnostic.organization.name %> (id <%= packageDiagnostic.organization.id %>, <%= packageDiagnostic.organization.slug %>)</dd>
            <dt>Current package</dt>
            <dd><strong><%= packageDiagnostic.currentPackage.label %></strong> (<%= packageDiagnostic.currentPackage.code %>)</dd>
            <dt>Stored plan_code</dt>
            <dd><%= packageDiagnostic.storedPlanCode == null || packageDiagnostic.storedPlanCode === '' ? '—' : packageDiagnostic.storedPlanCode %></dd>
            <dt>Entitlement source</dt>
            <dd><%= packageDiagnostic.entitlementSource %></dd>
            <dt>Fallback status</dt>
            <dd>
              <% if (packageDiagnostic.fallback.used) { %>
                Used — <%= packageDiagnostic.fallback.reason || 'Defaulted to Foundation.' %>
              <% } else { %>
                Not used
              <% } %>
            </dd>
          </dl>
        </section>
        <% } %>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Usage summary</h2>
          <div class="admin-dashboard__grid">
            <div class="admin-stat">
              <p class="admin-stat__label">Branches</p>
              <p class="admin-stat__value"><%= planSummary.branchesDisplay %></p>
            </div>
            <div class="admin-stat">
              <p class="admin-stat__label">Verified members</p>
              <p class="admin-stat__value"><%= planSummary.membersDisplay %></p>
            </div>
          </div>
          <% if ((planSummary.warnings || []).length > 0) { %>
            <ul style="margin-top:1rem;">
              <% planSummary.warnings.forEach(function (w) { %>
                <li class="<%= w.level === 'limit' ? 'flash' : 'muted' %>"><%= w.message %></li>
              <% }); %>
            </ul>
          <% } %>
        </section>

        <% if (typeof packageDiagnostic !== 'undefined' && packageDiagnostic && packageDiagnostic.usage) { %>
        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Package usage diagnostic</h2>
          <p class="muted" style="margin-top:0;">
            Tenant-scoped meters for <%= packageDiagnostic.usage.packageLabel %>
            · month <code><%= String(packageDiagnostic.usage.usageMonth).slice(0, 7) %></code>
            (<%= packageDiagnostic.usage.timezone || 'UTC' %>).
            No invoice totals.
          </p>
          <dl class="admin-dl">
            <dt>Active branches</dt><dd><%= packageDiagnostic.usage.meters.branches.display %></dd>
            <dt>Active members</dt><dd><%= packageDiagnostic.usage.meters.members.display %></dd>
            <dt>Administrators / leadership</dt><dd><%= packageDiagnostic.usage.meters.admins.display %></dd>
            <dt>Storage</dt><dd><%= packageDiagnostic.usage.meters.storage.display %></dd>
            <dt>External emails (month)</dt><dd><%= packageDiagnostic.usage.meters.externalEmails.display %></dd>
            <dt>Scheduled reports (month)</dt><dd><%= packageDiagnostic.usage.meters.scheduledReports.display %></dd>
            <dt>Warning state</dt>
            <dd><%= (packageDiagnostic.usage.warnings || []).length ? (packageDiagnostic.usage.warnings.map(function (w) { return w.message; }).join('; ')) : 'None' %></dd>
            <dt>Blocked state</dt>
            <dd><%= (packageDiagnostic.usage.blocked || []).length ? (packageDiagnostic.usage.blocked.map(function (b) { return b.message; }).join('; ')) : 'None' %></dd>
            <dt>Available upgrade</dt>
            <dd><%= packageDiagnostic.usage.availableUpgrade ? (packageDiagnostic.usage.availableUpgrade.packageLabel + ' — ' + packageDiagnostic.usage.availableUpgrade.reason) : '—' %></dd>
          </dl>
        </section>
        <% } %>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Features</h2>
          <div class="table-wrap">
            <table class="table">
              <thead><tr><th>Feature</th><th>Status</th></tr></thead>
              <tbody>
                <% planSummary.featureRows.forEach(function (row) { %>
                  <tr>
                    <td><%= row.label %></td>
                    <td>
                      <% if (row.locked) { %>
                        <span class="muted">Locked</span>
                      <% } else if (row.enabled) { %>
                        Enabled
                      <% } else { %>
                        Disabled
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Change plan</h2>
          <form method="post" action="/admin/church/organizations/<%= planSummary.organization.id %>/plan" class="admin-form-grid">
            <%- include('partials/csrf_field') %>
            <div class="input-field">
              <label class="input-field__label" for="plan_code">Plan</label>
              <select id="plan_code" class="input-field__control" name="plan_code">
                <% planCodes.forEach(function (code) { %>
                  <option value="<%= code %>" <%= form.plan_code === code ? 'selected' : '' %>><%= (typeof getPlanDisplay === 'function' ? getPlanDisplay(code).label : code) %> (<%= code %>)</option>
                <% }); %>
              </select>
            </div>
            <div class="input-field">
              <label class="input-field__label" for="plan_status">Plan status</label>
              <select id="plan_status" class="input-field__control" name="plan_status">
                <option value="active" <%= form.plan_status === 'active' ? 'selected' : '' %>>active</option>
                <option value="inactive" <%= form.plan_status === 'inactive' ? 'selected' : '' %>>inactive</option>
              </select>
            </div>
            <div class="input-field" style="grid-column:1/-1;">
              <label class="input-field__label" for="plan_notes">Plan notes</label>
              <textarea id="plan_notes" class="input-field__control" name="plan_notes" rows="3"><%= form.plan_notes || '' %></textarea>
            </div>
            <div class="admin-toolbar" style="grid-column:1/-1;">
              <%- include('../../partials/components/button', { variant: 'primary', type: 'submit', label: 'Save plan' }) %>
            </div>
          </form>
        </section>
<%- include('../../partials/platform_admin_shell_end') %>
