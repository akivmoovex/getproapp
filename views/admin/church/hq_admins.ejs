<%- include('../../partials/platform_admin_shell_start', { navTitle: 'HQ admins', activeNav: activeNav || 'church_platform_orgs', pageTitle: 'HQ admins' }) %>
<% var _hqBase = typeof hqAdminsBasePath !== 'undefined' && hqAdminsBasePath ? hqAdminsBasePath : ('/admin/church/organizations/' + organization.id + '/hq-admins'); %>
<% var _orgDetail = typeof organizationDetailPath !== 'undefined' && organizationDetailPath ? organizationDetailPath : ('/admin/church/organizations/' + organization.id); %>
<header class="admin-dashboard__header">
          <div>
            <h1 class="admin-dashboard__title">HQ admins</h1>
            <p class="admin-dashboard__subtitle muted">
              <a href="<%= _orgDetail %>"><%= organization.name %></a>
              · <%= activeHqAdminCount != null ? activeHqAdminCount : 0 %> active
            </p>
          </div>
          <div class="admin-toolbar">
            <%- include('../../partials/components/button', { variant: 'primary', href: _hqBase + '/new', label: 'Add HQ admin' }) %>
            <%- include('../../partials/components/button', { variant: 'default', href: _orgDetail, label: 'Organization detail' }) %>
          </div>
        </header>

        <% if (typeof flashNotice !== 'undefined' && flashNotice) { %>
          <div class="flash flash--success" role="status"><%= flashNotice %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="flash flash--error" role="alert"><%= error %></div>
        <% } %>

        <% if (hqLoginHostSlug) { %>
        <section class="card card--mb-xl" style="padding:1rem;">
          <p class="muted" style="margin:0;">
            Example HQ login: <code>https://<%= churchPublicHost(hqLoginHostSlug) %>/hq/login</code>
          </p>
        </section>
        <% } else { %>
        <section class="card card--mb-xl" style="padding:1rem;">
          <p class="muted" style="margin:0;">Add a branch to this organization before HQ admins can log in on a branch host.</p>
        </section>
        <% } %>

        <div class="card card--mb-xl">
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Role</th>
                  <th>Status</th>
                  <th>Last updated</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% if (!admins || admins.length === 0) { %>
                  <tr><td colspan="7" class="muted">No HQ admins yet.</td></tr>
                <% } else { admins.forEach(function (a) { %>
                  <tr>
                    <td><%= a.full_name %></td>
                    <td><%= a.email || '—' %></td>
                    <td><%= a.phone || '—' %></td>
                    <td><%= a.role %></td>
                    <td><%- include('../../partials/admin/church_status_badge', { status: a.status }) %></td>
                    <td><%= formatDate(a.updated_at || a.created_at) %></td>
                    <td>
                      <%- include('../../partials/components/button', { variant: 'default', href: _hqBase + '/' + a.id, label: 'View' }) %>
                      <%- include('../../partials/components/button', { variant: 'default', href: _hqBase + '/' + a.id + '/edit', label: 'Edit' }) %>
                    </td>
                  </tr>
                <% }); } %>
              </tbody>
            </table>
          </div>
        </div>
<%- include('../../partials/platform_admin_shell_end') %>
