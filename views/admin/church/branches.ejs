<%- include('../../partials/platform_admin_shell_start', { navTitle: 'Church branches', activeNav: activeNav || 'church_platform_branches', pageTitle: 'Church branches' }) %>
<header class="admin-dashboard__header">
          <div>
            <h1 class="admin-dashboard__title">Church branches</h1>
            <p class="admin-dashboard__subtitle muted">All provisioned branches across organizations.</p>
          </div>
          <div class="admin-toolbar">
            <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church', label: 'Church dashboard' }) %>
          </div>
        </header>

        <form method="get" action="/admin/church/branches" class="admin-filter-form card card--mb-xl" style="padding:1rem;">
          <div class="input-field">
            <label class="input-field__label" for="q">Search</label>
            <input id="q" class="input-field__control" name="q" type="search" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Branch, org slug, city…" />
          </div>
          <div class="input-field">
            <label class="input-field__label" for="status">Status</label>
            <select id="status" class="input-field__control" name="status">
              <option value="all" <%= (typeof statusFilter === 'undefined' || statusFilter === 'all') ? 'selected' : '' %>>All</option>
              <% (orgBranchStatuses || ['active','suspended','archived']).forEach(function (s) { %>
                <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
              <% }); %>
            </select>
          </div>
          <%- include('../../partials/components/button', { variant: 'default', type: 'submit', label: 'Search' }) %>
        </form>

        <div class="card card--mb-xl">
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Branch</th>
                  <th>Organization</th>
                  <th>Host slug</th>
                  <th>Public URL</th>
                  <th>Location</th>
                  <th>Pastor / contact</th>
                  <th>Branch admin</th>
                  <th>Members</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (!branches || branches.length === 0) { %>
                  <tr><td colspan="11" class="muted">No branches found.</td></tr>
                <% } else { branches.forEach(function (b) { %>
                  <% var host = churchPublicHost(b.branch_host_slug || b.host_slug || b.slug); %>
                  <tr>
                    <td><%= b.name %></td>
                    <td><%= b.organization_name %></td>
                    <td class="muted"><%= b.branch_host_slug || b.host_slug || b.slug %></td>
                    <td><code><%= host %></code></td>
                    <td><%= [b.city, b.country].filter(Boolean).join(', ') || '—' %></td>
                    <td>
                      <%= b.pastor_name || '—' %>
                      <% if (b.contact_phone || b.contact_email) { %>
                        <br /><span class="muted"><%= [b.contact_phone, b.contact_email].filter(Boolean).join(' · ') %></span>
                      <% } %>
                    </td>
                    <td><%= b.branch_admin_name || '—' %></td>
                    <td><%= b.verified_member_count != null ? b.verified_member_count : 0 %></td>
                    <td><%- include('../../partials/admin/church_status_badge', { status: b.status }) %></td>
                    <td><%= formatDate(b.created_at) %></td>
                    <td>
                      <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/branches/' + b.id, label: 'View' }) %>
                      <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/branches/' + b.id + '/edit', label: 'Edit' }) %>
                    </td>
                  </tr>
                <% }); } %>
              </tbody>
            </table>
          </div>
        </div>
<%- include('../../partials/platform_admin_shell_end') %>
