<%- include('../../partials/platform_admin_shell_start', { navTitle: 'Deactivate HQ admin', activeNav: activeNav || 'church_platform_orgs', pageTitle: 'Confirm HQ admin deactivation' }) %>
<% var _hqBase = typeof hqAdminsBasePath !== 'undefined' && hqAdminsBasePath ? hqAdminsBasePath : ('/admin/church/organizations/' + organization.id + '/hq-admins'); %>
<% var _orgDetail = typeof organizationDetailPath !== 'undefined' && organizationDetailPath ? organizationDetailPath : ('/admin/church/organizations/' + organization.id); %>
        <header class="admin-dashboard__header">
          <div>
            <h1 class="admin-dashboard__title">Confirm HQ admin deactivation</h1>
            <p class="admin-dashboard__subtitle muted"><%= admin.full_name %> · <%= organization.name %></p>
          </div>
          <div class="admin-toolbar">
            <%- include('../../partials/components/button', { variant: 'default', href: _hqBase + '/' + admin.id, label: 'Cancel' }) %>
          </div>
        </header>

        <% if (typeof statusError !== 'undefined' && statusError) { %>
          <div class="flash flash--error" role="alert"><%= statusError %></div>
        <% } %>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Administrator</h2>
          <dl class="admin-dl">
            <dt>Name</dt><dd style="overflow-wrap:anywhere;"><%= admin.full_name %></dd>
            <dt>Email</dt><dd style="overflow-wrap:anywhere;"><%= admin.email || '—' %></dd>
            <dt>Current status</dt><dd><%- include('../../partials/admin/church_status_badge', { status: admin.status }) %></dd>
            <dt>Organization</dt><dd><a href="<%= _orgDetail %>"><%= organization.name %></a></dd>
            <dt>Active HQ admins</dt><dd><%= typeof activeHqAdminCount !== 'undefined' ? activeHqAdminCount : '—' %></dd>
          </dl>
          <ul class="admin-list" style="margin-top:1rem;">
            <li>Deactivation sets status to inactive (existing account model).</li>
            <li>Login is rejected while inactive.</li>
            <li>Existing sessions are cleared on the next protected HQ request (not immediately revoked server-wide).</li>
            <li>An audit event is recorded with previous status, new status, and reason.</li>
          </ul>
          <% if (typeof isLastActiveHqAdmin !== 'undefined' && isLastActiveHqAdmin) { %>
            <div class="flash flash--error" role="alert" style="margin-top:1rem;">This is the last active HQ administrator. Deactivation is blocked.</div>
          <% } %>
        </section>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <% if (typeof isLastActiveHqAdmin !== 'undefined' && isLastActiveHqAdmin) { %>
            <%- include('../../partials/components/button', { variant: 'default', href: _hqBase + '/' + admin.id, label: 'Back' }) %>
          <% } else { %>
            <form method="post" action="<%= _hqBase %>/<%= admin.id %>/deactivate">
              <%- include('partials/csrf_field') %>
              <label class="input-field__label" for="deactivate_reason">Reason (required)</label>
              <textarea id="deactivate_reason" name="status_reason" required minlength="3" maxlength="2000" placeholder="Why is this HQ admin being deactivated?"><%= typeof formReason !== 'undefined' ? formReason : '' %></textarea>
              <div class="admin-toolbar" style="margin-top:1rem;">
                <%- include('../../partials/components/button', { variant: 'default', type: 'submit', label: 'Confirm deactivate' }) %>
                <%- include('../../partials/components/button', { variant: 'default', href: _hqBase + '/' + admin.id, label: 'Cancel' }) %>
              </div>
            </form>
          <% } %>
        </section>
<%- include('../../partials/platform_admin_shell_end') %>
