<%- include('../../partials/platform_admin_shell_start', { navTitle: 'Branch admin reset detail', activeNav: activeNav || 'church_platform_branch_admin_resets', pageTitle: 'Branch admin reset detail' }) %>
<header class="admin-dashboard__header">
          <div>
            <h1 class="admin-dashboard__title">Password reset request #<%= requestItem.id %></h1>
            <p class="admin-dashboard__subtitle muted">
              <a href="/admin/church/organizations/<%= requestItem.organization_id %>"><%= requestItem.organization_name %></a>
              · <a href="/admin/church/branches/<%= requestItem.branch_id %>"><%= requestItem.branch_name %></a>
              · <%- include('../../partials/reset_request_status_badge', { status: requestItem.status }) %>
            </p>
            <p class="muted">Submitted <%= formatDateTime(requestItem.created_at) %></p>
          </div>
          <div class="admin-toolbar">
            <%- include('../../partials/components/button', { variant: 'default', href: returnTo, label: 'Back to reset inbox' }) %>
          </div>
        </header>

        <% if (typeof flashNotice !== 'undefined' && flashNotice) { %>
          <div class="flash flash--success" role="status"><%= flashNotice %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="flash flash--error" role="alert"><%= error %></div>
        <% } %>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Submitted details</h2>
          <dl class="admin-dl">
            <dt>Identifier</dt><dd><%= maskIdentifier(requestItem.identifier_submitted) %></dd>
            <dt>Full name</dt><dd><%= requestItem.full_name_submitted || '—' %></dd>
            <dt>Phone</dt><dd><%= requestItem.phone_submitted || '—' %></dd>
            <dt>Email</dt><dd><%= requestItem.email_submitted || '—' %></dd>
            <dt>Organization</dt>
            <dd><a href="/admin/church/organizations/<%= requestItem.organization_id %>"><%= requestItem.organization_name %></a> · <%- include('../../partials/admin/church_status_badge', { status: requestItem.organization_status }) %></dd>
            <dt>Branch</dt>
            <dd><a href="/admin/church/branches/<%= requestItem.branch_id %>"><%= requestItem.branch_name %></a> · <%- include('../../partials/admin/church_status_badge', { status: requestItem.branch_status }) %></dd>
            <dt>Last updated</dt><dd><%= formatDateTime(requestItem.updated_at) %></dd>
            <% if (requestItem.resolved_at) { %>
              <dt>Resolved</dt>
              <dd><%= formatDateTime(requestItem.resolved_at) %><% if (requestItem.resolved_by_username || requestItem.resolved_by_display_name) { %> by <%= requestItem.resolved_by_display_name || requestItem.resolved_by_username %><% } %></dd>
            <% } %>
            <% if (requestItem.review_comment) { %>
              <dt>Review comment</dt><dd><%= requestItem.review_comment %></dd>
            <% } %>
          </dl>
        </section>

        <% if (requestItem.branch_admin_id) { %>
        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Matched branch administrator</h2>
          <dl class="admin-dl">
            <dt>Name</dt><dd><%= requestItem.branch_admin_name %></dd>
            <dt>Email</dt><dd><%= requestItem.branch_admin_email || '—' %></dd>
            <dt>Phone</dt><dd><%= requestItem.branch_admin_phone || '—' %></dd>
            <dt>Role</dt><dd><%= requestItem.branch_admin_role || 'branch_admin' %></dd>
            <dt>Status</dt><dd><%- include('../../partials/admin/church_status_badge', { status: requestItem.branch_admin_status }) %></dd>
          </dl>
          <p style="margin-top:1rem;">
            <%- include('../../partials/components/button', { variant: 'default', href: '/admin/church/branches/' + requestItem.branch_id + '/admins/' + requestItem.branch_admin_id, label: 'View branch admin record' }) %>
          </p>
        </section>
        <% } else { %>
        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">No branch admin match</h2>
          <p class="muted">No matching branch administrator account was found. Do not disclose this publicly.</p>
        </section>
        <% } %>

        <section class="card card--mb-xl" style="padding:1.25rem;">
          <%- include('../../partials/reset_request_timeline', { resetTimeline: resetTimeline, resetTimelineError: resetTimelineError, formatDateTime: formatDateTime }) %>
        </section>

        <% if (requestItem.status !== 'reset_completed' && requestItem.status !== 'rejected') { %>
        <section class="card card--mb-xl" style="padding:1.25rem;">
          <h2 class="section-title section-title--flush">Actions</h2>
          <% if (requestItem.status === 'submitted') { %>
          <form method="post" action="/admin/church/branch-admin-password-reset-requests/<%= requestItem.id %>/mark-reviewed" style="margin-bottom:1rem;">
            <%- include('../../partials/components/button', { variant: 'default', type: 'submit', label: 'Mark reviewed' }) %>
          </form>
          <% } %>
          <% if (requestItem.branch_admin_id) { %>
          <form method="post" action="/admin/church/branch-admin-password-reset-requests/<%= requestItem.id %>/reset-password" class="admin-form-grid" style="margin-bottom:1.5rem;">
            <div class="input-field">
              <label class="input-field__label" for="new_password">New password *</label>
              <input id="new_password" class="input-field__control" name="new_password" type="password" required minlength="8" autocomplete="new-password" />
            </div>
            <div class="input-field">
              <label class="input-field__label" for="confirm_password">Confirm password *</label>
              <input id="confirm_password" class="input-field__control" name="confirm_password" type="password" required minlength="8" autocomplete="new-password" />
            </div>
            <div class="input-field">
              <%- include('../../partials/components/button', { variant: 'primary', type: 'submit', label: 'Reset password' }) %>
            </div>
          </form>
          <% } %>
          <form method="post" action="/admin/church/branch-admin-password-reset-requests/<%= requestItem.id %>/reject">
            <div class="input-field">
              <label class="input-field__label" for="review_comment">Rejection comment (required)</label>
              <textarea id="review_comment" class="input-field__control" name="review_comment" rows="3" required minlength="3"></textarea>
            </div>
            <%- include('../../partials/components/button', { variant: 'default', type: 'submit', label: 'Reject request' }) %>
          </form>
        </section>
        <% } %>
<%- include('../../partials/platform_admin_shell_end') %>
