<%- include('../../partials/platform_admin_shell_start', { navTitle: 'Pilot flags', activeNav: activeNav || 'church_platform_pilot_flags', pageTitle: 'Pilot feature flags' }) %>
<header class="church-platform-page-hero">
  <div>
    <h1 class="church-platform-page-hero__title">Pilot feature flags</h1>
    <p class="church-platform-page-hero__subtitle">
      Platform defaults for incomplete or high-risk Growth capabilities.
      Flags work <strong>in addition to</strong> package entitlements — both must allow a feature.
      Missing rows fall back to catalogue defaults (safe, non-breaking).
    </p>
  </div>
</header>

<% if (notice) { %><div class="flash flash--success" role="status"><%= notice %></div><% } %>
<% if (error) { %><div class="flash flash--error" role="alert"><%= error %></div><% } %>

<% (rows || []).forEach(function (row) { %>
<% var def = row.definition; var r = row.resolved; %>
<section class="card card--mb-xl" style="padding:1.25rem;" data-pilot-flag="<%= def.key %>">
  <h2 class="section-title section-title--flush"><%= def.label %> <code><%= def.key %></code></h2>
  <p class="muted"><%= def.description %></p>
  <dl class="admin-dl">
    <dt>Effective (platform)</dt>
    <dd><%= r.flagAllows ? 'Allowed' : 'Blocked' %> · source <code><%= r.source %></code></dd>
    <dt>Catalogue default</dt><dd><%= def.defaultEnabled ? 'enabled' : 'disabled' %></dd>
    <dt>Entitlement</dt>
    <dd><%= def.entitlementKey || def.entitlementMode %></dd>
  </dl>
  <form method="post" action="/admin/church/pilot-flags/<%= def.key %>" class="admin-form-grid" style="margin-top:1rem;">
    <%- include('partials/csrf_field') %>
    <label class="input-field">
      <span class="input-field__label">Enabled</span>
      <select class="input-field__control" name="enabled">
        <option value="true" <%= r.enabled ? 'selected' : '' %>>true</option>
        <option value="false" <%= !r.enabled ? 'selected' : '' %>>false</option>
      </select>
    </label>
    <label class="input-field">
      <span class="input-field__label">Starts at (ISO optional)</span>
      <input class="input-field__control" type="datetime-local" name="starts_at" value="<%= r.platform && r.platform.startsAt ? String(r.platform.startsAt).slice(0,16) : '' %>"/>
    </label>
    <label class="input-field">
      <span class="input-field__label">Ends at (ISO optional)</span>
      <input class="input-field__control" type="datetime-local" name="ends_at" value="<%= r.platform && r.platform.endsAt ? String(r.platform.endsAt).slice(0,16) : '' %>"/>
    </label>
    <label class="input-field" style="grid-column:1/-1;">
      <span class="input-field__label">Reason</span>
      <input class="input-field__control" type="text" name="reason" maxlength="2000" value="<%= r.platform && r.platform.reason ? r.platform.reason : '' %>"/>
    </label>
    <label class="input-field" style="grid-column:1/-1;">
      <span class="input-field__label">Approver</span>
      <input class="input-field__control" type="text" name="approver_label" required maxlength="200" value="<%= (typeof adminUser !== 'undefined' && adminUser && (adminUser.display_name || adminUser.username)) || '' %>"/>
    </label>
    <div class="admin-toolbar" style="grid-column:1/-1;">
      <button class="church-btn church-btn--primary" type="submit">Save platform default</button>
    </div>
  </form>
</section>
<% }); %>

<section class="card card--mb-xl" style="padding:1.25rem;">
  <h2 class="section-title section-title--flush">Recent audit</h2>
  <% if (!(audit || []).length) { %>
  <p class="muted">No flag changes yet.</p>
  <% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>When</th><th>Scope</th><th>Flag</th><th>Enabled</th><th>Approver</th><th>Reason</th></tr></thead>
      <tbody>
        <% audit.forEach(function (a) { %>
        <tr>
          <td><%= a.created_at %></td>
          <td><%= a.scope %><% if (a.organization_id) { %> #<%= a.organization_id %><% } %></td>
          <td><code><%= a.flag_key %></code></td>
          <td><%= a.previous_enabled %> → <%= a.new_enabled %></td>
          <td><%= a.approver_label || '—' %></td>
          <td><%= a.reason || '—' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<%- include('../../partials/platform_admin_shell_end') %>
