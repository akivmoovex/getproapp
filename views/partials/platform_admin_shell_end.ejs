<%
  var _bbMode = typeof blessboardAdminMode !== 'undefined' && blessboardAdminMode;
  var _csrfToken = typeof platformAdminCsrfToken !== 'undefined' ? platformAdminCsrfToken : '';
  var _csrfField = typeof platformAdminCsrfField !== 'undefined' && platformAdminCsrfField ? platformAdminCsrfField : '_csrf';
%>
<% if (_csrfToken) { %>
<template id="platform-admin-csrf-template">
  <input type="hidden" name="<%= _csrfField %>" value="<%= _csrfToken %>"/>
</template>
<script>
  (function () {
    var tpl = document.getElementById("platform-admin-csrf-template");
    if (!tpl || !tpl.content) return;
    var sample = tpl.content.querySelector("input");
    if (!sample || !sample.value) return;
    var forms = document.querySelectorAll('form[method="post"], form[method="POST"]');
    for (var i = 0; i < forms.length; i++) {
      var form = forms[i];
      if (form.querySelector('input[name="' + sample.name + '"]')) continue;
      form.appendChild(sample.cloneNode(true));
    }
  })();
</script>
<% } %>
<% if (_bbMode) { %>
      </div>
    </div>
  </div>
  <script>
    (function () {
      var btn = document.getElementById('church-platform-menu-btn');
      var drawer = document.getElementById('church-platform-drawer');
      var overlay = document.getElementById('church-platform-drawer-overlay');
      var closeBtn = document.getElementById('church-platform-drawer-close');
      if (!btn || !drawer || !overlay) return;
      function openDrawer() {
        drawer.setAttribute('aria-hidden', 'false');
        overlay.hidden = false;
        btn.setAttribute('aria-expanded', 'true');
        document.body.classList.add('church-drawer-open');
      }
      function closeDrawer() {
        drawer.setAttribute('aria-hidden', 'true');
        overlay.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('church-drawer-open');
      }
      btn.addEventListener('click', openDrawer);
      closeBtn && closeBtn.addEventListener('click', closeDrawer);
      overlay.addEventListener('click', closeDrawer);
    })();
  </script>
</body>
</html>
<% } else { %>
      </div>
    </main>
  </body>
</html>
<% } %>
