<%
  var cardIsPast = Boolean(typeof isPast !== 'undefined' && isPast);
  var isRegistered = Boolean(item && item.registration);
  var isFull = item && item.capacity != null && item.spotsRemaining === 0 && !isRegistered;

  function formatWhen(value, timezone) {
    if (!value) return '';
    try {
      var d = value instanceof Date ? value : new Date(value);
      if (isNaN(d.getTime())) return '';
      var opts = {
        weekday: 'short',
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      };
      if (timezone) opts.timeZone = String(timezone);
      return d.toLocaleString('en-GB', opts);
    } catch (e) {
      return '';
    }
  }

  function formatMonth(value, timezone) {
    if (!value) return '';
    try {
      var d = value instanceof Date ? value : new Date(value);
      if (isNaN(d.getTime())) return '';
      var opts = { month: 'short' };
      if (timezone) opts.timeZone = String(timezone);
      return d.toLocaleDateString('en-GB', opts).toUpperCase();
    } catch (e) {
      return '';
    }
  }

  function formatDayNum(value, timezone) {
    if (!value) return '';
    try {
      var d = value instanceof Date ? value : new Date(value);
      if (isNaN(d.getTime())) return '';
      var opts = { day: 'numeric' };
      if (timezone) opts.timeZone = String(timezone);
      return d.toLocaleDateString('en-GB', opts);
    } catch (e) {
      return '';
    }
  }
%>
<a
  class="bb-mp-part-card<%= isRegistered ? ' is-registered' : '' %><%= isFull ? ' is-full' : '' %><%= cardIsPast ? ' is-past' : '' %>"
  href="/member/events/<%= item.id %>"
  data-bb-event="<%= item.id %>"
  data-bb-registered="<%= isRegistered ? '1' : '0' %>"
  data-bb-event-when="<%= cardIsPast ? 'past' : 'upcoming' %>"
  <% if (item.capacity != null) { %>data-bb-capacity="<%= item.spotsRemaining %>"<% } %>
>
  <div class="bb-mp-part-card__when" aria-hidden="true">
    <span class="bb-mp-part-card__month"><%= formatMonth(item.startsAt, item.timezone) || '—' %></span>
    <span class="bb-mp-part-card__day"><%= formatDayNum(item.startsAt, item.timezone) || '—' %></span>
  </div>
  <div class="bb-mp-part-card__body">
    <div class="bb-mp-part-card__top">
      <h3 class="bb-mp-part-card__title"><%= item.title %></h3>
      <% if (isRegistered) { %>
      <span class="bb-mp-chip bb-mp-chip--active" aria-label="Registered">Registered</span>
      <% } else if (isFull) { %>
      <span class="bb-mp-chip bb-mp-chip--full" aria-label="Full">Full</span>
      <% } else if (!cardIsPast) { %>
      <span class="bb-mp-chip bb-mp-chip--open" aria-label="Open">Open</span>
      <% } else { %>
      <span class="bb-mp-chip" aria-label="Past">Past</span>
      <% } %>
    </div>
    <% if (item.summary) { %>
    <p class="bb-mp-part-card__excerpt"><%= item.summary %></p>
    <% } %>
    <% if (item.startsAt) { %>
    <p class="bb-mp-part-card__meta">
      <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
      <%= formatWhen(item.startsAt, item.timezone) %>
      <% if (item.endsAt) { %>
      – <%= formatWhen(item.endsAt, item.timezone) %>
      <% } %>
    </p>
    <% } %>
    <% if (item.location) { %>
    <p class="bb-mp-part-card__meta">
      <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
      <%= item.location %>
    </p>
    <% } %>
    <% if (!cardIsPast && item.capacity != null) { %>
    <p class="bb-mp-part-card__capacity">
      <% if (item.spotsRemaining === 0) { %>
      No spots remaining (<%= item.registeredCount %>/<%= item.capacity %>)
      <% } else { %>
      <%= item.spotsRemaining %> spot<%= item.spotsRemaining === 1 ? '' : 's' %> left
      (<%= item.registeredCount %>/<%= item.capacity %>)
      <% } %>
    </p>
    <% } %>
    <% if (!cardIsPast && !isRegistered && !isFull) { %>
    <p class="bb-mp-part-card__cta">View details</p>
    <% } else if (!cardIsPast && isRegistered) { %>
    <p class="bb-mp-part-card__cta">Manage registration</p>
    <% } %>
  </div>
  <span class="bb-mp-ann-card__chevron material-symbols-outlined" aria-hidden="true">chevron_right</span>
</a>
