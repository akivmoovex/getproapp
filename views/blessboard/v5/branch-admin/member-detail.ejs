<%- include('../partials/branch-admin-shell-start') %>
<%
  var model = typeof profile !== 'undefined' && profile ? profile : {};
  var m = model.member || member || {};
  var caps = model.capabilities || capabilities || {};
  var displayHeading = model.displayName || [m.firstName, m.lastName].filter(Boolean).join(' ') || 'Member';
  var initialsSource = [m.firstName, m.lastName].filter(Boolean);
  var initials = initialsSource.map(function (part) { return String(part).charAt(0); }).join('').slice(0, 2).toUpperCase() || '?';
  var churchId = model.churchId || m.memberNumber || '—';
  var membershipTone = String(m.status || '').toLowerCase() === 'active' ? 'success' : 'neutral';
  var portalTone = String(m.portalAccessStatus || '').toLowerCase() === 'blocked' ? 'danger'
    : (String(m.portalAccessStatus || '').toLowerCase() === 'active' ? 'success' : 'neutral');
  var notice = typeof flashNotice !== 'undefined' ? flashNotice : null;
  var errorMsg = typeof flashError !== 'undefined' ? flashError : null;
  function formatWhen(value) {
    if (!value) return '—';
    var d = value instanceof Date ? value : new Date(value);
    if (isNaN(d.getTime())) return String(value);
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
  }
%>

<section
  class="bb-v204-m06"
  data-bb-member-admin-profile="1"
  data-bb-member-detail="1"
  data-bb-stitch-v204="BB-M06"
  data-bb-stitch-member-detail="27-branch-member-profile"
  data-bb-screen="BB-M06"
  data-screen="BB14"
  data-bb-screen-desktop="BB14-D"
  data-bb-screen-mobile="BB14-M"
  data-bb-stitch-id="7ddcd294a1514304a449e5f8a4acbc4c"
  data-bb-member-sections="1"
  aria-label="Member Admin Profile"
>
  <%- include('../partials/v204/page-header', {
    title: displayHeading,
    subtitle: 'Membership status and portal access are managed separately.',
    breadcrumbsHtml: '<a href="/branch-admin/members">Members</a> <span aria-hidden="true">›</span> <span>Admin profile</span>',
    actionsHtml: (function () {
      var parts = [];
      if (caps.canEditMember) {
        parts.push('<a class="bb-ba-btn bb-ba-btn--primary" href="/branch-admin/members/' + m.id + '/edit" data-bb-m06-edit="1" data-screen="BB15"><span class="material-symbols-outlined" aria-hidden="true">edit</span> Edit Member</a>');
      }
      if (caps.canManageAccess) {
        parts.push('<a class="bb-ba-btn bb-ba-btn--secondary" href="/branch-admin/members/' + m.id + '/access" data-bb-m06-access="1"><span class="material-symbols-outlined" aria-hidden="true">vpn_key</span> Manage Access</a>');
      }
      return parts.join(' ');
    })()
  }) %>

  <% if (notice) { %>
  <p class="bb-ba-banner bb-ba-banner--ok" role="status"><%= notice %></p>
  <% } %>
  <% if (errorMsg) { %>
  <p class="bb-ba-banner bb-ba-banner--danger" role="alert"><%= errorMsg %></p>
  <% } %>

  <div class="bb-v204-m06__hero" data-bb-member-summary="1">
    <span class="bb-ba-avatar bb-ba-avatar--xl" aria-hidden="true"><%= initials %></span>
    <div class="bb-v204-m06__hero-copy">
      <div class="bb-v204-m06__chips">
        <%- include('../partials/v204/status-chip', { label: model.membershipLabel || 'Membership', tone: membershipTone }) %>
        <%- include('../partials/v204/status-chip', { label: 'Portal: ' + (model.portalLabel || 'Not Activated'), tone: portalTone }) %>
        <span class="bb-v204-m01__church-id" data-bb-m06-church-id="1"><%= churchId %></span>
      </div>
      <h2 class="bb-v204-m06__name"><%= displayHeading %></h2>
      <% if (m.preferredName) { %><p class="bb-ba-muted">Preferred: <%= m.preferredName %></p><% } %>
      <p class="bb-ba-muted">
        <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
        Member since <%= formatWhen(m.joinedAt || m.createdAt) %>
      </p>
      <p class="bb-ba-hint">Profile fields are Read-only here. Use Edit Member for approved changes.</p>
    </div>
  </div>

  <nav class="bb-v204-m06__tabs" aria-label="Profile sections">
    <a class="bb-v204-m06__tab is-active" href="#bb-m06-overview" aria-current="page">Overview</a>
    <a class="bb-v204-m06__tab" href="#bb-m06-profile">Profile</a>
    <a class="bb-v204-m06__tab" href="#bb-m06-membership">Membership</a>
    <a class="bb-v204-m06__tab" href="#bb-m06-access">Access</a>
    <% if (caps.canViewHistory) { %>
    <a class="bb-v204-m06__tab" href="/branch-admin/members/<%= m.id %>/history" data-bb-m06-history="1">History</a>
    <% } else { %>
    <span class="bb-v204-m06__tab is-unavailable" data-bb-member-unavailable="1" title="Not authorized">History</span>
    <% } %>
  </nav>

  <div class="bb-v204-m06__layout" id="bb-m06-overview">
    <div class="bb-v204-m06__main">
      <section class="bb-v204-m02__section" id="bb-m06-profile" data-bb-member-contact="1" aria-labelledby="bb-m06-contact-h">
        <h2 id="bb-m06-contact-h">Contact &amp; Residential</h2>
        <dl class="bb-v204-m03__dl">
          <div><dt>Primary Phone</dt><dd><%= m.phoneDisplay || '—' %></dd></div>
          <div><dt>Email Address</dt><dd><%= m.emailDisplay || '—' %></dd></div>
          <div><dt>Residential Address</dt><dd><%= m.addressLine1 || '—' %><% if (m.addressCity) { %><br /><%= m.addressCity %><% } %></dd></div>
        </dl>
      </section>

      <section class="bb-v204-m02__section" aria-labelledby="bb-m06-personal-h">
        <h2 id="bb-m06-personal-h">Personal &amp; Household</h2>
        <dl class="bb-v204-m03__dl">
          <div><dt>Date of birth</dt><dd><%= m.dateOfBirth || '—' %></dd></div>
          <div><dt>Occupation</dt><dd><%= m.occupation || '—' %></dd></div>
          <div><dt>Marital status</dt><dd><%= m.maritalStatus || '—' %></dd></div>
          <div><dt>Children</dt><dd><%= m.numberOfChildren != null ? m.numberOfChildren : '—' %></dd></div>
          <div><dt>Next of kin</dt><dd><%= m.nextOfKinName || '—' %><% if (m.nextOfKinRelationship) { %> (<%= m.nextOfKinRelationship %>)<% } %></dd></div>
          <div><dt>Emergency phone</dt><dd><%= m.nextOfKinPhoneDisplay || '—' %></dd></div>
        </dl>
      </section>
    </div>

    <aside class="bb-v204-m06__aside">
      <section class="bb-v204-m02__section" id="bb-m06-membership" data-bb-member-membership="1" aria-labelledby="bb-m06-membership-h">
        <h2 id="bb-m06-membership-h">Membership</h2>
        <dl class="bb-v204-m03__dl">
          <div><dt>Church ID</dt><dd><span class="bb-v204-m01__church-id"><%= churchId %></span></dd></div>
          <div><dt>Membership status</dt><dd><%- include('../partials/v204/status-chip', { label: model.membershipLabel, tone: membershipTone }) %></dd></div>
          <div><dt>Assigned branch</dt><dd><%= branchDisplayName || churchDisplayName || '—' %></dd></div>
        </dl>
        <p class="bb-ba-hint">Church ID cannot be edited from the profile form. Privileged staff use Change Church ID.</p>
      </section>

      <section class="bb-v204-m02__section" id="bb-m06-access" data-bb-member-account="1" aria-labelledby="bb-m06-access-h">
        <h2 id="bb-m06-access-h">Access</h2>
        <dl class="bb-v204-m03__dl">
          <div><dt>Portal status</dt><dd><%- include('../partials/v204/status-chip', { label: model.portalLabel, tone: portalTone }) %></dd></div>
          <div><dt>Login linked</dt><dd><%= m.hasLoginLinked || m.userId ? 'Yes' : 'No' %></dd></div>
        </dl>
        <p class="bb-ba-hint">Blocking portal access disables digital access and does not delete membership.</p>
      </section>

      <section class="bb-v204-m02__section" aria-labelledby="bb-m06-controls-h">
        <h2 id="bb-m06-controls-h">Staff Controls</h2>
        <ul class="bb-v204-m06__actions">
          <% if (caps.canChangeChurchId) { %>
          <li><a href="/branch-admin/members/<%= m.id %>/church-id" data-bb-m06-church-id-action="1"><span class="material-symbols-outlined" aria-hidden="true">badge</span> Change Church ID (Privileged)</a></li>
          <% } %>
          <% if (caps.canTransferBranch) { %>
          <li><a href="/branch-admin/members/<%= m.id %>/transfer" data-bb-m06-transfer="1"><span class="material-symbols-outlined" aria-hidden="true">sync_alt</span> Transfer Branch</a></li>
          <% } %>
          <% if (caps.canManageAccess && String(m.portalAccessStatus || '') !== 'blocked') { %>
          <li><a href="/branch-admin/members/<%= m.id %>/access/block" data-bb-m06-block="1"><span class="material-symbols-outlined" aria-hidden="true">block</span> Block Member Access</a></li>
          <% } %>
          <% if (caps.canDeactivateMembership) { %>
          <li><a href="/branch-admin/members/<%= m.id %>/edit#membership-status" data-bb-m06-deactivate="1"><span class="material-symbols-outlined" aria-hidden="true">person_off</span> Deactivate Membership</a></li>
          <% } %>
        </ul>
      </section>
    </aside>
  </div>
</section>

<%- include('../partials/branch-admin-shell-end') %>
