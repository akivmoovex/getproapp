<%- include('../partials/branch-admin-shell-start') %>
<%
  var modules = typeof portalModules !== 'undefined' && portalModules ? portalModules : [];
  var greetingName = displayName ? String(displayName).split(/\s+/)[0] : '';
%>

<section class="bb-ba-dash" data-bb-branch-dashboard="1">
  <header class="bb-ba-dash__hero">
    <h1 class="bb-ba-dash__title">
      <% if (greetingName) { %>Welcome, <%= greetingName %><% } else { %>Branch dashboard<% } %>
    </h1>
    <p class="bb-ba-lede">
      Manage
      <strong><%= churchDisplayName %></strong><% if (branchDisplayName) { %>
      · <%= branchDisplayName %><% } %>.
      Open a module below — counts and activity feeds appear only from live branch data inside each section.
    </p>
    <p class="bb-ba-role-line">
      Signed in as <span class="bb-ba-role"><%= roleLabel %></span>
    </p>
  </header>

  <p class="bb-ba-empty" data-bb-empty="dashboard" role="status">
    No summary metrics are shown on this dashboard. Use the modules below for branch work.
  </p>

  <section class="bb-ba-grid" aria-label="Branch modules">
    <% modules.forEach(function (mod) { %>
      <% if (mod.enabled && mod.href) { %>
      <a
        class="bb-ba-card bb-ba-card--link"
        href="<%= mod.href %>"
        data-bb-module="<%= mod.key %>"
        data-bb-module-enabled="1"
      >
        <span class="bb-ba-card__icon" aria-hidden="true">
          <span class="material-symbols-outlined"><%= mod.icon || 'widgets' %></span>
        </span>
        <h2 class="bb-ba-card__title"><%= mod.label %></h2>
        <p class="bb-ba-card__meta"><%= mod.blurb || 'Open' %></p>
      </a>
      <% } else { %>
      <article
        class="bb-ba-card is-disabled"
        data-bb-module="<%= mod.key %>"
        data-bb-module-enabled="0"
        aria-disabled="true"
      >
        <span class="bb-ba-card__icon" aria-hidden="true">
          <span class="material-symbols-outlined"><%= mod.icon || 'block' %></span>
        </span>
        <h2 class="bb-ba-card__title"><%= mod.label %></h2>
        <p class="bb-ba-card__meta">Not enabled</p>
      </article>
      <% } %>
    <% }) %>
  </section>
</section>

<%- include('../partials/branch-admin-shell-end') %>
