<%- include('../partials/branch-admin-shell-start') %>
<%
  var rows = items || [];
  var searchQ = typeof q !== 'undefined' && q ? String(q) : '';
  var activeStatus = typeof statusFilter !== 'undefined' && statusFilter ? String(statusFilter) : '';
  var activePortal = typeof portalFilter !== 'undefined' && portalFilter ? String(portalFilter) : '';
  var hasFilter = Boolean(searchQ || activeStatus || activePortal);
  var ov = typeof overview !== 'undefined' && overview ? overview : null;
  var statusCounts = (ov && ov.statusCounts) || { total: typeof total === 'number' ? total : 0, byStatus: {} };
  var byStatus = statusCounts.byStatus || {};
  var activeCount = Number(byStatus.active) || 0;
  var canCreate = typeof canCreateMember !== 'undefined' && canCreateMember;
  var addHref = typeof addMemberHref !== 'undefined' && addMemberHref ? addMemberHref : '/branch-admin/members/new';
  var branchLabel = branchDisplayName || churchDisplayName || 'this branch';
  var statusOptions = [
    { key: '', label: 'All Members' },
    { key: 'active', label: 'Active' },
    { key: 'pending', label: 'Pending' },
    { key: 'inactive', label: 'Inactive' },
    { key: 'suspended', label: 'Suspended' },
    { key: 'archived', label: 'Archived' }
  ];
  function statusLabel(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'active') return 'Active';
    if (key === 'pending') return 'Pending';
    if (key === 'inactive') return 'Inactive';
    if (key === 'suspended') return 'Suspended';
    if (key === 'archived') return 'Archived';
    if (key === 'transferred') return 'Transferred';
    if (key === 'former') return 'Former';
    if (key === 'deceased') return 'Deceased';
    return s || '—';
  }
  function portalLabel(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'active') return 'Portal Active';
    if (key === 'blocked') return 'Blocked';
    if (key === 'not_activated') return 'Not Invited';
    return 'Not Invited';
  }
  function portalTone(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'active') return 'info';
    if (key === 'blocked') return 'danger';
    return 'neutral';
  }
  function membershipTone(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'active') return 'success';
    if (key === 'pending') return 'warning';
    if (key === 'suspended' || key === 'deceased') return 'danger';
    return 'neutral';
  }
  function formatWhen(value) {
    if (!value) return '—';
    var d = value instanceof Date ? value : new Date(value);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
  }
  function initials(item) {
    var a = String(item.firstName || '').charAt(0);
    var b = String(item.lastName || '').charAt(0);
    return (a + b).toUpperCase() || '?';
  }
  function filterHref(opts) {
    var params = [];
    var st = opts && opts.status != null ? opts.status : activeStatus;
    var pr = opts && opts.portal != null ? opts.portal : activePortal;
    var qq = opts && opts.q != null ? opts.q : searchQ;
    if (qq) params.push('q=' + encodeURIComponent(qq));
    if (st) params.push('status=' + encodeURIComponent(st));
    if (pr) params.push('portal=' + encodeURIComponent(pr));
    return '/branch-admin/members' + (params.length ? '?' + params.join('&') : '');
  }
  function pagerHref(pageNum) {
    var params = ['page=' + pageNum];
    if (searchQ) params.push('q=' + encodeURIComponent(searchQ));
    if (activeStatus) params.push('status=' + encodeURIComponent(activeStatus));
    if (activePortal) params.push('portal=' + encodeURIComponent(activePortal));
    return '/branch-admin/members?' + params.join('&');
  }
%>

<section
  class="bb-v204-m01"
  data-bb-member-directory="1"
  data-bb-stitch-members="28-branch-member-directory"
  data-bb-stitch-v204="BB-M01"
  data-bb-membership="branch-overview"
  data-screen="BB18"
  data-bb-screen="BB-M01"
  data-bb-screen-desktop="BB18-D"
  data-bb-screen-mobile="BB18-M"
  data-bb-screen-desktop-v204="BB-M01"
  data-bb-screen-mobile-v204="BB-M01-responsive"
  data-bb-members-overview="1"
  data-bb-stitch-id="2b8333d5e64242bc9cde22dac5aacc3c"
  data-bb-stitch-id-desktop="2b8333d5e64242bc9cde22dac5aacc3c"
  aria-label="Members Directory"
>
  <%- include('../partials/v204/page-header', {
    title: 'Members',
    subtitle: 'Manage congregation records, monitor portal activation, and review branch memberships across ' + branchLabel + '.',
    actionsHtml: canCreate
      ? ('<a class="gp-ops-btn gp-ops-btn--primary" href="' + addHref + '" data-bb-m01-add="1"><span class="material-symbols-outlined" aria-hidden="true">add</span> + Add Member</a>')
      : ''
  }) %>

  <nav class="bb-ba-members-chips" aria-label="Status filters" data-bb-member-status-chips="1">
    <a
      class="bb-ba-members-chip<%= !activeStatus && !activePortal ? ' is-active' : '' %>"
      href="<%= filterHref({ status: '', portal: '' }) %>"
      <%= !activeStatus && !activePortal ? 'aria-current="page"' : '' %>
      data-bb-member-status-filter="all"
    >All Members<% if (typeof total === 'number') { %> <span class="bb-v204-m01__chip-count"><%= total %></span><% } %></a>
    <a
      class="bb-ba-members-chip<%= activeStatus === 'active' && !activePortal ? ' is-active' : '' %>"
      href="<%= filterHref({ status: 'active', portal: '' }) %>"
      <%= activeStatus === 'active' && !activePortal ? 'aria-current="page"' : '' %>
      data-bb-member-status-filter="active"
    >Active<% if (activeCount) { %> <span class="bb-v204-m01__chip-count"><%= activeCount %></span><% } %></a>
    <a
      class="bb-ba-members-chip<%= activePortal === 'not_activated' ? ' is-active' : '' %>"
      href="<%= filterHref({ status: '', portal: 'not_activated' }) %>"
      <%= activePortal === 'not_activated' ? 'aria-current="page"' : '' %>
      data-bb-member-status-filter="portal-pending"
      data-bb-member-portal-filter="not_activated"
    >Portal Pending</a>
  </nav>

  <form
    method="get"
    action="/branch-admin/members"
    class="bb-ba-filter bb-ba-members-filter bb-v204-m01__filters"
    data-bb-member-filter="1"
    role="search"
  >
    <div class="bb-ba-field bb-v204-m01__search">
      <label for="q">Search</label>
      <input
        id="q"
        name="q"
        type="search"
        maxlength="100"
        value="<%= searchQ %>"
        placeholder="Search by member name, phone, or Church ID (e.g. CH-74291)..."
        autocomplete="off"
      />
    </div>
    <div class="bb-ba-field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="">All Statuses</option>
        <% ['active','pending','inactive','suspended','archived','transferred','former','deceased'].forEach(function (st) { %>
        <option value="<%= st %>" <%= activeStatus === st ? 'selected' : '' %>><%= statusLabel(st) %></option>
        <% }) %>
      </select>
    </div>
    <div class="bb-ba-field">
      <label for="portal">Portal</label>
      <select id="portal" name="portal">
        <option value="">All Portal States</option>
        <option value="not_activated" <%= activePortal === 'not_activated' ? 'selected' : '' %>>Not Invited</option>
        <option value="active" <%= activePortal === 'active' ? 'selected' : '' %>>Portal Active</option>
        <option value="blocked" <%= activePortal === 'blocked' ? 'selected' : '' %>>Blocked</option>
      </select>
    </div>
    <div class="bb-ba-filter__actions">
      <button type="submit" class="bb-ba-btn bb-ba-btn--primary">Filter</button>
      <% if (hasFilter) { %>
      <a class="bb-ba-btn bb-ba-btn--ghost" href="/branch-admin/members">Clear all</a>
      <% } %>
    </div>
  </form>

  <% if (hasFilter) { %>
  <p class="bb-v204-m01__active-filters" data-bb-m01-active-filters="1">
    Active Filters:
    <% if (searchQ) { %><span class="bb-ba-chip bb-ba-chip--muted">Search: <%= searchQ %></span><% } %>
    <% if (activeStatus) { %><span class="bb-ba-chip bb-ba-chip--muted">Status: <%= statusLabel(activeStatus) %></span><% } %>
    <% if (activePortal) { %><span class="bb-ba-chip bb-ba-chip--muted">Portal: <%= portalLabel(activePortal) %></span><% } %>
  </p>
  <% } %>

  <% if (!rows.length && !hasFilter) { %>
  <div class="bb-ba-members-empty" data-bb-member-empty="catalog" role="status">
    <%- include('../partials/v204/empty-state', {
      title: 'No members registered yet',
      body: 'Begin building your congregation registry by creating membership records for ' + branchLabel + '.',
      actionHref: canCreate ? addHref : null,
      actionLabel: canCreate ? '+ Add First Member' : null
    }) %>
  </div>
  <% } else if (!rows.length && hasFilter) { %>
  <div class="bb-ba-members-empty" data-bb-member-empty="no-results" role="status">
    <%- include('../partials/v204/empty-state', {
      title: 'No members found',
      body: 'No matches across ' + branchLabel + ' with the selected filter criteria.',
      actionHref: '/branch-admin/members',
      actionLabel: 'Reset Active Search & Filters'
    }) %>
  </div>
  <% } else { %>

  <section class="bb-ba-panel bb-ba-members-panel" aria-labelledby="bb-ba-members-list-heading">
    <div class="bb-ba-members-panel__head">
      <h2 id="bb-ba-members-list-heading" class="bb-ba-members-panel__title">Directory</h2>
      <% if (typeof total === 'number') { %>
      <p class="bb-ba-members-panel__meta" data-bb-member-total="<%= total %>">
        Showing <%= rows.length %> of <%= total %>
        <% if (typeof page === 'number' && typeof totalPages === 'number' && totalPages > 1) { %>
        · Page <%= page %> of <%= totalPages %>
        <% } %>
      </p>
      <% } %>
    </div>

    <div class="bb-ba-table-wrap bb-ba-members-table-wrap" role="region" aria-label="Members table" tabindex="0" data-bb-member-table-wrap="1">
      <table class="bb-ba-table bb-ba-members-table" data-bb-member-table="1">
        <thead>
          <tr>
            <th scope="col">Church ID</th>
            <th scope="col">Member Name</th>
            <th scope="col">Phone</th>
            <th scope="col">Branch</th>
            <th scope="col">Membership Status</th>
            <th scope="col">Portal Status</th>
            <th scope="col">Last Updated</th>
            <th scope="col"><span class="bb-ba-sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function (item) { %>
          <tr data-bb-member-status="<%= item.status %>" data-bb-member-row="1" data-bb-portal-status="<%= item.portalAccessStatus || 'not_activated' %>">
            <td>
              <span class="bb-v204-m01__church-id"><%= item.memberNumber || '—' %></span>
            </td>
            <td>
              <div class="bb-ba-person">
                <span class="bb-ba-avatar" aria-hidden="true"><%= initials(item) %></span>
                <span>
                  <strong><%= item.firstName %> <%= item.lastName %></strong>
                  <% if (item.preferredName) { %>
                  <span class="bb-ba-muted"> (<%= item.preferredName %>)</span>
                  <% } %>
                </span>
              </div>
            </td>
            <td><%= item.phoneDisplay || '—' %></td>
            <td><%= branchLabel %></td>
            <td>
              <%- include('../partials/v204/status-chip', {
                label: statusLabel(item.status || item.membershipStatus),
                tone: membershipTone(item.status || item.membershipStatus)
              }) %>
            </td>
            <td>
              <%- include('../partials/v204/status-chip', {
                label: portalLabel(item.portalAccessStatus),
                tone: portalTone(item.portalAccessStatus)
              }) %>
            </td>
            <td><%= formatWhen(item.updatedAt) %></td>
            <td class="bb-ba-table__actions">
              <a
                class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm"
                href="/branch-admin/members/<%= item.id %>"
                data-bb-member-action="view"
              >View Profile</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <ul class="bb-ba-members-cards" data-bb-member-cards="1">
      <% rows.forEach(function (item) { %>
      <li class="bb-ba-members-card" data-bb-member-row="1" data-bb-member-status="<%= item.status %>">
        <div class="bb-ba-members-card__head">
          <div class="bb-ba-members-card__identity">
            <span class="bb-ba-avatar" aria-hidden="true"><%= initials(item) %></span>
            <div>
              <p class="bb-ba-members-card__name"><%= item.firstName %> <%= item.lastName %></p>
              <p class="bb-ba-members-card__meta">
                <span class="bb-v204-m01__church-id"><%= item.memberNumber || '—' %></span>
              </p>
            </div>
          </div>
          <div class="bb-ba-members-card__badges">
            <%- include('../partials/v204/status-chip', {
              label: statusLabel(item.status),
              tone: membershipTone(item.status)
            }) %>
            <%- include('../partials/v204/status-chip', {
              label: portalLabel(item.portalAccessStatus),
              tone: portalTone(item.portalAccessStatus)
            }) %>
          </div>
        </div>
        <div class="bb-ba-members-card__body">
          <p class="bb-ba-members-card__line">
            <span class="material-symbols-outlined" aria-hidden="true">call</span>
            <%= item.phoneDisplay || '—' %>
          </p>
          <p class="bb-ba-members-card__line">
            <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
            <%= formatWhen(item.updatedAt) %>
          </p>
        </div>
        <div class="bb-ba-members-card__actions">
          <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="/branch-admin/members/<%= item.id %>" data-bb-member-action="view">View Profile</a>
        </div>
      </li>
      <% }) %>
    </ul>

    <% if (typeof totalPages === 'number' && totalPages > 1) { %>
    <nav class="bb-ba-pager" aria-label="Members pagination">
      <% if (page > 1) { %>
      <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="<%= pagerHref(page - 1) %>">Previous</a>
      <% } %>
      <span class="bb-ba-pager__meta">Page <%= page %> of <%= totalPages %></span>
      <% if (page < totalPages) { %>
      <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="<%= pagerHref(page + 1) %>">Next</a>
      <% } %>
    </nav>
    <% } %>
  </section>
  <% } %>

  <section
    class="bb-ba-members-overview"
    data-bb-members-overview-panel="1"
    data-bb-members-metrics="1"
    aria-label="Branch membership overview"
  >
    <div class="bb-ba-members-metrics">
      <a class="bb-ba-members-metric" href="/branch-admin/registrations" data-bb-metric="queue">
        <span class="bb-ba-members-metric__label">Verification queue</span>
        <span class="bb-ba-members-metric__value"><%= Number((ov && ov.reviewQueue && ov.reviewQueue.total) || 0) %></span>
      </a>
      <a class="bb-ba-members-metric" href="/branch-admin/activity-forms" data-bb-metric="visitors" data-bb-members-visitors="1">
        <span class="bb-ba-members-metric__label">Visitor forms</span>
        <span class="bb-ba-members-metric__value">Open</span>
      </a>
      <a class="bb-ba-members-metric" href="/branch-admin/membership" data-bb-metric="transfers" data-bb-members-transfers="1" data-bb-members-queue="1">
        <span class="bb-ba-members-metric__label">Transfers &amp; review</span>
        <span class="bb-ba-members-metric__value"><%= Number((ov && ov.openTransfers && ov.openTransfers.total) || 0) %></span>
      </a>
    </div>
  </section>
</section>

<%- include('../partials/branch-admin-shell-end') %>
