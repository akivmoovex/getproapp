<%#
  BB-M18 Recovery Verification — OTP + new password
%>
<%- include('_shell-start', {
  pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'Recovery Verification',
  stitchScreen: 'BB-M18',
  churchName: typeof churchName !== 'undefined' ? churchName : '',
  bodyClass: 'bb-v204-m18',
  loginHref: '/member/login',
  errorState: typeof error !== 'undefined' && error ? 'otp_failed' : null
}) %>
<%
  var rules = Array.isArray(passwordRules) ? passwordRules : [];
%>

<div class="bb-auth-card__intro">
  <p class="bb-auth-step">Recovery · Step 2</p>
  <h1 class="bb-auth-card__title">Enter verification code</h1>
  <p class="bb-auth-card__lead">Enter the code sent to your verified contact, then choose a new password.</p>
</div>

<% if (typeof message !== 'undefined' && message) { %>
<p class="bb-auth-success" role="status"><%= message %></p>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
<div class="bb-auth-error" role="alert">
  <p class="bb-auth-error__body"><%= error %></p>
</div>
<% } %>

<form class="bb-auth-form" method="post" action="/member/forgot-password/verify" novalidate autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <input type="hidden" name="draft_token" value="<%= draftToken || '' %>" />
  <input type="hidden" name="verification_id" value="<%= verificationId || '' %>" />
  <div class="bb-auth-field">
    <label class="bb-auth-label" for="code">Security code</label>
    <input class="bb-auth-input bb-auth-input--mono" id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" required maxlength="8" />
    <% if (typeof testCode !== 'undefined' && testCode) { %>
    <p class="bb-auth-hint" data-bb-test-otp="1">Test code: <%= testCode %></p>
    <% } %>
  </div>
  <div class="bb-auth-field">
    <label class="bb-auth-label" for="password">New password</label>
    <input class="bb-auth-input" id="password" name="password" type="password" autocomplete="new-password" required minlength="8" />
    <% if (rules.length) { %>
    <div class="bb-auth-checklist" aria-label="Password requirements">
      <p class="bb-auth-checklist__title">Security checklist</p>
      <ul class="bb-auth-hint-list">
        <% rules.forEach(function (rule) { %>
        <li><%= rule.label %></li>
        <% }) %>
      </ul>
    </div>
    <% } else { %>
    <p class="bb-auth-hint">At least 8 characters, one uppercase letter, and one special character.</p>
    <% } %>
  </div>
  <div class="bb-auth-field">
    <label class="bb-auth-label" for="password_confirm">Confirm password</label>
    <input class="bb-auth-input" id="password_confirm" name="password_confirm" type="password" autocomplete="new-password" required minlength="8" />
  </div>
  <div class="bb-auth-actions">
    <button class="bb-auth-btn bb-auth-btn--primary" type="submit">Verify &amp; reset password</button>
  </div>
</form>

<p class="bb-auth-footer">
  <a href="/member/forgot-password">Start over</a>
</p>

<%- include('_shell-end') %>
