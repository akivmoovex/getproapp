<%#
  BB-M17 Forgot Password — Church ID only start
%>
<%- include('_shell-start', {
  pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'Forgot Password',
  stitchScreen: 'BB-M17',
  churchName: typeof churchName !== 'undefined' ? churchName : '',
  bodyClass: 'bb-v204-m17',
  loginHref: typeof loginHref !== 'undefined' ? loginHref : '/member/login'
}) %>

<div class="bb-auth-card__intro">
  <p class="bb-auth-step">Recovery · Step 1</p>
  <h1 class="bb-auth-card__title">Recover access</h1>
  <p class="bb-auth-card__lead">Enter your Church ID. We’ll send a verification code to your verified contact on file.</p>
</div>

<% if (typeof message !== 'undefined' && message) { %>
<p class="bb-auth-success" role="status" data-bb-auth-reset-requested="1"><%= message %></p>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
<div class="bb-auth-error" role="alert">
  <p class="bb-auth-error__body"><%= error %></p>
</div>
<% } %>

<form class="bb-auth-form" method="post" action="/member/forgot-password" novalidate autocomplete="on">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div class="bb-auth-field">
    <label class="bb-auth-label" for="member_number">Church ID number</label>
    <input
      class="bb-auth-input bb-auth-input--mono"
      id="member_number"
      name="member_number"
      type="text"
      required
      autocomplete="username"
      spellcheck="false"
      placeholder="CH-XXXXX"
      value="<%= typeof memberNumberValue !== 'undefined' && memberNumberValue ? memberNumberValue : '' %>"
    />
  </div>
  <div class="bb-auth-actions">
    <button class="bb-auth-btn bb-auth-btn--primary" type="submit">Send verification code</button>
  </div>
</form>

<p class="bb-auth-footer">
  <span class="bb-auth-footer__links">
    <a href="<%= loginHref || '/member/login' %>">Back to login</a>
    <a href="<%= lostHref || '/member/forgot-password?lost=1' %>">Don’t know your Church ID?</a>
  </span>
</p>
<p class="bb-auth-footnote">We never confirm whether a Church ID exists. Contact your church if you need pastoral help.</p>

<%- include('_shell-end') %>
