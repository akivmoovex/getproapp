<%#
  BB-M15 Create Password
%>
<%- include('_shell-start', {
  pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'Create Password',
  stitchScreen: 'BB-M15',
  churchName: typeof churchName !== 'undefined' ? churchName : '',
  bodyClass: 'bb-v204-m15',
  loginHref: '/member/login',
  errorState: typeof error !== 'undefined' && error ? 'weak_password' : null
}) %>
<%
  var rules = Array.isArray(passwordRules) ? passwordRules : [];
  var hint = typeof memberHint !== 'undefined' && memberHint ? memberHint : null;
  var hintName = hint && hint.firstName ? String(hint.firstName) : '';
  var hintId = hint && hint.memberNumber ? String(hint.memberNumber) : '';
  var initials = hintName ? hintName.charAt(0).toUpperCase() : (hintId ? hintId.charAt(0) : 'M');
%>

<div class="bb-auth-card__intro">
  <p class="bb-auth-step">Step 2 of 2 · Activation</p>
  <h1 class="bb-auth-card__title">Create secure password</h1>
  <p class="bb-auth-card__lead">Conclude activation to unlock member portal access for your verified membership.</p>
</div>

<% if (hintId || hintName) { %>
<div class="bb-auth-member-chip" data-bb-auth-member-hint="1">
  <div class="bb-auth-member-chip__avatar" aria-hidden="true"><%= initials %></div>
  <div>
    <p class="bb-auth-member-chip__name"><%= hintName || 'Verified member' %></p>
    <% if (hintId) { %>
    <p class="bb-auth-member-chip__meta">ID: <%= hintId %></p>
    <% } %>
    <div class="bb-auth-badge-row">
      <span class="bb-auth-badge">
        <span class="material-symbols-outlined" aria-hidden="true" style="font-size:0.9rem">verified</span>
        Verified membership
      </span>
    </div>
  </div>
</div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
<div class="bb-auth-error" role="alert">
  <p class="bb-auth-error__body"><%= error %></p>
</div>
<% } %>

<form class="bb-auth-form" method="post" action="/member/activate/password" novalidate autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <input type="hidden" name="draft_token" value="<%= draftToken || '' %>" />
  <div class="bb-auth-field">
    <label class="bb-auth-label" for="password">Create password</label>
    <input class="bb-auth-input" id="password" name="password" type="password" autocomplete="new-password" required minlength="8" placeholder="Enter your confidential password" />
  </div>
  <div class="bb-auth-field">
    <label class="bb-auth-label" for="password_confirm">Confirm password</label>
    <input class="bb-auth-input" id="password_confirm" name="password_confirm" type="password" autocomplete="new-password" required minlength="8" placeholder="Re-enter password to confirm" />
  </div>
  <% if (rules.length) { %>
  <div class="bb-auth-checklist" aria-label="Password requirements">
    <p class="bb-auth-checklist__title">Security checklist</p>
    <ul class="bb-auth-hint-list">
      <% rules.forEach(function (rule) { %>
      <li><%= rule.label %></li>
      <% }) %>
      <li>Passwords match confirmation</li>
    </ul>
  </div>
  <% } else { %>
  <p class="bb-auth-hint">At least 8 characters, one uppercase letter, and one special character.</p>
  <% } %>
  <div class="bb-auth-actions">
    <button class="bb-auth-btn bb-auth-btn--primary" type="submit">Complete password &amp; activate portal</button>
  </div>
</form>

<p class="bb-auth-footer">
  <a href="/member/activate">Back to verification</a>
</p>

<%- include('_shell-end') %>
