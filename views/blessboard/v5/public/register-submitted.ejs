<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Registration received · <%= publicName %></title>
  <meta name="robots" content="noindex, nofollow" />
  <%- include('../partials/head-design-system') %>
  <link rel="stylesheet" href="/blessboard/v5/tenant-auth.css?v=6" />
</head>
<body
  class="bb-auth-body"
  data-bb-shell="tenant-auth"
  data-bb-product="blessboard-v5"
  data-bb-page="register-submitted"
  data-bb-stitch-register-submitted="11-auth-registration-submitted"
>
  <a class="bb-auth-skip" href="#bb-auth-submitted">Skip to confirmation</a>

  <div class="bb-auth-layout">
    <aside class="bb-auth-panel" aria-hidden="true">
      <div class="bb-auth-panel__inner">
        <p class="bb-auth-panel__eyebrow">
          <span class="material-symbols-outlined" aria-hidden="true">mark_email_read</span>
          Application received
        </p>
        <p class="bb-auth-panel__title">Thank you for applying</p>
        <p class="bb-auth-panel__lead">
          Leadership at <%= publicName %> will review your registration. You do not need to resubmit unless asked.
        </p>
      </div>
    </aside>

    <div class="bb-auth-main">
      <header class="bb-auth-main__header">
        <a class="bb-auth-brand" href="/">
          <img
            class="bb-auth-brand__mark"
            src="/church/images/brand/blessboard-small-church-logo.png"
            alt=""
            width="32"
            height="32"
            decoding="async"
          />
          <span>
            <span class="bb-auth-brand__name"><%= publicName %></span>
            <% if (branchName) { %>
            <span class="bb-auth-brand__branch"><%= branchName %></span>
            <% } %>
          </span>
        </a>
        <a class="bb-auth-main__header-link" href="/">Home</a>
      </header>

      <div class="bb-auth-main__body">
        <div
          class="bb-auth-card bb-auth-card--submitted"
          id="bb-auth-submitted"
          data-bb-register-submitted="1"
        >
          <div class="bb-auth-card__icon bb-auth-card__icon--ok" aria-hidden="true">
            <span class="material-symbols-outlined">check_circle</span>
          </div>
          <p class="bb-auth-badge">
            <span class="material-symbols-outlined" aria-hidden="true">hourglass_top</span>
            Pending review
          </p>
          <h1 class="bb-auth-card__title">Registration submitted</h1>
          <p class="bb-auth-card__lead">
            Thank you. Your application has been received and is pending administrator review.
            An account is not created automatically.
          </p>

          <h2 class="bb-auth-card__subtitle">Next steps</h2>
          <ul class="bb-auth-success-list">
            <li>
              <span class="material-symbols-outlined" aria-hidden="true">verified_user</span>
              <span>Church leadership will review your registration when they are ready.</span>
            </li>
            <li>
              <span class="material-symbols-outlined" aria-hidden="true">home</span>
              <span>You can continue browsing the church site while your application is reviewed.</span>
            </li>
            <li>
              <span class="material-symbols-outlined" aria-hidden="true">login</span>
              <span>Member sign-in is available only after leadership approves your registration.</span>
            </li>
            <li>
              <span class="material-symbols-outlined" aria-hidden="true">contact_support</span>
              <span>If you need help, contact the church office using the details you provided or the Contact page.</span>
            </li>
          </ul>

          <div class="bb-auth-actions">
            <a class="bb-auth-btn bb-auth-btn--primary" href="/">Return home</a>
            <a class="bb-auth-btn bb-auth-btn--ghost" href="/contact">Contact office</a>
          </div>
        </div>
      </div>

      <footer class="bb-auth-footer">
        <%- include('../partials/powered-by-getpro') %>
      </footer>
    </div>
  </div>
  <script src="/blessboard/v5/design-system.js?v=2" defer></script>
</body>
</html>
