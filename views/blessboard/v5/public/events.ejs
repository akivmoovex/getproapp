<%#
  Events — Stitch 05-public-events-*-v2 (Populated).
  Desktop: 6f618576f0304982bd239bfe04946e72
  Mobile:  f58c416cbbd545429258d963b3a15b60
  Empty:   6c3a2b460ac54e6a88336af9085e8c38
  List/featured model only (no calendar). Published upcoming via preparePublicEvents.
  Registration only when safe registrationUrl exists.
%>
<%
  var demoFb =
    typeof eventsDemoFallback !== 'undefined' && eventsDemoFallback ? eventsDemoFallback : null;
  var pageSections = (sections || []).filter(function (s) {
    return s && (s.heading || s.bodyText || s.mediaUrl);
  });
  var events = (entities || []).filter(function (e) {
    return e && String(e.title || '').trim();
  });
  var featured = events.length ? events[0] : null;
  var rest = events.length > 1 ? events.slice(1) : [];
  var intro = pageSections.length ? pageSections[0] : null;
  var introHeading =
    (intro && intro.heading) ||
    (demoFb && demoFb.introHeading) ||
    pageTitle ||
    'Gather with Us';
  var introBody =
    (intro && intro.bodyText) ||
    (demoFb && demoFb.introBody) ||
    '';
  var introMedia =
    (intro && intro.mediaUrl) ||
    (demoFb && demoFb.introMediaUrl) ||
    null;
  var featuredParts = featured
    ? formatEventParts(featured.startsAt, featured.timezone, featured.endsAt)
    : null;

  // Stitch display titles accent the trailing phrase without inventing copy.
  var accentBefore = introHeading;
  var accentPhrase = '';
  var headingWords = String(introHeading || '').trim().split(/\s+/).filter(Boolean);
  if (headingWords.length >= 4) {
    accentBefore = headingWords.slice(0, -2).join(' ') + ' ';
    accentPhrase = headingWords.slice(-2).join(' ');
  }
%>

<section
  class="bb-tp-directory bb-tp-events"
  data-bb-events="1"
  data-bb-stitch-events="populated-v2"
>
  <header class="bb-tp-dir-hero bb-tp-dir-hero--center bb-tp-events-hero" aria-label="Events" data-bb-events-hero="1">
    <div class="bb-tp-container">
      <p class="bb-tp-eyebrow bb-tp-eyebrow--pill bb-tp-events-hero__eyebrow-desktop">
        Community Calendar
      </p>
      <p class="bb-tp-eyebrow bb-tp-eyebrow--pill bb-tp-events-hero__eyebrow-mobile">
        Events
      </p>
      <h1 class="bb-tp-dir-hero__title">
        <% if (accentPhrase) { %>
        <%= accentBefore %><span class="bb-tp-events-hero__title-accent"><%= accentPhrase %></span>
        <% } else { %>
        <%= introHeading %>
        <% } %>
      </h1>
      <% if (introBody) { %>
      <p class="bb-tp-dir-hero__lead bb-tp-dir-hero__lead--center"><%= introBody %></p>
      <% } %>
      <% if (introMedia) { %>
      <div class="bb-tp-events-hero__media">
        <img
          class="bb-tp-media"
          src="<%= introMedia %>"
          alt=""
          width="960"
          height="420"
          loading="eager"
          decoding="async"
        />
      </div>
      <% } %>
    </div>
  </header>

  <div class="bb-tp-container bb-tp-directory__body">
    <% if (showEmptyState) { %>
    <div class="bb-tp-empty bb-tp-empty--split" role="status" data-bb-empty="events">
      <div class="bb-tp-empty__visual" aria-hidden="true">
        <span class="material-symbols-outlined bb-tp-empty__icon">event</span>
      </div>
      <div class="bb-tp-empty__copy">
        <p class="bb-tp-empty__badge">No upcoming events</p>
        <h2><%= emptyHeadline %></h2>
        <p><%= emptyMessage %></p>
        <div class="bb-tp-page-hero__cta">
          <a class="bb-tp-btn bb-tp-btn--primary" href="<%= hrefFor('/contact') %>">Contact Us</a>
          <a class="bb-tp-btn bb-tp-btn--ghost" href="<%= typeof homeHref !== 'undefined' && homeHref ? homeHref : '/' %>">Home</a>
        </div>
      </div>
    </div>
    <% } else { %>

    <% if (featured) { %>
    <section class="bb-tp-featured-event" aria-label="Featured event" data-bb-event-featured="1">
      <h2 class="bb-tp-featured-event__label bb-tp-section-title--ruled">Featured Gathering</h2>
      <article class="bb-tp-featured-event__card">
        <div class="bb-tp-featured-event__media<%= featured.imageUrl ? '' : ' is-fallback' %>">
          <% if (featured.imageUrl) { %>
          <img
            src="<%= featured.imageUrl %>"
            alt="<%= featured.title %>"
            width="960"
            height="540"
            loading="eager"
            decoding="async"
          />
          <% } else if (featuredParts.month || featuredParts.day) { %>
          <div
            class="bb-tp-featured-event__badge"
            role="img"
            aria-label="<%= [featuredParts.weekday, featuredParts.month, featuredParts.day].filter(Boolean).join(' ') %>"
          >
            <% if (featuredParts.month) { %><span><%= featuredParts.month %></span><% } %>
            <% if (featuredParts.day) { %><strong><%= featuredParts.day %></strong><% } %>
          </div>
          <% } else { %>
          <span
            class="material-symbols-outlined bb-tp-featured-event__fallback-icon"
            role="img"
            aria-label="<%= featured.title %>"
          >event</span>
          <% } %>
        </div>
        <div class="bb-tp-featured-event__copy">
          <% if (featuredParts.weekday || featuredParts.time) { %>
          <p class="bb-tp-meta bb-tp-meta--accent" data-bb-event-when="1">
            <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
            <% if (featuredParts.weekday) { %><%= featuredParts.weekday %><% if (featuredParts.month) { %>, <%= featuredParts.month %> <%= featuredParts.day %><% } %><% } %>
            <% if (featuredParts.time) { %><% if (featuredParts.weekday) { %> · <% } %><%= featuredParts.time %><% } %>
          </p>
          <% } %>
          <h3 class="bb-tp-featured-event__title"><%= featured.title %></h3>
          <% if (featured.summary) { %>
          <p class="bb-tp-body"><%= featured.summary %></p>
          <% } %>
          <% if (featured.location) { %>
          <p class="bb-tp-meta">
            <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
            <%= featured.location %>
          </p>
          <% } %>
          <div class="bb-tp-page-hero__cta">
            <% if (featured.registrationUrl) { %>
            <a
              class="bb-tp-btn bb-tp-btn--primary"
              href="<%= featured.registrationUrl %>"
              rel="noopener noreferrer"
              data-bb-event-register="1"
              aria-label="Register for <%= featured.title %>"
            >
              Register
              <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
            <% } %>
            <a
              class="bb-tp-btn<%= featured.registrationUrl ? ' bb-tp-btn--ghost' : ' bb-tp-btn--primary' %>"
              href="<%= hrefFor('/contact') %>"
            >
              Contact for Details
              <% if (!featured.registrationUrl) { %>
              <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
              <% } %>
            </a>
          </div>
        </div>
      </article>
    </section>
    <% } %>

    <% if (rest.length) { %>
    <section class="bb-tp-event-list-wrap" aria-label="Upcoming events" data-bb-events-list="1">
      <h2 class="bb-tp-section-title bb-tp-section-title--ruled">Upcoming Events</h2>
      <ul class="bb-tp-event-grid">
        <% rest.forEach(function (event) { %>
        <% var parts = formatEventParts(event.startsAt, event.timezone, event.endsAt); %>
        <li class="bb-tp-event-card" data-bb-event-item="1">
          <div class="bb-tp-event-card__media<%= event.imageUrl ? '' : ' is-fallback' %>">
            <% if (event.imageUrl) { %>
            <img
              src="<%= event.imageUrl %>"
              alt="<%= event.title %>"
              width="400"
              height="240"
              loading="lazy"
              decoding="async"
            />
            <% } else { %>
            <span class="material-symbols-outlined" aria-hidden="true">event</span>
            <% } %>
            <% if (parts.month || parts.day) { %>
            <div
              class="bb-tp-event-card__date"
              role="img"
              aria-label="<%= [parts.month, parts.day].filter(Boolean).join(' ') %>"
            >
              <% if (parts.month) { %><span class="bb-tp-event-card__month"><%= parts.month %></span><% } %>
              <% if (parts.day) { %><strong class="bb-tp-event-card__day"><%= parts.day %></strong><% } %>
            </div>
            <% } %>
          </div>
          <div class="bb-tp-event-card__body">
            <h3 class="bb-tp-event-card__title"><%= event.title %></h3>
            <% if (event.summary) { %>
            <p class="bb-tp-event-card__summary"><%= event.summary %></p>
            <% } %>
            <% if (parts.timeRange || parts.full) { %>
            <p class="bb-tp-meta" data-bb-event-when="1">
              <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
              <%= parts.timeRange || parts.full %>
            </p>
            <% } %>
            <% if (event.location) { %>
            <p class="bb-tp-meta">
              <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
              <%= event.location %>
            </p>
            <% } %>
            <% if (event.registrationUrl) { %>
            <a
              class="bb-tp-btn bb-tp-btn--ghost bb-tp-btn--block"
              href="<%= event.registrationUrl %>"
              rel="noopener noreferrer"
              data-bb-event-register="1"
              aria-label="Register for <%= event.title %>"
            >Register</a>
            <% } else { %>
            <a class="bb-tp-btn bb-tp-btn--ghost bb-tp-btn--block" href="<%= hrefFor('/contact') %>">Contact Church</a>
            <% } %>
          </div>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (pageSections.length > 1) { %>
    <div class="bb-tp-directory__sections">
      <% pageSections.slice(1).forEach(function (section) { %>
      <section
        class="bb-tp-content-block<%= section.mediaUrl ? ' bb-tp-content-block--media' : '' %>"
        data-section="<%= section.sectionKey %>"
      >
        <% if (section.mediaUrl) { %>
        <div class="bb-tp-content-block__media">
          <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="" width="960" height="540" loading="lazy" decoding="async" />
        </div>
        <% } %>
        <div class="bb-tp-content-block__copy">
          <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
          <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
        </div>
      </section>
      <% }) %>
    </div>
    <% } %>

    <% } %>
  </div>
</section>
