<%#
  Phase 7 — Church Website Leadership (Desktop; responsive).
  Stitch: 4d525f9fbba9482f91fadc28ef650d13
  Published leaders preferred; centralized demo soft-fill when none published.
%>
<%
  var demoFb =
    typeof leadershipDemoFallback !== 'undefined' && leadershipDemoFallback
      ? leadershipDemoFallback
      : null;
  var pageSections = (sections || []).filter(function (s) {
    return s && (s.heading || s.bodyText || s.mediaUrl);
  });
  var leaders = (entities || []).filter(function (leader) {
    return leader && String(leader.displayName || '').trim();
  });
  var featured = leaders.length ? leaders[0] : null;
  var team = leaders.length > 1 ? leaders.slice(1, 4) : [];
  var staff = leaders.length > 4 ? leaders.slice(4) : (leaders.length > 1 && leaders.length <= 4 ? [] : []);
  // If 2–4 leaders total, show remaining as team; if more, first 3 after featured are executive team.
  if (leaders.length > 1 && leaders.length <= 4) {
    team = leaders.slice(1);
    staff = [];
  } else if (leaders.length > 4) {
    team = leaders.slice(1, 4);
    staff = leaders.slice(4);
  }

  var intro = pageSections.length ? pageSections[0] : null;
  var introHeading =
    (intro && intro.heading) ||
    (demoFb && demoFb.introHeading) ||
    pageTitle ||
    'Composed Focus, Sacred Leadership';
  var introBody =
    (intro && intro.bodyText) ||
    (demoFb && demoFb.introBody) ||
    '';
  var introMedia =
    (intro && intro.mediaUrl) ||
    (demoFb && demoFb.introMediaUrl) ||
    null;
%>

<section
  class="bb-tp-directory bb-tp-leadership"
  data-bb-leadership="1"
  data-bb-stitch-leadership="phase7-v1"
>
  <%- include('./partials/page-hero', {
    heroHeading: introHeading,
    heroBody: introBody,
    heroMedia: introMedia,
    heroMediaAlt: 'Leadership at ' + publicName,
    heroEyebrow: 'Our Heart for Service',
    heroClass: 'bb-tp-leadership-hero',
    heroCtaPrimary: { href: hrefFor('/contact'), label: 'Connect with Leadership' },
    heroCtaSecondary: { href: hrefFor('/ministries'), label: 'Explore Ministries' }
  }) %>
  <div class="bb-tp-leadership-hero-marker" data-bb-leadership-hero="1" hidden></div>

  <div class="bb-tp-container bb-tp-directory__body">
    <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
    <p class="bb-tp-edit-collection-actions">
      <%- include('../partials/structured-edit-trigger', {
        editKind: 'leader',
        editEntityKey: 'new-' + Date.now(),
        editLabel: 'Add leadership member',
        editPayload: { displayName: '', roleTitle: '', biography: '', imageUrl: '', visible: true, sortOrder: 100 }
      }) %>
      <span class="bb-tp-se-hint">Add leadership member</span>
    </p>
    <% } %>
    <% if (featured) { %>
    <section class="bb-tp-featured-leader" aria-label="Senior leader" data-bb-leadership-featured="1">
      <p class="bb-tp-featured-leader__label"><%= featured.roleTitle || 'Senior Leader' %></p>
      <%- include('./partials/leader-card', { leader: featured, featured: true, bioMax: 480 }) %>
    </section>
    <% } %>

    <% if (team.length) { %>
    <section class="bb-tp-leader-grid-wrap" aria-label="Leadership team" data-bb-leadership-grid="1">
      <h2 class="bb-tp-section-title bb-tp-section-title--ruled">
        <span class="bb-tp-leadership-grid__title-desktop"><%= staff.length ? 'Leadership Team' : 'Ministry Leaders' %></span>
        <span class="bb-tp-leadership-grid__title-mobile"><%= staff.length ? 'Leadership Team' : 'Ministry Leads' %></span>
      </h2>
      <ul class="bb-tp-leader-grid">
        <% team.forEach(function (leader) { %>
        <li>
          <%- include('./partials/leader-card', { leader: leader, featured: false, bioMax: 160 }) %>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (staff.length) { %>
    <section class="bb-tp-leader-grid-wrap bb-tp-leader-grid-wrap--staff" aria-label="Ministry and staff leaders" data-bb-leadership-staff="1">
      <h2 class="bb-tp-section-title bb-tp-section-title--ruled">
        <span class="bb-tp-leadership-grid__title-desktop">Ministry Leaders</span>
        <span class="bb-tp-leadership-grid__title-mobile">Ministry Leads</span>
      </h2>
      <ul class="bb-tp-leader-grid bb-tp-leader-grid--compact">
        <% staff.forEach(function (leader) { %>
        <li>
          <%- include('./partials/leader-card', { leader: leader, featured: false, bioMax: 120 }) %>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (pageSections.length > 1) { %>
    <div class="bb-tp-directory__sections" data-bb-leadership-sections="1">
      <% pageSections.slice(1).forEach(function (section) { %>
      <section
        class="bb-tp-content-block<%= section.mediaUrl ? ' bb-tp-content-block--media' : '' %>"
        data-section="<%= section.sectionKey %>"
      >
        <% if (section.mediaUrl) { %>
        <div class="bb-tp-content-block__media">
          <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="" width="960" height="540" loading="lazy" decoding="async" />
        </div>
        <% } %>
        <div class="bb-tp-content-block__copy">
          <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
          <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
        </div>
      </section>
      <% }) %>
    </div>
    <% } %>
  </div>

  <div data-bb-leadership-cta="1">
  <%- include('./partials/cta-band', {
    ctaClass: 'bb-tp-cta-band--leadership',
    ctaTitle: 'Connect with Leadership',
    ctaBody: 'Reach out with a pastoral question or schedule a conversation with our team.',
    ctaPrimary: { href: hrefFor('/contact'), label: 'Reach Out via Email' },
    ctaSecondary: { href: hrefFor('/ministries'), label: 'Join a Ministry' }
  }) %>
  </div>
</section>
