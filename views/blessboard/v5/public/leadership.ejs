<%#
  Leadership — Stitch populated/empty layouts; published leaders only (sort_order ASC).
  No placeholder people, Contact Pastor, or View Profile actions.
%>
<%
  var pageSections = sections || [];
  var leaders = entities || [];
  var featured = null;
  var others = [];
  leaders.forEach(function (leader) {
    var role = String(leader.roleTitle || '').toLowerCase();
    if (!featured && /pastor|shepherd|senior/.test(role)) {
      featured = leader;
    }
  });
  if (!featured && leaders.length) {
    featured = leaders[0];
  }
  leaders.forEach(function (leader) {
    if (leader !== featured) others.push(leader);
  });
  var intro = pageSections.length ? pageSections[0] : null;
  var introHeading = (intro && intro.heading) || pageTitle || 'Our Leadership';
  var introBody = (intro && intro.bodyText) || '';
%>

<section class="bb-tp-directory bb-tp-leadership" data-bb-leadership="1">
  <header class="bb-tp-dir-hero">
    <div class="bb-tp-container">
      <p class="bb-tp-eyebrow">Faith &amp; Community</p>
      <h1 class="bb-tp-dir-hero__title"><%= introHeading %></h1>
      <% if (introBody) { %>
      <p class="bb-tp-dir-hero__lead"><%= introBody %></p>
      <% } %>
    </div>
  </header>

  <div class="bb-tp-container bb-tp-directory__body">
    <% if (showEmptyState) { %>
    <div class="bb-tp-empty" role="status" data-bb-empty="leadership">
      <span class="material-symbols-outlined bb-tp-empty__icon" aria-hidden="true">groups</span>
      <h2><%= emptyHeadline %></h2>
      <p><%= emptyMessage %></p>
      <div class="bb-tp-page-hero__cta">
        <a class="bb-tp-btn bb-tp-btn--primary" href="/contact">Contact Us</a>
        <a class="bb-tp-btn bb-tp-btn--ghost" href="/about">About</a>
      </div>
    </div>
    <% } else { %>

    <% if (featured) { %>
    <section class="bb-tp-featured-leader" aria-label="Featured leader">
      <% if (featured.roleTitle) { %>
      <p class="bb-tp-featured-leader__label"><%= featured.roleTitle %></p>
      <% } %>
      <article class="bb-tp-featured-leader__card">
        <div class="bb-tp-featured-leader__media<%= featured.imageUrl ? '' : ' is-fallback' %>">
          <% if (featured.imageUrl) { %>
          <img src="<%= featured.imageUrl %>" alt="" width="480" height="560" loading="eager" decoding="async" />
          <% } else { %>
          <div class="bb-tp-avatar bb-tp-avatar--xl" aria-hidden="true"><%= initials(featured.displayName) %></div>
          <% } %>
        </div>
        <div class="bb-tp-featured-leader__copy">
          <h2 class="bb-tp-featured-leader__name"><%= featured.displayName %></h2>
          <% if (featured.roleTitle) { %>
          <p class="bb-tp-featured-leader__role"><%= featured.roleTitle %></p>
          <% } %>
          <% if (featured.biography) { %>
          <p class="bb-tp-body"><%= featured.biography %></p>
          <% } %>
        </div>
      </article>
    </section>
    <% } %>

    <% if (others.length) { %>
    <section class="bb-tp-leader-grid-wrap" aria-label="Ministry leaders">
      <h2 class="bb-tp-section-title">Ministry Leaders</h2>
      <ul class="bb-tp-leader-grid">
        <% others.forEach(function (leader) { %>
        <li class="bb-tp-leader-card">
          <div class="bb-tp-leader-card__media<%= leader.imageUrl ? '' : ' is-fallback' %>">
            <% if (leader.imageUrl) { %>
            <img src="<%= leader.imageUrl %>" alt="" width="320" height="320" loading="lazy" decoding="async" />
            <% } else { %>
            <div class="bb-tp-avatar" aria-hidden="true"><%= initials(leader.displayName) %></div>
            <% } %>
          </div>
          <div class="bb-tp-leader-card__body">
            <h3 class="bb-tp-leader-card__name"><%= leader.displayName %></h3>
            <% if (leader.roleTitle) { %>
            <p class="bb-tp-leader-card__role"><%= leader.roleTitle %></p>
            <% } %>
            <% if (leader.biography) { %>
            <p class="bb-tp-leader-card__bio"><%= leader.biography %></p>
            <% } %>
          </div>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (pageSections.length > 1) { %>
    <div class="bb-tp-directory__sections">
      <% pageSections.slice(1).forEach(function (section) { %>
      <section class="bb-tp-content-block" data-section="<%= section.sectionKey %>">
        <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
        <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
        <% if (section.mediaUrl) { %>
        <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="" loading="lazy" decoding="async" />
        <% } %>
      </section>
      <% }) %>
    </div>
    <% } %>

    <% } %>
  </div>

  <section class="bb-tp-dir-cta">
    <div class="bb-tp-container bb-tp-dir-cta__inner">
      <h2 class="bb-tp-section-title">Want to serve with us?</h2>
      <p class="bb-tp-body">Connect with <%= publicName %> to learn about serving opportunities.</p>
      <div class="bb-tp-page-hero__cta">
        <a class="bb-tp-btn bb-tp-btn--primary" href="/contact">Contact Church</a>
        <a class="bb-tp-btn bb-tp-btn--ghost" href="/ministries">Explore Ministries</a>
      </div>
    </div>
  </section>
</section>
