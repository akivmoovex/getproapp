<%#
  Phase 7 — Church Website Ministries (Desktop; responsive).
  Stitch: 5a52a893e0414bf6962a0c078808d124
  Reuses Stage 2 shell + page-hero / cta-band. Published ministries preferred;
  centralized demo soft-fill when none published. No category filters or unsupported card actions.
%>
<%
  var demoFb =
    typeof ministriesDemoFallback !== 'undefined' && ministriesDemoFallback
      ? ministriesDemoFallback
      : null;
  var pageSections = (sections || []).filter(function (s) {
    return s && (s.heading || s.bodyText || s.mediaUrl);
  });
  var ministries = (entities || []).filter(function (m) {
    return m && String(m.name || '').trim();
  });
  var featured = ministries.length ? ministries.slice(0, Math.min(3, ministries.length)) : [];
  var rest = ministries.length > 3 ? ministries.slice(3) : [];
  var intro = pageSections.length ? pageSections[0] : null;
  var introHeading =
    (intro && intro.heading) ||
    (demoFb && demoFb.introHeading) ||
    pageTitle ||
    'A Space to Belong and Grow';
  var introBody =
    (intro && intro.bodyText) ||
    (demoFb && demoFb.introBody) ||
    '';
  var introMedia =
    (intro && intro.mediaUrl) ||
    (demoFb && demoFb.introMediaUrl) ||
    null;

  var summaryMax = 160;
  function ministrySummary(m) {
    var raw = String((m && (m.summary || m.description)) || '').replace(/\s+/g, ' ').trim();
    if (!raw) return '';
    return raw.length <= summaryMax ? raw : (raw.slice(0, summaryMax - 1) + '…');
  }

  var audienceGroups = [];
  var audienceSeen = {};
  ministries.forEach(function (m) {
    var key = String(m.audience || '').trim();
    if (!key) return;
    if (!audienceSeen[key]) {
      audienceSeen[key] = true;
      audienceGroups.push(key);
    }
  });
%>

<section
  class="bb-tp-directory bb-tp-ministries"
  data-bb-ministries="1"
  data-bb-stitch-ministries="phase7-v1"
  aria-label="Ministries"
>
  <%- include('./partials/page-hero', {
    heroHeading: introHeading,
    heroBody: introBody,
    heroMedia: introMedia,
    heroMediaAlt: 'Ministries at ' + publicName,
    heroEyebrow: (intro && intro.layoutMetadata && intro.layoutMetadata.eyebrow) || 'Our Community Ecosystem',
    heroClass: 'bb-tp-ministries-hero',
    heroCtaPrimary: { href: hrefFor('/contact'), label: 'Join a Ministry' },
    heroCtaSecondary: { href: hrefFor('/events'), label: 'View Events' },
    heroLayoutMetadata: (intro && intro.layoutMetadata) || null,
    editPageKey: 'ministries',
    editSectionKey: 'hero'
  }) %>
  <div class="bb-tp-ministries-hero-marker" data-bb-ministries-hero="1" hidden></div>

  <div class="bb-tp-container bb-tp-directory__body">
    <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode && !featured.length) { %>
    <p class="bb-tp-edit-collection-actions">
      <%- include('../partials/structured-edit-trigger', {
        editKind: 'ministry',
        editEntityKey: 'new-ministry',
        editLabel: 'Add ministry',
        editPayload: { name: '', summary: '', description: '', visible: true, featured: false }
      }) %>
      <span class="bb-tp-se-hint">Add ministry</span>
    </p>
    <% } %>
    <% if (featured.length) { %>
    <section class="bb-tp-ministry-featured" aria-label="Featured ministries" data-bb-ministries-featured="1" data-bb-ministries-grid="1">
      <h2 class="bb-tp-section-title bb-tp-section-title--ruled">Weekly Gatherings
      <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
      <%- include('../partials/structured-edit-trigger', {
        editKind: 'ministry',
        editEntityKey: 'new-ministry',
        editLabel: 'Add ministry',
        editPayload: { name: '', summary: '', description: '', visible: true, featured: false }
      }) %>
      <% } %>
      </h2>
      <ul class="bb-tp-ministry-grid bb-tp-ministry-grid--featured">
        <% featured.forEach(function (ministry, index) { %>
        <li class="bb-tp-ministry-card" data-bb-ministry-card="1">
          <div class="bb-tp-ministry-card__media<%= ministry.imageUrl ? '' : ' is-fallback' %>">
            <% if (ministry.imageUrl) { %>
            <img
              src="<%= ministry.imageUrl %>"
              alt="<%= ministry.name %>"
              width="640"
              height="400"
              loading="<%= index === 0 ? 'eager' : 'lazy' %>"
              decoding="async"
            />
            <% } else { %>
            <span class="material-symbols-outlined bb-tp-ministry-card__fallback-icon" role="img" aria-label="<%= ministry.name %>">groups</span>
            <% } %>
          </div>
          <div class="bb-tp-ministry-card__body">
            <h3 class="bb-tp-ministry-card__title">
              <%= ministry.name %>
              <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
              <%- include('../partials/structured-edit-trigger', {
                editKind: 'ministry',
                editEntityKey: String(ministry.id || ('ministry-' + ministry.name)),
                editLabel: 'Edit ' + ministry.name,
                editPayload: {
                  name: ministry.name,
                  summary: ministry.summary,
                  description: ministry.description,
                  meetingDay: ministry.meetingDay,
                  contactEmail: ministry.contactEmail,
                  imageUrl: ministry.imageUrl,
                  visible: true
                }
              }) %>
              <% } %>
            </h3>
            <% var featuredSummary = ministrySummary(ministry); %>
            <% if (featuredSummary) { %>
            <p class="bb-tp-ministry-card__summary"><%= featuredSummary %></p>
            <% } %>
            <% if (ministry.meetingDay) { %>
            <p class="bb-tp-meta">
              <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
              <span><%= ministry.meetingDay %></span>
            </p>
            <% } %>
            <% if (ministry.audience) { %>
            <p class="bb-tp-meta">
              <span class="material-symbols-outlined" aria-hidden="true">groups</span>
              <span><%= ministry.audience %></span>
            </p>
            <% } %>
            <% if (ministry.leaderName) { %>
            <p class="bb-tp-meta">
              <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>
              <span>Leader: <%= ministry.leaderName %></span>
            </p>
            <% } %>
            <% if (ministry.contactEmail && ministry.contactHref) { %>
            <p class="bb-tp-meta" data-bb-ministry-contact="1">
              <span class="material-symbols-outlined" aria-hidden="true">mail</span>
              <a href="<%= ministry.contactHref %>" aria-label="Email <%= ministry.name %>"><%= ministry.contactEmail %></a>
            </p>
            <% } else { %>
            <p class="bb-tp-ministry-card__action">
              <a class="bb-tp-btn bb-tp-btn--ghost bb-tp-btn--block" href="<%= hrefFor('/contact') %>">Contact for details</a>
            </p>
            <% } %>
          </div>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (rest.length) { %>
    <section class="bb-tp-ministry-list-wrap" aria-label="More ministries" data-bb-ministries-more="1">
      <h2 class="bb-tp-section-title bb-tp-section-title--ruled">More Ministries</h2>
      <% if (audienceGroups.length > 1) { %>
      <p class="bb-tp-lead bb-tp-ministries-audiences" data-bb-ministries-audiences="1">
        Serving: <%= audienceGroups.join(' · ') %>
      </p>
      <% } %>
      <ul class="bb-tp-ministry-grid">
        <% rest.forEach(function (ministry) { %>
        <li class="bb-tp-ministry-card" data-bb-ministry-card="1">
          <div class="bb-tp-ministry-card__media<%= ministry.imageUrl ? '' : ' is-fallback' %>">
            <% if (ministry.imageUrl) { %>
            <img src="<%= ministry.imageUrl %>" alt="<%= ministry.name %>" width="640" height="400" loading="lazy" decoding="async" />
            <% } else { %>
            <span class="material-symbols-outlined bb-tp-ministry-card__fallback-icon" role="img" aria-label="<%= ministry.name %>">groups</span>
            <% } %>
          </div>
          <div class="bb-tp-ministry-card__body">
            <h3 class="bb-tp-ministry-card__title">
              <%= ministry.name %>
              <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
              <%- include('../partials/structured-edit-trigger', {
                editKind: 'ministry',
                editEntityKey: String(ministry.id || ('ministry-' + ministry.name)),
                editLabel: 'Edit ' + ministry.name,
                editPayload: {
                  name: ministry.name,
                  summary: ministry.summary,
                  description: ministry.description,
                  meetingDay: ministry.meetingDay,
                  contactEmail: ministry.contactEmail,
                  imageUrl: ministry.imageUrl,
                  visible: true
                }
              }) %>
              <% } %>
            </h3>
            <% var moreSummary = ministrySummary(ministry); %>
            <% if (moreSummary) { %>
            <p class="bb-tp-ministry-card__summary"><%= moreSummary %></p>
            <% } %>
            <% if (ministry.meetingDay) { %>
            <p class="bb-tp-meta">
              <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
              <span><%= ministry.meetingDay %></span>
            </p>
            <% } %>
            <% if (ministry.audience) { %>
            <p class="bb-tp-meta">
              <span class="material-symbols-outlined" aria-hidden="true">groups</span>
              <span><%= ministry.audience %></span>
            </p>
            <% } %>
            <% if (ministry.leaderName) { %>
            <p class="bb-tp-meta">
              <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>
              <span>Leader: <%= ministry.leaderName %></span>
            </p>
            <% } %>
            <% if (ministry.contactEmail && ministry.contactHref) { %>
            <p class="bb-tp-meta" data-bb-ministry-contact="1">
              <span class="material-symbols-outlined" aria-hidden="true">mail</span>
              <a href="<%= ministry.contactHref %>" aria-label="Email <%= ministry.name %>"><%= ministry.contactEmail %></a>
            </p>
            <% } %>
          </div>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (pageSections.length > 1) { %>
    <div class="bb-tp-directory__sections" data-bb-ministries-sections="1">
      <% pageSections.slice(1).forEach(function (section) { %>
      <section
        class="bb-tp-content-block<%= section.mediaUrl ? ' bb-tp-content-block--media' : '' %>"
        data-section="<%= section.sectionKey %>"
      >
        <% if (section.mediaUrl) { %>
        <div class="bb-tp-content-block__media">
          <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="<%= (section.layoutMetadata && section.layoutMetadata.altText) || '' %>" width="960" height="540" loading="lazy" decoding="async" />
        </div>
        <% } %>
        <div class="bb-tp-content-block__copy">
          <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
          <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
        </div>
      </section>
      <% }) %>
    </div>
    <% } %>
  </div>

  <div data-bb-ministries-cta="1">
  <%- include('./partials/cta-band', {
    ctaClass: 'bb-tp-cta-band--ministries',
    ctaTitle: 'Find Your Place in the Mission',
    ctaBody: 'Growth happens best in community. Reach out to find a ministry fit at ' + publicName + '.',
    ctaPrimary: { href: hrefFor('/contact'), label: 'Start Volunteering' },
    ctaSecondary: { href: hrefFor('/contact'), label: 'Ask a Question' }
  }) %>
  </div>
</section>
