<%#
  Ministries — Stitch 04-public-ministries-*-v4 (Populated).
  Desktop: f146cdccadb34ff3bd8b0b75a0450d15
  Mobile:  d2fd7ecc586541d3beb5d0d3bed98d56
  Published ministries only (sort_order ASC). No category filters,
  unsupported per-card actions, file guides, or sample ministries.
%>
<%
  var demoFb =
    typeof ministriesDemoFallback !== 'undefined' && ministriesDemoFallback
      ? ministriesDemoFallback
      : null;
  var pageSections = (sections || []).filter(function (s) {
    return s && (s.heading || s.bodyText || s.mediaUrl);
  });
  var ministries = (entities || []).filter(function (m) {
    return m && String(m.name || '').trim();
  });
  var intro = pageSections.length ? pageSections[0] : null;
  var introHeading =
    (intro && intro.heading) ||
    (demoFb && demoFb.introHeading) ||
    pageTitle ||
    'Our Ministries';
  var introBody =
    (intro && intro.bodyText) ||
    (demoFb && demoFb.introBody) ||
    '';
  var introMedia = intro && intro.mediaUrl ? intro.mediaUrl : null;

  var accentBefore = introHeading;
  var accentPhrase = '';
  var headingWords = String(introHeading || '').trim().split(/\s+/).filter(Boolean);
  if (headingWords.length >= 4) {
    accentBefore = headingWords.slice(0, -2).join(' ') + ' ';
    accentPhrase = headingWords.slice(-2).join(' ');
  }
%>

<section
  class="bb-tp-directory bb-tp-ministries"
  data-bb-ministries="1"
  data-bb-stitch-ministries="populated-v4"
>
  <header class="bb-tp-dir-hero bb-tp-dir-hero--center bb-tp-ministries-hero" aria-label="Ministries" data-bb-ministries-hero="1">
    <div class="bb-tp-container">
      <p class="bb-tp-eyebrow bb-tp-eyebrow--pill bb-tp-ministries-hero__eyebrow-desktop">
        Our Impact
      </p>
      <p class="bb-tp-eyebrow bb-tp-eyebrow--pill bb-tp-ministries-hero__eyebrow-mobile">
        Our Community
      </p>
      <h1 class="bb-tp-dir-hero__title">
        <% if (accentPhrase) { %>
        <%= accentBefore %><span class="bb-tp-ministries-hero__title-accent"><%= accentPhrase %></span>
        <% } else { %>
        <%= introHeading %>
        <% } %>
      </h1>
      <% if (introBody) { %>
      <p class="bb-tp-dir-hero__lead bb-tp-dir-hero__lead--center"><%= introBody %></p>
      <% } %>
      <div class="bb-tp-page-hero__cta bb-tp-page-hero__cta--center bb-tp-ministries-hero__cta">
        <a class="bb-tp-btn bb-tp-btn--primary" href="<%= hrefFor('/contact') %>">
          <span class="material-symbols-outlined" aria-hidden="true">volunteer_activism</span>
          Join a Ministry
        </a>
        <a class="bb-tp-btn bb-tp-btn--ghost" href="<%= hrefFor('/events') %>">
          <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
          View Events
        </a>
      </div>
      <% if (introMedia) { %>
      <div class="bb-tp-ministries-hero__media">
        <img
          class="bb-tp-media"
          src="<%= introMedia %>"
          alt=""
          width="960"
          height="420"
          loading="eager"
          decoding="async"
        />
      </div>
      <% } %>
    </div>
  </header>

  <div class="bb-tp-container bb-tp-directory__body">
    <% if (showEmptyState) { %>
    <div class="bb-tp-empty bb-tp-empty--split" role="status" data-bb-empty="ministries">
      <div class="bb-tp-empty__visual" aria-hidden="true">
        <span class="material-symbols-outlined bb-tp-empty__icon">diversity_3</span>
      </div>
      <div class="bb-tp-empty__copy">
        <p class="bb-tp-empty__badge">Update in progress</p>
        <h2><%= emptyHeadline %></h2>
        <p><%= emptyMessage %></p>
        <div class="bb-tp-page-hero__cta">
          <a class="bb-tp-btn bb-tp-btn--primary" href="<%= hrefFor('/contact') %>">Contact Us</a>
          <a class="bb-tp-btn bb-tp-btn--ghost" href="/register">Register</a>
        </div>
      </div>
    </div>
    <% } else if (ministries.length) { %>
    <ul class="bb-tp-ministry-grid" aria-label="Published ministries" data-bb-ministries-grid="1">
      <% ministries.forEach(function (ministry, index) { %>
      <li class="bb-tp-ministry-card<%= index === 0 ? ' bb-tp-ministry-card--featured' : '' %>" data-bb-ministry-card="1">
        <div class="bb-tp-ministry-card__media<%= ministry.imageUrl ? '' : ' is-fallback' %>">
          <% if (ministry.imageUrl) { %>
          <img
            src="<%= ministry.imageUrl %>"
            alt="<%= ministry.name %>"
            width="640"
            height="400"
            loading="<%= index === 0 ? 'eager' : 'lazy' %>"
            decoding="async"
          />
          <% } else { %>
          <span
            class="material-symbols-outlined bb-tp-ministry-card__fallback-icon"
            role="img"
            aria-label="<%= ministry.name %>"
          >groups</span>
          <% } %>
        </div>
        <div class="bb-tp-ministry-card__body">
          <h2 class="bb-tp-ministry-card__title"><%= ministry.name %></h2>
          <% if (ministry.summary) { %>
          <p class="bb-tp-ministry-card__summary"><%= ministry.summary %></p>
          <% } else if (ministry.description) { %>
          <p class="bb-tp-ministry-card__summary"><%= ministry.description %></p>
          <% } %>
          <% if (ministry.meetingDay) { %>
          <p class="bb-tp-meta">
            <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
            <span><%= ministry.meetingDay %></span>
          </p>
          <% } %>
          <% if (ministry.contactEmail && ministry.contactHref) { %>
          <p class="bb-tp-meta" data-bb-ministry-contact="1">
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            <a href="<%= ministry.contactHref %>" aria-label="Email <%= ministry.name %>"><%= ministry.contactEmail %></a>
          </p>
          <% } %>
        </div>
      </li>
      <% }) %>
    </ul>
    <% } %>

    <% if (!showEmptyState && pageSections.length > 1) { %>
    <div class="bb-tp-directory__sections" data-bb-ministries-sections="1">
      <% pageSections.slice(1).forEach(function (section) { %>
      <section
        class="bb-tp-content-block<%= section.mediaUrl ? ' bb-tp-content-block--media' : '' %>"
        data-section="<%= section.sectionKey %>"
      >
        <% if (section.mediaUrl) { %>
        <div class="bb-tp-content-block__media">
          <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="" width="960" height="540" loading="lazy" decoding="async" />
        </div>
        <% } %>
        <div class="bb-tp-content-block__copy">
          <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
          <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
        </div>
      </section>
      <% }) %>
    </div>
    <% } %>
  </div>

  <section class="bb-tp-dir-cta bb-tp-dir-cta--soft bb-tp-ministries-cta" aria-label="Get involved" data-bb-ministries-cta="1">
    <div class="bb-tp-container">
      <div class="bb-tp-dir-cta__inner bb-tp-ministries-cta__inner">
        <h2 class="bb-tp-section-title">Still looking for your place?</h2>
        <p class="bb-tp-body">Reach out — we will help you find a ministry fit at <%= publicName %>.</p>
        <div class="bb-tp-page-hero__cta bb-tp-ministries-cta__actions">
          <a class="bb-tp-btn bb-tp-btn--primary" href="<%= hrefFor('/contact') %>">
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            Contact Us
          </a>
          <a class="bb-tp-btn bb-tp-btn--ghost" href="/register">Register as a Member</a>
        </div>
      </div>
    </div>
  </section>
</section>
