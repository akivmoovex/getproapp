<%#
  Phase 7 — Church Website About (Desktop; responsive).
  Stitch: 3736c7550483404282d5ba9914962c40
  Published CMS fields preferred; centralized demo soft-fill when sparse.
%>
<%
  function classifyAboutSection(s) {
    var key = String(s.sectionKey || '').toLowerCase();
    var type = String(s.sectionType || '').toLowerCase();
    var heading = String(s.heading || '').toLowerCase();
    var blob = key + ' ' + type + ' ' + heading;
    if (blob.indexOf('mission') >= 0) return 'mission';
    if (blob.indexOf('vision') >= 0) return 'vision';
    if (blob.indexOf('value') >= 0) return 'values';
    if (blob.indexOf('belief') >= 0 || blob.indexOf('foundation') >= 0) return 'beliefs';
    if (blob.indexOf('community') >= 0 || blob.indexOf('involvement') >= 0) return 'community';
    if (blob.indexOf('gallery') >= 0) return 'gallery';
    if (blob.indexOf('story') >= 0 || blob.indexOf('history') >= 0) return 'story';
    return 'generic';
  }

  function sectionHasContent(s) {
    return Boolean(s && (s.heading || s.bodyText || s.mediaUrl));
  }

  var demoFb = typeof aboutDemoFallback !== 'undefined' && aboutDemoFallback ? aboutDemoFallback : null;
  var VALUE_ICONS = ['auto_awesome', 'groups', 'menu_book', 'volunteer_activism', 'favorite'];

  var hero = null;
  var rest = [];
  (sections || []).forEach(function (s) {
    if (!sectionHasContent(s)) return;
    var isHero = !hero && (s.sectionType === 'hero' || String(s.sectionKey || '').indexOf('hero') >= 0);
    if (isHero) hero = s;
    else rest.push(s);
  });
  if (!hero && rest.length) hero = rest.shift();

  var heroHeading =
    (hero && hero.heading) ||
    (demoFb && demoFb.heroHeading) ||
    pageTitle ||
    ('About ' + publicName);
  var heroBody = (hero && hero.bodyText) || (demoFb && demoFb.heroBody) || '';
  var heroMedia =
    (hero && hero.mediaUrl) ||
    (demoFb && demoFb.heroMediaUrl) ||
    null;

  var storySections = [];
  var missionSection = null;
  var visionSection = null;
  var valueSections = [];
  var beliefsSection = null;
  var communitySection = null;
  var galleryUrls = [];
  var genericSections = [];

  rest.forEach(function (s) {
    if (!sectionHasContent(s)) return;
    var kind = classifyAboutSection(s);
    if (kind === 'story') storySections.push(s);
    else if (kind === 'mission' && !missionSection) missionSection = s;
    else if (kind === 'vision' && !visionSection) visionSection = s;
    else if (kind === 'values') valueSections.push(s);
    else if (kind === 'beliefs' && !beliefsSection) beliefsSection = s;
    else if (kind === 'community' && !communitySection) communitySection = s;
    else if (kind === 'gallery' && s.mediaUrl) galleryUrls.push(s.mediaUrl);
    else genericSections.push(s);
  });

  if (!storySections.length && demoFb && demoFb.story && sectionHasContent(demoFb.story)) {
    storySections = [demoFb.story];
  }
  if (!missionSection && demoFb && demoFb.mission) missionSection = demoFb.mission;
  if (!visionSection && demoFb && demoFb.vision) visionSection = demoFb.vision;
  if (!valueSections.length && demoFb && demoFb.values) {
    valueSections = Array.isArray(demoFb.values) ? demoFb.values.slice() : [demoFb.values];
  }
  if (!beliefsSection && demoFb && demoFb.beliefs) beliefsSection = demoFb.beliefs;
  if (!communitySection && demoFb && demoFb.community) communitySection = demoFb.community;
  if (!galleryUrls.length && demoFb && demoFb.gallery) galleryUrls = demoFb.gallery.slice();

  var storyMedia = [];
  storySections.forEach(function (s) {
    if (s.mediaUrl && storyMedia.indexOf(s.mediaUrl) < 0) storyMedia.push(s.mediaUrl);
  });
  if (!storyMedia.length && demoFb && demoFb.storyMediaUrl) storyMedia.push(demoFb.storyMediaUrl);
%>

<section class="bb-tp-about" data-bb-about="1" data-bb-stitch-about="phase7-v1">
  <div data-bb-about-hero="1">
  <%- include('./partials/page-hero', {
    heroHeading: heroHeading,
    heroBody: heroBody,
    heroMedia: heroMedia,
    heroMediaAlt: publicName + ' building',
    heroEyebrow: 'About Us',
    heroClass: 'bb-tp-about-hero',
    heroCtaPrimary: { href: hrefFor('/contact'), label: 'Plan Your Visit' },
    heroCtaSecondary: { href: hrefFor('/leadership'), label: 'Meet Leadership' },
    editPageKey: 'about',
    editSectionKey: 'hero'
  }) %>
  </div>

  <% if (storySections.length) { %>
  <section class="bb-tp-about-story-band" aria-label="Church story" data-bb-about-story="1" id="bb-tp-about-story">
    <div class="bb-tp-container bb-tp-about__story-wrap">
      <div class="bb-tp-about-story<%= storyMedia.length ? ' bb-tp-about-story--with-media' : '' %>">
        <div class="bb-tp-about-story__copy">
          <% storySections.forEach(function (section, idx) { %>
          <div class="bb-tp-about-story__block" data-section="<%= section.sectionKey || 'story' %>">
            <% if (section.heading) { %>
            <h2 class="bb-tp-section-title<%= idx === 0 ? ' bb-tp-about-story__title' : '' %>"><%= section.heading %></h2>
            <% } %>
            <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
          </div>
          <% }) %>
        </div>
        <% if (storyMedia.length) { %>
        <div class="bb-tp-about-story__media">
          <img class="bb-tp-media" src="<%= storyMedia[0] %>" alt="Life at <%= publicName %>" width="960" height="720" loading="lazy" decoding="async" />
        </div>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (missionSection || visionSection) { %>
  <section class="bb-tp-about-purpose" aria-label="Mission and vision" data-bb-about-purpose="1">
    <div class="bb-tp-container">
      <header class="bb-tp-about-purpose__header">
        <h2 class="bb-tp-section-title">Mission &amp; Vision</h2>
      </header>
      <div class="bb-tp-about-purpose__grid<%= missionSection && visionSection ? ' bb-tp-about-purpose__grid--pair' : '' %>">
        <% if (missionSection && sectionHasContent(missionSection)) { %>
        <article class="bb-tp-purpose-card" data-section="<%= missionSection.sectionKey || 'mission' %>" data-bb-about-mission="1">
          <span class="bb-tp-purpose-card__icon material-symbols-outlined" aria-hidden="true">flag</span>
          <% if (missionSection.heading) { %><h3 class="bb-tp-purpose-card__title"><%= missionSection.heading %></h3><% } %>
          <% if (missionSection.bodyText) { %><p class="bb-tp-body"><%= missionSection.bodyText %></p><% } %>
        </article>
        <% } %>
        <% if (visionSection && sectionHasContent(visionSection)) { %>
        <article class="bb-tp-purpose-card bb-tp-purpose-card--accent" data-section="<%= visionSection.sectionKey || 'vision' %>" data-bb-about-vision="1">
          <span class="bb-tp-purpose-card__icon material-symbols-outlined" aria-hidden="true">visibility</span>
          <% if (visionSection.heading) { %><h3 class="bb-tp-purpose-card__title"><%= visionSection.heading %></h3><% } %>
          <% if (visionSection.bodyText) { %><p class="bb-tp-body"><%= visionSection.bodyText %></p><% } %>
        </article>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (valueSections.length) { %>
  <section class="bb-tp-about-values" aria-label="Core values" data-bb-about-values="1">
    <div class="bb-tp-container">
      <h2 class="bb-tp-section-title bb-tp-about-values__heading">Core Values</h2>
      <ul class="bb-tp-about-values__list">
        <% valueSections.forEach(function (section, idx) { %>
        <% if (!sectionHasContent(section)) return; %>
        <li class="bb-tp-about-values__item" data-section="<%= section.sectionKey || ('values-' + idx) %>">
          <span class="bb-tp-about-values__icon material-symbols-outlined" aria-hidden="true"><%= VALUE_ICONS[idx % VALUE_ICONS.length] %></span>
          <div>
            <% if (section.heading) { %><h3 class="bb-tp-about-values__title"><%= section.heading %></h3><% } %>
            <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
          </div>
        </li>
        <% }) %>
      </ul>
    </div>
  </section>
  <% } %>

  <% if (beliefsSection && sectionHasContent(beliefsSection)) { %>
  <section class="bb-tp-container bb-tp-about-beliefs" data-bb-about-beliefs="1" aria-labelledby="bb-tp-about-beliefs-heading">
    <h2 id="bb-tp-about-beliefs-heading" class="bb-tp-section-title"><%= beliefsSection.heading || 'Beliefs' %></h2>
    <% if (beliefsSection.bodyText) { %><p class="bb-tp-body"><%= beliefsSection.bodyText %></p><% } %>
  </section>
  <% } %>

  <% if (communitySection && sectionHasContent(communitySection)) { %>
  <section class="bb-tp-about-community" data-bb-about-community="1" aria-labelledby="bb-tp-about-community-heading">
    <div class="bb-tp-container">
      <h2 id="bb-tp-about-community-heading" class="bb-tp-section-title"><%= communitySection.heading || 'Community involvement' %></h2>
      <% if (communitySection.bodyText) { %><p class="bb-tp-body"><%= communitySection.bodyText %></p><% } %>
    </div>
  </section>
  <% } %>

  <% if (galleryUrls.length) { %>
  <section class="bb-tp-container bb-tp-about-gallery" data-bb-about-gallery="1" aria-label="Image gallery">
    <h2 class="bb-tp-section-title">Life at <%= publicName %></h2>
    <ul class="bb-tp-about-gallery__grid">
      <% galleryUrls.slice(0, 6).forEach(function (url, idx) { %>
      <li>
        <img src="<%= url %>" alt="Community moment <%= idx + 1 %> at <%= publicName %>" width="640" height="480" loading="lazy" decoding="async" />
      </li>
      <% }) %>
    </ul>
  </section>
  <% } %>

  <% if (genericSections.length) { %>
  <div class="bb-tp-container bb-tp-about__body" data-bb-about-generic="1">
    <% genericSections.forEach(function (section) { %>
    <% if (!sectionHasContent(section)) return; %>
    <section class="bb-tp-content-block<%= section.mediaUrl ? ' bb-tp-content-block--media' : '' %>" data-section="<%= section.sectionKey %>">
      <% if (section.mediaUrl) { %>
      <div class="bb-tp-content-block__media">
        <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="" width="960" height="540" loading="lazy" decoding="async" />
      </div>
      <% } %>
      <div class="bb-tp-content-block__copy">
        <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
        <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
      </div>
    </section>
    <% }) %>
  </div>
  <% } %>

  <div data-bb-about-join="1">
  <%- include('./partials/cta-band', {
    ctaClass: 'bb-tp-cta-band--visit',
    ctaTitle: 'Experience ' + publicName,
    ctaBody: 'Whether you are a seeker or a long-time believer, there is a seat for you. Join us this Sunday.',
    ctaPrimary: { href: hrefFor('/contact'), label: 'Plan Your Visit' },
    ctaSecondary: { href: hrefFor('/contact'), label: 'Get Directions' }
  }) %>
  </div>
</section>
