<%#
  Phase 7 — Church Website About (Desktop; responsive).
  Stitch: 3736c7550483404282d5ba9914962c40
  Published CMS fields preferred; centralized demo soft-fill when sparse.
%>
<%
  function classifyAboutSection(s) {
    var key = String(s.sectionKey || '').toLowerCase();
    var type = String(s.sectionType || '').toLowerCase();
    var heading = String(s.heading || '').toLowerCase();
    var blob = key + ' ' + type + ' ' + heading;
    if (blob.indexOf('mission') >= 0) return 'mission';
    if (blob.indexOf('vision') >= 0) return 'vision';
    if (blob.indexOf('value') >= 0) return 'values';
    if (blob.indexOf('belief') >= 0 || blob.indexOf('foundation') >= 0) return 'beliefs';
    if (blob.indexOf('community') >= 0 || blob.indexOf('involvement') >= 0) return 'community';
    if (blob.indexOf('gallery') >= 0) return 'gallery';
    if (blob.indexOf('story') >= 0 || blob.indexOf('history') >= 0) return 'story';
    return 'generic';
  }

  function sectionHasContent(s) {
    return Boolean(s && (s.heading || s.bodyText || s.mediaUrl));
  }

  var demoFb = typeof aboutDemoFallback !== 'undefined' && aboutDemoFallback ? aboutDemoFallback : null;
  var VALUE_ICONS = ['auto_awesome', 'groups', 'menu_book', 'volunteer_activism', 'favorite'];

  var hero = null;
  var rest = [];
  (sections || []).forEach(function (s) {
    if (!sectionHasContent(s)) return;
    var isHero = !hero && (s.sectionType === 'hero' || String(s.sectionKey || '').indexOf('hero') >= 0);
    if (isHero) hero = s;
    else rest.push(s);
  });
  if (!hero && rest.length) hero = rest.shift();

  var heroHeading =
    (hero && hero.heading) ||
    (demoFb && demoFb.heroHeading) ||
    pageTitle ||
    ('About ' + publicName);
  var heroBody = (hero && hero.bodyText) || (demoFb && demoFb.heroBody) || '';
  var heroMedia =
    (hero && hero.mediaUrl) ||
    (demoFb && demoFb.heroMediaUrl) ||
    null;

  var storySections = [];
  var missionSection = null;
  var visionSection = null;
  var valueSections = [];
  var beliefsSection = null;
  var communitySection = null;
  var galleryUrls = [];
  var genericSections = [];

  rest.forEach(function (s) {
    if (!sectionHasContent(s)) return;
    var kind = classifyAboutSection(s);
    if (kind === 'story') storySections.push(s);
    else if (kind === 'mission' && !missionSection) missionSection = s;
    else if (kind === 'vision' && !visionSection) visionSection = s;
    else if (kind === 'values') valueSections.push(s);
    else if (kind === 'beliefs' && !beliefsSection) beliefsSection = s;
    else if (kind === 'community' && !communitySection) communitySection = s;
    else if (kind === 'gallery' && s.mediaUrl) galleryUrls.push(s.mediaUrl);
    else genericSections.push(s);
  });

  if (!storySections.length && demoFb && demoFb.story && sectionHasContent(demoFb.story)) {
    storySections = [demoFb.story];
  }
  if (!missionSection && demoFb && demoFb.mission) missionSection = demoFb.mission;
  if (!visionSection && demoFb && demoFb.vision) visionSection = demoFb.vision;
  if (!valueSections.length && demoFb && demoFb.values) {
    valueSections = Array.isArray(demoFb.values) ? demoFb.values.slice() : [demoFb.values];
  }
  if (!beliefsSection && demoFb && demoFb.beliefs) beliefsSection = demoFb.beliefs;
  if (!communitySection && demoFb && demoFb.community) communitySection = demoFb.community;
  if (!galleryUrls.length && demoFb && demoFb.gallery) galleryUrls = demoFb.gallery.slice();

  var storyMedia = [];
  storySections.forEach(function (s) {
    if (s.mediaUrl && storyMedia.indexOf(s.mediaUrl) < 0) storyMedia.push(s.mediaUrl);
  });
  if (!storyMedia.length && demoFb && demoFb.storyMediaUrl) storyMedia.push(demoFb.storyMediaUrl);

  /* Avoid repeating mission/vision/story blocks already rendered above. */
  genericSections = genericSections.filter(function (s) {
    var kind = classifyAboutSection(s);
    if (kind === 'mission' || kind === 'vision' || kind === 'story' || kind === 'values' || kind === 'beliefs' || kind === 'community') {
      return false;
    }
    var heading = String(s.heading || '').toLowerCase();
    if (missionSection && heading && heading === String(missionSection.heading || '').toLowerCase()) return false;
    if (visionSection && heading && heading === String(visionSection.heading || '').toLowerCase()) return false;
    return true;
  });
%>

<section class="bb-tp-about" data-bb-about="1" data-bb-stitch-about="phase7-v1">
  <div data-bb-about-hero="1">
  <%- include('./partials/page-hero', {
    heroHeading: heroHeading,
    heroBody: heroBody,
    heroMedia: heroMedia,
    heroMediaAlt: publicName + ' building',
    heroEyebrow: (hero && hero.layoutMetadata && hero.layoutMetadata.eyebrow) || 'About Us',
    heroClass: 'bb-tp-about-hero',
    heroCtaPrimary: { href: hrefFor('/contact'), label: 'Plan Your Visit' },
    heroCtaSecondary: { href: hrefFor('/leadership'), label: 'Meet Leadership' },
    heroLayoutMetadata: (hero && hero.layoutMetadata) || null,
    editPageKey: 'about',
    editSectionKey: 'hero'
  }) %>
  </div>

  <% if (storySections.length) { %>
  <section class="bb-tp-about-story-band" aria-label="Church story" data-bb-about-story="1" id="bb-tp-about-story">
    <div class="bb-tp-container bb-tp-about__story-wrap">
      <div class="bb-tp-about-story<%= storyMedia.length ? ' bb-tp-about-story--with-media' : '' %>">
        <div class="bb-tp-about-story__copy">
          <% storySections.forEach(function (section, idx) { %>
          <div class="bb-tp-about-story__block" data-section="<%= section.sectionKey || 'story' %>">
            <% var storyKey = idx === 0 ? 'story' : (section.sectionKey || ('story-' + idx)); %>
            <% if (section.heading || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode && idx === 0)) { %>
            <%- include('../partials/editable-text', {
              editPageKey: 'about',
              editSectionKey: storyKey,
              editFieldKey: 'heading',
              editValue: section.heading || '',
              editTag: 'h2',
              editClass: 'bb-tp-section-title' + (idx === 0 ? ' bb-tp-about-story__title' : ''),
              editType: 'heading',
              editMaxLength: 120,
              editMultiline: false
            }) %>
            <% } %>
            <% if (section.bodyText || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode && idx === 0)) { %>
            <%- include('../partials/editable-text', {
              editPageKey: 'about',
              editSectionKey: storyKey,
              editFieldKey: 'bodyText',
              editValue: section.bodyText || '',
              editTag: 'p',
              editClass: 'bb-tp-body bb-tp-prose-narrow',
              editType: 'paragraph',
              editMaxLength: 4000,
              editMultiline: true
            }) %>
            <% } %>
          </div>
          <% }) %>
        </div>
        <% if (storyMedia.length || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) { %>
        <div class="bb-tp-about-story__media">
          <% if (storyMedia.length) { %>
          <img class="bb-tp-media" src="<%= storyMedia[0] %>" alt="Life at <%= publicName %>" width="960" height="720" loading="lazy" decoding="async" />
          <% } %>
          <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
          <div class="bb-tp-edit-media-wrap">
            <%- include('../partials/structured-edit-trigger', {
              editKind: 'image',
              editEntityKey: 'about-story',
              editSectionKey: 'story',
              editLabel: 'Edit story image',
              editPayload: { imageUrl: storyMedia[0] || '', altText: 'Life at ' + publicName, focal: 'center' }
            }) %>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (missionSection || visionSection || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) { %>
  <section class="bb-tp-about-purpose" aria-label="Mission and vision" data-bb-about-purpose="1">
    <div class="bb-tp-container">
      <header class="bb-tp-about-purpose__header">
        <h2 class="bb-tp-section-title">Mission &amp; Vision</h2>
      </header>
      <div class="bb-tp-about-purpose__grid<%= (missionSection || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) && (visionSection || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) ? ' bb-tp-about-purpose__grid--pair' : '' %>">
        <% if (missionSection || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) { %>
        <article class="bb-tp-purpose-card" data-section="<%= (missionSection && missionSection.sectionKey) || 'mission' %>" data-bb-about-mission="1">
          <span class="bb-tp-purpose-card__icon material-symbols-outlined" aria-hidden="true">flag</span>
          <%- include('../partials/editable-text', {
            editPageKey: 'about',
            editSectionKey: 'mission',
            editFieldKey: 'heading',
            editValue: (missionSection && missionSection.heading) || '',
            editTag: 'h3',
            editClass: 'bb-tp-purpose-card__title',
            editType: 'heading',
            editMaxLength: 120,
            editMultiline: false
          }) %>
          <%- include('../partials/editable-text', {
            editPageKey: 'about',
            editSectionKey: 'mission',
            editFieldKey: 'bodyText',
            editValue: (missionSection && missionSection.bodyText) || '',
            editTag: 'p',
            editClass: 'bb-tp-body',
            editType: 'paragraph',
            editMaxLength: 2000,
            editMultiline: true
          }) %>
        </article>
        <% } %>
        <% if (visionSection || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) { %>
        <article class="bb-tp-purpose-card bb-tp-purpose-card--accent" data-section="<%= (visionSection && visionSection.sectionKey) || 'vision' %>" data-bb-about-vision="1">
          <span class="bb-tp-purpose-card__icon material-symbols-outlined" aria-hidden="true">visibility</span>
          <%- include('../partials/editable-text', {
            editPageKey: 'about',
            editSectionKey: 'vision',
            editFieldKey: 'heading',
            editValue: (visionSection && visionSection.heading) || '',
            editTag: 'h3',
            editClass: 'bb-tp-purpose-card__title',
            editType: 'heading',
            editMaxLength: 120,
            editMultiline: false
          }) %>
          <%- include('../partials/editable-text', {
            editPageKey: 'about',
            editSectionKey: 'vision',
            editFieldKey: 'bodyText',
            editValue: (visionSection && visionSection.bodyText) || '',
            editTag: 'p',
            editClass: 'bb-tp-body',
            editType: 'paragraph',
            editMaxLength: 2000,
            editMultiline: true
          }) %>
        </article>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (valueSections.length || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode && demoFb && demoFb.values)) { %>
  <section class="bb-tp-about-values" aria-label="Core values" data-bb-about-values="1">
    <div class="bb-tp-container">
      <%- include('../partials/editable-text', {
        editPageKey: 'about',
        editSectionKey: 'values',
        editFieldKey: 'heading',
        editValue: (demoFb && demoFb.valuesHeading) || 'Core Values',
        editTag: 'h2',
        editClass: 'bb-tp-section-title bb-tp-about-values__heading',
        editType: 'heading',
        editMaxLength: 120,
        editMultiline: false
      }) %>
      <ul class="bb-tp-about-values__list">
        <% valueSections.forEach(function (section, idx) { %>
        <% if (!sectionHasContent(section) && !(typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) return; %>
        <% var valueKey = section.sectionKey || ('value_' + idx); %>
        <li class="bb-tp-about-values__item" data-section="<%= valueKey %>">
          <span class="bb-tp-about-values__icon material-symbols-outlined" aria-hidden="true"><%= VALUE_ICONS[idx % VALUE_ICONS.length] %></span>
          <div>
            <%- include('../partials/editable-text', {
              editPageKey: 'about',
              editSectionKey: valueKey,
              editFieldKey: 'heading',
              editValue: section.heading || '',
              editTag: 'h3',
              editClass: 'bb-tp-about-values__title',
              editType: 'heading',
              editMaxLength: 120,
              editMultiline: false
            }) %>
            <%- include('../partials/editable-text', {
              editPageKey: 'about',
              editSectionKey: valueKey,
              editFieldKey: 'bodyText',
              editValue: section.bodyText || '',
              editTag: 'p',
              editClass: 'bb-tp-body',
              editType: 'paragraph',
              editMaxLength: 1000,
              editMultiline: true
            }) %>
          </div>
        </li>
        <% }) %>
      </ul>
    </div>
  </section>
  <% } %>

  <% if ((beliefsSection && sectionHasContent(beliefsSection)) || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode && beliefsSection)) { %>
  <section class="bb-tp-container bb-tp-about-beliefs" data-bb-about-beliefs="1" aria-labelledby="bb-tp-about-beliefs-heading">
    <%- include('../partials/editable-text', {
      editPageKey: 'about',
      editSectionKey: 'beliefs',
      editFieldKey: 'heading',
      editValue: (beliefsSection && beliefsSection.heading) || 'Beliefs',
      editTag: 'h2',
      editClass: 'bb-tp-section-title',
      editType: 'heading',
      editId: 'bb-tp-about-beliefs-heading',
      editMaxLength: 120,
      editMultiline: false
    }) %>
    <%- include('../partials/editable-text', {
      editPageKey: 'about',
      editSectionKey: 'beliefs',
      editFieldKey: 'bodyText',
      editValue: (beliefsSection && beliefsSection.bodyText) || '',
      editTag: 'p',
      editClass: 'bb-tp-body bb-tp-prose-narrow',
      editType: 'paragraph',
      editMaxLength: 4000,
      editMultiline: true
    }) %>
  </section>
  <% } %>

  <% if ((communitySection && sectionHasContent(communitySection)) || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode && communitySection)) { %>
  <section class="bb-tp-about-community" data-bb-about-community="1" aria-labelledby="bb-tp-about-community-heading">
    <div class="bb-tp-container">
      <%- include('../partials/editable-text', {
        editPageKey: 'about',
        editSectionKey: 'community',
        editFieldKey: 'heading',
        editValue: (communitySection && communitySection.heading) || 'Community involvement',
        editTag: 'h2',
        editClass: 'bb-tp-section-title',
        editType: 'heading',
        editId: 'bb-tp-about-community-heading',
        editMaxLength: 120,
        editMultiline: false
      }) %>
      <%- include('../partials/editable-text', {
        editPageKey: 'about',
        editSectionKey: 'community',
        editFieldKey: 'bodyText',
        editValue: (communitySection && communitySection.bodyText) || '',
        editTag: 'p',
        editClass: 'bb-tp-body bb-tp-prose-narrow',
        editType: 'paragraph',
        editMaxLength: 2000,
        editMultiline: true
      }) %>
      <% if ((communitySection && communitySection.mediaUrl) || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) { %>
      <div class="bb-tp-about-community__media">
        <% if (communitySection && communitySection.mediaUrl) { %>
        <img class="bb-tp-media" src="<%= communitySection.mediaUrl %>" alt="<%= (communitySection.layoutMetadata && communitySection.layoutMetadata.altText) || '' %>" width="960" height="540" loading="lazy" decoding="async" />
        <% } %>
        <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
        <div class="bb-tp-edit-media-wrap">
          <%- include('../partials/structured-edit-trigger', {
            editKind: 'image',
            editEntityKey: 'about-community',
            editSectionKey: 'community',
            editLabel: 'Edit neighbourhood image',
            editPayload: { imageUrl: (communitySection && communitySection.mediaUrl) || '', altText: (communitySection && communitySection.layoutMetadata && communitySection.layoutMetadata.altText) || '', focal: 'center' }
          }) %>
        </div>
        <% } %>
      </div>
      <% } %>
    </div>
  </section>
  <% } %>

  <% if (galleryUrls.length || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) { %>
  <section class="bb-tp-container bb-tp-about-gallery" data-bb-about-gallery="1" aria-label="Image gallery">
    <%- include('../partials/editable-text', {
      editPageKey: 'about',
      editSectionKey: 'gallery',
      editFieldKey: 'heading',
      editValue: (demoFb && demoFb.galleryHeading) || ('Life at ' + publicName),
      editTag: 'h2',
      editClass: 'bb-tp-section-title',
      editType: 'heading',
      editMaxLength: 120,
      editMultiline: false
    }) %>
    <ul class="bb-tp-about-gallery__grid">
      <% var gallerySlots = galleryUrls.slice(0, 6); %>
      <% if (!gallerySlots.length && typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { gallerySlots = ['', '', '']; } %>
      <% gallerySlots.forEach(function (url, idx) { %>
      <% var galleryKey = 'gallery_' + (idx + 1); %>
      <li>
        <% if (url) { %>
        <img src="<%= url %>" alt="Community moment <%= idx + 1 %> at <%= publicName %>" width="640" height="480" loading="lazy" decoding="async" />
        <% } %>
        <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
        <div class="bb-tp-edit-media-wrap">
          <%- include('../partials/structured-edit-trigger', {
            editKind: 'image',
            editEntityKey: 'about-' + galleryKey,
            editSectionKey: galleryKey,
            editLabel: 'Edit gallery image ' + (idx + 1),
            editPayload: { imageUrl: url || '', altText: 'Community moment ' + (idx + 1) + ' at ' + publicName, focal: 'center' }
          }) %>
        </div>
        <% if (idx < 3) { %>
        <%- include('../partials/editable-text', {
          editPageKey: 'about',
          editSectionKey: galleryKey,
          editFieldKey: 'heading',
          editValue: '',
          editTag: 'p',
          editClass: 'bb-tp-about-gallery__caption',
          editType: 'label',
          editMaxLength: 120,
          editMultiline: false
        }) %>
        <% } %>
        <% } %>
      </li>
      <% }) %>
    </ul>
  </section>
  <% } %>

  <% if (genericSections.length) { %>
  <div class="bb-tp-container bb-tp-about__body" data-bb-about-generic="1">
    <% genericSections.forEach(function (section) { %>
    <% if (!sectionHasContent(section)) return; %>
    <section class="bb-tp-content-block<%= section.mediaUrl ? ' bb-tp-content-block--media' : '' %>" data-section="<%= section.sectionKey %>">
      <% if (section.mediaUrl || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) { %>
      <div class="bb-tp-content-block__media">
        <% if (section.mediaUrl) { %>
        <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="<%= (section.layoutMetadata && section.layoutMetadata.altText) || '' %>" width="960" height="540" loading="lazy" decoding="async" />
        <% } %>
        <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
        <div class="bb-tp-edit-media-wrap">
          <%- include('../partials/structured-edit-trigger', {
            editKind: 'image',
            editEntityKey: 'about-' + (section.sectionKey || 'block'),
            editSectionKey: section.sectionKey || 'generic',
            editLabel: 'Edit section image',
            editPayload: { imageUrl: section.mediaUrl || '', altText: (section.layoutMetadata && section.layoutMetadata.altText) || '', focal: 'center' }
          }) %>
        </div>
        <% } %>
      </div>
      <% } %>
      <div class="bb-tp-content-block__copy">
        <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
        <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
      </div>
    </section>
    <% }) %>
  </div>
  <% } %>

  <div data-bb-about-join="1">
  <%- include('./partials/cta-band', {
    ctaClass: 'bb-tp-cta-band--visit',
    ctaTitle: (demoFb && demoFb.visitorCtaHeading) || ('Experience ' + publicName),
    ctaBody: (demoFb && demoFb.visitorCtaBody) || ('Whether you are a seeker or a long-time believer, there is a seat for you at ' + publicName + '. Join us this Sunday.'),
    ctaPrimary: {
      href: hrefFor('/contact'),
      label: (demoFb && demoFb.visitorCtaButtonText) || 'Plan Your Visit'
    },
    ctaSecondary: { href: hrefFor('/contact'), label: 'Get Directions' },
    editPageKey: 'about',
    editSectionKey: 'visitor_cta'
  }) %>
  </div>
</section>
