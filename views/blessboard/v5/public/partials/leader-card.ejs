<%#
  Shared leader card.
  Locals: leader, featured (optional boolean), bioMax (optional)
%>
<%
  var _featured = typeof featured !== 'undefined' && featured;
  var _bioMax = typeof bioMax !== 'undefined' ? bioMax : (_featured ? 400 : 140);
  var _bio = '';
  if (leader && leader.biography) {
    var t = String(leader.biography).replace(/\s+/g, ' ').trim();
    _bio = t.length <= _bioMax ? t : (t.slice(0, _bioMax - 1) + '…');
  }
  var _img = leader && leader.imageUrl ? leader.imageUrl : null;
  if (_img && typeof presentImageSrc === 'function') {
    _img = presentImageSrc(_img) || null;
  }
  var _wa = typeof websiteAdmin !== 'undefined' && websiteAdmin ? websiteAdmin : null;
  var _leaderKey = leader && (leader.id || leader.entityKey)
    ? String(leader.id || leader.entityKey)
    : '';
  var _canEdit = Boolean(_wa && _wa.editingMode && _leaderKey);
  var _nameClean = String(leader && leader.displayName || '')
    .replace(/\s*\(template example\)\s*$/i, '')
    .trim();
  var _roleClean = String(leader && leader.roleTitle || '')
    .replace(/\s*\(template example\)\s*$/i, '')
    .trim();
  var _bioClean = String(leader && leader.biography || '')
    .replace(/\s*\(template example\)\s*$/i, '')
    .trim();
%>
<article
  class="bb-tp-leader-card<%= _featured ? ' bb-tp-leader-card--featured' : '' %><%= leader && leader.templateExample ? ' bb-tp-leader-card--template' : '' %><%= _canEdit ? ' bb-tp-leader-card--editable' : '' %>"
  <% if (leader && leader.templateExample) { %> data-bb-template-example="leader"<% } %>
  <% if (_canEdit) { %> data-bb-leader-card="1" data-bb-leader-id="<%= _leaderKey %>"<% } %>
>
  <div class="bb-tp-leader-card__media<%= _img ? ' has-media' : ' is-fallback' %><%= _canEdit ? ' bb-tp-edit-media-wrap' : '' %>">
    <% if (_img) { %>
    <img
      src="<%= _img %>"
      alt="<%= leader.templateExample ? 'Template portrait' : leader.displayName %>"
      width="<%= _featured ? 480 : 400 %>"
      height="<%= _featured ? 600 : 400 %>"
      loading="<%= _featured ? 'eager' : 'lazy' %>"
      decoding="async"
      data-bb-leader-image="1"
    />
    <% } else { %>
    <div class="bb-tp-avatar<%= _featured ? ' bb-tp-avatar--xl' : '' %>" role="img" aria-label="<%= leader.displayName %>">
      <%= initials(leader.displayName) %>
    </div>
    <% } %>
    <% if (_canEdit) { %>
    <%- include('../../partials/entity-image-edit-trigger', {
      editKind: 'leader',
      editEntityKey: _leaderKey,
      editPayload: {
        displayName: _nameClean,
        roleTitle: _roleClean,
        biography: _bioClean,
        imageUrl: leader.imageUrl || '',
        sortOrder: leader.sortOrder != null ? leader.sortOrder : 10,
        seniorLeader: Boolean(_featured || leader.seniorLeader),
        visible: leader.visible !== false,
        contactPublic: Boolean(leader.contactPublic),
        email: leader.email || '',
        phone: leader.phone || '',
        socialUrl: leader.socialUrl || ''
      }
    }) %>
    <% } %>
  </div>
  <div class="bb-tp-leader-card__body">
    <% if (_featured && leader.roleTitle) { %>
    <p class="bb-tp-leader-card__eyebrow"><%= leader.roleTitle %></p>
    <% } %>
    <h3 class="bb-tp-leader-card__name<%= _featured ? ' bb-tp-featured-leader__name' : '' %>">
      <%= leader.displayName %>
    </h3>
    <% if (!_featured && leader.roleTitle) { %>
    <p class="bb-tp-leader-card__role" data-bb-leader-role="1"><%= leader.roleTitle %></p>
    <% } else if (_featured && leader.roleTitle) { %>
    <p class="bb-tp-leader-card__role" data-bb-leader-role="1"><%= leader.roleTitle %></p>
    <% } %>
    <% if (_bio) { %>
    <p class="bb-tp-leader-card__bio" data-bb-leader-bio="1"><%= _bio %></p>
    <% } %>
    <% if (leader.contactHref) { %>
    <a class="bb-tp-leader-card__contact" href="<%= leader.contactHref %>">Contact</a>
    <% } %>
    <% if (_canEdit) { %>
    <div class="bb-tp-leader-card__edit-actions">
      <%- include('../../partials/structured-edit-trigger', {
        editKind: 'leader',
        editEntityKey: _leaderKey,
        editLabel: 'Edit details',
        editDialogTitle: 'Edit details',
        editButtonText: 'Edit details',
        editPayload: {
          displayName: _nameClean,
          roleTitle: _roleClean,
          biography: _bioClean,
          imageUrl: leader.imageUrl || '',
          sortOrder: leader.sortOrder != null ? leader.sortOrder : 10,
          seniorLeader: Boolean(_featured || leader.seniorLeader),
          visible: leader.visible !== false,
          contactPublic: Boolean(leader.contactPublic),
          email: leader.email || '',
          phone: leader.phone || '',
          socialUrl: leader.socialUrl || ''
        }
      }) %>
    </div>
    <% } %>
  </div>
</article>
