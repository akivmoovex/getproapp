<%#
  Content-block media with structured image edit (Replace / Add).
  Locals: section (required), editPageKey (optional)
%>
<%
  var _sec = typeof section !== 'undefined' && section ? section : null;
  var _page = typeof editPageKey !== 'undefined' && editPageKey ? String(editPageKey) : '';
  var _wa = typeof websiteAdmin !== 'undefined' && websiteAdmin ? websiteAdmin : null;
  var _editing = Boolean(_wa && _wa.editingMode);
  var _media = _sec && _sec.mediaUrl ? String(_sec.mediaUrl) : '';
  if (_media && typeof presentImageSrc === 'function') {
    _media = presentImageSrc(_media) || '';
  }
  var _alt = (_sec && _sec.layoutMetadata && _sec.layoutMetadata.altText) || '';
  var _sectionKey = _sec && _sec.sectionKey ? String(_sec.sectionKey) : 'content';
  var _placement = (_sec && _sec.layoutMetadata && _sec.layoutMetadata.imagePlacement) || null;
  var _ps =
    typeof presentImagePlacementStyle === 'function'
      ? presentImagePlacementStyle(_placement)
      : { className: '', style: '' };
%>
<% if (_media || _editing) { %>
<div class="bb-tp-content-block__media">
  <% if (_media) { %>
  <img class="bb-tp-media<%= _ps.className ? ' ' + _ps.className : '' %>" src="<%= _media %>" alt="<%= _alt %>" width="960" height="540" loading="lazy" decoding="async"<% if (_ps.style) { %> style="<%= _ps.style %>"<% } %> />
  <% } else if (_editing) { %>
  <div class="bb-tp-media bb-tp-media--empty" data-bb-media-empty="1" aria-hidden="true"></div>
  <% } %>
  <% if (_editing) { %>
  <div class="bb-tp-edit-media-wrap">
    <%- include('../../partials/structured-edit-trigger', {
      editKind: 'image',
      editEntityKey: (_page ? _page + '-' : '') + _sectionKey + '-image',
      editSectionKey: _sectionKey,
      editLabel: _media ? 'Replace section image' : 'Add section image',
      editPayload: { imageUrl: _media, altText: _alt, focal: (_sec && _sec.layoutMetadata && _sec.layoutMetadata.focal) || 'center', placement: _placement }
    }) %>
  </div>
  <% } %>
</div>
<% } %>
