<%- include('../partials/tenant-public-shell-start') %>

<% if (pageKey === 'home') { %>
  <%- include('./home') %>
<% } else if (pageKey === 'about') { %>
  <%- include('./about') %>
<% } else if (pageKey === 'leadership') { %>
  <%- include('./leadership') %>
<% } else if (pageKey === 'ministries') { %>
  <%- include('./ministries') %>
<% } else if (pageKey === 'events') { %>
  <%- include('./events') %>
<% } else if (pageKey === 'sermons') { %>
  <%- include('./sermons') %>
<% } else if (pageKey === 'contact') { %>
  <%- include('./contact') %>
<% } else if (pageKey === 'giving') { %>
  <%- include('./giving') %>
<% } else { %>
  <div class="bb-tp-container bb-tp-legacy-page">
    <h1 class="bb-tp-legacy-page__title"><%= pageTitle %></h1>

    <% if (showEmptyState) { %>
    <%- include('./partials/empty-state') %>
    <% } %>

    <% if (sections && sections.length) { %>
      <% sections.forEach(function (section) { %>
      <section class="bb-tp-section bb-tp-content-block<%= section.mediaUrl || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) ? ' bb-tp-content-block--media' : '' %>" data-section="<%= section.sectionKey %>">
        <% if (section.heading) { %><h2><%= section.heading %></h2><% } %>
        <% if (section.bodyText) { %><p><%= section.bodyText %></p><% } %>
        <%- include('./partials/content-block-media', { section: section, editPageKey: pageKey || 'page' }) %>
      </section>
      <% }) %>
    <% } %>
  </div>
<% } %>

<%- include('../partials/tenant-public-shell-end') %>
