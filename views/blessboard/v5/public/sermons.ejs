<%#
  Sermons & Resources — Stitch 06-public-sermons-*-v2 (Populated).
  Desktop: 4f4995dc4ec84354ac80ed022a767ef3
  Mobile:  96b380d4e47649c1bd7f05cabe9c3a1d
  Empty:   0c7262cdda4547739ec0c1fa5128fb51
  Published only (preached_at DESC). mediaUrl / resourceUrl only when safeExternalUrl allows.
  No series, scripture, duration, thumbnails, embeds, filters, or fabricated archive.
%>
<%
  var pageSections = sections || [];
  var sermons = entities || [];
  var featured = sermons.length ? sermons[0] : null;
  var rest = sermons.length > 1 ? sermons.slice(1) : [];
  var intro = pageSections.length ? pageSections[0] : null;
  var introHeading = (intro && intro.heading) || pageTitle || 'Sermons & Resources';
  var introBody = (intro && intro.bodyText) || '';
  var introMedia = intro && intro.mediaUrl ? intro.mediaUrl : null;

  var accentBefore = introHeading;
  var accentPhrase = '';
  var headingWords = String(introHeading || '').trim().split(/\s+/).filter(Boolean);
  if (headingWords.length >= 3) {
    accentBefore = headingWords.slice(0, -1).join(' ') + ' ';
    accentPhrase = headingWords.slice(-1).join(' ');
  }

  function mediaLabel(kind, title) {
    if (kind === 'audio') return 'Listen to sermon: ' + title;
    if (kind === 'video') return 'Watch sermon: ' + title;
    return 'Open media for sermon: ' + title;
  }
  function mediaButton(kind) {
    if (kind === 'audio') return { icon: 'headphones', text: 'Listen' };
    if (kind === 'video') return { icon: 'play_circle', text: 'Watch Sermon' };
    return { icon: 'play_circle', text: 'Watch or Listen' };
  }
  function resourceLabel(kind, title) {
    if (kind === 'download') return 'Download notes for sermon: ' + title;
    return 'Open resources for sermon: ' + title;
  }
  function resourceButton(kind) {
    if (kind === 'download') return { icon: 'download', text: 'Download' };
    return { icon: 'menu_book', text: 'Resources' };
  }
%>

<section
  class="bb-tp-directory bb-tp-sermons"
  data-bb-sermons="1"
  data-bb-stitch-sermons="populated-v2"
>
  <header class="bb-tp-dir-hero bb-tp-dir-hero--center bb-tp-sermons-hero" aria-label="Sermons">
    <div class="bb-tp-container">
      <p class="bb-tp-eyebrow bb-tp-eyebrow--pill bb-tp-sermons-hero__eyebrow-desktop">
        Teaching Library
      </p>
      <p class="bb-tp-eyebrow bb-tp-eyebrow--pill bb-tp-sermons-hero__eyebrow-mobile">
        Sermons
      </p>
      <h1 class="bb-tp-dir-hero__title">
        <% if (accentPhrase) { %>
        <%= accentBefore %><span class="bb-tp-sermons-hero__title-accent"><%= accentPhrase %></span>
        <% } else { %>
        <%= introHeading %>
        <% } %>
      </h1>
      <% if (introBody) { %>
      <p class="bb-tp-dir-hero__lead bb-tp-dir-hero__lead--center"><%= introBody %></p>
      <% } %>
      <% if (introMedia) { %>
      <div class="bb-tp-sermons-hero__media">
        <img
          class="bb-tp-media"
          src="<%= introMedia %>"
          alt=""
          width="960"
          height="420"
          loading="eager"
          decoding="async"
        />
      </div>
      <% } %>
    </div>
  </header>

  <div class="bb-tp-container bb-tp-directory__body">
    <% if (showEmptyState) { %>
    <div class="bb-tp-empty bb-tp-empty--split" role="status" data-bb-empty="sermons">
      <div class="bb-tp-empty__visual" aria-hidden="true">
        <span class="material-symbols-outlined bb-tp-empty__icon">menu_book</span>
      </div>
      <div class="bb-tp-empty__copy">
        <p class="bb-tp-empty__badge">No sermons published</p>
        <h2><%= emptyHeadline %></h2>
        <p><%= emptyMessage %></p>
        <div class="bb-tp-page-hero__cta">
          <a class="bb-tp-btn bb-tp-btn--primary" href="/contact">Contact Us</a>
          <a class="bb-tp-btn bb-tp-btn--ghost" href="/events">View Events</a>
        </div>
      </div>
    </div>
    <% } else { %>

    <% if (featured) { %>
    <%
      var featuredKind = featured.mediaUrl ? sermonMediaKind(featured.mediaUrl) : null;
      var featuredBtn = featuredKind ? mediaButton(featuredKind) : null;
      var featuredResKind = featured.resourceUrl ? sermonResourceKind(featured.resourceUrl) : null;
      var featuredResBtn = featuredResKind ? resourceButton(featuredResKind) : null;
    %>
    <section class="bb-tp-featured-sermon" aria-label="Featured sermon" data-bb-sermon-featured="1">
      <p class="bb-tp-featured-sermon__label bb-tp-featured-sermon__label--desktop">
        <span class="material-symbols-outlined" aria-hidden="true">star</span>
        Featured Sermon
      </p>
      <p class="bb-tp-featured-sermon__label bb-tp-featured-sermon__label--mobile">
        Latest Release
      </p>
      <article class="bb-tp-featured-sermon__card">
        <div class="bb-tp-featured-sermon__copy">
          <h2 class="bb-tp-featured-sermon__title"><%= featured.title %></h2>
          <% if (featured.speakerName || featured.preachedAt) { %>
          <p class="bb-tp-meta bb-tp-featured-sermon__meta">
            <% if (featured.speakerName) { %>
            <span class="bb-tp-meta__item">
              <span class="material-symbols-outlined" aria-hidden="true">person</span>
              <%= featured.speakerName %>
            </span>
            <% } %>
            <% if (featured.preachedAt) { %>
            <span class="bb-tp-meta__item">
              <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
              <%= formatDate(featured.preachedAt) %>
            </span>
            <% } %>
          </p>
          <% } %>
          <% if (featured.summary) { %>
          <p class="bb-tp-body"><%= featured.summary %></p>
          <% } %>
          <% if (featured.mediaUrl || featured.resourceUrl) { %>
          <div class="bb-tp-page-hero__cta bb-tp-featured-sermon__actions">
            <% if (featured.mediaUrl && featuredBtn) { %>
            <a
              class="bb-tp-btn bb-tp-btn--primary bb-tp-featured-sermon__cta-desktop"
              href="<%= featured.mediaUrl %>"
              rel="noopener noreferrer"
              data-bb-sermon-media="1"
              data-bb-media-kind="<%= featuredKind %>"
              aria-label="<%= mediaLabel(featuredKind, featured.title) %>"
            >
              <span class="material-symbols-outlined" aria-hidden="true"><%= featuredBtn.icon %></span>
              <%= featuredBtn.text %>
            </a>
            <% } %>
            <% if (featured.resourceUrl && featuredResBtn) { %>
            <a
              class="bb-tp-btn bb-tp-btn--ghost"
              href="<%= featured.resourceUrl %>"
              rel="noopener noreferrer"
              data-bb-sermon-resource="1"
              data-bb-resource-kind="<%= featuredResKind %>"
              aria-label="<%= resourceLabel(featuredResKind, featured.title) %>"
            >
              <span class="material-symbols-outlined" aria-hidden="true"><%= featuredResBtn.icon %></span>
              <%= featuredResBtn.text %>
            </a>
            <% } %>
          </div>
          <% } %>
        </div>
        <% if (featured.mediaUrl && featuredBtn) { %>
        <a
          class="bb-tp-featured-sermon__play bb-tp-featured-sermon__play--mobile"
          href="<%= featured.mediaUrl %>"
          rel="noopener noreferrer"
          data-bb-sermon-media="1"
          data-bb-media-kind="<%= featuredKind %>"
          aria-label="<%= mediaLabel(featuredKind, featured.title) %>"
        >
          <span class="material-symbols-outlined" aria-hidden="true">play_arrow</span>
        </a>
        <% } %>
      </article>
    </section>
    <% } %>

    <% if (rest.length) { %>
    <section class="bb-tp-sermon-list-wrap" aria-label="Recent sermons">
      <div class="bb-tp-sermon-list-wrap__head">
        <h2 class="bb-tp-section-title bb-tp-section-title--ruled">Recent Sermons</h2>
      </div>
      <ul class="bb-tp-sermon-grid">
        <% rest.forEach(function (sermon) { %>
        <%
          var kind = sermon.mediaUrl ? sermonMediaKind(sermon.mediaUrl) : null;
          var btn = kind ? mediaButton(kind) : null;
          var resKind = sermon.resourceUrl ? sermonResourceKind(sermon.resourceUrl) : null;
          var resBtn = resKind ? resourceButton(resKind) : null;
          var thumbLabel = sermon.title || 'Sermon';
        %>
        <li class="bb-tp-sermon-card" data-bb-sermon-item="1">
          <div
            class="bb-tp-sermon-card__media is-fallback"
            role="img"
            aria-label="<%= thumbLabel %>"
          >
            <span class="material-symbols-outlined bb-tp-sermon-card__fallback-icon" aria-hidden="true">menu_book</span>
          </div>
          <div class="bb-tp-sermon-card__body">
            <h3 class="bb-tp-sermon-card__title"><%= sermon.title %></h3>
            <% if (sermon.speakerName || sermon.preachedAt) { %>
            <p class="bb-tp-meta bb-tp-sermon-card__meta">
              <% if (sermon.speakerName) { %>
              <span class="bb-tp-meta__item">
                <span class="material-symbols-outlined" aria-hidden="true">person</span>
                <%= sermon.speakerName %>
              </span>
              <% } %>
              <% if (sermon.preachedAt) { %>
              <span class="bb-tp-meta__item">
                <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
                <%= formatDate(sermon.preachedAt) %>
              </span>
              <% } %>
            </p>
            <% } %>
            <% if (sermon.summary) { %>
            <p class="bb-tp-sermon-card__summary"><%= sermon.summary %></p>
            <% } %>
            <% if (sermon.mediaUrl || sermon.resourceUrl) { %>
            <p class="bb-tp-sermon-card__actions">
              <% if (sermon.mediaUrl && btn) { %>
              <a
                href="<%= sermon.mediaUrl %>"
                rel="noopener noreferrer"
                data-bb-sermon-media="1"
                data-bb-media-kind="<%= kind %>"
                aria-label="<%= mediaLabel(kind, sermon.title) %>"
              >
                <span class="material-symbols-outlined" aria-hidden="true"><%= kind === 'audio' ? 'headphones' : 'play_arrow' %></span>
                <%= kind === 'audio' ? 'Listen' : (kind === 'video' ? 'Watch' : 'Open') %>
              </a>
              <% } %>
              <% if (sermon.resourceUrl && resBtn) { %>
              <a
                href="<%= sermon.resourceUrl %>"
                rel="noopener noreferrer"
                data-bb-sermon-resource="1"
                data-bb-resource-kind="<%= resKind %>"
                aria-label="<%= resourceLabel(resKind, sermon.title) %>"
              >
                <span class="material-symbols-outlined" aria-hidden="true"><%= resBtn.icon %></span>
                <%= resKind === 'download' ? 'Notes' : 'Resources' %>
              </a>
              <% } %>
            </p>
            <% } %>
          </div>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (pageSections.length > 1) { %>
    <div class="bb-tp-directory__sections">
      <% pageSections.slice(1).forEach(function (section) { %>
      <section class="bb-tp-content-block" data-section="<%= section.sectionKey %>">
        <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
        <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
        <% if (section.mediaUrl) { %>
        <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="" loading="lazy" decoding="async" />
        <% } %>
      </section>
      <% }) %>
    </div>
    <% } %>

    <% } %>
  </div>
</section>
