<%#
  Phase 7 — Church Website Sermons (Desktop; responsive).
  Stitch: d85d37f3bba84ac48d8d3f24b01b2010
  Published only. No search/filter UI (not functional). Series via category when present.
  Media links only when safeExternalUrl allows; safe image fallbacks.
%>
<%
  var demoFb =
    typeof sermonsDemoFallback !== 'undefined' && sermonsDemoFallback ? sermonsDemoFallback : null;
  var pageSections = (sections || []).filter(function (s) {
    return s && (s.heading || s.bodyText || s.mediaUrl);
  });
  var sermons = (entities || []).filter(function (s) {
    return s && String(s.title || '').trim();
  });
  var featured = sermons.length ? sermons[0] : null;
  var rest = sermons.length > 1 ? sermons.slice(1) : [];
  var intro = pageSections.length ? pageSections[0] : null;
  var introHeading =
    (intro && intro.heading) ||
    (demoFb && demoFb.introHeading) ||
    pageTitle ||
    'Sacred Teachings for Modern Souls';
  var introBody =
    (intro && intro.bodyText) ||
    (demoFb && demoFb.introBody) ||
    '';
  var introMedia =
    (intro && intro.mediaUrl) ||
    (demoFb && demoFb.introMediaUrl) ||
    null;

  var seriesSeen = {};
  var seriesList = [];
  sermons.forEach(function (s) {
    var cat = String(s.category || '').trim();
    if (!cat || seriesSeen[cat]) return;
    seriesSeen[cat] = true;
    seriesList.push(cat);
  });

  function mediaLabel(kind, title) {
    if (kind === 'audio') return 'Listen to sermon: ' + title;
    if (kind === 'video') return 'Watch sermon: ' + title;
    return 'Open media for sermon: ' + title;
  }
  function mediaButton(kind) {
    if (kind === 'audio') return { icon: 'headphones', text: 'Listen' };
    if (kind === 'video') return { icon: 'play_circle', text: 'Watch Sermon' };
    return { icon: 'play_circle', text: 'Watch or Listen' };
  }
  function resourceLabel(kind, title) {
    if (kind === 'download') return 'Download notes for sermon: ' + title;
    return 'Open resources for sermon: ' + title;
  }
  function resourceButton(kind) {
    if (kind === 'download') return { icon: 'download', text: 'Download' };
    return { icon: 'menu_book', text: 'Resources' };
  }

  var summaryMax = 140;
  function sermonSummary(text) {
    var raw = String(text || '').replace(/\s+/g, ' ').trim();
    if (!raw) return '';
    return raw.length <= summaryMax ? raw : (raw.slice(0, summaryMax - 1) + '…');
  }
%>

<section
  class="bb-tp-directory bb-tp-sermons"
  data-bb-sermons="1"
  data-bb-stitch-sermons="phase7-v1"
  aria-label="Sermons"
>
  <%- include('./partials/page-hero', {
    heroHeading: introHeading,
    heroBody: introBody,
    heroMedia: introMedia,
    heroMediaAlt: 'Sermons at ' + publicName,
    heroEyebrow: (intro && intro.layoutMetadata && intro.layoutMetadata.eyebrow) || 'Spiritual Nourishment',
    heroClass: 'bb-tp-sermons-hero',
    heroCtaPrimary: { href: hrefFor('/events'), label: 'View Events' },
    heroCtaSecondary: { href: hrefFor('/contact'), label: 'Contact Us' },
    heroLayoutMetadata: (intro && intro.layoutMetadata) || null,
    editPageKey: 'sermons',
    editSectionKey: 'hero'
  }) %>
  <div class="bb-tp-sermons-hero-marker" data-bb-sermons-hero="1" hidden></div>

  <div class="bb-tp-container bb-tp-directory__body">
    <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
    <p class="bb-tp-edit-collection-actions">
      <%- include('../partials/structured-edit-trigger', {
        editKind: 'sermon',
        editEntityKey: 'new-sermon',
        editLabel: 'Add sermon',
        editPayload: {
          title: '',
          speakerName: '',
          preachedAt: '',
          summary: '',
          scripture: '',
          mediaUrl: '',
          imageUrl: '',
          featured: false,
          visible: true
        }
      }) %>
      <span class="bb-tp-se-hint">Add sermon</span>
    </p>
    <% } %>
    <% if (featured) { %>
    <%
      var featuredKind = featured.mediaUrl ? sermonMediaKind(featured.mediaUrl) : null;
      var featuredBtn = featuredKind ? mediaButton(featuredKind) : null;
      var featuredResKind = featured.resourceUrl ? sermonResourceKind(featured.resourceUrl) : null;
      var featuredResBtn = featuredResKind ? resourceButton(featuredResKind) : null;
    %>
    <section class="bb-tp-featured-sermon" aria-label="Featured sermon" data-bb-sermon-featured="1">
      <p class="bb-tp-featured-sermon__label bb-tp-featured-sermon__label--desktop">
        <span class="material-symbols-outlined" aria-hidden="true">star</span>
        Featured Sermon
      </p>
      <p class="bb-tp-featured-sermon__label bb-tp-featured-sermon__label--mobile">
        Latest Release
      </p>
      <article class="bb-tp-featured-sermon__card">
        <div class="bb-tp-featured-sermon__media<%= featured.imageUrl ? '' : ' is-fallback' %>" data-bb-sermon-thumb="1">
          <% if (featured.imageUrl) { %>
          <img
            src="<%= featured.imageUrl %>"
            alt="<%= featured.title %>"
            width="720"
            height="405"
            loading="eager"
            decoding="async"
          />
          <% } else { %>
          <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
          <% } %>
        </div>
        <div class="bb-tp-featured-sermon__copy">
          <h2 class="bb-tp-featured-sermon__title">
            <%= featured.title %>
            <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
            <%- include('../partials/structured-edit-trigger', {
              editKind: 'sermon',
              editEntityKey: String(featured.id || ('sermon-' + featured.title)),
              editLabel: 'Edit ' + featured.title,
              editPayload: {
                title: featured.title,
                speakerName: featured.speakerName,
                preachedAt: featured.preachedAt,
                summary: featured.summary,
                scripture: featured.scripture,
                mediaUrl: featured.mediaUrl,
                imageUrl: featured.imageUrl,
                featured: true,
                visible: true
              }
            }) %>
            <% } %>
          </h2>
          <% if (featured.category) { %>
          <p class="bb-tp-sermon-card__category"><%= featured.category %></p>
          <% } %>
          <% if (featured.speakerName || featured.preachedAt || featured.scripture) { %>
          <p class="bb-tp-meta bb-tp-featured-sermon__meta">
            <% if (featured.speakerName) { %>
            <span class="bb-tp-meta__item">
              <span class="material-symbols-outlined" aria-hidden="true">person</span>
              <%= featured.speakerName %>
            </span>
            <% } %>
            <% if (featured.preachedAt) { %>
            <span class="bb-tp-meta__item">
              <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
              <%= formatDate(featured.preachedAt) %>
            </span>
            <% } %>
            <% if (featured.scripture) { %>
            <span class="bb-tp-meta__item">
              <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
              <%= featured.scripture %>
            </span>
            <% } %>
          </p>
          <% } %>
          <% var featuredSermonSummary = sermonSummary(featured.summary); %>
          <% if (featuredSermonSummary) { %>
          <p class="bb-tp-body bb-tp-featured-sermon__summary"><%= featuredSermonSummary %></p>
          <% } %>
          <% if (featured.mediaUrl || featured.resourceUrl) { %>
          <div class="bb-tp-page-hero__cta bb-tp-featured-sermon__actions">
            <% if (featured.mediaUrl && featuredBtn) { %>
            <a
              class="bb-tp-btn bb-tp-btn--primary bb-tp-featured-sermon__cta-desktop"
              href="<%= featured.mediaUrl %>"
              rel="noopener noreferrer"
              data-bb-sermon-media="1"
              data-bb-media-kind="<%= featuredKind %>"
              aria-label="<%= mediaLabel(featuredKind, featured.title) %>"
            >
              <span class="material-symbols-outlined" aria-hidden="true"><%= featuredBtn.icon %></span>
              <%= featuredBtn.text %>
            </a>
            <% } %>
            <% if (featured.resourceUrl && featuredResBtn) { %>
            <a
              class="bb-tp-btn bb-tp-btn--ghost"
              href="<%= featured.resourceUrl %>"
              rel="noopener noreferrer"
              data-bb-sermon-resource="1"
              data-bb-resource-kind="<%= featuredResKind %>"
              aria-label="<%= resourceLabel(featuredResKind, featured.title) %>"
            >
              <span class="material-symbols-outlined" aria-hidden="true"><%= featuredResBtn.icon %></span>
              <%= featuredResBtn.text %>
            </a>
            <% } %>
          </div>
          <% } %>
        </div>
        <% if (featured.mediaUrl && featuredBtn) { %>
        <a
          class="bb-tp-featured-sermon__play bb-tp-featured-sermon__play--mobile"
          href="<%= featured.mediaUrl %>"
          rel="noopener noreferrer"
          data-bb-sermon-media="1"
          data-bb-media-kind="<%= featuredKind %>"
          aria-label="<%= mediaLabel(featuredKind, featured.title) %>"
        >
          <span class="material-symbols-outlined" aria-hidden="true">play_arrow</span>
        </a>
        <% } %>
      </article>
    </section>
    <% } %>

    <% if (rest.length) { %>
    <section class="bb-tp-sermon-list-wrap" aria-label="Recent sermons" data-bb-sermons-list="1">
      <div class="bb-tp-sermon-list-wrap__head">
        <h2 class="bb-tp-section-title bb-tp-section-title--ruled">Recent Sermons</h2>
      </div>
      <ul class="bb-tp-sermon-grid">
        <% rest.forEach(function (sermon) { %>
        <%
          var kind = sermon.mediaUrl ? sermonMediaKind(sermon.mediaUrl) : null;
          var btn = kind ? mediaButton(kind) : null;
          var resKind = sermon.resourceUrl ? sermonResourceKind(sermon.resourceUrl) : null;
          var resBtn = resKind ? resourceButton(resKind) : null;
          var thumbLabel = sermon.title || 'Sermon';
        %>
        <li class="bb-tp-sermon-card" data-bb-sermon-item="1">
          <div
            class="bb-tp-sermon-card__media<%= sermon.imageUrl ? '' : ' is-fallback' %>"
            <% if (!sermon.imageUrl) { %>role="img" aria-label="<%= thumbLabel %>"<% } %>
          >
            <% if (sermon.imageUrl) { %>
            <img src="<%= sermon.imageUrl %>" alt="<%= thumbLabel %>" width="400" height="240" loading="lazy" decoding="async" />
            <% } else { %>
            <span class="material-symbols-outlined bb-tp-sermon-card__fallback-icon" aria-hidden="true">menu_book</span>
            <% } %>
          </div>
          <div class="bb-tp-sermon-card__body">
            <h3 class="bb-tp-sermon-card__title">
              <%= sermon.title %>
              <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
              <%- include('../partials/structured-edit-trigger', {
                editKind: 'sermon',
                editEntityKey: String(sermon.id || ('sermon-' + sermon.title)),
                editLabel: 'Edit ' + sermon.title,
                editPayload: {
                  title: sermon.title,
                  speakerName: sermon.speakerName,
                  preachedAt: sermon.preachedAt,
                  summary: sermon.summary,
                  scripture: sermon.scripture,
                  mediaUrl: sermon.mediaUrl,
                  imageUrl: sermon.imageUrl,
                  featured: false,
                  visible: true
                }
              }) %>
              <% } %>
            </h3>
            <% if (sermon.category) { %>
            <p class="bb-tp-sermon-card__category"><%= sermon.category %></p>
            <% } %>
            <% if (sermon.speakerName || sermon.preachedAt || sermon.scripture) { %>
            <p class="bb-tp-meta bb-tp-sermon-card__meta">
              <% if (sermon.speakerName) { %>
              <span class="bb-tp-meta__item">
                <span class="material-symbols-outlined" aria-hidden="true">person</span>
                <%= sermon.speakerName %>
              </span>
              <% } %>
              <% if (sermon.preachedAt) { %>
              <span class="bb-tp-meta__item">
                <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
                <%= formatDate(sermon.preachedAt) %>
              </span>
              <% } %>
              <% if (sermon.scripture) { %>
              <span class="bb-tp-meta__item">
                <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                <%= sermon.scripture %>
              </span>
              <% } %>
            </p>
            <% } %>
            <% var cardSermonSummary = sermonSummary(sermon.summary); %>
            <% if (cardSermonSummary) { %>
            <p class="bb-tp-sermon-card__summary"><%= cardSermonSummary %></p>
            <% } %>
            <% if (sermon.mediaUrl || sermon.resourceUrl) { %>
            <p class="bb-tp-sermon-card__actions">
              <% if (sermon.mediaUrl && btn) { %>
              <a
                href="<%= sermon.mediaUrl %>"
                rel="noopener noreferrer"
                data-bb-sermon-media="1"
                data-bb-media-kind="<%= kind %>"
                aria-label="<%= mediaLabel(kind, sermon.title) %>"
              >
                <span class="material-symbols-outlined" aria-hidden="true"><%= kind === 'audio' ? 'headphones' : 'play_arrow' %></span>
                <%= kind === 'audio' ? 'Listen' : (kind === 'video' ? 'Watch' : 'Open') %>
              </a>
              <% } %>
              <% if (sermon.resourceUrl && resBtn) { %>
              <a
                href="<%= sermon.resourceUrl %>"
                rel="noopener noreferrer"
                data-bb-sermon-resource="1"
                data-bb-resource-kind="<%= resKind %>"
                aria-label="<%= resourceLabel(resKind, sermon.title) %>"
              >
                <span class="material-symbols-outlined" aria-hidden="true"><%= resBtn.icon %></span>
                <%= resKind === 'download' ? 'Notes' : 'Resources' %>
              </a>
              <% } %>
            </p>
            <% } %>
          </div>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (seriesList.length > 1) { %>
    <section class="bb-tp-sermon-series" aria-label="Sermon series" data-bb-sermon-series="1">
      <h2 class="bb-tp-section-title bb-tp-section-title--ruled">Explore Series</h2>
      <ul class="bb-tp-sermon-series__list">
        <% seriesList.forEach(function (seriesName) { %>
        <li class="bb-tp-sermon-series__item">
          <span class="material-symbols-outlined" aria-hidden="true">library_books</span>
          <span><%= seriesName %></span>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (pageSections.length > 1) { %>
    <div class="bb-tp-directory__sections">
      <% pageSections.slice(1).forEach(function (section) { %>
      <section class="bb-tp-content-block" data-section="<%= section.sectionKey %>">
        <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
        <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
        <% if (section.mediaUrl) { %>
        <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="<%= (section.layoutMetadata && section.layoutMetadata.altText) || '' %>" width="960" height="540" loading="lazy" decoding="async" />
        <% } %>
      </section>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
