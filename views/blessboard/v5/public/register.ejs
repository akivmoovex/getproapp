<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Register · <%= publicName %></title>
  <meta name="robots" content="noindex, nofollow" />
  <%- include('../partials/head-design-system') %>
  <link rel="stylesheet" href="/blessboard/v5/tenant-auth.css?v=15" />
</head>
<body
  class="bb-auth-body"
  data-bb-shell="tenant-auth"
  data-bb-product="blessboard-v5"
  data-bb-page="register"
  data-bb-stitch-register="10-auth-member-registration"
>
<%
  var fe = typeof fieldErrors !== 'undefined' && fieldErrors ? fieldErrors : {};
  var summaryItems = typeof errorSummaryItems !== 'undefined' && errorSummaryItems && errorSummaryItems.length
    ? errorSummaryItems
    : (error ? [error] : []);
  var hasErrors = Boolean(error) || summaryItems.length > 0;
  var sub = submitted || {};
  function fieldInvalid(key) { return Boolean(fe[key]); }
  function fieldDescribedBy(key, extraIds) {
    var ids = [];
    if (fe[key]) ids.push('err-' + key);
    if (extraIds) ids = ids.concat(extraIds);
    return ids.length ? ids.join(' ') : null;
  }
%>
  <a class="bb-auth-skip" href="#bb-auth-form">Skip to registration form</a>

  <div class="bb-auth-layout">
    <aside class="bb-auth-panel" aria-hidden="true">
      <div class="bb-auth-panel__inner">
        <p class="bb-auth-panel__eyebrow">
          <span class="material-symbols-outlined" aria-hidden="true">person_add</span>
          Join the family
        </p>
        <p class="bb-auth-panel__title">Become part of <%= publicName %></p>
        <p class="bb-auth-panel__lead">
          Submit your details for church leadership to review. This site’s address determines your church and branch — you never enter those IDs in the form.
        </p>
      </div>
    </aside>

    <main class="bb-auth-main">
      <header class="bb-auth-main__header">
        <a class="bb-auth-brand" href="/">
          <img
            class="bb-auth-brand__mark"
            src="/church/images/brand/blessboard-small-church-logo.png"
            alt=""
            width="32"
            height="32"
            decoding="async"
          />
          <span>
            <span class="bb-auth-brand__name"><%= publicName %></span>
            <% if (branchName) { %>
            <span class="bb-auth-brand__branch"><%= branchName %></span>
            <% } %>
          </span>
        </a>
        <a class="bb-auth-main__header-link" href="/login">Sign in</a>
      </header>

      <div class="bb-auth-main__body">
        <div class="bb-auth-card bb-auth-card--wide bb-auth-card--register">
          <div class="bb-auth-card__hero">
            <p class="bb-auth-card__hero-eyebrow bb-auth-card__hero-eyebrow--mobile">
              Join Our Community
            </p>
            <h1 class="bb-auth-card__hero-title">Member Registration</h1>
            <p class="bb-auth-card__hero-lead">
              Join our community at <%= publicName %><% if (branchName) { %> · <%= branchName %><% } %>.
              Please fill in your details below. Leadership reviews applications before member access is granted.
            </p>
          </div>

          <div class="bb-auth-card__body">
            <% if (hasErrors) { %>
            <div
              class="bb-auth-error"
              id="bb-auth-error-summary"
              role="alert"
              tabindex="-1"
              aria-live="assertive"
              data-bb-auth-error="register"
            >
              <p class="bb-auth-error__title">We could not submit your registration</p>
              <% if (summaryItems.length === 1) { %>
              <p class="bb-auth-error__body"><%= summaryItems[0] %></p>
              <% } else { %>
              <ul class="bb-auth-error__list">
                <% summaryItems.forEach(function (item) { %>
                <li><%= item %></li>
                <% }) %>
              </ul>
              <% } %>
            </div>
            <% } %>

            <form
              method="post"
              action="/register"
              class="bb-auth-form bb-auth-form--register"
              id="bb-auth-form"
              tabindex="-1"
              novalidate
              aria-describedby="<%= hasErrors ? 'bb-auth-error-summary bb-auth-contact-hint bb-auth-privacy-note' : 'bb-auth-contact-hint bb-auth-privacy-note' %>"
            >
              <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />

              <fieldset class="bb-auth-fieldset" data-bb-auth-group="personal">
                <legend class="bb-auth-fieldset__legend">
                  <span class="material-symbols-outlined" aria-hidden="true">badge</span>
                  <span class="bb-auth-fieldset__legend-desktop">Personal Info</span>
                  <span class="bb-auth-fieldset__legend-mobile">Personal Information</span>
                </legend>

                <div class="bb-auth-field-row">
                  <div class="bb-auth-field">
                    <label for="first_name">
                      First name
                      <span class="bb-auth-required" aria-hidden="true">*</span>
                    </label>
                    <input
                      id="first_name"
                      name="first_name"
                      type="text"
                      required
                      maxlength="100"
                      autocomplete="given-name"
                      aria-required="true"
                      <% if (fieldInvalid('firstName')) { %>aria-invalid="true"<% } %>
                      <% var firstDesc = fieldDescribedBy('firstName'); if (firstDesc) { %>aria-describedby="<%= firstDesc %>"<% } %>
                      value="<%= sub.firstName != null ? sub.firstName : '' %>"
                    />
                    <% if (fe.firstName) { %>
                    <p class="bb-auth-field__error" id="err-firstName" role="status"><%= fe.firstName %></p>
                    <% } %>
                  </div>

                  <div class="bb-auth-field">
                    <label for="last_name">
                      Last name
                      <span class="bb-auth-required" aria-hidden="true">*</span>
                    </label>
                    <input
                      id="last_name"
                      name="last_name"
                      type="text"
                      required
                      maxlength="100"
                      autocomplete="family-name"
                      aria-required="true"
                      <% if (fieldInvalid('lastName')) { %>aria-invalid="true"<% } %>
                      <% var lastDesc = fieldDescribedBy('lastName'); if (lastDesc) { %>aria-describedby="<%= lastDesc %>"<% } %>
                      value="<%= sub.lastName != null ? sub.lastName : '' %>"
                    />
                    <% if (fe.lastName) { %>
                    <p class="bb-auth-field__error" id="err-lastName" role="status"><%= fe.lastName %></p>
                    <% } %>
                  </div>
                </div>

                <div class="bb-auth-field">
                  <label for="preferred_name">
                    Preferred name
                    <span class="bb-auth-optional">(optional)</span>
                  </label>
                  <input
                    id="preferred_name"
                    name="preferred_name"
                    type="text"
                    maxlength="100"
                    autocomplete="nickname"
                    aria-describedby="<%= fieldDescribedBy('preferredName', ['hint-preferredName']) || 'hint-preferredName' %>"
                    <% if (fieldInvalid('preferredName')) { %>aria-invalid="true"<% } %>
                    value="<%= sub.preferredName != null ? sub.preferredName : '' %>"
                  />
                  <p class="bb-auth-hint" id="hint-preferredName">How you would like to be addressed, if different from your first name.</p>
                  <% if (fe.preferredName) { %>
                  <p class="bb-auth-field__error" id="err-preferredName" role="status"><%= fe.preferredName %></p>
                  <% } %>
                </div>
              </fieldset>

              <fieldset class="bb-auth-fieldset" data-bb-auth-group="contact">
                <legend class="bb-auth-fieldset__legend">
                  <span class="material-symbols-outlined" aria-hidden="true">contact_mail</span>
                  Contact
                </legend>

                <div class="bb-auth-field-row">
                  <div class="bb-auth-field">
                    <label for="phone">Mobile phone number *</label>
                    <input
                      id="phone"
                      name="phone"
                      type="tel"
                      maxlength="40"
                      required
                      autocomplete="tel"
                      inputmode="tel"
                      <% if (fieldInvalid('phone') || fieldInvalid('phone_required')) { %>aria-invalid="true"<% } %>
                      aria-describedby="<%= fieldDescribedBy('phone', ['bb-auth-contact-hint']) || 'bb-auth-contact-hint' %>"
                      value="<%= sub.phone != null ? sub.phone : '' %>"
                    />
                    <% if (fe.phone || fe.phone_required) { %>
                    <p class="bb-auth-field__error" id="err-phone" role="status"><%= fe.phone || fe.phone_required %></p>
                    <% } %>
                  </div>

                  <div class="bb-auth-field">
                    <label for="email">Email address, optional</label>
                    <input
                      id="email"
                      name="email"
                      type="email"
                      maxlength="254"
                      autocomplete="email"
                      inputmode="email"
                      <% if (fieldInvalid('email')) { %>aria-invalid="true"<% } %>
                      aria-describedby="<%= fieldDescribedBy('email', ['bb-auth-contact-hint']) || 'bb-auth-contact-hint' %>"
                      value="<%= sub.email != null ? sub.email : '' %>"
                    />
                    <% if (fe.email) { %>
                    <p class="bb-auth-field__error" id="err-email" role="status"><%= fe.email %></p>
                    <% } %>
                  </div>
                </div>

                <p class="bb-auth-hint" id="bb-auth-contact-hint">Mobile phone is required for registration. Email is optional for additional notifications.</p>
              </fieldset>

              <p class="bb-auth-privacy" id="bb-auth-privacy-note" data-bb-auth-privacy="1">
                <span class="material-symbols-outlined" aria-hidden="true">security</span>
                <span>
                  Your details are submitted for church administration review only.
                  Questions about how this church uses your information can be sent via
                  <a href="/contact">Contact</a>.
                </span>
              </p>

              <div class="bb-auth-actions">
                <button class="bb-auth-btn bb-auth-btn--primary" type="submit">Submit Registration</button>
                <a class="bb-auth-btn bb-auth-btn--ghost" href="/">Back to homepage</a>
              </div>
            </form>
          </div>
        </div>
      </div>

      <footer class="bb-auth-footer">
        <div class="bb-auth-footer__links">
          <a href="/login">Already a member? Sign in</a>
          <a href="/contact">Contact church</a>
        </div>
        <%- include('../partials/powered-by-getpro') %>
      </footer>
    </main>
  </div>

  <script src="/blessboard/v5/design-system.js?v=3" defer></script>
  <script src="/blessboard/v5/tenant-auth.js?v=2" defer></script>
</body>
</html>
