<%#
  Phase 7 — Church Website Contact (Desktop; responsive).
  Stitch: 28ba746495424a66a10cf5fb11916dec
  No contact POST (unsupported). Map only with valid lat/lng.
  Service times repeated near location/map.
%>
<%
  var demoFb =
    typeof contactDemoFallback !== 'undefined' && contactDemoFallback ? contactDemoFallback : null;
  var pageSections = (sections || []).filter(function (s) {
    return s && (s.heading || s.bodyText || s.mediaUrl);
  });
  var channels = (entities || []).filter(function (ch) {
    return ch && (ch.label || ch.value);
  });
  var contact = typeof publicContact !== 'undefined' && publicContact ? publicContact : { hasAny: false };
  var intro = null;
  var officeHoursSection = null;
  var moreSections = [];
  pageSections.forEach(function (s) {
    var blob = (String(s.sectionKey || '') + ' ' + String(s.sectionType || '') + ' ' + String(s.heading || '')).toLowerCase();
    if (!officeHoursSection && (blob.indexOf('office_hours') >= 0 || blob.indexOf('office hours') >= 0 || (blob.indexOf('office') >= 0 && blob.indexOf('hour') >= 0))) {
      officeHoursSection = s;
      return;
    }
    if (!intro) {
      intro = s;
      return;
    }
    moreSections.push(s);
  });

  var introHeading =
    (intro && intro.heading) ||
    (demoFb && demoFb.introHeading) ||
    pageTitle ||
    "We'd Love to Hear From You";
  var introBody =
    (intro && intro.bodyText) ||
    (demoFb && demoFb.introBody) ||
    '';

  var officeHoursHeading =
    (officeHoursSection && officeHoursSection.heading) ||
    (demoFb && demoFb.officeHoursHeading) ||
    'Office Hours';
  var officeHoursBody =
    (officeHoursSection && officeHoursSection.bodyText) ||
    (demoFb && !officeHoursSection ? demoFb.officeHoursBody : null) ||
    null;

  function formatTimeLabel(hhmm) {
    var m = /^([01]?\d|2[0-3]):([0-5]\d)$/.exec(String(hhmm || ''));
    if (!m) return String(hhmm || '');
    var h = Number(m[1]);
    var min = m[2];
    var ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12;
    if (h === 0) h = 12;
    return h + ':' + min + ' ' + ampm;
  }

  var typesSeen = {};
  channels.forEach(function (ch) {
    typesSeen[String(ch.channelType || '').toLowerCase()] = true;
  });

  function channelIsEmail(type) {
    var t = String(type || '').toLowerCase();
    return t === 'email' || t.indexOf('mail') !== -1;
  }
  function channelIsPhone(type) {
    var t = String(type || '').toLowerCase();
    return t === 'phone' || t.indexOf('tel') !== -1 || t.indexOf('call') !== -1;
  }

  var settingsCards = [];
  if (contact.phone && !typesSeen.phone && !typesSeen.tel && !typesSeen.call) {
    settingsCards.push({
      icon: 'call',
      label: 'Phone',
      value: contact.phone,
      href: contact.phoneHref,
      kind: 'phone'
    });
  }
  if (contact.email && !typesSeen.email && !typesSeen.mail) {
    settingsCards.push({
      icon: 'mail',
      label: 'Email',
      value: contact.email,
      href: contact.emailHref,
      kind: 'email'
    });
  }
  if (contact.addressText && !typesSeen.address && !typesSeen.location && !typesSeen.map) {
    settingsCards.push({
      icon: 'location_on',
      label: 'Location',
      value: contact.addressText,
      href: null,
      multiline: true,
      kind: 'location'
    });
  }

  var hasChannelCards = channels.length > 0 || settingsCards.length > 0;
  var showMapUnavailable = Boolean(contact.addressText && !contact.hasMap);
  var messageEmailHref = contact.emailHref || null;
  var messageEmail = contact.email || '';
  var contactServiceEntries =
    typeof serviceTimesEntries !== 'undefined' && serviceTimesEntries ? serviceTimesEntries : [];
  var socialLinksList =
    typeof socialLinks !== 'undefined' && socialLinks ? socialLinks.filter(function (s) { return s && (s.label || s.href); }) : [];
%>

<section
  class="bb-tp-directory bb-tp-contact"
  data-bb-contact="1"
  data-bb-stitch-contact="phase7-v1"
  aria-label="Contact"
>
  <%- include('./partials/page-hero', {
    heroHeading: introHeading,
    heroBody: introBody,
    heroMedia: null,
    heroEyebrow: 'Get In Touch',
    heroClass: 'bb-tp-contact-hero',
    heroCtaPrimary: messageEmailHref
      ? { href: messageEmailHref, label: 'Email Us' }
      : { href: hrefFor('/about'), label: 'About Us' },
    heroCtaSecondary: { href: hrefFor('/events'), label: 'View Events' },
    editPageKey: 'contact',
    editSectionKey: 'hero'
  }) %>
  <div class="bb-tp-contact-hero-marker" data-bb-contact-hero="1" hidden></div>

  <div class="bb-tp-container bb-tp-directory__body">
    <% if (hasChannelCards) { %>
    <ul class="bb-tp-contact-cards" data-bb-contact-channels="1">
      <% channels.forEach(function (channel) { %>
      <li class="bb-tp-contact-card" data-bb-contact-channel="<%= channel.channelType || 'other' %>">
        <span class="bb-tp-contact-card__icon" aria-hidden="true">
          <span class="material-symbols-outlined"><%= channel.icon || 'contact_mail' %></span>
        </span>
        <div class="bb-tp-contact-card__body">
          <h3 class="bb-tp-contact-card__label"><%= channel.label %></h3>
          <% if (channel.href) { %>
          <p class="bb-tp-contact-card__value">
            <a
              href="<%= channel.href %>"
              <% if (channel.href.indexOf('http') === 0) { %>rel="noopener noreferrer"<% } %>
              <% if (channelIsEmail(channel.channelType)) { %>aria-label="Email <%= channel.value %>"<% } %>
              <% if (channelIsPhone(channel.channelType)) { %>aria-label="Call <%= channel.value %>"<% } %>
            ><%= channel.value %></a>
          </p>
          <% } else { %>
          <p class="bb-tp-contact-card__value"><%= channel.value %></p>
          <% } %>
        </div>
      </li>
      <% }) %>
      <% settingsCards.forEach(function (card) { %>
      <li class="bb-tp-contact-card" data-bb-contact-settings="<%= card.label.toLowerCase() %>">
        <span class="bb-tp-contact-card__icon" aria-hidden="true">
          <span class="material-symbols-outlined"><%= card.icon %></span>
        </span>
        <div class="bb-tp-contact-card__body">
          <h3 class="bb-tp-contact-card__label"><%= card.label %></h3>
          <% if (card.href) { %>
          <p class="bb-tp-contact-card__value">
            <a
              href="<%= card.href %>"
              <% if (card.kind === 'email') { %>aria-label="Email <%= card.value %>"<% } %>
              <% if (card.kind === 'phone') { %>aria-label="Call <%= card.value %>"<% } %>
            ><%= card.value %></a>
          </p>
          <% } else if (card.multiline && contact.addressLines && contact.addressLines.length) { %>
          <p class="bb-tp-contact-card__value bb-tp-contact-card__value--multi">
            <% contact.addressLines.forEach(function (line) { %><span><%= line %></span><% }) %>
          </p>
          <% } else { %>
          <p class="bb-tp-contact-card__value"><%= card.value %></p>
          <% } %>
        </div>
      </li>
      <% }) %>
    </ul>
    <% } else if (entitiesEmptyMessage && !contact.hasAny) { %>
    <p class="bb-tp-lead" role="status"><%= entitiesEmptyMessage %></p>
    <% } %>

    <% if (demoFb && demoFb.visitorGuidance) { %>
    <section class="bb-tp-contact-guidance" data-bb-contact-guidance="1" aria-labelledby="bb-tp-contact-guidance-heading">
      <h2 id="bb-tp-contact-guidance-heading" class="bb-tp-section-title bb-tp-section-title--ruled">First Visit Guidance</h2>
      <p class="bb-tp-body"><%= demoFb.visitorGuidance %></p>
      <% if (demoFb.directionsHeading && demoFb.directionsBody) { %>
      <h3 class="bb-tp-subsection-title"><%= demoFb.directionsHeading %></h3>
      <p class="bb-tp-body"><%= demoFb.directionsBody %></p>
      <% } %>
      <% if (demoFb.serviceReminderHeading && demoFb.serviceReminderBody) { %>
      <h3 class="bb-tp-subsection-title"><%= demoFb.serviceReminderHeading %></h3>
      <p class="bb-tp-body"><%= demoFb.serviceReminderBody %></p>
      <% } %>
    </section>
    <% } %>

    <% if (officeHoursHeading && officeHoursBody) { %>
    <section class="bb-tp-contact-hours" data-bb-contact-hours="1" aria-labelledby="bb-tp-contact-hours-heading">
      <h2 id="bb-tp-contact-hours-heading" class="bb-tp-section-title bb-tp-section-title--ruled">
        <%= officeHoursHeading %>
      </h2>
      <p class="bb-tp-body"><%= officeHoursBody %></p>
    </section>
    <% } %>

    <div class="bb-tp-contact-main">
      <section
        class="bb-tp-contact-message"
        aria-labelledby="bb-tp-contact-message-heading"
        data-bb-contact-message="unavailable"
      >
        <h2 id="bb-tp-contact-message-heading" class="bb-tp-section-title">Send a Message</h2>
        <p class="bb-tp-body" role="status" data-bb-contact-form="unavailable">
          Online message forms are not available on this site. Use the published contact details above<% if (messageEmailHref) { %>, or email us directly<% } %>.
        </p>
        <div class="bb-tp-page-hero__cta">
          <% if (messageEmailHref) { %>
          <a
            class="bb-tp-btn bb-tp-btn--primary"
            href="<%= messageEmailHref %>"
            aria-label="Email <%= messageEmail %>"
          >
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            Email Us
          </a>
          <% } %>
          <% if (contact.phoneHref) { %>
          <a class="bb-tp-btn bb-tp-btn--ghost" href="<%= contact.phoneHref %>" aria-label="Call <%= contact.phone %>">
            <span class="material-symbols-outlined" aria-hidden="true">call</span>
            Call Us
          </a>
          <% } else { %>
          <a class="bb-tp-btn bb-tp-btn--ghost" href="<%= hrefFor('/events') %>">View Events</a>
          <% } %>
        </div>
      </section>

      <div class="bb-tp-contact-aside">
        <% if (contact.hasMap && contact.mapEmbedUrl) { %>
        <section class="bb-tp-contact-map" aria-label="Map" data-bb-contact-map="1">
          <% if (contact.addressText) { %>
          <div class="bb-tp-contact-map__address">
            <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
            <div>
              <h2 class="bb-tp-contact-map__heading">Find Us</h2>
              <p class="bb-tp-contact-map__text bb-tp-contact-card__value--multi">
                <% contact.addressLines.forEach(function (line) { %><span><%= line %></span><% }) %>
              </p>
            </div>
          </div>
          <% } %>
          <div class="bb-tp-contact-map__frame">
            <iframe
              title="Map of <%= publicName %>"
              src="<%= contact.mapEmbedUrl %>"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
            <% if (contact.directionsUrl) { %>
            <a
              class="bb-tp-contact-map__directions"
              href="<%= contact.directionsUrl %>"
              rel="noopener noreferrer"
              target="_blank"
              aria-label="Get directions to <%= publicName %> (opens in a new tab)"
            >
              <span class="material-symbols-outlined" aria-hidden="true">pin_drop</span>
              Get Directions
              <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
            <% } %>
          </div>
        </section>
        <% } else if (contact.directionsUrl) { %>
        <p class="bb-tp-contact-map__link-only" data-bb-contact-map="directions-only">
          <a
            class="bb-tp-btn bb-tp-btn--primary"
            href="<%= contact.directionsUrl %>"
            rel="noopener noreferrer"
            target="_blank"
            aria-label="Get directions to <%= publicName %> (opens in a new tab)"
          >
            <span class="material-symbols-outlined" aria-hidden="true">pin_drop</span>
            Get Directions
          </a>
        </p>
        <% } else if (showMapUnavailable) { %>
        <p class="bb-tp-contact-map__unavailable" role="status" data-bb-contact-map="unavailable">
          <span class="material-symbols-outlined" aria-hidden="true">info</span>
          A map is not available for this location yet. Use the address details above when visiting.
        </p>
        <% } else if (contact.addressText) { %>
        <section class="bb-tp-contact-map" aria-label="Location" data-bb-contact-map="address-only">
          <div class="bb-tp-contact-map__address">
            <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
            <div>
              <h2 class="bb-tp-contact-map__heading">Find Us</h2>
              <p class="bb-tp-contact-map__text bb-tp-contact-card__value--multi">
                <% contact.addressLines.forEach(function (line) { %><span><%= line %></span><% }) %>
              </p>
            </div>
          </div>
        </section>
        <% } %>

        <% if (contactServiceEntries.length) { %>
        <section class="bb-tp-contact-services bb-tp-contact-services--aside" data-bb-contact-services="1" aria-labelledby="bb-tp-contact-services-heading">
          <h2 id="bb-tp-contact-services-heading" class="bb-tp-section-title bb-tp-section-title--ruled">Service Times</h2>
          <ul class="bb-tp-service-times-list">
            <% contactServiceEntries.forEach(function (entry) { %>
            <li class="bb-tp-service-times-item">
              <span class="bb-tp-service-times-item__day"><%= String(entry.day || '').charAt(0).toUpperCase() + String(entry.day || '').slice(1) %></span>
              <span class="bb-tp-service-times-item__name"><%= entry.name %></span>
              <span class="bb-tp-service-times-item__time">
                <%= formatTimeLabel(entry.startTime) %><% if (entry.endTime) { %>–<%= formatTimeLabel(entry.endTime) %><% } %>
              </span>
              <% if (entry.location) { %><span class="bb-tp-service-times-item__location"><%= entry.location %></span><% } %>
            </li>
            <% }) %>
          </ul>
        </section>
        <% } %>
      </div>
    </div>

    <% if (socialLinksList.length) { %>
    <section class="bb-tp-contact-social" aria-label="Social links" data-bb-contact-social="1">
      <h2 class="bb-tp-section-title bb-tp-section-title--ruled">Follow Our Journey</h2>
      <ul class="bb-tp-contact-social__list">
        <% socialLinksList.forEach(function (link) { %>
        <li>
          <% if (link.href) { %>
          <a href="<%= link.href %>" rel="noopener noreferrer" class="bb-tp-contact-social__link">
            <span class="material-symbols-outlined" aria-hidden="true"><%= link.icon || 'public' %></span>
            <%= link.label || 'Social' %>
          </a>
          <% } else { %>
          <span class="bb-tp-contact-social__link is-static">
            <span class="material-symbols-outlined" aria-hidden="true"><%= link.icon || 'public' %></span>
            <%= link.label || 'Social' %>
          </span>
          <% } %>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% moreSections.forEach(function (section) { %>
    <section class="bb-tp-section bb-tp-content-block" data-section="<%= section.sectionKey %>">
      <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
      <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
      <% if (section.mediaUrl) { %>
      <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="" width="960" height="540" loading="lazy" decoding="async" />
      <% } %>
    </section>
    <% }) %>
  </div>
</section>
