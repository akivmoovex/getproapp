<%#
  Phase 7 — Church Website Home (Desktop + Mobile).
  Stitch: 25de9fa64884455b993abb051adb0d8a / b82eb087d4b84242aabead19c08eb717
  Published content + centralized demo soft-fill. No edit controls. No fabricated stats.
%>
<%
  var demoFb = typeof homeDemoFallback !== 'undefined' && homeDemoFallback ? homeDemoFallback : null;
  var hero = null;
  var welcomeSection = null;
  var aboutPreviewSection = null;
  var rest = [];
  var serviceTimesSection = null;
  var serviceTimesEntriesLocal =
    typeof serviceTimesEntries !== 'undefined' && serviceTimesEntries && serviceTimesEntries.length
      ? serviceTimesEntries
      : [];

  (sections || []).forEach(function (s) {
    var key = String(s.sectionKey || '');
    var type = String(s.sectionType || '');
    var isServiceTimes =
      key === 'service_times' || key === 'services' || key === 'worship_times' ||
      type === 'service_times' || type === 'services' || type === 'worship_times';
    if (isServiceTimes && !serviceTimesSection) {
      serviceTimesSection = s;
      return;
    }
    var isHero = !hero && (type === 'hero' || key.indexOf('hero') >= 0);
    if (isHero) {
      hero = s;
      return;
    }
    if (!welcomeSection && (key === 'welcome' || type === 'welcome' || key === 'welcome_home')) {
      welcomeSection = s;
      return;
    }
    if (!aboutPreviewSection && (key === 'about_preview' || key === 'our_story' || type === 'about_preview')) {
      aboutPreviewSection = s;
      return;
    }
    rest.push(s);
  });
  if (!hero && rest.length) hero = rest.shift();
  if (!welcomeSection && rest.length) {
    welcomeSection = rest.find(function (s) { return s.heading || s.bodyText; }) || null;
    if (welcomeSection) {
      rest = rest.filter(function (s) { return s !== welcomeSection; });
    }
  }

  var cmsHeading = hero && hero.heading ? String(hero.heading).trim() : '';
  var staleDemoHeading = cmsHeading === 'A Place for Growth & Community';
  var heroHeading =
    ((!cmsHeading || staleDemoHeading) && demoFb && demoFb.heroHeading) ||
    cmsHeading ||
    (demoFb && demoFb.heroHeading) ||
    pageTitle ||
    publicName;
  var heroBody = (hero && hero.bodyText) || (demoFb && demoFb.heroBody) || '';
  var heroEyebrow = (demoFb && demoFb.heroEyebrow) || ('Welcome to ' + publicName);
  var heroMedia =
    (hero && hero.mediaUrl) ||
    (demoFb && demoFb.heroMediaUrl) ||
    null;

  var teasers = typeof homeTeasers !== 'undefined' && homeTeasers ? homeTeasers : {
    ministries: [], leaders: [], events: [], sermons: [], announcement: null
  };

  var welcomeHeading =
    (welcomeSection && welcomeSection.heading) ||
    (demoFb && demoFb.welcomeHeading) ||
    'Welcome Home';
  var welcomeBody =
    (welcomeSection && welcomeSection.bodyText) ||
    (demoFb && demoFb.welcomeBody) ||
    '';
  var welcomeMedia = welcomeSection && welcomeSection.mediaUrl ? welcomeSection.mediaUrl : null;

  var aboutHeading =
    (aboutPreviewSection && aboutPreviewSection.heading) ||
    (demoFb && demoFb.aboutPreviewHeading) ||
    'Our Story';
  var aboutBody =
    (aboutPreviewSection && aboutPreviewSection.bodyText) ||
    (demoFb && demoFb.aboutPreviewBody) ||
    '';

  var contact = typeof publicContact !== 'undefined' && publicContact ? publicContact : null;
  var directionsHref = contact && contact.directionsUrl ? contact.directionsUrl : null;
%>

<div class="bb-tp-home" data-bb-home="1" data-bb-stitch-home="phase7-v1">
  <section class="bb-tp-hero bb-tp-hero--phase7" aria-label="Welcome" data-bb-home-hero="1">
    <div class="bb-tp-hero__media-plane<%= heroMedia ? ' has-media' : '' %>" aria-hidden="<%= heroMedia ? 'false' : 'true' %>">
      <% if (heroMedia) { %>
      <img
        class="bb-tp-hero__img"
        src="<%= heroMedia %>"
        alt="<%= publicName %> gathering"
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
      />
      <% } else { %>
      <div class="bb-tp-hero__fallback"></div>
      <% } %>
      <div class="bb-tp-hero__scrim"></div>
      <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
      <div class="bb-tp-edit-media-wrap bb-tp-edit-media-wrap--hero">
        <%- include('../partials/structured-edit-trigger', {
          editKind: 'image',
          editEntityKey: 'home-hero',
          editSectionKey: 'hero',
          editLabel: 'Edit hero image',
          editPayload: { imageUrl: heroMedia || '', altText: publicName + ' gathering', focal: 'center' }
        }) %>
        <%- include('../partials/structured-edit-trigger', {
          editKind: 'video',
          editEntityKey: 'home-hero-video',
          editSectionKey: 'hero',
          editLabel: 'Edit hero video',
          editPayload: { videoUrl: '', title: '', thumbnailUrl: heroMedia || '' }
        }) %>
      </div>
      <% } %>
    </div>
    <div class="bb-tp-hero__inner bb-tp-hero__inner--overlay">
      <div class="bb-tp-hero__copy">
        <p class="bb-tp-eyebrow bb-tp-eyebrow--pill bb-tp-eyebrow--on-dark"><%= heroEyebrow %></p>
        <%- include('../partials/editable-text', {
          editPageKey: 'home',
          editSectionKey: 'hero',
          editFieldKey: 'heading',
          editValue: heroHeading,
          editTag: 'h1',
          editClass: 'bb-tp-hero__title',
          editType: 'heading',
          editMaxLength: 120,
          editGuidance: 'Up to 120 characters',
          editMultiline: false
        }) %>
        <% if (heroBody || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) { %>
        <%- include('../partials/editable-text', {
          editPageKey: 'home',
          editSectionKey: 'hero',
          editFieldKey: 'bodyText',
          editValue: heroBody,
          editTag: 'p',
          editClass: 'bb-tp-hero__lead',
          editType: 'paragraph',
          editMaxLength: 500,
          editGuidance: 'Up to 500 characters',
          editMultiline: true
        }) %>
        <% } %>
        <div class="bb-tp-hero__cta">
          <%- include('../partials/editable-text', {
            editPageKey: 'home',
            editSectionKey: 'hero',
            editFieldKey: 'buttonText',
            editValue: (hero && hero.layoutMetadata && hero.layoutMetadata.buttonText) || 'Plan Your Visit',
            editTag: 'a',
            editClass: 'bb-tp-btn bb-tp-btn--primary',
            editHref: (hero && hero.layoutMetadata && hero.layoutMetadata.buttonUrl) || hrefFor('/contact'),
            editType: 'buttonText',
            editMaxLength: 48,
            editGuidance: 'Short button label',
            editMultiline: false
          }) %>
          <a class="bb-tp-btn bb-tp-btn--ghost bb-tp-btn--on-dark" href="<%= hrefFor('/sermons') %>">Watch Latest Sermon</a>
        </div>
      </div>
    </div>
  </section>

  <%- include('./partials/service-times-block', {
    serviceTimesEntries: serviceTimesEntriesLocal,
    serviceTimesHeading: (serviceTimesSection && serviceTimesSection.heading) || 'Service Times',
    visitHref: hrefFor('/contact'),
    directionsHref: directionsHref,
    serviceTimesVariant: 'band'
  }) %>

  <section class="bb-tp-container bb-tp-home-welcome" data-bb-home-welcome="1" aria-labelledby="bb-tp-home-welcome-heading">
    <div class="bb-tp-home-welcome__grid<%= welcomeMedia ? ' has-media' : '' %>">
      <div class="bb-tp-home-welcome__copy">
        <%- include('../partials/editable-text', {
          editPageKey: 'home',
          editSectionKey: 'welcome',
          editFieldKey: 'heading',
          editValue: welcomeHeading,
          editTag: 'h2',
          editClass: 'bb-tp-section-title',
          editType: 'heading',
          editId: 'bb-tp-home-welcome-heading',
          editMaxLength: 120,
          editMultiline: false
        }) %>
        <% if (welcomeBody || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) { %>
        <%- include('../partials/editable-text', {
          editPageKey: 'home',
          editSectionKey: 'welcome',
          editFieldKey: 'bodyText',
          editValue: welcomeBody,
          editTag: 'p',
          editClass: 'bb-tp-body',
          editType: 'paragraph',
          editMaxLength: 2000,
          editMultiline: true
        }) %>
        <% } %>
        <a class="bb-tp-btn bb-tp-btn--ghost" href="<%= hrefFor('/about') %>">Learn More About Our Story</a>
      </div>
      <% if (welcomeMedia) { %>
      <div class="bb-tp-home-welcome__media">
        <img class="bb-tp-media" src="<%= welcomeMedia %>" alt="" width="800" height="600" loading="lazy" decoding="async" />
      </div>
      <% } %>
    </div>
  </section>

  <section class="bb-tp-home-about-preview" data-bb-home-about="1" aria-labelledby="bb-tp-home-about-heading">
    <div class="bb-tp-container">
      <%- include('./partials/section-heading', {
        sectionId: 'bb-tp-home-about-heading',
        sectionTitle: aboutHeading,
        sectionLead: aboutBody,
        sectionHref: hrefFor('/about'),
        sectionLinkLabel: 'About us'
      }) %>
    </div>
  </section>

  <% if (teasers.ministries && teasers.ministries.length) { %>
  <section class="bb-tp-container bb-tp-home-teaser" data-bb-home-ministries="1" aria-labelledby="bb-tp-home-ministries-heading">
    <%- include('./partials/section-heading', {
      sectionId: 'bb-tp-home-ministries-heading',
      sectionTitle: (demoFb && demoFb.ministriesIntroHeading) || 'Find Your Place',
      sectionLead: (demoFb && demoFb.ministriesIntroBody) || 'Explore the different ways you can grow in your faith and serve others through our core ministries.',
      sectionHref: hrefFor('/ministries'),
      sectionLinkLabel: 'View all',
      sectionRuled: true
    }) %>
    <div class="bb-tp-card-grid bb-tp-card-grid--3">
      <% teasers.ministries.forEach(function (m) { %>
      <%- include('./partials/content-card', {
        cardTitle: m.name,
        cardSummary: m.summary,
        cardImage: m.imageUrl,
        cardImageAlt: m.name,
        cardHref: hrefFor('/ministries'),
        cardCta: 'Explore ' + m.name,
        cardIcon: 'groups'
      }) %>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (teasers.events && teasers.events.length) { %>
  <section class="bb-tp-container bb-tp-home-teaser" data-bb-home-events="1" aria-labelledby="bb-tp-home-events-heading">
    <%- include('./partials/section-heading', {
      sectionId: 'bb-tp-home-events-heading',
      sectionTitle: (demoFb && demoFb.eventsIntroHeading) || 'Upcoming Events',
      sectionLead: (demoFb && demoFb.eventsIntroBody) || '',
      sectionHref: hrefFor('/events'),
      sectionLinkLabel: 'View all',
      sectionRuled: true
    }) %>
    <div class="bb-tp-card-grid bb-tp-card-grid--2">
      <% teasers.events.forEach(function (event) { %>
      <% var parts = formatEventParts(event.startsAt, event.timezone, event.endsAt); %>
      <article class="bb-tp-event-card bb-tp-event-card--media">
        <% if (event.imageUrl) { %>
        <div class="bb-tp-event-card__media">
          <img src="<%= event.imageUrl %>" alt="<%= event.title %>" width="640" height="360" loading="lazy" decoding="async" />
        </div>
        <% } %>
        <div class="bb-tp-event-card__body">
          <div class="bb-tp-event-card__date" aria-hidden="true">
            <span class="bb-tp-event-card__month"><%= parts.month %></span>
            <span class="bb-tp-event-card__day"><%= parts.day %></span>
          </div>
          <div>
            <h3 class="bb-tp-event-card__title"><%= event.title %></h3>
            <% if (parts.timeRange) { %><p class="bb-tp-event-card__meta"><%= parts.weekday %> · <%= parts.timeRange %></p><% } %>
            <% if (event.summary) { %><p class="bb-tp-event-card__summary"><%= event.summary %></p><% } %>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (teasers.sermons && teasers.sermons.length) { %>
  <section class="bb-tp-container bb-tp-home-teaser" data-bb-home-sermons="1" aria-labelledby="bb-tp-home-sermons-heading">
    <%- include('./partials/section-heading', {
      sectionId: 'bb-tp-home-sermons-heading',
      sectionTitle: (demoFb && demoFb.sermonIntroHeading) || 'Latest Sermon',
      sectionLead: (demoFb && demoFb.sermonIntroBody) || '',
      sectionHref: hrefFor('/sermons'),
      sectionLinkLabel: 'Full library',
      sectionRuled: true
    }) %>
    <% var sermon = teasers.sermons[0]; %>
    <article class="bb-tp-sermon-feature">
      <% if (sermon.imageUrl) { %>
      <div class="bb-tp-sermon-feature__media">
        <img src="<%= sermon.imageUrl %>" alt="<%= sermon.title %>" width="800" height="450" loading="lazy" decoding="async" />
        <span class="bb-tp-sermon-feature__play material-symbols-outlined" aria-hidden="true">play_arrow</span>
      </div>
      <% } %>
      <div class="bb-tp-sermon-feature__copy">
        <% if (sermon.category) { %><p class="bb-tp-eyebrow"><%= sermon.category %></p><% } %>
        <h3 class="bb-tp-sermon-feature__title"><%= sermon.title %></h3>
        <p class="bb-tp-sermon-feature__meta">
          <%= sermon.speakerName %><% if (sermon.preachedAt) { %> · <%= formatDate(sermon.preachedAt) %><% } %>
        </p>
        <% if (sermon.summary) { %><p class="bb-tp-body"><%= sermon.summary %></p><% } %>
        <a class="bb-tp-btn bb-tp-btn--ghost" href="<%= hrefFor('/sermons') %>">Watch or listen</a>
      </div>
    </article>
  </section>
  <% } %>

  <% if (teasers.leaders && teasers.leaders.length) { %>
  <section class="bb-tp-container bb-tp-home-teaser" data-bb-home-leadership="1" aria-labelledby="bb-tp-home-leadership-heading">
    <%- include('./partials/section-heading', {
      sectionId: 'bb-tp-home-leadership-heading',
      sectionTitle: (demoFb && demoFb.leadershipIntroHeading) || 'Meet Our Pastors',
      sectionLead: (demoFb && demoFb.leadershipIntroBody) || '',
      sectionHref: hrefFor('/leadership'),
      sectionLinkLabel: 'Meet our team',
      sectionRuled: true
    }) %>
    <div class="bb-tp-card-grid bb-tp-card-grid--3">
      <% teasers.leaders.forEach(function (leader) { %>
      <%- include('./partials/leader-card', { leader: leader, featured: false, bioMax: 120 }) %>
      <% }) %>
    </div>
  </section>
  <% } %>

  <%- include('./partials/cta-band', {
    ctaClass: 'bb-tp-cta-band--giving',
    ctaTitle: (demoFb && demoFb.givingHeading) || 'Stewardship with Purpose',
    ctaBody: (demoFb && demoFb.givingBody) || 'Your generosity fuels worship, discipleship, and outreach.',
    ctaPrimary: { href: hrefFor('/giving'), label: 'Give Now' },
    ctaSecondary: { href: hrefFor('/contact'), label: 'Ask a question' }
  }) %>

  <section class="bb-tp-container bb-tp-home-contact" data-bb-home-contact="1" aria-labelledby="bb-tp-home-contact-heading">
    <%- include('./partials/section-heading', {
      sectionId: 'bb-tp-home-contact-heading',
      sectionTitle: (demoFb && demoFb.contactHeading) || 'Get in Touch',
      sectionLead: (demoFb && demoFb.contactBody) || '',
      sectionHref: hrefFor('/contact'),
      sectionLinkLabel: 'Contact'
    }) %>
    <div class="bb-tp-home-contact__grid">
      <% if (contact && contact.addressText) { %>
      <div class="bb-tp-home-contact__item">
        <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
        <div>
          <h3 class="bb-tp-home-contact__label">Location</h3>
          <p><%= contact.addressText %></p>
        </div>
      </div>
      <% } %>
      <% if (contact && contact.phone) { %>
      <div class="bb-tp-home-contact__item">
        <span class="material-symbols-outlined" aria-hidden="true">phone</span>
        <div>
          <h3 class="bb-tp-home-contact__label">Phone</h3>
          <p><% if (contact.phoneHref) { %><a href="<%= contact.phoneHref %>"><%= contact.phone %></a><% } else { %><%= contact.phone %><% } %></p>
        </div>
      </div>
      <% } %>
      <% if (contact && contact.email) { %>
      <div class="bb-tp-home-contact__item">
        <span class="material-symbols-outlined" aria-hidden="true">mail</span>
        <div>
          <h3 class="bb-tp-home-contact__label">Email</h3>
          <p><% if (contact.emailHref) { %><a href="<%= contact.emailHref %>"><%= contact.email %></a><% } else { %><%= contact.email %><% } %></p>
        </div>
      </div>
      <% } %>
    </div>
  </section>
</div>
