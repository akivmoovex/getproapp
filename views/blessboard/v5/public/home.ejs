<%#
  Tenant Home — Stitch 01-public-home-*-v2 (Refined).
  Desktop: ead45db5be774baa9454412262096ffc
  Mobile:  89177588fbf8405dbebd5747c38e19ce
  Published CMS sections only. No fabricated metrics, announcements,
  prayer widgets, schedule sidebars, or ministry demo cards.
%>
<%
  var hero = null;
  var rest = [];
  var serviceTimesSection = null;
  var serviceTimesEntries = [];
  (sections || []).forEach(function (s) {
    var key = String(s.sectionKey || '');
    var type = String(s.sectionType || '');
    var isServiceTimes =
      key === 'service_times' || key === 'services' || key === 'worship_times' ||
      type === 'service_times' || type === 'services' || type === 'worship_times';
    if (isServiceTimes && !serviceTimesSection) {
      serviceTimesSection = s;
      var meta = s.layoutMetadata && typeof s.layoutMetadata === 'object' ? s.layoutMetadata : null;
      if (meta && Array.isArray(meta.entries)) {
        serviceTimesEntries = meta.entries.filter(function (e) {
          return e && e.enabled !== false;
        }).slice().sort(function (a, b) {
          var ao = a.sortOrder != null ? Number(a.sortOrder) : 0;
          var bo = b.sortOrder != null ? Number(b.sortOrder) : 0;
          return ao - bo;
        });
      }
      return;
    }
    var isHero = !hero && (s.sectionType === 'hero' || String(s.sectionKey || '').indexOf('hero') >= 0);
    if (isHero) hero = s;
    else rest.push(s);
  });
  if (!hero && rest.length) {
    hero = rest.shift();
  }
  var heroHeading = (hero && hero.heading) || pageTitle || publicName;
  var heroBody = (hero && hero.bodyText) || '';
  var heroMedia = hero && hero.mediaUrl ? hero.mediaUrl : null;

  // Stitch display titles accent the trailing phrase (e.g. "Growth & Community").
  // Apply the same treatment to live headings without inventing copy.
  var accentBefore = heroHeading;
  var accentPhrase = '';
  var headingWords = String(heroHeading || '').trim().split(/\s+/).filter(Boolean);
  if (headingWords.length >= 4) {
    accentBefore = headingWords.slice(0, -2).join(' ') + ' ';
    accentPhrase = headingWords.slice(-2).join(' ');
  }

  function dayLabel(day) {
    var d = String(day || '');
    if (!d) return '';
    return d.charAt(0).toUpperCase() + d.slice(1);
  }
  function formatTimeLabel(hhmm) {
    var m = /^([01]?\d|2[0-3]):([0-5]\d)$/.exec(String(hhmm || ''));
    if (!m) return String(hhmm || '');
    var h = Number(m[1]);
    var min = m[2];
    var ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12;
    if (h === 0) h = 12;
    return h + ':' + min + ' ' + ampm;
  }
%>

<div class="bb-tp-home" data-bb-home="1" data-bb-stitch-home="refined-v2">
  <section class="bb-tp-hero" aria-label="Welcome">
    <div class="bb-tp-hero__inner">
      <div class="bb-tp-hero__copy">
        <p class="bb-tp-eyebrow bb-tp-eyebrow--pill bb-tp-hero__eyebrow-desktop">
          <span class="material-symbols-outlined" aria-hidden="true">verified</span>
          Official Church Portal
        </p>
        <p class="bb-tp-eyebrow bb-tp-eyebrow--pill bb-tp-hero__eyebrow-mobile">
          Welcome to our Digital Sanctuary
        </p>
        <h1 class="bb-tp-hero__title">
          <% if (accentPhrase) { %>
          <%= accentBefore %><span class="bb-tp-hero__title-accent"><%= accentPhrase %></span>
          <% } else { %>
          <%= heroHeading %>
          <% } %>
        </h1>
        <% if (heroBody) { %>
        <p class="bb-tp-hero__lead"><%= heroBody %></p>
        <% } %>
        <div class="bb-tp-hero__cta">
          <a class="bb-tp-btn bb-tp-btn--primary bb-tp-hero__cta-desktop" href="<%= hrefFor('/events') %>">
            Join a Service
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
          <a class="bb-tp-btn bb-tp-btn--ghost bb-tp-hero__cta-desktop" href="<%= hrefFor('/giving') %>">
            <span class="material-symbols-outlined" aria-hidden="true">favorite</span>
            Giving
          </a>
          <a class="bb-tp-btn bb-tp-btn--primary bb-tp-hero__cta-mobile" href="<%= hrefFor('/events') %>">
            Join Our Next Service
          </a>
          <a class="bb-tp-btn bb-tp-btn--ghost bb-tp-hero__cta-mobile" href="<%= hrefFor('/ministries') %>">
            Explore Ministries
          </a>
        </div>
      </div>
      <div class="bb-tp-hero__visual<%= heroMedia ? ' has-media' : '' %>">
        <% if (heroMedia) { %>
        <img
          class="bb-tp-hero__img"
          src="<%= heroMedia %>"
          alt=""
          width="960"
          height="960"
          loading="eager"
          decoding="async"
        />
        <% } else { %>
        <div class="bb-tp-hero__fallback" aria-hidden="true"></div>
        <% } %>
      </div>
    </div>
  </section>

  <% if (serviceTimesEntries.length) { %>
  <section class="bb-tp-container bb-tp-home__service-times" data-bb-home-service-times="1" aria-labelledby="bb-tp-service-times-heading">
    <h2 id="bb-tp-service-times-heading" class="bb-tp-section-title">
      <%= (serviceTimesSection && serviceTimesSection.heading) || 'Service Times' %>
    </h2>
    <ul class="bb-tp-service-times-list">
      <% serviceTimesEntries.forEach(function (entry) { %>
      <li class="bb-tp-service-times-item">
        <span class="bb-tp-service-times-item__day"><%= dayLabel(entry.day) %></span>
        <span class="bb-tp-service-times-item__name"><%= entry.name %></span>
        <span class="bb-tp-service-times-item__time">
          <%= formatTimeLabel(entry.startTime) %><% if (entry.endTime) { %>–<%= formatTimeLabel(entry.endTime) %><% } %>
        </span>
        <% if (entry.location) { %><span class="bb-tp-service-times-item__location"><%= entry.location %></span><% } %>
        <% if (entry.note) { %><span class="bb-tp-service-times-item__note"><%= entry.note %></span><% } %>
      </li>
      <% }) %>
    </ul>
  </section>
  <% } else if (serviceTimesSection && serviceTimesSection.bodyText) { %>
  <section class="bb-tp-container bb-tp-home__service-times" data-bb-home-service-times="1" aria-labelledby="bb-tp-service-times-heading">
    <h2 id="bb-tp-service-times-heading" class="bb-tp-section-title">
      <%= serviceTimesSection.heading || 'Service Times' %>
    </h2>
    <p class="bb-tp-body"><%= serviceTimesSection.bodyText %></p>
  </section>
  <% } %>

  <% if (showEmptyState) { %>
  <div class="bb-tp-container">
    <div class="bb-tp-empty bb-tp-empty--split" role="status" data-bb-empty="home">
      <div class="bb-tp-empty__visual" aria-hidden="true">
        <span class="material-symbols-outlined bb-tp-empty__icon">info</span>
      </div>
      <div class="bb-tp-empty__copy">
        <p class="bb-tp-empty__badge">Content coming soon</p>
        <h2><%= emptyHeadline %></h2>
        <p><%= emptyMessage %></p>
        <div class="bb-tp-page-hero__cta">
          <a class="bb-tp-btn bb-tp-btn--primary" href="<%= hrefFor('/contact') %>">Contact Us</a>
          <a class="bb-tp-btn bb-tp-btn--ghost" href="<%= hrefFor('/about') %>">About</a>
        </div>
      </div>
    </div>
  </div>
  <% } else if (rest.length) { %>
  <div class="bb-tp-container bb-tp-home__sections">
    <% rest.forEach(function (section) { %>
    <section class="bb-tp-content-block<%= section.mediaUrl ? ' bb-tp-content-block--media' : '' %>" data-section="<%= section.sectionKey %>">
      <% if (section.mediaUrl) { %>
      <div class="bb-tp-content-block__media">
        <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="" width="960" height="540" loading="lazy" decoding="async" />
      </div>
      <% } %>
      <div class="bb-tp-content-block__copy">
        <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
        <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
      </div>
    </section>
    <% }) %>
  </div>
  <% } %>

  <section class="bb-tp-shortcuts" aria-label="Explore">
    <div class="bb-tp-container">
      <header class="bb-tp-shortcuts__header">
        <h2 class="bb-tp-section-title">Explore</h2>
        <p class="bb-tp-shortcuts__lead">Find gatherings, ministries, messages, and our story.</p>
      </header>
      <div class="bb-tp-shortcuts__grid">
        <a class="bb-tp-shortcut" href="<%= hrefFor('/events') %>">
          <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
          <span class="bb-tp-shortcut__label">Events</span>
          <span class="bb-tp-shortcut__hint">Upcoming gatherings</span>
        </a>
        <a class="bb-tp-shortcut" href="<%= hrefFor('/ministries') %>">
          <span class="material-symbols-outlined" aria-hidden="true">groups</span>
          <span class="bb-tp-shortcut__label">Ministries</span>
          <span class="bb-tp-shortcut__hint">Find your place</span>
        </a>
        <a class="bb-tp-shortcut" href="<%= hrefFor('/sermons') %>">
          <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
          <span class="bb-tp-shortcut__label">Sermons</span>
          <span class="bb-tp-shortcut__hint">Messages and resources</span>
        </a>
        <a class="bb-tp-shortcut" href="<%= hrefFor('/about') %>">
          <span class="material-symbols-outlined" aria-hidden="true">info</span>
          <span class="bb-tp-shortcut__label">About</span>
          <span class="bb-tp-shortcut__hint">Our story and purpose</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bb-tp-member-band" aria-label="Members">
    <div class="bb-tp-container bb-tp-member-band__inner">
      <div class="bb-tp-member-band__copy">
        <h2 class="bb-tp-member-band__title">Already a Member?</h2>
        <p class="bb-tp-member-band__lead">Sign in for this church, or register if you are new.</p>
      </div>
      <div class="bb-tp-member-band__cta">
        <a class="bb-tp-btn bb-tp-btn--primary" href="<%= loginHref %>">Member Login</a>
        <a class="bb-tp-btn bb-tp-btn--ghost bb-tp-btn--on-dark" href="/register">Register</a>
      </div>
    </div>
  </section>
</div>
