<%#
  Phase 7 — Church Website Giving (Desktop; responsive).
  Stitch: e4fe61fbb9eb4b0987ca150d078aa76c
  Published methods only. No payment processing, checkout, or fabricated credentials.
  Method-card detail states also follow church-flow giving-information (account rows + QR).
%>
<%
  var demoFb =
    typeof givingDemoFallback !== 'undefined' && givingDemoFallback ? givingDemoFallback : null;
  var pageSections = (sections || []).filter(function (s) {
    return s && (s.heading || s.bodyText || s.mediaUrl || s.sectionKey);
  });
  var methods = (entities || []).filter(function (m) {
    return m && String(m.label || '').trim();
  });
  function findGivingSection(key) {
    for (var i = 0; i < pageSections.length; i++) {
      if (String(pageSections[i].sectionKey || '') === key) return pageSections[i];
    }
    return null;
  }
  var intro = findGivingSection('hero') || (pageSections.length ? pageSections[0] : null);
  var moreSections = pageSections.filter(function (s) {
    if (!s) return false;
    if (s === intro) return false;
    var key = String(s.sectionKey || '');
    if (key === 'hero' || key === 'why' || key === 'ways' || key === 'accountability' || key === 'stewardship' || key === 'assistance') return false;
    if (key.indexOf('why_') === 0) return false;
    return Boolean(s.heading || s.bodyText || s.mediaUrl);
  });
  var introHeading =
    (intro && intro.heading) ||
    (demoFb && demoFb.introHeading) ||
    pageTitle ||
    'Investing in Sacred Space and Community';
  var introBody =
    (intro && intro.bodyText) ||
    (demoFb && demoFb.introBody) ||
    '';
  var introMedia =
    (intro && intro.mediaUrl) ||
    (demoFb && demoFb.introMediaUrl) ||
    null;
  var isTestingEnv =
    typeof showEnvBadge !== 'undefined' && showEnvBadge;
  var whyHeading = (demoFb && demoFb.whyHeading) || 'Why We Give';
  var whyItems = (demoFb && demoFb.whyItems) || [];
  var accountability =
    (demoFb && demoFb.accountability) ||
    'For questions about designations or receipts, contact the church office. BlessBoard never collects card, bank, or wallet credentials on this page.';
  var accountabilityHeading = (demoFb && demoFb.accountabilityHeading) || 'Financial Accountability';
  var stewardshipHeading = (demoFb && demoFb.stewardshipHeading) || 'Stewardship and Support';
  var stewardshipBody = (demoFb && demoFb.stewardshipBody) || '';
  var assistanceContact = (demoFb && demoFb.assistanceContact) || '';
  var assistanceHeading = (demoFb && demoFb.assistanceHeading) || 'Need Assistance?';
  var assistanceButtonText = (demoFb && demoFb.assistanceButtonText) || 'Contact Finance Team';
  var waysHeading = (demoFb && demoFb.waysHeading) || 'Ways to Give';
  var waysBody =
    (demoFb && demoFb.waysBody) ||
    ('Methods published by ' + publicName + '. Follow the instructions below, or contact the church office if you need help.');
  var editing =
    typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode;

  var whySec = findGivingSection('why');
  var waysSec = findGivingSection('ways');
  var accountabilitySec = findGivingSection('accountability');
  var stewardshipSec = findGivingSection('stewardship');
  var assistanceSec = findGivingSection('assistance');
  if (whySec && whySec.heading) whyHeading = whySec.heading;
  if (waysSec && waysSec.heading) waysHeading = waysSec.heading;
  if (waysSec && waysSec.bodyText) waysBody = waysSec.bodyText;
  if (accountabilitySec && accountabilitySec.heading) accountabilityHeading = accountabilitySec.heading;
  if (accountabilitySec && accountabilitySec.bodyText) accountability = accountabilitySec.bodyText;
  if (stewardshipSec && stewardshipSec.heading) stewardshipHeading = stewardshipSec.heading;
  if (stewardshipSec && stewardshipSec.bodyText) stewardshipBody = stewardshipSec.bodyText;
  if (assistanceSec && assistanceSec.heading) assistanceHeading = assistanceSec.heading;
  if (assistanceSec && assistanceSec.bodyText) assistanceContact = assistanceSec.bodyText;
  if (assistanceSec && assistanceSec.layoutMetadata && assistanceSec.layoutMetadata.buttonText) {
    assistanceButtonText = assistanceSec.layoutMetadata.buttonText;
  }
  // Merge CMS why_* cards when present
  var whyFromCms = pageSections.filter(function (s) {
    return s && String(s.sectionKey || '').indexOf('why_') === 0;
  });
  if (whyFromCms.length) {
    whyItems = whyFromCms.map(function (s) {
      return {
        sectionKey: s.sectionKey,
        icon: 'volunteer_activism',
        title: s.heading || '',
        body: s.bodyText || ''
      };
    });
  }

  function methodTypeLabel(type) {
    var t = String(type || '').toLowerCase();
    if (t.indexOf('bank') >= 0 || t.indexOf('transfer') >= 0) return 'Bank transfer';
    if (t.indexOf('mobile') >= 0 || t.indexOf('momo') >= 0 || t.indexOf('airtel') >= 0 || t.indexOf('mtn') >= 0) {
      return 'Mobile money';
    }
    if (t.indexOf('cash') >= 0 || t.indexOf('offering') >= 0 || t.indexOf('person') >= 0) return 'In person';
    if (t.indexOf('online') >= 0 || t.indexOf('card') >= 0 || t.indexOf('pay') >= 0) return 'External link';
    return 'Giving method';
  }

  function methodScopeLabel(method) {
    if (method && method.scope === 'branch') return 'This branch';
    if (method && method.branchId) return 'This branch';
    return 'Church-wide';
  }

  /** Prefer copying short payment references; skip long prose. */
  function isCopyableReference(value) {
    var s = String(value || '').trim();
    if (s.length < 4 || s.length > 96) return false;
    if (s.split(/\s+/).length > 8) return false;
    if (/\[redacted\]/i.test(s)) return false;
    return /[0-9]{4,}/.test(s) || /^[A-Z]{2}\d{2}/i.test(s) || /@/.test(s);
  }

  function parseAccountRows(text) {
    var rows = [];
    String(text || '')
      .split(/\n+/)
      .forEach(function (line) {
        line = String(line || '').trim();
        if (!line) return;
        var m = line.match(/^([^:：|]{1,48})\s*[:：|]\s*(.+)$/);
        if (m) {
          rows.push({
            label: String(m[1] || '').trim(),
            value: String(m[2] || '').trim(),
            copyable: isCopyableReference(m[2])
          });
          return;
        }
        var parts = line.split(/\s*·\s*/).filter(Boolean);
        if (parts.length > 1 && parts.length <= 4) {
          parts.forEach(function (part) {
            var pm = String(part).match(/^([^:：]{1,32})\s*[:：]\s*(.+)$/);
            if (pm) {
              rows.push({
                label: String(pm[1] || '').trim(),
                value: String(pm[2] || '').trim(),
                copyable: isCopyableReference(pm[2])
              });
            } else {
              rows.push({
                label: null,
                value: String(part).trim(),
                copyable: isCopyableReference(part)
              });
            }
          });
          return;
        }
        rows.push({
          label: null,
          value: line,
          copyable: isCopyableReference(line)
        });
      });
    return rows;
  }

  function methodHasPublicDetail(method) {
    return Boolean(
      (method && method.accountDetails) ||
        (method && method.instructions) ||
        (method && method.qrImageUrl) ||
        (method && method.description) ||
        (method && method.externalUrl)
    );
  }
%>

<section
  class="bb-tp-directory bb-tp-giving"
  data-bb-giving="1"
  data-bb-stitch-giving="phase7-v1"
  aria-label="Giving"
>
  <%- include('./partials/page-hero', {
    heroHeading: introHeading,
    heroBody: introBody,
    heroMedia: introMedia,
    heroMediaAlt: 'Giving at ' + publicName,
    heroEyebrow: 'A Culture of Generosity',
    heroClass: 'bb-tp-giving-hero',
    heroCtaPrimary: methods.length
      ? { href: '#ways-to-give', label: 'Explore Ways to Give' }
      : { href: hrefFor('/contact'), label: 'Contact Church' },
    heroCtaSecondary: { href: hrefFor('/contact'), label: 'Contact Church' },
    editPageKey: 'giving',
    editSectionKey: 'hero'
  }) %>
  <div class="bb-tp-giving-hero-marker" data-bb-giving-hero="1" hidden></div>

  <div class="bb-tp-container bb-tp-directory__body bb-tp-giving__body">
    <aside class="bb-tp-giving-notice" role="note" data-bb-giving-notice="1">
      <span class="material-symbols-outlined" aria-hidden="true">info</span>
      <p>
        This page shares published giving instructions only. BlessBoard does not process payments or collect card, bank, or mobile-money account details here.
        <% if (isTestingEnv) { %>
        <strong data-bb-giving-testing="1"> Testing / demo environment — do not send real money.</strong>
        <% } %>
      </p>
    </aside>

    <% if (whyItems.length || editing) { %>
    <section class="bb-tp-giving-why" aria-labelledby="bb-tp-giving-why-heading" data-bb-giving-why="1">
      <%- include('../partials/editable-text', {
        editPageKey: 'giving',
        editSectionKey: 'why',
        editFieldKey: 'heading',
        editValue: whyHeading,
        editTag: 'h2',
        editClass: 'bb-tp-section-title bb-tp-section-title--ruled',
        editType: 'heading',
        editId: 'bb-tp-giving-why-heading',
        editMaxLength: 120,
        editMultiline: false
      }) %>
      <ul class="bb-tp-giving-why__grid">
        <% whyItems.forEach(function (item) { %>
        <% var whyKey = item.sectionKey || ('why_' + String(item.title || 'item').toLowerCase().replace(/[^a-z0-9]+/g, '_')); %>
        <li class="bb-tp-giving-why__card" data-section="<%= whyKey %>">
          <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon || 'volunteer_activism' %></span>
          <%- include('../partials/editable-text', {
            editPageKey: 'giving',
            editSectionKey: whyKey,
            editFieldKey: 'heading',
            editValue: item.title || '',
            editTag: 'h3',
            editClass: '',
            editType: 'heading',
            editMaxLength: 120,
            editMultiline: false
          }) %>
          <%- include('../partials/editable-text', {
            editPageKey: 'giving',
            editSectionKey: whyKey,
            editFieldKey: 'bodyText',
            editValue: item.body || '',
            editTag: 'p',
            editClass: '',
            editType: 'paragraph',
            editMaxLength: 500,
            editMultiline: true
          }) %>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (editing) { %>
    <div class="bb-tp-giving-editor-bar" data-bb-giving-editor="1" role="region" aria-label="Giving method editor">
      <p class="bb-tp-giving-editor-bar__title">Edit giving methods</p>
      <p class="bb-tp-giving-editor-bar__hint">Add, edit, or hide published methods. Visitors never see these controls.</p>
      <p class="bb-tp-edit-collection-actions">
        <%- include('../partials/structured-edit-trigger', {
          editKind: 'giving_method',
          editEntityKey: 'new-giving-method',
          editLabel: 'Add giving method',
          editPayload: {
            methodType: 'bank_transfer',
            label: '',
            description: '',
            accountDetails: '',
            instructions: '',
            externalUrl: '',
            buttonLabel: 'Open published link',
            qrImageUrl: '',
            visible: true,
            sortOrder: 100
          }
        }) %>
        <span class="bb-tp-se-hint">Add giving method</span>
      </p>
    </div>
    <% } %>

    <% if (methods.length) { %>
    <section id="ways-to-give" class="bb-tp-giving-methods" aria-labelledby="ways-to-give-heading" data-bb-giving-methods="1">
      <div class="bb-tp-giving-methods__head">
        <div class="bb-tp-giving-methods__title-row">
          <%- include('../partials/editable-text', {
            editPageKey: 'giving',
            editSectionKey: 'ways',
            editFieldKey: 'heading',
            editValue: waysHeading,
            editTag: 'h2',
            editClass: 'bb-tp-section-title bb-tp-section-title--ruled',
            editType: 'heading',
            editId: 'ways-to-give-heading',
            editMaxLength: 120,
            editMultiline: false
          }) %>
          <p class="bb-tp-giving-methods__count" data-bb-giving-method-count="<%= methods.length %>">
            <%= methods.length %> option<%= methods.length === 1 ? '' : 's' %> available
          </p>
        </div>
        <%- include('../partials/editable-text', {
          editPageKey: 'giving',
          editSectionKey: 'ways',
          editFieldKey: 'bodyText',
          editValue: waysBody,
          editTag: 'p',
          editClass: 'bb-tp-giving-methods__note',
          editType: 'paragraph',
          editMaxLength: 800,
          editMultiline: true
        }) %>
      </div>
      <ul class="bb-tp-giving-grid">
        <% methods.forEach(function (method) { %>
        <%
          var accountRows = method.accountDetails ? parseAccountRows(method.accountDetails) : [];
          var scopeLabel = methodScopeLabel(method);
          var showContactFallback = !methodHasPublicDetail(method);
        %>
        <li
          class="bb-tp-giving-card<%= method.qrImageUrl ? ' bb-tp-giving-card--has-qr' : '' %><%= method.accountDetails ? ' bb-tp-giving-card--has-account' : '' %>"
          data-bb-giving-method="<%= method.methodType || 'other' %>"
          data-bb-giving-id="<%= method.id || '' %>"
          data-bb-giving-scope="<%= method.scope || (method.branchId ? 'branch' : 'church') %>"
        >
          <header class="bb-tp-giving-card__head">
            <span class="bb-tp-giving-card__icon" aria-hidden="true">
              <span class="material-symbols-outlined"><%= method.icon || 'payments' %></span>
            </span>
            <div class="bb-tp-giving-card__titles">
              <p class="bb-tp-giving-card__type"><%= methodTypeLabel(method.methodType) %></p>
              <h3 class="bb-tp-giving-card__label"><%= method.label %></h3>
              <p class="bb-tp-giving-card__scope" data-bb-giving-scope-label="1"><%= scopeLabel %></p>
            </div>
          </header>

          <div class="bb-tp-giving-card__body">
            <% if (method.description) { %>
            <p class="bb-tp-giving-card__description" data-bb-giving-description="1"><%= method.description %></p>
            <% } %>

            <% if (accountRows.length) { %>
            <div class="bb-tp-giving-card__account" data-bb-giving-account="1">
              <p class="bb-tp-giving-card__block-label">Payment details</p>
              <dl class="bb-tp-giving-card__refs">
                <% accountRows.forEach(function (row, rowIdx) { %>
                <div class="bb-tp-giving-card__ref">
                  <% if (row.label) { %>
                  <dt class="bb-tp-giving-card__ref-label"><%= row.label %></dt>
                  <% } else { %>
                  <dt class="bb-tp-giving-card__ref-label bb-tp-giving-card__ref-label--sr">Reference <%= rowIdx + 1 %></dt>
                  <% } %>
                  <dd class="bb-tp-giving-card__ref-value">
                    <span class="bb-tp-giving-card__ref-text" data-bb-giving-ref="1"><%= row.value %></span>
                    <% if (row.copyable) { %>
                    <button
                      type="button"
                      class="bb-tp-giving-card__copy"
                      data-bb-copy-ref="1"
                      aria-label="Copy <%= row.label || 'payment reference' %>"
                    >
                      <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
                      <span class="bb-tp-giving-card__copy-text">Copy</span>
                    </button>
                    <% } %>
                  </dd>
                </div>
                <% }) %>
              </dl>
            </div>
            <% } else if (method.accountDetails) { %>
            <div class="bb-tp-giving-card__account" data-bb-giving-account="1">
              <p class="bb-tp-giving-card__block-label">Payment details</p>
              <p class="bb-tp-giving-card__instructions-body" data-bb-giving-ref="1"><%= method.accountDetails %></p>
            </div>
            <% } %>

            <% if (method.instructions) { %>
            <div class="bb-tp-giving-card__instructions" data-bb-giving-instructions="1">
              <p class="bb-tp-giving-card__block-label">Instructions</p>
              <p class="bb-tp-giving-card__instructions-body"><%= method.instructions %></p>
            </div>
            <% } %>

            <% if (method.qrImageUrl) { %>
            <figure class="bb-tp-giving-card__qr" data-bb-giving-qr="1">
              <img
                src="<%= method.qrImageUrl %>"
                alt="QR code for <%= method.label %>"
                width="144"
                height="144"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="bb-tp-giving-card__qr-caption">Scan to open this method</figcaption>
            </figure>
            <% } %>
          </div>

          <% if (method.externalUrl) { %>
          <p class="bb-tp-giving-card__action">
            <a
              class="bb-tp-btn bb-tp-btn--primary bb-tp-btn--block"
              href="<%= method.externalUrl %>"
              rel="noopener noreferrer"
              target="_blank"
              data-bb-giving-link="1"
              aria-label="<%= method.buttonLabel || 'Open published link' %> for <%= method.label %> (opens in a new tab)"
            >
              <%= method.buttonLabel || 'Open published link' %>
              <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
            </a>
          </p>
          <% } else if (showContactFallback) { %>
          <p class="bb-tp-giving-card__action">
            <a class="bb-tp-btn bb-tp-btn--ghost bb-tp-btn--block" href="<%= hrefFor('/contact') %>">
              Contact for details
            </a>
          </p>
          <% } %>

          <% if (editing) { %>
          <div class="bb-tp-giving-card__edit" data-bb-giving-card-edit="1">
            <%- include('../partials/structured-edit-trigger', {
              editKind: 'giving_method',
              editEntityKey: method.id || ('method-' + (method.label || 'new')),
              editLabel: 'Edit giving method',
              editPayload: {
                methodType: method.methodType || 'other',
                label: method.label || '',
                description: method.description || '',
                accountDetails: method.accountDetails || '',
                instructions: method.instructions || '',
                externalUrl: method.externalUrl || '',
                buttonLabel: method.buttonLabel || 'Open published link',
                qrImageUrl: method.qrImageUrl || '',
                visible: true,
                sortOrder: method.sortOrder != null ? method.sortOrder : 10
              }
            }) %>
            <span class="bb-tp-se-hint">Edit method</span>
          </div>
          <% } %>
        </li>
        <% }) %>
      </ul>
      <div class="bb-tp-sr-only" aria-live="polite" data-bb-copy-status="1"></div>
    </section>
    <% } else if (entitiesEmptyMessage) { %>
    <p class="bb-tp-lead" role="status"><%= entitiesEmptyMessage %></p>
    <% } %>

    <% moreSections.forEach(function (section) { %>
    <section class="bb-tp-section bb-tp-giving-section bb-tp-content-block" data-section="<%= section.sectionKey %>">
      <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
      <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
      <% if (section.mediaUrl) { %>
      <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="" width="960" height="540" loading="lazy" decoding="async" />
      <% } %>
    </section>
    <% }) %>

    <section class="bb-tp-giving-accountability" data-bb-giving-accountability="1" aria-labelledby="bb-tp-giving-accountability-heading">
      <%- include('../partials/editable-text', {
        editPageKey: 'giving',
        editSectionKey: 'accountability',
        editFieldKey: 'heading',
        editValue: accountabilityHeading,
        editTag: 'h2',
        editClass: 'bb-tp-section-title bb-tp-section-title--ruled',
        editType: 'heading',
        editId: 'bb-tp-giving-accountability-heading',
        editMaxLength: 120,
        editMultiline: false
      }) %>
      <%- include('../partials/editable-text', {
        editPageKey: 'giving',
        editSectionKey: 'accountability',
        editFieldKey: 'bodyText',
        editValue: accountability,
        editTag: 'p',
        editClass: 'bb-tp-body',
        editType: 'paragraph',
        editMaxLength: 2000,
        editMultiline: true
      }) %>
      <% if (stewardshipBody || editing) { %>
      <%- include('../partials/editable-text', {
        editPageKey: 'giving',
        editSectionKey: 'stewardship',
        editFieldKey: 'heading',
        editValue: stewardshipHeading || 'Stewardship and Support',
        editTag: 'h3',
        editClass: 'bb-tp-subsection-title',
        editType: 'heading',
        editMaxLength: 120,
        editMultiline: false
      }) %>
      <%- include('../partials/editable-text', {
        editPageKey: 'giving',
        editSectionKey: 'stewardship',
        editFieldKey: 'bodyText',
        editValue: stewardshipBody || '',
        editTag: 'p',
        editClass: 'bb-tp-body',
        editType: 'paragraph',
        editMaxLength: 2000,
        editMultiline: true
      }) %>
      <% } %>
    </section>

    <p class="bb-tp-giving-disclaimer" role="note" data-bb-giving-disclaimer="1">
      BlessBoard does not process payments or collect financial account details on this page. Use only the published methods above, or contact the church office for help.
    </p>

    <div data-bb-giving-support="1">
    <%- include('./partials/cta-band', {
      ctaClass: 'bb-tp-cta-band--giving',
      ctaTitle: assistanceHeading,
      ctaBody: assistanceContact || 'If you have questions about designations or published payment instructions, contact the church office.',
      ctaPrimary: { href: hrefFor('/contact'), label: assistanceButtonText },
      ctaSecondary: { href: hrefFor('/about'), label: 'About Our Church' },
      editPageKey: 'giving',
      editSectionKey: 'assistance'
    }) %>
    </div>
  </div>
</section>
