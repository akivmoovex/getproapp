<%#
  Phase 7 — Church Website Giving (Desktop; responsive).
  Stitch: e4fe61fbb9eb4b0987ca150d078aa76c
  Published methods only. No payment processing, checkout, or fabricated credentials.
%>
<%
  var demoFb =
    typeof givingDemoFallback !== 'undefined' && givingDemoFallback ? givingDemoFallback : null;
  var pageSections = (sections || []).filter(function (s) {
    return s && (s.heading || s.bodyText || s.mediaUrl);
  });
  var methods = (entities || []).filter(function (m) {
    return m && String(m.label || '').trim();
  });
  var intro = pageSections.length ? pageSections[0] : null;
  var moreSections = pageSections.length > 1 ? pageSections.slice(1) : [];
  var introHeading =
    (intro && intro.heading) ||
    (demoFb && demoFb.introHeading) ||
    pageTitle ||
    'Investing in Sacred Space and Community';
  var introBody =
    (intro && intro.bodyText) ||
    (demoFb && demoFb.introBody) ||
    '';
  var introMedia = intro && intro.mediaUrl ? intro.mediaUrl : null;
  var isTestingEnv =
    typeof showEnvBadge !== 'undefined' && showEnvBadge;
  var whyHeading = (demoFb && demoFb.whyHeading) || 'Why We Give';
  var whyItems = (demoFb && demoFb.whyItems) || [];
  var accountability =
    (demoFb && demoFb.accountability) ||
    'For questions about designations or receipts, contact the church office. BlessBoard never collects card, bank, or wallet credentials on this page.';
  var stewardshipHeading = (demoFb && demoFb.stewardshipHeading) || 'Stewardship and Support';
  var stewardshipBody = (demoFb && demoFb.stewardshipBody) || '';
  var assistanceContact = (demoFb && demoFb.assistanceContact) || '';

  function methodTypeLabel(type) {
    var t = String(type || '').toLowerCase();
    if (t.indexOf('bank') >= 0 || t.indexOf('transfer') >= 0) return 'Bank transfer';
    if (t.indexOf('mobile') >= 0 || t.indexOf('momo') >= 0 || t.indexOf('airtel') >= 0 || t.indexOf('mtn') >= 0) {
      return 'Mobile money';
    }
    if (t.indexOf('cash') >= 0 || t.indexOf('offering') >= 0 || t.indexOf('person') >= 0) return 'In person';
    if (t.indexOf('online') >= 0 || t.indexOf('card') >= 0 || t.indexOf('pay') >= 0) return 'External link';
    return 'Giving method';
  }
%>

<section
  class="bb-tp-directory bb-tp-giving"
  data-bb-giving="1"
  data-bb-stitch-giving="phase7-v1"
  aria-label="Giving"
>
  <%- include('./partials/page-hero', {
    heroHeading: introHeading,
    heroBody: introBody,
    heroMedia: introMedia,
    heroMediaAlt: 'Giving at ' + publicName,
    heroEyebrow: 'A Culture of Generosity',
    heroClass: 'bb-tp-giving-hero',
    heroCtaPrimary: methods.length
      ? { href: '#ways-to-give', label: 'Explore Ways to Give' }
      : { href: hrefFor('/contact'), label: 'Contact Church' },
    heroCtaSecondary: { href: hrefFor('/contact'), label: 'Contact Church' },
    editPageKey: 'giving',
    editSectionKey: 'hero'
  }) %>
  <div class="bb-tp-giving-hero-marker" data-bb-giving-hero="1" hidden></div>

  <div class="bb-tp-container bb-tp-directory__body">
    <aside class="bb-tp-giving-notice" role="note" data-bb-giving-notice="1">
      <span class="material-symbols-outlined" aria-hidden="true">info</span>
      <p>
        This page shares published giving instructions only. BlessBoard does not process payments or collect card, bank, or mobile-money account details here.
        <% if (isTestingEnv) { %>
        <strong data-bb-giving-testing="1"> Testing / demo environment — do not send real money.</strong>
        <% } %>
      </p>
    </aside>

    <% if (whyItems.length) { %>
    <section class="bb-tp-giving-why" aria-labelledby="bb-tp-giving-why-heading" data-bb-giving-why="1">
      <h2 id="bb-tp-giving-why-heading" class="bb-tp-section-title bb-tp-section-title--ruled"><%= whyHeading %></h2>
      <ul class="bb-tp-giving-why__grid">
        <% whyItems.forEach(function (item) { %>
        <li class="bb-tp-giving-why__card">
          <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon || 'volunteer_activism' %></span>
          <h3><%= item.title %></h3>
          <p><%= item.body %></p>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (methods.length) { %>
    <section id="ways-to-give" class="bb-tp-giving-methods" aria-labelledby="ways-to-give-heading" data-bb-giving-methods="1">
      <div class="bb-tp-giving-methods__head">
        <h2 id="ways-to-give-heading" class="bb-tp-section-title bb-tp-section-title--ruled">Ways to Give</h2>
        <p class="bb-tp-giving-methods__note">
          Methods published by <%= publicName %>. Follow the instructions below, or contact the church office if you need help.
        </p>
      </div>
      <ul class="bb-tp-giving-grid">
        <% methods.forEach(function (method) { %>
        <li class="bb-tp-giving-card" data-bb-giving-method="<%= method.methodType || 'other' %>">
          <span class="bb-tp-giving-card__icon" aria-hidden="true">
            <span class="material-symbols-outlined"><%= method.icon || 'payments' %></span>
          </span>
          <div class="bb-tp-giving-card__body">
            <p class="bb-tp-giving-card__type"><%= methodTypeLabel(method.methodType) %></p>
            <h3 class="bb-tp-giving-card__label"><%= method.label %></h3>
            <% if (method.instructions) { %>
            <div class="bb-tp-giving-card__instructions" data-bb-giving-instructions="1">
              <p class="bb-tp-giving-card__instructions-label">Instructions</p>
              <p class="bb-tp-giving-card__instructions-body"><%= method.instructions %></p>
            </div>
            <% } %>
            <% if (method.externalUrl) { %>
            <p class="bb-tp-giving-card__action">
              <a
                class="bb-tp-btn bb-tp-btn--primary bb-tp-btn--block"
                href="<%= method.externalUrl %>"
                rel="noopener noreferrer"
                target="_blank"
                data-bb-giving-link="1"
                aria-label="Open published giving link for <%= method.label %> (opens in a new tab)"
              >
                Open published link
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
              </a>
            </p>
            <% } else { %>
            <p class="bb-tp-giving-card__action">
              <a class="bb-tp-btn bb-tp-btn--ghost bb-tp-btn--block" href="<%= hrefFor('/contact') %>">
                Contact for details
              </a>
            </p>
            <% } %>
          </div>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } else if (entitiesEmptyMessage) { %>
    <p class="bb-tp-lead" role="status"><%= entitiesEmptyMessage %></p>
    <% } %>

    <% moreSections.forEach(function (section) { %>
    <section class="bb-tp-section bb-tp-giving-section bb-tp-content-block" data-section="<%= section.sectionKey %>">
      <% if (section.heading) { %><h2 class="bb-tp-section-title"><%= section.heading %></h2><% } %>
      <% if (section.bodyText) { %><p class="bb-tp-body"><%= section.bodyText %></p><% } %>
      <% if (section.mediaUrl) { %>
      <img class="bb-tp-media" src="<%= section.mediaUrl %>" alt="" width="960" height="540" loading="lazy" decoding="async" />
      <% } %>
    </section>
    <% }) %>

    <section class="bb-tp-giving-accountability" data-bb-giving-accountability="1" aria-labelledby="bb-tp-giving-accountability-heading">
      <h2 id="bb-tp-giving-accountability-heading" class="bb-tp-section-title bb-tp-section-title--ruled">Financial Accountability</h2>
      <p class="bb-tp-body"><%= accountability %></p>
      <% if (stewardshipBody) { %>
      <h3 class="bb-tp-subsection-title"><%= stewardshipHeading || 'Stewardship and Support' %></h3>
      <p class="bb-tp-body"><%= stewardshipBody %></p>
      <% } %>
    </section>

    <p class="bb-tp-giving-disclaimer" role="note">
      BlessBoard does not process payments or collect financial account details on this page. Use only the published methods above, or contact the church office for help.
    </p>

    <div data-bb-giving-support="1">
    <%- include('./partials/cta-band', {
      ctaClass: 'bb-tp-cta-band--giving',
      ctaTitle: 'Need Assistance?',
      ctaBody: assistanceContact || 'If you have questions about designations or published payment instructions, contact the church office.',
      ctaPrimary: { href: hrefFor('/contact'), label: 'Contact Finance Team' },
      ctaSecondary: { href: hrefFor('/about'), label: 'About Our Church' }
    }) %>
    </div>
  </div>
</section>
