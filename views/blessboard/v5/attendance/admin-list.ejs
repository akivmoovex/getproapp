<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-start') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-start') %>
<% } %>
<%
  var rows = events || [];
  var monthSummary = summary || null;
  var categoryRows = (monthSummary && (monthSummary.churchTotals || monthSummary.byBranch)) || [];
  var hasStatus = Boolean(statusFilter);
  var hasType = Boolean(eventTypeFilter);
  var hasListFilter = hasStatus || hasType;
  function statusLabel(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'draft') return 'Draft';
    if (key === 'submitted') return 'Submitted';
    if (key === 'approved') return 'Approved';
    if (key === 'archived') return 'Archived';
    return s || '—';
  }
  function statusChip(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'submitted' || key === 'approved') return 'bb-ba-chip--ok';
    if (key === 'draft') return 'bb-ba-chip--pending';
    return 'bb-ba-chip--muted';
  }
  function typeLabel(t) {
    var key = String(t || '');
    if (key === 'sunday_service') return 'Sunday service';
    if (key === 'midweek') return 'Midweek';
    if (key === 'special') return 'Special';
    if (key === 'youth') return 'Youth';
    if (key === 'children') return 'Children';
    if (key === 'other') return 'Other';
    return t || '—';
  }
  function categoryLabel(c) {
    if (c === 'first_time_visitors') return 'Visitors';
    if (c === 'adults') return 'Adults';
    if (c === 'youth') return 'Youth';
    if (c === 'children') return 'Children';
    if (c === 'volunteers') return 'Volunteers';
    if (c === 'other') return 'Other';
    return c;
  }
  function entryCount(ev, cat) {
    var list = ev.entries || [];
    for (var i = 0; i < list.length; i++) {
      if (list[i].category === cat) return list[i].count;
    }
    return 0;
  }
  function toDate(value) {
    if (!value) return null;
    var d = value instanceof Date ? value : new Date(String(value) + (String(value).length === 10 ? 'T00:00:00Z' : ''));
    if (isNaN(d.getTime())) return null;
    return d;
  }
  function formatDate(value) {
    var d = toDate(value);
    if (!d) return value ? String(value).slice(0, 10) : '—';
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
  }
  function dateMonth(value) {
    var d = toDate(value);
    if (!d) return '';
    return d.toLocaleDateString(undefined, { month: 'short' }).toUpperCase();
  }
  function dateDay(value) {
    var d = toDate(value);
    if (!d) return '';
    return String(d.getUTCDate());
  }
  function summaryTotalFor(cat) {
    for (var i = 0; i < categoryRows.length; i++) {
      if (categoryRows[i].category === cat) return categoryRows[i].totalCount;
    }
    return 0;
  }
  function listQuery(overrides) {
    var next = {
      month: yearMonth,
      status: statusFilter || '',
      event_type: eventTypeFilter || ''
    };
    Object.keys(overrides || {}).forEach(function (k) { next[k] = overrides[k]; });
    var parts = [];
    if (next.month) parts.push('month=' + encodeURIComponent(next.month));
    if (next.status) parts.push('status=' + encodeURIComponent(next.status));
    if (next.event_type) parts.push('event_type=' + encodeURIComponent(next.event_type));
    return parts.length ? ('?' + parts.join('&')) : '';
  }
  function statusHref(st) {
    return basePath + listQuery({ status: st || '' });
  }
  function typeHref(t) {
    return basePath + listQuery({ event_type: t || '' });
  }
  function clearListHref() {
    return basePath + listQuery({ status: '', event_type: '' });
  }
  var statusOptions = [
    { key: '', label: 'All statuses' },
    { key: 'draft', label: 'Draft' },
    { key: 'submitted', label: 'Submitted' },
    { key: 'approved', label: 'Approved' },
    { key: 'archived', label: 'Archived' }
  ];
  var typeOptions = [{ key: '', label: 'All types' }].concat(
    (eventTypes || []).map(function (t) { return { key: t, label: typeLabel(t) }; })
  );
  var scopeName = typeof branchDisplayName !== 'undefined' && branchDisplayName
    ? branchDisplayName
    : churchDisplayName;
%>

<section
  class="bb-att-admin"
  data-bb-attendance-admin-list="1"
  data-bb-stitch-attendance="36-branch-attendance-tracker"
  aria-label="Attendance tracker"
>
  <header class="bb-ba-page-head bb-ba-page-head--split">
    <div>
      <p class="bb-ba-breadcrumb">
        <% if (shellKind === 'hq') { %>
        <a href="/hq">HQ</a>
        <% } else { %>
        <a href="/branch-admin">Dashboard</a>
        <% } %>
        <span aria-hidden="true">›</span>
        <span>Attendance</span>
      </p>
      <h1 class="bb-ba-page-head__title">Attendance tracker</h1>
      <p class="bb-ba-lede">
        Manage and review aggregate attendance for
        <strong><%= scopeName %></strong>.
        Individual member check-in is not enabled. Monthly totals use submitted records only.
      </p>
    </div>
    <% if (canCreate) { %>
    <p class="bb-ba-page-head__actions">
      <a class="bb-ba-btn bb-ba-btn--primary" href="<%= basePath %>/new" data-bb-att-create="1">
        <span class="material-symbols-outlined" aria-hidden="true">add</span>
        Record attendance
      </a>
    </p>
    <% } %>
  </header>

  <% if (saved) { %>
  <%- include('../partials/flash-message', { type: 'success', title: 'Saved', message: 'Attendance changes saved.' }) %>
  <% } %>

  <% if (typeof isHqBranchScoped !== 'undefined' && isHqBranchScoped) { %>
  <p class="bb-ba-hint"><a href="/hq/attendance">← Church-wide attendance</a> · <a href="/hq/reports/attendance">Attendance report</a></p>
  <% } %>
  <% if (typeof isHqChurchWide !== 'undefined' && isHqChurchWide) { %>
  <p class="bb-ba-hint"><a href="/hq/reports/attendance">Open attendance report</a></p>
  <% if (branches && branches.length) { %>
  <section class="bb-hq-panel" data-bb-hq-att-branches="1" aria-labelledby="hq-att-branch-heading">
    <h2 id="hq-att-branch-heading" class="bb-hq-section-title">Branch attendance</h2>
    <ul class="bb-ca-branch-list">
      <% branches.forEach(function (branch) { %>
      <li>
        <a href="/hq/attendance/b/<%= branch.key %>"><%= branch.displayName %></a>
        <% if (branch.isPrimary) { %><span class="bb-ca-pill">Primary</span><% } %>
        <code class="bb-hq-key"><%= branch.key %></code>
      </li>
      <% }) %>
    </ul>
  </section>
  <% } %>
  <% } %>

  <section class="bb-att-summary bb-ba-panel" data-bb-attendance-monthly="1">
    <div class="bb-att-summary__head">
      <h2 class="bb-ba-section-title">Monthly summary · <%= yearMonth %></h2>
      <form method="get" action="<%= basePath %>" class="bb-att-month-form" role="search">
        <label class="bb-ba-sr-only" for="month">Month</label>
        <input id="month" type="month" name="month" value="<%= yearMonth %>" />
        <% if (statusFilter) { %><input type="hidden" name="status" value="<%= statusFilter %>" /><% } %>
        <% if (eventTypeFilter) { %><input type="hidden" name="event_type" value="<%= eventTypeFilter %>" /><% } %>
        <button type="submit" class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm">Show</button>
      </form>
    </div>

    <% if (!monthSummary || !categoryRows.length) { %>
    <div class="bb-att-summary-empty" data-bb-att-summary-empty="1" role="status">
      <%- include('../partials/empty-state', {
        title: 'No submitted attendance this month',
        body: 'Totals appear after you submit (or HQ approves) category counts for this month.',
        icon: 'how_to_reg',
        actionHref: canCreate ? (basePath + '/new') : null,
        actionLabel: canCreate ? 'Record attendance' : null
      }) %>
    </div>
    <% } else { %>
    <div class="bb-att-summary-cards" data-bb-att-summary-cards="1">
      <article class="bb-att-stat bb-att-stat--primary" data-bb-attendance-grand-total="<%= monthSummary.grandTotal %>">
        <p class="bb-att-stat__label">Total attendance</p>
        <p class="bb-att-stat__value"><%= monthSummary.grandTotal %></p>
        <p class="bb-att-stat__hint">Submitted / approved / archived · <%= yearMonth %></p>
      </article>
      <% ['first_time_visitors','adults','youth','children'].forEach(function (cat) { %>
      <article class="bb-att-stat" data-bb-attendance-category="<%= cat %>">
        <p class="bb-att-stat__label"><%= categoryLabel(cat) %></p>
        <p class="bb-att-stat__value"><%= summaryTotalFor(cat) %></p>
        <p class="bb-att-stat__hint">Monthly category total</p>
      </article>
      <% }) %>
    </div>
    <ul class="bb-att-summary-list" data-bb-attendance-summary-list="1">
      <% categoryRows.forEach(function (row) { %>
      <li>
        <%= categoryLabel(row.category) %>: <%= row.totalCount %>
        (<%= row.eventCount %> event<%= row.eventCount === 1 ? '' : 's' %>)
      </li>
      <% }) %>
    </ul>
    <% } %>
  </section>

  <form method="get" action="<%= basePath %>" class="bb-ba-filter bb-att-filter" data-bb-att-filter="1" role="search">
    <input type="hidden" name="month" value="<%= yearMonth %>" />
    <div class="bb-ba-field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="">All statuses</option>
        <% ['draft','submitted','approved','archived'].forEach(function (st) { %>
        <option value="<%= st %>" <%= statusFilter === st ? 'selected' : '' %>><%= statusLabel(st) %></option>
        <% }) %>
      </select>
    </div>
    <div class="bb-ba-field">
      <label for="event_type">Service type</label>
      <select id="event_type" name="event_type">
        <option value="">All types</option>
        <% eventTypes.forEach(function (t) { %>
        <option value="<%= t %>" <%= eventTypeFilter === t ? 'selected' : '' %>><%= typeLabel(t) %></option>
        <% }) %>
      </select>
    </div>
    <div class="bb-ba-filter__actions">
      <button type="submit" class="bb-ba-btn bb-ba-btn--primary">
        <span class="material-symbols-outlined" aria-hidden="true">filter_list</span>
        Filter
      </button>
      <% if (hasListFilter) { %>
      <a class="bb-ba-btn bb-ba-btn--ghost" href="<%= clearListHref() %>">Clear</a>
      <% } %>
    </div>
  </form>

  <nav class="bb-ba-entities-chips" aria-label="Attendance status filters" data-bb-att-status-chips="1">
    <% statusOptions.forEach(function (opt) { %>
    <a
      class="bb-ba-entities-chip<%= (statusFilter || '') === opt.key ? ' is-active' : '' %>"
      href="<%= statusHref(opt.key) %>"
      <%= (statusFilter || '') === opt.key ? 'aria-current="page"' : '' %>
      data-bb-att-status-filter="<%= opt.key || 'all' %>"
    ><%= opt.label %></a>
    <% }) %>
  </nav>

  <nav class="bb-ba-entities-chips" aria-label="Service type filters" data-bb-att-type-chips="1">
    <% typeOptions.forEach(function (opt) { %>
    <a
      class="bb-ba-entities-chip<%= (eventTypeFilter || '') === opt.key ? ' is-active' : '' %>"
      href="<%= typeHref(opt.key) %>"
      <%= (eventTypeFilter || '') === opt.key ? 'aria-current="page"' : '' %>
      data-bb-att-type-filter="<%= opt.key || 'all' %>"
    ><%= opt.label %></a>
    <% }) %>
  </nav>

  <section class="bb-ba-panel bb-att-table-panel" data-bb-att-history="1">
    <div class="bb-att-history__head">
      <h2 class="bb-ba-section-title">Recent records</h2>
      <p class="bb-ba-entities-panel__meta"><%= rows.length %> shown · <%= yearMonth %></p>
    </div>

    <% if (!rows.length) { %>
    <div class="bb-att-history-empty" data-bb-att-history-empty="<%= hasListFilter ? 'no-results' : 'catalog' %>" role="status">
      <%- include('../partials/empty-state', {
        title: hasListFilter ? 'No matching records' : 'No attendance records yet',
        body: hasListFilter
          ? 'Try another status or service type, or clear filters.'
          : 'Create a draft service record, enter category counts, then submit to HQ.',
        icon: hasListFilter ? 'search_off' : 'event_available',
        actionHref: hasListFilter ? clearListHref() : (canCreate ? (basePath + '/new') : null),
        actionLabel: hasListFilter ? 'Clear filters' : (canCreate ? 'Record attendance' : null)
      }) %>
    </div>
    <% } else { %>

    <div class="bb-ba-table-wrap bb-att-table-wrap" role="region" aria-label="Attendance records table" tabindex="0" data-bb-att-table-desktop="1">
      <table class="bb-ba-table bb-att-table" data-bb-att-table="1">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Type</th>
            <th scope="col">Title</th>
            <th scope="col">Total</th>
            <th scope="col">Adults</th>
            <th scope="col">Youth</th>
            <th scope="col">Children</th>
            <th scope="col">Visitors</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="bb-ba-sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function (ev) { %>
          <tr data-bb-status="<%= ev.status %>" data-bb-att-row="<%= ev.id %>">
            <td><%= formatDate(ev.eventDate) %></td>
            <td><%= typeLabel(ev.eventType) %></td>
            <td><a class="bb-ann-title-link" href="<%= basePath %>/<%= ev.id %>"><%= ev.title %></a></td>
            <td><%= ev.totalCount %></td>
            <td><%= entryCount(ev, 'adults') %></td>
            <td><%= entryCount(ev, 'youth') %></td>
            <td><%= entryCount(ev, 'children') %></td>
            <td><%= entryCount(ev, 'first_time_visitors') %></td>
            <td><span class="bb-ba-chip <%= statusChip(ev.status) %>"><%= statusLabel(ev.status) %></span></td>
            <td><a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="<%= basePath %>/<%= ev.id %>">Open</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="bb-att-cards" data-bb-att-cards="1">
      <% rows.forEach(function (ev) { %>
      <article class="bb-att-card bb-ba-panel" data-bb-att-card="<%= ev.id %>" data-bb-status="<%= ev.status %>">
        <div class="bb-att-card__date" aria-hidden="true">
          <span class="bb-att-card__month"><%= dateMonth(ev.eventDate) %></span>
          <span class="bb-att-card__day"><%= dateDay(ev.eventDate) %></span>
        </div>
        <div class="bb-att-card__body">
          <h3 class="bb-att-card__title">
            <a href="<%= basePath %>/<%= ev.id %>"><%= ev.title %></a>
          </h3>
          <p class="bb-att-card__meta">
            <%= typeLabel(ev.eventType) %>
            · <span class="material-symbols-outlined" aria-hidden="true">group</span>
            <%= ev.totalCount %>
          </p>
          <p class="bb-ba-sr-only"><%= formatDate(ev.eventDate) %></p>
        </div>
        <span class="bb-ba-chip <%= statusChip(ev.status) %>"><%= statusLabel(ev.status) %></span>
      </article>
      <% }) %>
    </div>

    <p class="bb-ba-hint" data-bb-att-list-bound="1">Showing up to <%= rows.length %> events for <%= yearMonth %> (bounded list).</p>
    <% } %>
  </section>

  <aside class="bb-ba-entities-unavailable" data-bb-att-unavailable="1" aria-label="Unavailable in V5">
    <p data-bb-att-unavailable-row="individual">Individual member attendance and QR check-in are not available.</p>
    <p data-bb-att-unavailable-row="trends">Trend percentages, 30-day averages, and projected growth are not calculated here.</p>
    <p data-bb-att-unavailable-row="biometric">Biometric entry and offline sync are not available.</p>
  </aside>
</section>

<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-end') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-end') %>
<% } %>
