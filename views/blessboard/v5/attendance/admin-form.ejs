<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-start') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-start') %>
<% } %>
<%
  var isEdit = formMode === 'edit' && event && event.id;
  function typeLabel(t) {
    if (t === 'sunday_service') return 'Sunday service';
    if (t === 'midweek') return 'Midweek';
    if (t === 'special') return 'Special';
    if (t === 'youth') return 'Youth';
    if (t === 'children') return 'Children';
    if (t === 'other') return 'Other';
    return t;
  }
  function eventAtValue(ev) {
    if (!ev || !ev.eventAt) return '';
    var d = ev.eventAt instanceof Date ? ev.eventAt : new Date(ev.eventAt);
    if (isNaN(d.getTime())) return '';
    var pad = function (n) { return String(n).padStart(2, '0'); };
    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
  }
%>

<section
  class="bb-att-admin bb-att-form-page"
  data-bb-attendance-admin-form="1"
  data-bb-form-mode="<%= formMode || 'create' %>"
  data-bb-stitch-attendance-form="36-branch-attendance-tracker"
>
  <header class="bb-ba-page-head">
    <p class="bb-ba-breadcrumb">
      <a href="<%= basePath %>">Attendance</a>
      <span aria-hidden="true">›</span>
      <span><%= isEdit ? 'Edit' : 'Create' %></span>
    </p>
    <h1 class="bb-ba-page-head__title"><%= isEdit ? 'Edit attendance event' : 'Record attendance' %></h1>
    <p class="bb-ba-lede">
      Fill in the meeting details to create a draft. Enter aggregate category counts on the next screen.
      This does not record individual members.
    </p>
  </header>

  <% if (error) { %>
  <%- include('../partials/form-errors', { errors: [error], id: 'bb-att-form-errors' }) %>
  <% } %>

  <form
    method="post"
    action="<%= isEdit ? (basePath + '/' + event.id + '/edit') : basePath %>"
    class="bb-ba-panel bb-att-form"
    data-bb-att-form="1"
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <section class="bb-att-form__section" aria-labelledby="bb-att-meeting-heading" data-bb-att-form-section="meeting">
      <h2 id="bb-att-meeting-heading" class="bb-ba-entities-form__section-title">Meeting details</h2>
      <div class="bb-ba-field">
        <label for="title">Meeting name</label>
        <input id="title" type="text" name="title" maxlength="200" required value="<%= event && event.title ? event.title : '' %>" autocomplete="off" />
      </div>
      <div class="bb-att-form__grid">
        <div class="bb-ba-field">
          <label for="event_type">Meeting type</label>
          <select id="event_type" name="event_type" required>
            <% eventTypes.forEach(function (t) { %>
            <option value="<%= t %>" <%= event && event.eventType === t ? 'selected' : '' %>><%= typeLabel(t) %></option>
            <% }) %>
          </select>
        </div>
        <div class="bb-ba-field">
          <label for="event_date">Meeting date</label>
          <input id="event_date" type="date" name="event_date" required value="<%= event && event.eventDate ? event.eventDate : '' %>" />
        </div>
      </div>
      <div class="bb-ba-field">
        <label for="event_at">Time (optional)</label>
        <input id="event_at" type="datetime-local" name="event_at" value="<%= eventAtValue(event) %>" />
      </div>
    </section>

    <p class="bb-ba-hint" data-bb-att-form-hint="aggregate">
      Population breakdown is entered after the draft is created — adults, youth, children, visitors, volunteers, and other.
    </p>

    <div class="bb-ba-decision__actions bb-att-form__actions">
      <a class="bb-ba-btn bb-ba-btn--ghost" href="<%= isEdit ? (basePath + '/' + event.id) : basePath %>">Cancel</a>
      <button type="submit" class="bb-ba-btn bb-ba-btn--primary"><%= isEdit ? 'Save changes' : 'Save as draft' %></button>
    </div>
  </form>
</section>

<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-end') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-end') %>
<% } %>
