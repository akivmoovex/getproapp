<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-start') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-start') %>
<% } %>
  <h1>New attendance event</h1>
  <p><a href="<%= basePath %>">Back</a></p>
  <% if (error) { %><p class="bb-ann-error" role="alert"><%= error %></p><% } %>
  <form method="post" action="<%= basePath %>" class="bb-att-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>Title
      <input type="text" name="title" maxlength="200" required value="<%= event && event.title ? event.title : '' %>" />
    </label>
    <label>Type
      <select name="event_type" required>
        <% eventTypes.forEach(function (t) { %>
          <option value="<%= t %>" <%= event && event.eventType === t ? 'selected' : '' %>><%= t %></option>
        <% }) %>
      </select>
    </label>
    <label>Date
      <input type="date" name="event_date" required value="<%= event && event.eventDate ? event.eventDate : '' %>" />
    </label>
    <label>Time (optional)
      <input type="datetime-local" name="event_at" />
    </label>
    <button type="submit">Create draft</button>
  </form>
<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-end') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-end') %>
<% } %>
