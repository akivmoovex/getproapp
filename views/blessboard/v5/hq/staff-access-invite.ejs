<%- include('../partials/hq-shell-start') %>
<%
  var placement = placement === 'branch' ? 'branch' : 'hq';
  var branchOptions = branches || [];
  var roleOptions = roles || [];
  var draft = draft || {};
%>
<section class="bb-hq-page" data-bb-staff-invite="1" aria-label="Add team member">
  <header class="bb-hq-page-head">
    <p class="bb-hq-breadcrumb">
      <a href="/hq/settings/staff-access">Staff access</a>
      <span aria-hidden="true">›</span>
      <span>Add team member</span>
    </p>
    <h1 class="bb-hq-page-head__title">Add team member</h1>
    <p class="bb-hq-lede">
      Adding to <strong><%= placement === 'branch' ? 'a branch' : 'HQ (church-wide)' %></strong>.
      Phone is required; email is optional.
    </p>
  </header>

  <% if (error) { %>
  <p class="bb-hq-banner bb-hq-banner--error" role="alert"><%= error %></p>
  <% } %>

  <form method="post" action="/hq/settings/staff-access/invite" class="bb-hq-card bb-hq-roles__form" data-bb-hq-team-invite-form="1">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />
    <input type="hidden" name="placement" value="<%= placement %>" />
    <div class="bb-hq-field">
      <label for="first_name">First name</label>
      <input id="first_name" name="first_name" required maxlength="100" value="<%= draft.firstName || '' %>" />
    </div>
    <div class="bb-hq-field">
      <label for="last_name">Last name</label>
      <input id="last_name" name="last_name" required maxlength="100" value="<%= draft.lastName || '' %>" />
    </div>
    <div class="bb-hq-field">
      <label for="phone">Phone</label>
      <input id="phone" name="phone" type="tel" required maxlength="40" value="<%= draft.phone || '' %>" />
    </div>
    <div class="bb-hq-field">
      <label for="email">Email (optional)</label>
      <input id="email" name="email" type="email" maxlength="254" value="<%= draft.email || '' %>" />
    </div>
    <% if (placement === 'branch') { %>
    <div class="bb-hq-field">
      <label for="branch_id">Branch</label>
      <select id="branch_id" name="branch_id" required>
        <option value="">Select branch</option>
        <% branchOptions.forEach(function (b) { %>
        <option value="<%= b.id %>" <%= String(draft.branchId) === String(b.id) ? 'selected' : '' %>><%= b.displayName || b.display_name %></option>
        <% }); %>
      </select>
    </div>
    <% } %>
    <div class="bb-hq-field">
      <label for="role_key">Role</label>
      <select id="role_key" name="role_key" required>
        <% if (placement === 'hq') { %>
        <option value="church_hq_admin">Organisation Administrator (HQ bootstrap)</option>
        <% } else { %>
        <option value="branch_admin">Branch Administrator (bootstrap)</option>
        <% } %>
        <% roleOptions.forEach(function (r) { %>
        <option value="<%= r.roleKey %>" <%= draft.roleKey === r.roleKey ? 'selected' : '' %>><%= r.displayName %> (<%= r.sensitivityLabel %>)</option>
        <% }); %>
      </select>
    </div>
    <div class="bb-hq-field">
      <label for="assignment_reason">Assignment reason</label>
      <input id="assignment_reason" name="assignment_reason" maxlength="500" value="<%= draft.assignmentReason || '' %>" />
    </div>
    <div class="bb-hq-field">
      <label for="leadership_title">Church leadership title (optional)</label>
      <input id="leadership_title" name="leadership_title" maxlength="120" />
    </div>
    <button type="submit" class="bb-hq-btn bb-hq-btn--primary">Create invitation</button>
  </form>
</section>
<%- include('../partials/hq-shell-end') %>
