<%- include('../partials/hq-shell-start') %>
<%
  var f = form || {};
  var values = f.values || {};
  var branchesList = branches || [];
  var errors = f.fieldErrors || [];
  function fieldMessage(name) {
    for (var i = 0; i < errors.length; i++) {
      if (errors[i] && errors[i].field === name) return errors[i].message;
    }
    return '';
  }
  var nameError = fieldMessage('full_name');
  var phoneError = fieldMessage('phone');
  var emailError = fieldMessage('email');
  var branchError = fieldMessage('branch_id');
  var addressError = fieldMessage('address_line_1');
  var maritalError = fieldMessage('marital_status');
  var kinNameError = fieldMessage('next_of_kin_name');
  var kinRelError = fieldMessage('next_of_kin_relationship');
  var kinPhoneError = fieldMessage('next_of_kin_phone');
  var maritalOptions = f.maritalOptions || [];
  var relationshipOptions = f.relationshipOptions || [];
%>
<section class="bb-hq-members" data-bb-hq-member-add="1" aria-labelledby="bb-hq-add-member-title">
  <header class="bb-hq-page-head">
    <p class="bb-hq-breadcrumb"><a href="/hq/members">Members</a> <span aria-hidden="true">›</span> Add member</p>
    <h1 id="bb-hq-add-member-title" class="bb-hq-page-head__title">Add member</h1>
    <p class="bb-hq-lede">Prepare a church membership record. Portal activation is handled separately.</p>
  </header>
  <div class="bb-hq-panel">
    <div class="bb-hq-panel__head">
      <h2 class="bb-hq-members-panel__title">Member details</h2>
      <p class="bb-hq-lede">Review and confirm possible matches before creation.</p>
    </div>
    <% if (errors.length) { %>
    <div class="bb-hq-login-unavailable" role="alert">
      <%- include('../partials/form-errors', { title: 'Please correct the highlighted fields', errors: errors }) %>
    </div>
    <% } %>
    <form class="bb-hq-filter" method="post" action="/hq/members/new" data-bb-hq-add-member-form="1" aria-describedby="bb-hq-add-member-status">
      <div class="bb-hq-field">
        <label for="hq_add_full_name">Full name</label>
        <input id="hq_add_full_name" name="full_name" type="text" value="<%= values.fullName || '' %>" autocomplete="name" required aria-required="true"<% if (nameError) { %> aria-invalid="true" aria-describedby="hq_add_full_name_error"<% } %> />
        <% if (nameError) { %><p id="hq_add_full_name_error" class="bb-hq-field-error" role="alert"><%= nameError %></p><% } %>
      </div>
      <div class="bb-hq-field">
        <label for="hq_add_email">Email <span class="bb-hq-muted">(optional)</span></label>
        <input id="hq_add_email" name="email" type="email" value="<%= values.email || '' %>" autocomplete="email"<% if (emailError) { %> aria-invalid="true" aria-describedby="hq_add_email_error"<% } %> />
        <% if (emailError) { %><p id="hq_add_email_error" class="bb-hq-field-error" role="alert"><%= emailError %></p><% } %>
      </div>
      <div class="bb-hq-field">
        <label for="hq_add_phone">Phone</label>
        <input id="hq_add_phone" name="phone" type="tel" value="<%= values.phone || '' %>" autocomplete="tel" required aria-required="true"<% if (phoneError) { %> aria-invalid="true" aria-describedby="hq_add_phone_error"<% } %> />
        <% if (phoneError) { %><p id="hq_add_phone_error" class="bb-hq-field-error" role="alert"><%= phoneError %></p><% } %>
      </div>
      <div class="bb-hq-field">
        <label for="hq_add_address">Residential address</label>
        <input id="hq_add_address" name="address_line_1" type="text" maxlength="300" value="<%= values.addressLine1 || '' %>" autocomplete="street-address" required aria-required="true"<% if (addressError) { %> aria-invalid="true"<% } %> />
        <% if (addressError) { %><p class="bb-hq-field-error" role="alert"><%= addressError %></p><% } %>
      </div>
      <div class="bb-hq-field">
        <label for="hq_add_marital">Marital status</label>
        <select id="hq_add_marital" name="marital_status" required aria-required="true"<% if (maritalError) { %> aria-invalid="true"<% } %>>
          <option value="">Select a marital status</option>
          <% maritalOptions.forEach(function (option) { %>
          <option value="<%= option %>" <%= values.maritalStatus === option ? 'selected' : '' %>><%= option %></option>
          <% }) %>
        </select>
        <% if (maritalError) { %><p class="bb-hq-field-error" role="alert"><%= maritalError %></p><% } %>
      </div>
      <div class="bb-hq-field">
        <label for="hq_add_kin_name">Emergency contact name</label>
        <input id="hq_add_kin_name" name="next_of_kin_name" type="text" maxlength="120" value="<%= values.nextOfKinName || '' %>" required aria-required="true"<% if (kinNameError) { %> aria-invalid="true"<% } %> />
        <% if (kinNameError) { %><p class="bb-hq-field-error" role="alert"><%= kinNameError %></p><% } %>
      </div>
      <div class="bb-hq-field">
        <label for="hq_add_kin_rel">Emergency relationship</label>
        <select id="hq_add_kin_rel" name="next_of_kin_relationship" required aria-required="true"<% if (kinRelError) { %> aria-invalid="true"<% } %>>
          <option value="">Select a relationship</option>
          <% relationshipOptions.forEach(function (option) { %>
          <option value="<%= option %>" <%= values.nextOfKinRelationship === option ? 'selected' : '' %>><%= option %></option>
          <% }) %>
        </select>
        <% if (kinRelError) { %><p class="bb-hq-field-error" role="alert"><%= kinRelError %></p><% } %>
      </div>
      <div class="bb-hq-field">
        <label for="hq_add_kin_phone">Emergency phone</label>
        <input id="hq_add_kin_phone" name="next_of_kin_phone" type="tel" value="<%= values.nextOfKinPhone || '' %>" autocomplete="tel" required aria-required="true"<% if (kinPhoneError) { %> aria-invalid="true"<% } %> />
        <% if (kinPhoneError) { %><p class="bb-hq-field-error" role="alert"><%= kinPhoneError %></p><% } %>
      </div>
      <div class="bb-hq-field">
        <label for="hq_add_branch">Authorized branch</label>
        <select id="hq_add_branch" name="branch_id" required aria-required="true"<% if (branchError) { %> aria-invalid="true" aria-describedby="hq_add_branch_error"<% } %>>
          <option value="" <%= values.branchId ? '' : 'selected' %>>Select a branch</option>
          <% branchesList.forEach(function (branch) { %>
          <option value="<%= branch.id || '' %>" <%= String(values.branchId || '') === String(branch.id || '') ? 'selected' : '' %>><%= branch.displayName || branch.key %></option>
          <% }) %>
        </select>
        <% if (branchError) { %><p id="hq_add_branch_error" class="bb-hq-field-error" role="alert"><%= branchError %></p><% } %>
      </div>
      <p id="bb-hq-add-member-status" class="bb-hq-lede" role="status">Portal activation remains pending after creation.</p>
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />
      <button type="submit" class="bb-hq-btn bb-hq-btn--primary">Continue</button>
    </form>
  </div>
</section>
<%- include('../partials/hq-shell-end') %>
