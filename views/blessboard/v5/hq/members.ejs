<%- include('../partials/hq-shell-start') %>
<%
  var rows = items || [];
  var branchOptions = branches || [];
  function statusLabel(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'active') return 'Active';
    if (key === 'pending') return 'Pending';
    if (key === 'inactive') return 'Inactive';
    if (key === 'suspended') return 'Suspended';
    if (key === 'archived') return 'Archived';
    return s || '—';
  }
  function statusChip(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'active') return 'bb-hq-chip--ok';
    if (key === 'pending') return 'bb-hq-chip--pending';
    if (key === 'inactive' || key === 'archived') return 'bb-hq-chip--muted';
    if (key === 'suspended') return 'bb-hq-chip--danger';
    return 'bb-hq-chip--muted';
  }
  function initials(item) {
    var a = String(item.firstName || '').charAt(0);
    var b = String(item.lastName || '').charAt(0);
    return (a + b).toUpperCase() || '?';
  }
  function pagerHref(p) {
    return '/hq/members?page=' + p
      + '&q=' + encodeURIComponent(q || '')
      + '&status=' + encodeURIComponent(statusFilter || '')
      + '&branch=' + encodeURIComponent(branchFilter || '');
  }
%>

<section class="bb-hq-members" data-bb-hq-member-directory="1">
  <header class="bb-hq-page-head bb-hq-page-head--split">
    <div>
      <h1 class="bb-hq-page-head__title">Member directory</h1>
      <p class="bb-hq-lede">
        Church-wide members for <strong><%= churchDisplayName %></strong>.
        Contact fields are display-only — no normalized identifiers are shown.
      </p>
    </div>
    <p class="bb-hq-page-head__actions">
      <a class="bb-hq-btn bb-hq-btn--ghost" href="/hq/registrations">Registration oversight</a>
    </p>
  </header>

  <form method="get" action="/hq/members" class="bb-hq-filter" data-bb-hq-member-filter="1">
    <div class="bb-hq-field">
      <label for="q">Search</label>
      <input
        id="q"
        name="q"
        type="search"
        maxlength="100"
        value="<%= q || '' %>"
        placeholder="Name, email, or phone"
        autocomplete="off"
      />
    </div>
    <div class="bb-hq-field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="">All statuses</option>
        <% ['active','pending','inactive','suspended','archived'].forEach(function (st) { %>
        <option value="<%= st %>" <%= statusFilter === st ? 'selected' : '' %>><%= statusLabel(st) %></option>
        <% }) %>
      </select>
    </div>
    <div class="bb-hq-field">
      <label for="branch">Branch</label>
      <select id="branch" name="branch">
        <option value="">All branches</option>
        <% branchOptions.forEach(function (b) { %>
        <option value="<%= b.key %>" <%= branchFilter === b.key ? 'selected' : '' %>><%= b.displayName %></option>
        <% }) %>
      </select>
    </div>
    <div class="bb-hq-filter__actions">
      <button type="submit" class="bb-hq-btn bb-hq-btn--primary">Filter</button>
    </div>
  </form>

  <% if (!rows.length) { %>
  <div class="bb-hq-empty" role="status">No members match this filter.</div>
  <% } else { %>
  <div class="bb-hq-table-wrap">
    <table class="bb-hq-table" data-bb-hq-member-table="1">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Branch</th>
          <th scope="col">Contact</th>
          <th scope="col">Membership</th>
          <th scope="col">Status</th>
          <th scope="col"><span class="bb-hq-sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (item) { %>
        <tr data-bb-member-status="<%= item.status %>">
          <td>
            <div class="bb-hq-person">
              <span class="bb-hq-avatar" aria-hidden="true"><%= initials(item) %></span>
              <span>
                <strong><%= item.firstName %> <%= item.lastName %></strong>
                <% if (item.preferredName) { %>
                <span class="bb-hq-muted"> (<%= item.preferredName %>)</span>
                <% } %>
              </span>
            </div>
          </td>
          <td>
            <% if (item.branchDisplayName || item.branchKey) { %>
            <span><%= item.branchDisplayName || item.branchKey %></span>
            <% if (item.branchKey) { %>
            <code class="bb-hq-key"><%= item.branchKey %></code>
            <% } %>
            <% } else { %>—<% } %>
          </td>
          <td>
            <div class="bb-hq-contact">
              <% if (item.phoneDisplay) { %><span><%= item.phoneDisplay %></span><% } %>
              <% if (item.emailDisplay) { %><span><%= item.emailDisplay %></span><% } %>
              <% if (!item.phoneDisplay && !item.emailDisplay) { %>—<% } %>
            </div>
          </td>
          <td><%= item.membershipStatus || '—' %></td>
          <td><span class="bb-hq-chip <%= statusChip(item.status) %>"><%= statusLabel(item.status) %></span></td>
          <td class="bb-hq-table__actions">
            <a class="bb-hq-btn bb-hq-btn--ghost bb-hq-btn--sm" href="/hq/members/<%= item.id %>">View</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <% if (totalPages > 1) { %>
  <nav class="bb-hq-pager" aria-label="Pagination">
    <% if (page > 1) { %>
    <a class="bb-hq-btn bb-hq-btn--ghost bb-hq-btn--sm" href="<%= pagerHref(page - 1) %>">Previous</a>
    <% } %>
    <span class="bb-hq-pager__meta">Page <%= page %> of <%= totalPages %> · <%= total %> total</span>
    <% if (page < totalPages) { %>
    <a class="bb-hq-btn bb-hq-btn--ghost bb-hq-btn--sm" href="<%= pagerHref(page + 1) %>">Next</a>
    <% } %>
  </nav>
  <% } %>
</section>

<%- include('../partials/hq-shell-end') %>
