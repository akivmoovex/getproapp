<%- include('../partials/hq-shell-start') %>
<%
  var o = overview || {};
  var checklist = o.checklist || [];
  var undo = o.undoLastPublish || {};
  function formatWhen(value) {
    if (!value) return '—';
    var d = value instanceof Date ? value : new Date(value);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleString(undefined, {
      year: 'numeric', month: 'short', day: 'numeric',
      hour: 'numeric', minute: '2-digit'
    });
  }
%>

<section
  class="bb-phase4-website"
  data-bb-hq-website="1"
  data-bb-phase4-foundation-website-overview="1"
  data-bb-stitch-screen="Phase4 - Foundation Website Overview"
  data-bb-viewport="responsive"
  aria-label="Church Website"
>
  <header class="bb-hq-page-head bb-hq-page-head--split">
    <div>
      <p class="bb-hq-breadcrumb">
        <a href="/hq">Dashboard</a>
        <span aria-hidden="true">›</span>
        <span>Website</span>
      </p>
      <h1 class="bb-hq-page-head__title"><%= o.title || 'Church Website' %></h1>
      <p class="bb-hq-lede"><%= o.subtitle || 'Edit and publish your church website' %></p>
    </div>
    <p class="bb-hq-page-head__actions bb-phase4-website__actions">
      <a class="bb-hq-btn bb-hq-btn--primary" href="<%= o.inlineEditPath || o.editPath || '/hq/content' %>" data-bb-edit-website="1">
        <span class="material-symbols-outlined" aria-hidden="true">edit</span>
        Edit website
      </a>
      <% if (o.websiteUx && o.websiteUx.actions && o.websiteUx.actions.viewLive) { %>
      <a class="bb-hq-btn bb-hq-btn--ghost" href="<%= o.websiteUx.actions.viewLive %>" rel="noopener" data-bb-website-action="view-live">View Live Website</a>
      <% } else { %>
      <a class="bb-hq-btn bb-hq-btn--ghost" href="<%= o.previewPath || '/hq/content/preview/home' %>" data-bb-website-action="preview">Preview Website</a>
      <% } %>
    </p>
  </header>

  <% if (typeof notice !== 'undefined' && notice) { %>
  <div class="bb-hq-alert bb-hq-alert--ok" role="status"><%= notice %></div>
  <% } %>

  <%- include('../partials/website-settings-status') %>

  <% if (typeof needsFoundationRepair !== 'undefined' && needsFoundationRepair) { %>
  <div class="bb-hq-panel" data-bb-hq-website-repair="1" id="website-setup-retry">
    <h2 class="bb-hq-panel__title">Repair website foundation</h2>
    <p>
      Required page shells or settings are missing. Repair inserts only missing structures
      and does not publish or overwrite existing content.
    </p>
    <form method="post" action="/hq/website/repair-foundation" class="bb-hq-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="audit_reason" value="hq_repair_website_foundation" />
      <div class="bb-hq-field">
        <label>
          <input type="checkbox" name="confirm_repair" value="1" required />
          I confirm repairing missing website foundation records only
        </label>
      </div>
      <button type="submit" class="bb-hq-btn bb-hq-btn--secondary">Retry</button>
    </form>
  </div>
  <% } %>

  <% if (o.unpublishedNotice) { %>
  <div class="bb-hq-alert" role="status" data-bb-website-unpublished="1">
    <strong>Website not published yet.</strong>
    <%= o.unpublishedNotice %>
    <% if (o.publicPath) { %>
    <span class="bb-hq-muted"> Public path after publish: <code><%= o.publicPath %></code></span>
    <% } %>
  </div>
  <% } %>

  <% if (o.isEmptyWebsite) { %>
  <div class="bb-phase4-website__empty bb-hq-card" data-bb-phase4-empty="new-website">
    <h2>Your church website is ready to set up.</h2>
    <p>Add your church details and homepage content, then publish when you are ready.</p>
    <a class="bb-hq-btn bb-hq-btn--primary" href="<%= o.editPath || '/hq/content' %>">Start Editing</a>
  </div>
  <% } %>

  <% if (o.hasUnpublishedChanges) { %>
  <div class="bb-phase4-website__draft-notice" role="status" data-bb-phase4-draft-notice="1">
    <div>
      <p class="bb-phase4-website__draft-notice-title">You have unpublished website changes.</p>
      <p class="bb-hq-muted">These will not be visible to visitors until you publish them.</p>
    </div>
    <p class="bb-phase4-website__draft-notice-actions">
        <a class="bb-hq-btn bb-hq-btn--ghost" href="<%= o.previewPath %>">Preview Changes</a>
        <% if (o.canEdit) { %>
        <a class="bb-hq-btn bb-hq-btn--ghost" href="<%= o.editPath %>">Continue Editing</a>
        <% } %>
        <% if (o.canPublish) { %>
      <a class="bb-hq-btn bb-hq-btn--primary" href="<%= o.publishReviewPath || '/hq/website/publish/review' %>">Publish Changes</a>
      <% } else if (o.showFixDetails) { %>
      <a class="bb-hq-btn bb-hq-btn--primary" href="<%= o.fixDetailsPath || o.publishReviewPath || '/hq/website/publish/review' %>" data-bb-fix-website-details="1">Fix Website Details</a>
      <% } %>
    </p>
  </div>
  <% } %>

  <div class="bb-phase4-website__grid">
    <article class="bb-hq-card bb-phase4-website__status" data-bb-phase4-website-status="1">
      <p class="bb-phase4-website__status-badge"><%= o.websiteStatusLabel || 'Not Published' %></p>
      <h2 class="bb-hq-section-title">Website status</h2>
      <% if (o.organizationKey) { %>
      <p class="bb-hq-muted">Organization key: <code><%= o.organizationKey %></code></p>
      <% } %>
      <% if (o.websiteUx && o.websiteUx.actions && o.websiteUx.actions.viewLive) { %>
      <p class="bb-phase4-website__url">
        <a href="<%= o.websiteUx.actions.viewLive %>" rel="noopener"><%= o.publicPath %></a>
      </p>
      <% } else if (o.publicPath) { %>
      <p class="bb-phase4-website__url bb-hq-muted">
        Public path (not live yet): <code><%= o.publicPath %></code>
      </p>
      <% } %>
      <dl class="bb-phase4-website__dl">
        <div><dt>Last published</dt><dd><%= formatWhen(o.lastPublishedAt) %></dd></div>
        <div><dt>Published by</dt><dd><%= o.lastPublishedByName || '—' %></dd></div>
        <div><dt>Theme</dt><dd><%= o.themeKey || 'default' %></dd></div>
      </dl>
      <div class="bb-phase4-website__preview-card" aria-hidden="true">
        <span class="material-symbols-outlined">language</span>
        <span>Website preview</span>
      </div>
      <p class="bb-phase4-website__status-actions">
        <% if (o.canEdit) { %>
        <a class="bb-hq-btn bb-hq-btn--ghost" href="<%= o.editPath %>">Edit Website</a>
        <% } %>
        <a class="bb-hq-btn bb-hq-btn--ghost" href="<%= o.previewPath %>">Preview Changes</a>
        <a class="bb-hq-btn bb-hq-btn--ghost" href="/hq/website/version-history" data-bb-website-action="history">Version history</a>
        <a class="bb-hq-btn bb-hq-btn--ghost" href="/hq/website/publishing-history" data-bb-website-action="publishing-history">Publishing history</a>
        <% if (o.canPublish) { %>
        <a class="bb-hq-btn bb-hq-btn--primary" href="<%= o.publishReviewPath || '/hq/website/publish/review' %>">Publish Changes</a>
        <% } else if (o.showFixDetails) { %>
        <a class="bb-hq-btn bb-hq-btn--primary" href="<%= o.fixDetailsPath || o.publishReviewPath || '/hq/website/publish/review' %>" data-bb-fix-website-details="1">Fix Website Details</a>
        <% } %>
      </p>
    </article>

    <aside class="bb-hq-card bb-phase4-website__checklist" data-bb-phase4-setup-checklist="1">
      <h2 class="bb-hq-section-title">Church setup</h2>
      <ul class="bb-phase4-website__checklist-list">
        <% checklist.forEach(function (item) { %>
        <li class="<%= item.complete ? 'is-complete' : 'is-open' %>">
          <span class="material-symbols-outlined" aria-hidden="true"><%= item.complete ? 'check_circle' : 'radio_button_unchecked' %></span>
          <span>
            <strong><%= item.label %></strong>
            <span class="bb-phase4-website__check-state"><%= item.state %></span>
          </span>
        </li>
        <% }) %>
      </ul>
    </aside>
  </div>

  <% if (undo.eligible) { %>
  <div class="bb-hq-card bb-phase4-website__undo" data-bb-phase4-undo="1">
    <div>
      <h2 class="bb-hq-section-title">Need to undo your latest publication?</h2>
      <p class="bb-hq-muted">You can restore your previous published website as a draft for review.</p>
    </div>
    <% if (undo.enabled && undo.href) { %>
    <a class="bb-hq-btn bb-hq-btn--ghost bb-phase4-website__undo-btn" href="<%= undo.href %>">Undo Last Publish</a>
    <% } else { %>
    <button type="button" class="bb-hq-btn bb-hq-btn--ghost" disabled title="<%= undo.explanation || 'Not available' %>">Undo Last Publish</button>
    <% } %>
  </div>
  <% } %>

  <p class="bb-phase4-website__sticky-edit">
    <a class="bb-hq-btn bb-hq-btn--primary" href="<%= o.editPath || '/hq/content' %>">Edit Website</a>
  </p>
</section>

<%- include('../partials/hq-shell-end') %>
