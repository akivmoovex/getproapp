<%- include('../partials/hq-shell-start') %>
<%
  var catalogue = roles || [];
  function roleIcon(r) {
    var cat = String((r && r.roleCategory) || '');
    if (cat === 'branch') return 'location_city';
    if (cat === 'ministry' || cat === 'department') return 'diversity_3';
    if (cat === 'pastoral') return 'volunteer_activism';
    if (cat === 'finance') return 'payments';
    return 'admin_panel_settings';
  }
%>
<section class="bb-hq-page bb-urp bb-urp-page" data-bb-staff-roles="1" data-bb-visual="stitch-urp" aria-label="Roles">
  <header class="bb-urp-head">
    <div>
      <h1 class="bb-urp-title">Roles</h1>
      <p class="bb-urp-lede">View and manage platform roles and their access levels.</p>
    </div>
  </header>

  <p class="bb-urp-muted" style="margin-top:-1.5rem;margin-bottom:1.5rem">
    Canonical BlessBoard roles are read-only. Permission mappings cannot be edited here.
  </p>

  <div class="bb-urp-panel bb-urp-role-table bb-urp-desktop-only">
    <% if (!catalogue.length) { %>
    <p class="bb-urp-empty">No roles in the catalogue.</p>
    <% } else { %>
    <div class="bb-urp-table-wrap">
      <table class="bb-urp-table">
        <thead>
          <tr>
            <th>Role</th>
            <th>Description</th>
            <th>Scope</th>
            <th>Users</th>
            <th>Permissions</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% catalogue.forEach(function (r) { %>
          <tr onclick="window.location='/hq/settings/roles/<%= encodeURIComponent(r.roleKey) %>'">
            <td>
              <div class="bb-urp-user">
                <div class="bb-urp-avatar" aria-hidden="true"><span class="material-symbols-outlined"><%= roleIcon(r) %></span></div>
                <strong><%= r.displayName %></strong>
              </div>
            </td>
            <td class="bb-urp-muted"><%= r.description || 'No description.' %></td>
            <td><%= r.scopeLabel || 'Global' %></td>
            <td><%= r.assignedCount || 0 %></td>
            <td><%= r.permissionCount || 0 %></td>
            <td>
              <a class="bb-urp-btn bb-urp-btn--ghost" href="/hq/settings/roles/<%= encodeURIComponent(r.roleKey) %>">View <span class="material-symbols-outlined">chevron_right</span></a>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <div class="bb-urp-role-cards bb-urp-mobile-only">
    <p class="bb-urp-lede">Manage system access and permissions</p>
    <% catalogue.forEach(function (r) { %>
    <article class="bb-urp-role-card">
      <p class="bb-urp-chip bb-urp-chip--pending"><%= r.scopeLabel === 'Branch' ? 'Local Scope' : 'Global Scope' %></p>
      <h3><%= r.displayName %></h3>
      <p class="bb-urp-muted"><%= r.description || 'No description.' %></p>
      <p class="bb-urp-muted">
        <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle">group</span>
        <%= r.assignedCount || 0 %> Users
        ·
        <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle">key</span>
        <%= r.permissionCount || 0 %> Permissions
      </p>
      <a class="bb-urp-btn bb-urp-btn--primary" href="/hq/settings/roles/<%= encodeURIComponent(r.roleKey) %>">View Permissions</a>
    </article>
    <% }); %>
  </div>
</section>
<%- include('../partials/hq-shell-end') %>
