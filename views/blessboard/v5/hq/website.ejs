<%- include('../partials/hq-shell-start') %>

<section class="bb-hq-settings" data-bb-hq-website="1" aria-label="Website publish">
  <header class="bb-hq-page-head">
    <p class="bb-hq-breadcrumb">
      <a href="/hq">HQ</a>
      <span aria-hidden="true">›</span>
      <span>Website</span>
    </p>
    <h1 class="bb-hq-page-head__title">Website preview &amp; publish</h1>
    <p class="bb-hq-lede">
      Preview draft pages privately, then publish when readiness checks pass.
      Optional content (leadership, sermons, events, giving) is not required.
    </p>
    <p class="bb-hq-page-head__actions">
      <a class="bb-hq-btn bb-hq-btn--ghost" href="/hq/website/workflow">
        Workflow dashboard
      </a>
      <a class="bb-hq-btn bb-hq-btn--ghost" href="/hq/website/change-submissions">
        Website change submissions
      </a>
      <a class="bb-hq-btn bb-hq-btn--ghost" href="/hq/website/version-history">
        Version history
      </a>
      <a class="bb-hq-btn bb-hq-btn--ghost" href="/hq/website/publishing-history">
        Publishing history
      </a>
      <a class="bb-hq-btn bb-hq-btn--ghost" href="/hq/website/audit-log">
        Audit log
      </a>
      <a class="bb-hq-btn bb-hq-btn--ghost" href="/hq/website/approval-settings">
        Approval settings
      </a>
    </p>
  </header>

  <% if (error) { %>
  <p class="bb-hq-error" role="alert"><%= error %></p>
  <% } %>
  <% if (notice === 'published') { %>
  <p class="bb-hq-ok" role="status">Website published.</p>
  <% } else if (notice === 'unpublished') { %>
  <p class="bb-hq-ok" role="status">Website unpublished. Content is preserved.</p>
  <% } else if (notice === 'preview_ack') { %>
  <p class="bb-hq-ok" role="status">Preview acknowledged.</p>
  <% } else if (notice === 'foundation_repaired') { %>
  <p class="bb-hq-ok" role="status">Website foundation repaired. Existing content was not overwritten.</p>
  <% } %>

  <% if (typeof needsFoundationRepair !== 'undefined' && needsFoundationRepair) { %>
  <div class="bb-hq-panel" data-bb-hq-website-repair="1">
    <h2 class="bb-hq-panel__title">Repair website foundation</h2>
    <p>
      Required page shells or settings are missing. Repair inserts only missing structures
      and does not publish or overwrite existing content.
    </p>
    <form method="post" action="/hq/website/repair-foundation" class="bb-hq-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="audit_reason" value="hq_repair_website_foundation" />
      <div class="bb-hq-field">
        <label>
          <input type="checkbox" name="confirm_repair" value="1" required />
          I confirm repairing missing website foundation records only
        </label>
      </div>
      <button type="submit" class="bb-hq-btn bb-hq-btn--secondary">Repair website foundation</button>
    </form>
  </div>
  <% } %>

  <div class="bb-hq-panel">
    <h2 class="bb-hq-panel__title">Status</h2>
    <p>Website status: <strong><%= readiness.websiteStatus || 'draft' %></strong></p>
    <% if (readiness.planKey) { %>
    <p>Plan: <strong><%= readiness.planKey %></strong></p>
    <% } %>
    <% if (publicPath) { %>
    <p>Public path: <code><%= publicPath %></code></p>
    <% } %>
    <p>
      <a class="bb-hq-btn bb-hq-btn--secondary" href="<%= previewPath %>">Preview</a>
      <% if (publicPath) { %>
      <a class="bb-hq-btn bb-hq-btn--secondary" href="<%= publicPath %>" rel="noopener">View live</a>
      <a class="bb-hq-btn bb-hq-btn--primary" href="<%= publicPath %>?website_edit=1" data-bb-edit-website="1">Edit website</a>
      <% } %>
    </p>
  </div>

  <div class="bb-hq-panel">
    <h2 class="bb-hq-panel__title">Publish readiness</h2>
    <% if (readiness.ready) { %>
    <p class="bb-hq-ok" role="status">Ready to publish.</p>
    <% } else { %>
    <ul>
      <% (readiness.gaps || []).forEach(function (gap) { %>
      <li><%= gapLabels[gap] || gap %></li>
      <% }) %>
    </ul>
    <% } %>
  </div>

  <div class="bb-hq-panel">
    <h2 class="bb-hq-panel__title">Actions</h2>

    <form method="post" action="/hq/website/preview-ack" class="bb-hq-form" style="margin-bottom:1.25rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="bb-hq-btn bb-hq-btn--secondary">Acknowledge preview</button>
    </form>

    <p class="bb-hq-form__actions" style="margin-bottom:1.25rem;">
      <a class="bb-hq-btn bb-hq-btn--primary" href="/hq/website/publish/review<%= deferServiceTimes ? '?defer_service_times=1' : '' %>">
        Review &amp; publish
      </a>
    </p>

    <form method="post" action="/hq/website/unpublish" class="bb-hq-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="bb-hq-btn bb-hq-btn--secondary">Unpublish website</button>
    </form>
  </div>

  <p class="bb-hq-lede">
    Per-page content editing remains under
    <a href="/hq/content">Content admin</a>.
    Contact details live in
    <a href="/hq/settings">Church settings</a>.
  </p>
</section>

<%- include('../partials/hq-shell-end') %>
