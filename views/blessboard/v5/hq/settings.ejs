<%- include('../partials/hq-shell-start') %>
  <h1>Church settings</h1>
  <p class="bb-hq-lede">Public contact and website status for this church. No content publishing here.</p>
  <% if (error) { %>
    <p class="bb-hq-error" role="alert"><%= error %></p>
  <% } %>
  <% if (saved) { %>
    <p class="bb-hq-ok" role="status">Settings saved.</p>
  <% } %>
  <form method="post" action="/hq/settings" class="bb-hq-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label for="publicName">Public name</label>
    <input id="publicName" name="publicName" type="text" required maxlength="200" value="<%= settings.publicName %>" />

    <label for="denomination">Denomination</label>
    <input id="denomination" name="denomination" type="text" maxlength="120" value="<%= settings.denomination || '' %>" />

    <label for="primaryEmail">Primary email</label>
    <input id="primaryEmail" name="primaryEmail" type="email" maxlength="254" value="<%= settings.primaryEmail || '' %>" />

    <label for="primaryPhone">Primary phone</label>
    <input id="primaryPhone" name="primaryPhone" type="tel" maxlength="32" value="<%= settings.primaryPhone || '' %>" placeholder="+260…" />

    <label for="defaultTimezone">Default timezone</label>
    <input id="defaultTimezone" name="defaultTimezone" type="text" maxlength="64" value="<%= settings.defaultTimezone || '' %>" placeholder="Africa/Lusaka" />

    <label for="defaultCountryCode">Default country</label>
    <input id="defaultCountryCode" name="defaultCountryCode" type="text" maxlength="2" value="<%= settings.defaultCountryCode || '' %>" placeholder="ZM" />

    <label for="websiteStatus">Website status</label>
    <select id="websiteStatus" name="websiteStatus">
      <option value="draft" <%= settings.websiteStatus === 'draft' ? 'selected' : '' %>>Draft</option>
      <option value="published" <%= settings.websiteStatus === 'published' ? 'selected' : '' %>>Published</option>
      <option value="suspended" <%= settings.websiteStatus === 'suspended' ? 'selected' : '' %>>Suspended</option>
    </select>

    <button type="submit">Save church settings</button>
  </form>
<%- include('../partials/hq-shell-end') %>
