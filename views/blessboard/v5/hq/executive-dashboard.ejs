<%- include('../partials/hq-shell-start') %>
<%
  var branchOptions = branches || [];
  var entitled = typeof executiveEntitled === 'boolean' ? executiveEntitled : false;
  var reportSafe = report || null;
  var members = (reportSafe && reportSafe.activeMembersByBranch) || [];
  var pendingRegs = (reportSafe && reportSafe.registrationsPendingByBranch) || [];
  var attByBranch = (reportSafe && reportSafe.attendance && reportSafe.attendance.byBranch) || [];
  var givByBranch = (reportSafe && reportSafe.giving && reportSafe.giving.byBranch) || [];
  var givCurrency = (reportSafe && reportSafe.giving && reportSafe.giving.byCurrency) || [];
  var memberTotal = 0;
  members.forEach(function (row) { memberTotal += Number(row.activeMemberCount) || 0; });
  var pendingTotal = 0;
  pendingRegs.forEach(function (row) { pendingTotal += Number(row.pendingCount) || 0; });
  var attTotal = reportSafe && reportSafe.attendance ? Number(reportSafe.attendance.totalCount) || 0 : 0;
  var attEvents = reportSafe && reportSafe.attendance ? Number(reportSafe.attendance.eventCount) || 0 : 0;
  var openRequests = reportSafe && reportSafe.openRequests ? Number(reportSafe.openRequests.openCount) || 0 : 0;
  var reqSubmitted = reportSafe && reportSafe.openRequests ? Number(reportSafe.openRequests.submittedCount) || 0 : 0;
  var reqInReview = reportSafe && reportSafe.openRequests ? Number(reportSafe.openRequests.inReviewCount) || 0 : 0;
  var annPublished = reportSafe && reportSafe.announcements ? Number(reportSafe.announcements.publishedCount) || 0 : 0;
  var annReaders = reportSafe && reportSafe.announcements ? Number(reportSafe.announcements.uniqueReaders) || 0 : 0;
  var annReads = reportSafe && reportSafe.announcements ? Number(reportSafe.announcements.readReceiptCount) || 0 : 0;
  var evtPublished = reportSafe && reportSafe.events ? Number(reportSafe.events.publishedEventCount) || 0 : 0;
  var evtRegs = reportSafe && reportSafe.events ? Number(reportSafe.events.registrationCount) || 0 : 0;
  var branchCount = typeof activeBranchCount === 'number' ? activeBranchCount : 0;
  var scopeLabel = branchFilter
    ? (branchDisplayName || branchFilter)
    : (churchDisplayName || 'All branches');
  var maxAttBranch = 0;
  attByBranch.forEach(function (row) {
    var n = Number(row.totalCount) || 0;
    if (n > maxAttBranch) maxAttBranch = n;
  });
  function pctBar(part, whole) {
    var n = Number(part) || 0;
    var d = Number(whole) || 0;
    if (d <= 0 || n <= 0) return 0;
    return Math.min(100, Math.round((n / d) * 1000) / 10);
  }
  function filterHref(opts) {
    var params = [];
    var m = opts && opts.month != null ? opts.month : yearMonth;
    var b = opts && Object.prototype.hasOwnProperty.call(opts, 'branch') ? opts.branch : branchFilter;
    if (m) params.push('month=' + encodeURIComponent(m));
    if (b) params.push('branch=' + encodeURIComponent(b));
    return '/hq/reports/executive' + (params.length ? '?' + params.join('&') : '');
  }
  var attHref = '/hq/reports/attendance?month=' + encodeURIComponent(yearMonth) +
    (branchFilter ? '&branch=' + encodeURIComponent(branchFilter) : '');
  var givHref = '/hq/reports/giving?month=' + encodeURIComponent(yearMonth) +
    (branchFilter ? '&branch=' + encodeURIComponent(branchFilter) : '');
  var hasMonthActivity = attTotal > 0 || givCurrency.length > 0 || openRequests > 0 ||
    annPublished > 0 || evtPublished > 0 || pendingTotal > 0 || memberTotal > 0;
%>

<section
  class="bb-hq-exec"
  data-bb-hq-executive="1"
  data-bb-batch="nw-ex-01"
  data-bb-stitch-executive="57-hq-consolidated-analytics"
  data-bb-stitch-desktop="2a577dc15d4342acb152f16aed21c267"
  data-bb-stitch-mobile="06489c79d0d04a429e57eba5c717ba47"
  data-bb-exec-entitlement="<%= entitled ? 'network' : 'denied' %>"
  data-bb-exec-scope="<%= branchFilter ? 'branch' : 'church' %>"
  aria-label="Executive dashboard"
>
  <header class="bb-hq-page-head bb-hq-page-head--split">
    <div>
      <p class="bb-hq-breadcrumb">
        <a href="/hq/reports">Reports</a>
        <span aria-hidden="true">›</span>
        <span>Executive</span>
      </p>
      <div class="bb-hq-exec__title-row">
        <h1 class="bb-hq-page-head__title">Executive dashboard</h1>
        <% if (entitled) { %>
        <span class="bb-hq-exec__month" data-bb-exec-month="<%= yearMonth %>"><%= yearMonth %></span>
        <% } %>
      </div>
      <p class="bb-hq-lede">
        <% if (!entitled) { %>
        Network package required. Growth and Foundation keep the HQ reports hub and
        Growth attendance/giving detail pages — this executive summary is Network-only.
        <% } else { %>
        Live aggregates for <strong><%= scopeLabel %></strong>.
        Month uses calendar dates on stored attendance and giving records (UTC month default).
        No trend percentages, forecasts, compliance scores, or donor-level figures.
        <% } %>
      </p>
    </div>
    <p class="bb-hq-page-head__actions">
      <a class="bb-hq-btn bb-hq-btn--ghost" href="/hq/reports" data-bb-exec-action="reports">
        <span class="material-symbols-outlined" aria-hidden="true">analytics</span>
        All reports
      </a>
    </p>
  </header>

  <% if (!entitled) { %>
  <div class="bb-hq-exec-denied" data-bb-exec-denied="1">
    <%- include('../partials/empty-state', {
      title: 'Network package required',
      body: 'The executive dashboard summarizes approved church-wide metrics for Network. Assign the Network plan (or an executive_reports entitlement) to unlock this page. Growth still has attendance and giving reports.',
      icon: 'lock'
    }) %>
    <ul class="bb-hq-exec-unavailable" data-bb-exec-unavailable="denied" aria-label="Unavailable on this package">
      <li>Active branch and membership executive cards</li>
      <li>Monthly attendance and giving branch comparison</li>
      <li>Request volume and announcement read receipts</li>
    </ul>
    <p class="bb-hq-hint">
      <a href="/hq/reports">Open HQ reports hub</a>
      ·
      <a href="/hq/reports/attendance">Attendance report</a>
      ·
      <a href="/hq/reports/giving">Giving report</a>
    </p>
  </div>
  <% } else { %>

  <form method="get" action="/hq/reports/executive" class="bb-hq-filter" data-bb-exec-filter="1" role="search">
    <div class="bb-hq-field">
      <label for="exec-month">Month</label>
      <input id="exec-month" type="month" name="month" value="<%= yearMonth %>" />
    </div>
    <div class="bb-hq-field">
      <label for="exec-branch">Branch</label>
      <select id="exec-branch" name="branch">
        <option value="">All branches</option>
        <% branchOptions.forEach(function (b) { %>
        <option value="<%= b.key %>" <%= branchFilter === b.key ? 'selected' : '' %>><%= b.displayName %></option>
        <% }) %>
      </select>
    </div>
    <div class="bb-hq-filter__actions">
      <button type="submit" class="bb-hq-btn bb-hq-btn--primary">
        <span class="material-symbols-outlined" aria-hidden="true">filter_list</span>
        Show
      </button>
      <% if (branchFilter) { %>
      <a class="bb-hq-btn bb-hq-btn--ghost" href="<%= filterHref({ branch: '' }) %>">Clear branch</a>
      <% } %>
    </div>
  </form>

  <p class="bb-hq-hint" data-bb-exec-scope-label="1">
    Scope: <%= scopeLabel %> · Month <%= yearMonth %> (calendar date on stored records)
  </p>

  <section class="bb-hq-reports-summary" data-bb-exec-summary="1" aria-label="Executive snapshot">
    <div class="bb-hq-reports-summary__card" data-bb-exec-stat="branches">
      <p class="bb-hq-reports-summary__label">Active branches</p>
      <p class="bb-hq-reports-summary__value"><%= branchCount %></p>
    </div>
    <div class="bb-hq-reports-summary__card" data-bb-exec-stat="members">
      <p class="bb-hq-reports-summary__label">Active members</p>
      <p class="bb-hq-reports-summary__value"><%= memberTotal %></p>
    </div>
    <div class="bb-hq-reports-summary__card" data-bb-exec-stat="pending">
      <p class="bb-hq-reports-summary__label">Pending registrations</p>
      <p class="bb-hq-reports-summary__value"><%= pendingTotal %></p>
    </div>
    <div class="bb-hq-reports-summary__card" data-bb-exec-stat="attendance">
      <p class="bb-hq-reports-summary__label">Attendance headcount</p>
      <p class="bb-hq-reports-summary__value"><%= attTotal %></p>
    </div>
    <div class="bb-hq-reports-summary__card" data-bb-exec-stat="requests">
      <p class="bb-hq-reports-summary__label">Open requests</p>
      <p class="bb-hq-reports-summary__value"><%= openRequests %></p>
    </div>
  </section>

  <% if (!hasMonthActivity && branchCount === 0) { %>
  <div class="bb-hq-exec-empty" data-bb-exec-empty="insufficient">
    <%- include('../partials/empty-state', {
      title: 'Insufficient data',
      body: 'No active branches or operational totals are available for this church yet.',
      icon: 'insights'
    }) %>
  </div>
  <% } %>

  <section class="bb-hq-panel" data-bb-exec-panel="members">
    <h2 class="bb-hq-section-title">Active members by branch</h2>
    <% if (!members.length) { %>
    <p class="bb-hq-empty" role="status" data-bb-exec-empty="members">No active member counts for this scope.</p>
    <% } else { %>
    <div class="bb-hq-table-wrap bb-hq-exec-table-wrap--desktop">
      <table class="bb-hq-table" data-bb-exec-table="members">
        <thead>
          <tr>
            <th scope="col">Branch</th>
            <th scope="col">Active members</th>
          </tr>
        </thead>
        <tbody>
          <% members.forEach(function (row) { %>
          <tr data-bb-branch="<%= row.branchKey %>">
            <td><%= row.displayName %> <code class="bb-hq-key"><%= row.branchKey %></code></td>
            <td data-bb-count="<%= row.activeMemberCount %>"><%= row.activeMemberCount %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <ul class="bb-hq-exec-cards" data-bb-exec-cards="members" aria-label="Active members by branch">
      <% members.forEach(function (row) { %>
      <li class="bb-hq-exec-card" data-bb-branch="<%= row.branchKey %>">
        <p class="bb-hq-exec-card__title"><%= row.displayName %></p>
        <p class="bb-hq-exec-card__value"><%= row.activeMemberCount %></p>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </section>

  <section class="bb-hq-panel" data-bb-exec-panel="registrations">
    <h2 class="bb-hq-section-title">Pending registrations by branch</h2>
    <% if (!pendingRegs.length || pendingTotal === 0) { %>
    <p class="bb-hq-empty" role="status" data-bb-exec-empty="registrations">No pending registrations.</p>
    <% } else { %>
    <ul class="bb-hq-report-list" data-bb-exec-list="registrations">
      <% pendingRegs.forEach(function (row) { %>
      <% if (Number(row.pendingCount) > 0) { %>
      <li data-bb-branch="<%= row.branchKey %>" data-bb-count="<%= row.pendingCount %>">
        <%= row.displayName %>: <%= row.pendingCount %>
      </li>
      <% } %>
      <% }) %>
    </ul>
    <% } %>
  </section>

  <section class="bb-hq-panel" data-bb-exec-panel="attendance">
    <h2 class="bb-hq-section-title">Attendance · <%= yearMonth %></h2>
    <% if (!attTotal && !attByBranch.length) { %>
    <p class="bb-hq-empty" role="status" data-bb-exec-empty="attendance">No submitted attendance for this month.</p>
    <% } else { %>
    <p data-bb-exec="attendance-total">Total headcount: <%= attTotal %></p>
    <p data-bb-exec="attendance-events">Events counted: <%= attEvents %></p>
    <% if (attByBranch.length && !branchFilter) { %>
    <h3 class="bb-hq-subsection-title">Branch comparison</h3>
    <div class="bb-hq-table-wrap bb-hq-exec-table-wrap--desktop">
      <table class="bb-hq-table" data-bb-exec-table="attendance-by-branch">
        <thead>
          <tr>
            <th scope="col">Branch</th>
            <th scope="col">Headcount</th>
            <th scope="col">Share of max</th>
          </tr>
        </thead>
        <tbody>
          <% attByBranch.forEach(function (row) { %>
          <% var bar = pctBar(row.totalCount, maxAttBranch); %>
          <tr data-bb-branch="<%= row.branchKey %>">
            <td><%= row.displayName %></td>
            <td><%= row.totalCount %></td>
            <td>
              <span
                class="bb-hq-att-bar"
                role="img"
                aria-label="<%= bar %>% of highest branch headcount"
                data-bb-exec-bar-pct="<%= bar %>"
              >
                <span class="bb-hq-att-bar__track" aria-hidden="true">
                  <span class="bb-hq-att-bar__fill bb-hq-att-bar__fill--branch" style="width: <%= bar %>%;"></span>
                </span>
                <span class="bb-hq-att-bar__label"><%= bar %>%</span>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <ul class="bb-hq-exec-cards" data-bb-exec-cards="attendance" aria-label="Attendance by branch">
      <% attByBranch.forEach(function (row) { %>
      <li class="bb-hq-exec-card" data-bb-branch="<%= row.branchKey %>">
        <p class="bb-hq-exec-card__title"><%= row.displayName %></p>
        <p class="bb-hq-exec-card__value"><%= row.totalCount %></p>
        <p class="bb-hq-exec-card__meta"><%= row.eventCount %> events</p>
      </li>
      <% }) %>
    </ul>
    <% } %>
    <p class="bb-hq-hint"><a href="<%= attHref %>" data-bb-exec-link="attendance-detail">Category detail (Growth report)</a></p>
    <% } %>
  </section>

  <section class="bb-hq-panel" data-bb-exec-panel="giving">
    <h2 class="bb-hq-section-title">Giving · <%= yearMonth %></h2>
    <% if (!givCurrency.length) { %>
    <p class="bb-hq-empty" role="status" data-bb-exec-empty="giving">No submitted giving for this month.</p>
    <% } else { %>
    <div class="bb-hq-table-wrap bb-hq-exec-table-wrap--desktop">
      <table class="bb-hq-table" data-bb-exec-table="giving-currency">
        <thead>
          <tr>
            <th scope="col">Currency</th>
            <th scope="col">Total</th>
            <th scope="col">Entries</th>
          </tr>
        </thead>
        <tbody>
          <% givCurrency.forEach(function (row) { %>
          <tr data-bb-currency="<%= row.currency %>">
            <td><%= row.currency %></td>
            <td data-bb-amount="<%= row.totalAmount %>"><%= row.totalAmount %></td>
            <td><%= row.entryCount %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <ul class="bb-hq-exec-cards" data-bb-exec-cards="giving-currency" aria-label="Giving by currency">
      <% givCurrency.forEach(function (row) { %>
      <li class="bb-hq-exec-card" data-bb-currency="<%= row.currency %>">
        <p class="bb-hq-exec-card__title"><%= row.currency %></p>
        <p class="bb-hq-exec-card__value"><%= row.totalAmount %></p>
        <p class="bb-hq-exec-card__meta"><%= row.entryCount %> entries</p>
      </li>
      <% }) %>
    </ul>
    <% if (givByBranch.length && !branchFilter) { %>
    <h3 class="bb-hq-subsection-title">By branch and currency</h3>
    <div class="bb-hq-table-wrap bb-hq-exec-table-wrap--desktop">
      <table class="bb-hq-table" data-bb-exec-table="giving-by-branch">
        <thead>
          <tr>
            <th scope="col">Branch</th>
            <th scope="col">Currency</th>
            <th scope="col">Total</th>
            <th scope="col">Entries</th>
          </tr>
        </thead>
        <tbody>
          <% givByBranch.forEach(function (row) { %>
          <tr data-bb-branch="<%= row.branchKey %>" data-bb-currency="<%= row.currency %>">
            <td><%= row.displayName %></td>
            <td><%= row.currency %></td>
            <td data-bb-amount="<%= row.totalAmount %>"><%= row.totalAmount %></td>
            <td><%= row.entryCount %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
    <p class="bb-hq-hint"><a href="<%= givHref %>" data-bb-exec-link="giving-detail">Category detail (Growth report)</a></p>
    <% } %>
  </section>

  <section class="bb-hq-panel" data-bb-exec-panel="requests">
    <h2 class="bb-hq-section-title">Request volume</h2>
    <dl class="bb-hq-exec-dl" data-bb-exec-dl="requests">
      <div><dt>Open</dt><dd data-bb-exec="requests-open"><%= openRequests %></dd></div>
      <div><dt>Submitted</dt><dd data-bb-exec="requests-submitted"><%= reqSubmitted %></dd></div>
      <div><dt>In review</dt><dd data-bb-exec="requests-in-review"><%= reqInReview %></dd></div>
    </dl>
  </section>

  <section class="bb-hq-panel" data-bb-exec-panel="announcements">
    <h2 class="bb-hq-section-title">Announcements (read receipts)</h2>
    <p class="bb-hq-hint">Unique readers and read receipts are not marketing “reach.”</p>
    <dl class="bb-hq-exec-dl" data-bb-exec-dl="announcements">
      <div><dt>Published</dt><dd data-bb-exec="ann-published"><%= annPublished %></dd></div>
      <div><dt>Unique readers</dt><dd data-bb-exec="ann-readers"><%= annReaders %></dd></div>
      <div><dt>Read receipts</dt><dd data-bb-exec="ann-reads"><%= annReads %></dd></div>
    </dl>
  </section>

  <section class="bb-hq-panel" data-bb-exec-panel="events">
    <h2 class="bb-hq-section-title">Events</h2>
    <dl class="bb-hq-exec-dl" data-bb-exec-dl="events">
      <div><dt>Published events</dt><dd data-bb-exec="events-published"><%= evtPublished %></dd></div>
      <div><dt>Registrations</dt><dd data-bb-exec="event-registrations"><%= evtRegs %></dd></div>
    </dl>
  </section>

  <section class="bb-hq-panel" data-bb-exec-panel="unavailable" aria-labelledby="bb-hq-exec-unavail-heading">
    <h2 id="bb-hq-exec-unavail-heading" class="bb-hq-section-title">Unavailable analytics</h2>
    <ul class="bb-hq-exec-unavailable" data-bb-exec-unavailable="product">
      <li>Trend percentages, forecasts, and growth predictions</li>
      <li>Reporting compliance / monthly report submission status</li>
      <li>Health, engagement, and fabricated benchmarks</li>
      <li>Donor-level giving and individual attendance</li>
      <li>Forms and submissions rollup</li>
      <li>Daily / weekly period toggles</li>
    </ul>
  </section>

  <% } %>
</section>

<%- include('../partials/hq-shell-end') %>
