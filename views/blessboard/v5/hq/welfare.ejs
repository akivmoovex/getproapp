<%- include('../partials/hq-shell-start') %>
<section class="bb-hq-page" data-bb-welfare="1">
  <header class="bb-hq-page-head">
    <p class="bb-hq-breadcrumb">
      <a href="/hq">Dashboard</a>
      <span aria-hidden="true">›</span>
      <span>Welfare</span>
    </p>
    <h1 class="bb-hq-page-head__title">Welfare</h1>
    <p class="bb-hq-page-head__lede">Assistance requests with separation of duties. Pastoral narrative is not shared with Finance.</p>
  </header>

  <% if (typeof notice !== 'undefined' && notice) { %>
    <p class="bb-hq-banner bb-hq-banner--ok" role="status"><%= notice %></p>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <p class="bb-hq-banner bb-hq-banner--error" role="alert"><%= error %></p>
  <% } %>

  <nav class="bb-hq-card" aria-label="Welfare links">
    <h2 class="bb-hq-section-title">Quick links</h2>
    <p class="bb-hq-lede"><a href="/hq/welfare/requests">Welfare requests</a></p>
  </nav>
</section>
<%- include('../partials/hq-shell-end') %>
