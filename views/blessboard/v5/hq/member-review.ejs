<%- include('../partials/hq-shell-start') %>
<section class="bb-hq-panel" data-bb-hq-member-review="1">
  <h1 class="bb-hq-page-head__title">Review new member</h1>
  <p>Confirm the church membership record. Portal activation remains pending after creation.</p>
  <% if (review && review.fieldErrors && review.fieldErrors.length) { %>
  <%- include('../partials/form-errors', { title: 'Unable to create member', errors: review.fieldErrors }) %>
  <% } %>
  <dl data-bb-member-fields="full_name,phone,email,address_line_1,marital_status,next_of_kin_name,next_of_kin_relationship,next_of_kin_phone,branch_id">
    <dt>Full name</dt><dd><%= (review && review.values && review.values.fullName) || 'New member' %></dd>
    <dt>Phone</dt><dd><%= (review && review.values && review.values.phone) || '—' %></dd>
    <dt>Email</dt><dd><%= (review && review.values && review.values.email) || 'Not provided' %></dd>
    <dt>Residential address</dt><dd><%= (review && review.values && review.values.addressLine1) || '—' %></dd>
    <dt>Marital status</dt><dd><%= (review && review.values && review.values.maritalStatus) || '—' %></dd>
    <dt>Emergency contact</dt><dd><%= (review && review.values && review.values.nextOfKinName) || '—' %></dd>
    <dt>Emergency relationship</dt><dd><%= (review && review.values && review.values.nextOfKinRelationship) || '—' %></dd>
    <dt>Emergency phone</dt><dd><%= (review && review.values && review.values.nextOfKinPhone) || '—' %></dd>
    <dt>Authorized branch</dt><dd><%= (review && review.values && (review.values.branchName || review.values.branchId)) || 'Authorized branch' %></dd>
    <dt>Portal access</dt><dd>not_activated</dd>
  </dl>
  <form method="post" action="/hq/members/new/review">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />
    <input type="hidden" name="draft_token" value="<%= draftToken %>" />
    <button class="bb-hq-btn bb-hq-btn--primary" name="action" value="confirm_create">Create member</button>
  </form>
</section>
<%- include('../partials/hq-shell-end') %>
