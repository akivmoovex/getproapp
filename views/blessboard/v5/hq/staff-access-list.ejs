<%- include('../partials/hq-shell-start') %>
<%
  var rows = users || [];
  var branchOptions = branches || [];
  var roleOptions = roles || [];
  var f = filters || {};
  var s = stats || { totalUsers: rows.length, churchAdmins: 0, branchAdmins: 0, pendingInvitations: 0 };
  var totalCount = typeof total === 'number' ? total : rows.length;
  var pageLimit = typeof limit === 'number' ? limit : 50;
  var pageOffset = typeof offset === 'number' ? offset : 0;
  var fromN = totalCount ? pageOffset + 1 : 0;
  var toN = Math.min(pageOffset + rows.length, totalCount);
  var prevOffset = Math.max(pageOffset - pageLimit, 0);
  var nextOffset = pageOffset + pageLimit;
  function keepQs(extra) {
    var q = [];
    if (f.q) q.push('q=' + encodeURIComponent(f.q));
    if (f.role) q.push('role=' + encodeURIComponent(f.role));
    if (f.branch) q.push('branch=' + encodeURIComponent(f.branch));
    if (f.status) q.push('status=' + encodeURIComponent(f.status));
    extra = extra || {};
    Object.keys(extra).forEach(function (k) { q.push(k + '=' + encodeURIComponent(extra[k])); });
    return q.length ? ('?' + q.join('&')) : '';
  }
%>
<section class="bb-hq-page bb-urp bb-urp-page" data-bb-staff-access="1" data-bb-visual="stitch-urp" data-bb-stitch-project="5480028321322186480" aria-label="Users">
  <header class="bb-urp-head">
    <div>
      <h1 class="bb-urp-title">Users</h1>
      <p class="bb-urp-lede">Manage platform access, roles, and branch assignments.</p>
    </div>
    <a class="bb-urp-btn bb-urp-btn--primary bb-urp-desktop-only" href="/hq/settings/staff-access/invite?placement=hq" data-bb-hq-add-hq-member="1">
      <span class="material-symbols-outlined" aria-hidden="true">person_add</span>
      Invite User
    </a>
  </header>

  <% if (notice) { %>
  <p class="bb-urp-banner bb-urp-banner--ok" role="status"><%= notice %></p>
  <% } %>
  <% if (error) { %>
  <p class="bb-urp-banner bb-urp-banner--error" role="alert"><%= error %></p>
  <% } %>

  <div class="bb-urp-mobile-stats">
    <article class="bb-urp-stat">
      <p class="bb-urp-stat__value"><%= s.totalUsers %></p>
      <p class="bb-urp-stat__label">Total Users</p>
    </article>
    <article class="bb-urp-stat">
      <p class="bb-urp-stat__value"><%= s.churchAdmins %></p>
      <p class="bb-urp-stat__label">Admins</p>
    </article>
  </div>

  <div class="bb-urp-stats" aria-label="User summary">
    <article class="bb-urp-stat">
      <div class="bb-urp-stat__icon bb-urp-stat__icon--teal"><span class="material-symbols-outlined">group</span></div>
      <h2 class="bb-urp-stat__value"><%= s.totalUsers %></h2>
      <p class="bb-urp-stat__label">Total Users</p>
    </article>
    <article class="bb-urp-stat">
      <div class="bb-urp-stat__icon bb-urp-stat__icon--navy"><span class="material-symbols-outlined">shield_person</span></div>
      <h2 class="bb-urp-stat__value"><%= s.churchAdmins %></h2>
      <p class="bb-urp-stat__label">Church Admins</p>
    </article>
    <article class="bb-urp-stat">
      <div class="bb-urp-stat__icon bb-urp-stat__icon--sage"><span class="material-symbols-outlined">location_away</span></div>
      <h2 class="bb-urp-stat__value"><%= s.branchAdmins %></h2>
      <p class="bb-urp-stat__label">Branch Admins</p>
    </article>
    <article class="bb-urp-stat">
      <div class="bb-urp-stat__icon bb-urp-stat__icon--error"><span class="material-symbols-outlined">hourglass_empty</span></div>
      <h2 class="bb-urp-stat__value"><%= s.pendingInvitations %></h2>
      <p class="bb-urp-stat__label">Pending Invitations</p>
    </article>
  </div>

  <form method="get" action="/hq/settings/staff-access" class="bb-urp-panel" aria-label="Filter users">
    <div class="bb-urp-toolbar">
      <div class="bb-urp-search">
        <span class="material-symbols-outlined" aria-hidden="true">search</span>
        <input id="staff-q" name="q" type="search" value="<%= f.q || '' %>" maxlength="200" autocomplete="off" placeholder="Search users by name or email..." />
      </div>
      <div class="bb-urp-filters">
        <label class="bb-hq-sr-only" for="staff-role">Role</label>
        <select id="staff-role" name="role">
          <option value="">Role</option>
          <% roleOptions.forEach(function (r) { %>
          <option value="<%= r.roleKey %>" <%= f.role === r.roleKey ? 'selected' : '' %>><%= r.displayName %></option>
          <% }); %>
          <option value="church_hq_admin" <%= f.role === 'church_hq_admin' ? 'selected' : '' %>>Church HQ Admin</option>
          <option value="branch_admin" <%= f.role === 'branch_admin' ? 'selected' : '' %>>Branch Admin</option>
        </select>
        <label class="bb-hq-sr-only" for="staff-branch">Branch</label>
        <select id="staff-branch" name="branch">
          <option value="">Branch</option>
          <% branchOptions.forEach(function (b) { %>
          <option value="<%= b.id %>" <%= f.branch === String(b.id) ? 'selected' : '' %>><%= b.displayName || b.display_name %></option>
          <% }); %>
        </select>
        <label class="bb-hq-sr-only" for="staff-status">Status</label>
        <select id="staff-status" name="status">
          <option value="">Status</option>
          <option value="active" <%= f.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="pending" <%= f.status === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="inactive" <%= f.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
        <button type="submit" class="bb-urp-btn" aria-label="Apply filters">
          <span class="material-symbols-outlined">tune</span>
        </button>
      </div>
    </div>

    <div class="bb-urp-table-wrap">
      <% if (!rows.length) { %>
      <div class="bb-urp-empty">No matching users in this church.</div>
      <% } else { %>
      <table class="bb-urp-table">
        <thead>
          <tr>
            <th>User</th>
            <th>Contact</th>
            <th>Role</th>
            <th>Scope</th>
            <th>Status</th>
            <th class="bb-urp-num">Last Active</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function (u) { %>
          <tr onclick="window.location='/hq/settings/staff-access/<%= u.id %>'">
            <td>
              <div class="bb-urp-user">
                <div class="bb-urp-avatar" aria-hidden="true"><%= u.initials || '?' %></div>
                <div>
                  <strong><%= u.displayName %></strong>
                  <span class="bb-urp-muted bb-urp-mobile-only"><%= u.emailDisplay || '' %></span>
                </div>
              </div>
            </td>
            <td>
              <p class="bb-urp-muted" style="margin:0"><%= u.emailDisplay || '—' %></p>
              <p class="bb-urp-muted" style="margin:0;opacity:0.7"><%= u.phoneMasked || u.phoneDisplay || '' %></p>
            </td>
            <td><%= u.roleSummary %><% if (u.roleExtraCount) { %> +<%= u.roleExtraCount %><% } %></td>
            <td>
              <span class="bb-urp-scope">
                <span class="material-symbols-outlined"><%= (u.scopeSummary && u.scopeSummary.icon) || 'account_balance' %></span>
                <%= (u.scopeSummary && u.scopeSummary.label) || '—' %>
              </span>
            </td>
            <td>
              <span class="bb-urp-chip bb-urp-chip--<%= u.statusChip || 'pending' %>">
                <span class="bb-urp-chip__dot" aria-hidden="true"></span>
                <%= u.statusLabel || u.status %>
              </span>
            </td>
            <td style="text-align:right"><span class="bb-urp-muted"><%= u.lastActiveLabel || '—' %></span></td>
            <td class="bb-urp-rel" onclick="event.stopPropagation()">
              <button type="button" class="bb-urp-more" data-bb-urp-menu="1" aria-label="More actions">
                <span class="material-symbols-outlined">more_vert</span>
              </button>
              <div class="bb-urp-menu">
                <a href="/hq/settings/staff-access/<%= u.id %>">View access</a>
                <a href="/hq/settings/staff-access/<%= u.id %>#assign">Assign role</a>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>

    <div class="bb-urp-cards bb-urp-mobile-only">
      <% if (!rows.length) { %>
      <p class="bb-urp-empty">No matching users in this church.</p>
      <% } else { rows.forEach(function (u) { %>
      <a class="bb-urp-card-row" href="/hq/settings/staff-access/<%= u.id %>">
        <div class="bb-urp-user">
          <div class="bb-urp-avatar" aria-hidden="true"><%= u.initials || '?' %></div>
          <div>
            <strong><%= u.displayName %></strong>
            <div class="bb-urp-muted"><%= u.roleSummary %> · <%= (u.scopeSummary && u.scopeSummary.label) || '—' %></div>
          </div>
        </div>
        <span class="bb-urp-chip bb-urp-chip--<%= u.statusChip || 'pending' %>"><%= u.statusLabel || u.status %></span>
      </a>
      <% }); } %>
    </div>

    <% if (totalCount) { %>
    <div class="bb-urp-pager">
      <span>Showing <%= fromN %> to <%= toN %> of <%= totalCount %> results</span>
      <span>
        <% if (pageOffset > 0) { %>
        <a href="/hq/settings/staff-access<%= keepQs({ offset: prevOffset, limit: pageLimit }) %>" aria-label="Previous"><span class="material-symbols-outlined">chevron_left</span></a>
        <% } else { %>
        <span aria-hidden="true"><span class="material-symbols-outlined">chevron_left</span></span>
        <% } %>
        <% if (nextOffset < totalCount) { %>
        <a href="/hq/settings/staff-access<%= keepQs({ offset: nextOffset, limit: pageLimit }) %>" aria-label="Next"><span class="material-symbols-outlined">chevron_right</span></a>
        <% } else { %>
        <span aria-hidden="true"><span class="material-symbols-outlined">chevron_right</span></span>
        <% } %>
      </span>
    </div>
    <% } %>
  </form>

  <p class="bb-urp-muted" style="margin-top:1.5rem">
    <a href="/hq/settings/roles">Roles</a>
    · <a href="/hq/settings/staff-access/invite?placement=branch" data-bb-hq-add-branch-member="1">Invite branch user</a>
    · <a href="/hq/settings/access-audit">Access audit</a>
    · <a href="/hq/roles">Legacy permissions</a>
  </p>

  <a class="bb-urp-fab bb-urp-mobile-only" href="/hq/settings/staff-access/invite?placement=hq" aria-label="Invite User">
    <span class="material-symbols-outlined">person_add</span>
  </a>
</section>
<%- include('../partials/hq-shell-end') %>
