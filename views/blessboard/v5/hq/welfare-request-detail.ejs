<%- include('../partials/hq-shell-start') %>
<%
  var r = typeof welfareRequest !== 'undefined' && welfareRequest ? welfareRequest : null;
  var approvalRows = typeof approvals !== 'undefined' && approvals ? approvals : [];
  var distRows = typeof distributions !== 'undefined' && distributions ? distributions : [];
%>
<section class="bb-hq-page" data-bb-welfare-request-detail="1">
  <header class="bb-hq-page-head">
    <p class="bb-hq-breadcrumb">
      <a href="/hq">Dashboard</a>
      <span aria-hidden="true">›</span>
      <a href="/hq/welfare">Welfare</a>
      <span aria-hidden="true">›</span>
      <a href="/hq/welfare/requests">Requests</a>
      <span aria-hidden="true">›</span>
      <span>Detail</span>
    </p>
    <h1 class="bb-hq-page-head__title">Welfare request</h1>
  </header>

  <% if (typeof notice !== 'undefined' && notice) { %>
    <p class="bb-hq-banner bb-hq-banner--ok" role="status"><%= notice %></p>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <p class="bb-hq-banner bb-hq-banner--error" role="alert"><%= error %></p>
  <% } %>

  <% if (r) { %>
  <section class="bb-hq-card">
    <h2 class="bb-hq-section-title">Request</h2>
    <ul class="bb-hq-list">
      <li>Status: <strong><%= r.status %></strong></li>
      <li>Type: <%= r.assistanceType %></li>
      <li>Amount requested: <%= r.amountRequested %> <%= r.currencyCode || '' %></li>
      <li>Operational summary: <%= r.operationalSummary || '—' %></li>
    </ul>
  </section>

  <section class="bb-hq-card">
    <h2 class="bb-hq-section-title">Approval history (immutable)</h2>
    <% if (!approvalRows.length) { %>
      <p class="bb-hq-lede">No decisions yet.</p>
    <% } else { %>
      <ul class="bb-hq-list">
        <% approvalRows.forEach(function (a) { %>
          <li>
            <%= a.decision %> — amount <%= a.amountApproved %>
            <% if (a.financeInstructionSummary) { %>
              · Finance instruction: <%= a.financeInstructionSummary %>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="bb-hq-card">
    <h2 class="bb-hq-section-title">Decide (approver ≠ requester)</h2>
    <form method="post" action="/hq/welfare/requests/<%= r.id %>/decide" class="bb-hq-form">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <label>Decision
        <select name="decision">
          <option value="approved">Approve</option>
          <option value="rejected">Reject</option>
        </select>
      </label>
      <label>Reason <input name="decisionReason" maxlength="500"/></label>
      <label>Amount approved <input name="amountApproved" type="number" step="0.01" min="0"/></label>
      <label>Finance instruction (payment only)
        <input name="financeInstructionSummary" maxlength="500"/>
      </label>
      <button type="submit">Record decision</button>
    </form>
  </section>

  <section class="bb-hq-card">
    <h2 class="bb-hq-section-title">Distributions</h2>
    <% if (!distRows.length) { %>
      <p class="bb-hq-lede">None recorded.</p>
    <% } else { %>
      <ul class="bb-hq-list">
        <% distRows.forEach(function (d) { %>
          <li><%= d.amountDistributed %> <%= d.currencyCode %> via <%= d.distributionMethod %></li>
        <% }) %>
      </ul>
    <% } %>
    <form method="post" action="/hq/welfare/requests/<%= r.id %>/distribute" class="bb-hq-form">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <label>Amount <input name="amountDistributed" type="number" step="0.01" min="0.01" required/></label>
      <label>Currency <input name="currencyCode" maxlength="3" required/></label>
      <label>Method
        <select name="distributionMethod">
          <option value="cash">Cash</option>
          <option value="transfer">Transfer</option>
          <option value="voucher">Voucher</option>
          <option value="in_kind">In kind</option>
          <option value="other">Other</option>
        </select>
      </label>
      <label><input type="checkbox" name="recipientAcknowledged" value="1"/> Recipient acknowledged</label>
      <button type="submit">Record distribution</button>
    </form>
  </section>
  <% } %>
</section>
<%- include('../partials/hq-shell-end') %>
