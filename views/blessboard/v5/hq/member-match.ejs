<%- include('../partials/hq-shell-start') %>
<section class="bb-hq-panel" data-bb-hq-member-match="1">
  <h1 class="bb-hq-page-head__title">Possible existing member</h1>
  <p>Review the church-scoped matches before continuing.</p>
  <% (matches || []).forEach(function (match) { %>
  <article class="bb-hq-panel">
    <strong><%= match.nameHint || match.firstName || 'Possible match' %></strong>
    <form method="post" action="/hq/members/new/match">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />
      <input type="hidden" name="draft_token" value="<%= draftToken %>" />
      <input type="hidden" name="member_id" value="<%= match.memberId || match.subjectRef %>" />
      <button class="bb-hq-btn bb-hq-btn--primary" name="action" value="open_existing">Open existing member</button>
    </form>
  </article>
  <% }) %>
  <% if (!blocked) { %>
  <form method="post" action="/hq/members/new/match">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />
    <input type="hidden" name="draft_token" value="<%= draftToken %>" />
    <button class="bb-hq-btn bb-hq-btn--primary" name="action" value="confirm_different">Continue as different person</button>
  </form>
  <% } %>
</section>
<%- include('../partials/hq-shell-end') %>
