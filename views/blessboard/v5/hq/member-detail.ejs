<%- include('../partials/hq-shell-start') %>
<%
  var m = member || {};
  function formatWhen(value) {
    if (!value) return '—';
    var d = value instanceof Date ? value : new Date(value);
    if (isNaN(d.getTime())) return String(value);
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
  }
%>

<section class="bb-hq-member-detail" data-bb-hq-member-detail="1" data-bb-membership="member-profile" data-screen="BB14" data-bb-screen-desktop="BB14-D" data-bb-screen-mobile="BB14-M" aria-label="Member profile">
  <p class="bb-hq-breadcrumb">
    <a href="/hq">HQ</a>
    <span aria-hidden="true">›</span>
    <a href="/hq/members">Members</a>
    <span aria-hidden="true">›</span>
    <span>Profile</span>
  </p>
  <p class="bb-hq-back">
    <a href="/hq/members">
      <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
      Back to directory
    </a>
  </p>

  <header class="bb-hq-page-head">
    <h1 class="bb-hq-page-head__title"><%= m.firstName %> <%= m.lastName %></h1>
    <p class="bb-hq-lede">Church-wide member profile. Privacy-limited fields only.</p>
  </header>

  <article class="bb-hq-panel">
    <div class="bb-hq-chips" aria-label="Status">
      <span class="bb-hq-chip"><%= m.status %></span>
      <% if (m.membershipStatus) { %>
      <span class="bb-hq-chip bb-hq-chip--muted"><%= m.membershipStatus %></span>
      <% } %>
      <% if (m.branchDisplayName || m.branchKey) { %>
      <span class="bb-hq-pill"><%= m.branchDisplayName || m.branchKey %></span>
      <% } %>
    </div>
    <dl class="bb-hq-dl">
      <dt>Legal name</dt>
      <dd><%= m.firstName %> <%= m.lastName %></dd>
      <% if (m.preferredName) { %>
      <dt>Preferred name</dt>
      <dd><%= m.preferredName %></dd>
      <% } %>
      <dt>Primary branch</dt>
      <dd>
        <% if (m.branchDisplayName || m.branchKey) { %>
        <%= m.branchDisplayName || m.branchKey %>
        <% if (m.branchKey) { %>
        <code class="bb-hq-key"><%= m.branchKey %></code>
        <% } %>
        <% } else { %>—<% } %>
      </dd>
      <dt>Email</dt>
      <dd><%= m.emailDisplay || '—' %></dd>
      <dt>Phone</dt>
      <dd><%= m.phoneDisplay || '—' %></dd>
      <dt>Joined</dt>
      <dd><%= formatWhen(m.joinedAt) %></dd>
      <dt>Primary membership</dt>
      <dd><%= m.isPrimary ? 'Yes' : 'No' %></dd>
      <dt>Login linked</dt>
      <dd><%= m.hasLoginLinked ? 'Yes' : 'No' %></dd>
    </dl>
  </article>

  <p class="bb-hq-hint">
    Linking a login is a separate step. Approving a registration never promises an automatic account.
  </p>

  <article class="bb-hq-panel bb-hq-panel--mobile-form" data-bb-member-edit="1" data-screen="BB15" data-bb-screen-desktop="BB15-D" data-bb-screen-mobile="BB15-M" data-bb-stitch-id-mobile="9207936b1268431fba2640c297438a11">
    <h2 class="bb-hq-section-title">Edit profile</h2>
    <p class="bb-hq-hint">Editing profile fields does not create or change a login account.</p>
    <form method="post" action="/hq/membership/members/<%= m.id %>/edit" data-bb-member-edit-form="1">
      <input type="hidden" name="<%= typeof csrfField !== 'undefined' ? csrfField : '_csrf' %>" value="<%= csrfToken %>" />
      <label for="hq_first_name">First name</label>
      <input id="hq_first_name" name="first_name" type="text" maxlength="100" value="<%= m.firstName || '' %>" autocomplete="given-name" />
      <label for="hq_last_name">Last name</label>
      <input id="hq_last_name" name="last_name" type="text" maxlength="100" value="<%= m.lastName || '' %>" autocomplete="family-name" />
      <label for="hq_preferred_name">Preferred name</label>
      <input id="hq_preferred_name" name="preferred_name" type="text" maxlength="100" value="<%= m.preferredName || '' %>" />
      <label for="hq_email">Email</label>
      <input id="hq_email" name="email" type="email" maxlength="254" value="<%= m.emailDisplay || m.email || '' %>" autocomplete="email" />
      <div class="bb-hq-actions bb-hq-actions--sticky">
        <button type="submit" class="bb-hq-btn bb-hq-btn--primary">Save profile</button>
      </div>
    </form>
  </article>

  <article class="bb-hq-panel bb-hq-panel--mobile-form" data-bb-member-transfer="1" data-screen="BB16" data-bb-screen-desktop="BB16-D" data-bb-screen-mobile="BB16-M" data-bb-stitch-id-mobile="9a061086176e49d3b55eabc3d95f2e1e">
    <h2 class="bb-hq-section-title">Request branch transfer</h2>
    <p class="bb-hq-hint">Transfers stay inside this church. Destination branch must belong to the same church.</p>
    <form method="post" action="/hq/membership/members/<%= m.id %>/transfer" data-bb-member-transfer-form="1">
      <input type="hidden" name="<%= typeof csrfField !== 'undefined' ? csrfField : '_csrf' %>" value="<%= csrfToken %>" />
      <label for="hq_to_branch_id">Destination branch ID</label>
      <input id="hq_to_branch_id" name="to_branch_id" type="text" required maxlength="64" />
      <label for="hq_reason">Reason</label>
      <textarea id="hq_reason" name="reason" rows="3" maxlength="1000"></textarea>
      <label class="bb-hq-check">
        <input type="checkbox" name="confirm_transfer" value="1" required />
        I confirm this transfer request stays within the same church.
      </label>
      <div class="bb-hq-actions bb-hq-actions--sticky">
        <button type="submit" class="bb-hq-btn bb-hq-btn--primary">Request transfer</button>
      </div>
    </form>
  </article>

  <% if (typeof journeySummary !== 'undefined' && journeySummary) { %>
  <article class="bb-hq-panel" data-bb-member-journey-summary="1">
    <h2 class="bb-hq-panel__title">Member journey</h2>
    <dl class="bb-hq-dl">
      <dt>Current stage</dt>
      <dd><%= journeySummary.currentStage || '—' %></dd>
      <dt>Active handover</dt>
      <dd><%= journeySummary.activeHandoverStatus || '—' %></dd>
      <dt>Cell</dt>
      <dd>
        <% if (journeySummary.cell) { %>
          <%= journeySummary.cell.displayName %>
          <% if (journeySummary.cell.careStatus) { %>
            <span class="bb-hq-chip bb-hq-chip--muted"><%= journeySummary.cell.careStatus %></span>
          <% } %>
        <% } else { %>—<% } %>
      </dd>
    </dl>
    <% if (journeySummary.classes && journeySummary.classes.length) { %>
      <h3>Classes</h3>
      <ul>
        <% journeySummary.classes.forEach(function (c) { %>
          <li><%= c.programName %> · <%= c.cohortName %> · <%= c.status %></li>
        <% }) %>
      </ul>
    <% } %>
    <% if (journeySummary.departments && journeySummary.departments.length) { %>
      <h3>Departments</h3>
      <ul>
        <% journeySummary.departments.forEach(function (d) { %>
          <li><%= d.displayName %></li>
        <% }) %>
      </ul>
    <% } %>
    <% if (journeySummary.handovers && journeySummary.handovers.length) { %>
      <h3>Recent handovers</h3>
      <ul>
        <% journeySummary.handovers.forEach(function (h) { %>
          <li>
            <a href="/hq/member-journey/handovers/<%= h.id %>"><%= h.fromStage %> → <%= h.toStage %></a>
            · <%= h.status %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </article>
  <% } %>
</section>

<%- include('../partials/hq-shell-end') %>
