<%- include('../partials/platform-admin-shell-start') %>
<%
  var app = application || {};
  var rq = (typeof registrationQueue !== 'undefined' && registrationQueue) ? registrationQueue : null;
  var needs = (typeof needsInformationState !== 'undefined' && needsInformationState)
    ? needsInformationState
    : { hasRequest: false, waiting: true, reasonLabels: [], delivery: null };
  var delivery = (typeof deliverySummary !== 'undefined' && deliverySummary)
    ? deliverySummary
    : (needs.delivery || { key: 'recorded', label: 'Information request recorded' });
  function displayOrMissing(value) {
    if (value == null) return null;
    var s = String(value).trim();
    return s ? s : null;
  }
  function fmtDate(d) {
    if (!d) return null;
    try {
      return new Date(d).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
    } catch (e) {
      return null;
    }
  }
  var churchName = displayOrMissing(app.churchName) || 'Church registration';
  var contactName = displayOrMissing(app.contactName);
  var emailDisplay = displayOrMissing(app.contactEmail);
  var phoneDisplay = displayOrMissing(app.contactPhoneNormalized) || displayOrMissing(app.contactPhone);
  var phase5Status = rq && rq.presentPhase5QueueStatus
    ? rq.presentPhase5QueueStatus(app)
    : { key: 'needs_information', label: 'Needs Information', chipClass: 'bb-pa-chip--warn' };
  var appIdEnc = app.id ? encodeURIComponent(String(app.id)) : '';
  var viewHref = appIdEnc ? ('/admin/registration-applications/' + appIdEnc) : '/admin/registration-applications';
  var anotherHref = appIdEnc
    ? ('/admin/registration-applications/' + appIdEnc + '/request-information')
    : viewHref;
  var recordedAt = fmtDate(needs.requestedAt);
  var actorId = needs.latestEvent && needs.latestEvent.actor_user_id
    ? String(needs.latestEvent.actor_user_id)
    : null;
  var headline = 'Information request recorded';
  if (delivery.key === 'email_sent') headline = 'Email sent';
  else if (delivery.key === 'sms_sent') headline = 'SMS sent';
  else if (delivery.key === 'delivery_failed') headline = 'Delivery failed';
  else if (delivery.key === 'unavailable' || delivery.key === 'queued') headline = 'Information request recorded';
%>

<section
  class="bb-pa-org-detail bb-pa-reg-info-requested"
  data-bb-pa-reg-info-requested="1"
  data-bb-pa-reg-info-delivery="<%= delivery.key %>"
  aria-label="Information requested"
>
  <header class="bb-pa-page-head bb-pa-reg-info-requested__head">
    <div class="bb-pa-reg-approved__icon" aria-hidden="true">✓</div>
    <p class="bb-pa-org-detail__eyebrow" data-bb-pa-reg-info-result-label="1"><%= headline %></p>
    <h1 class="bb-pa-page-head__title" data-bb-pa-reg-info-church="1"><%= churchName %></h1>
    <p class="bb-pa-lede">
      <span class="bb-pa-chip <%= phase5Status.chipClass %>" data-bb-pa-phase5-status="<%= phase5Status.key %>"><%= phase5Status.label %></span>
      <span class="bb-pa-chip bb-pa-chip--warn" data-bb-pa-reg-info-follow-up="1">Follow-up: awaiting customer</span>
      <% if (recordedAt) { %>
      <span data-bb-pa-reg-info-recorded-at="1"><%= recordedAt %></span>
      <% } %>
    </p>
  </header>

  <section class="bb-pa-panel" aria-labelledby="reg-info-result-summary-title">
    <h2 id="reg-info-result-summary-title" class="bb-pa-section-title">Request summary</h2>
    <dl class="bb-pa-dl">
      <div>
        <dt>Delivery state</dt>
        <dd data-bb-pa-reg-info-delivery-label="1"><%= delivery.label %></dd>
      </div>
      <% if (needs.reasonLabels && needs.reasonLabels.length) { %>
      <div>
        <dt>Selected reasons</dt>
        <dd data-bb-pa-reg-info-reasons="1">
          <ul class="bb-pa-reg-info-requested__reasons">
            <% needs.reasonLabels.forEach(function (label) { %>
            <li><%= label %></li>
            <% }) %>
          </ul>
        </dd>
      </div>
      <% } %>
      <% if (needs.messageSummary) { %>
      <div>
        <dt>Message summary</dt>
        <dd data-bb-pa-reg-info-message="1"><%= needs.messageSummary %></dd>
      </div>
      <% } %>
      <% if (contactName || needs.recipient || emailDisplay) { %>
      <div>
        <dt>Recipient contact</dt>
        <dd data-bb-pa-reg-info-recipient="1">
          <% if (contactName) { %><%= contactName %><% } %>
          <% if (contactName && (needs.recipient || emailDisplay)) { %> · <% } %>
          <span class="bb-pa-reg-hub__email"><%= needs.recipient || emailDisplay %></span>
          <% if (phoneDisplay) { %> · <%= phoneDisplay %><% } %>
        </dd>
      </div>
      <% } %>
      <% if (actorId) { %>
      <div>
        <dt>Recorded by</dt>
        <dd data-bb-pa-reg-info-actor="1">Platform administrator</dd>
      </div>
      <% } %>
    </dl>
    <p class="bb-pa-banner bb-pa-banner--warn" role="status" data-bb-pa-reg-info-no-false-sent="1">
      Request recorded. External delivery is not yet connected. Application status was not changed by this action.
    </p>
  </section>

  <div class="bb-pa-reg-info-requested__actions">
    <a class="bb-pa-btn bb-pa-btn--primary" href="<%= viewHref %>" data-bb-pa-reg-info-view="1">Return to review</a>
    <a class="bb-pa-btn bb-pa-btn--secondary" href="/admin/registration-applications" data-bb-pa-reg-info-return="1">Return to registrations</a>
    <a class="bb-pa-btn bb-pa-btn--secondary" href="<%= anotherHref %>" data-bb-pa-reg-info-another="1">Record another request</a>
  </div>
</section>

<%- include('../partials/platform-admin-shell-end') %>
