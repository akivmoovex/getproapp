<%- include('../partials/platform-admin-shell-start') %>
<%
  var rows = organizations || [];
  var limits = allowedLimits || [10, 25, 50, 100];
  var f = filters || {};
  var hasFilter = Boolean(
    keyPrefix ||
    f.product ||
    f.onboarding ||
    f.follow_up ||
    f.support_requested ||
    f.publication ||
    f.plan
  );
  var totalCount = typeof total !== 'undefined' ? Number(total) || 0 : 0;
  function statusLabel(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'active') return 'Active';
    if (key === 'inactive') return 'Inactive';
    if (key === 'suspended') return 'Suspended';
    if (key === 'pending') return 'Pending';
    if (key === 'archived') return 'Archived';
    if (key === 'trialing') return 'Trialing';
    if (key === 'past_due') return 'Past due';
    if (key === 'grace') return 'Grace';
    return String(s || '—').replace(/_/g, ' ');
  }
  function statusChip(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'active' || key === 'published' || key === 'completed' || key === 'trialing') return 'bb-pa-chip--ok';
    if (key === 'suspended' || key === 'needs_help') return 'bb-pa-chip--danger';
    if (key === 'pending' || key === 'in_progress' || key === 'partially_published' || key === 'new' || key === 'past_due' || key === 'grace') return 'bb-pa-chip--warn';
    if (key === 'inactive' || key === 'archived' || key === 'unpublished' || key === 'not_started') return 'bb-pa-chip--muted';
    return 'bb-pa-chip--muted';
  }
  function formatTs(iso) {
    if (!iso) return '—';
    try {
      var d = new Date(iso);
      if (Number.isNaN(d.getTime())) return '—';
      return d.toISOString().slice(0, 10);
    } catch (e) {
      return '—';
    }
  }
  function subStatusLabel(org) {
    if (org.subscriptionStatusLabel) return org.subscriptionStatusLabel;
    return statusLabel(org.subscriptionStatus);
  }
  function timingEnd(org) {
    if (org.subscriptionTimingKind === 'grace' || org.subscriptionTimingKind === 'trial') {
      return org.subscriptionEndsAt;
    }
    return org.subscriptionEndsAt;
  }
  function statusTone(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'active') return 'ok';
    if (key === 'suspended') return 'danger';
    if (key === 'pending') return 'warn';
    return 'muted';
  }
  function filterQueryParts() {
    var parts = ['limit=' + encodeURIComponent(limit)];
    if (keyPrefix) parts.push('q=' + encodeURIComponent(keyPrefix));
    if (f.product) parts.push('product=' + encodeURIComponent(f.product));
    if (f.onboarding) parts.push('onboarding=' + encodeURIComponent(f.onboarding));
    if (f.follow_up) parts.push('follow_up=' + encodeURIComponent(f.follow_up));
    if (f.support_requested) parts.push('support_requested=' + encodeURIComponent(f.support_requested));
    if (f.publication) parts.push('publication=' + encodeURIComponent(f.publication));
    if (f.plan) parts.push('plan=' + encodeURIComponent(f.plan));
    return parts;
  }
  function queryPage(p) {
    return '/admin/organizations?' + filterQueryParts().concat(['page=' + encodeURIComponent(p)]).join('&');
  }
  function clearHref() {
    return '/admin/organizations?limit=' + encodeURIComponent(limit);
  }
%>

<section
  class="bb-pa-orgs"
  data-bb-pa-organizations="1"
  data-bb-stitch-organizations="63-platform-church-organizations"
  aria-label="Organization directory"
>
  <header class="bb-pa-page-head bb-pa-page-head--split">
    <div>
      <p class="bb-pa-orgs__eyebrow">Platform catalogue</p>
      <h1 class="bb-pa-page-head__title">Organization Governance</h1>
      <p class="bb-pa-lede">
        Canonical list of <strong>provisioned</strong> organizations only.
        Registration applications live under
        <a class="bb-pa-link" href="/admin/registration-applications">Registration Applications</a>
        and are never counted here as organizations.
      </p>
    </div>
    <p class="bb-pa-page-head__actions">
      <span class="bb-pa-orgs__total" data-bb-count="directory-total"><%= totalCount %></span>
      <span class="bb-pa-orgs__total-label">in directory</span>
    </p>
  </header>

  <p class="bb-pa-orgs__notice" role="note" data-bb-pa-org-notice="1">
    Optional filters narrow this same list (product, onboarding, follow-up, support, publication, plan).
    Search uses organization key prefix only. No second onboarding or support queue.
  </p>

  <form
    class="bb-pa-org-filter"
    method="get"
    action="/admin/organizations"
    role="search"
    data-bb-pa-org-filter="1"
  >
    <div class="bb-pa-field">
      <label for="q">Organization key prefix</label>
      <input
        id="q"
        name="q"
        type="search"
        value="<%= keyPrefix || '' %>"
        placeholder="e.g. pa-"
        maxlength="64"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
    <div class="bb-pa-field">
      <label for="product">Product</label>
      <select id="product" name="product" data-bb-pa-filter="product">
        <option value="">All products</option>
        <option value="blessboard" <%= f.product === 'blessboard' ? 'selected' : '' %>>BlessBoard</option>
      </select>
    </div>
    <div class="bb-pa-field">
      <label for="onboarding">Onboarding</label>
      <select id="onboarding" name="onboarding" data-bb-pa-filter="onboarding">
        <option value="">Any</option>
        <option value="incomplete" <%= f.onboarding === 'incomplete' ? 'selected' : '' %>>Incomplete</option>
      </select>
    </div>
    <div class="bb-pa-field">
      <label for="follow_up">Follow-up</label>
      <select id="follow_up" name="follow_up" data-bb-pa-filter="follow_up">
        <option value="">Any</option>
        <% (allowedFollowUp || []).forEach(function (s) { %>
        <option value="<%= s %>" <%= f.follow_up === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
        <% }) %>
      </select>
    </div>
    <div class="bb-pa-field">
      <label for="support_requested">Support requested</label>
      <select id="support_requested" name="support_requested" data-bb-pa-filter="support_requested">
        <option value="">Any</option>
        <option value="true" <%= f.support_requested === 'true' ? 'selected' : '' %>>Yes</option>
      </select>
    </div>
    <div class="bb-pa-field">
      <label for="publication">Publication</label>
      <select id="publication" name="publication" data-bb-pa-filter="publication">
        <option value="">Any</option>
        <option value="unpublished" <%= f.publication === 'unpublished' ? 'selected' : '' %>>Unpublished</option>
      </select>
    </div>
    <div class="bb-pa-field">
      <label for="plan">Plan</label>
      <select id="plan" name="plan" data-bb-pa-filter="plan">
        <option value="">Any</option>
        <% (allowedPlans || ['free']).forEach(function (p) { %>
        <option value="<%= p %>" <%= f.plan === p ? 'selected' : '' %>>
          <%= p === 'network' ? 'Network' : (p === 'free' ? 'Foundation' : (p === 'growth' ? 'Growth' : p)) %>
        </option>
        <% }) %>
      </select>
    </div>
    <div class="bb-pa-field">
      <label for="limit">Rows per page</label>
      <select id="limit" name="limit">
        <% limits.forEach(function (n) { %>
        <option value="<%= n %>" <%= Number(limit) === Number(n) ? 'selected' : '' %>><%= n %></option>
        <% }) %>
      </select>
    </div>
    <div class="bb-pa-org-filter__actions">
      <button type="submit" class="bb-pa-btn">
        <span class="material-symbols-outlined" aria-hidden="true">filter_list</span>
        Filter
      </button>
      <% if (hasFilter) { %>
      <a class="bb-pa-btn bb-pa-btn--ghost" href="<%= clearHref() %>">Clear</a>
      <% } %>
    </div>
  </form>

  <% if (!rows.length && !hasFilter) { %>
  <div class="bb-pa-orgs-empty" data-bb-empty="organizations" data-bb-pa-empty="catalog" role="status">
    <%- include('../partials/empty-state', {
      title: 'No organizations yet',
      body: 'Provisioned platform organizations appear here. Creation stays CLI-only — there is no create-organization screen in V5.',
      icon: 'corporate_fare',
      actionHref: '/admin',
      actionLabel: 'Back to dashboard'
    }) %>
  </div>
  <% } else if (!rows.length && hasFilter) { %>
  <div class="bb-pa-orgs-empty" data-bb-empty="organizations" data-bb-pa-empty="no-results" role="status">
    <%- include('../partials/empty-state', {
      title: 'No matching organizations',
      body: 'Try different filters, or clear to see the full directory. Applications are not listed here.',
      icon: 'search_off',
      actionHref: clearHref(),
      actionLabel: 'Clear filter'
    }) %>
  </div>
  <% } else { %>

  <div
    class="bb-pa-table-wrap bb-pa-orgs-table-wrap"
    data-bb-org-table-wrap="1"
    role="region"
    aria-label="Organizations table"
    tabindex="0"
  >
    <table class="bb-pa-table bb-pa-orgs-table" data-bb-table="organizations" data-bb-org-table="1">
      <thead>
        <tr>
          <th scope="col">Organization</th>
          <th scope="col">First branch</th>
          <th scope="col">Plan</th>
          <th scope="col">Subscription</th>
          <th scope="col">Trial / grace end</th>
          <th scope="col">Onboarding</th>
          <th scope="col">Registered</th>
          <th scope="col">Registration</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (org) { %>
        <tr data-bb-org-key="<%= org.organizationKey %>" data-bb-org-plan="<%= org.planKey || '' %>" data-bb-org-sub-status="<%= org.subscriptionStatus || '' %>">
          <td>
            <a class="bb-pa-orgs__name-link" href="/admin/organizations/<%= org.organizationKey %>">
              <strong><%= org.displayName %></strong>
              <code class="bb-pa-key">key · <%= org.organizationKey %></code>
            </a>
            <% if (org.supportRequested) { %>
            <span class="bb-pa-chip bb-pa-chip--warn" data-bb-pa-support-requested="1">Support requested</span>
            <% } %>
          </td>
          <td data-bb-first-branch="1"><%= org.firstBranchName || '—' %></td>
          <td>
            <span data-bb-plan-label="1"><%= org.planLabel || '—' %></span>
            <% if (org.planKey) { %><div><code class="bb-pa-key"><%= org.planKey %></code></div><% } %>
          </td>
          <td>
            <% if (org.subscriptionStatus) { %>
            <span class="bb-pa-chip <%= statusChip(org.subscriptionStatusLabel === 'Grace' ? 'grace' : org.subscriptionStatus) %>" data-bb-sub-status="<%= org.subscriptionStatus %>"><%= subStatusLabel(org) %></span>
            <% } else { %>—<% } %>
          </td>
          <td data-bb-timing-end="1">
            <% if (org.subscriptionTimingLabel && timingEnd(org)) { %>
            <span class="bb-pa-muted"><%= org.subscriptionTimingLabel %></span>
            <div><time datetime="<%= timingEnd(org) %>"><%= formatTs(timingEnd(org)) %></time></div>
            <% } else { %>—<% } %>
          </td>
          <td>
            <% if (org.onboardingStatus) { %>
            <span class="bb-pa-chip <%= statusChip(org.onboardingStatus) %>"><%= statusLabel(org.onboardingStatus) %></span>
            <% } else { %>—<% } %>
          </td>
          <td>
            <% if (org.organizationCreatedAt) { %>
            <time datetime="<%= org.organizationCreatedAt %>" data-bb-org-registered="1"><%= formatTs(org.organizationCreatedAt) %></time>
            <% } else { %>—<% } %>
          </td>
          <td>
            <% if (org.registrationApplicationId) { %>
            <a class="bb-pa-link" href="/admin/registration-applications/<%= org.registrationApplicationId %>" data-bb-linked-registration="1">View application</a>
            <% } else { %>—<% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <ul class="bb-pa-orgs-cards" data-bb-org-cards="1">
    <% rows.forEach(function (org) { %>
    <li
      class="bb-pa-orgs-card bb-pa-orgs-card--<%= statusTone(org.organizationStatus) %>"
      data-bb-org-key="<%= org.organizationKey %>"
    >
      <a class="bb-pa-orgs-card__link" href="/admin/organizations/<%= org.organizationKey %>">
        <span class="bb-pa-orgs-card__icon" aria-hidden="true">
          <span class="material-symbols-outlined">corporate_fare</span>
        </span>
        <span class="bb-pa-orgs-card__body">
          <span class="bb-pa-orgs-card__top">
            <strong class="bb-pa-orgs-card__title"><%= org.displayName %></strong>
            <span class="bb-pa-chip <%= statusChip(org.organizationStatus) %>"><%= statusLabel(org.organizationStatus) %></span>
          </span>
          <code class="bb-pa-key"><%= org.organizationKey %></code>
          <span class="bb-pa-orgs-card__meta">
            <% if (org.firstBranchName) { %><span>Branch · <%= org.firstBranchName %></span><% } %>
            <% if (org.planLabel || org.planKey) { %><span>Plan · <%= org.planLabel || org.planKey %></span><% } %>
            <% if (org.subscriptionStatus) { %>
            <span class="bb-pa-chip <%= statusChip(org.subscriptionStatusLabel === 'Grace' ? 'grace' : org.subscriptionStatus) %>"><%= subStatusLabel(org) %></span>
            <% } %>
            <% if (org.onboardingStatus) { %>
            <span class="bb-pa-chip <%= statusChip(org.onboardingStatus) %>"><%= statusLabel(org.onboardingStatus) %></span>
            <% } %>
            <% if (org.registrationApplicationId) { %>
            <span>Linked registration</span>
            <% } %>
          </span>
        </span>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>

  <nav class="bb-pa-pager" aria-label="Organization pagination" data-bb-pager="organizations">
    <span class="bb-pa-pager__meta">
      <% if (totalCount === 0) { %>
      Showing 0 of 0
      <% } else { %>
      Showing <%= rangeFrom %>–<%= rangeTo %> of <%= totalCount %>
      <% } %>
      · page <%= page %> of <%= totalPages || 1 %>
      · limit <%= limit %> (max <%= maxLimit %>)
    </span>
    <span class="bb-pa-pager__nav">
      <% if (page > 1) { %>
      <a class="bb-pa-btn bb-pa-btn--ghost" href="<%= queryPage(page - 1) %>">Previous</a>
      <% } %>
      <% if (totalPages && page < totalPages) { %>
      <a class="bb-pa-btn bb-pa-btn--ghost" href="<%= queryPage(page + 1) %>">Next</a>
      <% } %>
    </span>
  </nav>
</section>

<%- include('../partials/platform-admin-shell-end') %>
