<%- include('../partials/platform-admin-shell-start') %>
<%
  var app = application || {};
  var ov = app.operatorView || {};
  var contactRows = contacts || [];
  var audits = auditEvents || [];
  var admins = platformAdmins || [];
  var followOpts = followUpStatuses || [];
  var methodOpts = contactMethods || [];
  var outcomeOpts = contactOutcomes || [];
  var flashNotice = typeof notice !== 'undefined' ? notice : null;
  var flashError = typeof error !== 'undefined' ? error : null;
  var displayStatus = ov.displayStatus || app.displayStatus || '—';
  var statusExplanation = ov.explanation || app.statusExplanation || '';
  var operatorQueue = ov.queue || app.operatorQueue || '';
  var operatorTone = ov.tone || app.operatorTone || 'muted';
  var organizationHref = ov.organizationHref ||
    (app.organizationKey
      ? '/admin/organizations/' + encodeURIComponent(app.organizationKey)
      : null);

  function labelStatus(s) {
    return String(s || '').replace(/_/g, ' ') || '—';
  }
  function toneChip(tone) {
    if (typeof registrationStatus !== 'undefined' && registrationStatus && registrationStatus.chipClassForTone) {
      return registrationStatus.chipClassForTone(tone);
    }
    if (tone === 'success') return 'bb-pa-chip--ok';
    if (tone === 'danger') return 'bb-pa-chip--danger';
    if (tone === 'warn') return 'bb-pa-chip--warn';
    return 'bb-pa-chip--muted';
  }
  function fmtDate(d) {
    if (!d) return null;
    try {
      return new Date(d).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
    } catch (e) {
      return null;
    }
  }
  function displayOrMissing(value) {
    if (value == null) return null;
    var s = String(value).trim();
    return s ? s : null;
  }
  function noticeText(code) {
    if (code === 'follow_up_saved') return 'Follow-up status updated.';
    if (code === 'support_assigned') return 'Support assignment saved.';
    if (code === 'contact_saved') return 'Contact note added.';
    if (code === 'approved') return 'Application approved and provisioned.';
    if (code === 'already_provisioned') return 'Organization was already provisioned.';
    if (code === 'network_organization_created') {
      return 'Network organization created. Activate the Network plan from the organization page when ready.';
    }
    if (code === 'validation_complete') {
      return 'Network validation marked complete. A platform administrator can create the organization.';
    }
    if (code === 'rejected') return 'Application rejected. No organization was provisioned.';
    if (code === 'application_rejected') {
      return 'Application rejected. No organization was provisioned. This does not confirm that a rejection message was delivered.';
    }
    if (code === 'application_reopened') {
      return 'Application reopened for review. Prior rejection history and communications were preserved. No email was sent.';
    }
    if (code === 'retry_succeeded' || code === 'provision_retried') return 'Provisioning retry completed.';
    if (code === 'already_healthy') return 'Provisioning is already complete. Healthy resources were not rebuilt.';
    if (code === 'organization_linked') return 'Application linked to the existing organization.';
    if (code === 'phone_attempt_recorded') return 'Phone verification attempt recorded.';
    if (code === 'email_verification_sent') {
      return 'Verification email resend was accepted for processing.';
    }
    if (code === 'information_requested') {
      return 'Information request recorded. Follow-up is set to awaiting customer. This does not confirm that a message was delivered.';
    }
    return null;
  }
  function errorText(code) {
    if (code === 'csrf') return 'Invalid or missing security token. Reload and try again.';
    if (code === 'confirm_required') return 'Confirmation is required.';
    if (code === 'invalid') return 'The request could not be processed. Review the fields and try again.';
    if (code === 'phone_attempt_failed') return 'The call attempt could not be saved right now.';
    if (code === 'cooldown') {
      return 'Please wait at least 60 seconds before resending another verification email.';
    }
    if (code === 'invalid_email') {
      return 'The applicant email is missing or invalid.';
    }
    if (code === 'email_sending_unavailable') {
      return 'Email delivery is not configured. A verification token was recorded but no message was sent.';
    }
    if (code === 'sending_unavailable') {
      return 'Outbound email is not available right now. The information request was not recorded as sent.';
    }
    if (code === 'email_verification_failed') {
      return 'The verification email could not be processed right now.';
    }
    if (code === 'information_request_failed') {
      return 'The information request could not be saved right now.';
    }
    if (code === 'not_found') return 'This registration application could not be found.';
    if (code === 'organization_not_found') return 'That organization key was not found.';
    if (code === 'not_provisioned') {
      return 'This action is available after the organization is provisioned.';
    }
    if (code === 'not_eligible') {
      return 'This application is not eligible for that action.';
    }
    if (code === 'identity_conflict') {
      return 'The administrator email belongs to an account that cannot safely own this church. Resolve the identity conflict before approving.';
    }
    if (code === 'duplicate_email_review') {
      return 'This email still needs duplicate review before provisioning can continue.';
    }
    if (code === 'network_validation_required') {
      return 'Network validation must be completed before creating the organization.';
    }
    if (code === 'administrator_email_required') {
      return 'Administrator email is required.';
    }
    if (code === 'not_platform_admin') return 'Only active platform administrators can be assigned.';
    if (code === 'provision_failed') {
      return 'Provisioning failed. No organization was created.';
    }
    if (code === 'not_retryable') {
      return 'Provisioning retry is not available. Healthy resources were not rebuilt.';
    }
    if (code === 'schema_mismatch') {
      return 'Registration approval is temporarily unavailable because the database schema is incomplete. BlessBoard support has been notified via server logs — try again after pending migrations are applied.';
    }
    if (code === 'follow_up_failed' || code === 'assign_failed' || code === 'contact_failed' ||
        code === 'reject_failed' || code === 'reopen_failed' || code === 'approve_failed' ||
        code === 'retry_failed' || code === 'link_failed') {
      return 'The change could not be saved. Try again.';
    }
    return code ? 'Something went wrong.' : null;
  }
  var infoRequestCategories = [
    { value: 'clarify_church_identity', label: 'Clarify church identity' },
    { value: 'confirm_applicant_authority', label: 'Confirm applicant authority' },
    { value: 'upload_registration_document', label: 'Upload registration document' },
    { value: 'correct_phone', label: 'Correct phone' },
    { value: 'correct_email', label: 'Correct email' },
    { value: 'confirm_location', label: 'Confirm location' },
    { value: 'explain_possible_duplicate', label: 'Explain possible duplicate' },
    { value: 'confirm_website_name', label: 'Confirm website name' },
    { value: 'add_service_times', label: 'Add service times' },
    { value: 'other', label: 'Other' }
  ];
  var infoRequestRecipient = displayOrMissing(app.contactEmail) || '';
  var noticeMsg = noticeText(flashNotice);
  var errorMsg = errorText(flashError);
  var cityVal = displayOrMissing(app.city);
  var countryVal = displayOrMissing(app.country);
  var locationLabel = [cityVal, countryVal].filter(Boolean).join(', ') || null;
  var roleVal = displayOrMissing(app.roleInChurch);
  var branchNameVal = displayOrMissing(app.branchName);
  var branchCountVal = displayOrMissing(app.branchCount);
  var messageVal = displayOrMissing(app.message);
  var assigneeLabel = displayOrMissing(app.assignedSupportDisplayName) ||
    displayOrMissing(app.assignedSupportEmail) ||
    null;
  var submittedLabel = fmtDate(app.createdAt);
  var lastActivityLabel = fmtDate(app.lastActivityAt) || fmtDate(app.lastContactedAt) || submittedLabel;
  var appRef = displayOrMissing(app.id);
  var ORIGIN_APPLICANT = 'Applicant-provided';
  var ORIGIN_SYSTEM = 'System-derived';
  var ORIGIN_ADMIN = 'Administrator-entered';

  var rq = (typeof registrationQueue !== 'undefined' && registrationQueue) ? registrationQueue : null;
  var phase5Status = rq && rq.presentPhase5QueueStatus
    ? rq.presentPhase5QueueStatus(app)
    : { key: 'new', label: 'New', tone: 'warn', chipClass: 'bb-pa-chip--warn' };
  var phase5Date = rq && rq.formatRegistrationDate
    ? rq.formatRegistrationDate(app.createdAt)
    : (submittedLabel || '—');
  var phase5Location = rq && rq.formatRegistrationLocation
    ? rq.formatRegistrationLocation(app)
    : (locationLabel || null);
  var dupWarning = (typeof duplicateWarning !== 'undefined' && duplicateWarning) ? duplicateWarning : null;
  if (!dupWarning && rq && rq.presentPhase5DuplicateWarning && typeof duplicateMatchesLoaded !== 'undefined') {
    dupWarning = rq.presentPhase5DuplicateWarning(duplicateMatchesLoaded, app.id);
  }
  if (!dupWarning) {
    dupWarning = { show: false, match: null, listHref: null, advisory: true };
  }
  var showDupWarning = Boolean(dupWarning && dupWarning.show && dupWarning.match);
  var dupMatch = showDupWarning ? dupWarning.match : null;
  var appIdEnc = app.id ? encodeURIComponent(String(app.id)) : '';
  var canPhase5Approve = Boolean(app.riskReviewActionsAvailable || app.networkApproveAvailable);
  var canPhase5Reject = Boolean(app.rejectActionsAvailable);
  var isPhase5Rejected =
    phase5Status.key === 'rejected' || String(app.applicationStatus || '') === 'rejected';
  var decisionApproveHref = appIdEnc && canPhase5Approve
    ? ('/admin/registration-applications/' + appIdEnc + '/approve')
    : (organizationHref || null);
  var decisionRequestHref = appIdEnc
    ? ('/admin/registration-applications/' + appIdEnc + '/request-information')
    : '#reg-communications';
  var decisionRejectHref = appIdEnc
    ? (canPhase5Reject
      ? ('/admin/registration-applications/' + appIdEnc + '/reject')
      : (isPhase5Rejected
        ? ('/admin/registration-applications/' + appIdEnc + '/rejected')
        : ('/admin/registration-applications/' + appIdEnc)))
    : '#';
  var decisionRejectDupHref = appIdEnc
    ? ('/admin/registration-applications/' + appIdEnc + '/reject?rejection_category=duplicate_registration')
    : '#';
  var continueApprovalHref = canPhase5Approve ? decisionApproveHref : null;
  var showOrgDecision = Boolean(!canPhase5Approve && organizationHref);
  var phoneHref = null;
  var emailHref = null;
  var phoneDisplay = displayOrMissing(app.contactPhoneNormalized) || displayOrMissing(app.contactPhone);
  var emailDisplay = displayOrMissing(app.contactEmail);
  if (phoneDisplay) {
    var phoneTel = String(phoneDisplay).replace(/[^\d+]/g, '');
    if (phoneTel) phoneHref = 'tel:' + phoneTel;
  }
  if (emailDisplay) emailHref = 'mailto:' + String(emailDisplay);
  var reviewNotesVal = displayOrMissing(app.reviewNotes);
  var intentRaw = (typeof intent !== 'undefined' && intent) ? String(intent) : '';
  // Phase 5 decision intents use dedicated pages; do not auto-open secondary bypass forms.
  var secondaryOpen = intentRaw === 'follow-up';
  var planLabel = displayOrMissing(app.selectedPlanLabel) || displayOrMissing(app.selectedPlan);
  var needsInformationState = rq && rq.presentPhase5NeedsInformationState
    ? rq.presentPhase5NeedsInformationState(
        (typeof communications !== 'undefined' ? communications : null),
        app
      )
    : null;
%>

<section
  class="bb-pa-org-detail bb-pa-reg-detail bb-pa-reg-hub"
  data-bb-pa-registration-application-detail="1"
  data-bb-pa-reg-detail-overview="1"
  data-bb-pa-reg-phase5-hub="1"
  data-bb-phase5-status="<%= phase5Status.key %>"
  data-bb-pa-reg-dup-warning="<%= showDupWarning ? '1' : '0' %>"
  aria-label="Review church registration"
>
  <nav class="bb-pa-org-detail__crumb" aria-label="Breadcrumb">
    <a class="bb-pa-link" href="/admin/registration-applications" data-bb-pa-reg-back="1">Back to Church Registrations</a>
  </nav>

  <% if (noticeMsg) { %>
  <div class="bb-pa-flash bb-pa-flash--ok" role="status"><%= noticeMsg %></div>
  <% } %>
  <% if (errorMsg) { %>
  <div class="bb-pa-flash bb-pa-flash--error" role="alert"><%= errorMsg %></div>
  <% } %>

  <%- include('../partials/tenant-health-summary', { tenantHealth: typeof tenantHealth !== 'undefined' ? tenantHealth : null }) %>

  <header class="bb-pa-page-head bb-pa-reg-hub__header" data-bb-pa-reg-section="overview" id="reg-overview">
    <div class="bb-pa-reg-hub__header-main">
      <h1 class="bb-pa-page-head__title bb-pa-reg-hub__title" data-bb-pa-reg-church-name="1"><%= app.churchName || 'Registration application' %></h1>
      <p class="bb-pa-lede bb-pa-reg-hub__meta">
        <span class="bb-pa-chip <%= phase5Status.chipClass %>" data-bb-pa-display-status="1" data-bb-pa-phase5-status="<%= phase5Status.key %>"><%= phase5Status.label %></span>
        <% if (phase5Date && phase5Date !== '—') { %>
        <span data-bb-pa-reg-submitted="1">Registered <%= phase5Date %></span>
        <% } %>
        <% if (planLabel) { %>
        <span data-bb-pa-plan-badge="<%= String(app.selectedPlan || '').toLowerCase() %>"><%= planLabel %></span>
        <% } %>
      </p>
    </div>
  </header>

  <% if (showDupWarning && dupMatch) { %>
  <aside
    class="bb-pa-reg-hub__dup"
    data-bb-pa-reg-dup-banner="1"
    role="status"
    aria-labelledby="reg-dup-warning-title"
  >
    <div class="bb-pa-reg-hub__dup-head">
      <h2 id="reg-dup-warning-title" class="bb-pa-reg-hub__dup-title">Possible duplicate church found</h2>
      <p class="bb-pa-hint">
        Duplicate evidence is advisory. Continue Approval does not change duplicate review state.
      </p>
    </div>
    <dl class="bb-pa-dl bb-pa-reg-hub__dup-dl">
      <div>
        <dt>Matching record</dt>
        <dd data-bb-pa-reg-dup-name="1"><%= dupMatch.name %></dd>
      </div>
      <% if (dupMatch.location) { %>
      <div>
        <dt>Location</dt>
        <dd data-bb-pa-reg-dup-location="1"><%= dupMatch.location %></dd>
      </div>
      <% } %>
      <div>
        <dt>Match reason</dt>
        <dd data-bb-pa-reg-dup-reason="1"><%= dupMatch.reason %></dd>
      </div>
      <% if (dupMatch.stateLabel) { %>
      <div>
        <dt>Current state</dt>
        <dd data-bb-pa-reg-dup-state="1"><%= dupMatch.stateLabel %></dd>
      </div>
      <% } %>
      <div>
        <dt>Risk</dt>
        <dd data-bb-pa-reg-dup-risk="1"><%= dupMatch.riskLabel %></dd>
      </div>
    </dl>
    <div class="bb-pa-reg-hub__dup-actions">
      <% if (dupMatch.existingHref) { %>
      <a
        class="bb-pa-btn bb-pa-btn--secondary"
        href="<%= dupMatch.existingHref %>"
        data-bb-pa-reg-dup-view-existing="1"
      >View existing church or registration</a>
      <% } else if (dupWarning.listHref) { %>
      <a
        class="bb-pa-btn bb-pa-btn--secondary"
        href="<%= dupWarning.listHref %>"
        data-bb-pa-reg-dup-view-existing="1"
      >View duplicate matches</a>
      <% } %>
      <% if (continueApprovalHref) { %>
      <a
        class="bb-pa-btn bb-pa-btn--primary"
        href="<%= continueApprovalHref %>"
        data-bb-pa-reg-dup-continue="1"
      >Continue approval</a>
      <% } %>
      <% if (canPhase5Reject) { %>
      <a
        class="bb-pa-btn bb-pa-btn--danger"
        href="<%= decisionRejectDupHref %>"
        data-bb-pa-reg-dup-reject="1"
      >Reject as duplicate</a>
      <% } %>
    </div>
  </aside>
  <% } %>

  <%- include('../partials/pa-registration-needs-information', {
    app: app,
    rq: rq,
    phase5Status: phase5Status,
    needsInformationState: needsInformationState,
    phoneDisplay: phoneDisplay,
    emailDisplay: emailDisplay,
    phoneHref: phoneHref,
    emailHref: emailHref,
    appIdEnc: appIdEnc,
    canPhase5Approve: canPhase5Approve,
    decisionApproveHref: decisionApproveHref,
    decisionRejectHref: decisionRejectHref,
    displayOrMissing: displayOrMissing,
    labelStatus: labelStatus
  }) %>

  <div class="bb-pa-reg-hub__layout">
    <div class="bb-pa-reg-hub__main">
      <section class="bb-pa-panel bb-pa-reg-hub__card" aria-labelledby="reg-hub-church-title" data-bb-pa-reg-hub-church="1">
        <h2 id="reg-hub-church-title" class="bb-pa-section-title">Church information</h2>
        <dl class="bb-pa-dl">
          <% if (displayOrMissing(app.churchName)) { %>
          <div>
            <dt>Church name</dt>
            <dd><%= app.churchName %></dd>
          </div>
          <% } %>
          <% if (phase5Location) { %>
          <div>
            <dt>Location</dt>
            <dd data-bb-pa-reg-hub-location="1"><%= phase5Location %></dd>
          </div>
          <% } else { %>
            <% if (cityVal) { %>
            <div>
              <dt>Town or city</dt>
              <dd><%= cityVal %></dd>
            </div>
            <% } %>
            <% if (countryVal) { %>
            <div>
              <dt>Country</dt>
              <dd><%= countryVal %></dd>
            </div>
            <% } %>
          <% } %>
          <% if (branchCountVal) { %>
          <div>
            <dt>Expected branches</dt>
            <dd data-bb-pa-reg-hub-branch-count="1"><%= branchCountVal %></dd>
          </div>
          <% } %>
          <% if (planLabel) { %>
          <div>
            <dt>Selected plan</dt>
            <dd><%= planLabel %></dd>
          </div>
          <% } %>
        </dl>
      </section>

      <section class="bb-pa-panel bb-pa-reg-hub__card" aria-labelledby="reg-hub-contact-title" data-bb-pa-reg-hub-contact="1">
        <h2 id="reg-hub-contact-title" class="bb-pa-section-title">Main contact</h2>
        <dl class="bb-pa-dl">
          <% if (displayOrMissing(app.contactName)) { %>
          <div>
            <dt>Contact name</dt>
            <dd data-bb-pa-reg-overview-applicant="1"><%= app.contactName %></dd>
          </div>
          <% } %>
          <% if (roleVal) { %>
          <div>
            <dt>Position or role</dt>
            <dd data-bb-pa-reg-hub-role="1"><%= roleVal %></dd>
          </div>
          <% } %>
          <% if (phoneDisplay) { %>
          <div>
            <dt>Phone</dt>
            <dd class="bb-pa-reg-hub__contact-value" data-bb-pa-reg-hub-phone="1">
              <% if (phoneHref) { %>
              <a class="bb-pa-link bb-pa-reg-hub__tap" href="<%= phoneHref %>" data-bb-pa-reg-hub-call="1"><%= phoneDisplay %></a>
              <% } else { %>
              <%= phoneDisplay %>
              <% } %>
            </dd>
          </div>
          <% } %>
          <% if (emailDisplay) { %>
          <div>
            <dt>Email</dt>
            <dd class="bb-pa-reg-hub__contact-value bb-pa-reg-hub__email" data-bb-pa-reg-hub-email="1">
              <% if (emailHref) { %>
              <a class="bb-pa-link bb-pa-reg-hub__tap" href="<%= emailHref %>" data-bb-pa-reg-hub-mailto="1"><%= emailDisplay %></a>
              <% } else { %>
              <%= emailDisplay %>
              <% } %>
            </dd>
          </div>
          <% } %>
        </dl>
        <div class="bb-pa-reg-hub__contact-actions">
          <% if (phoneHref) { %>
          <a class="bb-pa-btn bb-pa-btn--secondary bb-pa-btn--sm" href="<%= phoneHref %>" data-bb-pa-reg-hub-call-btn="1">Call</a>
          <% } %>
          <% if (emailHref) { %>
          <a class="bb-pa-btn bb-pa-btn--secondary bb-pa-btn--sm" href="<%= emailHref %>" data-bb-pa-reg-hub-email-btn="1">Email</a>
          <% } %>
          <% if (phoneDisplay) { %>
          <button
            type="button"
            class="bb-pa-btn bb-pa-btn--secondary bb-pa-btn--sm"
            data-bb-pa-reg-hub-copy-phone="1"
            data-phone="<%= phoneDisplay %>"
          >Copy phone number</button>
          <% } %>
        </div>
      </section>

      <% if (messageVal) { %>
      <section class="bb-pa-panel bb-pa-reg-hub__card" aria-labelledby="reg-hub-message-title" data-bb-pa-reg-hub-message="1">
        <h2 id="reg-hub-message-title" class="bb-pa-section-title">Applicant message</h2>
        <p class="bb-pa-reg-hub__message-body"><%= messageVal %></p>
      </section>
      <% } %>

      <% if (reviewNotesVal) { %>
      <section class="bb-pa-panel bb-pa-reg-hub__card" aria-labelledby="reg-hub-notes-title" data-bb-pa-reg-hub-notes="1">
        <h2 id="reg-hub-notes-title" class="bb-pa-section-title">Internal review note</h2>
        <p class="bb-pa-reg-hub__message-body"><%= reviewNotesVal %></p>
        <p class="bb-pa-hint">Existing reviewer note. Saving notes is part of later action workflows.</p>
      </section>
      <% } %>
    </div>

    <aside
      class="bb-pa-panel bb-pa-reg-hub__decision"
      aria-labelledby="reg-hub-decision-title"
      data-bb-pa-reg-hub-decision="1"
      id="reg-hub-decision"
    >
      <h2 id="reg-hub-decision-title" class="bb-pa-section-title">Take action</h2>
      <p class="bb-pa-hint">
        Approve opens confirmation. Request information opens the Phase 5 request form.
      </p>
      <div class="bb-pa-reg-hub__decision-actions">
        <% if (canPhase5Approve && decisionApproveHref) { %>
        <a
          class="bb-pa-btn bb-pa-btn--primary bb-pa-btn--block"
          href="<%= decisionApproveHref %>"
          data-bb-pa-phase5-decision="approve"
        >Approve and create church</a>
        <% } else if (showOrgDecision) { %>
        <a
          class="bb-pa-btn bb-pa-btn--primary bb-pa-btn--block"
          href="<%= organizationHref %>"
          data-bb-pa-phase5-decision="open-organization"
        >Open organization</a>
        <% } %>
        <a
          class="bb-pa-btn bb-pa-btn--secondary bb-pa-btn--block"
          href="<%= decisionRequestHref %>"
          data-bb-pa-phase5-decision="request-information"
        >Request information</a>
        <% if (canPhase5Reject) { %>
        <a
          class="bb-pa-btn bb-pa-btn--danger bb-pa-btn--block"
          href="<%= decisionRejectHref %>"
          data-bb-pa-phase5-decision="reject"
        >Reject registration</a>
        <% } else if (isPhase5Rejected) { %>
        <a
          class="bb-pa-btn bb-pa-btn--secondary bb-pa-btn--block"
          href="<%= decisionRejectHref %>"
          data-bb-pa-phase5-decision="view-rejection"
        >View rejection</a>
        <% } %>
      </div>
    </aside>
  </div>

  <div class="bb-pa-reg-hub__mobile-decision" data-bb-pa-reg-hub-mobile-decision="1">
    <% if (canPhase5Approve && decisionApproveHref) { %>
    <a class="bb-pa-btn bb-pa-btn--primary" href="<%= decisionApproveHref %>" data-bb-pa-phase5-decision-mobile="approve">Approve</a>
    <% } else if (showOrgDecision) { %>
    <a class="bb-pa-btn bb-pa-btn--primary" href="<%= organizationHref %>" data-bb-pa-phase5-decision-mobile="open-organization">Organization</a>
    <% } %>
    <a class="bb-pa-btn bb-pa-btn--secondary" href="<%= decisionRequestHref %>" data-bb-pa-phase5-decision-mobile="request-information">Request info</a>
    <% if (canPhase5Reject) { %>
    <a class="bb-pa-btn bb-pa-btn--danger" href="<%= decisionRejectHref %>" data-bb-pa-phase5-decision-mobile="reject">Reject</a>
    <% } else if (isPhase5Rejected) { %>
    <a class="bb-pa-btn bb-pa-btn--secondary" href="<%= decisionRejectHref %>" data-bb-pa-phase5-decision-mobile="view-rejection">Rejection</a>
    <% } %>
  </div>

  <details
    class="bb-pa-panel bb-pa-reg-hub__secondary"
    data-bb-pa-reg-secondary="1"
    id="reg-additional-details"
    <%= secondaryOpen ? ' open' : '' %>
  >
    <summary class="bb-pa-reg-hub__secondary-summary">Additional review details</summary>
    <div class="bb-pa-reg-hub__secondary-body" data-bb-pa-reg-secondary-body="1">
      <%- include('../partials/pa-registration-detail-secondary') %>
    </div>
  </details>
</section>

<script>
(function () {
  var btn = document.querySelector('[data-bb-pa-reg-hub-copy-phone="1"]');
  if (!btn || !navigator.clipboard || !navigator.clipboard.writeText) return;
  btn.addEventListener('click', function () {
    var phone = btn.getAttribute('data-phone') || '';
    if (!phone) return;
    navigator.clipboard.writeText(phone).catch(function () {});
  });
})();
</script>

