<%- include('../partials/platform-admin-shell-start') %>
<%
  var rows = applications || [];
  var limits = allowedLimits || [10, 25, 50, 100];
  var f = filters || {};
  var queues = queueFilters || [];
  var totalCount = typeof total !== 'undefined' ? Number(total) || 0 : 0;
  var listError = typeof listError !== 'undefined' && listError;
  var appStatuses = applicationStatuses || ['submitted', 'duplicate_review', 'rejected', 'cancelled', 'closed'];
  var provStatuses = provisioningStatuses || ['not_started', 'provisioning', 'provisioned', 'provisioning_failed'];
  var followStatuses = followUpStatuses || [];
  var linkedOpts = linkedFilters || ['all', 'linked', 'unlinked'];
  var rq = (typeof registrationQueue !== 'undefined' && registrationQueue) ? registrationQueue : null;
  var visibleStatusSelected = rq && rq.resolveSelectedVisibleStatus
    ? rq.resolveSelectedVisibleStatus(f, typeof visibleStatus !== 'undefined' ? visibleStatus : '')
    : '';
  var phase5StatusFilters = (rq && rq.PHASE5_STATUS_FILTERS) ? rq.PHASE5_STATUS_FILTERS : [
    { key: '', label: 'All statuses' },
    { key: 'new', label: 'New' },
    { key: 'needs_information', label: 'Needs Information' },
    { key: 'approved', label: 'Approved' },
    { key: 'rejected', label: 'Rejected' }
  ];

  function statusLabel(kind, value) {
    if (typeof registrationStatus !== 'undefined' && registrationStatus && registrationStatus.presentRegistrationStatus) {
      return registrationStatus.presentRegistrationStatus(kind, value).label;
    }
    return String(value || '').replace(/_/g, ' ') || '—';
  }
  function followLabel(value) {
    return String(value || '').replace(/_/g, ' ');
  }
  function fmtDate(d) {
    if (rq && rq.formatRegistrationDate) return rq.formatRegistrationDate(d);
    if (!d) return '—';
    try {
      return new Date(d).toISOString().slice(0, 10);
    } catch (e) {
      return '—';
    }
  }
  function fmtLocation(row) {
    if (rq && rq.formatRegistrationLocation) return rq.formatRegistrationLocation(row);
    var city = row && row.city ? String(row.city) : '';
    var country = row && row.country ? String(row.country) : '';
    if (city && country) return city + ', ' + country;
    return city || country || '—';
  }
  function phase5Status(row) {
    if (rq && rq.presentPhase5QueueStatus) return rq.presentPhase5QueueStatus(row);
    return { key: 'new', label: 'New', tone: 'warn', chipClass: 'bb-pa-chip--warn' };
  }
  function reviewAction(row) {
    if (rq && rq.presentPhase5QueueAction) return rq.presentPhase5QueueAction(row);
    return {
      label: 'Review',
      href: row && row.id ? ('/admin/registration-applications/' + encodeURIComponent(row.id)) : null
    };
  }
  function pushFilter(parts, key, value) {
    if (value != null && String(value) !== '') {
      parts.push(key + '=' + encodeURIComponent(String(value)));
    }
  }
  function queryPage(p) {
    var parts = ['page=' + encodeURIComponent(p), 'limit=' + encodeURIComponent(limit)];
    pushFilter(parts, 'q', f.q);
    pushFilter(parts, 'visible_status', visibleStatusSelected);
    pushFilter(parts, 'queue', f.queue);
    pushFilter(parts, 'selected_plan', f.selectedPlan);
    pushFilter(parts, 'application_status', f.applicationStatus);
    pushFilter(parts, 'provisioning_status', f.provisioningStatus);
    pushFilter(parts, 'follow_up_status', f.followUpStatus);
    pushFilter(parts, 'from', f.from);
    pushFilter(parts, 'to', f.to);
    pushFilter(parts, 'support_requested', f.supportRequested);
    pushFilter(parts, 'requires_review', f.requiresReview);
    pushFilter(parts, 'overdue_follow_up', f.overdueFollowUp);
    if (f.linked && f.linked !== 'all') pushFilter(parts, 'linked', f.linked);
    return '/admin/registration-applications?' + parts.join('&');
  }
  function clearHref() {
    return '/admin/registration-applications';
  }
  var hasActiveFilters = Boolean(
    (f.q && String(f.q).trim()) ||
    (visibleStatusSelected && String(visibleStatusSelected).trim()) ||
    (f.queue && String(f.queue).trim()) ||
    (f.selectedPlan && String(f.selectedPlan).trim()) ||
    (f.applicationStatus && String(f.applicationStatus).trim()) ||
    (f.provisioningStatus && String(f.provisioningStatus).trim()) ||
    (f.followUpStatus && String(f.followUpStatus).trim()) ||
    (f.from && String(f.from).trim()) ||
    (f.to && String(f.to).trim()) ||
    f.supportRequested === 'true' || f.supportRequested === 'false' ||
    f.requiresReview === 'true' ||
    f.overdueFollowUp === 'true' ||
    (f.linked && f.linked !== 'all' && String(f.linked).trim())
  );
  var moreFiltersOpen = Boolean(
    (f.queue && String(f.queue).trim()) ||
    (f.applicationStatus && String(f.applicationStatus).trim()) ||
    (f.provisioningStatus && String(f.provisioningStatus).trim()) ||
    (f.followUpStatus && String(f.followUpStatus).trim() && visibleStatusSelected !== 'needs_information') ||
    (f.from && String(f.from).trim()) ||
    (f.to && String(f.to).trim()) ||
    f.supportRequested === 'true' || f.supportRequested === 'false' ||
    f.requiresReview === 'true' ||
    f.overdueFollowUp === 'true' ||
    (f.linked && f.linked !== 'all')
  );
%>

<section
  class="bb-pa-orgs bb-pa-reg-ops bb-pa-reg-queue"
  data-bb-pa-registration-applications="1"
  data-bb-pa-reg-phase5-queue="1"
  data-bb-pa-reg-list-error="<%= listError ? '1' : '0' %>"
  data-bb-pa-reg-has-filters="<%= hasActiveFilters ? '1' : '0' %>"
  aria-label="Church registrations"
>
  <header class="bb-pa-page-head bb-pa-page-head--split">
    <div>
      <h1 class="bb-pa-page-head__title">Church Registrations</h1>
      <p class="bb-pa-lede">
        Review and manage churches applying to join BlessBoard.
      </p>
      <p class="bb-pa-hint" data-bb-pa-reg-queue-new-hint="1">
        Status filter <strong>New</strong> shows the needs-review operator queue (open registrations awaiting a decision).
      </p>
    </div>
    <% if (!listError && totalCount > 0) { %>
    <p class="bb-pa-page-head__actions">
      <span class="bb-pa-orgs__total" data-bb-count="registration-total"><%= totalCount %></span>
      <span class="bb-pa-orgs__total-label"><%= totalCount === 1 ? 'registration' : 'registrations' %></span>
    </p>
    <% } %>
  </header>

  <% if (listError) { %>
  <%- include('../partials/error-state', {
    title: 'Unable to load registrations',
    body: 'Church registrations could not be loaded right now. Try again in a moment.',
    actionHref: '/admin/registration-applications',
    actionLabel: 'Retry'
  }) %>
  <% } else { %>

  <form
    class="bb-pa-org-filter bb-pa-reg-filter"
    method="get"
    action="/admin/registration-applications"
    role="search"
    data-bb-pa-reg-filter="1"
  >
    <div class="bb-pa-field bb-pa-field--search">
      <label for="q">Search</label>
      <input
        id="q"
        name="q"
        type="search"
        value="<%= f.q || '' %>"
        placeholder="Church, contact, email, or phone"
        autocomplete="off"
        data-bb-pa-reg-filter-field="q"
      />
    </div>
    <div class="bb-pa-field">
      <label for="visible_status">Status</label>
      <select
        id="visible_status"
        name="visible_status"
        data-bb-pa-reg-visible-status="1"
        data-bb-pa-reg-filter-field="visible_status"
      >
        <% phase5StatusFilters.forEach(function (opt) { %>
        <option value="<%= opt.key %>"<%= visibleStatusSelected === opt.key ? ' selected' : '' %>><%= opt.label %></option>
        <% }) %>
      </select>
    </div>
    <div class="bb-pa-field">
      <label for="selected_plan">Plan</label>
      <select id="selected_plan" name="selected_plan" data-bb-pa-reg-plan-filter="1" data-bb-pa-reg-filter-field="selected_plan">
        <option value="">All plans</option>
        <% (allowedPlans || ['foundation', 'growth', 'network']).forEach(function (p) { %>
        <option value="<%= p %>"<%= f.selectedPlan === p ? ' selected' : '' %>>
          <%= p === 'network' ? 'Network' : (p === 'foundation' ? 'Foundation' : (p === 'growth' ? 'Growth' : p)) %>
        </option>
        <% }) %>
      </select>
    </div>
    <div class="bb-pa-field">
      <label for="limit">Per page</label>
      <select id="limit" name="limit" data-bb-pa-reg-filter-field="limit">
        <% limits.forEach(function (n) { %>
        <option value="<%= n %>"<%= Number(limit) === Number(n) ? ' selected' : '' %>><%= n %></option>
        <% }) %>
      </select>
    </div>

    <details class="bb-pa-reg-filter__more" data-bb-pa-reg-filter-more="1"<%= moreFiltersOpen ? ' open' : '' %>>
      <summary>More filters</summary>
      <div class="bb-pa-reg-filter__more-grid">
        <div class="bb-pa-field">
          <label for="queue">Operator queue</label>
          <select id="queue" name="queue" data-bb-pa-reg-queue="1" data-bb-pa-reg-filter-field="queue">
            <% queues.forEach(function (q) { %>
            <option value="<%= q.key %>"<%= (f.queue || '') === q.key ? ' selected' : '' %>><%= q.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="bb-pa-field">
          <label for="application_status">Application status</label>
          <select
            id="application_status"
            name="application_status"
            data-bb-pa-reg-filter-field="application_status"
          >
            <option value="">All</option>
            <% appStatuses.forEach(function (s) { %>
            <option value="<%= s %>"<%= f.applicationStatus === s ? ' selected' : '' %>><%= statusLabel('application', s) %></option>
            <% }) %>
          </select>
        </div>
        <div class="bb-pa-field">
          <label for="provisioning_status">Provisioning status</label>
          <select
            id="provisioning_status"
            name="provisioning_status"
            data-bb-pa-reg-filter-field="provisioning_status"
          >
            <option value="">All</option>
            <% provStatuses.forEach(function (s) { %>
            <option value="<%= s %>"<%= f.provisioningStatus === s ? ' selected' : '' %>><%= statusLabel('provisioning', s) %></option>
            <% }) %>
          </select>
        </div>
        <div class="bb-pa-field">
          <label for="follow_up_status">Follow-up status</label>
          <select
            id="follow_up_status"
            name="follow_up_status"
            data-bb-pa-reg-filter-field="follow_up_status"
          >
            <option value="">All</option>
            <% followStatuses.forEach(function (s) { %>
            <option value="<%= s %>"<%= f.followUpStatus === s ? ' selected' : '' %>><%= followLabel(s) %></option>
            <% }) %>
          </select>
        </div>
        <div class="bb-pa-field">
          <label for="from">Submitted from</label>
          <input id="from" name="from" type="date" value="<%= f.from || '' %>" data-bb-pa-reg-filter-field="from" />
        </div>
        <div class="bb-pa-field">
          <label for="to">Submitted to</label>
          <input id="to" name="to" type="date" value="<%= f.to || '' %>" data-bb-pa-reg-filter-field="to" />
        </div>
        <div class="bb-pa-field">
          <label for="support_requested">Support requested</label>
          <select
            id="support_requested"
            name="support_requested"
            data-bb-pa-reg-filter-field="support_requested"
          >
            <option value="">All</option>
            <option value="true"<%= f.supportRequested === 'true' ? ' selected' : '' %>>Yes</option>
            <option value="false"<%= f.supportRequested === 'false' ? ' selected' : '' %>>No</option>
          </select>
        </div>
        <div class="bb-pa-field">
          <label for="requires_review">Requires review</label>
          <select
            id="requires_review"
            name="requires_review"
            data-bb-pa-reg-filter-field="requires_review"
          >
            <option value="">All</option>
            <option value="true"<%= f.requiresReview === 'true' ? ' selected' : '' %>>Yes</option>
          </select>
        </div>
        <div class="bb-pa-field">
          <label for="overdue_follow_up">Overdue follow-up</label>
          <select
            id="overdue_follow_up"
            name="overdue_follow_up"
            data-bb-pa-reg-filter-field="overdue_follow_up"
          >
            <option value="">All</option>
            <option value="true"<%= f.overdueFollowUp === 'true' ? ' selected' : '' %>>Yes</option>
          </select>
        </div>
        <div class="bb-pa-field">
          <label for="linked">Linked status</label>
          <select id="linked" name="linked" data-bb-pa-reg-filter-field="linked">
            <% linkedOpts.forEach(function (opt) { %>
            <option value="<%= opt %>"<%= (f.linked || 'all') === opt ? ' selected' : '' %>>
              <%= opt === 'all' ? 'All' : (opt === 'linked' ? 'Linked' : 'Unlinked') %>
            </option>
            <% }) %>
          </select>
        </div>
      </div>
    </details>

    <div class="bb-pa-org-filter__actions bb-pa-reg-filter__actions">
      <button class="bb-pa-btn bb-pa-btn--primary" type="submit">Apply</button>
      <% if (hasActiveFilters) { %>
      <a
        class="bb-pa-btn bb-pa-btn--secondary"
        href="<%= clearHref() %>"
        data-bb-pa-reg-clear-filters="1"
      >Clear filters</a>
      <% } %>
    </div>
  </form>

  <% if (!rows.length) { %>
    <% if (hasActiveFilters) { %>
    <%- include('../partials/empty-state', {
      title: 'No registrations match these filters',
      body: 'Try adjusting search or filters, or clear filters to see the full queue.',
      actionHref: clearHref(),
      actionLabel: 'Clear filters',
      className: 'bb-pa-reg-no-results',
      icon: 'search'
    }) %>
    <div hidden data-bb-pa-reg-state="no-results"></div>
    <% } else { %>
    <%- include('../partials/empty-state', {
      title: 'No church registrations yet',
      body: 'When churches submit the public registration form, their applications will appear here for review.',
      actionHref: '/admin',
      actionLabel: 'Return to Dashboard',
      className: 'bb-pa-reg-empty',
      icon: 'church'
    }) %>
    <div hidden data-bb-pa-reg-state="empty"></div>
    <% } %>
  <% } else { %>
  <div class="bb-pa-table-wrap bb-pa-orgs-table-wrap bb-pa-reg-queue__table-wrap" data-bb-pa-reg-table="1">
    <table class="bb-pa-table bb-pa-reg-queue__table">
      <thead>
        <tr>
          <th scope="col">Church name</th>
          <th scope="col">Location</th>
          <th scope="col">Contact person</th>
          <th scope="col">Phone</th>
          <th scope="col">Plan</th>
          <th scope="col">Date</th>
          <th scope="col">Status</th>
          <th scope="col">Action</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (row) {
          var st = phase5Status(row);
          var act = reviewAction(row);
        %>
        <tr
          data-bb-operator-queue="<%= row.operatorQueue || '' %>"
          data-bb-display-status="<%= st.label %>"
          data-bb-phase5-status="<%= st.key %>"
          data-bb-recommended-action="<%= row.recommendedAction || '' %>"
        >
          <td>
            <a class="bb-pa-link bb-pa-reg-queue__church" href="<%= act.href || ('/admin/registration-applications/' + row.id) %>"><%= row.churchName %></a>
          </td>
          <td><%= fmtLocation(row) %></td>
          <td><%= row.contactName || '—' %></td>
          <td><%= row.contactPhoneNormalized || row.contactPhone || '—' %></td>
          <td>
            <span data-bb-pa-plan-badge="<%= String(row.selectedPlan || '').toLowerCase() %>"><%= row.selectedPlanLabel || row.selectedPlan || '—' %></span>
          </td>
          <td><%= fmtDate(row.createdAt) %></td>
          <td>
            <span
              class="bb-pa-chip <%= st.chipClass %>"
              data-bb-pa-display-status="1"
              data-bb-pa-phase5-status="<%= st.key %>"
            ><%= st.label %></span>
          </td>
          <td>
            <a
              class="bb-pa-btn bb-pa-btn--primary bb-pa-btn--sm"
              href="<%= act.href || ('/admin/registration-applications/' + row.id) %>"
              data-bb-pa-reg-primary="1"
              aria-label="Review registration for <%= row.churchName || 'application' %>"
            >Review</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <ul class="bb-pa-orgs-cards bb-pa-reg-cards bb-pa-reg-queue__cards" data-bb-pa-reg-cards="1">
    <% rows.forEach(function (row) {
      var st = phase5Status(row);
      var act = reviewAction(row);
    %>
    <li
      class="bb-pa-org-card bb-pa-reg-queue__card"
      data-bb-operator-queue="<%= row.operatorQueue || '' %>"
      data-bb-display-status="<%= st.label %>"
      data-bb-phase5-status="<%= st.key %>"
    >
      <div class="bb-pa-reg-queue__card-head">
        <h2 class="bb-pa-reg-queue__card-title">
          <a class="bb-pa-link" href="<%= act.href || ('/admin/registration-applications/' + row.id) %>"><%= row.churchName %></a>
        </h2>
        <span
          class="bb-pa-chip <%= st.chipClass %>"
          data-bb-pa-display-status="1"
          data-bb-pa-phase5-status="<%= st.key %>"
        ><%= st.label %></span>
      </div>
      <dl class="bb-pa-reg-queue__card-meta">
        <div>
          <dt>Location</dt>
          <dd><%= fmtLocation(row) %></dd>
        </div>
        <div>
          <dt>Contact</dt>
          <dd><%= row.contactName || '—' %></dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd><%= row.contactPhoneNormalized || row.contactPhone || '—' %></dd>
        </div>
        <div>
          <dt>Plan</dt>
          <dd data-bb-pa-plan-badge="<%= String(row.selectedPlan || '').toLowerCase() %>"><%= row.selectedPlanLabel || row.selectedPlan || '—' %></dd>
        </div>
        <div>
          <dt>Registered</dt>
          <dd><%= fmtDate(row.createdAt) %></dd>
        </div>
      </dl>
      <p class="bb-pa-reg-card__action">
        <a
          class="bb-pa-btn bb-pa-btn--primary bb-pa-btn--block"
          href="<%= act.href || ('/admin/registration-applications/' + row.id) %>"
          data-bb-pa-reg-primary="1"
          aria-label="Review registration for <%= row.churchName || 'application' %>"
        >Review</a>
      </p>
    </li>
    <% }) %>
  </ul>

  <% if (totalPages > 1) { %>
  <nav class="bb-pa-pager" aria-label="Pagination">
    <p class="bb-pa-pager__summary">Showing <%= rangeFrom %>–<%= rangeTo %> of <%= totalCount %></p>
    <div class="bb-pa-pager__actions">
      <% if (page > 1) { %>
      <a class="bb-pa-btn bb-pa-btn--secondary" href="<%= queryPage(page - 1) %>">Previous</a>
      <% } %>
      <% if (page < totalPages) { %>
      <a class="bb-pa-btn bb-pa-btn--secondary" href="<%= queryPage(page + 1) %>">Next</a>
      <% } %>
    </div>
  </nav>
  <% } %>
  <% } %>
  <% } %>
</section>

<%- include('../partials/platform-admin-shell-end') %>
