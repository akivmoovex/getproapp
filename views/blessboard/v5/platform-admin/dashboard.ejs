<%- include('../partials/platform-admin-shell-start') %>
<%
  var sample = directorySample || [];
  var orgTotal = typeof totalOrganizations !== 'undefined' ? Number(totalOrganizations) || 0 : 0;
  var withChurch = typeof organizationsWithChurch !== 'undefined' ? Number(organizationsWithChurch) || 0 : 0;
  var recentFoundation = typeof recentFoundationRegistrations !== 'undefined' ? Number(recentFoundationRegistrations) || 0 : 0;
  var activeTrials = typeof activeGrowthTrials !== 'undefined' ? Number(activeGrowthTrials) || 0 : 0;
  var trialsEnding = typeof growthTrialsEndingSoon !== 'undefined' ? Number(growthTrialsEndingSoon) || 0 : 0;
  var inGrace = typeof growthSubscriptionsInGrace !== 'undefined' ? Number(growthSubscriptionsInGrace) || 0 : 0;
  var needsReview = typeof registrationsRequiringReview !== 'undefined' ? Number(registrationsRequiringReview) || 0 : 0;
  var networkPending = typeof pendingNetworkSupportRequests !== 'undefined' ? Number(pendingNetworkSupportRequests) || 0 : 0;
  var newRegs = typeof newRegistrations7d !== 'undefined' ? Number(newRegistrations7d) || 0 : 0;
  var provFails = typeof provisioningFailures !== 'undefined' ? Number(provisioningFailures) || 0 : 0;
  var eligibleTrial = typeof foundationEligibleForGrowthTrial !== 'undefined' ? Number(foundationEligibleForGrowthTrial) || 0 : 0;
  var offersPending = typeof growthTrialOffersPending !== 'undefined' ? Number(growthTrialOffersPending) || 0 : 0;
  var foundationTrials = typeof foundationOriginActiveTrials !== 'undefined' ? Number(foundationOriginActiveTrials) || 0 : 0;
  var trialsConsumed = typeof foundationTrialOffersConsumed !== 'undefined' ? Number(foundationTrialOffersConsumed) || 0 : 0;
  var paidGrowth = typeof paidGrowthSubscriptions !== 'undefined' ? Number(paidGrowthSubscriptions) || 0 : 0;
  var netValPending = typeof networkValidationPending !== 'undefined' ? Number(networkValidationPending) || 0 : 0;
  var netValProgress = typeof networkValidationInProgress !== 'undefined' ? Number(networkValidationInProgress) || 0 : 0;
  var netAwaiting = typeof networkAwaitingApplicant !== 'undefined' ? Number(networkAwaitingApplicant) || 0 : 0;
  var netApproved = typeof networkApprovedNotProvisioned !== 'undefined' ? Number(networkApprovedNotProvisioned) || 0 : 0;
  var netOverdue = typeof networkFirstContactOverdue !== 'undefined' ? Number(networkFirstContactOverdue) || 0 : 0;
  var alerts = typeof opsAlerts !== 'undefined' && Array.isArray(opsAlerts) ? opsAlerts : [];
  var alertsPage = typeof opsAlertsPage !== 'undefined' ? Number(opsAlertsPage) || 1 : 1;
  var alertsLimit = typeof opsAlertsLimit !== 'undefined' ? Number(opsAlertsLimit) || 20 : 20;
  var alertsTotal = typeof opsAlertsTotal !== 'undefined' ? Number(opsAlertsTotal) || 0 : 0;
  var alertsTotalPages = typeof opsAlertsTotalPages !== 'undefined' ? Number(opsAlertsTotalPages) || 0 : 0;
  var greetingName = displayName ? String(displayName).split(/\s+/)[0] : '';
  function fmtAlertWhen(d) {
    if (!d) return '';
    try {
      return new Date(d).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
    } catch (e) {
      return '';
    }
  }
  function severityLabel(s) {
    if (s === 'critical') return 'Critical';
    if (s === 'warn') return 'Attention';
    return 'Info';
  }
  var deployLabel = typeof deploymentCode !== 'undefined' && deploymentCode ? String(deploymentCode) : '';
  var desktopQuickActions = [
    { key: 'organizations', label: 'Organizations', href: '/admin/organizations', icon: 'corporate_fare' },
    { key: 'registrations', label: 'Registrations', href: '/admin/registration-applications', icon: 'app_registration' },
    { key: 'subscriptions', label: 'Subscriptions', href: '/admin/subscriptions', icon: 'card_membership' },
    { key: 'plans', label: 'Plans & limits', href: '/admin/plans', icon: 'workspace_premium' }
  ];
  var mobileQuickActions = [
    { key: 'organizations', label: 'Orgs', href: '/admin/organizations', icon: 'corporate_fare' },
    { key: 'registrations', label: 'Apps', href: '/admin/registration-applications', icon: 'app_registration' },
    { key: 'subscriptions', label: 'Subs', href: '/admin/subscriptions', icon: 'card_membership' },
    { key: 'account', label: 'Account', href: '/admin/account', icon: 'person' }
  ];
  var summaryCards = [
    {
      key: 'organizations',
      label: 'Organizations',
      icon: 'corporate_fare',
      href: '/admin/organizations',
      tone: 'accent',
      available: true,
      value: String(orgTotal),
      countAttr: 'organizations-total',
      hint: 'Live provisioned total',
      visibility: 'both'
    },
    {
      key: 'churches',
      label: 'BlessBoard churches',
      icon: 'church',
      href: '/admin/organizations',
      tone: 'ok',
      available: true,
      value: String(withChurch),
      countAttr: 'organizations-with-church',
      hint: 'Linked church catalogue rows',
      visibility: 'both'
    },
    {
      key: 'foundation-recent',
      label: 'Foundation (7 days)',
      icon: 'verified',
      href: '/admin/registration-applications?selected_plan=foundation&linked=linked',
      tone: 'ok',
      available: true,
      value: String(recentFoundation),
      countAttr: 'recent-foundation-registrations',
      hint: 'Recently provisioned Foundation applications',
      visibility: 'both'
    },
    {
      key: 'growth-trials',
      label: 'Active Growth trials',
      icon: 'timelapse',
      href: '/admin/subscriptions?status=trialing&plan=growth',
      tone: 'accent',
      available: true,
      value: String(activeTrials),
      countAttr: 'active-growth-trials',
      hint: 'Live trialing Growth subscriptions',
      visibility: 'both'
    },
    {
      key: 'trials-ending',
      label: 'Trials ending soon',
      icon: 'event_upcoming',
      href: '/admin/subscriptions?status=trialing&plan=growth&ending_soon=true',
      tone: 'warn',
      available: true,
      value: String(trialsEnding),
      countAttr: 'growth-trials-ending-soon',
      hint: 'Trial ends_at within seven days',
      visibility: 'both'
    },
    {
      key: 'growth-grace',
      label: 'Growth in grace',
      icon: 'hourglass_top',
      href: '/admin/subscriptions?status=past_due&plan=growth',
      tone: 'warn',
      available: true,
      value: String(inGrace),
      countAttr: 'growth-in-grace',
      hint: 'past_due Growth with open grace window',
      visibility: 'both'
    },
    {
      key: 'needs-review',
      label: 'Needs review',
      icon: 'fact_check',
      href: '/admin/registration-applications?requires_review=true',
      tone: 'warn',
      available: true,
      value: String(needsReview),
      countAttr: 'registrations-requiring-review',
      hint: 'Applications needing operator attention',
      visibility: 'both'
    },
    {
      key: 'network-support',
      label: 'Network support queue',
      icon: 'support_agent',
      href: '/admin/registration-applications?selected_plan=network&support_requested=true',
      tone: 'warn',
      available: true,
      value: String(networkPending),
      countAttr: 'pending-network-support',
      hint: 'Unlinked Network contact requests',
      visibility: 'both'
    },
    {
      key: 'new-registrations',
      label: 'New registrations (7d)',
      icon: 'fiber_new',
      href: '/admin/registration-applications',
      tone: 'accent',
      available: true,
      value: String(newRegs),
      countAttr: 'new-registrations-7d',
      hint: 'Applications submitted in the last 7 days',
      visibility: 'both'
    },
    {
      key: 'provisioning-failures',
      label: 'Provisioning failures',
      icon: 'error',
      href: '/admin/registration-applications?provisioning_status=provisioning_failed',
      tone: 'warn',
      available: true,
      value: String(provFails),
      countAttr: 'provisioning-failures',
      hint: 'Open these applications and retry or investigate',
      visibility: 'both'
    },
    {
      key: 'eligible-growth-trial',
      label: 'Eligible for Growth trial',
      icon: 'redeem',
      href: '/admin/organizations?plan=free',
      tone: 'ok',
      available: true,
      value: String(eligibleTrial),
      countAttr: 'foundation-eligible-growth-trial',
      hint: 'Foundation orgs with no consumed introductory trial',
      visibility: 'both'
    },
    {
      key: 'offers-pending',
      label: 'Offers pending accept',
      icon: 'mark_email_unread',
      href: '/admin/organizations',
      tone: 'warn',
      available: true,
      value: String(offersPending),
      countAttr: 'growth-trial-offers-pending',
      hint: 'Create or cancel offers from organization detail',
      visibility: 'both'
    },
    {
      key: 'foundation-origin-trials',
      label: 'Foundation-origin trials',
      icon: 'upgrade',
      href: '/admin/subscriptions?status=trialing&plan=growth&trial_source=foundation_trial_offer',
      tone: 'accent',
      available: true,
      value: String(foundationTrials),
      countAttr: 'foundation-origin-active-trials',
      hint: 'Active trials started from a Foundation offer',
      visibility: 'both'
    },
    {
      key: 'trials-consumed',
      label: 'Intro trials consumed',
      icon: 'history',
      href: '/admin/organizations',
      tone: '',
      available: true,
      value: String(trialsConsumed),
      countAttr: 'foundation-trial-consumed',
      hint: 'Organizations that used their introductory trial',
      visibility: 'both'
    },
    {
      key: 'paid-growth',
      label: 'Paid Growth',
      icon: 'paid',
      href: '/admin/subscriptions?status=active&plan=growth',
      tone: 'ok',
      available: true,
      value: String(paidGrowth),
      countAttr: 'paid-growth',
      hint: 'Active Growth with paid marker or open-ended window',
      visibility: 'both'
    },
    {
      key: 'network-validation-pending',
      label: 'Network validation pending',
      icon: 'pending_actions',
      href: '/admin/registration-applications?selected_plan=network&follow_up_status=validation_pending',
      tone: 'warn',
      available: true,
      value: String(netValPending),
      countAttr: 'network-validation-pending',
      hint: 'Assign an owner and make first contact',
      visibility: 'both'
    },
    {
      key: 'network-validation-progress',
      label: 'Network validation in progress',
      icon: 'manage_search',
      href: '/admin/registration-applications?selected_plan=network&follow_up_status=validation_in_progress',
      tone: 'accent',
      available: true,
      value: String(netValProgress),
      countAttr: 'network-validation-in-progress',
      hint: 'Complete the checklist before approval',
      visibility: 'both'
    },
    {
      key: 'network-awaiting',
      label: 'Network awaiting applicant',
      icon: 'hourglass_empty',
      href: '/admin/registration-applications?selected_plan=network&follow_up_status=awaiting_customer',
      tone: 'warn',
      available: true,
      value: String(netAwaiting),
      countAttr: 'network-awaiting-applicant',
      hint: 'Waiting on applicant information',
      visibility: 'both'
    },
    {
      key: 'network-approved',
      label: 'Network approved (not provisioned)',
      icon: 'how_to_reg',
      href: '/admin/registration-applications?selected_plan=network&follow_up_status=approved_for_provision',
      tone: 'ok',
      available: true,
      value: String(netApproved),
      countAttr: 'network-approved-not-provisioned',
      hint: 'Provision the organization, then activate Network separately',
      visibility: 'both'
    },
    {
      key: 'network-overdue',
      label: 'Network contact overdue',
      icon: 'schedule',
      href: '/admin/registration-applications?selected_plan=network&overdue=true',
      tone: 'warn',
      available: true,
      value: String(netOverdue),
      countAttr: 'network-first-contact-overdue',
      hint: 'Next follow-up date is in the past',
      visibility: 'both'
    }
  ];
%>

<section
  class="bb-pa-dash"
  data-bb-pa-dashboard="1"
  data-bb-stitch-dashboard="62-platform-admin-dashboard"
  aria-label="Platform admin dashboard"
>
  <header class="bb-pa-dash__hero">
    <div class="bb-pa-dash__welcome" data-bb-dash-welcome="1">
      <p class="bb-pa-dash__eyebrow">Platform overview</p>
      <h1 class="bb-pa-dash__title">System Overview</h1>
      <p class="bb-pa-dash__lede">
        Welcome<% if (greetingName) { %>, <%= greetingName %><% } %>.
        Apex command center for BlessBoard V5.
        Only live organization and registration-operations counts are shown here —
        subscription revenue, system health scores, and invented ticket queues are not.
      </p>
      <p class="bb-pa-dash__role">
        Signed in as <span class="bb-pa-role" data-bb-pa-role="1"><%= roleLabel || 'Platform admin' %></span>
        <% if (deployLabel) { %>
        · <span data-bb-pa-deployment="1"><%= deployLabel %></span>
        <% } %>
      </p>
      <a class="bb-pa-btn bb-pa-dash__hero-cta" href="/admin/organizations">
        Browse organizations
      </a>
    </div>
  </header>

  <section
    class="bb-pa-dash__notices"
    aria-labelledby="bb-pa-dash-notices-heading"
    data-bb-dash-notices="1"
    data-bb-pa-ops-alerts="1"
  >
    <div class="bb-pa-dash-panel__head">
      <h2 id="bb-pa-dash-notices-heading" class="bb-pa-dash-panel__title">Registration operations alerts</h2>
      <% if (alertsTotal > 0) { %>
      <span class="bb-pa-chip" data-bb-pa-ops-alerts-total="<%= alertsTotal %>"><%= alertsTotal %> open</span>
      <% } %>
    </div>
    <p class="bb-pa-hint">
      Derived from live registration, subscription, and audit records — not an email or ticket inbox.
      Sensitive fields are omitted. Open an alert to continue in the existing admin screens.
    </p>
    <% if (!alerts.length) { %>
    <div class="bb-pa-dash-empty" role="status" data-bb-dash-empty="notices" data-bb-pa-ops-alerts-empty="1">
      <span class="material-symbols-outlined" aria-hidden="true">notifications_none</span>
      <p>
        No registration operations alerts right now.
        <% if (deployLabel) { %>
        Current deployment: <strong><%= deployLabel %></strong>.
        <% } %>
      </p>
    </div>
    <% } else { %>
    <ul class="bb-pa-ops-alerts" data-bb-pa-ops-alerts-list="1">
      <% alerts.forEach(function (alert) { %>
      <li
        class="bb-pa-ops-alert bb-pa-ops-alert--<%= alert.severity || 'info' %>"
        data-bb-pa-ops-alert="1"
        data-bb-pa-ops-alert-key="<%= alert.alertKey %>"
        data-bb-pa-ops-alert-type="<%= alert.eventType %>"
      >
        <a class="bb-pa-ops-alert__link" href="<%= alert.href %>">
          <span class="bb-pa-ops-alert__meta">
            <span class="bb-pa-chip"><%= severityLabel(alert.severity) %></span>
            <% if (alert.occurredAt) { %>
            <time datetime="<%= new Date(alert.occurredAt).toISOString() %>"><%= fmtAlertWhen(alert.occurredAt) %></time>
            <% } %>
          </span>
          <strong class="bb-pa-ops-alert__title"><%= alert.title %></strong>
          <span class="bb-pa-ops-alert__summary"><%= alert.summary %></span>
          <% if (alert.entityLabel) { %>
          <span class="bb-pa-ops-alert__entity"><%= alert.entityLabel %></span>
          <% } %>
        </a>
      </li>
      <% }) %>
    </ul>
    <% if (alertsTotalPages > 1) { %>
    <nav class="bb-pa-ops-alerts__pager" aria-label="Operations alerts pages" data-bb-pa-ops-alerts-pager="1">
      <% if (alertsPage > 1) { %>
      <a class="bb-pa-link" href="/admin?alerts_page=<%= alertsPage - 1 %>&alerts_limit=<%= alertsLimit %>">Previous</a>
      <% } %>
      <span>Page <%= alertsPage %> of <%= alertsTotalPages %></span>
      <% if (alertsPage < alertsTotalPages) { %>
      <a class="bb-pa-link" href="/admin?alerts_page=<%= alertsPage + 1 %>&alerts_limit=<%= alertsLimit %>">Next</a>
      <% } %>
    </nav>
    <% } %>
    <% } %>
  </section>

  <section
    class="bb-pa-dash-stats"
    aria-labelledby="bb-pa-dash-stats-heading"
    data-bb-dash-stats="1"
    data-bb-pa-summary="1"
  >
    <h2 id="bb-pa-dash-stats-heading" class="bb-pa-sr-only">Summary</h2>
    <div class="bb-pa-dash-stats__grid">
      <% summaryCards.forEach(function (card) {
        var visClass = card.visibility === 'desktop'
          ? ' bb-pa-dash-stat--desktop-only'
          : (card.visibility === 'mobile' ? ' bb-pa-dash-stat--mobile-only' : '');
        var className = 'bb-pa-dash-stat bb-pa-dash-stat--' + card.tone + visClass;
        var availAttr = card.available ? '1' : '0';
      %>
      <% if (card.href) { %>
      <a
        class="<%= className %> bb-pa-dash-stat--link<%= card.available ? '' : ' is-unavailable' %>"
        href="<%= card.href %>"
        data-bb-dash-stat="<%= card.key %>"
        data-bb-dash-stat-available="<%= availAttr %>"
      >
        <span class="bb-pa-dash-stat__icon" aria-hidden="true">
          <span class="material-symbols-outlined"><%= card.icon %></span>
        </span>
        <span class="bb-pa-dash-stat__label"><%= card.label %></span>
        <% if (card.available) { %>
        <strong class="bb-pa-dash-stat__value" data-bb-count="<%= card.countAttr %>"><%= card.value %></strong>
        <% } else { %>
        <strong class="bb-pa-dash-stat__value" aria-hidden="true"><%= card.value %></strong>
        <% } %>
        <span class="bb-pa-dash-stat__hint"><%= card.hint %></span>
      </a>
      <% } else { %>
      <article
        class="<%= className %> is-unavailable"
        data-bb-dash-stat="<%= card.key %>"
        data-bb-dash-stat-available="<%= availAttr %>"
        aria-disabled="true"
      >
        <span class="bb-pa-dash-stat__icon" aria-hidden="true">
          <span class="material-symbols-outlined"><%= card.icon %></span>
        </span>
        <span class="bb-pa-dash-stat__label"><%= card.label %></span>
        <strong class="bb-pa-dash-stat__value" aria-hidden="true"><%= card.value %></strong>
        <span class="bb-pa-dash-stat__hint"><%= card.hint %></span>
      </article>
      <% } %>
      <% }) %>
    </div>
  </section>

  <%
    var analytics = typeof registrationAnalytics !== 'undefined' ? registrationAnalytics : null;
    var analyticsRanges = typeof analyticsAllowedRanges !== 'undefined' ? analyticsAllowedRanges : [7, 30, 90];
    var analyticsDays = analytics && analytics.window ? analytics.window.rangeDays : (typeof analyticsDefaultRange !== 'undefined' ? analyticsDefaultRange : 7);
    var m = analytics && analytics.metrics ? analytics.metrics : null;
    function fmtWindowDay(iso) {
      if (!iso) return '';
      try { return new Date(iso).toISOString().slice(0, 10); } catch (e) { return ''; }
    }
  %>
  <section
    class="bb-pa-dash-panel"
    aria-labelledby="bb-pa-dash-analytics-heading"
    data-bb-pa-registration-analytics="1"
    data-bb-analytics-timezone="UTC"
  >
    <div class="bb-pa-dash-panel__head">
      <h2 id="bb-pa-dash-analytics-heading" class="bb-pa-dash-panel__title">Registration &amp; onboarding analytics</h2>
      <form class="bb-pa-inline-form" method="get" action="/admin" data-bb-pa-analytics-range-form="1">
        <label for="analytics_range">Window</label>
        <select id="analytics_range" name="analytics_range" data-bb-pa-analytics-range="1">
          <% analyticsRanges.forEach(function (d) { %>
          <option value="<%= d %>"<%= Number(analyticsDays) === Number(d) ? ' selected' : '' %>><%= d %> days</option>
          <% }) %>
        </select>
        <button class="bb-pa-btn bb-pa-btn--secondary" type="submit">Apply</button>
      </form>
    </div>
    <p class="bb-pa-hint">
      Aggregate operational counts only (UTC). No contact names, emails, phones, notes, cookies, or third-party trackers.
      <% if (analytics && analytics.window) { %>
      Window: <%= fmtWindowDay(analytics.window.rangeStart) %> → <%= fmtWindowDay(analytics.window.rangeEndExclusive) %> (exclusive end) · <%= analytics.window.timezone %>.
      <% } %>
    </p>
    <% if (!analytics || !m) { %>
    <div class="bb-pa-dash-empty" role="status" data-bb-pa-analytics-empty="unavailable">
      <p>Analytics are temporarily unavailable.</p>
    </div>
    <% } else if (analytics.empty) { %>
    <div class="bb-pa-dash-empty" role="status" data-bb-pa-analytics-empty="1">
      <span class="material-symbols-outlined" aria-hidden="true">insights</span>
      <p>No registration or onboarding activity in this window yet.</p>
    </div>
    <% } else { %>
    <dl class="bb-pa-dl bb-pa-analytics-grid" data-bb-pa-analytics-metrics="1">
      <div data-bb-pa-metric="submissions_by_plan">
        <dt><%= m.submissionsByPlan.label %></dt>
        <dd>
          <% m.submissionsByPlan.values.forEach(function (row, idx) { %>
          <span data-bb-pa-plan="<%= row.plan %>" data-bb-count="analytics-submissions-<%= row.plan %>"><%= row.planLabel %>: <%= row.count %></span><% if (idx < m.submissionsByPlan.values.length - 1) { %> · <% } %>
          <% }) %>
          <div class="bb-pa-muted">Total: <span data-bb-count="analytics-submissions-total"><%= m.submissionsByPlan.total %></span></div>
        </dd>
      </div>
      <div data-bb-pa-metric="registration_completion_rate">
        <dt><%= m.registrationCompletionRate.label %></dt>
        <dd>
          <% if (m.registrationCompletionRate.valuePercent == null) { %>
          <span data-bb-count="analytics-completion-rate">—</span>
          <div class="bb-pa-muted">No Foundation/Growth submissions in window</div>
          <% } else { %>
          <span data-bb-count="analytics-completion-rate"><%= m.registrationCompletionRate.valuePercent %>%</span>
          <div class="bb-pa-muted"><%= m.registrationCompletionRate.numerator %> / <%= m.registrationCompletionRate.denominator %> provisioned</div>
          <% } %>
        </dd>
      </div>
      <div data-bb-pa-metric="auto_provision_outcomes">
        <dt><%= m.autoProvisionOutcomes.label %></dt>
        <dd>
          Success: <span data-bb-count="analytics-provision-success"><%= m.autoProvisionOutcomes.success %></span>
          · Failed: <span data-bb-count="analytics-provision-failed"><%= m.autoProvisionOutcomes.failed %></span>
        </dd>
      </div>
      <div data-bb-pa-metric="review_required">
        <dt><%= m.reviewRequired.label %></dt>
        <dd><span data-bb-count="analytics-review-required"><%= m.reviewRequired.value %></span></dd>
      </div>
      <div data-bb-pa-metric="network_contact_requests">
        <dt><%= m.networkContactRequests.label %></dt>
        <dd><span data-bb-count="analytics-network-contact"><%= m.networkContactRequests.value %></span></dd>
      </div>
      <div data-bb-pa-metric="growth_trial_starts">
        <dt><%= m.growthTrialStarts.label %></dt>
        <dd><span data-bb-count="analytics-growth-trial-starts"><%= m.growthTrialStarts.value %></span></dd>
      </div>
      <div data-bb-pa-metric="growth_trial_conversions" data-bb-pa-metric-available="1">
        <dt><%= m.growthTrialConversions.label %></dt>
        <dd>
          <span data-bb-count="analytics-growth-trial-conversions"><%= m.growthTrialConversions.value %></span>
          <div class="bb-pa-muted"><%= m.growthTrialConversions.note %></div>
        </dd>
      </div>
      <div data-bb-pa-metric="provider_billing_conversions" data-bb-pa-metric-available="0">
        <dt><%= m.providerBillingConversions.label %></dt>
        <dd>
          <span class="bb-pa-chip bb-pa-chip--muted">Unavailable</span>
          <div class="bb-pa-muted"><%= m.providerBillingConversions.unavailableReason %></div>
        </dd>
      </div>
      <div data-bb-pa-metric="growth_downgrades">
        <dt><%= m.growthDowngrades.label %></dt>
        <dd><span data-bb-count="analytics-growth-downgrades"><%= m.growthDowngrades.value %></span></dd>
      </div>
      <div data-bb-pa-metric="onboarding_started">
        <dt><%= m.onboardingStarted.label %></dt>
        <dd><span data-bb-count="analytics-onboarding-started"><%= m.onboardingStarted.value %></span></dd>
      </div>
      <div data-bb-pa-metric="onboarding_completed">
        <dt><%= m.onboardingCompleted.label %></dt>
        <dd><span data-bb-count="analytics-onboarding-completed"><%= m.onboardingCompleted.value %></span></dd>
      </div>
      <div data-bb-pa-metric="median_registration_to_onboarding_complete">
        <dt><%= m.medianRegistrationToOnboardingComplete.label %></dt>
        <dd>
          <span data-bb-count="analytics-median-reg-onboard"><%= m.medianRegistrationToOnboardingComplete.durationLabel || '—' %></span>
        </dd>
      </div>
      <div data-bb-pa-metric="median_network_request_to_first_contact">
        <dt><%= m.medianNetworkRequestToFirstContact.label %></dt>
        <dd>
          <span data-bb-count="analytics-median-network-contact"><%= m.medianNetworkRequestToFirstContact.durationLabel || '—' %></span>
        </dd>
      </div>
    </dl>
    <% } %>
  </section>

  <div class="bb-pa-dash__layout">
    <div class="bb-pa-dash__main">
      <section
        class="bb-pa-dash-panel bb-pa-show-mobile"
        aria-labelledby="bb-pa-dash-quick-mobile-heading"
        data-bb-dash-quick="mobile"
      >
        <h2 id="bb-pa-dash-quick-mobile-heading" class="bb-pa-dash-panel__title">Quick governance</h2>
        <ul class="bb-pa-dash-quick-icons">
          <% mobileQuickActions.forEach(function (action) { %>
          <li>
            <a
              class="bb-pa-dash-quick-icon"
              href="<%= action.href %>"
              data-bb-quick-action="<%= action.key %>"
              data-bb-quick-enabled="1"
            >
              <span class="bb-pa-dash-quick-icon__glyph" aria-hidden="true">
                <span class="material-symbols-outlined"><%= action.icon %></span>
              </span>
              <span class="bb-pa-dash-quick-icon__label"><%= action.label %></span>
            </a>
          </li>
          <% }) %>
        </ul>
      </section>

      <section
        class="bb-pa-dash-panel"
        aria-labelledby="pa-sample-heading"
        data-bb-dash-directory="1"
      >
        <div class="bb-pa-dash-panel__head">
          <h2 id="pa-sample-heading" class="bb-pa-dash-panel__title">Directory sample</h2>
          <a class="bb-pa-link" href="/admin/organizations">View all</a>
        </div>
        <p class="bb-pa-hint">
          First keys by organization key order. Creation, editing, billing, and impersonation stay CLI-only —
          this is not a ranked “top performing” leaderboard.
        </p>
        <% if (!sample.length) { %>
        <div class="bb-pa-dash-empty" role="status" data-bb-pa-empty="directory" data-bb-dash-empty="directory">
          <span class="material-symbols-outlined" aria-hidden="true">corporate_fare</span>
          <p>No organizations provisioned yet.</p>
          <a class="bb-pa-btn bb-pa-btn--ghost" href="/admin/organizations">Open organizations</a>
        </div>
        <% } else { %>
        <ul class="bb-pa-org-list" data-bb-pa-directory-sample="1">
          <% sample.forEach(function (org) { %>
          <li>
            <a href="/admin/organizations/<%= org.organizationKey %>">
              <code class="bb-pa-key"><%= org.organizationKey %></code>
              <span><%= org.displayName %></span>
            </a>
            <% if (org.churchKey) { %>
            <span class="bb-pa-chip">Church · <%= org.churchKey %></span>
            <% } %>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </section>

      <section
        class="bb-pa-dash-panel"
        aria-labelledby="bb-pa-dash-activity-heading"
        data-bb-dash-activity="1"
      >
        <div class="bb-pa-dash-panel__head">
          <h2 id="bb-pa-dash-activity-heading" class="bb-pa-dash-panel__title">Recent activity</h2>
          <a class="bb-pa-link" href="/admin/deployments">View deployments</a>
        </div>
        <div class="bb-pa-dash-empty" role="status" data-bb-dash-empty="activity">
          <span class="material-symbols-outlined" aria-hidden="true">history</span>
          <p>
            No activity feed is summarized here. Open Deployments for the live registry —
            fabricated provisioning events and ticket updates are not shown.
          </p>
        </div>
      </section>

      <section
        class="bb-pa-dash-panel"
        aria-labelledby="bb-pa-dash-health-heading"
        data-bb-dash-health="1"
      >
        <div class="bb-pa-dash-panel__head">
          <h2 id="bb-pa-dash-health-heading" class="bb-pa-dash-panel__title">Platform health</h2>
        </div>
        <div class="bb-pa-dash-empty" role="status" data-bb-dash-empty="health">
          <span class="material-symbols-outlined" aria-hidden="true">monitor_heart</span>
          <p>
            API uptime, database latency, and reliability percentages are not calculated on this dashboard.
            Use Deployments for identity and registry context only.
          </p>
          <a class="bb-pa-btn bb-pa-btn--ghost" href="/admin/deployments">Open deployments</a>
        </div>
      </section>
    </div>

    <aside class="bb-pa-dash__aside bb-pa-show-desktop" aria-label="Shortcuts">
      <section
        class="bb-pa-dash-actions"
        aria-labelledby="bb-pa-dash-quick-desktop-heading"
        data-bb-dash-quick="desktop"
      >
        <h2 id="bb-pa-dash-quick-desktop-heading" class="bb-pa-dash-actions__title">
          <span class="material-symbols-outlined" aria-hidden="true">bolt</span>
          Quick actions
        </h2>
        <ul class="bb-pa-dash-actions__list">
          <% desktopQuickActions.forEach(function (action) { %>
          <li>
            <a
              class="bb-pa-dash-actions__item"
              href="<%= action.href %>"
              data-bb-quick-action="<%= action.key %>"
              data-bb-quick-enabled="1"
            >
              <span class="bb-pa-dash-actions__icon" aria-hidden="true">
                <span class="material-symbols-outlined"><%= action.icon %></span>
              </span>
              <span class="bb-pa-dash-actions__label"><%= action.label %></span>
              <span class="material-symbols-outlined bb-pa-dash-actions__chevron" aria-hidden="true">chevron_right</span>
            </a>
          </li>
          <% }) %>
        </ul>
        <p class="bb-pa-dash-actions__note" data-bb-dash-empty="create-org">
          Organization creation is not available from this dashboard.
        </p>
      </section>
    </aside>
  </div>
</section>

<%- include('../partials/platform-admin-shell-end') %>
