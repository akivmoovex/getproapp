<%- include('../partials/platform-admin-shell-start') %>
  <h1><%= organization.displayName %></h1>
  <p class="bb-pa-lede">Read-only organization summary. No administrative actions are available in this phase.</p>
  <dl class="bb-pa-dl" data-bb-detail="organization">
    <dt>Organization key</dt>
    <dd><%= organization.organizationKey %></dd>
    <dt>Display name</dt>
    <dd><%= organization.displayName %></dd>
    <dt>Data environment</dt>
    <dd><%= organization.dataEnvironment %></dd>
    <dt>Organization status</dt>
    <dd><%= organization.organizationStatus %></dd>
    <dt>BlessBoard enrolment</dt>
    <dd><%= organization.enrolmentStatus || "—" %></dd>
    <dt>Canonical hostname</dt>
    <dd><%= organization.canonicalHostname || "—" %></dd>
    <dt>Deployment</dt>
    <dd><%= organization.deploymentCode || "—" %></dd>
    <dt>Church key</dt>
    <dd><%= organization.churchKey || "—" %></dd>
    <dt>Church status</dt>
    <dd><%= organization.churchStatus || "—" %></dd>
    <dt>Active branches</dt>
    <dd data-bb-count="active-branches"><%= organization.activeBranchCount %></dd>
  </dl>
  <p><a href="/admin/organizations">Back to directory</a></p>
<%- include('../partials/platform-admin-shell-end') %>
