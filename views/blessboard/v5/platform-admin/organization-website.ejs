<%- include('../partials/platform-admin-shell-start') %>
<%
  var org = organization || {};
  var inst = instance || null;
  var versions = versions || [];
  var pending = pendingSubmissions || [];
  var cl = checklist || null;
  var avail = availability || null;
  var hco = avail && avail.healthcareOrganization;
  var approved = avail && avail.latestApprovedVersion || (typeof liveVersion !== 'undefined' ? liveVersion : null);
  var ready = avail && avail.readiness;
  var last = avail && avail.lastToggle;
  var canToggle = canToggleAvailability === true;
  var notice = String(notice || '');
  var error = String(error || '');
  var isPublic = typeof websitePublished === 'boolean'
    ? websitePublished
    : Boolean(hco && hco.websitePublished);
  var product = typeof productCode !== 'undefined' ? productCode : 'activeclinic';
  var acts = typeof actions !== 'undefined' && actions ? actions : {};
  var publicHref = (typeof publicPath !== 'undefined' && publicPath) || (avail && (avail.publicPath || avail.publicUrl)) || '';
%>
<section class="bb-pa-page" data-bb-pa-website-detail="1" data-product="<%= product %>">
  <h1><%= product === 'blessboard' ? 'Church website' : 'Clinic website' %></h1>
  <p><%= org.display_name %> · <%= org.organization_key %> · <%= typeof productLabel !== 'undefined' ? productLabel : product %></p>
  <% if (notice === 'published') { %>
  <p class="bb-pa-notice" data-website-availability-notice="published">Website is public.<% if (publicHref) { %> <a href="<%= publicHref %>"><%= publicHref %></a><% } %></p>
  <% } else if (notice === 'unpublished') { %>
  <p class="bb-pa-notice" data-website-availability-notice="unpublished">Website is not public. Content and versions were kept.</p>
  <% } else if (notice === 'restored') { %>
  <p class="bb-pa-notice">Previous version restored as a new live version. History was kept.</p>
  <% } else if (notice === 'offline') { %>
  <p class="bb-pa-notice">Website taken offline. Tenant account remains active.</p>
  <% } else if (notice === 'suspend') { %>
  <p class="bb-pa-notice">Website suspended. Tenant account remains active.</p>
  <% } else if (notice === 'restore-site') { %>
  <p class="bb-pa-notice">Website restored.</p>
  <% } else if (notice === 'request-changes') { %>
  <p class="bb-pa-notice">Changes requested. Current public version was left in place unless taken offline.</p>
  <% } else if (notice === 'policy') { %>
  <p class="bb-pa-notice">Publishing policy updated.</p>
  <% } %>
  <% if (error) { %>
  <p class="bb-pa-error" data-website-availability-error="<%= error %>">Could not update website availability (<%= error %>).</p>
  <% } %>

  <h2>Website overview</h2>
  <dl class="bb-pa-dl" data-website-availability="<%= isPublic ? 'public' : 'not-public' %>">
    <dt>Product</dt>
    <dd><%= typeof productLabel !== 'undefined' ? productLabel : product %></dd>
    <dt>Organisation</dt>
    <dd><%= org.display_name %> (<%= org.organization_key %>)</dd>
    <dt>Public URL</dt>
    <dd>
      <% if (publicHref) { %>
      <a href="<%= publicHref %>" data-action-view-live="1"><%= publicHref %></a>
      <% } else { %>Not assigned<% } %>
    </dd>
    <dt>Website status</dt>
    <dd data-website-status="<%= typeof websiteStatus !== 'undefined' ? websiteStatus : '' %>"><%= typeof websiteStatus !== 'undefined' && websiteStatus ? websiteStatus : (isPublic ? 'Public' : 'Not public') %></dd>
    <dt>Published version</dt>
    <dd data-published-version="<%= approved && approved.versionNumber ? approved.versionNumber : '' %>"><% if (approved && approved.versionNumber) { %>v<%= approved.versionNumber %><% } else { %>None<% } %></dd>
    <dt>Current draft</dt>
    <dd data-draft-state="<%= typeof currentDraft !== 'undefined' ? currentDraft : '' %>"><%= typeof currentDraft !== 'undefined' && currentDraft ? currentDraft : (unpublishedCount > 0 ? 'Unpublished changes' : 'Current') %></dd>
    <dt>Unpublished changes</dt>
    <dd data-unpublished-count="<%= unpublishedCount || 0 %>"><%= unpublishedCount || 0 %></dd>
    <dt>Last editor</dt>
    <dd data-last-editor="<%= typeof lastEditor !== 'undefined' ? lastEditor : '' %>"><%= typeof lastEditor !== 'undefined' && lastEditor ? lastEditor : '—' %></dd>
    <dt>Last publisher</dt>
    <dd data-last-publisher="<%= typeof lastPublisher !== 'undefined' ? lastPublisher : '' %>"><%= typeof lastPublisher !== 'undefined' && lastPublisher ? lastPublisher : '—' %></dd>
    <dt>Lifecycle</dt>
    <dd><%= (inst && inst.lifecycleStatus) || '—' %></dd>
    <dt>Publishing policy</dt>
    <dd><%= (inst && inst.publishPolicy) || '—' %></dd>
    <% if (ready) { %>
    <dt>Readiness</dt>
    <dd>
      <% if (ready.readyToPublish) { %>Ready for public launch
      <% } else if (ready.userMessages && ready.userMessages.length) { %>
        Not ready: <%= ready.userMessages.join(', ') %>
      <% } else { %>Unknown<% } %>
    </dd>
    <% } %>
    <% if (last) { %>
    <dt>Last publication toggle</dt>
    <dd><%= last.actionKey === 'website.availability.publish' ? 'Published' : 'Unpublished' %> · <%= last.at %></dd>
    <% } %>
  </dl>

  <p class="bb-pa-actions">
    <% if (publicHref) { %>
    <a class="bb-pa-btn bb-pa-btn--ghost" href="<%= publicHref %>" data-action-view-live="1">View live</a>
    <% } %>
    <% if (acts.previewDraft) { %>
    <a class="bb-pa-btn bb-pa-btn--ghost" href="<%= acts.previewDraft %>" data-action-preview-draft="1">Preview draft</a>
    <% } %>
    <a class="bb-pa-btn bb-pa-btn--ghost" href="#website-changes" data-action-change-summary="1">View change summary</a>
    <a class="bb-pa-btn bb-pa-btn--ghost" href="#website-history" data-action-history="1">View history</a>
  </p>

  <% if (canToggle) { %>
    <% if (!isPublic) { %>
    <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/publish" data-website-availability-form="publish">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <button type="submit" class="bb-pa-btn" <%= (product === 'activeclinic' && !approved) ? 'disabled' : '' %>>Publish Website</button>
    </form>
    <% } else { %>
    <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/unpublish" data-website-availability-form="unpublish">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <button type="submit" class="bb-pa-btn bb-pa-btn--ghost">Unpublish Website</button>
    </form>
    <% } %>
  <% } %>

  <% if (inst && (canTakeOffline || canSuspend || canRestore || canModerate || canManagePolicy)) { %>
  <h2>Moderation</h2>
  <p>These actions affect the public website only. They do not disable the tenant account.</p>
  <% if (canTakeOffline) { %>
  <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/offline" data-website-moderation="offline">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <label>Reason <input name="reason" maxlength="500" required/></label>
    <label>Tenant-visible note <input name="note_public" maxlength="500"/></label>
    <button type="submit" class="bb-pa-btn bb-pa-btn--ghost">Hide Website</button>
  </form>
  <% } %>
  <% if (canSuspend) { %>
  <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/suspend" data-website-moderation="suspend">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <label>Reason <input name="reason" maxlength="500" required/></label>
    <label>Tenant-visible note <input name="note_public" maxlength="500"/></label>
    <button type="submit" class="bb-pa-btn bb-pa-btn--ghost">Block Website</button>
  </form>
  <% } %>
  <% if (canRestore && (typeof canResume === 'undefined' || canResume)) { %>
  <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/restore-site" data-website-moderation="restore">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <button type="submit" class="bb-pa-btn"><%= inst && inst.lifecycleStatus === 'suspended' ? 'Unblock Website' : inst && inst.lifecycleStatus === 'offline' ? 'Unhide Website' : 'Resume publishing' %></button>
  </form>
  <% } %>
  <% if (canModerate) { %>
  <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/request-changes" data-website-moderation="request-changes">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <label>Request <input name="note_public" maxlength="500" required/></label>
    <button type="submit" class="bb-pa-btn bb-pa-btn--ghost">Request Changes</button>
  </form>
  <% } %>
  <% if (canManagePolicy) { %>
  <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/policy" data-website-moderation="policy">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <label>Policy
      <select name="publish_policy">
        <option value="TENANT_PUBLISH" <%= inst.publishPolicy === 'TENANT_PUBLISH' ? 'selected' : '' %>>Organisation publishes</option>
        <option value="AUTO_PUBLISH_WITH_MODERATION" <%= inst.publishPolicy === 'AUTO_PUBLISH_WITH_MODERATION' ? 'selected' : '' %>>Auto-publish with moderation</option>
        <option value="REVIEW_BEFORE_PUBLISH" <%= inst.publishPolicy === 'REVIEW_BEFORE_PUBLISH' ? 'selected' : '' %>>Review before publish</option>
        <option value="PLATFORM_LOCKED" <%= inst.publishPolicy === 'PLATFORM_LOCKED' ? 'selected' : '' %>>Platform locked</option>
      </select>
    </label>
    <button type="submit" class="bb-pa-btn">Update policy</button>
  </form>
  <% } %>
  <% } %>

  <% if (!inst && product !== 'blessboard') { %>
  <p>No website instance for this organisation.</p>
  <% } else { %>
  <% if (inst) { %>
  <p>Template <%= inst.templateId %> v<%= inst.templateVersion %> · status <%= inst.status %> · unpublished <%= unpublishedCount || 0 %></p>
  <% } %>
  <% if (cl) { %>
  <p>Checklist <%= cl.percent || 0 %>% complete</p>
  <% } %>
  <% if (pending.length) { %>
  <h2>Pending submissions</h2>
  <ul>
    <% pending.forEach(function (s) { %>
    <li><a href="/admin/website-changes/<%= s.id %>"><%= s.status %> · <%= s.changeCount || 0 %> keys</a></li>
    <% }) %>
  </ul>
  <% } %>
  <h2 id="website-changes">Changes since publication</h2>
  <% var summary = typeof changeSummary !== 'undefined' && changeSummary ? changeSummary : []; %>
  <% if (!summary.length) { %>
  <p class="bb-pa-hint">No unpublished draft changes.</p>
  <% } else { %>
  <ul data-website-change-summary="1">
    <% summary.forEach(function (group) { %>
    <li>
      <strong><%= group.page %></strong>
      <ul>
        <% (group.items || []).forEach(function (item) { %>
        <li><%= item %></li>
        <% }) %>
      </ul>
    </li>
    <% }) %>
  </ul>
  <% } %>
  <h2 id="website-history">Version history</h2>
  <p>Editing a published website updates the draft only. Publish creates the next immutable version. Restore creates a new current version from history.</p>
  <table class="bb-pa-table" data-website-version-history="1">
    <thead>
      <tr>
        <th>Version</th>
        <th>Editor</th>
        <th>When</th>
        <th>Session</th>
        <th>Fields</th>
        <th>Pages / sections</th>
        <th>Policy</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (!versions.length) { %>
      <tr><td colspan="9">No website versions yet.</td></tr>
      <% } %>
      <% versions.forEach(function (v) { %>
      <tr>
        <td>v<%= v.versionNumber %></td>
        <td><%= v.editorLabel || 'Editor' %></td>
        <td><%= v.publishedLabel || '—' %></td>
        <td>
          <% if (v.sessionStartLabel) { %>
            <%= v.sessionStartLabel %><% if (v.sessionEndLabel) { %> – <%= v.sessionEndLabel %><% } %>
            <% if (v.sessionOpen) { %> (open)<% } %>
          <% } else { %>Single publish<% } %>
        </td>
        <td><%= v.fieldCount || (v.changedKeys && v.changedKeys.length) || v.changeCount || 0 %></td>
        <td>
          <%= (v.pagesAffected || []).join(', ') || '—' %>
          <% if (v.sectionsAffected && v.sectionsAffected.length) { %>
            <br/><span class="bb-pa-muted"><%= v.sectionsAffected.join(', ') %></span>
          <% } %>
        </td>
        <td><%= v.sourcePolicy || (inst && inst.publishPolicy) || '—' %></td>
        <td><%= v.moderationStatus || v.status %></td>
        <td>
          <% if (product === 'activeclinic' && v.id) { %>
          <a class="bb-pa-link" href="/admin/recent-website-changes/version/<%= v.id %>">View changes</a>
          <% } %>
          <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/versions/<%= v.id %>/restore" style="display:inline" data-action-restore="1">
            <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
            <button type="submit" class="bb-pa-btn bb-pa-btn--ghost">Restore version</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</section>
<%- include('../partials/platform-admin-shell-end') %>
