<%- include('../partials/platform-admin-shell-start') %>
<%
  var org = organization || {};
  var inst = instance || null;
  var versions = versions || [];
  var pending = pendingSubmissions || [];
  var cl = checklist || null;
  var avail = availability || null;
  var hco = avail && avail.healthcareOrganization;
  var approved = avail && avail.latestApprovedVersion;
  var ready = avail && avail.readiness;
  var last = avail && avail.lastToggle;
  var canToggle = canToggleAvailability === true;
  var notice = String(notice || '');
  var error = String(error || '');
  var isPublic = Boolean(hco && hco.websitePublished);
%>
<section class="bb-pa-page">
  <h1>Clinic website</h1>
  <p><%= org.display_name %> · <%= org.organization_key %></p>
  <% if (notice === 'published') { %>
  <p class="bb-pa-notice" data-website-availability-notice="published">Website is public.<% if (avail && avail.publicUrl) { %> <a href="<%= avail.publicUrl %>"><%= avail.publicUrl %></a><% } %></p>
  <% } else if (notice === 'unpublished') { %>
  <p class="bb-pa-notice" data-website-availability-notice="unpublished">Website is not public. Content and versions were kept.</p>
  <% } else if (notice === 'restored') { %>
  <p class="bb-pa-notice">Previous version restored as a new live version. History was kept.</p>
  <% } else if (notice === 'offline') { %>
  <p class="bb-pa-notice">Website taken offline. Tenant account remains active.</p>
  <% } else if (notice === 'suspend') { %>
  <p class="bb-pa-notice">Website suspended. Tenant account remains active.</p>
  <% } else if (notice === 'restore-site') { %>
  <p class="bb-pa-notice">Website restored.</p>
  <% } else if (notice === 'request-changes') { %>
  <p class="bb-pa-notice">Changes requested. Current public version was left in place unless taken offline.</p>
  <% } else if (notice === 'policy') { %>
  <p class="bb-pa-notice">Publishing policy updated.</p>
  <% } %>
  <% if (error) { %>
  <p class="bb-pa-error" data-website-availability-error="<%= error %>">Could not update website availability (<%= error %>).</p>
  <% } %>

  <h2>Website availability</h2>
  <% if (!inst || !hco) { %>
  <p>No clinic website instance for this organisation. Availability cannot be toggled yet.</p>
  <% } else { %>
  <dl class="bb-pa-dl" data-website-availability="<%= isPublic ? 'public' : 'not-public' %>">
    <dt>Lifecycle</dt>
    <dd><%= inst.lifecycleStatus || '—' %></dd>
    <dt>Publishing policy</dt>
    <dd><%= inst.publishPolicy || '—' %></dd>
    <dt>Adapter</dt>
    <dd><%= inst.adapterMode || 'shared_engine' %></dd>
    <dt>Public availability</dt>
    <dd><%= isPublic ? 'Public' : 'Not public' %></dd>
    <dt>Public URL</dt>
    <dd><% if (avail && avail.publicUrl) { %><a href="<%= avail.publicUrl %>"><%= avail.publicUrl %></a><% } else if (avail && avail.publicPath) { %><%= avail.publicPath %><% } else { %>Not assigned<% } %></dd>
    <dt>Latest approved version</dt>
    <dd><% if (approved) { %>v<%= approved.versionNumber %> · <%= approved.status %><% } else { %>None<% } %></dd>
    <dt>Readiness</dt>
    <dd>
      <% if (ready && ready.readyToPublish) { %>Ready for public launch
      <% } else if (ready && ready.userMessages && ready.userMessages.length) { %>
        Not ready: <%= ready.userMessages.join(', ') %>
      <% } else { %>Unknown<% } %>
    </dd>
    <dt>Last publication toggle</dt>
    <dd>
      <% if (last) { %>
        <%= last.actionKey === 'website.availability.publish' ? 'Published' : 'Unpublished' %>
        · <%= last.at %>
      <% } else { %>Never toggled<% } %>
    </dd>
  </dl>
  <% if (canToggle) { %>
    <% if (!isPublic) { %>
    <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/publish" data-website-availability-form="publish">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <button type="submit" class="bb-pa-btn" <%= approved ? '' : 'disabled' %>>Publish Website</button>
    </form>
    <% } else { %>
    <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/unpublish" data-website-availability-form="unpublish">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <button type="submit" class="bb-pa-btn bb-pa-btn--ghost">Unpublish Website</button>
    </form>
    <% } %>
  <% } %>
  <% } %>
  <% if (inst && (canTakeOffline || canSuspend || canRestore || canModerate || canManagePolicy)) { %>
  <h2>Moderation</h2>
  <p>These actions affect the public website only. They do not disable the tenant account.</p>
  <% if (canTakeOffline) { %>
  <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/offline" data-website-moderation="offline">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <label>Reason <input name="reason" maxlength="500"/></label>
    <label>Tenant-visible note <input name="note_public" maxlength="500"/></label>
    <button type="submit" class="bb-pa-btn bb-pa-btn--ghost">Take Website Offline</button>
  </form>
  <% } %>
  <% if (canSuspend) { %>
  <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/suspend" data-website-moderation="suspend">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <label>Reason <input name="reason" maxlength="500" required/></label>
    <label>Tenant-visible note <input name="note_public" maxlength="500"/></label>
    <button type="submit" class="bb-pa-btn bb-pa-btn--ghost">Suspend Website</button>
  </form>
  <% } %>
  <% if (canRestore) { %>
  <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/restore-site" data-website-moderation="restore">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <button type="submit" class="bb-pa-btn">Restore Website</button>
  </form>
  <% } %>
  <% if (canModerate) { %>
  <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/request-changes" data-website-moderation="request-changes">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <label>Request <input name="note_public" maxlength="500" required/></label>
    <button type="submit" class="bb-pa-btn bb-pa-btn--ghost">Request Changes</button>
  </form>
  <% } %>
  <% if (canManagePolicy) { %>
  <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/policy" data-website-moderation="policy">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <label>Policy
      <select name="publish_policy">
        <option value="AUTO_PUBLISH_WITH_MODERATION" <%= inst.publishPolicy === 'AUTO_PUBLISH_WITH_MODERATION' ? 'selected' : '' %>>Auto-publish with moderation</option>
        <option value="REVIEW_BEFORE_PUBLISH" <%= inst.publishPolicy === 'REVIEW_BEFORE_PUBLISH' ? 'selected' : '' %>>Review before publish</option>
        <option value="PLATFORM_LOCKED" <%= inst.publishPolicy === 'PLATFORM_LOCKED' ? 'selected' : '' %>>Platform locked</option>
      </select>
    </label>
    <button type="submit" class="bb-pa-btn">Update policy</button>
  </form>
  <% } %>
  <% } %>
  <% if (!inst) { %>
  <p>No website instance for this organisation.</p>
  <% } else { %>
  <p>Template <%= inst.templateId %> v<%= inst.templateVersion %> · status <%= inst.status %> · unpublished <%= unpublishedCount || 0 %></p>
  <% if (cl) { %>
  <p>Checklist <%= cl.percent || 0 %>% complete</p>
  <% } %>
  <h2>Pending submissions</h2>
  <ul>
    <% pending.forEach(function (s) { %>
    <li><a href="/admin/website-changes/<%= s.id %>"><%= s.status %> · <%= s.changeCount || 0 %> keys</a></li>
    <% }) %>
  </ul>
  <h2>Version history</h2>
  <p>Each editing session publishes one version. Field saves still go live immediately.</p>
  <table class="bb-pa-table" data-website-version-history="1">
    <thead>
      <tr>
        <th>Version</th>
        <th>Editor</th>
        <th>When</th>
        <th>Session</th>
        <th>Fields</th>
        <th>Pages / sections</th>
        <th>Policy</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (!versions.length) { %>
      <tr><td colspan="9">No website versions yet.</td></tr>
      <% } %>
      <% versions.forEach(function (v) { %>
      <tr>
        <td>v<%= v.versionNumber %></td>
        <td><%= v.editorLabel || 'Editor' %></td>
        <td><%= v.publishedLabel || '—' %></td>
        <td>
          <% if (v.sessionStartLabel) { %>
            <%= v.sessionStartLabel %><% if (v.sessionEndLabel) { %> – <%= v.sessionEndLabel %><% } %>
            <% if (v.sessionOpen) { %> (open)<% } %>
          <% } else { %>Single publish<% } %>
        </td>
        <td><%= v.fieldCount || (v.changedKeys && v.changedKeys.length) || v.changeCount || 0 %></td>
        <td>
          <%= (v.pagesAffected || []).join(', ') || '—' %>
          <% if (v.sectionsAffected && v.sectionsAffected.length) { %>
            <br/><span class="bb-pa-muted"><%= v.sectionsAffected.join(', ') %></span>
          <% } %>
        </td>
        <td><%= v.sourcePolicy || inst.publishPolicy || '—' %></td>
        <td><%= v.moderationStatus || v.status %></td>
        <td>
          <a class="bb-pa-link" href="/admin/recent-website-changes/version/<%= v.id %>">View changes</a>
          <form method="post" action="/admin/organizations/<%= org.organization_key %>/website/versions/<%= v.id %>/restore" style="display:inline">
            <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
            <button type="submit" class="bb-pa-btn bb-pa-btn--ghost">Restore version</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</section>
<%- include('../partials/platform-admin-shell-end') %>
