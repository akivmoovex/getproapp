<%- include('../partials/platform-admin-shell-start') %>
<%
  var app = application || {};
  var loc = [app.address, app.city, app.province, app.country_code].filter(Boolean).join(', ');
  var events = typeof reviewHistory !== 'undefined' && reviewHistory ? reviewHistory : [];
  var notes = typeof reviewNotes !== 'undefined' && reviewNotes ? reviewNotes : [];
  var collision = typeof identityCollision !== 'undefined' && identityCollision ? identityCollision : null;
  var website = typeof websiteState !== 'undefined' && websiteState ? websiteState : 'not_provisioned';
  var flashNotice = typeof notice !== 'undefined' ? String(notice || '') : '';
  var flashError = typeof error !== 'undefined' ? String(error || '') : '';
  function noticeText(code) {
    if (code === 'approved') return 'Application approved.';
    if (code === 'rejected') return 'Application rejected. The reason was recorded. Email was not sent.';
    if (code === 'information_requested') return 'Information request recorded. Email was not sent.';
    if (code === 'information_returned') return 'Information marked as returned. Application is back in review.';
    if (code === 'note_saved') return 'Internal note saved.';
    if (code === 'provision_retried' || code === 'retry_succeeded') return 'Provisioning retry completed.';
    if (code === 'already_healthy') return 'Provisioning is already complete. Healthy resources were not rebuilt.';
    return code || '';
  }
  function errorText(code) {
    if (code === 'csrf') return 'Invalid or missing security token. Reload and try again.';
    if (code === 'rejection_reason_required') return 'Enter a rejection reason of at least 3 characters.';
    if (code === 'request_text_required') return 'Enter the information you need from the applicant.';
    if (code === 'note_required') return 'Enter an internal note.';
    if (code === 'not_awaiting_customer') return 'This application is not awaiting customer information.';
    if (code === 'application_not_eligible') return 'This action is not available for the current application status.';
    if (code === 'application_not_found') return 'This clinic registration could not be found.';
    if (code === 'existing_identity_acknowledgement_required') {
      return 'This contact already administers another ActiveClinic organization. Confirm second-clinic attachment before approving.';
    }
    if (code === 'not_retryable') return 'Provisioning retry is not available. Healthy resources were not rebuilt.';
    if (code === 'retry_failed') return 'Provisioning retry could not complete. Review tenant health and try again.';
    return code ? 'Something went wrong.' : '';
  }
  function axisChip(kind, value) {
    var v = String(value || '');
    if (kind === 'application') {
      if (v === 'approved' || v === 'active') return 'bb-pa-chip--ok';
      if (v === 'rejected' || v === 'duplicate' || v === 'provision_failed') return 'bb-pa-chip--danger';
      if (v === 'pending_review' || v === 'review_required' || v === 'submitted' || v === 'provisioning') return 'bb-pa-chip--warn';
      return 'bb-pa-chip--muted';
    }
    if (kind === 'follow_up') {
      if (v === 'awaiting_customer') return 'bb-pa-chip--warn';
      if (v === 'returned_for_review' || v === 'under_review') return 'bb-pa-chip--ok';
      return 'bb-pa-chip--muted';
    }
    if (v === 'provisioned') return 'bb-pa-chip--ok';
    if (v === 'failed') return 'bb-pa-chip--danger';
    if (v === 'in_progress' || v === 'website_pending') return 'bb-pa-chip--warn';
    return 'bb-pa-chip--muted';
  }
  var noticeMsg = noticeText(flashNotice);
  var errorMsg = errorText(flashError);
  var pending = app.status === 'pending_review' || app.status === 'review_required' || app.status === 'submitted' || app.status === 'provisioning';
  var awaiting = pending && app.follow_up_status === 'awaiting_customer';
  var followUp = app.follow_up_status || 'none';
  var provisioning = app.provisioning_status || 'not_started';
  var needsSecondClinicAck = collision && collision.requiresSecondClinicAcknowledgement;
%>
<section class="bb-pa-page" data-ac-clinic-reg-detail="1">
  <p><a href="/admin/clinic-registrations">← Clinic registrations</a></p>
  <h1><%= app.clinic_name || 'Clinic registration' %></h1>
  <p class="bb-pa-hint">Application <%= app.application_number %></p>
  <% if (noticeMsg) { %>
  <p class="bb-pa-notice" role="status" data-ac-clinic-reg-notice="<%= flashNotice %>"><%= noticeMsg %></p>
  <% } %>
  <% if (errorMsg) { %>
  <p class="bb-pa-error" role="alert" data-ac-clinic-reg-error="<%= flashError %>"><%= errorMsg %></p>
  <% } %>

  <section class="bb-pa-panel" data-ac-clinic-reg-axes="1" aria-label="Independent review states">
    <h2 class="bb-pa-section-title">Review state</h2>
    <p class="bb-pa-hint">Application, follow-up, and provisioning are separate. They are not combined into one status.</p>
    <dl class="bb-pa-dl bb-pa-clinic-axes">
      <div>
        <dt>Application status</dt>
        <dd>
          <span class="bb-pa-chip <%= axisChip('application', app.status) %>" data-ac-application-status="<%= app.status %>"><%= app.status %></span>
        </dd>
      </div>
      <div>
        <dt>Follow-up status</dt>
        <dd>
          <span class="bb-pa-chip <%= axisChip('follow_up', followUp) %>" data-ac-follow-up-status="<%= followUp %>"><%= followUp %></span>
        </dd>
      </div>
      <div>
        <dt>Provisioning status</dt>
        <dd>
          <span class="bb-pa-chip <%= axisChip('provisioning', provisioning) %>" data-ac-provisioning-status="<%= provisioning %>"><%= provisioning %></span>
        </dd>
      </div>
    </dl>
  </section>

  <%- include('../partials/tenant-health-summary', { tenantHealth: typeof tenantHealth !== 'undefined' ? tenantHealth : null }) %>

  <section class="bb-pa-panel" data-ac-clinic-reg-identity="1">
    <h2 class="bb-pa-section-title">Application identity</h2>
    <dl class="bb-pa-dl">
      <div><dt>Application number</dt><dd><code><%= app.application_number %></code></dd></div>
      <div><dt>Submitted</dt><dd><%= app.created_at ? new Date(app.created_at).toISOString() : '—' %></dd></div>
      <% if (app.organization_id) { %>
      <div><dt>Organization</dt><dd><code><%= app.organization_id %></code></dd></div>
      <% } %>
      <% if (app.duplicate_of_application_id) { %>
      <div>
        <dt>Duplicate of</dt>
        <dd data-ac-duplicate-of="1"><code><%= app.duplicate_of_application_id %></code></dd>
      </div>
      <% } %>
    </dl>
  </section>

  <section class="bb-pa-panel" data-ac-clinic-reg-clinic="1">
    <h2 class="bb-pa-section-title">Clinic details</h2>
    <dl class="bb-pa-dl">
      <div><dt>Clinic name</dt><dd><%= app.clinic_name %></dd></div>
      <div><dt>Location</dt><dd><%= loc || '—' %></dd></div>
      <div><dt>Applicant notes</dt><dd><%= app.notes || '—' %></dd></div>
    </dl>
  </section>

  <section class="bb-pa-panel" data-ac-clinic-reg-admin="1">
    <h2 class="bb-pa-section-title">Administrator / contact</h2>
    <dl class="bb-pa-dl">
      <div><dt>Name</dt><dd><%= app.contact_name %></dd></div>
      <div><dt>Email</dt><dd><%= app.contact_email_display %></dd></div>
      <div><dt>Phone</dt><dd><%= app.contact_phone_display %></dd></div>
    </dl>
  </section>

  <% if (collision && collision.existingIdentity) { %>
  <section class="bb-pa-panel <%= needsSecondClinicAck ? 'bb-pa-panel--danger' : '' %>" data-ac-existing-identity="1" data-ac-existing-identity-match="<%= collision.matchOn || '' %>">
    <h2 class="bb-pa-section-title">Existing identity</h2>
    <% if (collision.existingActiveClinicIdentity) { %>
    <p class="bb-pa-hint" data-ac-existing-ac-identity="1">
      Existing ActiveClinic identity. Approving will attach this person as administrator of another clinic.
      The current password will not be changed.
    </p>
    <ul class="bb-pa-list" data-ac-existing-orgs="1">
      <% (collision.existingOrganizations || []).forEach(function (org) { %>
      <li data-ac-existing-org="<%= org.organizationKey %>"><%= org.displayName || org.organizationKey %> · <%= org.staffStatus %></li>
      <% }) %>
    </ul>
    <% } else { %>
    <p class="bb-pa-hint">
      This contact matches an existing platform identity (<%= collision.matchOn %>).
      Approval will reuse that identity as clinic administrator. The current password will not be changed.
    </p>
    <% } %>
  </section>
  <% } %>

  <section class="bb-pa-panel" data-ac-clinic-reg-website="1">
    <h2 class="bb-pa-section-title">Website state</h2>
    <dl class="bb-pa-dl">
      <div>
        <dt>Website</dt>
        <dd data-ac-website-state="<%= website %>"><%= website %></dd>
      </div>
      <% if (app.last_provision_stage) { %>
      <div><dt>Failed stage</dt><dd data-ac-last-provision-stage="1"><%= app.last_provision_stage %></dd></div>
      <% } %>
      <% if (app.last_provision_error) { %>
      <div><dt>Last provision error</dt><dd><%= app.last_provision_error %></dd></div>
      <% } %>
    </dl>
  </section>

  <% if (app.rejection_reason) { %>
  <section class="bb-pa-panel" data-ac-clinic-reg-rejection="1">
    <h2 class="bb-pa-section-title">Rejection reason</h2>
    <p data-ac-rejection-reason="1"><%= app.rejection_reason %></p>
    <p class="bb-pa-hint">Recorded for Platform Admin. Email was not sent.</p>
  </section>
  <% } %>

  <% if (pending || ((app.status === 'approved' || app.status === 'active' || app.status === 'provision_failed') && app.provisioning_status !== 'provisioned')) { %>
  <form method="post" action="/admin/clinic-registrations/<%= app.id %>/approve" data-ac-clinic-reg-approve="1">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
    <% if (needsSecondClinicAck) { %>
    <label class="bb-pa-check" data-ac-second-clinic-ack="1">
      <input type="checkbox" name="acknowledge_existing_identity" value="1" required/>
      I confirm this existing ActiveClinic identity should also administer this additional clinic. Do not change the password.
    </label>
    <% } %>
    <button type="submit" class="bb-pa-btn"><%= (app.status === 'approved' || app.status === 'active') ? 'Retry provision' : 'Approve and provision' %></button>
  </form>
  <% } %>

  <% if (pending) { %>
  <section class="bb-pa-panel" data-ac-clinic-reg-request-info="1">
    <h2 class="bb-pa-section-title">Request information</h2>
    <p class="bb-pa-hint">The application stays in review. This records the request in history. Email is not sent from this screen.</p>
    <form class="bb-pa-form" method="post" action="/admin/clinic-registrations/<%= app.id %>/request-information">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <label class="bb-pa-field">
        <span class="bb-pa-field__label">Request text</span>
        <textarea name="request_text" rows="4" maxlength="8000" required data-ac-request-text="1"></textarea>
      </label>
      <button type="submit" class="bb-pa-btn">Record information request</button>
    </form>
    <% if (awaiting) { %>
    <form class="bb-pa-form" method="post" action="/admin/clinic-registrations/<%= app.id %>/information-returned">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <p class="bb-pa-hint">Applicant resubmission portal is not available. Mark returned when the applicant has provided the information.</p>
      <button type="submit" class="bb-pa-btn bb-pa-btn--ghost" data-ac-mark-returned="1">Mark information returned</button>
    </form>
    <% } %>
  </section>

  <section class="bb-pa-panel" data-ac-clinic-reg-reject="1">
    <h2 class="bb-pa-section-title">Reject application</h2>
    <p class="bb-pa-hint">Rejected applications remain visible historically. Email is not sent from this screen.</p>
    <form class="bb-pa-form" method="post" action="/admin/clinic-registrations/<%= app.id %>/reject">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <label class="bb-pa-field">
        <span class="bb-pa-field__label">Rejection reason</span>
        <textarea name="rejection_reason" rows="3" maxlength="2000" required data-ac-rejection-reason-input="1"></textarea>
      </label>
      <button type="submit" class="bb-pa-btn bb-pa-btn--ghost">Reject</button>
    </form>
  </section>
  <% } %>

  <section class="bb-pa-panel" data-ac-clinic-reg-notes="1">
    <h2 class="bb-pa-section-title">Internal review notes</h2>
    <p class="bb-pa-hint">Notes are Platform Admin only. They are never shown on public clinic pages.</p>
    <% if (!notes.length) { %>
    <p class="bb-pa-hint">No internal notes yet.</p>
    <% } %>
    <% notes.forEach(function (note) { %>
    <article class="bb-pa-note" data-ac-review-note="1">
      <p><%= note.body %></p>
      <p class="bb-pa-hint"><%= note.actorLabel || 'Platform admin' %> · <%= note.createdAt ? new Date(note.createdAt).toISOString() : '' %></p>
    </article>
    <% }) %>
    <form class="bb-pa-form" method="post" action="/admin/clinic-registrations/<%= app.id %>/notes">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>"/>
      <label class="bb-pa-field">
        <span class="bb-pa-field__label">Add note</span>
        <textarea name="note_body" rows="3" maxlength="8000" required data-ac-note-body="1"></textarea>
      </label>
      <button type="submit" class="bb-pa-btn">Save note</button>
    </form>
  </section>

  <section class="bb-pa-panel" data-ac-clinic-reg-history="1">
    <h2 class="bb-pa-section-title">Review history</h2>
    <% if (!events.length) { %>
    <p class="bb-pa-hint">No history recorded yet.</p>
    <% } %>
    <ol class="bb-pa-clinic-history">
      <% events.forEach(function (ev) { %>
      <li class="bb-pa-clinic-history__item bb-pa-clinic-history__item--<%= ev.eventType %><%= ev.isInternalNote ? ' bb-pa-clinic-history__item--note' : '' %>" data-ac-history-event="<%= ev.eventType %>" data-ac-history-visibility="<%= ev.visibility || 'history' %>">
        <strong><%= ev.label %></strong>
        <span class="bb-pa-hint"><%= ev.createdAt ? new Date(ev.createdAt).toISOString() : '' %></span>
        <% if (ev.actorLabel) { %><span class="bb-pa-hint"> · <%= ev.actorLabel %></span><% } %>
        <% if (ev.body) { %><p><%= ev.body %></p><% } %>
        <% if (ev.eventType === 'information_requested' || ev.eventType === 'rejection' || ev.eventType === 'approval') { %>
        <% if (ev.deliveryHint) { %>
        <p class="bb-pa-hint" data-ac-delivery-status="<%= ev.deliveryStatus || 'sending_unavailable' %>"><%= ev.deliveryHint %></p>
        <% } %>
        <% } %>
      </li>
      <% }) %>
    </ol>
  </section>
</section>
<%- include('../partials/platform-admin-shell-end') %>
