<%- include('../partials/platform-admin-shell-start') %>
<%
  var app = application || {};
  var rq = (typeof registrationQueue !== 'undefined' && registrationQueue) ? registrationQueue : null;
  function displayOrMissing(value) {
    if (value == null) return null;
    var s = String(value).trim();
    return s ? s : null;
  }
  var churchName = displayOrMissing(app.churchName) || 'Church registration';
  var planLabel = displayOrMissing(app.selectedPlanLabel) || displayOrMissing(app.selectedPlan);
  var contactName = displayOrMissing(app.contactName);
  var contactEmail = displayOrMissing(app.contactEmail);
  var locationLabel = rq && rq.formatRegistrationLocation
    ? rq.formatRegistrationLocation(app)
    : [displayOrMissing(app.city), displayOrMissing(app.country)].filter(Boolean).join(', ') || null;
  var branchLabel = displayOrMissing(app.branchName) || 'Headquarters';
  var cancelHref = app.id
    ? ('/admin/registration-applications/' + encodeURIComponent(String(app.id)))
    : '/admin/registration-applications';
  var approveAction = app.id
    ? ('/admin/registration-applications/' + encodeURIComponent(String(app.id)) + '/approve')
    : '#';
  var isNetwork = Boolean(app.networkApproveAvailable) && !app.riskReviewActionsAvailable;
  var dupWarning = (typeof duplicateWarning !== 'undefined' && duplicateWarning) ? duplicateWarning : null;
  if (!dupWarning) {
    dupWarning = { show: false, match: null, listHref: null, advisory: true };
  }
  var showDupWarning = Boolean(dupWarning && dupWarning.show && dupWarning.match);
  var dupMatch = showDupWarning ? dupWarning.match : null;
  var suggested = (typeof suggestedOrganizationKey !== 'undefined' && suggestedOrganizationKey)
    ? suggestedOrganizationKey
    : { key: null, publicPath: null, publicUrlPreview: null };
  var flashError = typeof error !== 'undefined' ? error : null;
  function errorText(code) {
    if (code === 'csrf') return 'Invalid or missing security token. Reload and try again.';
    if (code === 'not_eligible') return 'This registration cannot be approved right now.';
    if (code === 'duplicate_email_review') return 'This email still needs duplicate review before provisioning can continue.';
    if (code === 'identity_conflict') return 'The administrator email belongs to an account that cannot safely own this church.';
    if (code === 'provision_failed') return 'Provisioning failed. No organization was created.';
    if (code === 'network_validation_required') return 'Network validation must be completed before creating the organization.';
    if (code === 'administrator_email_required') return 'Administrator email is required.';
    if (code === 'approve_failed') return 'Approval could not be completed. Try again from the review page.';
    return code ? 'Something went wrong.' : null;
  }
  var errorMsg = errorText(flashError);
%>

<section
  class="bb-pa-org-detail bb-pa-reg-approve-confirm"
  data-bb-pa-reg-approve-confirm="1"
  data-bb-pa-reg-dup-warning="<%= showDupWarning ? '1' : '0' %>"
  aria-label="Approve church confirmation"
>
  <nav class="bb-pa-org-detail__crumb" aria-label="Breadcrumb">
    <a class="bb-pa-link" href="<%= cancelHref %>" data-bb-pa-reg-approve-cancel="1">Cancel</a>
    <span aria-hidden="true">/</span>
    <span>Confirm approval</span>
  </nav>

  <% if (errorMsg) { %>
  <div class="bb-pa-flash bb-pa-flash--error" role="alert"><%= errorMsg %></div>
  <% } %>

  <% if (showDupWarning && dupMatch) { %>
  <aside class="bb-pa-reg-hub__dup bb-pa-reg-approve-confirm__dup" data-bb-pa-reg-dup-banner="1" role="status">
    <h2 class="bb-pa-reg-hub__dup-title">Possible duplicate church found</h2>
    <p class="bb-pa-hint">
      Duplicate evidence is advisory unless backend policy already blocks this approval.
      Confirming approval does not change duplicate review state by itself.
    </p>
    <dl class="bb-pa-dl">
      <div>
        <dt>Matching record</dt>
        <dd data-bb-pa-reg-dup-name="1"><%= dupMatch.name %></dd>
      </div>
      <% if (dupMatch.location) { %>
      <div>
        <dt>Location</dt>
        <dd><%= dupMatch.location %></dd>
      </div>
      <% } %>
      <div>
        <dt>Match reason</dt>
        <dd data-bb-pa-reg-dup-reason="1"><%= dupMatch.reason %></dd>
      </div>
    </dl>
    <% if (dupMatch.existingHref) { %>
    <p>
      <a class="bb-pa-link" href="<%= dupMatch.existingHref %>" data-bb-pa-reg-dup-view-existing="1">View existing church or registration</a>
    </p>
    <% } %>
  </aside>
  <% } %>

  <header class="bb-pa-page-head">
    <p class="bb-pa-org-detail__eyebrow">Confirmation required</p>
    <h1 class="bb-pa-page-head__title">Approve registration</h1>
    <p class="bb-pa-lede">
      Review the church details before final approval. This creates their organization now — there is no background job.
    </p>
  </header>

  <section class="bb-pa-panel bb-pa-reg-approve-confirm__summary" aria-labelledby="reg-approve-summary-title">
    <h2 id="reg-approve-summary-title" class="bb-pa-section-title">Church summary</h2>
    <dl class="bb-pa-dl">
      <div>
        <dt>Church name</dt>
        <dd data-bb-pa-reg-approve-church="1"><%= churchName %></dd>
      </div>
      <% if (planLabel) { %>
      <div>
        <dt>Selected plan</dt>
        <dd data-bb-pa-reg-approve-plan="1"><%= planLabel %></dd>
      </div>
      <% } %>
      <% if (contactName || contactEmail) { %>
      <div>
        <dt>Applicant / main contact</dt>
        <dd data-bb-pa-reg-approve-contact="1">
          <% if (contactName) { %><%= contactName %><% } %>
          <% if (contactName && contactEmail) { %> · <% } %>
          <% if (contactEmail) { %><span class="bb-pa-reg-hub__email"><%= contactEmail %></span><% } %>
        </dd>
      </div>
      <% } %>
      <% if (locationLabel) { %>
      <div>
        <dt>Main location</dt>
        <dd data-bb-pa-reg-approve-location="1"><%= locationLabel %></dd>
      </div>
      <% } %>
      <div>
        <dt>Proposed first branch</dt>
        <dd data-bb-pa-reg-approve-branch="1"><%= branchLabel %></dd>
      </div>
      <% if (suggested && suggested.key) { %>
      <div>
        <dt>Organization key (auto)</dt>
        <dd data-bb-pa-reg-approve-org-key-preview="1"><code class="bb-pa-key"><%= suggested.key %></code></dd>
      </div>
      <div>
        <dt>Public website preview</dt>
        <dd data-bb-pa-reg-approve-public-url-preview="1">
          <code><%= suggested.publicUrlPreview || suggested.publicPath %></code>
        </dd>
      </div>
      <% } %>
    </dl>
    <p class="bb-pa-hint" data-bb-pa-reg-approve-key-hint="1">
      The final organization key is allocated during provisioning. The preview above is illustrative unless you override it below.
    </p>
  </section>

  <section class="bb-pa-panel" aria-labelledby="reg-approve-next-title">
    <h2 id="reg-approve-next-title" class="bb-pa-section-title">What happens next</h2>
    <ul class="bb-pa-reg-approve-confirm__list" data-bb-pa-reg-approve-effects="1">
      <li>Create the organization</li>
      <li>Create the church and first branch</li>
      <li>Prepare an HQ administrator invitation for you to copy</li>
      <li>Publish the Foundation public miniwebsite when provisioning succeeds</li>
    </ul>
    <p class="bb-pa-hint" data-bb-pa-reg-approve-no-email="1">
      Approval does not send an automated welcome email and does not activate the administrator account immediately.
      The administrator sets a password when they accept the invitation.
      <% if (isNetwork) { %>
      Network plan activation remains a separate billing step on the organization page.
      <% } %>
    </p>
  </section>

  <form
    class="bb-pa-form bb-pa-reg-approve-confirm__form"
    method="post"
    action="<%= approveAction %>"
    data-bb-pa-approve-confirm-form="1"
    data-bb-pa-approve-form="1"
  >
    <input type="hidden" name="<%= csrfField || '_csrf' %>" value="<%= csrfToken || '' %>" />

    <div class="bb-pa-field">
      <label for="reviewer_note">Reviewer note (optional)</label>
      <textarea
        id="reviewer_note"
        name="reviewer_note"
        rows="3"
        maxlength="2000"
        data-bb-pa-reg-approve-reviewer-note="1"
        placeholder="Internal note for audit trail (not emailed)."
      ></textarea>
    </div>

    <details
      class="bb-pa-reg-approve-confirm__advanced"
      data-bb-pa-reg-approve-advanced="1"
      data-bb-pa-reg-approve-org-key-collapsed="1"
    >
      <summary>Advanced: organization key override (optional)</summary>
      <div class="bb-pa-field bb-pa-reg-approve-confirm__org-key">
        <label for="organization_key">Organization key override</label>
        <input
          id="organization_key"
          name="organization_key"
          type="text"
          maxlength="80"
          autocomplete="off"
          placeholder="<%= (suggested && suggested.key) ? suggested.key : 'leave blank for auto-allocate' %>"
          data-bb-pa-reg-approve-org-key="1"
        />
        <p class="bb-pa-hint">
          Leave blank to auto-allocate a unique key during provisioning. Override only when you need a specific
          <code>/c/…</code> public path. Most approvals should leave this closed and empty.
        </p>
      </div>
    </details>

    <div class="bb-pa-reg-approve-confirm__actions">
      <button
        class="bb-pa-btn bb-pa-btn--primary bb-pa-btn--block"
        type="submit"
        data-bb-pa-approve-confirm-submit="1"
      >Confirm approval</button>
      <a
        class="bb-pa-btn bb-pa-btn--secondary bb-pa-btn--block"
        href="<%= cancelHref %>"
        data-bb-pa-reg-approve-cancel-btn="1"
      >Cancel</a>
    </div>
  </form>

  <div
    class="bb-pa-reg-approve-processing"
    data-bb-pa-reg-approve-processing="1"
    hidden
    aria-hidden="true"
  >
    <div class="bb-pa-reg-approve-processing__frame" role="status" aria-live="polite" aria-busy="true">
      <div class="bb-pa-reg-approve-processing__secure" data-bb-pa-reg-approve-processing-secure="1">
        <span>Secure processing</span>
      </div>
      <div class="bb-pa-reg-approve-processing__card">
        <div class="bb-pa-reg-approve-processing__bar" aria-hidden="true">
          <span class="bb-pa-reg-approve-processing__bar-fill"></span>
        </div>
        <h2 class="bb-pa-reg-approve-processing__title">Creating church account</h2>
        <p class="bb-pa-lede" data-bb-pa-reg-approve-processing-church="1">
          Setting up <strong><%= churchName %></strong>. Waiting for the server to finish the approval transaction.
        </p>
        <ol class="bb-pa-reg-approve-processing__steps" data-bb-pa-reg-approve-processing-steps="1">
          <li data-step="org" data-state="pending">Creating church organization…</li>
          <li data-step="branch" data-state="pending">Creating first branch…</li>
          <li data-step="invite" data-state="pending">Preparing administrator invitation…</li>
          <li data-step="site" data-state="pending">Publishing public miniwebsite when ready…</li>
        </ol>
        <p class="bb-pa-hint" data-bb-pa-reg-approve-processing-honest="1">
          Progress is not marked complete until the server replies. Refreshing this page cancels the waiting UI — check the registration or organization page if you already submitted.
        </p>
        <p class="bb-pa-reg-approve-processing__sync" aria-hidden="true">System processing</p>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var form = document.querySelector('[data-bb-pa-approve-confirm-form="1"]');
  if (!form) return;
  var submitBtn = form.querySelector('[data-bb-pa-approve-confirm-submit="1"]');
  var cancelBtn = form.querySelector('[data-bb-pa-reg-approve-cancel-btn="1"]');
  var processing = document.querySelector('[data-bb-pa-reg-approve-processing="1"]');
  var submitting = false;
  var storageKey = 'bb-pa-reg-approve-pending:' + (form.getAttribute('action') || '');

  try {
    if (sessionStorage.getItem(storageKey) === '1' && processing) {
      processing.hidden = false;
      processing.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('bb-pa-reg-approve-processing-active');
      var honest = processing.querySelector('[data-bb-pa-reg-approve-processing-honest="1"]');
      if (honest) {
        honest.textContent =
          'A previous approval submit may still be finishing. If this screen persists, open the registration or organization page to confirm the result.';
      }
    }
  } catch (e) {}

  form.addEventListener('submit', function (event) {
    if (submitting) {
      event.preventDefault();
      return false;
    }
    submitting = true;
    try { sessionStorage.setItem(storageKey, '1'); } catch (e) {}
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-busy', 'true');
      submitBtn.textContent = 'Confirming…';
    }
    if (cancelBtn) {
      cancelBtn.setAttribute('aria-disabled', 'true');
      cancelBtn.classList.add('bb-pa-btn--disabled');
      cancelBtn.addEventListener('click', function (ev) { ev.preventDefault(); }, { once: true });
    }
    if (processing) {
      processing.hidden = false;
      processing.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('bb-pa-reg-approve-processing-active');
    }
  });

  window.addEventListener('pageshow', function () {
    try { sessionStorage.removeItem(storageKey); } catch (e) {}
  });
})();
</script>

<%- include('../partials/platform-admin-shell-end') %>
