<%- include('../partials/member-shell-start') %>
<%
  var p = typeof profile !== 'undefined' && profile ? profile : {};
  var addr = p.address || {};
  var kin = p.nextOfKin || {};
  var legalName = [p.firstName, p.lastName].filter(Boolean).join(' ') || '—';
  var displayHeading = p.preferredName || legalName;
  var initialsSource = [p.firstName, p.lastName].filter(Boolean);
  var initials = initialsSource
    .map(function (part) { return String(part).charAt(0); })
    .join('')
    .slice(0, 2)
    .toUpperCase();
  if (!initials) initials = String(displayHeading || '?').charAt(0).toUpperCase();
  var membershipLabel = p.membershipStatus === 'active' ? 'Active' : (p.membershipStatus || '—');
  var membershipChipClass = p.membershipStatus === 'active'
    ? 'bb-mp-chip bb-mp-chip--active'
    : 'bb-mp-chip bb-mp-chip--pending';
  function fmtDob(v) {
    if (!v) return '—';
    try {
      var d = v instanceof Date ? v : new Date(v);
      if (Number.isNaN(d.getTime())) return String(v);
      return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    } catch (_e) { return String(v); }
  }
  function residenceLine() {
    var parts = [addr.line1, addr.line2, addr.city, addr.district, addr.province, addr.countryCode]
      .filter(Boolean);
    return parts.length ? parts.join(', ') : '—';
  }
%>

<section
  class="bb-mp-profile bb-v204-m21"
  data-bb-member-profile="1"
  data-bb-stitch-v204="BB-M21"
  data-bb-stitch-profile="15-member-profile"
  data-bb-stitch-profile-v204="BB-M21"
  data-bb-profile-header="1"
  data-bb-profile-readonly="1"
>
  <header class="bb-mp-page-head bb-mp-page-head--split">
    <div>
      <h1 class="bb-mp-page-head__title">My Parish Profile</h1>
      <p class="bb-mp-lede">
        Your details at
        <strong><%= churchDisplayName %></strong><% if (branchDisplayName) { %>
        · <%= branchDisplayName %><% } %>.
        Church ID and official membership branch are managed by your church.
      </p>
    </div>
    <div class="bb-mp-page-head__actions">
      <a class="bb-mp-btn bb-mp-btn--primary" href="/member/profile/edit">
        <span class="material-symbols-outlined" aria-hidden="true">edit</span>
        Edit profile
      </a>
    </div>
  </header>

  <% if (saved) { %>
  <p class="bb-mp-ok" role="status">Profile saved<% if (typeof phoneVerified !== 'undefined' && phoneVerified) { %>. Phone verified<% } %>.</p>
  <% } %>

  <article class="bb-mp-panel bb-mp-profile__header" data-bb-profile-header="1">
    <div class="bb-mp-profile__avatar" aria-hidden="true"><%= initials %></div>
    <div class="bb-mp-profile__identity">
      <p class="bb-mp-badge" data-bb-member-verified="1">
        <span class="material-symbols-outlined" aria-hidden="true">verified</span>
        Verified member
      </p>
      <h2 class="bb-mp-profile__name"><%= displayHeading %></h2>
      <p class="bb-mp-profile__meta">
        Church ID <strong><%= p.memberNumber || '—' %></strong>
        <% if (branchDisplayName) { %> · <%= branchDisplayName %><% } %>
      </p>
      <div class="bb-mp-profile__status" aria-label="Membership status">
        <span class="<%= membershipChipClass %>">
          <span class="material-symbols-outlined" aria-hidden="true">badge</span>
          <%= membershipLabel %> membership
        </span>
        <% if (p.isPrimaryBranch) { %>
        <span class="bb-mp-chip bb-mp-chip--member">Primary branch</span>
        <% } %>
        <% if (p.phoneVerificationRequired) { %>
        <a class="bb-mp-chip bb-mp-chip--pending" href="/member/profile/phone-verify?send=1">Phone verification pending</a>
        <% } %>
      </div>
    </div>
  </article>

  <div class="bb-mp-profile__grid bb-mp-profile__grid--m21">
    <article class="bb-mp-panel">
      <h2 class="bb-mp-panel__title">
        <span class="material-symbols-outlined" aria-hidden="true">lock</span>
        Church-managed
      </h2>
      <dl class="bb-mp-kv bb-mp-kv--profile">
        <div class="bb-mp-kv__item bb-mp-kv__item--readonly">
          <dt>Church ID</dt>
          <dd data-bb-church-id="1"><%= p.memberNumber || '—' %></dd>
        </div>
        <div class="bb-mp-kv__item bb-mp-kv__item--readonly">
          <dt>Official branch</dt>
          <dd><%= branchDisplayName || '—' %></dd>
        </div>
        <div class="bb-mp-kv__item bb-mp-kv__item--readonly">
          <dt>Membership</dt>
          <dd><%= membershipLabel %></dd>
        </div>
      </dl>
      <p class="bb-mp-lock-note">
        <strong>Member ID is read-only</strong>
        Church ID is issued by your church and synced with the membership register. Branch changes require a pastoral transfer workflow.
      </p>
    </article>

    <article class="bb-mp-panel">
      <h2 class="bb-mp-panel__title">
        <span class="material-symbols-outlined" aria-hidden="true">person</span>
        Personal
      </h2>
      <dl class="bb-mp-kv bb-mp-kv--profile">
        <div class="bb-mp-kv__item"><dt>Name</dt><dd><%= legalName %></dd></div>
        <div class="bb-mp-kv__item"><dt>Preferred name</dt><dd><%= p.preferredName || '—' %></dd></div>
        <div class="bb-mp-kv__item"><dt>Date of birth</dt><dd><%= fmtDob(p.dateOfBirth) %></dd></div>
        <div class="bb-mp-kv__item"><dt>Occupation</dt><dd><%= p.occupation || '—' %></dd></div>
        <div class="bb-mp-kv__item"><dt>Marital status</dt><dd><%= p.maritalStatus ? String(p.maritalStatus).replace(/_/g, ' ') : '—' %></dd></div>
        <div class="bb-mp-kv__item"><dt>Children</dt><dd><%= p.numberOfChildren == null ? '—' : p.numberOfChildren %></dd></div>
      </dl>
    </article>

    <article class="bb-mp-panel">
      <h2 class="bb-mp-panel__title">
        <span class="material-symbols-outlined" aria-hidden="true">call</span>
        Contact
      </h2>
      <dl class="bb-mp-kv bb-mp-kv--profile">
        <div class="bb-mp-kv__item"><dt>Phone</dt><dd><%= p.phoneDisplay || p.phoneNormalized || '—' %></dd></div>
        <% if (p.phonePendingNormalized) { %>
        <div class="bb-mp-kv__item">
          <dt>Pending phone</dt>
          <dd><%= p.phonePendingDisplay || p.phonePendingNormalized %> · <a href="/member/profile/phone-verify?send=1">Verify</a></dd>
        </div>
        <% } %>
        <div class="bb-mp-kv__item"><dt>Email</dt><dd><%= p.emailDisplay || p.emailNormalized || '—' %></dd></div>
        <div class="bb-mp-kv__item"><dt>Residence</dt><dd><%= residenceLine() %></dd></div>
      </dl>
    </article>

    <article class="bb-mp-panel">
      <h2 class="bb-mp-panel__title">
        <span class="material-symbols-outlined" aria-hidden="true">emergency</span>
        Emergency / next of kin
      </h2>
      <dl class="bb-mp-kv bb-mp-kv--profile">
        <div class="bb-mp-kv__item"><dt>Name</dt><dd><%= kin.name || '—' %></dd></div>
        <div class="bb-mp-kv__item"><dt>Relationship</dt><dd><%= kin.relationship || '—' %></dd></div>
        <div class="bb-mp-kv__item"><dt>Phone</dt><dd><%= kin.phoneDisplay || kin.phoneNormalized || '—' %></dd></div>
      </dl>
    </article>
  </div>
</section>

<%- include('../partials/member-shell-end') %>
