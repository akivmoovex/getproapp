<%- include('../partials/member-shell-start') %>
<%
  var fe = typeof fieldErrors !== 'undefined' && fieldErrors ? fieldErrors : {};
  var summaryItems = typeof errorSummaryItems !== 'undefined' && errorSummaryItems && errorSummaryItems.length
    ? errorSummaryItems
    : (error ? [error] : []);
  var hasErrors = Boolean(error) || summaryItems.length > 0;
  var showEdit = Boolean(editMode) || hasErrors;
  var legalName = [profile.firstName, profile.lastName].filter(Boolean).join(' ') || '—';
  var displayHeading = profile.preferredName || legalName;
  var initialsSource = [profile.firstName, profile.lastName].filter(Boolean);
  var initials = initialsSource
    .map(function (part) { return String(part).charAt(0); })
    .join('')
    .slice(0, 2)
    .toUpperCase();
  if (!initials) {
    initials = String(displayHeading || '?').charAt(0).toUpperCase();
  }
  var membershipLabel = profile.membershipStatus === 'active'
    ? 'Active'
    : (profile.membershipStatus || '—');
  var membershipChipClass = profile.membershipStatus === 'active'
    ? 'bb-mp-chip bb-mp-chip--active'
    : 'bb-mp-chip bb-mp-chip--pending';
  function fieldDescribedBy(key, extraIds) {
    var ids = [];
    if (fe[key]) ids.push('err-' + key);
    if (extraIds) ids = ids.concat(extraIds);
    return ids.length ? ids.join(' ') : null;
  }
%>

<section
  class="bb-mp-profile"
  data-bb-member-profile="1"
  data-bb-stitch-profile="15-member-profile"
>
  <header class="bb-mp-page-head bb-mp-page-head--split">
    <div>
      <h1 class="bb-mp-page-head__title">Member Profile</h1>
      <p class="bb-mp-lede">
        Your details at
        <strong><%= churchDisplayName %></strong><% if (branchDisplayName) { %>
        · <%= branchDisplayName %><% } %>.
        Membership and legal identity are managed by your church.
      </p>
    </div>
    <div class="bb-mp-page-head__actions">
      <% if (!showEdit) { %>
      <a class="bb-mp-btn bb-mp-btn--primary" href="/member/profile?edit=1#profile-form">
        <span class="material-symbols-outlined" aria-hidden="true">edit</span>
        Edit Profile
      </a>
      <% } %>
    </div>
  </header>

  <% if (saved) { %>
  <p class="bb-mp-ok" role="status">Profile saved.</p>
  <% } %>

  <article class="bb-mp-panel bb-mp-profile__header" data-bb-profile-header="1">
    <div class="bb-mp-profile__avatar" aria-hidden="true"><%= initials %></div>
    <div class="bb-mp-profile__identity">
      <p class="bb-mp-badge" data-bb-member-verified="1">
        <span class="material-symbols-outlined" aria-hidden="true">verified</span>
        Verified Member
      </p>
      <h2 class="bb-mp-profile__name"><%= displayHeading %></h2>
      <p class="bb-mp-profile__meta">
        <%= churchDisplayName %><% if (branchDisplayName) { %> · <%= branchDisplayName %><% } %>
      </p>
      <div class="bb-mp-profile__status" aria-label="Membership status">
        <span class="<%= membershipChipClass %>" data-bb-membership-status="<%= profile.membershipStatus || '' %>">
          <span class="material-symbols-outlined" aria-hidden="true">badge</span>
          <%= membershipLabel %> membership
        </span>
        <% if (profile.isPrimaryBranch) { %>
        <span class="bb-mp-chip bb-mp-chip--member">Primary branch</span>
        <% } %>
      </div>
    </div>
  </article>

  <div class="bb-mp-profile__grid">
    <article class="bb-mp-panel" data-bb-profile-readonly="1">
      <h2 class="bb-mp-panel__title" id="bb-mp-profile-readonly-heading">
        <span class="material-symbols-outlined" aria-hidden="true">badge</span>
        Personal Information
      </h2>
      <p class="bb-mp-profile__group-note">
        <span class="bb-mp-chip bb-mp-chip--readonly">Read-only</span>
        Managed by your church — these fields cannot be changed here.
      </p>
      <dl class="bb-mp-kv bb-mp-kv--profile" aria-labelledby="bb-mp-profile-readonly-heading">
        <div class="bb-mp-kv__item bb-mp-kv__item--readonly">
          <dt>Legal Name</dt>
          <dd><%= legalName %></dd>
        </div>
        <div class="bb-mp-kv__item bb-mp-kv__item--readonly">
          <dt>Sign-in email</dt>
          <dd><%= profile.emailNormalized || '—' %></dd>
        </div>
        <div class="bb-mp-kv__item bb-mp-kv__item--readonly">
          <dt>Membership</dt>
          <dd><%= membershipLabel %></dd>
        </div>
      </dl>
    </article>

    <article class="bb-mp-panel bb-mp-profile__contact" id="profile-form" data-bb-profile-form="1">
      <h2 class="bb-mp-panel__title" id="bb-mp-profile-editable-heading">
        <span class="material-symbols-outlined" aria-hidden="true">edit_note</span>
        Contact details
      </h2>
      <p class="bb-mp-profile__group-note">
        <% if (showEdit) { %>
        <span class="bb-mp-chip bb-mp-chip--editable">Editable</span>
        Update preferred name, display email, and phone. Legal name and sign-in email stay with your church record.
        <% } else { %>
        <span class="bb-mp-chip bb-mp-chip--editable">Editable</span>
        Preferred name, display email, and phone can be updated with Edit Profile. Legal name and sign-in email stay with your church record.
        <% } %>
      </p>

      <% if (hasErrors) { %>
      <div class="bb-mp-alert bb-mp-alert--error" role="alert" id="profile-error-summary" tabindex="-1">
        <p class="bb-mp-alert__title">We could not save your profile</p>
        <ul>
          <% summaryItems.forEach(function (item) { %>
          <li><%= item %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <form
        method="post"
        action="/member/profile"
        class="bb-mp-form bb-mp-form--panel bb-mp-form--profile<%= showEdit ? '' : ' is-view' %>"
        aria-labelledby="bb-mp-profile-editable-heading"
        novalidate
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="bb-mp-form__grid">
          <div class="bb-mp-field<%= fe.preferredName ? ' is-invalid' : '' %>">
            <label for="preferredName">Preferred name</label>
            <input
              id="preferredName"
              name="preferredName"
              type="text"
              maxlength="100"
              value="<%= profile.preferredName || '' %>"
              autocomplete="nickname"
              <%= showEdit ? '' : 'readonly' %>
              <% if (fe.preferredName) { %>aria-invalid="true" aria-describedby="<%= fieldDescribedBy('preferredName') %>"<% } %>
            />
            <% if (fe.preferredName) { %>
            <p class="bb-mp-field__error" id="err-preferredName"><%= fe.preferredName %></p>
            <% } %>
          </div>

          <div class="bb-mp-field<%= fe.phone ? ' is-invalid' : '' %>">
            <label for="phone">Mobile phone number</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              maxlength="32"
              value="<%= profile.phoneDisplay || profile.phoneNormalized || '' %>"
              placeholder="+260…"
              autocomplete="tel"
              <%= showEdit ? '' : 'readonly' %>
              <% if (fe.phone) { %>aria-invalid="true" aria-describedby="<%= fieldDescribedBy('phone') %>"<% } %>
            />
            <p class="bb-mp-hint">Used for login and invitations. Email remains optional for notifications.</p>
            <% if (fe.phone) { %>
            <p class="bb-mp-field__error" id="err-phone"><%= fe.phone %></p>
            <% } %>
          </div>

          <div class="bb-mp-field<%= fe.emailDisplay ? ' is-invalid' : '' %>">
            <label for="emailDisplay">Email address, optional</label>
            <input
              id="emailDisplay"
              name="emailDisplay"
              type="email"
              maxlength="254"
              value="<%= profile.emailDisplay || profile.emailNormalized || '' %>"
              autocomplete="email"
              <%= showEdit ? '' : 'readonly' %>
              <% if (fe.emailDisplay) { %>aria-invalid="true" aria-describedby="<%= fieldDescribedBy('emailDisplay', ['hint-emailDisplay']) %>"<% } else { %>aria-describedby="hint-emailDisplay"<% } %>
            />
            <p class="bb-mp-hint" id="hint-emailDisplay">Used for additional notifications. Your sign-in identifier stays the same until phone verification is complete.</p>
            <% if (fe.emailDisplay) { %>
            <p class="bb-mp-field__error" id="err-emailDisplay"><%= fe.emailDisplay %></p>
            <% } %>
          </div>
        </div>

        <div class="bb-mp-form__actions">
          <% if (showEdit) { %>
          <button type="submit" class="bb-mp-btn bb-mp-btn--primary">Save profile</button>
          <a class="bb-mp-btn bb-mp-btn--ghost" href="/member/profile">Cancel</a>
          <% } %>
        </div>
      </form>
    </article>
  </div>
</section>

<%- include('../partials/member-shell-end') %>
