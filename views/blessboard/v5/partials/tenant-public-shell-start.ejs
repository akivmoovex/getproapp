<%#
  BlessBoard V5 tenant public shell — document start + sticky header + mobile drawer.
  Stage 4: branch mini-site identity + switcher; Stitch public home shell tokens.
  Locals: seo, publicName, church, branch, websiteScope, branchSwitcher, churchHomeHref,
          navItems, activeNav, loginHref, visitHref, cssHref (optional)
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>" />
  <meta name="robots" content="<%= seo.robots %>" />
  <link rel="canonical" href="<%= seo.canonicalUrl %>" />
  <meta property="og:type" content="<%= seo.ogType %>" />
  <meta property="og:title" content="<%= seo.ogTitle %>" />
  <meta property="og:description" content="<%= seo.ogDescription %>" />
  <meta property="og:url" content="<%= seo.ogUrl %>" />
  <% if (seo.ogSiteName) { %>
  <meta property="og:site_name" content="<%= seo.ogSiteName %>" />
  <% } %>
  <% if (seo.ogImageUrl) { %>
  <meta property="og:image" content="<%= seo.ogImageUrl %>" />
  <% if (seo.ogImageAlt) { %>
  <meta property="og:image:alt" content="<%= seo.ogImageAlt %>" />
  <% } %>
  <% } %>
  <meta name="twitter:card" content="<%= seo.twitterCard %>" />
  <meta name="twitter:title" content="<%= seo.twitterTitle %>" />
  <meta name="twitter:description" content="<%= seo.twitterDescription %>" />
  <% if (seo.twitterImageUrl) { %>
  <meta name="twitter:image" content="<%= seo.twitterImageUrl %>" />
  <% } %>
  <%- include('./head-design-system') %>
  <link rel="stylesheet" href="<%= typeof cssHref !== 'undefined' && cssHref ? cssHref : '/blessboard/v5/tenant-public.css?v=55' %>" />
  <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.canEdit) { %>
  <link rel="stylesheet" href="/platform/website-inline-edit.css?v=v7-website-14" />
  <meta name="csrf-token" content="<%= websiteAdmin.csrfToken %>" />
  <% } %>
</head>
<%
  var _isBranchMini =
    typeof websiteScope !== 'undefined' &&
    websiteScope &&
    String(websiteScope.scopeType || '') === 'branch';
  var _bodyClass = 'bb-tp-body';
  if (typeof isPreview !== 'undefined' && isPreview) _bodyClass += ' bb-tp-body--preview';
  if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.canEdit) _bodyClass += ' bb-tp-body--admin';
  if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) _bodyClass += ' bb-tp-body--editing gp-website-editor-open';
  if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.previewDraftMode) _bodyClass += ' bb-tp-body--preview gp-website-preview-open';
  if (_isBranchMini) _bodyClass += ' bb-tp-body--branch';
  var _stackChrome = typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.canEdit;
%>
<body
  class="<%= _bodyClass %>"
  data-bb-shell="tenant-public"
  data-bb-product="blessboard-v5"
  data-bb-page="<%= pageKey %>"
  <% if (_isBranchMini) { %>data-bb-website-scope="branch"<% } else { %>data-bb-website-scope="church"<% } %>
  <% if (typeof isPreview !== 'undefined' && isPreview) { %>data-bb-preview="1"<% } %>
  <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>data-bb-website-editing="1"<% } %>
  <% if (typeof brandStyle !== 'undefined' && brandStyle) { %>style="<%= brandStyle %>"<% } %>
>
  <a class="bb-tp-skip" href="#bb-tp-main">Skip to content</a>

  <% if (_stackChrome) { %>
  <div class="gp-website-chrome-stack" data-website-chrome-stack="1">
  <%- include('./website-admin-chrome') %>
  </div>
  <% } %>

  <header class="bb-tp-header" data-bb-header="1" id="bb-tp-header">
    <div class="bb-tp-header__inner">
      <%- include('../public/partials/shell-brand', { brandVariant: 'header' }) %>

      <%- include('../public/partials/shell-nav', {
        navClass: 'bb-tp-nav bb-tp-nav--desktop',
        navDataAttr: 'desktop',
        navAriaLabel: 'Primary'
      }) %>

      <div class="bb-tp-header__actions" data-bb-header-actions="1">
        <%- include('../public/partials/branch-switcher', { switcherPlacement: 'header' }) %>
        <% if (showEnvBadge) { %>
        <span class="bb-tp-env"><%= dataEnvironment %></span>
        <% } %>
        <% if (typeof portalHref !== 'undefined' && portalHref) { %>
        <a
          class="bb-tp-btn bb-tp-btn--ghost bb-tp-btn--sm bb-tp-header__login"
          href="<%= portalHref %>"
          data-bb-public-portal="1"
        ><%= typeof portalLabel !== 'undefined' && portalLabel ? portalLabel : 'My Portal' %></a>
        <% } else { %>
        <a
          class="bb-tp-btn bb-tp-btn--ghost bb-tp-btn--sm bb-tp-header__login"
          href="<%= typeof loginHref !== 'undefined' && loginHref ? loginHref : '/login' %>"
          data-bb-public-login="1"
        >Login</a>
        <% } %>
        <%
          var _cta = (typeof navigation !== 'undefined' && navigation && navigation.ctaItem)
            ? navigation.ctaItem
            : null;
          var _ctaHref = _cta && _cta.href
            ? _cta.href
            : (typeof giveHref !== 'undefined' && giveHref
              ? giveHref
              : (typeof visitHref !== 'undefined' && visitHref ? visitHref : (typeof hrefFor === 'function' ? hrefFor('/contact') : '/contact')));
          var _ctaLabel = _cta && _cta.label ? _cta.label : (_cta ? 'Give' : 'Plan Your Visit');
          var _ctaKey = _cta && _cta.key ? _cta.key : (_cta ? 'giving' : 'visit');
          var _ctaActive = _cta ? Boolean(_cta.isActive) : (typeof activeNav !== 'undefined' && activeNav === 'contact');
          if (!_cta && typeof navigation !== 'undefined' && navigation && navigation.ctaItem === null) {
            // Giving intentionally hidden — fall back to visit CTA only when no Give.
            _ctaLabel = 'Plan Your Visit';
            _ctaKey = 'visit';
            _ctaHref = typeof visitHref !== 'undefined' && visitHref
              ? visitHref
              : (typeof hrefFor === 'function' ? hrefFor('/contact') : '/contact');
            _ctaActive = typeof activeNav !== 'undefined' && activeNav === 'contact';
          }
        %>
        <span class="bb-tp-header__visit-wrap" data-bb-header-cta="1">
          <a
            class="bb-tp-btn bb-tp-btn--primary bb-tp-btn--sm bb-tp-header__visit<%= _ctaActive ? ' is-active' : '' %>"
            href="<%= _ctaHref %>"
            data-bb-nav-link="<%= _ctaKey %>"
            data-bb-header-cta-link="1"
            <% if (_ctaActive) { %>aria-current="page"<% } %>
          ><%= _ctaLabel %></a>
          <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
          <%- include('./settings-edit-trigger', {
            settingsLinkId: 'header_cta',
            settingsLabel: 'Edit header CTA',
            settingsClass: 'bb-tp-settings-pencil bb-tp-settings-pencil--compact'
          }) %>
          <% } %>
        </span>
        <button
          type="button"
          class="bb-tp-menu-btn bb-shell-burger"
          id="bb-tp-menu-btn"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="bb-tp-drawer"
          aria-haspopup="dialog"
        >
          <span class="bb-shell-burger__icon" aria-hidden="true">
            <span class="bb-shell-burger__bar"></span>
            <span class="bb-shell-burger__bar"></span>
            <span class="bb-shell-burger__bar"></span>
          </span>
          <span class="bb-shell-burger__label">Menu</span>
        </button>
      </div>
    </div>
  </header>
  <% if (typeof isPreview !== 'undefined' && isPreview && typeof previewMeta !== 'undefined' && previewMeta && !(typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.previewDraftMode)) { %>
  <div class="bb-tp-preview-banner" role="status" data-bb-preview-banner="1">
    <div class="bb-tp-preview-banner__inner">
      <strong><%= previewMeta.bannerLabel || 'Preview' %></strong>
      <span>— <%= previewMeta.bannerDetail || 'Admin preview (includes drafts). Not visible to the public unless published.' %></span>
      <span class="bb-tp-preview-banner__links">
        <% if (previewMeta.backHref) { %>
        <a href="<%= previewMeta.backHref %>">Back</a>
        <% } %>
        <% if (previewMeta.editHref) { %>
        <% if (previewMeta.backHref) { %> · <% } %>
        <a href="<%= previewMeta.editHref %>">Edit page</a>
        <% } %>
      </span>
    </div>
  </div>
  <% } %>

  <div class="bb-tp-drawer-overlay" id="bb-tp-drawer-overlay" hidden></div>
  <aside
    class="bb-tp-drawer"
    id="bb-tp-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Church navigation"
    aria-hidden="true"
    data-bb-nav="mobile-drawer"
    inert
  >
    <div class="bb-tp-drawer__head">
      <%- include('../public/partials/shell-brand', { brandVariant: 'drawer' }) %>
      <button type="button" class="bb-tp-drawer__close" id="bb-tp-drawer-close" aria-label="Close navigation">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>
    <div class="bb-tp-drawer__switcher">
      <%- include('../public/partials/branch-switcher', { switcherPlacement: 'drawer' }) %>
    </div>
    <nav class="bb-tp-drawer__nav" aria-label="Primary">
      <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
      <div class="bb-tp-drawer__nav-edit">
        <%- include('./settings-edit-trigger', {
          settingsLinkId: 'navigation',
          settingsLabel: 'Edit navigation',
          settingsClass: 'bb-tp-settings-pencil bb-tp-settings-pencil--nav'
        }) %>
      </div>
      <% } %>
      <ul class="bb-tp-drawer__list" data-bb-nav="mobile">
        <%
          var _mobileNav = (typeof navigation !== 'undefined' && navigation && navigation.mobileItems && navigation.mobileItems.length)
            ? navigation.mobileItems
            : (navItems || []);
        %>
        <% _mobileNav.forEach(function (item) { %>
        <li class="bb-tp-drawer__item">
          <a
            href="<%= item.href %>"
            class="bb-tp-drawer__link<%= (item.isActive || activeNav === item.key) ? ' is-active' : '' %><%= item.emphasized ? ' bb-tp-drawer__link--cta' : '' %>"
            data-bb-nav-link="<%= item.key %>"
            <% if (item.isActive || activeNav === item.key) { %>aria-current="page"<% } %>
          ><%= item.label %></a>
        </li>
        <% }) %>
      </ul>
    </nav>
    <div class="bb-tp-drawer__actions">
      <%
        var _drawerCta = (typeof navigation !== 'undefined' && navigation && navigation.ctaItem)
          ? navigation.ctaItem
          : null;
        var _drawerCtaHref = _drawerCta && _drawerCta.href
          ? _drawerCta.href
          : (typeof visitHref !== 'undefined' && visitHref ? visitHref : (typeof hrefFor === 'function' ? hrefFor('/contact') : '/contact'));
        var _drawerCtaLabel = _drawerCta && _drawerCta.label ? _drawerCta.label : 'Plan Your Visit';
      %>
      <a
        class="bb-tp-btn bb-tp-btn--primary bb-tp-btn--block"
        href="<%= _drawerCtaHref %>"
        data-bb-nav-link="<%= _drawerCta && _drawerCta.key ? _drawerCta.key : 'visit' %>"
      ><%= _drawerCtaLabel %></a>
      <% if (typeof portalHref !== 'undefined' && portalHref) { %>
      <a
        class="bb-tp-btn bb-tp-btn--ghost bb-tp-btn--block"
        href="<%= portalHref %>"
        data-bb-public-portal="1"
      ><%= typeof portalLabel !== 'undefined' && portalLabel ? portalLabel : 'My Portal' %></a>
      <% } else { %>
      <a
        class="bb-tp-btn bb-tp-btn--ghost bb-tp-btn--block"
        href="<%= typeof loginHref !== 'undefined' && loginHref ? loginHref : '/login' %>"
        data-bb-public-login="1"
      >Login</a>
      <% } %>
      <p class="bb-tp-drawer__powered">Powered by BlessBoard</p>
    </div>
  </aside>

  <% if (typeof usedPublicDemoFill !== 'undefined' && usedPublicDemoFill) { %>
  <div class="bb-tp-template-banner" role="status" data-bb-template-example="1">
    Template examples — these names, events, and ministries are not this church’s published facts. Replace them in Website management.
  </div>
  <% } %>

  <main id="bb-tp-main" class="bb-tp-main" tabindex="-1" data-bb-main="1">
