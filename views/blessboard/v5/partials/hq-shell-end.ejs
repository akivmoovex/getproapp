</div>
</main>
<%
  var hqNavEnd = (typeof navItems !== 'undefined' && navItems && navItems.length)
    ? navItems
    : [
        { key: 'home', label: 'Dashboard', href: '/hq', icon: 'dashboard' },
        { key: 'branches', label: 'Branches', href: '/hq/branches', icon: 'apartment' },
        { key: 'registrations', label: 'Registrations', href: '/hq/registrations', icon: 'how_to_reg' },
        { key: 'members', label: 'Members', href: '/hq/members', icon: 'badge' },
        { key: 'settings', label: 'Settings', href: '/hq/settings', icon: 'settings' },
        { key: 'content', label: 'Website', href: '/hq/content', icon: 'language' },
        { key: 'announcements', label: 'Announcements', href: '/hq/announcements', icon: 'campaign' },
        { key: 'participation', label: 'Participation', href: '/hq/participation', icon: 'groups' },
        { key: 'attendance', label: 'Attendance', href: '/hq/attendance', icon: 'fact_check' },
        { key: 'giving', label: 'Giving', href: '/hq/giving', icon: 'payments' },
        { key: 'resources', label: 'Resources', href: '/hq/resources', icon: 'menu_book' },
        { key: 'forms', label: 'Forms', href: '/hq/forms', icon: 'description' },
        { key: 'requests', label: 'Requests', href: '/hq/requests', icon: 'inbox' },
        { key: 'reports', label: 'Reports', href: '/hq/reports', icon: 'analytics' },
        { key: 'audit', label: 'Audit', href: '/hq/audit', icon: 'history' },
        { key: 'account', label: 'Account', href: '/hq/account', icon: 'person' },
      ];
  var hqTabsEnd = (typeof mobileTabs !== 'undefined' && mobileTabs && mobileTabs.length)
    ? mobileTabs
    : hqNavEnd.filter(function (item) {
        return ['home', 'branches', 'reports', 'account'].indexOf(item.key) !== -1;
      });
%>

      <nav class="bb-hq-bottom" aria-label="HQ primary" data-bb-nav="mobile-tabs">
        <% hqTabsEnd.forEach(function (item) { %>
        <a
          href="<%= item.href %>"
          class="bb-hq-bottom__link<%= activeNav === item.key ? ' is-active' : '' %>"
          <%= activeNav === item.key ? 'aria-current="page"' : '' %>
        >
          <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
          <span><%= item.label %></span>
        </a>
        <% }) %>
      </nav>

      <footer class="bb-hq-footer" data-bb-footer="1">
        <%- include('./powered-by-getpro') %>
      </footer>
    </div>
  </div>

  <script src="/blessboard/v5/shell-nav.js?v=2" defer></script>
  <script src="/blessboard/v5/design-system.js?v=3" defer></script>
  <script src="/blessboard/v5/hq-admin.js?v=3" defer></script>
  <% if (typeof loadMediaPicker !== 'undefined' && loadMediaPicker) { %>
  <script src="/blessboard/v5/media-picker.js?v=6" defer></script>
  <% } %>
</body>
</html>
