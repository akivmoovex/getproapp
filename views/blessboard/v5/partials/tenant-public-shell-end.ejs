<%#
  BlessBoard V5 tenant public shell — footer + scripts.
  Stage 4: branch identity, contact summary, branch-aware quick links.
%>
<%
  var _isBranchMini =
    typeof websiteScope !== 'undefined' &&
    websiteScope &&
    String(websiteScope.scopeType || '') === 'branch';
  var _churchName =
    (typeof publicName !== 'undefined' && publicName)
      ? String(publicName)
      : ((typeof church !== 'undefined' && church && church.displayName)
        ? String(church.displayName)
        : 'Church');
  var _branchName =
    _isBranchMini && typeof branch !== 'undefined' && branch && branch.displayName
      ? String(branch.displayName)
      : '';
  var _footerNav = (typeof footerNavItems !== 'undefined' && footerNavItems && footerNavItems.length)
    ? footerNavItems
    : ((typeof navigation !== 'undefined' && navigation && navigation.footerItems && navigation.footerItems.length)
      ? navigation.footerItems
      : ((typeof navItems !== 'undefined' && navItems && navItems.length)
        ? navItems
        : [
            { href: '/', label: 'Home', key: 'home' },
            { href: '/about', label: 'About', key: 'about' },
            { href: '/contact', label: 'Contact', key: 'contact' }
          ]));
  function footerDayLabel(day) {
    var d = String(day || '');
    if (!d) return '';
    return d.charAt(0).toUpperCase() + d.slice(1);
  }
  function footerTimeLabel(hhmm) {
    var m = /^([01]?\d|2[0-3]):([0-5]\d)$/.exec(String(hhmm || ''));
    if (!m) return String(hhmm || '');
    var h = Number(m[1]);
    var min = m[2];
    var ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12;
    if (h === 0) h = 12;
    return h + ':' + min + ' ' + ampm;
  }
  var footerServices = (typeof serviceTimesEntries !== 'undefined' && serviceTimesEntries) ? serviceTimesEntries : [];
%>
  </main>

  <footer class="bb-tp-footer" data-bb-footer="1">
    <div class="bb-tp-footer__inner">
      <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
      <div class="bb-tp-footer__edit-bar" data-bb-footer-edits="1">
        <%- include('./settings-edit-trigger', {
          settingsLinkId: 'footer',
          settingsLabel: 'Edit footer',
          settingsClass: 'bb-tp-settings-pencil'
        }) %>
        <%- include('./settings-edit-trigger', {
          settingsLinkId: 'contact',
          settingsLabel: 'Edit contact details',
          settingsClass: 'bb-tp-settings-pencil'
        }) %>
        <%- include('./settings-edit-trigger', {
          settingsLinkId: 'service_times',
          settingsLabel: 'Edit service times',
          settingsClass: 'bb-tp-settings-pencil'
        }) %>
        <%- include('./settings-edit-trigger', {
          settingsLinkId: 'social',
          settingsLabel: 'Edit social links',
          settingsClass: 'bb-tp-settings-pencil'
        }) %>
        <%- include('./settings-edit-trigger', {
          settingsLinkId: 'announcement',
          settingsLabel: 'Edit announcement',
          settingsClass: 'bb-tp-settings-pencil'
        }) %>
      </div>
      <% } %>
      <div class="bb-tp-footer__grid bb-tp-footer__grid--phase7">
        <div class="bb-tp-footer__brand">
          <div class="bb-tp-footer__brand-lockup">
            <img
              class="bb-tp-footer__mark"
              src="/church/images/brand/blessboard-small-church-logo.png"
              alt=""
              width="28"
              height="28"
              decoding="async"
              data-bb-platform-logo="1"
            />
            <div class="bb-tp-footer__brand-text">
              <p class="bb-tp-footer__name" data-bb-church-name="1"><%= _churchName %></p>
              <% if (_branchName) { %>
              <p class="bb-tp-footer__branch" data-bb-branch-name="1"><%= _branchName %></p>
              <% } %>
              <% if ((typeof footerTagline !== 'undefined' && footerTagline) || (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode)) { %>
              <%- include('./editable-text', {
                editPageKey: 'home',
                editSectionKey: 'footer',
                editFieldKey: 'tagline',
                editValue: (typeof footerTagline !== 'undefined' && footerTagline) ? footerTagline : '',
                editTag: 'p',
                editClass: 'bb-tp-footer__tagline',
                editType: 'paragraph',
                editMaxLength: 200,
                editGuidance: 'Footer tagline (up to 200 characters)',
                editMultiline: true
              }) %>
              <% } %>
            </div>
            <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
            <%- include('./settings-edit-trigger', {
              settingsLinkId: 'identity',
              settingsLabel: 'Edit identity',
              settingsClass: 'bb-tp-settings-pencil bb-tp-settings-pencil--compact'
            }) %>
            <% } %>
          </div>
          <%- include('../public/partials/contact-summary') %>
          <% if (typeof socialLinks !== 'undefined' && socialLinks && socialLinks.length) { %>
          <ul class="bb-tp-footer__social" aria-label="Social links" data-bb-footer-social="1">
            <% socialLinks.forEach(function (link) { %>
            <% if (link && link.href) { %>
            <li data-bb-social-link="<%= link.id || link.channelType || '' %>">
              <a href="<%= link.href %>" rel="noopener noreferrer">
                <% if (link.icon) { %>
                <span class="material-symbols-outlined" aria-hidden="true"><%= link.icon %></span>
                <% } %>
                <span><%= link.label %></span>
              </a>
              <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
              <%- include('./structured-edit-trigger', {
                editKind: 'social_link',
                editEntityKey: link.id || ('social-' + (link.channelType || 'link')),
                editLabel: 'Edit social link',
                editPayload: {
                  channelType: link.channelType || 'social',
                  label: link.label || '',
                  value: link.href || link.value || '',
                  visible: true,
                  sortOrder: link.sortOrder != null ? link.sortOrder : 10
                }
              }) %>
              <% } %>
            </li>
            <% } %>
            <% }) %>
          </ul>
          <% } %>
          <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
          <p class="bb-tp-edit-collection-actions bb-tp-edit-collection-actions--footer">
            <%- include('./structured-edit-trigger', {
              editKind: 'social_link',
              editEntityKey: 'new-social-' + Date.now(),
              editLabel: 'Add social link',
              editPayload: { channelType: 'facebook', label: 'Facebook', value: '', visible: true, sortOrder: 100 }
            }) %>
            <span class="bb-tp-se-hint">Add social link</span>
          </p>
          <% } %>
        </div>

        <div class="bb-tp-footer__col">
          <h2 class="bb-tp-footer__heading">Quick Links</h2>
          <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
          <%- include('./settings-edit-trigger', {
            settingsLinkId: 'navigation',
            settingsLabel: 'Edit navigation',
            settingsClass: 'bb-tp-settings-pencil bb-tp-settings-pencil--compact'
          }) %>
          <% } %>
          <ul class="bb-tp-footer__list" data-bb-footer-nav="1">
            <% _footerNav.forEach(function (item) { %>
            <li><a href="<%= item.href %>" data-bb-nav-link="<%= item.key || '' %>"><%= item.label %></a></li>
            <% }) %>
          </ul>
        </div>

        <div class="bb-tp-footer__col" data-bb-footer-service-times="1">
          <div class="bb-tp-footer__heading-row">
            <h2 class="bb-tp-footer__heading">Service Times</h2>
            <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
            <%- include('./settings-edit-trigger', {
              settingsLinkId: 'service_times',
              settingsLabel: 'Edit service times',
              settingsClass: 'bb-tp-settings-pencil bb-tp-settings-pencil--compact'
            }) %>
            <% } %>
          </div>
          <% if (footerServices.length) { %>
          <% var _templateTimes = footerServices.some(function (entry) {
            return entry && (entry.templateExample || (entry.note && /template example/i.test(String(entry.note))));
          }); %>
          <% if (_templateTimes) { %>
          <p class="bb-tp-footer__muted" data-bb-template-example="service-times">Example gathering times — not this church’s published schedule.</p>
          <% } %>
          <ul class="bb-tp-footer__list bb-tp-footer__list--services">
            <% footerServices.forEach(function (entry) { %>
            <li>
              <strong><%= entry.name %></strong>
              <span>
                <%= footerDayLabel(entry.day) %>
                ·
                <%= footerTimeLabel(entry.startTime) %><% if (entry.endTime) { %>–<%= footerTimeLabel(entry.endTime) %><% } %>
              </span>
            </li>
            <% }) %>
          </ul>
          <% } else { %>
          <p class="bb-tp-footer__muted"><a href="<%= typeof hrefFor === 'function' ? hrefFor('/contact') : '/contact' %>">See visit details</a></p>
          <% } %>
        </div>
      </div>

      <div class="bb-tp-footer__bar">
        <p class="bb-tp-footer__copy">&copy; <%= _churchName %><% if (_branchName) { %> · <%= _branchName %><% } %>. Powered by BlessBoard</p>
        <p class="bb-tp-footer__bar-links">
          <a href="<%= typeof hrefFor === 'function' ? hrefFor('/contact') : '/contact' %>">Contact Us</a>
          <span aria-hidden="true"> · </span>
          <a href="<%= typeof hrefFor === 'function' ? hrefFor('/giving') : '/giving' %>">Giving</a>
          <span aria-hidden="true"> · </span>
          <%- include('./powered-by-getpro') %>
        </p>
      </div>
    </div>
  </footer>

  <script src="/blessboard/v5/design-system.js?v=3" defer></script>
  <script src="/blessboard/v5/tenant-public.js?v=10" defer></script>
  <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.canEdit) { %>
  <script src="/platform/website-lifecycle.js?v=v7-website-17" defer></script>
  <script src="/platform/website-editor-mobile.js?v=v7-website-17" defer></script>
  <% } %>
  <% if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.editingMode) { %>
  <%- include('./structured-editor-host') %>
  <script src="/blessboard/v5/website-unsaved-guard.js?v=2" defer></script>
  <script src="/platform/website-inline-edit.js?v=v7-website-17" defer></script>
  <script src="/platform/website-section-actions.js?v=v7-website-17" defer></script>
  <script src="/blessboard/v5/website-structured-edit.js?v=6" defer></script>
  <script src="/blessboard/v5/website-features-panel.js?v=1" defer></script>
  <% } else if (typeof websiteAdmin !== 'undefined' && websiteAdmin && websiteAdmin.previewDraftMode) { %>
  <% /* lifecycle.js loaded above for all canEdit sessions */ %>
  <% } %>
</body>
</html>
