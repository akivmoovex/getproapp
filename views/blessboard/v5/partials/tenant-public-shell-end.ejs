<%#
  BlessBoard V5 tenant public shell — footer + scripts.
  Locals: publicName, hqBranchDisplayName, primaryEmail, primaryPhone,
          publicContact (optional), loginHref, apexHref, footerTagline (optional),
          navItems (optional — Quick Links; falls back to canonical public paths)
%>
<%
  var footerEmail = (typeof publicContact !== 'undefined' && publicContact && publicContact.email)
    ? publicContact.email
    : (typeof primaryEmail !== 'undefined' ? primaryEmail : '');
  var footerPhone = (typeof publicContact !== 'undefined' && publicContact && publicContact.phone)
    ? publicContact.phone
    : (typeof primaryPhone !== 'undefined' ? primaryPhone : '');
  var footerEmailHref = (typeof publicContact !== 'undefined' && publicContact && publicContact.emailHref)
    ? publicContact.emailHref
    : (footerEmail ? ('mailto:' + footerEmail) : null);
  var footerPhoneHref = (typeof publicContact !== 'undefined' && publicContact && publicContact.phoneHref)
    ? publicContact.phoneHref
    : null;
  if (!footerPhoneHref && footerPhone) {
    footerPhoneHref = 'tel:' + String(footerPhone).replace(/[^\d+]/g, '');
  }
  var footerNavItems = (typeof navItems !== 'undefined' && navItems && navItems.length)
    ? navItems
    : [
        { href: '/', label: 'Home' },
        { href: '/about', label: 'About' },
        { href: '/leadership', label: 'Leadership' },
        { href: '/ministries', label: 'Ministries' },
        { href: '/events', label: 'Events' },
        { href: '/sermons', label: 'Sermons' },
        { href: '/contact', label: 'Contact' },
        { href: '/giving', label: 'Giving' }
      ];
%>
  </main>

  <footer class="bb-tp-footer" data-bb-footer="1">
    <div class="bb-tp-footer__inner">
      <div class="bb-tp-footer__grid">
        <div class="bb-tp-footer__brand">
          <div class="bb-tp-footer__brand-lockup">
            <img
              class="bb-tp-footer__mark"
              src="/church/images/brand/blessboard-small-church-logo.png"
              alt=""
              width="28"
              height="28"
              decoding="async"
            />
            <div class="bb-tp-footer__brand-text">
              <p class="bb-tp-footer__name"><%= publicName %></p>
              <% if (typeof footerTagline !== 'undefined' && footerTagline) { %>
              <p class="bb-tp-footer__tagline"><%= footerTagline %></p>
              <% } else if (hqBranchDisplayName) { %>
              <p class="bb-tp-footer__tagline">Headquarters: <%= hqBranchDisplayName %></p>
              <% } %>
            </div>
          </div>
        </div>

        <div class="bb-tp-footer__col">
          <h2 class="bb-tp-footer__heading">Quick Links</h2>
          <ul class="bb-tp-footer__list">
            <% footerNavItems.forEach(function (item) { %>
            <li><a href="<%= item.href %>"><%= item.label %></a></li>
            <% }) %>
          </ul>
        </div>

        <div class="bb-tp-footer__col">
          <h2 class="bb-tp-footer__heading">Contact</h2>
          <ul class="bb-tp-footer__list bb-tp-footer__list--contact">
            <% if (footerEmail && footerEmailHref) { %>
            <li>
              <span class="material-symbols-outlined" aria-hidden="true">mail</span>
              <a href="<%= footerEmailHref %>"><%= footerEmail %></a>
            </li>
            <% } %>
            <% if (footerPhone && footerPhoneHref) { %>
            <li>
              <span class="material-symbols-outlined" aria-hidden="true">phone</span>
              <a href="<%= footerPhoneHref %>"><%= footerPhone %></a>
            </li>
            <% } %>
            <% if (!footerEmail && !footerPhone) { %>
            <li><a href="<%= typeof hrefFor === 'function' ? hrefFor('/contact') : '/contact' %>">Contact details</a></li>
            <% } %>
          </ul>
          <% if (typeof socialLinks !== 'undefined' && socialLinks && socialLinks.length) { %>
          <ul class="bb-tp-footer__social" aria-label="Social links">
            <% socialLinks.forEach(function (link) { %>
            <li>
              <% if (link.href) { %>
              <a href="<%= link.href %>" rel="noopener noreferrer">
                <span class="material-symbols-outlined" aria-hidden="true"><%= link.icon || 'language' %></span>
                <span><%= link.label %></span>
              </a>
              <% } else { %>
              <span><%= link.label %></span>
              <% } %>
            </li>
            <% }) %>
          </ul>
          <% } %>
        </div>

        <div class="bb-tp-footer__col">
          <h2 class="bb-tp-footer__heading">Members</h2>
          <ul class="bb-tp-footer__list">
            <li><a href="<%= loginHref %>">Sign in</a></li>
            <li><a href="/register">Register</a></li>
            <li><a href="<%= apexHref %>">BlessBoard</a></li>
          </ul>
        </div>
      </div>

      <div class="bb-tp-footer__bar">
        <p class="bb-tp-footer__copy">&copy; <%= publicName %>. <%- include('./powered-by-getpro') %></p>
        <p class="bb-tp-footer__bar-links">
          <a href="<%= typeof hrefFor === 'function' ? hrefFor('/contact') : '/contact' %>">Contact Us</a>
        </p>
      </div>
    </div>
  </footer>

  <script src="/blessboard/v5/design-system.js?v=3" defer></script>
  <script src="/blessboard/v5/tenant-public.js?v=7" defer></script>
</body>
</html>
