<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> · BlessBoard</title>
  <meta name="robots" content="noindex, nofollow" />
  <%- include('./head-design-system') %>
  <link rel="stylesheet" href="/blessboard/v5/platform-admin.css?v=60" />
</head>
<%
  var paNav = (typeof navItems !== 'undefined' && navItems && navItems.length)
    ? navItems
    : [
        { key: 'home', label: 'Dashboard', href: '/admin', icon: 'dashboard' },
        { key: 'organizations', label: 'Organisations', href: '/admin/organizations', icon: 'corporate_fare' },
        { key: 'users', label: 'Users', href: '/admin/users', icon: 'group' },
        { key: 'members', label: 'Members', href: '/admin/members', icon: 'badge' },
        { key: 'domains', label: 'Domains and links', href: '/admin/domains', icon: 'language' },
        { key: 'roles', label: 'Roles and access', href: '/admin/roles', icon: 'admin_panel_settings' },
        { key: 'settings', label: 'Settings', href: '/admin/settings', icon: 'settings' },
        {
          key: 'system',
          label: 'System',
          href: '/admin/system/deployments',
          icon: 'monitor_heart',
          children: [
            { key: 'deployments', label: 'Deployments', href: '/admin/system/deployments', icon: 'dns' }
          ]
        },
        { key: 'account', label: 'Account', href: '/admin/account', icon: 'person' },
      ];
  var paRole = typeof roleLabel !== 'undefined' && roleLabel ? roleLabel : 'Platform admin';
  var paDisplay = typeof displayName !== 'undefined' && displayName ? displayName : '';
  var paDeploy = typeof deploymentCode !== 'undefined' && deploymentCode ? deploymentCode : '';
  var paCsrf = typeof csrfToken !== 'undefined' ? csrfToken : '';
  var paPageTitle = typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Platform Admin';
  var paSystemOpen = typeof systemNavOpen !== 'undefined' ? systemNavOpen : false;
%>
<body
  class="bb-pa-body"
  data-bb-shell="platform-admin"
  data-bb-product="blessboard-v5"
  data-bb-viewport="responsive"
  data-bb-page="<%= activeNav || 'home' %>"
  data-bb-stitch-shell="62-platform-admin-dashboard"
>
  <a class="bb-pa-skip" href="#bb-pa-main">Skip to content</a>
  <div id="bb-shell-nav-live" class="bb-shell-sr-only" aria-live="polite" aria-atomic="true"></div>

  <div class="bb-pa-app">
    <aside class="bb-pa-sidebar" data-bb-nav="desktop-sidebar" aria-label="Platform admin navigation">
      <div class="bb-pa-sidebar__brand">
        <a class="bb-pa-wordmark" href="/admin">
          <img
            class="bb-pa-wordmark__mark"
            src="/church/images/brand/blessboard-small-church-logo.png"
            alt=""
            width="28"
            height="28"
            decoding="async"
          />
          <%- include('./platform-wordmark-text') %>
        </a>
        <p class="bb-pa-context">
          <span class="bb-pa-context__label">Platform administration</span>
          <% if (paDeploy) { %>
          <span class="bb-pa-context__deploy" data-bb-pa-deployment="1"><%= paDeploy %></span>
          <% } %>
        </p>
        <span class="bb-pa-role" data-bb-pa-role="1">
          <span class="material-symbols-outlined" aria-hidden="true">shield_person</span>
          <%= paRole %>
        </span>
      </div>

      <nav class="bb-pa-sidebar__nav" aria-label="Platform admin desktop" data-bb-nav="desktop">
        <% paNav.forEach(function (item) { %>
        <% if (item.children && item.children.length) { %>
        <div class="bb-pa-nav-group<%= (paSystemOpen || activeNav === item.key) ? ' is-open' : '' %>" data-bb-pa-nav-group="<%= item.key %>">
          <a
            href="<%= item.href %>"
            class="bb-pa-nav-link bb-pa-nav-link--parent<%= (paSystemOpen || activeNav === item.key) ? ' is-active' : '' %>"
          >
            <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
            <span><%= item.label %></span>
          </a>
          <div class="bb-pa-nav-group__children">
            <% item.children.forEach(function (child) { %>
            <a
              href="<%= child.href %>"
              class="bb-pa-nav-link bb-pa-nav-link--child<%= activeNav === child.key ? ' is-active' : '' %>"
              <% if (activeNav === child.key) { %>aria-current="page"<% } %>
            >
              <span class="material-symbols-outlined" aria-hidden="true"><%= child.icon %></span>
              <span><%= child.label %></span>
            </a>
            <% }) %>
          </div>
        </div>
        <% } else { %>
        <a
          href="<%= item.href %>"
          class="bb-pa-nav-link<%= activeNav === item.key ? ' is-active' : '' %>"
          <% if (activeNav === item.key) { %>aria-current="page"<% } %>
        >
          <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
          <span><%= item.label %></span>
        </a>
        <% } %>
        <% }) %>
      </nav>

      <div class="bb-pa-sidebar__footer">
        <% if (paDisplay) { %>
        <p class="bb-pa-user" data-bb-admin-user="1">
          <span class="bb-pa-user__name"><%= paDisplay %></span>
          <span class="bb-pa-user__meta"><%= paRole %></span>
        </p>
        <% } %>
        <form class="bb-pa-logout" method="post" action="/admin/logout" data-bb-pa-logout="1">
          <input type="hidden" name="_csrf" value="<%= paCsrf %>" />
          <button type="submit">
            <span class="material-symbols-outlined" aria-hidden="true">logout</span>
            Sign out
          </button>
        </form>
        <%- include('./powered-by-getpro') %>
      </div>
    </aside>

    <div class="bb-pa-frame">
      <header class="bb-pa-top" data-bb-nav="mobile-header">
        <div class="bb-pa-top__brand">
          <a class="bb-pa-wordmark bb-pa-wordmark--compact" href="/admin" aria-label="BlessBoard platform admin home">
            <img
              class="bb-pa-wordmark__mark"
              src="/church/images/brand/blessboard-small-church-logo.png"
              alt=""
              width="24"
              height="24"
              decoding="async"
            />
            <%- include('./platform-wordmark-text') %>
          </a>
          <p class="bb-pa-top__title"><%= paPageTitle %></p>
        </div>
        <div class="bb-pa-top__actions">
          <button
            type="button"
            class="bb-pa-nav-toggle bb-shell-burger"
            id="bb-pa-menu-btn"
            data-bb-nav="mobile-toggle"
            aria-controls="bb-pa-drawer"
            aria-expanded="false"
            aria-label="Open navigation"
          >
            <span class="bb-shell-burger__icon bb-pa-nav-toggle__icon" aria-hidden="true">
              <span class="bb-shell-burger__bar bb-pa-nav-toggle__bar"></span>
              <span class="bb-shell-burger__bar bb-pa-nav-toggle__bar"></span>
              <span class="bb-shell-burger__bar bb-pa-nav-toggle__bar"></span>
            </span>
            <span class="bb-shell-burger__label bb-pa-nav-toggle__label">Menu</span>
          </button>
        </div>
      </header>

      <div
        id="bb-pa-drawer"
        class="bb-pa-drawer"
        data-bb-nav="mobile-drawer"
        role="dialog"
        aria-modal="true"
        aria-label="Platform admin navigation"
        inert
        hidden
      >
        <div class="bb-pa-drawer__scrim" data-bb-nav="drawer-close" tabindex="-1"></div>
        <nav class="bb-pa-drawer__panel" aria-label="Platform admin mobile">
          <div class="bb-pa-drawer__head">
            <div class="bb-pa-drawer__brand">
              <img
                class="bb-pa-wordmark__mark"
                src="/church/images/brand/blessboard-small-church-logo.png"
                alt=""
                width="24"
                height="24"
                decoding="async"
              />
              <p class="bb-pa-drawer__title">Platform Admin</p>
            </div>
            <button
              type="button"
              class="bb-pa-drawer__close"
              data-bb-nav="drawer-close"
              aria-label="Close navigation"
            >
              <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
          </div>
          <% if (paDisplay) { %>
          <p class="bb-pa-user bb-pa-user--drawer" data-bb-admin-user="1">
            <span class="bb-pa-user__name"><%= paDisplay %></span>
            <span class="bb-pa-user__meta"><%= paRole %></span>
          </p>
          <% } %>
          <div class="bb-pa-drawer__links" data-bb-nav="mobile-links">
            <ul class="bb-pa-drawer__list">
              <% paNav.forEach(function (item) { %>
              <% if (item.children && item.children.length) { %>
              <li class="bb-pa-drawer__item bb-pa-drawer__item--group">
                <a
                  href="<%= item.href %>"
                  class="bb-pa-nav-link<%= (paSystemOpen || activeNav === item.key) ? ' is-active' : '' %>"
                >
                  <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
                  <span><%= item.label %></span>
                </a>
                <ul class="bb-pa-drawer__sublist">
                  <% item.children.forEach(function (child) { %>
                  <li class="bb-pa-drawer__item">
                    <a
                      href="<%= child.href %>"
                      class="bb-pa-nav-link bb-pa-nav-link--child<%= activeNav === child.key ? ' is-active' : '' %>"
                      <% if (activeNav === child.key) { %>aria-current="page"<% } %>
                    >
                      <span class="material-symbols-outlined" aria-hidden="true"><%= child.icon %></span>
                      <span><%= child.label %></span>
                    </a>
                  </li>
                  <% }) %>
                </ul>
              </li>
              <% } else { %>
              <li class="bb-pa-drawer__item">
                <a
                  href="<%= item.href %>"
                  class="bb-pa-nav-link<%= activeNav === item.key ? ' is-active' : '' %>"
                  <% if (activeNav === item.key) { %>aria-current="page"<% } %>
                >
                  <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
                  <span><%= item.label %></span>
                </a>
              </li>
              <% } %>
              <% }) %>
            </ul>
          </div>
          <div class="bb-pa-drawer__account">
            <form class="bb-pa-logout" method="post" action="/admin/logout" data-bb-pa-logout="1">
              <input type="hidden" name="_csrf" value="<%= paCsrf %>" />
              <button type="submit">
                <span class="material-symbols-outlined" aria-hidden="true">logout</span>
                Sign out
              </button>
            </form>
          </div>
          <div class="bb-pa-drawer__footer" data-bb-footer="drawer">
            <%- include('./powered-by-getpro') %>
          </div>
        </nav>
      </div>

      <main id="bb-pa-main" class="bb-pa-main" tabindex="-1">
        <div class="bb-pa-page" data-bb-page-area="1">
