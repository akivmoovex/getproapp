<%#
  Apex shell end — footer includes Batch 2b marketing routes only (no dead links).
%>
  </main>

  <footer class="bb-apex-footer" data-bb-apex-footer="1">
    <div class="bb-apex-container">
      <div class="bb-apex-footer__grid">
        <div class="bb-apex-footer__brand">
          <p class="bb-apex-footer__name">BlessBoard</p>
          <p class="bb-apex-footer__tagline">Building the digital foundation for the church community — websites, engagement, and administration on GetPro.</p>
          <p class="bb-apex-footer__powered"><%- include('./powered-by-getpro') %></p>
        </div>
        <div class="bb-apex-footer__col">
          <h2 class="bb-apex-footer__heading">Product</h2>
          <ul class="bb-apex-footer__links">
            <li><a href="/">Home</a></li>
            <li><a href="/features">Features</a></li>
            <li><a href="/for-churches">For Churches</a></li>
            <li><a href="/pricing">Pricing</a></li>
            <li><a href="/directory">Directory</a></li>
            <li><a href="/register-church">Register Your Church</a></li>
          </ul>
        </div>
        <div class="bb-apex-footer__col">
          <h2 class="bb-apex-footer__heading">Account</h2>
          <ul class="bb-apex-footer__links">
            <% if (authenticated) { %>
            <li><a href="/account">Account</a></li>
            <% } else { %>
            <li><a href="/login">Login</a></li>
            <% } %>
          </ul>
        </div>
        <div class="bb-apex-footer__col">
          <h2 class="bb-apex-footer__heading">Legal</h2>
          <ul class="bb-apex-footer__links">
            <li><a href="/terms">Terms of Service</a></li>
            <li><a href="/privacy">Privacy Policy</a></li>
          </ul>
        </div>
      </div>
      <div class="bb-apex-footer__meta">
        <% if (typeof activeNav !== 'undefined' && activeNav === 'register-church-success') { %>
        <span>© BlessBoard. All rights reserved.</span>
        <% } else { %>
        <span>© BlessBoard</span>
        <% } %>
        <span class="bb-apex-footer__meta-links">
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
        </span>
      </div>
    </div>
  </footer>

  <script src="/blessboard/v5/design-system.js?v=3" defer></script>
  <script src="/blessboard/v5/apex.js?v=4" defer></script>
  <% if (typeof activeNav !== 'undefined' && activeNav === 'register-church') { %>
  <script src="/activeclinic/ac-phone-field.js?v=bb-reg-1" defer></script>
  <script src="/platform/location-autocomplete.js?v=1" defer></script>
  <script src="/blessboard/v5/register-church-location.js?v=1" defer></script>
  <script src="/platform/registration-password-rules.js?v=2" defer></script>
  <script src="/platform/registration-slug-preview.js?v=1" defer></script>
  <script src="/platform/registration-consent.js?v=1" defer></script>
  <script src="/platform/registration-form-lifecycle.js?v=2" defer></script>
  <% } %>
</body>
</html>
