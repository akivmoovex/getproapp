</div>
</main>
<%
  var mpTabsEnd = (typeof mobileTabs !== 'undefined' && mobileTabs && mobileTabs.length)
    ? mobileTabs
    : [
        { key: 'home', label: 'Dashboard', href: '/member', icon: 'dashboard' },
        { key: 'announcements', label: 'Announcements', href: '/member/announcements', icon: 'campaign' },
        { key: 'events', label: 'Events', href: '/member/events', icon: 'event' },
        { key: 'ministries', label: 'Ministries', href: '/member/ministries', icon: 'groups' },
        { key: 'profile', label: 'Profile', href: '/member/profile', icon: 'person' },
      ];
%>

      <nav class="bb-mp-bottom" aria-label="Member primary" data-bb-nav="mobile-tabs">
        <% mpTabsEnd.forEach(function (item) { %>
        <a
          href="<%= item.href %>"
          class="bb-mp-bottom__link<%= activeNav === item.key ? ' is-active' : '' %>"
          <%= activeNav === item.key ? 'aria-current="page"' : '' %>
        >
          <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
          <span><%= item.label %></span>
        </a>
        <% }) %>
      </nav>

      <footer class="bb-mp-footer" data-bb-footer="1">
        <%- include('./powered-by-getpro') %>
      </footer>
    </div>
  </div>

  <script src="/blessboard/v5/shell-nav.js?v=2" defer></script>
  <script src="/blessboard/v5/design-system.js?v=3" defer></script>
  <script src="/blessboard/v5/member-portal.js?v=4" defer></script>
</body>
</html>
