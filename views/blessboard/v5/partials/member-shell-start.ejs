<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> · <%= churchDisplayName || 'BlessBoard' %></title>
  <meta name="robots" content="noindex, nofollow" />
  <%- include('./head-design-system') %>
  <link rel="stylesheet" href="/blessboard/v5/member-portal.css?v=21" />
</head>
<%
  var mpDisplay = typeof displayName !== 'undefined' && displayName ? displayName : '';
  var mpChurch = typeof churchDisplayName !== 'undefined' && churchDisplayName ? churchDisplayName : '';
  var mpBranch = typeof branchDisplayName !== 'undefined' && branchDisplayName ? branchDisplayName : '';
  var mpNav = (typeof navItems !== 'undefined' && navItems && navItems.length)
    ? navItems
    : [
        { key: 'home', label: 'Dashboard', href: '/member', icon: 'dashboard' },
        { key: 'announcements', label: 'Announcements', href: '/member/announcements', icon: 'campaign' },
        { key: 'events', label: 'Events', href: '/member/events', icon: 'event' },
        { key: 'ministries', label: 'Ministries', href: '/member/ministries', icon: 'groups' },
        { key: 'resources', label: 'Resources', href: '/member/resources', icon: 'menu_book' },
        { key: 'forms', label: 'Forms', href: '/member/forms', icon: 'description' },
        { key: 'requests', label: 'Requests', href: '/member/requests', icon: 'inbox' },
        { key: 'giving', label: 'Giving', href: '/member/giving', icon: 'payments' },
        { key: 'profile', label: 'Profile', href: '/member/profile', icon: 'person' },
      ];
%>
<body
  class="bb-mp-body"
  data-bb-shell="member"
  data-bb-product="blessboard-v5"
  data-bb-viewport="responsive"
  data-bb-page="<%= activeNav || 'home' %>"
  data-bb-stitch-shell="14-member-dashboard"
>
  <a class="bb-mp-skip" href="#bb-mp-main">Skip to content</a>
  <div id="bb-shell-nav-live" class="bb-shell-sr-only" aria-live="polite" aria-atomic="true"></div>

  <div class="bb-mp-app">
    <aside class="bb-mp-sidebar" data-bb-nav="desktop-sidebar" aria-label="Member navigation">
      <div class="bb-mp-sidebar__brand">
        <a class="bb-mp-wordmark" href="/member">
          <img
            class="bb-mp-wordmark__mark"
            src="/church/images/brand/blessboard-small-church-logo.png"
            alt=""
            width="28"
            height="28"
            decoding="async"
          />
          <span>BlessBoard</span>
        </a>
        <p class="bb-mp-context">
          <span class="bb-mp-context__church"><%= mpChurch %></span>
          <% if (mpBranch) { %>
          <span class="bb-mp-context__branch"><%= mpBranch %></span>
          <% } %>
        </p>
        <span class="bb-mp-role" data-bb-member-role="1">
          <span class="material-symbols-outlined" aria-hidden="true">verified</span>
          Verified member
        </span>
      </div>

      <nav class="bb-mp-sidebar__nav" aria-label="Member portal" data-bb-nav="desktop">
        <% mpNav.forEach(function (item) { %>
        <a
          href="<%= item.href %>"
          class="bb-mp-nav-link<%= activeNav === item.key ? ' is-active' : '' %>"
          <%= activeNav === item.key ? 'aria-current="page"' : '' %>
        >
          <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
          <span><%= item.label %></span>
        </a>
        <% }) %>
      </nav>

      <div class="bb-mp-sidebar__footer">
        <% if (mpDisplay) { %>
        <p class="bb-mp-user" data-bb-member-identity="1">
          <span class="bb-mp-user__name"><%= mpDisplay %></span>
          <span class="bb-mp-user__meta"><%= mpChurch %><% if (mpBranch) { %> · <%= mpBranch %><% } %></span>
        </p>
        <% } %>
        <form class="bb-mp-logout" method="post" action="/member/logout" data-bb-member-logout="1">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit">
            <span class="material-symbols-outlined" aria-hidden="true">logout</span>
            Sign out
          </button>
        </form>
        <%- include('./powered-by-getpro') %>
      </div>
    </aside>

    <div class="bb-mp-frame">
      <header class="bb-mp-top" data-bb-nav="mobile-header">
        <div class="bb-mp-top__brand">
          <a class="bb-mp-wordmark bb-mp-wordmark--compact" href="/member">
            <img
              class="bb-mp-wordmark__mark"
              src="/church/images/brand/blessboard-small-church-logo.png"
              alt=""
              width="24"
              height="24"
              decoding="async"
            />
            <span>BlessBoard</span>
          </a>
          <p class="bb-mp-context bb-mp-context--compact">
            <%= mpChurch %><% if (mpBranch) { %> · <%= mpBranch %><% } %>
          </p>
        </div>
        <div class="bb-mp-top__actions">
          <button
            type="button"
            class="bb-mp-nav-toggle bb-shell-burger"
            id="bb-mp-menu-btn"
            data-bb-nav="mobile-toggle"
            aria-controls="bb-mp-drawer"
            aria-expanded="false"
            aria-label="Open navigation"
          >
            <span class="bb-shell-burger__icon" aria-hidden="true">
              <span class="bb-shell-burger__bar"></span>
              <span class="bb-shell-burger__bar"></span>
              <span class="bb-shell-burger__bar"></span>
            </span>
            <span class="bb-shell-burger__label">Menu</span>
          </button>
        </div>
      </header>

      <div
        id="bb-mp-drawer"
        class="bb-mp-drawer"
        data-bb-nav="mobile-drawer"
        role="dialog"
        aria-modal="true"
        aria-label="Member portal navigation"
        inert
        hidden
      >
        <div class="bb-mp-drawer__scrim" data-bb-nav="drawer-close" tabindex="-1"></div>
        <nav class="bb-mp-drawer__panel" aria-label="Member portal mobile">
          <div class="bb-mp-drawer__head">
            <p class="bb-mp-drawer__title">Member</p>
            <button
              type="button"
              class="bb-mp-drawer__close"
              data-bb-nav="drawer-close"
              aria-label="Close navigation"
            >
              <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
          </div>
          <% if (mpDisplay) { %>
          <p class="bb-mp-user bb-mp-user--drawer" data-bb-member-identity="1">
            <span class="bb-mp-user__name"><%= mpDisplay %></span>
            <span class="bb-mp-user__meta">Verified member</span>
          </p>
          <% } %>
          <div class="bb-mp-drawer__links" data-bb-nav="mobile-links">
            <% mpNav.forEach(function (item) { %>
            <a
              href="<%= item.href %>"
              class="bb-mp-nav-link<%= activeNav === item.key ? ' is-active' : '' %>"
              <%= activeNav === item.key ? 'aria-current="page"' : '' %>
            >
              <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
              <span><%= item.label %></span>
            </a>
            <% }) %>
          </div>
          <div class="bb-mp-drawer__account">
            <form class="bb-mp-logout" method="post" action="/member/logout" data-bb-member-logout="1">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit">
                <span class="material-symbols-outlined" aria-hidden="true">logout</span>
                Sign out
              </button>
            </form>
          </div>
          <div class="bb-mp-drawer__footer" data-bb-footer="drawer">
            <%- include('./powered-by-getpro') %>
          </div>
        </nav>
      </div>

      <main id="bb-mp-main" class="bb-mp-main" tabindex="-1">
        <div class="bb-mp-page" data-bb-page-area="1">
