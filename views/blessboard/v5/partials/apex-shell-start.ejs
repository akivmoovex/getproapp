<%#
  Apex shell start. Locals: pageTitle, authenticated, activeNav ('home'|'login'|'account'), csrfToken
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> · BlessBoard</title>
  <meta name="description" content="BlessBoard — one digital home for your church." />
  <%- include('./head-design-system') %>
  <link rel="stylesheet" href="/blessboard/v5/apex.css?v=3" />
  <link rel="stylesheet" href="/blessboard/v5/apex-auth.css?v=3" />
</head>
<body class="bb-apex-body" data-bb-shell="apex" data-bb-product="blessboard-v5" data-bb-page="<%= activeNav %>">
  <a class="bb-apex-skip" href="#bb-apex-main">Skip to content</a>

  <header class="bb-apex-header" data-bb-apex-header="1">
    <div class="bb-apex-header__inner">
      <a class="bb-apex-brand" href="/">
        <img
          class="bb-apex-brand__mark"
          src="/church/images/brand/blessboard-small-church-logo.png"
          alt=""
          width="32"
          height="32"
          decoding="async"
        />
        <span class="bb-apex-brand__name">BlessBoard</span>
      </a>

      <nav class="bb-apex-nav" aria-label="Primary" data-bb-apex-nav="desktop">
        <%- include('./apex-nav-links', { authenticated: authenticated, activeNav: activeNav, csrfToken: csrfToken, variant: 'desktop' }) %>
      </nav>

      <div class="bb-apex-header__actions">
        <% if (authenticated) { %>
        <form class="bb-apex-nav__logout bb-apex-nav__logout--header" method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
          <button type="submit">Logout</button>
        </form>
        <% } else { %>
        <a class="bb-apex-btn bb-apex-btn--primary bb-apex-btn--header" href="/login" data-bb-apex-cta="header-login">Login</a>
        <% } %>
        <button
          type="button"
          class="bb-apex-menu-btn"
          id="bb-apex-menu-btn"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="bb-apex-drawer"
        >
          <span class="material-symbols-outlined" aria-hidden="true">menu</span>
        </button>
      </div>
    </div>
  </header>

  <div class="bb-apex-drawer" id="bb-apex-drawer" hidden data-bb-apex-drawer="1">
    <button type="button" class="bb-apex-drawer__backdrop" data-bb-apex-drawer-close aria-label="Close menu"></button>
    <div class="bb-apex-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
      <button type="button" class="bb-apex-menu-btn bb-apex-drawer__close" data-bb-apex-drawer-close aria-label="Close menu">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
      <nav aria-label="Mobile">
        <%- include('./apex-nav-links', { authenticated: authenticated, activeNav: activeNav, csrfToken: csrfToken, variant: 'drawer' }) %>
      </nav>
      <p class="bb-apex-drawer__powered"><%- include('./powered-by-getpro') %></p>
    </div>
  </div>

  <main class="bb-apex-main" id="bb-apex-main">
