<%#
  Apex shell start. Locals: pageTitle, authenticated, activeNav, csrfToken
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> · BlessBoard</title>
  <meta name="description" content="BlessBoard — one digital home for your church." />
  <% if (typeof activeNav !== 'undefined' && activeNav === 'email-verification') { %>
  <meta name="robots" content="noindex, nofollow" />
  <% } else if (typeof robotsNoIndex !== 'undefined' && robotsNoIndex) { %>
  <meta name="robots" content="noindex, nofollow" />
  <% } %>
  <%- include('./head-design-system') %>
  <link rel="stylesheet" href="/blessboard/v5/apex.css?v=19" />
  <% if (typeof activeNav !== 'undefined' && activeNav === 'register-church') { %>
  <link rel="stylesheet" href="/activeclinic/ac-phone-field.css?v=bb-reg-1" />
  <% } %>
  <% if (typeof activeNav !== 'undefined' && activeNav === 'register-church-success') { %>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0&display=swap" rel="stylesheet" />
  <% } %>
  <% if (typeof activeNav !== 'undefined' && activeNav === 'account') { %>
  <link rel="stylesheet" href="/blessboard/v5/apex-auth.css?v=6" />
  <% } %>
</head>
<body class="bb-apex-body" data-bb-shell="apex" data-bb-product="blessboard-v5" data-bb-page="<%= activeNav %>">
  <a class="bb-apex-skip" href="#bb-apex-main">Skip to content</a>

  <header class="bb-apex-header" data-bb-apex-header="1">
    <div class="bb-apex-header__inner">
      <%- include('./apex-platform-brand') %>

      <nav class="bb-apex-nav" aria-label="Primary" data-bb-apex-nav="desktop">
        <%- include('./apex-nav-links', { authenticated: authenticated, activeNav: activeNav, csrfToken: csrfToken, variant: 'desktop' }) %>
      </nav>

      <div class="bb-apex-header__actions">
        <% if (authenticated) { %>
        <form class="bb-apex-nav__logout bb-apex-nav__logout--header" method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
          <button type="submit">Logout</button>
        </form>
        <% } else { %>
        <a class="bb-apex-btn bb-apex-btn--ghost bb-apex-btn--header" href="/register-church" data-bb-apex-cta="header-register">Register</a>
        <a class="bb-apex-btn bb-apex-btn--primary bb-apex-btn--header" href="/login" data-bb-apex-cta="header-login">Login</a>
        <% } %>
        <button
          type="button"
          class="bb-apex-menu-btn bb-shell-burger"
          id="bb-apex-menu-btn"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="bb-apex-drawer"
        >
          <span class="bb-shell-burger__icon" aria-hidden="true">
            <span class="bb-shell-burger__bar"></span>
            <span class="bb-shell-burger__bar"></span>
            <span class="bb-shell-burger__bar"></span>
          </span>
          <span class="bb-shell-burger__label">Menu</span>
        </button>
      </div>
    </div>
  </header>

  <div class="bb-apex-drawer" id="bb-apex-drawer" hidden inert data-bb-apex-drawer="1">
    <button type="button" class="bb-apex-drawer__backdrop" data-bb-apex-drawer-close aria-label="Close navigation"></button>
    <div class="bb-apex-drawer__panel" role="dialog" aria-modal="true" aria-label="BlessBoard navigation">
      <div class="bb-apex-drawer__head">
        <p class="bb-apex-drawer__title">Menu</p>
        <button type="button" class="bb-apex-menu-btn bb-apex-drawer__close" data-bb-apex-drawer-close aria-label="Close navigation">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </div>
      <nav class="bb-apex-drawer__nav" aria-label="Primary">
        <%- include('./apex-nav-links', { authenticated: authenticated, activeNav: activeNav, csrfToken: csrfToken, variant: 'drawer' }) %>
      </nav>
      <p class="bb-apex-drawer__powered"><%- include('./powered-by-getpro') %></p>
    </div>
  </div>

  <main class="bb-apex-main" id="bb-apex-main" tabindex="-1">
