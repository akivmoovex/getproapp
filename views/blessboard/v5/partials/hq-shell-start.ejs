<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> · <%= churchDisplayName || 'BlessBoard' %></title>
  <meta name="robots" content="noindex, nofollow" />
  <%- include('./head-design-system') %>
  <link rel="stylesheet" href="/blessboard/v5/hq-admin.css?v=77" />
  <% var loadEngineCss = (typeof loadWebsiteEngineCss !== 'undefined' && loadWebsiteEngineCss)
    || (typeof activeNav !== 'undefined' && (activeNav === 'website' || activeNav === 'content')); %>
  <% if (loadEngineCss) { %>
  <link rel="stylesheet" href="/platform/website-inline-edit.css?v=v7-website-5" />
  <% } %>
  <% if (typeof loadMediaPicker !== 'undefined' && loadMediaPicker) { %>
  <link rel="stylesheet" href="/blessboard/v5/media-picker.css?v=8" />
  <% } %>
</head>
<%
  var hqNav = (typeof navItems !== 'undefined' && navItems && navItems.length)
    ? navItems
    : [
        { key: 'home', label: 'Dashboard', href: '/hq', icon: 'dashboard' },
        { key: 'branches', label: 'Branches', href: '/hq/branches', icon: 'apartment' },
        { key: 'registrations', label: 'Registrations', href: '/hq/registrations', icon: 'how_to_reg' },
        { key: 'members', label: 'Members', href: '/hq/members', icon: 'badge' },
        { key: 'staff-access', label: 'Staff access', href: '/hq/settings/staff-access', icon: 'admin_panel_settings' },
        { key: 'settings', label: 'Settings', href: '/hq/settings', icon: 'settings' },
        { key: 'content', label: 'Website', href: '/hq/website', icon: 'language' },
        { key: 'broadcasts', label: 'Broadcasts', href: '/hq/broadcasts', icon: 'campaign' },
        { key: 'announcements', label: 'Announcements', href: '/hq/announcements', icon: 'newspaper' },
        { key: 'participation', label: 'Participation', href: '/hq/participation', icon: 'groups' },
        { key: 'attendance', label: 'Attendance', href: '/hq/attendance', icon: 'fact_check' },
        { key: 'giving', label: 'Giving', href: '/hq/giving', icon: 'payments' },
        { key: 'resources', label: 'Resources', href: '/hq/resources', icon: 'menu_book' },
        { key: 'forms', label: 'Forms', href: '/hq/forms', icon: 'description' },
        { key: 'requests', label: 'Requests', href: '/hq/requests', icon: 'inbox' },
        { key: 'reports', label: 'Reports', href: '/hq/reports', icon: 'analytics' },
        { key: 'audit', label: 'Audit', href: '/hq/audit', icon: 'history' },
        { key: 'account', label: 'Account', href: '/hq/account', icon: 'person' },
      ];
  var hqMobileNav = (typeof mobileNav !== 'undefined' && mobileNav)
    ? mobileNav
    : {
        primary: hqNav.filter(function (item) {
          return item.key !== 'account';
        }),
        sections: [],
        account: hqNav.filter(function (item) {
          return item.key === 'account';
        }),
      };
  var hqRole = typeof roleLabel !== 'undefined' && roleLabel ? roleLabel : 'HQ admin';
  var hqDisplay = typeof displayName !== 'undefined' && displayName ? displayName : '';
  var hqChurch = typeof churchDisplayName !== 'undefined' && churchDisplayName ? churchDisplayName : '';
  var hqBranch = typeof hqBranchDisplayName !== 'undefined' && hqBranchDisplayName ? hqBranchDisplayName : '';
  var hqCsrf = typeof csrfToken !== 'undefined' ? csrfToken : '';
%>
<body
  class="bb-hq-body"
  data-bb-shell="hq-admin"
  data-bb-product="blessboard-v5"
  data-bb-viewport="responsive"
  data-bb-page="<%= activeNav || 'home' %>"
  data-bb-stitch-shell="51-hq-dashboard"
>
  <a class="bb-hq-skip" href="#bb-hq-main">Skip to content</a>
  <div id="bb-shell-nav-live" class="bb-shell-sr-only" aria-live="polite" aria-atomic="true"></div>

  <div class="bb-hq-app">
    <aside class="bb-hq-sidebar" data-bb-nav="desktop-sidebar" aria-label="HQ navigation">
      <div class="bb-hq-sidebar__brand">
        <a class="bb-hq-wordmark" href="/hq">
          <img
            class="bb-hq-wordmark__mark"
            src="/church/images/brand/blessboard-small-church-logo.png"
            alt=""
            width="28"
            height="28"
            decoding="async"
          />
          <%- include('./platform-wordmark-text') %>
        </a>
        <p class="bb-hq-context">
          <span class="bb-hq-context__church"><%= hqChurch %></span>
          <% if (hqBranch) { %>
          <span class="bb-hq-context__hq"><%= hqBranch %></span>
          <% } %>
        </p>
        <span class="bb-hq-role" data-bb-hq-role="1">
          <span class="material-symbols-outlined" aria-hidden="true">domain</span>
          <%= hqRole %>
        </span>
      </div>

      <nav class="bb-hq-sidebar__nav" aria-label="HQ desktop" data-bb-nav="desktop">
        <% hqNav.forEach(function (item) { %>
        <% if (item.navHeading || !item.href) { %>
        <p class="bb-hq-nav-heading" data-bb-nav-heading="1"><%= item.label %></p>
        <% } else { %>
        <a
          href="<%= item.href %>"
          class="bb-hq-nav-link<%= activeNav === item.key ? ' is-active' : '' %>"
          <% if (activeNav === item.key) { %>aria-current="page"<% } %>
          data-bb-nav-key="<%= item.key %>"
        >
          <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
          <span><%= item.label %></span>
        </a>
        <% } %>
        <% }) %>
      </nav>

      <div class="bb-hq-sidebar__footer">
        <% if (hqDisplay) { %>
        <p class="bb-hq-user" data-bb-admin-user="1">
          <span class="bb-hq-user__name"><%= hqDisplay %></span>
          <span class="bb-hq-user__meta"><%= hqChurch %><% if (hqBranch) { %> · <%= hqBranch %><% } %></span>
        </p>
        <% } %>
        <form class="bb-hq-logout" method="post" action="/hq/logout" data-bb-hq-logout="1">
          <input type="hidden" name="_csrf" value="<%= hqCsrf %>" />
          <button type="submit">
            <span class="material-symbols-outlined" aria-hidden="true">logout</span>
            Sign out
          </button>
        </form>
        <%- include('./powered-by-getpro') %>
      </div>
    </aside>

    <div class="bb-hq-frame">
      <header class="bb-hq-top" data-bb-nav="mobile-header">
        <div class="bb-hq-top__brand">
          <a class="bb-hq-wordmark bb-hq-wordmark--compact" href="/hq">
            <img
              class="bb-hq-wordmark__mark"
              src="/church/images/brand/blessboard-small-church-logo.png"
              alt=""
              width="24"
              height="24"
              decoding="async"
            />
            <%- include('./platform-wordmark-text') %>
          </a>
          <p class="bb-hq-context bb-hq-context--compact">
            <%= hqChurch %><% if (hqBranch) { %> · <%= hqBranch %><% } %>
          </p>
        </div>
        <div class="bb-hq-top__actions">
          <button
            type="button"
            class="bb-hq-nav-toggle bb-shell-burger"
            id="bb-hq-menu-btn"
            data-bb-nav="mobile-toggle"
            aria-controls="bb-hq-drawer"
            aria-expanded="false"
            aria-label="Open navigation"
          >
            <span class="bb-shell-burger__icon" aria-hidden="true">
              <span class="bb-shell-burger__bar"></span>
              <span class="bb-shell-burger__bar"></span>
              <span class="bb-shell-burger__bar"></span>
            </span>
            <span class="bb-shell-burger__label">Menu</span>
          </button>
        </div>
      </header>

      <div
        id="bb-hq-drawer"
        class="bb-hq-drawer"
        data-bb-nav="mobile-drawer"
        role="dialog"
        aria-modal="true"
        aria-label="HQ navigation"
        inert
        hidden
      >
        <div class="bb-hq-drawer__scrim" data-bb-nav="drawer-close" tabindex="-1"></div>
        <nav class="bb-hq-drawer__panel" aria-label="HQ mobile">
          <div class="bb-hq-drawer__head">
            <p class="bb-hq-drawer__title">HQ Admin</p>
            <button
              type="button"
              class="bb-hq-drawer__close"
              data-bb-nav="drawer-close"
              aria-label="Close navigation"
            >
              <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
          </div>
          <% if (hqDisplay) { %>
          <p class="bb-hq-user bb-hq-user--drawer" data-bb-admin-user="1">
            <span class="bb-hq-user__name"><%= hqDisplay %></span>
            <span class="bb-hq-user__meta"><%= hqRole %></span>
          </p>
          <% } %>
          <div class="bb-hq-drawer__links" data-bb-nav="mobile-links">
            <%- include('./admin-mobile-nav-groups', {
              mobileNav: hqMobileNav,
              activeNav: activeNav,
              linkClass: 'bb-hq-nav-link',
              listClass: 'bb-hq-drawer__list',
              itemClass: 'bb-hq-drawer__item',
              idPrefix: 'bb-hq'
            }) %>
          </div>
          <div class="bb-hq-drawer__account">
            <% if (hqMobileNav.account && hqMobileNav.account.length) { %>
            <ul class="bb-hq-drawer__list bb-hq-drawer__account-list">
              <% hqMobileNav.account.forEach(function (item) { %>
              <li class="bb-hq-drawer__item">
                <a
                  href="<%= item.href %>"
                  class="bb-hq-nav-link<%= activeNav === item.key ? ' is-active' : '' %>"
                  <% if (activeNav === item.key) { %>aria-current="page"<% } %>
                  data-bb-nav-key="<%= item.key %>"
                >
                  <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
                  <span><%= item.label %></span>
                </a>
              </li>
              <% }) %>
            </ul>
            <% } %>
            <form class="bb-hq-logout" method="post" action="/hq/logout" data-bb-hq-logout="1">
              <input type="hidden" name="_csrf" value="<%= hqCsrf %>" />
              <button type="submit">
                <span class="material-symbols-outlined" aria-hidden="true">logout</span>
                Sign out
              </button>
            </form>
          </div>
          <div class="bb-hq-drawer__footer" data-bb-footer="drawer">
            <%- include('./powered-by-getpro') %>
          </div>
        </nav>
      </div>

      <main id="bb-hq-main" class="bb-hq-main" tabindex="-1">
        <%- include('./support-mode-banner') %>
        <div class="bb-hq-page" data-bb-page-area="1">
