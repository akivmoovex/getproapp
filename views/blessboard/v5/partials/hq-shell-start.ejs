<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> · <%= churchDisplayName || 'BlessBoard' %></title>
  <meta name="robots" content="noindex, nofollow" />
  <%- include('./head-design-system') %>
  <link rel="stylesheet" href="/platform/admin-console-shell.css?v=v205-acs-1" />
  <link rel="stylesheet" href="/blessboard/v5/hq-admin.css?v=v207-screen73-1" />
  <% if (typeof loadUrpAssets !== 'undefined' && loadUrpAssets) { %>
  <link rel="stylesheet" href="/blessboard/v5/bb-urp.css?v=1" />
  <% } %>
  <% if (typeof loadPhoneField !== 'undefined' && loadPhoneField) { %>
  <link rel="stylesheet" href="/platform/phone-field.css?v=bb-phone-1" />
  <% } %>
  <% if (typeof loadGpOpsAssets !== 'undefined' && loadGpOpsAssets) { %>
  <link rel="stylesheet" href="/platform/gp-ops-shared.css?v=v204-qa-3" />
  <% } %>
  <% var loadEngineCss = (typeof loadWebsiteEngineCss !== 'undefined' && loadWebsiteEngineCss)
    || (typeof activeNav !== 'undefined' && (activeNav === 'website' || activeNav === 'content')); %>
  <% if (loadEngineCss) { %>
  <link rel="stylesheet" href="/platform/website-inline-edit.css?v=v204-qa-3" />
  <% } %>
  <% if (typeof loadMediaPicker !== 'undefined' && loadMediaPicker) { %>
  <link rel="stylesheet" href="/blessboard/v5/media-picker.css?v=8" />
  <% } %>
  <% if (typeof loadSharedWebsiteMedia !== 'undefined' && loadSharedWebsiteMedia) { %>
  <link rel="stylesheet" href="/platform/website-media-field.css?v=v204-qa-3" />
  <% } %>
</head>
<%
  var hqNav = (typeof navItems !== 'undefined' && navItems && navItems.length)
    ? navItems
    : [
        { key: 'home', slot: 'dashboard', label: 'Dashboard', href: '/hq', icon: 'dashboard' },
        { key: 'content', slot: 'website', label: 'Website', href: '/hq/website', icon: 'language' },
        { key: 'branches', slot: 'locations', label: 'Branches', href: '/hq/branches', icon: 'apartment' },
        { key: 'registrations', slot: 'people', label: 'Registrations', href: '/hq/registrations', icon: 'how_to_reg' },
        { key: 'members', slot: 'people', label: 'Members', href: '/hq/members', icon: 'badge' },
        { key: 'staff-access', slot: 'people', label: 'Users', href: '/hq/settings/staff-access', icon: 'group' },
        { key: 'settings', slot: 'settings', label: 'Settings', href: '/hq/settings', icon: 'settings' },
        { key: 'broadcasts', slot: 'content', label: 'Broadcasts', href: '/hq/broadcasts', icon: 'campaign' },
        { key: 'announcements', slot: 'content', label: 'Announcements', href: '/hq/announcements', icon: 'notifications' },
        { key: 'participation', slot: 'operations', label: 'Participation', href: '/hq/participation', icon: 'groups' },
        { key: 'attendance', slot: 'operations', label: 'Attendance', href: '/hq/attendance', icon: 'fact_check' },
        { key: 'giving', slot: 'operations', label: 'Giving', href: '/hq/giving', icon: 'payments' },
        { key: 'resources', slot: 'content', label: 'Resources', href: '/hq/resources', icon: 'menu_book' },
        { key: 'forms', slot: 'content', label: 'Forms', href: '/hq/forms', icon: 'description' },
        { key: 'requests', slot: 'operations', label: 'Requests', href: '/hq/requests', icon: 'inbox' },
        { key: 'reports', slot: 'reports', label: 'Reports', href: '/hq/reports', icon: 'analytics' },
        { key: 'audit', slot: 'reports', label: 'Audit', href: '/hq/audit', icon: 'history' },
        { key: 'account', slot: 'settings', label: 'Account', href: '/hq/account', icon: 'person' },
      ];
  var hqNavGroups = (typeof navGroups !== 'undefined' && navGroups && navGroups.length)
    ? navGroups
    : null;
  var hqMobileNav = (typeof mobileNav !== 'undefined' && mobileNav)
    ? mobileNav
    : {
        primary: hqNav.filter(function (item) {
          return item.key !== 'account';
        }),
        sections: [],
        account: hqNav.filter(function (item) {
          return item.key === 'account';
        }),
      };
  var hqRole = typeof roleLabel !== 'undefined' && roleLabel ? roleLabel : 'HQ admin';
  var hqDisplay = typeof displayName !== 'undefined' && displayName ? displayName : '';
  var hqChurch = typeof churchDisplayName !== 'undefined' && churchDisplayName ? churchDisplayName : '';
  var hqBranch = typeof hqBranchDisplayName !== 'undefined' && hqBranchDisplayName ? hqBranchDisplayName : '';
  var hqCsrf = typeof csrfToken !== 'undefined' ? csrfToken : '';
%>
<body
  class="bb-hq-body gp-admin-console"
  data-product="blessboard"
  data-bb-shell="hq-admin"
  data-bb-product="blessboard-v5"
  data-bb-viewport="responsive"
  data-gp-admin-console="AdminConsoleShell"
  data-gp-admin-console-product="blessboard"
  data-gp-admin-console-stitch="BB-ADM-01"
  data-gp-admin-console-desktop="1440"
  data-gp-admin-console-mobile="390"
  data-bb-page="<%= activeNav || 'home' %>"
  data-bb-stitch-shell="51-hq-dashboard"
>
  <a class="bb-hq-skip" href="#bb-hq-main">Skip to content</a>
  <div id="bb-shell-nav-live" class="bb-shell-sr-only" aria-live="polite" aria-atomic="true"></div>

  <div class="bb-hq-app gp-admin-console__app" data-gp-admin-console-app="1">
    <aside class="bb-hq-sidebar gp-admin-console__sidebar" data-bb-nav="desktop-sidebar" data-gp-admin-console-sidebar="1" aria-label="HQ navigation">
      <div class="bb-hq-sidebar__brand">
        <a class="bb-hq-wordmark" href="/hq">
          <img
            class="bb-hq-wordmark__mark"
            src="<%= typeof cdnAsset==='function' ? cdnAsset('/church/images/brand/blessboard-small-church-logo.png') : '' %>"
            alt=""
            width="28"
            height="28"
            decoding="async"
          />
          <%- include('./platform-wordmark-text') %>
        </a>
        <p class="bb-hq-context" data-gp-admin-console-context="branch" data-bb-location-context="1">
          <span class="bb-hq-context__church"><%= hqChurch %></span>
          <% if (hqBranch) { %>
          <span class="bb-hq-context__hq" data-bb-branch-context="1"><%= hqBranch %></span>
          <% } %>
        </p>
        <span class="bb-hq-role" data-bb-hq-role="1">
          <span class="material-symbols-outlined" aria-hidden="true">domain</span>
          <%= hqRole %>
        </span>
      </div>

      <nav class="bb-hq-sidebar__nav" aria-label="HQ desktop" data-bb-nav="desktop" data-gp-admin-console-nav="1">
        <% if (hqNavGroups) { %>
        <% hqNavGroups.forEach(function (group) { %>
        <p class="bb-hq-nav-heading" data-bb-nav-heading="1" data-gp-admin-console-slot="<%= group.key %>"><%= group.label %></p>
        <% (group.items || []).forEach(function (item) { %>
        <% if (item.navHeading || !item.href) { %>
        <p class="bb-hq-nav-heading" data-bb-nav-heading="1"><%= item.label %></p>
        <% } else { %>
        <a
          href="<%= item.href %>"
          class="bb-hq-nav-link gp-admin-console__nav-item<%= activeNav === item.key ? ' is-active' : '' %>"
          <% if (activeNav === item.key) { %>aria-current="page"<% } %>
          data-bb-nav-key="<%= item.key %>"
          data-gp-admin-console-slot="<%= item.slot || group.key %>"
        >
          <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
          <span><%= item.label %></span>
        </a>
        <% } %>
        <% }) %>
        <% }) %>
        <% } else { %>
        <% hqNav.forEach(function (item) { %>
        <% if (item.navHeading || !item.href) { %>
        <p class="bb-hq-nav-heading" data-bb-nav-heading="1"><%= item.label %></p>
        <% } else { %>
        <a
          href="<%= item.href %>"
          class="bb-hq-nav-link gp-admin-console__nav-item<%= activeNav === item.key ? ' is-active' : '' %>"
          <% if (activeNav === item.key) { %>aria-current="page"<% } %>
          data-bb-nav-key="<%= item.key %>"
          data-gp-admin-console-slot="<%= item.slot || '' %>"
        >
          <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
          <span><%= item.label %></span>
        </a>
        <% } %>
        <% }) %>
        <% } %>
      </nav>

      <div class="bb-hq-sidebar__footer">
        <% if (hqDisplay) { %>
        <p class="bb-hq-user" data-bb-admin-user="1">
          <span class="bb-hq-user__name"><%= hqDisplay %></span>
          <span class="bb-hq-user__meta"><%= hqChurch %><% if (hqBranch) { %> · <%= hqBranch %><% } %></span>
        </p>
        <% } %>
        <form class="bb-hq-logout" method="post" action="/hq/logout" data-bb-hq-logout="1">
          <input type="hidden" name="_csrf" value="<%= hqCsrf %>" />
          <button type="submit">
            <span class="material-symbols-outlined" aria-hidden="true">logout</span>
            Sign out
          </button>
        </form>
        <%- include('./powered-by-getpro') %>
      </div>
    </aside>

    <div class="bb-hq-frame gp-admin-console__frame">
      <header class="bb-hq-top gp-admin-console__topbar" data-bb-nav="mobile-header" data-gp-admin-console-topbar="mobile">
        <div class="bb-hq-top__brand">
          <a class="bb-hq-wordmark bb-hq-wordmark--compact" href="/hq">
            <img
              class="bb-hq-wordmark__mark"
              src="<%= typeof cdnAsset==='function' ? cdnAsset('/church/images/brand/blessboard-small-church-logo.png') : '' %>"
              alt=""
              width="24"
              height="24"
              decoding="async"
            />
            <%- include('./platform-wordmark-text') %>
          </a>
          <p class="bb-hq-context bb-hq-context--compact">
            <%= hqChurch %><% if (hqBranch) { %> · <%= hqBranch %><% } %>
          </p>
        </div>
        <div class="bb-hq-top__actions">
          <button
            type="button"
            class="bb-hq-nav-toggle bb-shell-burger"
            id="bb-hq-menu-btn"
            data-bb-nav="mobile-toggle"
            aria-controls="bb-hq-drawer"
            aria-expanded="false"
            aria-label="Open navigation"
          >
            <span class="bb-shell-burger__icon" aria-hidden="true">
              <span class="bb-shell-burger__bar"></span>
              <span class="bb-shell-burger__bar"></span>
              <span class="bb-shell-burger__bar"></span>
            </span>
            <span class="bb-shell-burger__label">Menu</span>
          </button>
        </div>
      </header>

      <div
        id="bb-hq-drawer"
        class="bb-hq-drawer"
        data-bb-nav="mobile-drawer"
        role="dialog"
        aria-modal="true"
        aria-label="HQ navigation"
        inert
        hidden
      >
        <div class="bb-hq-drawer__scrim" data-bb-nav="drawer-close" tabindex="-1"></div>
        <nav class="bb-hq-drawer__panel" aria-label="HQ mobile">
          <div class="bb-hq-drawer__head">
            <p class="bb-hq-drawer__title">HQ Admin</p>
            <button
              type="button"
              class="bb-hq-drawer__close"
              data-bb-nav="drawer-close"
              aria-label="Close navigation"
            >
              <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
          </div>
          <% if (hqDisplay) { %>
          <p class="bb-hq-user bb-hq-user--drawer" data-bb-admin-user="1">
            <span class="bb-hq-user__name"><%= hqDisplay %></span>
            <span class="bb-hq-user__meta"><%= hqRole %></span>
          </p>
          <% } %>
          <div class="bb-hq-drawer__links" data-bb-nav="mobile-links">
            <%- include('./admin-mobile-nav-groups', {
              mobileNav: hqMobileNav,
              activeNav: activeNav,
              linkClass: 'bb-hq-nav-link',
              listClass: 'bb-hq-drawer__list',
              itemClass: 'bb-hq-drawer__item',
              idPrefix: 'bb-hq'
            }) %>
          </div>
          <div class="bb-hq-drawer__account">
            <% if (hqMobileNav.account && hqMobileNav.account.length) { %>
            <ul class="bb-hq-drawer__list bb-hq-drawer__account-list">
              <% hqMobileNav.account.forEach(function (item) { %>
              <li class="bb-hq-drawer__item">
                <a
                  href="<%= item.href %>"
                  class="bb-hq-nav-link<%= activeNav === item.key ? ' is-active' : '' %>"
                  <% if (activeNav === item.key) { %>aria-current="page"<% } %>
                  data-bb-nav-key="<%= item.key %>"
                >
                  <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
                  <span><%= item.label %></span>
                </a>
              </li>
              <% }) %>
            </ul>
            <% } %>
            <form class="bb-hq-logout" method="post" action="/hq/logout" data-bb-hq-logout="1">
              <input type="hidden" name="_csrf" value="<%= hqCsrf %>" />
              <button type="submit">
                <span class="material-symbols-outlined" aria-hidden="true">logout</span>
                Sign out
              </button>
            </form>
          </div>
          <div class="bb-hq-drawer__footer" data-bb-footer="drawer">
            <%- include('./powered-by-getpro') %>
          </div>
        </nav>
      </div>

      <main id="bb-hq-main" class="bb-hq-main" tabindex="-1">
        <%- include('./support-mode-banner') %>
        <div class="bb-hq-page" data-bb-page-area="1">
