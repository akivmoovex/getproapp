<%
  var orgLocal = (typeof org !== 'undefined' && org) ? org : {};
  var branchRowsLocal = (typeof branches !== 'undefined' && branches) ? branches : [];
  var statusChipFn = (typeof statusChip === 'function') ? statusChip : function () { return 'bb-pa-chip--muted'; };
  var statusLabelFn = (typeof statusLabel === 'function') ? statusLabel : function (s) { return s || '—'; };
  var phase5ApprovalNotices = {
    organization_provisioned: true,
    network_organization_created: true,
    already_provisioned: true,
    retry_succeeded: true
  };
  var phase5NoticeCode = typeof notice !== 'undefined' && notice ? String(notice) : '';
  var showPhase5ApprovalSuccess = Boolean(phase5ApprovalNotices[phase5NoticeCode]);
  var phase5AlreadyProvisioned = phase5NoticeCode === 'already_provisioned';
  var phase5InviteReady = typeof inviteOnceLink !== 'undefined' && inviteOnceLink;
  var phase5PendingInvite = typeof pendingInvitations !== 'undefined' && pendingInvitations && pendingInvitations.length;
  var phase5EmailFlash = typeof emailFlash !== 'undefined' ? String(emailFlash || '') : '';
  var phase5DeliveryFailed = phase5EmailFlash === 'delivery_failed';
  var phase5AdminLabel = null;
  if (phase5PendingInvite) {
    var firstInv = pendingInvitations[0];
    phase5AdminLabel = (firstInv && (firstInv.displayName || firstInv.emailDisplay || firstInv.emailNormalized)) || null;
  }
  var phase5PrimaryBranch = null;
  if (branchRowsLocal.length) {
    for (var bi = 0; bi < branchRowsLocal.length; bi++) {
      if (branchRowsLocal[bi] && branchRowsLocal[bi].isPrimary) {
        phase5PrimaryBranch = branchRowsLocal[bi];
        break;
      }
    }
    if (!phase5PrimaryBranch) phase5PrimaryBranch = branchRowsLocal[0];
  }
  var phase5BranchLabel = orgLocal.firstBranchName ||
    (phase5PrimaryBranch && phase5PrimaryBranch.displayName) ||
    null;
  var phase5PlanLabel = orgLocal.planLabel || orgLocal.planKey || null;
  var phase5OrgKey = orgLocal.organizationKey ? String(orgLocal.organizationKey) : null;
  var phase5OrgHref = phase5OrgKey
    ? ('/admin/organizations/' + encodeURIComponent(phase5OrgKey))
    : '#';
  var phase5OnboardingHref = phase5OrgHref !== '#' ? (phase5OrgHref + '#pa-org-onboarding') : '#pa-org-onboarding';
  var ob = (typeof onboardingSummary !== 'undefined' && onboardingSummary) ? onboardingSummary : null;
  var phase5PublicPath = null;
  var phase5PublicAvailable = false;
  var phase5PublicUnavailableReason = null;
  if (ob && ob.publicWebsitePath) {
    phase5PublicPath = String(ob.publicWebsitePath);
    phase5PublicAvailable = Boolean(ob.publicWebsiteAvailable);
    phase5PublicUnavailableReason = ob.publicWebsiteUnavailableReason || null;
  } else if (phase5OrgKey) {
    phase5PublicPath = '/c/' + encodeURIComponent(phase5OrgKey);
    phase5PublicAvailable = false;
    phase5PublicUnavailableReason = 'Confirm publication status on the organization page.';
  }
  var phase5PublicUrl = phase5PublicPath ? ('https://blessboard.org' + phase5PublicPath) : null;
%>
<% if (showPhase5ApprovalSuccess) { %>
<section
  class="bb-pa-panel bb-pa-reg-approved"
  data-bb-pa-reg-approved="1"
  data-bb-pa-reg-approved-notice="<%= phase5NoticeCode %>"
  data-bb-pa-reg-approved-already="<%= phase5AlreadyProvisioned ? '1' : '0' %>"
  aria-labelledby="pa-reg-approved-title"
>
  <header class="bb-pa-reg-approved__head">
    <div class="bb-pa-reg-approved__icon" aria-hidden="true">✓</div>
    <p class="bb-pa-org-detail__eyebrow"><%= phase5AlreadyProvisioned ? 'Already provisioned' : 'Church approved' %></p>
    <h2 id="pa-reg-approved-title" class="bb-pa-page-head__title bb-pa-reg-approved__title">
      <%= orgLocal.displayName || 'Church organization' %>
    </h2>
    <p class="bb-pa-lede bb-pa-reg-approved__badges">
      <span class="bb-pa-chip <%= statusChipFn(orgLocal.organizationStatus) %>" data-bb-pa-reg-approved-status="1">
        <%= statusLabelFn(orgLocal.organizationStatus) %>
      </span>
      <span data-bb-pa-reg-approved-complete-label="1">
        <%= phase5AlreadyProvisioned ? 'Organization already linked' : 'Registration complete' %>
      </span>
    </p>
    <p class="bb-pa-lede">
      <% if (phase5AlreadyProvisioned) { %>
      This registration was already linked to an organization. Provisioning was not run again.
      <% } else { %>
      Organization created. Administrator invitation delivery was attempted after provisioning committed.
      <% } %>
    </p>
  </header>

  <div class="bb-pa-reg-approved__grid">
    <dl class="bb-pa-dl bb-pa-reg-approved__facts">
      <% if (phase5OrgKey) { %>
      <div>
        <dt>Organization key</dt>
        <dd data-bb-pa-reg-approved-org-key="1"><code class="bb-pa-key"><%= phase5OrgKey %></code></dd>
      </div>
      <% } %>
      <% if (phase5PlanLabel) { %>
      <div>
        <dt>Service plan</dt>
        <dd data-bb-pa-reg-approved-plan="1"><%= phase5PlanLabel %></dd>
      </div>
      <% } %>
      <% if (phase5BranchLabel) { %>
      <div>
        <dt>First branch / location</dt>
        <dd data-bb-pa-reg-approved-branch="1"><%= phase5BranchLabel %></dd>
      </div>
      <% } %>
      <% if (phase5AdminLabel) { %>
      <div>
        <dt>Administrator</dt>
        <dd data-bb-pa-reg-approved-admin="1"><%= phase5AdminLabel %></dd>
      </div>
      <% } %>
      <div>
        <dt>Public miniwebsite</dt>
        <dd data-bb-pa-reg-approved-public="1">
          <% if (phase5PublicPath) { %>
          <code data-bb-pa-reg-approved-public-path="1"><%= phase5PublicPath %></code>
          <% if (phase5PublicAvailable) { %>
          <span class="bb-pa-chip bb-pa-chip--ok" data-bb-pa-reg-approved-public-ok="1">Published</span>
          <% } else { %>
          <span class="bb-pa-chip bb-pa-chip--warn" data-bb-pa-reg-approved-public-warn="1">Check status</span>
          <% } %>
          <% } else { %>
          <span data-bb-pa-reg-approved-public-missing="1">Not available</span>
          <% } %>
        </dd>
      </div>
      <div>
        <dt>Invitation status</dt>
        <dd data-bb-pa-reg-approved-invite-status="1">
          <% if (phase5DeliveryFailed) { %>
          Provisioning succeeded, but invitation email delivery failed or is unavailable. Resend from the invitation section or copy the one-time link when shown.
          <% } else if (phase5PendingInvite && pendingInvitations[0] && pendingInvitations[0].deliveryStatus === 'sent') { %>
          Invitation email recorded as sent. The administrator can complete setup from that link.
          <% } else if (phase5InviteReady) { %>
          Invitation prepared — delivery attempted. Copy once below if needed. It will not be shown again after you leave this page.
          <% } else if (phase5PendingInvite) { %>
          Invitation pending. Delivery status: <%= (pendingInvitations[0] && pendingInvitations[0].deliveryStatus) || 'pending' %>.
          <% } else if (phase5AlreadyProvisioned) { %>
          No new invitation was generated for this already-provisioned organization.
          <% } else { %>
          Administrator invitation prepared. Use the invitation section below when available.
          <% } %>
        </dd>
      </div>
    </dl>

    <aside class="bb-pa-reg-approved__invite-card" data-bb-pa-reg-approved-invite-card="1">
      <% if (phase5DeliveryFailed) { %>
      <p class="bb-pa-banner bb-pa-banner--warn" role="status" data-bb-pa-reg-approved-email-failed="1">
        Invitation email delivery failed or is unavailable. Provisioning was not rolled back.
      </p>
      <% } else { %>
      <p class="bb-pa-hint" data-bb-pa-reg-approved-email-note="1">
        Transactional invitation email is attempted after provisioning. Copy-once link remains available as a fallback when shown.
      </p>
      <% } %>
      <% if (phase5InviteReady) { %>
      <div class="bb-pa-field bb-pa-reg-approved__invite" data-bb-pa-reg-approved-invite="1">
        <label for="pa_phase5_invite_once_link">Copy invitation</label>
        <div class="bb-pa-reg-approved__invite-row">
          <input
            id="pa_phase5_invite_once_link"
            type="text"
            readonly
            value="<%= inviteOnceLink %>"
            data-bb-pa-invite-copy-once="1"
            onclick="this.select()"
          />
          <button
            type="button"
            class="bb-pa-btn bb-pa-btn--secondary"
            data-bb-pa-reg-approved-copy="1"
            data-invite-target="pa_phase5_invite_once_link"
          >Copy invitation</button>
        </div>
        <p class="bb-pa-muted">Invitation values are not placed in the URL. Refreshing clears this copy-once link.</p>
      </div>
      <% } %>
      <% if (!phase5PublicAvailable && phase5PublicUnavailableReason) { %>
      <p class="bb-pa-banner bb-pa-banner--warn" role="status" data-bb-pa-reg-approved-public-warning="1">
        Public miniwebsite warning: <%= phase5PublicUnavailableReason %>
      </p>
      <% } %>
    </aside>
  </div>

  <div class="bb-pa-reg-approved__next" data-bb-pa-reg-approved-next="1">
    <h3 class="bb-pa-section-title">Onboarding next steps</h3>
    <ol>
      <li>Copy and share the administrator invitation when available.</li>
      <li>Open the organization profile and confirm Foundation checklist items.</li>
      <li>Open the public miniwebsite path when published.</li>
    </ol>
  </div>

  <div class="bb-pa-reg-approved__actions">
    <a class="bb-pa-btn bb-pa-btn--primary" href="<%= phase5OrgHref %>" data-bb-pa-reg-approved-open-profile="1">Open organization</a>
    <% if (phase5PublicPath) { %>
    <a
      class="bb-pa-btn bb-pa-btn--secondary"
      href="<%= phase5PublicPath %>"
      rel="noopener"
      data-bb-pa-reg-approved-open-public="1"
      data-bb-pa-reg-approved-public-available="<%= phase5PublicAvailable ? '1' : '0' %>"
    ><%= phase5PublicAvailable ? 'Open public website' : 'Open public path' %></a>
    <% } %>
    <a class="bb-pa-btn bb-pa-btn--secondary" href="<%= phase5OnboardingHref %>" data-bb-pa-reg-approved-open-onboarding="1">Open onboarding</a>
    <a class="bb-pa-btn bb-pa-btn--secondary" href="/admin/registration-applications" data-bb-pa-reg-approved-return="1">Return to registrations</a>
  </div>
</section>
<script>
(function () {
  var btn = document.querySelector('[data-bb-pa-reg-approved-copy="1"]');
  if (!btn) return;
  btn.addEventListener('click', function () {
    var id = btn.getAttribute('data-invite-target');
    var input = id ? document.getElementById(id) : null;
    var value = input && input.value ? String(input.value) : '';
    if (!value) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(value).catch(function () {});
    } else if (input) {
      input.select();
    }
  });
})();
</script>
<% } %>
