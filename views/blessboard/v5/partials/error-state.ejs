<%#
  Error state panel. Locals: title, body, actionHref, actionLabel
%>
<div class="bb-ds-state" role="alert" data-bb-ds="error-state">
  <div class="bb-ds-state__icon">
    <%- include('./icon', { name: 'error' }) %>
  </div>
  <h2 class="bb-ds-state__title"><%= typeof title !== 'undefined' && title ? title : 'Something went wrong' %></h2>
  <% if (typeof body !== 'undefined' && body) { %>
  <p class="bb-ds-state__body"><%= body %></p>
  <% } %>
  <% if (typeof actionHref !== 'undefined' && actionHref) { %>
  <p>
    <a class="bb-ds-btn bb-ds-btn--primary" href="<%= actionHref %>"><%= typeof actionLabel !== 'undefined' && actionLabel ? actionLabel : 'Try again' %></a>
  </p>
  <% } %>
</div>
