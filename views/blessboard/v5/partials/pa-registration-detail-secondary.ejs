  <!-- Communication log + request additional information (Prompts 065–067) -->
  <%
    var commPayload = typeof communications !== 'undefined' && communications && typeof communications === 'object'
      ? communications
      : null;
    var commUnavailable = Boolean(commPayload && commPayload.unavailable);
    var commItems = commPayload && Array.isArray(commPayload.items) ? commPayload.items : [];
    var commSummary = commPayload && commPayload.summary && typeof commPayload.summary === 'object'
      ? commPayload.summary
      : {
          total: 0,
          internalNotes: 0,
          informationRequests: 0,
          applicantMessages: 0,
          rejectionNotices: 0,
          sendingUnavailable: 0,
          failed: 0,
          latestCommunicationAt: null
        };
    function communicationTypeLabel(item) {
      if (item && item.labels && item.labels.communicationType) return String(item.labels.communicationType);
      return labelStatus(item && item.communicationType);
    }
    function communicationChannelLabel(item) {
      if (item && item.labels && item.labels.channel) return String(item.labels.channel);
      return labelStatus(item && item.channel);
    }
    function communicationDirectionLabel(item) {
      if (item && item.labels && item.labels.direction) return String(item.labels.direction);
      return labelStatus(item && item.direction);
    }
    function communicationDeliveryLabel(status) {
      var s = String(status || '').trim().toLowerCase();
      if (s === 'sent') return 'Sent';
      if (s === 'sending_unavailable') return 'Sending unavailable';
      if (s === 'failed') return 'Failed';
      if (s === 'queued') return 'Queued';
      if (s === 'recorded') return 'Recorded';
      if (s === 'not_applicable') return 'Not applicable';
      if (!s) return 'Unknown';
      return labelStatus(s);
    }
    function communicationDeliveryTone(status) {
      var s = String(status || '').trim().toLowerCase();
      if (s === 'sent') return 'success';
      if (s === 'sending_unavailable') return 'warn';
      if (s === 'failed') return 'danger';
      if (s === 'queued') return 'warn';
      return 'muted';
    }
    function communicationRequestCategoryLabel(item) {
      if (!item) return null;
      if (item.labels && item.labels.requestCategory) return String(item.labels.requestCategory);
      return displayOrMissing(item.requestCategory);
    }
    function joinListValues(values) {
      if (!Array.isArray(values) || !values.length) return null;
      var parts = [];
      values.forEach(function (v) {
        var s = displayOrMissing(v);
        if (s) parts.push(s);
      });
      return parts.length ? parts.join(', ') : null;
    }
  %>
  <section
    id="reg-communications"
    class="bb-pa-panel bb-pa-reg-communications<%= commUnavailable ? ' bb-pa-reg-communications--unavailable' : '' %>"
    aria-labelledby="reg-communications-title"
    data-bb-pa-reg-section="communications"
    data-bb-pa-reg-communications="1"
    data-bb-pa-reg-communications-unavailable="<%= commUnavailable ? '1' : '0' %>"
  >
    <h2 id="reg-communications-title" class="bb-pa-section-title">Communication</h2>
    <p class="bb-pa-reg-origin" data-bb-pa-reg-origin="admin"><%= ORIGIN_ADMIN %></p>
    <p class="bb-pa-lede" data-bb-pa-reg-communications-lede="1">
      Review recorded messages and request additional information from the applicant.
    </p>

    <div class="bb-pa-reg-communications__history" data-bb-pa-reg-communications-history="1">
      <h3 class="bb-pa-lede" id="reg-communications-history-title">Communication log</h3>

      <% if (!commPayload) { %>
      <p class="bb-pa-muted" data-bb-pa-reg-communications-missing="1">
        Communication history is not available.
      </p>
      <% } else if (commUnavailable) { %>
      <p class="bb-pa-banner bb-pa-banner--warn" role="status" data-bb-pa-reg-communications-unavailable-banner="1">
        Communication history is temporarily unavailable
      </p>
      <% } else { %>
      <div class="bb-pa-reg-communications__summary" data-bb-pa-reg-communications-summary="1">
        <dl class="bb-pa-dl bb-pa-reg-communications__summary-dl">
          <div>
            <dt>Total communications</dt>
            <dd data-bb-pa-reg-communications-summary-total="1"><%= Number(commSummary.total) || 0 %></dd>
          </div>
          <div>
            <dt>Information requests</dt>
            <dd data-bb-pa-reg-communications-summary-information-requests="1"><%= Number(commSummary.informationRequests) || 0 %></dd>
          </div>
          <div>
            <dt>Internal notes</dt>
            <dd data-bb-pa-reg-communications-summary-internal-notes="1"><%= Number(commSummary.internalNotes) || 0 %></dd>
          </div>
          <div>
            <dt>Applicant messages</dt>
            <dd data-bb-pa-reg-communications-summary-applicant-messages="1"><%= Number(commSummary.applicantMessages) || 0 %></dd>
          </div>
          <div>
            <dt>Rejection notices</dt>
            <dd data-bb-pa-reg-communications-summary-rejection-notices="1"><%= Number(commSummary.rejectionNotices) || 0 %></dd>
          </div>
          <div>
            <dt>Sending unavailable</dt>
            <dd data-bb-pa-reg-communications-summary-sending-unavailable="1"><%= Number(commSummary.sendingUnavailable) || 0 %></dd>
          </div>
          <div>
            <dt>Failed</dt>
            <dd data-bb-pa-reg-communications-summary-failed="1"><%= Number(commSummary.failed) || 0 %></dd>
          </div>
          <div>
            <dt>Latest activity</dt>
            <dd data-bb-pa-reg-communications-summary-latest="1"><%= fmtDate(commSummary.latestCommunicationAt) || 'None' %></dd>
          </div>
        </dl>
      </div>

      <% if (!commItems.length) { %>
      <p class="bb-pa-muted" data-bb-pa-reg-communications-empty="1">
        No communication has been recorded
      </p>
      <% } else { %>
      <div class="bb-pa-reg-communications__list" data-bb-pa-reg-communications-list="1">
        <% commItems.forEach(function (item, itemIndex) { %>
        <%
          if (!item || typeof item !== 'object') return;
          var itemId = item.id != null ? String(item.id) : String(itemIndex);
          var itemType = item.communicationType != null ? String(item.communicationType) : '';
          var itemDelivery = item.deliveryStatus != null ? String(item.deliveryStatus) : '';
          var itemDeliveryLabel = communicationDeliveryLabel(itemDelivery);
          var itemDeliveryTone = toneChip(communicationDeliveryTone(itemDelivery));
          var itemRecipient = displayOrMissing(item.recipient);
          var itemSubject = displayOrMissing(item.subject);
          var itemApplicantMsg = displayOrMissing(item.applicantMessage);
          var itemInternalNote = displayOrMissing(item.internalNote);
          var itemCategory = communicationRequestCategoryLabel(item);
          var itemFields = joinListValues(item.requestedFields);
          var itemDocs = joinListValues(item.requestedDocuments);
          var itemDue = item.responseDueAt || null;
        %>
        <article
          class="bb-pa-reg-communications-card"
          data-bb-pa-reg-communications-card="1"
          data-bb-pa-reg-communications-card-id="<%= itemId %>"
          data-bb-pa-reg-communications-card-type="<%= itemType %>"
          data-bb-pa-reg-communications-card-delivery="<%= itemDelivery %>"
          aria-labelledby="reg-comm-card-<%= itemId %>"
        >
          <header class="bb-pa-reg-communications-card__head">
            <h4 id="reg-comm-card-<%= itemId %>" class="bb-pa-reg-communications-card__title">
              <%= communicationTypeLabel(item) %>
            </h4>
            <div class="bb-pa-reg-communications-card__badges">
              <span class="bb-pa-chip bb-pa-chip--muted" data-bb-pa-reg-communications-card-channel="1">
                <%= communicationChannelLabel(item) %>
              </span>
              <span class="bb-pa-chip bb-pa-chip--muted" data-bb-pa-reg-communications-card-direction="1">
                <%= communicationDirectionLabel(item) %>
              </span>
              <span class="bb-pa-chip <%= itemDeliveryTone %>" data-bb-pa-reg-communications-card-delivery-label="1"><%= itemDeliveryLabel %></span>
            </div>
          </header>

          <dl class="bb-pa-dl bb-pa-reg-communications-card__meta">
            <div>
              <dt>Type</dt>
              <dd data-bb-pa-reg-communications-card-type-label="1"><%= communicationTypeLabel(item) %></dd>
            </div>
            <div>
              <dt>Created</dt>
              <dd data-bb-pa-reg-communications-card-created="1"><%= fmtDate(item.createdAt) || 'Not provided' %></dd>
            </div>
            <% if (itemRecipient) { %>
            <div>
              <dt>Recipient</dt>
              <dd data-bb-pa-reg-communications-card-recipient="1"><%= itemRecipient %></dd>
            </div>
            <% } %>
            <% if (itemSubject) { %>
            <div>
              <dt>Subject</dt>
              <dd data-bb-pa-reg-communications-card-subject="1"><%= itemSubject %></dd>
            </div>
            <% } %>
            <% if (itemCategory) { %>
            <div>
              <dt>Request category</dt>
              <dd data-bb-pa-reg-communications-card-category="1"><%= itemCategory %></dd>
            </div>
            <% } %>
            <% if (itemFields) { %>
            <div>
              <dt>Requested fields</dt>
              <dd data-bb-pa-reg-communications-card-fields="1"><%= itemFields %></dd>
            </div>
            <% } %>
            <% if (itemDocs) { %>
            <div>
              <dt>Requested documents</dt>
              <dd data-bb-pa-reg-communications-card-documents="1"><%= itemDocs %></dd>
            </div>
            <% } %>
            <% if (itemDue) { %>
            <div>
              <dt>Response deadline</dt>
              <dd data-bb-pa-reg-communications-card-deadline="1"><%= fmtDate(itemDue) || 'Not provided' %></dd>
            </div>
            <% } %>
          </dl>

          <% if (itemApplicantMsg) { %>
          <div
            class="bb-pa-reg-communications-card__applicant"
            data-bb-pa-reg-communications-card-applicant="1"
          >
            <p class="bb-pa-reg-communications-card__block-label">Applicant-facing message</p>
            <p class="bb-pa-reg-communications-card__block-body"><%= itemApplicantMsg %></p>
          </div>
          <% } %>

          <% if (itemInternalNote) { %>
          <div
            class="bb-pa-reg-communications-card__internal"
            data-bb-pa-reg-communications-card-internal="1"
          >
            <p class="bb-pa-reg-communications-card__block-label">Internal note</p>
            <p class="bb-pa-reg-communications-card__block-body"><%= itemInternalNote %></p>
          </div>
          <% } %>
        </article>
        <% }) %>
      </div>
      <% } %>
      <% } %>
    </div>

    <div class="bb-pa-reg-communications__compose" data-bb-pa-reg-communications-compose="1">
      <h3 class="bb-pa-lede" id="reg-communications-compose-title">Request additional information</h3>
      <p class="bb-pa-hint" role="note" data-bb-pa-reg-communications-email-unavailable="1">
        Outbound email may be unavailable. Recording a request does not confirm that a message was delivered, opened, or bounced.
      </p>
      <p class="bb-pa-lede" data-bb-pa-reg-communications-compose-lede="1">
        Use the dedicated Phase 5 request-information page to record what is needed. This section keeps communication history only.
      </p>
      <div class="bb-pa-reg-communications__compose-actions" data-bb-pa-reg-communications-compose-actions="1">
        <a
          class="bb-pa-btn bb-pa-btn--primary"
          href="/admin/registration-applications/<%= app.id %>/request-information"
          data-bb-pa-reg-communications-open-request="1"
          data-bb-pa-reg-communications-submit="1"
        >Continue to request information</a>
      </div>
    </div>
  </section>

  <!-- Review activity -->
