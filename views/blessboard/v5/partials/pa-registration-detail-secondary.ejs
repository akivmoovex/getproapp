<%#
  Secondary registration review evidence (Phase 5).
  Included inside collapsed Additional review details on the decision hub.
  Relies on locals/helpers defined by registration-application-detail.ejs.
%>
<%
  var app = (typeof application !== 'undefined' && application) ? application : {};
  var ov = app.operatorView || {};
  var contactRows = contacts || [];
  var audits = auditEvents || [];
  var admins = platformAdmins || [];
  var followOpts = followUpStatuses || [];
  var methodOpts = contactMethods || [];
  var outcomeOpts = contactOutcomes || [];
  var flashNotice = typeof notice !== 'undefined' ? notice : null;
  var flashError = typeof error !== 'undefined' ? error : null;
  var displayStatus = ov.displayStatus || app.displayStatus || '—';
  var statusExplanation = ov.explanation || app.statusExplanation || '';
  var operatorQueue = ov.queue || app.operatorQueue || '';
  var operatorTone = ov.tone || app.operatorTone || 'muted';
  var organizationHref = ov.organizationHref ||
    (app.organizationKey
      ? '/admin/organizations/' + encodeURIComponent(app.organizationKey)
      : null);

  function labelStatus(s) {
    return String(s || '').replace(/_/g, ' ') || '—';
  }
  function toneChip(tone) {
    if (typeof registrationStatus !== 'undefined' && registrationStatus && registrationStatus.chipClassForTone) {
      return registrationStatus.chipClassForTone(tone);
    }
    if (tone === 'success') return 'bb-pa-chip--ok';
    if (tone === 'danger') return 'bb-pa-chip--danger';
    if (tone === 'warn') return 'bb-pa-chip--warn';
    return 'bb-pa-chip--muted';
  }
  function fmtDate(d) {
    if (!d) return null;
    try {
      return new Date(d).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
    } catch (e) {
      return null;
    }
  }
  function displayOrMissing(value) {
    if (value == null) return null;
    var s = String(value).trim();
    return s ? s : null;
  }
  function noticeText(code) {
    if (code === 'follow_up_saved') return 'Follow-up status updated.';
    if (code === 'support_assigned') return 'Support assignment saved.';
    if (code === 'contact_saved') return 'Contact note added.';
    if (code === 'approved') return 'Application approved and provisioned.';
    if (code === 'already_provisioned') return 'Organization was already provisioned.';
    if (code === 'network_organization_created') {
      return 'Network organization created. Activate the Network plan from the organization page when ready.';
    }
    if (code === 'validation_complete') {
      return 'Network validation marked complete. A platform administrator can create the organization.';
    }
    if (code === 'rejected') return 'Application rejected. No organization was provisioned.';
    if (code === 'application_rejected') {
      return 'Application rejected. No organization was provisioned. This does not confirm that a rejection message was delivered.';
    }
    if (code === 'application_reopened') {
      return 'Application reopened for review. Prior rejection history and communications were preserved. No email was sent.';
    }
    if (code === 'retry_succeeded') return 'Provisioning retry completed.';
    if (code === 'organization_linked') return 'Application linked to the existing organization.';
    if (code === 'phone_attempt_recorded') return 'Phone verification attempt recorded.';
    if (code === 'email_verification_sent') {
      return 'Verification email resend was accepted for processing.';
    }
    if (code === 'information_requested') {
      return 'Information request recorded. Follow-up is set to awaiting customer. This does not confirm that a message was delivered.';
    }
    return null;
  }
  function errorText(code) {
    if (code === 'csrf') return 'Invalid or missing security token. Reload and try again.';
    if (code === 'confirm_required') return 'Confirmation is required.';
    if (code === 'invalid') return 'The request could not be processed. Review the fields and try again.';
    if (code === 'phone_attempt_failed') return 'The call attempt could not be saved right now.';
    if (code === 'cooldown') {
      return 'Please wait at least 60 seconds before resending another verification email.';
    }
    if (code === 'invalid_email') {
      return 'The applicant email is missing or invalid.';
    }
    if (code === 'email_sending_unavailable') {
      return 'Email delivery is not configured. A verification token was recorded but no message was sent.';
    }
    if (code === 'sending_unavailable') {
      return 'Outbound email is not available right now. The information request was not recorded as sent.';
    }
    if (code === 'email_verification_failed') {
      return 'The verification email could not be processed right now.';
    }
    if (code === 'information_request_failed') {
      return 'The information request could not be saved right now.';
    }
    if (code === 'not_found') return 'This registration application could not be found.';
    if (code === 'organization_not_found') return 'That organization key was not found.';
    if (code === 'not_provisioned') {
      return 'This action is available after the organization is provisioned.';
    }
    if (code === 'not_eligible') {
      return 'This application is not eligible for that action.';
    }
    if (code === 'identity_conflict') {
      return 'The administrator email belongs to an account that cannot safely own this church. Resolve the identity conflict before approving.';
    }
    if (code === 'duplicate_email_review') {
      return 'This email still needs duplicate review before provisioning can continue.';
    }
    if (code === 'network_validation_required') {
      return 'Network validation must be completed before creating the organization.';
    }
    if (code === 'administrator_email_required') {
      return 'Administrator email is required.';
    }
    if (code === 'not_platform_admin') return 'Only active platform administrators can be assigned.';
    if (code === 'provision_failed') {
      return 'Provisioning failed. No organization was created.';
    }
    if (code === 'schema_mismatch') {
      return 'Registration approval is temporarily unavailable because the database schema is incomplete. BlessBoard support has been notified via server logs — try again after pending migrations are applied.';
    }
    if (code === 'follow_up_failed' || code === 'assign_failed' || code === 'contact_failed' ||
        code === 'reject_failed' || code === 'reopen_failed' || code === 'approve_failed' ||
        code === 'retry_failed' || code === 'link_failed') {
      return 'The change could not be saved. Try again.';
    }
    return code ? 'Something went wrong.' : null;
  }
  var noticeMsg = noticeText(flashNotice);
  var errorMsg = errorText(flashError);
  var cityVal = displayOrMissing(app.city);
  var countryVal = displayOrMissing(app.country);
  var locationLabel = [cityVal, countryVal].filter(Boolean).join(', ') || null;
  var roleVal = displayOrMissing(app.roleInChurch);
  var branchNameVal = displayOrMissing(app.branchName);
  var branchCountVal = displayOrMissing(app.branchCount);
  var messageVal = displayOrMissing(app.message);
  var assigneeLabel = displayOrMissing(app.assignedSupportDisplayName) ||
    displayOrMissing(app.assignedSupportEmail) ||
    null;
  var submittedLabel = fmtDate(app.createdAt);
  var lastActivityLabel = fmtDate(app.lastActivityAt) || fmtDate(app.lastContactedAt) || submittedLabel;
  var appRef = displayOrMissing(app.id);
  var ORIGIN_APPLICANT = 'Applicant-provided';
  var ORIGIN_SYSTEM = 'System-derived';
  var ORIGIN_ADMIN = 'Administrator-entered';
%>


<nav class="bb-pa-reg-section-nav" aria-label="Additional review sections" data-bb-pa-reg-section-nav="1">
  <a href="#reg-actions">Actions</a>
  <a href="#reg-details">Details</a>
  <a href="#reg-verification">Verification</a>
  <a href="#reg-recommendation">Recommendation</a>
  <a href="#reg-approval-checklist" data-bb-pa-reg-checklist-nav="1">Approval checklist</a>
  <a href="#reg-phone-verification">Phone</a>
  <a href="#reg-email-verification">Email</a>
  <a href="#reg-communications" data-bb-pa-reg-communications-nav="1">Communication</a>
  <a href="#reg-rejection" data-bb-pa-reg-rejection-nav="1">Rejection</a>
  <a href="#reg-activity">Activity</a>
</nav>

  <section
    id="reg-actions"
    class="bb-pa-panel bb-pa-reg-actions"
    aria-labelledby="reg-action-title"
    data-bb-pa-reg-section="actions"
  >
    <h2 id="reg-action-title" class="bb-pa-section-title">Review actions</h2>
    <p class="bb-pa-hint">
      Approval confirmation and rejection use the Phase 5 dedicated pages. Retry and network validation remain here when available.
    </p>

    <% if (app.riskReviewActionsAvailable || app.networkApproveAvailable) { %>
    <p class="bb-pa-lede">
      <% if (app.networkApproveAvailable && !app.riskReviewActionsAvailable) { %>
      Network approval creates the organization. Confirm on the dedicated approval page before continuing.
      <% } else { %>
      Approve provisions this application with the canonical orchestrator. Confirm on the dedicated approval page before continuing.
      <% } %>
    </p>
    <p>
      <a
        class="bb-pa-btn bb-pa-btn--primary"
        href="/admin/registration-applications/<%= app.id %>/approve"
        data-bb-pa-approve-confirm-link="1"
        data-bb-pa-approve-form="1"
        <%= app.networkApproveAvailable && !app.riskReviewActionsAvailable ? 'data-bb-pa-network-approve-form="1"' : '' %>
      ><%= app.networkApproveAvailable && !app.riskReviewActionsAvailable ? 'Continue to organization approval' : 'Continue to approval confirmation' %></a>
    </p>

    <% } else if (app.retryProvisionAvailable) { %>
    <p class="bb-pa-lede" role="note" data-bb-pa-provisioning-failed="1">
      <%= app.retryAllowedNote || 'Review the failure category in technical details, then retry only if no organization was created.' %>
    </p>
    <form
      class="bb-pa-form"
      method="post"
      action="/admin/registration-applications/<%= app.id %>/retry-provision"
      data-bb-pa-retry-provision-form="1"
    >
      <input type="hidden" name="<%= csrfField || '_csrf' %>" value="<%= csrfToken || '' %>" />
      <p class="bb-pa-lede">
        Retry uses the same idempotent provisioning orchestrator. It will not create a duplicate tenant if one already exists.
        An invitation will be created for the church administrator if provisioning succeeds.
      </p>
      <div class="bb-pa-field">
        <label for="retry_organization_key">Organization key (optional override)</label>
        <input id="retry_organization_key" name="organization_key" type="text" maxlength="80" autocomplete="off" />
      </div>
      <button class="bb-pa-btn bb-pa-btn--primary" type="submit">Retry provisioning</button>
    </form>

    <% } else if (app.markValidationCompleteAvailable) { %>
    <form
      class="bb-pa-form"
      method="post"
      action="/admin/registration-applications/<%= app.id %>/mark-validation-complete"
      data-bb-pa-mark-validation-form="1"
    >
      <input type="hidden" name="<%= csrfField || '_csrf' %>" value="<%= csrfToken || '' %>" />
      <p class="bb-pa-lede">
        Confirm that customer-support validation is complete so a platform administrator can create the organization.
      </p>
      <button class="bb-pa-btn bb-pa-btn--primary" type="submit">Mark validation complete</button>
    </form>

    <% } else if (app.organizationKey && organizationHref) { %>
    <p class="bb-pa-lede">
      <a class="bb-pa-btn bb-pa-btn--primary" href="<%= organizationHref %>" data-bb-pa-view-organization="1">View organization</a>
    </p>
    <% if (app.organizationDisplayName) { %>
    <p class="bb-pa-muted"><%= app.organizationDisplayName %> · <code class="bb-pa-key"><%= app.organizationKey %></code></p>
    <% } %>

    <% } else { %>
    <p class="bb-pa-lede">
      <%= ov.recommendedActionLabel || app.recommendedActionLabel || 'No action required' %>
    </p>
    <% } %>

    <% if (app.provisioningStatus === 'provisioning_failed' && !app.retryProvisionAvailable) { %>
    <p class="bb-pa-lede" role="note" data-bb-pa-provisioning-failed="1">
      <%= app.retryAllowedNote || 'This failure is not retryable from this screen.' %>
    </p>
    <% } %>
  </section>

  <!-- Rejection workspace (Prompt 070) -->
  <%
    var rejectionCategories = [
      { value: 'duplicate_registration', label: 'Duplicate registration' },
      { value: 'applicant_not_authorized', label: 'Applicant not authorized' },
      { value: 'contact_not_verified', label: 'Contact not verified' },
      { value: 'invalid_or_incomplete_information', label: 'Invalid or incomplete information' },
      { value: 'church_identity_not_confirmed', label: 'Church identity not confirmed' },
      { value: 'fraudulent_or_prohibited_use', label: 'Fraudulent or prohibited use' },
      { value: 'unsupported_organization_type', label: 'Unsupported organization type' },
      { value: 'applicant_withdrew', label: 'Applicant withdrew' },
      { value: 'other', label: 'Other' }
    ];
    function rejectionCategoryLabel(value) {
      var key = String(value || '').trim().toLowerCase();
      for (var i = 0; i < rejectionCategories.length; i += 1) {
        if (rejectionCategories[i].value === key) return rejectionCategories[i].label;
      }
      return key ? labelStatus(key) : null;
    }
    function rejectionNotificationLabel(status) {
      var s = String(status || '').trim().toLowerCase();
      if (s === 'sent') return 'Sent';
      if (s === 'sending_unavailable') return 'Sending unavailable';
      if (s === 'failed') return 'Failed';
      if (s === 'queued') return 'Queued';
      if (s === 'recorded') return 'Recorded';
      if (!s) return 'Not recorded';
      return labelStatus(s);
    }
    var isRejectedApp = String(app.applicationStatus || '') === 'rejected';
    var showRejectionForm = Boolean(app.rejectActionsAvailable);
    var showRejectionCompleted = isRejectedApp;
    var rejectEvent = null;
    if (showRejectionCompleted && Array.isArray(app.reviewEvents)) {
      for (var ri = app.reviewEvents.length - 1; ri >= 0; ri -= 1) {
        var ev = app.reviewEvents[ri];
        if (ev && typeof ev === 'object' && String(ev.action || '') === 'reject') {
          rejectEvent = ev;
          break;
        }
      }
    }
    var rejectedAt = (rejectEvent && rejectEvent.at) || app.riskDecidedAt || null;
    var rejectedById = rejectEvent && rejectEvent.actor_user_id
      ? String(rejectEvent.actor_user_id)
      : null;
    var rejectedByLabel = 'Platform administrator';
    if (rejectedById && Array.isArray(admins)) {
      for (var ai = 0; ai < admins.length; ai += 1) {
        if (admins[ai] && String(admins[ai].id) === rejectedById) {
          rejectedByLabel = displayOrMissing(admins[ai].displayName) ||
            displayOrMissing(admins[ai].email) ||
            rejectedByLabel;
          break;
        }
      }
    }
    var completedCategory = displayOrMissing(app.rejectionCategory) ||
      (rejectEvent && rejectEvent.rejection_category
        ? String(rejectEvent.rejection_category)
        : null);
    var completedReapply = app.reapplicationAllowed;
    if (completedReapply == null && rejectEvent && typeof rejectEvent.reapplication_allowed === 'boolean') {
      completedReapply = rejectEvent.reapplication_allowed;
    }
    var completedNotifyStatus = displayOrMissing(app.rejectionNotificationStatus) ||
      (rejectEvent && rejectEvent.notification_status
        ? String(rejectEvent.notification_status)
        : null);
    var completedApplicantExplanation = null;
    var commForReject = typeof communications !== 'undefined' && communications && typeof communications === 'object'
      ? communications
      : null;
    if (commForReject && Array.isArray(commForReject.items)) {
      for (var ci = 0; ci < commForReject.items.length; ci += 1) {
        var citem = commForReject.items[ci];
        if (citem && String(citem.communicationType || '') === 'rejection_notice') {
          completedApplicantExplanation = displayOrMissing(citem.applicantMessage);
          break;
        }
      }
    }
    var completedInternalNote = displayOrMissing(app.rejectionReason);
    var canReopenSecondary =
      showRejectionCompleted &&
      !app.organizationId &&
      String(app.provisioningStatus || '') !== 'provisioned';
  %>
  <% if (showRejectionForm || showRejectionCompleted) { %>
  <section
    id="reg-rejection"
    class="bb-pa-panel bb-pa-reg-rejection<%= showRejectionCompleted ? ' bb-pa-reg-rejection--completed' : '' %>"
    aria-labelledby="reg-rejection-title"
    data-bb-pa-reg-section="rejection"
    data-bb-pa-reg-rejection="1"
    data-bb-pa-reg-rejection-completed="<%= showRejectionCompleted ? '1' : '0' %>"
  >
    <h2 id="reg-rejection-title" class="bb-pa-section-title">Rejection workspace</h2>
    <p class="bb-pa-reg-origin" data-bb-pa-reg-origin="admin"><%= ORIGIN_ADMIN %></p>

    <% if (showRejectionCompleted) { %>
    <div class="bb-pa-reg-rejection__completed" data-bb-pa-reg-rejection-completed-panel="1">
      <p class="bb-pa-lede" data-bb-pa-reg-rejection-completed-lede="1">
        This application has been rejected. No organization was provisioned from this decision.
      </p>
      <p>
        <a
          class="bb-pa-btn bb-pa-btn--secondary"
          href="/admin/registration-applications/<%= app.id %>/rejected"
          data-bb-pa-reg-rejection-view-result="1"
        >View Phase 5 rejection summary</a>
      </p>
      <dl class="bb-pa-dl bb-pa-reg-rejection__summary-dl" data-bb-pa-reg-rejection-summary="1">
        <div>
          <dt>Rejected by</dt>
          <dd data-bb-pa-reg-rejection-rejected-by="1"><%= rejectedByLabel %></dd>
        </div>
        <div>
          <dt>Rejected date</dt>
          <dd data-bb-pa-reg-rejection-rejected-at="1"><%= fmtDate(rejectedAt) || 'Not provided' %></dd>
        </div>
        <div>
          <dt>Category</dt>
          <dd data-bb-pa-reg-rejection-category="1"><%= rejectionCategoryLabel(completedCategory) || 'Not provided' %></dd>
        </div>
        <div>
          <dt>Reapplication allowed</dt>
          <dd data-bb-pa-reg-rejection-reapplication="1">
            <% if (completedReapply == null) { %>Not provided<% } else { %><%= completedReapply ? 'Yes' : 'No' %><% } %>
          </dd>
        </div>
        <div>
          <dt>Notification status</dt>
          <dd data-bb-pa-reg-rejection-notification="1"><%= rejectionNotificationLabel(completedNotifyStatus) %></dd>
        </div>
      </dl>

      <% if (completedApplicantExplanation) { %>
      <div
        class="bb-pa-reg-rejection__applicant"
        data-bb-pa-reg-rejection-applicant-completed="1"
      >
        <p class="bb-pa-reg-rejection__block-label">Applicant-facing explanation</p>
        <p class="bb-pa-reg-rejection__block-body"><%= completedApplicantExplanation %></p>
      </div>
      <% } %>

      <% if (completedInternalNote) { %>
      <div
        class="bb-pa-reg-rejection__internal"
        data-bb-pa-reg-rejection-internal-completed="1"
      >
        <p class="bb-pa-reg-rejection__block-label">Internal decision notes</p>
        <p class="bb-pa-reg-rejection__block-body"><%= completedInternalNote %></p>
      </div>
      <% } %>

      <% if (canReopenSecondary) { %>
      <div class="bb-pa-reg-rejection__reopen" data-bb-pa-reg-rejection-reopen="1">
        <h3 class="bb-pa-reg-rejection__reopen-title" id="reg-reopen-title">Reopen application</h3>
        <p class="bb-pa-muted" data-bb-pa-reg-rejection-reopen-lede="1">
          Return this application to submitted for further review. Rejection history, metadata, and communication records are preserved. No email is sent automatically.
        </p>
        <form
          class="bb-pa-form bb-pa-reg-rejection__reopen-form"
          method="post"
          action="/admin/registration-applications/<%= app.id %>/reopen"
          data-bb-pa-reopen-form="1"
          data-bb-pa-reg-rejection-reopen-form="1"
          aria-labelledby="reg-reopen-title"
        >
          <input type="hidden" name="<%= csrfField || '_csrf' %>" value="<%= csrfToken || '' %>" />
          <div class="bb-pa-field">
            <label for="reopen_reason">Reason for reopen</label>
            <textarea
              id="reopen_reason"
              name="reopen_reason"
              rows="3"
              maxlength="500"
              required
              data-bb-pa-reg-rejection-field="reopen_reason"
            ></textarea>
          </div>
          <div class="bb-pa-reg-rejection__reopen-actions" data-bb-pa-reg-rejection-reopen-actions="1">
            <button
              class="bb-pa-btn bb-pa-btn--secondary"
              type="submit"
              data-bb-pa-reg-rejection-reopen-submit="1"
            >
              Reopen application
            </button>
          </div>
        </form>
      </div>
      <% } else { %>
      <p class="bb-pa-hint" data-bb-pa-reg-rejection-no-reopen="1">
        Reopen is not available while this registration is linked or provisioned.
      </p>
      <% } %>
    </div>
    <% } else if (showRejectionForm) { %>
    <p class="bb-pa-lede" data-bb-pa-reg-rejection-lede="1">
      Record a rejection decision on the dedicated confirmation page. This does not provision an organization.
    </p>
    <p class="bb-pa-hint" role="note" data-bb-pa-reg-rejection-email-unavailable="1">
      Outbound email may be unavailable. Recording a rejection does not confirm that a message was delivered, opened, or bounced.
    </p>
    <div class="bb-pa-reg-rejection__actions" data-bb-pa-reg-rejection-actions="1">
      <a
        class="bb-pa-btn bb-pa-btn--danger"
        href="/admin/registration-applications/<%= app.id %>/reject"
        data-bb-pa-reg-rejection-form="1"
        data-bb-pa-reject-form="1"
        data-bb-pa-reg-rejection-submit="1"
      >Continue to rejection confirmation</a>
    </div>
    <% } %>
  </section>
  <% } %>

  <!-- Structured registration details -->
  <div
    id="reg-details"
    class="bb-pa-reg-detail-grid"
    data-bb-pa-reg-section="details"
    data-bb-pa-reg-detail-grid="1"
  >
    <section class="bb-pa-panel bb-pa-reg-card" aria-labelledby="reg-church-title" data-bb-pa-reg-card="church">
      <h2 id="reg-church-title" class="bb-pa-section-title">Church information</h2>
      <p class="bb-pa-reg-origin" data-bb-pa-reg-origin="applicant"><%= ORIGIN_APPLICANT %></p>
      <dl class="bb-pa-dl">
        <div>
          <dt>Church name</dt>
          <dd><%= displayOrMissing(app.churchName) || 'Not provided' %></dd>
        </div>
        <div>
          <dt>Requested plan</dt>
          <dd>
            <%= app.selectedPlanLabel || app.selectedPlan || 'Not provided' %>
            <% if (app.isNetworkPlan) { %>
            <span class="bb-pa-chip bb-pa-chip--warn" data-bb-pa-plan-badge="network">Network</span>
            <% } %>
          </dd>
        </div>
        <% if (branchCountVal) { %>
        <div>
          <dt>Existing branch count (stated)</dt>
          <dd><%= branchCountVal %></dd>
        </div>
        <% } %>
        <% if (messageVal) { %>
        <div>
          <dt>Applicant notes</dt>
          <dd><%= messageVal %></dd>
        </div>
        <% } %>
      </dl>
    </section>

    <section class="bb-pa-panel bb-pa-reg-card" aria-labelledby="reg-location-title" data-bb-pa-reg-card="location">
      <h2 id="reg-location-title" class="bb-pa-section-title">Location and first branch</h2>
      <p class="bb-pa-reg-origin" data-bb-pa-reg-origin="applicant"><%= ORIGIN_APPLICANT %></p>
      <dl class="bb-pa-dl">
        <div>
          <dt>Country</dt>
          <dd><%= countryVal || 'Not provided' %></dd>
        </div>
        <div>
          <dt>Town or city</dt>
          <dd><%= cityVal || 'Not provided' %></dd>
        </div>
        <% if (locationLabel) { %>
        <div>
          <dt>Location summary</dt>
          <dd><%= locationLabel %></dd>
        </div>
        <% } %>
        <div>
          <dt>First branch name</dt>
          <dd><%= branchNameVal || 'Not provided' %></dd>
        </div>
      </dl>
    </section>

    <section
      id="reg-applicant"
      class="bb-pa-panel bb-pa-reg-card"
      aria-labelledby="reg-applicant-title"
      data-bb-pa-reg-card="applicant"
      data-bb-pa-reg-section="applicant"
    >
      <h2 id="reg-applicant-title" class="bb-pa-section-title">Contact and applicant</h2>
      <p class="bb-pa-reg-origin" data-bb-pa-reg-origin="applicant"><%= ORIGIN_APPLICANT %></p>
      <dl class="bb-pa-dl">
        <div>
          <dt>Applicant name</dt>
          <dd data-bb-pa-reg-applicant-name="1"><%= displayOrMissing(app.contactName) || 'Not provided' %></dd>
        </div>
        <div>
          <dt>Role or relationship</dt>
          <dd><%= roleVal || 'Not provided' %></dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd data-bb-pa-reg-applicant-phone="1"><%= displayOrMissing(app.contactPhone) || 'Not provided' %></dd>
        </div>
        <% if (displayOrMissing(app.contactPhoneNormalized)) { %>
        <div>
          <dt>Phone (normalized)</dt>
          <dd><code class="bb-pa-key"><%= app.contactPhoneNormalized %></code></dd>
        </div>
        <% } %>
        <div>
          <dt>Email</dt>
          <dd data-bb-pa-reg-applicant-email="1"><%= displayOrMissing(app.contactEmail) || 'Not provided' %></dd>
        </div>
        <div>
          <dt>Support request</dt>
          <dd>
            <% if (app.supportRequested) { %>
            <span class="bb-pa-chip bb-pa-chip--warn" data-bb-pa-support-requested="1">Support requested</span>
            <% } else { %>
            Not requested
            <% } %>
          </dd>
        </div>
      </dl>
    </section>

    <section
      id="reg-administration"
      class="bb-pa-panel bb-pa-reg-card"
      aria-labelledby="reg-proposed-admin-title"
      data-bb-pa-reg-card="administration"
      data-bb-pa-reg-section="administration"
    >
      <h2 id="reg-proposed-admin-title" class="bb-pa-section-title">Proposed administration</h2>
      <p class="bb-pa-reg-origin" data-bb-pa-reg-origin="applicant"><%= ORIGIN_APPLICANT %></p>
      <p class="bb-pa-hint">
        No separate proposed-administrator fields are stored. Contact details below are shown as the applicant contact used for provisioning invitations.
      </p>
      <dl class="bb-pa-dl">
        <div>
          <dt>Proposed administrator name</dt>
          <dd><%= displayOrMissing(app.contactName) || 'Not provided' %></dd>
        </div>
        <div>
          <dt>Proposed administrator email</dt>
          <dd><%= displayOrMissing(app.contactEmail) || 'Not provided' %></dd>
        </div>
        <div>
          <dt>Proposed administrator phone</dt>
          <dd><%= displayOrMissing(app.contactPhone) || 'Not provided' %></dd>
        </div>
      </dl>
    </section>

    <section
      id="reg-website"
      class="bb-pa-panel bb-pa-reg-card"
      aria-labelledby="reg-website-title"
      data-bb-pa-reg-card="website"
      data-bb-pa-reg-section="website"
    >
      <h2 id="reg-website-title" class="bb-pa-section-title">Website and access</h2>
      <p class="bb-pa-reg-origin" data-bb-pa-reg-origin="system"><%= ORIGIN_SYSTEM %></p>
      <dl class="bb-pa-dl">
        <div>
          <dt>Provisioning status</dt>
          <dd>
            <%- include('../partials/pa-registration-status-chip', { statusKind: 'provisioning', statusValue: app.provisioningStatus }) %>
          </dd>
        </div>
        <% if (app.organizationKey) { %>
        <div>
          <dt>Organization key</dt>
          <dd><code class="bb-pa-key"><%= app.organizationKey %></code></dd>
        </div>
        <div>
          <dt>Linked organization</dt>
          <dd>
            <% if (organizationHref) { %>
            <a class="bb-pa-link" href="<%= organizationHref %>"><%= app.organizationDisplayName || app.organizationKey %></a>
            <% } else { %>
            <%= app.organizationDisplayName || app.organizationKey %>
            <% } %>
          </dd>
        </div>
        <% if (app.organizationStatus) { %>
        <div>
          <dt>Organization status</dt>
          <dd><%= labelStatus(app.organizationStatus) %></dd>
        </div>
        <% } %>
        <% } else { %>
        <div>
          <dt>Linked organization</dt>
          <dd>Not linked</dd>
        </div>
        <% } %>
      </dl>
      <p class="bb-pa-hint">
        No requested website URL or slug was stored on this application. Domain and publication setup appear on the organization after provisioning.
      </p>
    </section>

    <section class="bb-pa-panel bb-pa-reg-card" aria-labelledby="reg-declarations-title" data-bb-pa-reg-card="declarations">
      <h2 id="reg-declarations-title" class="bb-pa-section-title">Declarations and submission</h2>
      <p class="bb-pa-reg-origin" data-bb-pa-reg-origin="applicant"><%= ORIGIN_APPLICANT %></p>
      <dl class="bb-pa-dl">
        <div>
          <dt>Terms acceptance</dt>
          <dd data-bb-pa-reg-consent="1"><%= app.consentTerms ? 'Accepted' : 'Not accepted' %></dd>
        </div>
        <div>
          <dt>Submission timestamp</dt>
          <dd><%= submittedLabel || 'Not provided' %></dd>
        </div>
        <% if (app.rejectionReason) { %>
        <div>
          <dt>Rejection reason</dt>
          <dd><span class="bb-pa-reg-origin" data-bb-pa-reg-origin="admin"><%= ORIGIN_ADMIN %></span> <%= app.rejectionReason %></dd>
        </div>
        <% } %>
