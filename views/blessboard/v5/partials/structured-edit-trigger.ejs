<%#
  Pencil / CTA trigger for structured editors (image, video, collections, leaders).
  Locals:
    editKind, editEntityKey, editSectionKey (optional), editLabel, editPayload (optional),
    editDialogTitle (optional), editButtonText (optional — when set, renders a visible text CTA)
%>
<%
  var _wa = typeof websiteAdmin !== 'undefined' && websiteAdmin ? websiteAdmin : null;
  var _kind = typeof editKind !== 'undefined' ? String(editKind) : '';
  var _entity = typeof editEntityKey !== 'undefined' ? String(editEntityKey) : 'default';
  var _section = typeof editSectionKey !== 'undefined' ? String(editSectionKey) : '';
  var _label = typeof editLabel !== 'undefined' ? String(editLabel) : 'Edit';
  var _dialogTitle = typeof editDialogTitle !== 'undefined' && editDialogTitle
    ? String(editDialogTitle)
    : '';
  var _buttonText = typeof editButtonText !== 'undefined' && editButtonText
    ? String(editButtonText)
    : '';
  var _payload = typeof editPayload !== 'undefined' && editPayload ? editPayload : {};
%>
<% if (_wa && _wa.editingMode && _kind) { %>
<button
  type="button"
  class="<%= _buttonText ? 'bb-tp-btn bb-tp-btn--ghost bb-tp-btn--sm bb-tp-structured-edit-cta' : 'bb-tp-structured-pencil' %>"
  data-bb-structured-open="1"
  data-bb-kind="<%= _kind %>"
  data-bb-entity="<%= _entity %>"
  <% if (_section) { %>data-bb-section="<%= _section %>"<% } %>
  <% if (_dialogTitle) { %>data-bb-dialog-title="<%= _dialogTitle %>"<% } %>
  <% if (_buttonText) { %>data-bb-edit-details="1"<% } %>
  data-bb-payload="<%= JSON.stringify(_payload).replace(/"/g, '&quot;') %>"
  aria-label="<%= _label %>"
>
  <span class="material-symbols-outlined" aria-hidden="true">edit</span>
  <% if (_buttonText) { %><span class="bb-tp-structured-edit-cta__label"><%= _buttonText %></span><% } %>
</button>
<% } %>
