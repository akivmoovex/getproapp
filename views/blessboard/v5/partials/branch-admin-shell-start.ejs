<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> · <%= churchDisplayName || 'BlessBoard' %></title>
  <meta name="robots" content="noindex, nofollow" />
  <%- include('./head-design-system') %>
  <link rel="stylesheet" href="/blessboard/v5/branch-admin.css?v=39" />
  <% if (typeof loadMediaPicker !== 'undefined' && loadMediaPicker) { %>
  <link rel="stylesheet" href="/blessboard/v5/media-picker.css?v=8" />
  <% } %>
</head>
<%
  var baNav = (typeof navItems !== 'undefined' && navItems && navItems.length)
    ? navItems
    : [
        { key: 'home', label: 'Dashboard', href: '/branch-admin', icon: 'dashboard' },
        { key: 'registrations', label: 'Registrations', href: '/branch-admin/registrations', icon: 'how_to_reg' },
        { key: 'members', label: 'Members', href: '/branch-admin/members', icon: 'group' },
        { key: 'announcements', label: 'Announcements', href: '/branch-admin/announcements', icon: 'campaign' },
        { key: 'participation', label: 'Participation', href: '/branch-admin/participation', icon: 'groups' },
        { key: 'attendance', label: 'Attendance', href: '/branch-admin/attendance', icon: 'fact_check' },
        { key: 'giving', label: 'Giving', href: '/branch-admin/giving', icon: 'payments' },
        { key: 'resources', label: 'Resources', href: '/branch-admin/resources', icon: 'menu_book' },
        { key: 'forms', label: 'Forms', href: '/branch-admin/forms', icon: 'description' },
        { key: 'requests', label: 'Requests', href: '/branch-admin/requests', icon: 'inbox' },
        { key: 'content', label: 'Website', href: '/branch-admin/content', icon: 'language' },
        { key: 'settings', label: 'Settings', href: '/branch-admin/settings', icon: 'settings' },
        { key: 'account', label: 'Account', href: '/branch-admin/account', icon: 'person' },
      ];
  var baRole = typeof roleLabel !== 'undefined' && roleLabel ? roleLabel : 'Branch admin';
  var baDisplay = typeof displayName !== 'undefined' && displayName ? displayName : '';
  var baChurch = typeof churchDisplayName !== 'undefined' && churchDisplayName ? churchDisplayName : '';
  var baBranch = typeof branchDisplayName !== 'undefined' && branchDisplayName ? branchDisplayName : '';
%>
<body
  class="bb-ba-body"
  data-bb-shell="branch-admin"
  data-bb-product="blessboard-v5"
  data-bb-viewport="responsive"
  data-bb-page="<%= activeNav || 'home' %>"
  data-bb-stitch-shell="25-branch-admin-dashboard"
>
  <a class="bb-ba-skip" href="#bb-ba-main">Skip to content</a>
  <div id="bb-shell-nav-live" class="bb-shell-sr-only" aria-live="polite" aria-atomic="true"></div>

  <div class="bb-ba-app">
    <aside class="bb-ba-sidebar" data-bb-nav="desktop-sidebar" aria-label="Branch admin navigation">
      <div class="bb-ba-sidebar__brand">
        <a class="bb-ba-wordmark" href="/branch-admin">
          <img
            class="bb-ba-wordmark__mark"
            src="/church/images/brand/blessboard-small-church-logo.png"
            alt=""
            width="28"
            height="28"
            decoding="async"
          />
          <span>BlessBoard</span>
        </a>
        <p class="bb-ba-context">
          <span class="bb-ba-context__church"><%= baChurch %></span>
          <% if (baBranch) { %>
          <span class="bb-ba-context__branch"><%= baBranch %></span>
          <% } %>
        </p>
        <span class="bb-ba-role" data-bb-branch-role="1">
          <span class="material-symbols-outlined" aria-hidden="true">admin_panel_settings</span>
          <%= baRole %>
        </span>
      </div>

      <nav class="bb-ba-sidebar__nav" aria-label="Branch admin" data-bb-nav="desktop">
        <% baNav.forEach(function (item) { %>
        <a
          href="<%= item.href %>"
          class="bb-ba-nav-link<%= activeNav === item.key ? ' is-active' : '' %>"
          <% if (activeNav === item.key) { %>aria-current="page"<% } %>
        >
          <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
          <span><%= item.label %></span>
        </a>
        <% }) %>
      </nav>

      <div class="bb-ba-sidebar__footer">
        <% if (baDisplay) { %>
        <p class="bb-ba-user" data-bb-admin-user="1">
          <span class="bb-ba-user__name"><%= baDisplay %></span>
          <span class="bb-ba-user__meta"><%= baChurch %><% if (baBranch) { %> · <%= baBranch %><% } %></span>
        </p>
        <% } %>
        <form class="bb-ba-logout" method="post" action="/branch-admin/logout" data-bb-branch-logout="1">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit">
            <span class="material-symbols-outlined" aria-hidden="true">logout</span>
            Sign out
          </button>
        </form>
        <%- include('./powered-by-getpro') %>
      </div>
    </aside>

    <div class="bb-ba-frame">
      <header class="bb-ba-top" data-bb-nav="mobile-header">
        <div class="bb-ba-top__brand">
          <a class="bb-ba-wordmark bb-ba-wordmark--compact" href="/branch-admin">
            <img
              class="bb-ba-wordmark__mark"
              src="/church/images/brand/blessboard-small-church-logo.png"
              alt=""
              width="24"
              height="24"
              decoding="async"
            />
            <span>BlessBoard</span>
          </a>
          <p class="bb-ba-context bb-ba-context--compact">
            <%= baChurch %><% if (baBranch) { %> · <%= baBranch %><% } %>
          </p>
        </div>
        <div class="bb-ba-top__actions">
          <button
            type="button"
            class="bb-ba-nav-toggle bb-shell-burger"
            id="bb-ba-menu-btn"
            data-bb-nav="mobile-toggle"
            aria-controls="bb-ba-drawer"
            aria-expanded="false"
            aria-label="Open navigation"
          >
            <span class="bb-shell-burger__icon" aria-hidden="true">
              <span class="bb-shell-burger__bar"></span>
              <span class="bb-shell-burger__bar"></span>
              <span class="bb-shell-burger__bar"></span>
            </span>
            <span class="bb-shell-burger__label">Menu</span>
          </button>
        </div>
      </header>

      <div
        id="bb-ba-drawer"
        class="bb-ba-drawer"
        data-bb-nav="mobile-drawer"
        role="dialog"
        aria-modal="true"
        aria-label="Branch admin navigation"
        inert
        hidden
      >
        <div class="bb-ba-drawer__scrim" data-bb-nav="drawer-close" tabindex="-1"></div>
        <nav class="bb-ba-drawer__panel" aria-label="Branch admin mobile">
          <div class="bb-ba-drawer__head">
            <p class="bb-ba-drawer__title">Branch Admin</p>
            <button
              type="button"
              class="bb-ba-drawer__close"
              data-bb-nav="drawer-close"
              aria-label="Close navigation"
            >
              <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
          </div>
          <% if (baDisplay) { %>
          <p class="bb-ba-user bb-ba-user--drawer" data-bb-admin-user="1">
            <span class="bb-ba-user__name"><%= baDisplay %></span>
            <span class="bb-ba-user__meta"><%= baRole %></span>
          </p>
          <% } %>
          <div class="bb-ba-drawer__links" data-bb-nav="mobile-links">
            <ul class="bb-ba-drawer__list">
              <% baNav.forEach(function (item) { %>
              <li class="bb-ba-drawer__item">
                <a
                  href="<%= item.href %>"
                  class="bb-ba-nav-link<%= activeNav === item.key ? ' is-active' : '' %>"
                  <% if (activeNav === item.key) { %>aria-current="page"<% } %>
                >
                  <span class="material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
                  <span><%= item.label %></span>
                </a>
              </li>
              <% }) %>
            </ul>
          </div>
          <div class="bb-ba-drawer__account">
            <form class="bb-ba-logout" method="post" action="/branch-admin/logout" data-bb-branch-logout="1">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit">
                <span class="material-symbols-outlined" aria-hidden="true">logout</span>
                Sign out
              </button>
            </form>
          </div>
          <div class="bb-ba-drawer__footer" data-bb-footer="drawer">
            <%- include('./powered-by-getpro') %>
          </div>
        </nav>
      </div>

      <main id="bb-ba-main" class="bb-ba-main" tabindex="-1">
        <div class="bb-ba-page" data-bb-page-area="1">
