<%#
  Accessible pagination. Locals:
    - page (1-based current)
    - totalPages
    - baseHref (path without query, e.g. /branch-admin/registrations)
    - query (optional object of extra query params; page key is "page")
    - label (optional aria-label)
%>
<%
  var _page = Math.max(1, parseInt(typeof page !== 'undefined' ? page : 1, 10) || 1);
  var _total = Math.max(1, parseInt(typeof totalPages !== 'undefined' ? totalPages : 1, 10) || 1);
  var _base = typeof baseHref !== 'undefined' && baseHref ? String(baseHref) : '#';
  var _label = typeof label !== 'undefined' && label ? label : 'Pagination';
  function buildHref(p) {
    var parts = [];
    if (typeof query === 'object' && query) {
      Object.keys(query).forEach(function (k) {
        if (k === 'page' || query[k] == null || query[k] === '') return;
        parts.push(encodeURIComponent(k) + '=' + encodeURIComponent(String(query[k])));
      });
    }
    parts.push('page=' + encodeURIComponent(String(p)));
    var q = parts.join('&');
    return _base.indexOf('?') >= 0 ? (_base + '&' + q) : (_base + '?' + q);
  }
%>
<% if (_total > 1) { %>
<nav class="bb-ds-pagination" aria-label="<%= _label %>" data-bb-ds="pagination">
  <p class="bb-ds-pagination__status">Page <%= _page %> of <%= _total %></p>
  <ul class="bb-ds-pagination__list">
    <li>
      <% if (_page > 1) { %>
      <a class="bb-ds-pagination__link" href="<%= buildHref(_page - 1) %>" rel="prev">Previous</a>
      <% } else { %>
      <span class="bb-ds-pagination__link is-disabled" aria-disabled="true">Previous</span>
      <% } %>
    </li>
    <%
      var start = Math.max(1, _page - 2);
      var end = Math.min(_total, _page + 2);
      for (var i = start; i <= end; i++) {
    %>
    <li>
      <% if (i === _page) { %>
      <span class="bb-ds-pagination__link is-current" aria-current="page"><%= i %></span>
      <% } else { %>
      <a class="bb-ds-pagination__link" href="<%= buildHref(i) %>"><%= i %></a>
      <% } %>
    </li>
    <% } %>
    <li>
      <% if (_page < _total) { %>
      <a class="bb-ds-pagination__link" href="<%= buildHref(_page + 1) %>" rel="next">Next</a>
      <% } else { %>
      <span class="bb-ds-pagination__link is-disabled" aria-disabled="true">Next</span>
      <% } %>
    </li>
  </ul>
</nav>
<% } %>
