<%
  var lock = lockModel || {};
  var benefits = lock.benefits || [];
%>
<section
  class="bb-hq-phase4-flock<%= lock.lockKind === 'network' ? ' bb-hq-phase4-flock--network' : ' bb-hq-phase4-flock--growth' %>"
  data-bb-phase4-feature-lock="1"
  data-bb-phase4-lock-kind="<%= lock.lockKind || 'growth' %>"
  aria-label="<%= lock.screenTitle || 'Feature locked' %>"
>
  <header class="bb-hq-page-head">
    <p class="bb-hq-breadcrumb">
      <a href="<%= lock.returnHref || '/hq/website' %>">Website</a>
      <span aria-hidden="true">›</span>
      <span>Plan access</span>
    </p>
    <p class="bb-hq-chip bb-hq-chip--warn">
      <span class="material-symbols-outlined" aria-hidden="true">lock</span>
      <span><%= lock.badgeLabel || 'Plan feature' %></span>
    </p>
    <h1 class="bb-hq-page-head__title"><%= lock.featureTitle || 'Feature locked' %></h1>
    <p class="bb-hq-lede"><%= lock.featureDescription || '' %></p>
    <p class="bb-hq-hint">
      Current plan: <strong><%= lock.currentPlanLabel || '—' %></strong>
      · Required: <strong><%= lock.requiredPlanLabel || '—' %></strong>
    </p>
  </header>

  <div class="bb-hq-panel bb-hq-phase4-flock__panel">
    <h2 class="bb-hq-panel__title">
      <span class="material-symbols-outlined" aria-hidden="true">verified_user</span>
      <%= lock.requiredPlanLabel %> includes
    </h2>
    <% if (benefits.length) { %>
    <ul class="bb-hq-phase4-flock__benefits">
      <% benefits.forEach(function (b) { %>
      <li>
        <span class="material-symbols-outlined" aria-hidden="true">done</span>
        <span><%= b %></span>
      </li>
      <% }) %>
    </ul>
    <% } %>
    <p class="bb-hq-hint" role="note">
      Access is not activated from this screen. Use package account options or talk to BlessBoard — there is no instant checkout here.
    </p>
    <p class="bb-hq-phase4-flock__actions">
      <a class="bb-hq-btn bb-hq-btn--primary" href="<%= lock.primaryCtaHref || '/hq/website/plan-features' %>"><%= lock.primaryCtaLabel || 'View plan features' %></a>
      <a class="bb-hq-btn bb-hq-btn--secondary" href="<%= lock.secondaryCtaHref || '/hq/account#package' %>"><%= lock.secondaryCtaLabel || 'View package &amp; account' %></a>
      <a class="bb-hq-btn bb-hq-btn--ghost" href="<%= lock.returnHref || '/hq/website' %>"><%= lock.returnLabel || 'Return to Website Overview' %></a>
    </p>
  </div>
</section>
