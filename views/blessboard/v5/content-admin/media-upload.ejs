<%# Inline upload control for an existing URL field. Expects: uploadUrl, targetInputId, csrfToken, visibility (optional) %>
<div class="bb-ca-upload" data-upload-url="<%= uploadUrl %>" data-target="<%= targetInputId %>" data-csrf="<%= csrfToken %>" data-visibility="<%= typeof visibility !== 'undefined' && visibility ? visibility : 'public' %>">
  <label for="<%= targetInputId %>_file">Upload file</label>
  <input id="<%= targetInputId %>_file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" />
  <button type="button" class="bb-ca-upload-btn">Upload</button>
  <p class="bb-ca-upload-status" hidden></p>
</div>
<script>
(function () {
  var roots = document.querySelectorAll(".bb-ca-upload");
  roots.forEach(function (root) {
    if (root.getAttribute("data-bound") === "1") return;
    root.setAttribute("data-bound", "1");
    var btn = root.querySelector(".bb-ca-upload-btn");
    var fileInput = root.querySelector('input[type="file"]');
    var status = root.querySelector(".bb-ca-upload-status");
    var target = document.getElementById(root.getAttribute("data-target"));
    if (!btn || !fileInput || !target) return;
    btn.addEventListener("click", function () {
      status.hidden = false;
      status.textContent = "";
      if (!fileInput.files || !fileInput.files[0]) {
        status.textContent = "Choose a file first.";
        return;
      }
      var fd = new FormData();
      fd.append("file", fileInput.files[0]);
      fd.append("_csrf", root.getAttribute("data-csrf") || "");
      fd.append("visibility", root.getAttribute("data-visibility") || "public");
      btn.disabled = true;
      status.textContent = "Uploading…";
      fetch(root.getAttribute("data-upload-url"), {
        method: "POST",
        body: fd,
        credentials: "same-origin",
        headers: { Accept: "application/json", "X-CSRF-Token": root.getAttribute("data-csrf") || "" },
      })
        .then(function (res) {
          return res.json().then(function (body) {
            return { res: res, body: body };
          });
        })
        .then(function (pack) {
          btn.disabled = false;
          if (!pack.res.ok || !pack.body || !pack.body.ok) {
            status.textContent = "Upload failed" + (pack.body && pack.body.reason ? ": " + pack.body.reason : ".");
            return;
          }
          target.value = pack.body.deliveryPath;
          status.textContent = pack.body.deduped ? "Reused existing file." : "Uploaded.";
        })
        .catch(function () {
          btn.disabled = false;
          status.textContent = "Upload failed.";
        });
    });
  });
})();
</script>
