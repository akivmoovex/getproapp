<%#
  Shared BlessBoard V5 media picker trigger.
  Expects: uploadUrl OR mediaBase, targetInputId, csrfToken
  Optional: visibility (public|private), fillField (deliveryPath|assetId), listUrl
  Batch 22 — Sacred Modernity chrome; upload security unchanged.
%>
<%
  var _mediaBase = '';
  if (typeof mediaBase !== 'undefined' && mediaBase) {
    _mediaBase = String(mediaBase).replace(/\/$/, '');
  } else if (typeof uploadUrl !== 'undefined' && uploadUrl) {
    _mediaBase = String(uploadUrl).replace(/\/media\/upload\/?$/, '');
  }
  var _uploadUrl = typeof uploadUrl !== 'undefined' && uploadUrl
    ? uploadUrl
    : (_mediaBase + '/media/upload');
  var _listUrl = typeof listUrl !== 'undefined' && listUrl
    ? listUrl
    : (_mediaBase + '/media');
  var _visibility = typeof visibility !== 'undefined' && visibility ? visibility : 'public';
  var _fill = typeof fillField !== 'undefined' && fillField ? fillField : 'deliveryPath';
%>
<div
  class="bb-media-picker"
  data-bb-media-picker="1"
  data-bb-stitch-media="shared-ui-states"
  data-media-base="<%= _mediaBase %>"
  data-upload-url="<%= _uploadUrl %>"
  data-list-url="<%= _listUrl %>"
  data-target="<%= targetInputId %>"
  data-csrf="<%= csrfToken %>"
  data-visibility="<%= _visibility %>"
  data-fill="<%= _fill %>"
>
  <button type="button" class="bb-media-picker__open" data-bb-media-open aria-haspopup="dialog">
    <span class="material-symbols-outlined" aria-hidden="true">photo_library</span>
    Choose or upload media
  </button>
  <span class="bb-media-picker__summary" data-bb-media-summary>No file selected</span>
</div>
