<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-start') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-start') %>
<% } %>
<%
  var pageRows = pages || [];
  var titles = typeof pageTitles !== 'undefined' && pageTitles ? pageTitles : {};
  var isBranchShell = shellKind === 'branch';
  var isHq = shellKind === 'hq';
  var isHqChurchWide = isHq && scope && !scope.branchId;
  var isHqBranchScoped = isHq && scope && scope.branchId;
  var activeStatus = typeof statusFilter !== 'undefined' && statusFilter ? String(statusFilter) : '';
  var searchQ = typeof q !== 'undefined' && q ? String(q).trim() : '';
  var hasFilter = Boolean(activeStatus || searchQ);
  var branchList = branches || [];
  var filterBase = (scope && scope.basePath) || (isHq ? '/hq/content' : '/branch-admin/content');
  var statusOptions = [
    { key: '', label: 'All' },
    { key: 'published', label: 'Published' },
    { key: 'draft', label: 'Draft' },
    { key: 'archived', label: 'Archived' }
  ];
  var entityModules = [
    { key: 'leadership', label: 'Leadership', href: scope.basePath + '/leadership', icon: 'groups', blurb: 'Leaders shown on the public Leadership page.' },
    { key: 'ministries', label: 'Ministries', href: scope.basePath + '/ministries', icon: 'volunteer_activism', blurb: 'Ministry cards for the public Ministries page.' },
    { key: 'events', label: 'Events', href: scope.basePath + '/events', icon: 'event', blurb: 'Upcoming and past events for the public Events page.' },
    { key: 'sermons', label: 'Sermons', href: scope.basePath + '/sermons', icon: 'record_voice_over', blurb: 'Sermon entries for the public Sermons page.' },
    { key: 'contact', label: 'Contact channels', href: scope.basePath + '/contact', icon: 'call', blurb: 'Public contact methods for the Contact page.' },
    { key: 'giving', label: 'Giving methods', href: scope.basePath + '/giving', icon: 'payments', blurb: 'Manual giving instructions for the Giving page.' }
  ];
  var unavailableModules = [
    { key: 'branding', label: 'Main site branding', reason: 'Church name and lockup are managed outside this overview.' },
    { key: 'theme', label: 'Theme & appearance', reason: 'Theme controls are not available in V5.' },
    { key: 'domain', label: 'Custom domain', reason: 'Hostname and DNS are platform-managed.' },
    { key: 'seo', label: 'SEO tools', reason: 'SEO analytics and SEO settings are not available in V5.' },
    { key: 'builder', label: 'Drag-and-drop website builder', reason: 'Use page and section editors instead.' },
    { key: 'templates', label: 'Organization templates', reason: 'Org-wide template libraries are not available in V5.' }
  ];
  if (isHqChurchWide) {
    entityModules = [
      {
        key: 'service-times-church',
        label: 'Church-wide service times',
        href: scope.basePath + '/pages/home',
        icon: 'schedule',
        blurb: 'Shared schedule on the church-wide home page.'
      }
    ].concat(entityModules);
  } else if (isHqBranchScoped && scope.branchKey) {
    entityModules = [
      {
        key: 'service-times-branch',
        label: 'Service times',
        href: '/hq/website/branches/' + scope.branchKey + '/service-times',
        icon: 'schedule',
        blurb: 'Structured times for this branch mini website.'
      }
    ].concat(entityModules);
  } else if (isBranchShell) {
    entityModules = [
      {
        key: 'service-times-branch',
        label: 'Service times',
        href: '/branch-admin/website/service-times',
        icon: 'schedule',
        blurb: 'Structured times for this branch mini website.'
      }
    ].concat(entityModules);
  }
  function statusLabel(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'draft') return 'Draft';
    if (key === 'published') return 'Published';
    if (key === 'archived') return 'Archived';
    return s || '—';
  }
  function statusChip(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'published') return 'bb-ba-chip--ok';
    if (key === 'draft') return 'bb-ba-chip--pending';
    return 'bb-ba-chip--muted';
  }
  function pageIcon(key) {
    var map = {
      home: 'home',
      about: 'info',
      leadership: 'groups',
      ministries: 'volunteer_activism',
      events: 'event',
      sermons: 'record_voice_over',
      contact: 'call',
      giving: 'payments'
    };
    return map[key] || 'article';
  }
  function pageBlurb(key) {
    var map = {
      home: 'Public home page sections and hero copy.',
      about: 'About page narrative sections.',
      leadership: 'Page chrome for the Leadership directory.',
      ministries: 'Page chrome for the Ministries directory.',
      events: 'Page chrome for the Events list.',
      sermons: 'Page chrome for the Sermons list.',
      contact: 'Page chrome for Contact channels.',
      giving: 'Page chrome for Giving methods.'
    };
    return map[key] || 'Public page content for this scope.';
  }
  function pageLabel(page) {
    return titles[page.pageKey] || page.title || page.pageKey;
  }
  function filterHref(statusKey) {
    var params = [];
    if (searchQ) params.push('q=' + encodeURIComponent(searchQ));
    if (statusKey) params.push('status=' + encodeURIComponent(statusKey));
    return filterBase + (params.length ? '?' + params.join('&') : '');
  }
  function clearHref() {
    return filterBase;
  }
  var publishedCount = 0;
  var draftCount = 0;
  var archivedCount = 0;
  pageRows.forEach(function (p) {
    var st = String(p.status || '').toLowerCase();
    if (st === 'published') publishedCount += 1;
    else if (st === 'draft') draftCount += 1;
    else if (st === 'archived') archivedCount += 1;
  });
  var filteredPages = pageRows.filter(function (page) {
    if (activeStatus && String(page.status || '').toLowerCase() !== activeStatus) return false;
    if (searchQ) {
      var hay = (pageLabel(page) + ' ' + (page.pageKey || '')).toLowerCase();
      if (hay.indexOf(searchQ.toLowerCase()) === -1) return false;
    }
    return true;
  });
%>

<section
  class="bb-ca-home bb-ba-content<%= isHq ? ' bb-hq-content' : '' %>"
  data-bb-content-admin="1"
  data-bb-stitch-content="34-branch-website-editor"
  data-bb-content-scope="<%= isHqChurchWide ? 'church-wide' : 'branch' %>"
  <% if (isHq) { %>data-bb-hq-content="1"<% } %>
>
  <header class="bb-ba-page-head bb-ba-page-head--split">
    <div>
      <p class="bb-ba-breadcrumb">
        <% if (isBranchShell) { %>
        <a href="/branch-admin">Dashboard</a>
        <% } else { %>
        <a href="/hq">HQ</a>
        <% } %>
        <span aria-hidden="true">›</span>
        <span>Website</span>
      </p>
      <div class="bb-ba-content__title-row">
        <h1 class="bb-ba-page-head__title"><%= isHq ? 'Public content' : 'Website content' %></h1>
        <% if (pageRows.length) { %>
        <span class="bb-ba-content__count" data-bb-content-page-total="<%= pageRows.length %>">
          <%= pageRows.length %> page<%= pageRows.length === 1 ? '' : 's' %>
        </span>
        <% } %>
      </div>
      <p class="bb-ba-lede">
        <% if (isHq) { %>
        Oversight of public pages and structured modules for
        <strong><%= scope.scopeLabel %></strong><% if (isHqChurchWide) { %> (church-wide)<% } %>.
        Central editing stays on this screen for the current scope. Theme, domain, SEO analytics, and live website-builder tools are not available.
        <% } else { %>
        Manage public pages and structured content for
        <strong><%= scope.scopeLabel %></strong>.
        Publish requires confirmation. Content is archived, never hard-deleted.
        <% } %>
      </p>
    </div>
    <% if (isHq) { %>
    <p class="bb-ba-page-head__actions">
      <a class="bb-ba-btn bb-ba-btn--ghost" href="/hq/announcements" data-bb-content-action="announcements">
        <span class="material-symbols-outlined" aria-hidden="true">campaign</span>
        Announcements
      </a>
    </p>
    <% } %>
  </header>

  <% if (saved) { %>
  <%- include('../partials/flash-message', { type: 'success', title: 'Saved', message: 'Changes saved.' }) %>
  <% } %>
  <% if (error) { %>
  <%- include('../partials/form-errors', { errors: [error], id: 'bb-ca-home-errors' }) %>
  <% } %>

  <% if (isHq) { %>
  <aside class="bb-hq-content-scope" data-bb-content-scope-panel="1" aria-labelledby="bb-hq-content-scope-heading">
    <h2 id="bb-hq-content-scope-heading" class="bb-hq-content-scope__title">Editing scope</h2>
    <p class="bb-hq-content-scope__body">
      <% if (isHqChurchWide) { %>
      You are editing <strong>church-wide</strong> public content for <strong><%= scope.scopeLabel %></strong>.
      Branch-scoped pages and modules open from the branch list below — existing central edit routes are unchanged.
      <% } else { %>
      You are editing <strong>branch</strong> public content for <strong><%= scope.scopeLabel %></strong>
      <% if (scope.branchKey) { %>(<code class="bb-hq-key"><%= scope.branchKey %></code>)<% } %>.
      Church-wide pages remain under <a href="/hq/content">church-wide content</a>.
      <% } %>
    </p>
  </aside>
  <% } %>

  <% if (typeof websiteModeNoticeMessage !== 'undefined' && websiteModeNoticeMessage) { %>
  <p
    class="bb-ba-ok"
    role="status"
    data-bb-website-mode-notice="<%= typeof websiteModeNoticeCode !== 'undefined' && websiteModeNoticeCode ? websiteModeNoticeCode : '' %>"
  ><%= websiteModeNoticeMessage %></p>
  <% } %>

  <% if (isHqChurchWide && websiteMode && websiteMode.websiteMode === 'multi_site' && branchList.length) { %>
  <section class="bb-ba-panel bb-ba-content-panel bb-hq-content-branches" data-bb-hq-content-branches="1" aria-labelledby="hq-content-branch-heading">
    <div class="bb-ba-content-panel__head">
      <h2 id="hq-content-branch-heading" class="bb-ba-section-title">Branch Websites</h2>
      <span class="bb-ba-content__count" data-bb-content-branch-total="<%= branchList.length %>"><%= branchList.length %></span>
    </div>
    <p class="bb-ba-hint">Open a branch to manage pages and modules scoped to that campus only. Church-wide editing stays on this page.</p>

    <div class="bb-hq-content-branch-table-wrap" data-bb-content-branch-table="1">
      <table class="bb-hq-content-branch-table">
        <thead>
          <tr>
            <th scope="col">Branch</th>
            <th scope="col">Key</th>
            <th scope="col">Role</th>
            <th scope="col"><span class="bb-hq-sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          <% branchList.forEach(function (branch) { %>
          <tr data-bb-content-branch="<%= branch.key %>">
            <td><%= branch.displayName %></td>
            <td><code class="bb-hq-key"><%= branch.key %></code></td>
            <td><% if (branch.isPrimary) { %><span class="bb-ca-pill">Primary</span><% } else { %>—<% } %></td>
            <td>
              <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="/hq/content/b/<%= branch.key %>" data-bb-content-action="open-branch">Open</a>
              <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="/hq/website/branches/<%= branch.key %>/service-times" data-bb-content-action="branch-service-times">Service times</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <ul class="bb-hq-content-branch-cards" data-bb-content-branch-cards="1">
      <% branchList.forEach(function (branch) { %>
      <li class="bb-hq-content-branch-card" data-bb-content-branch="<%= branch.key %>">
        <div class="bb-hq-content-branch-card__body">
          <h3 class="bb-hq-content-branch-card__title"><%= branch.displayName %></h3>
          <p class="bb-hq-content-branch-card__meta">
            <code class="bb-hq-key"><%= branch.key %></code>
            <% if (branch.isPrimary) { %><span class="bb-ca-pill">Primary</span><% } %>
          </p>
        </div>
        <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="/hq/content/b/<%= branch.key %>" data-bb-content-action="open-branch">Open</a>
        <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="/hq/website/branches/<%= branch.key %>/service-times" data-bb-content-action="branch-service-times">Service times</a>
      </li>
      <% }) %>
    </ul>
  </section>
  <% } else if (isHqChurchWide && websiteMode && websiteMode.websiteMode === 'multi_site') { %>
  <section class="bb-ba-panel bb-ba-content-panel" data-bb-hq-content-branches="1" data-bb-content-branch-empty="1" aria-labelledby="hq-content-branch-heading">
    <h2 id="hq-content-branch-heading" class="bb-ba-section-title">Branch Websites</h2>
    <p class="bb-ba-hint">No active branches are listed for this church yet. Church-wide pages below remain editable here.</p>
  </section>
  <% } %>

  <% if (isHqBranchScoped) { %>
  <p class="bb-ba-hint"><a href="/hq/content">← Church-wide content</a></p>
  <% } %>

  <% if (isBranchShell) { %>
  <section
    class="bb-ba-panel bb-ba-content-panel bb-ba-content-panel--hq"
    data-bb-content-hq-controlled="1"
    aria-labelledby="bb-content-hq-heading"
  >
    <div class="bb-ba-content-panel__head">
      <h2 id="bb-content-hq-heading" class="bb-ba-section-title">Church-controlled</h2>
      <span class="bb-ds-badge bb-ds-badge--neutral">HQ</span>
    </div>
    <p class="bb-ba-hint">
      Organization-level website content and HQ settings are managed outside this branch overview.
      This screen only shows pages and modules for
      <strong><%= scope.scopeLabel %></strong>.
    </p>
    <ul class="bb-ba-content-unavailable-list" data-bb-content-hq-items="1">
      <li class="bb-ba-content-unavailable" data-bb-content-unavailable="church-wide-pages">
        <span class="material-symbols-outlined" aria-hidden="true">lock</span>
        <span>
          <strong>HQ-managed pages</strong>
          <span class="bb-ba-muted"> — Organization pages are managed in HQ content, not editable here.</span>
        </span>
      </li>
      <li class="bb-ba-content-unavailable" data-bb-content-unavailable="org-branding">
        <span class="material-symbols-outlined" aria-hidden="true">lock</span>
        <span>
          <strong>Organization branding</strong>
          <span class="bb-ba-muted"> — Logo and org identity are HQ / platform controlled.</span>
        </span>
      </li>
    </ul>
  </section>
  <% } %>

  <section class="bb-ba-content-summary" data-bb-content-summary="1" aria-label="Publication summary">
    <div class="bb-ba-content-summary__card" data-bb-content-stat="pages">
      <p class="bb-ba-content-summary__label">Pages in this scope</p>
      <p class="bb-ba-content-summary__value"><%= pageRows.length %></p>
    </div>
    <div class="bb-ba-content-summary__card" data-bb-content-stat="published">
      <p class="bb-ba-content-summary__label">Published</p>
      <p class="bb-ba-content-summary__value"><%= publishedCount %></p>
    </div>
    <div class="bb-ba-content-summary__card" data-bb-content-stat="draft">
      <p class="bb-ba-content-summary__label">Draft</p>
      <p class="bb-ba-content-summary__value"><%= draftCount %></p>
    </div>
    <% if (archivedCount > 0 || isHq) { %>
    <div class="bb-ba-content-summary__card" data-bb-content-stat="archived">
      <p class="bb-ba-content-summary__label">Archived</p>
      <p class="bb-ba-content-summary__value"><%= archivedCount %></p>
    </div>
    <% } %>
  </section>

  <% if (isHq) { %>
  <form
    method="get"
    action="<%= filterBase %>"
    class="bb-hq-filter bb-hq-content-filter"
    data-bb-content-filter="1"
    role="search"
  >
    <div class="bb-hq-field">
      <label for="bb-content-q">Search pages</label>
      <input
        id="bb-content-q"
        name="q"
        type="search"
        maxlength="100"
        value="<%= searchQ %>"
        placeholder="Page title or key"
        autocomplete="off"
      />
    </div>
    <div class="bb-hq-field">
      <label for="bb-content-status">Status</label>
      <select id="bb-content-status" name="status">
        <option value="">All statuses</option>
        <% ['published','draft','archived'].forEach(function (st) { %>
        <option value="<%= st %>" <%= activeStatus === st ? 'selected' : '' %>><%= statusLabel(st) %></option>
        <% }) %>
      </select>
    </div>
    <div class="bb-hq-filter__actions">
      <button type="submit" class="bb-hq-btn bb-hq-btn--primary">
        <span class="material-symbols-outlined" aria-hidden="true">filter_list</span>
        Filter
      </button>
      <% if (hasFilter) { %>
      <a class="bb-hq-btn bb-hq-btn--ghost" href="<%= clearHref() %>">Clear</a>
      <% } %>
    </div>
  </form>

  <nav class="bb-hq-content-chips" aria-label="Publication status filters" data-bb-content-status-chips="1">
    <% statusOptions.forEach(function (opt) { %>
    <a
      class="bb-hq-content-chip<%= activeStatus === opt.key ? ' is-active' : '' %>"
      href="<%= filterHref(opt.key) %>"
      <%= activeStatus === opt.key ? 'aria-current="page"' : '' %>
      data-bb-content-status-filter="<%= opt.key || 'all' %>"
    ><%= opt.label %></a>
    <% }) %>
  </nav>
  <% } %>

  <section class="bb-ba-content-block" data-bb-content-pages="1" aria-labelledby="bb-content-pages-heading">
    <div class="bb-ba-content-block__head">
      <h2 id="bb-content-pages-heading" class="bb-ba-section-title">Public pages</h2>
      <p class="bb-ba-hint">
        <% if (isHq && hasFilter) { %>
        Showing <strong data-bb-content-match-total="<%= filteredPages.length %>"><%= filteredPages.length %></strong>
        of <%= pageRows.length %> pages. Status reflects the real page record for this scope.
        <% } else { %>
        Edit page title and sections. Status reflects the real page record for this scope.
        <% } %>
      </p>
    </div>

    <% if (!pageRows.length) { %>
    <div class="bb-ba-content-empty" data-bb-content-empty="pages" role="status">
      <%- include('../partials/empty-state', {
        title: 'No pages yet',
        body: 'Empty draft pages are provisioned for this scope when you open Website content. Refresh if they do not appear.',
        icon: 'web'
      }) %>
    </div>
    <% } else if (!filteredPages.length && hasFilter) { %>
    <div class="bb-ba-content-empty" data-bb-content-empty="no-results" role="status">
      <%- include('../partials/empty-state', {
        title: 'No matching pages',
        body: 'Try a different search or status filter, or clear filters to see every page in this scope.',
        icon: 'search_off',
        actionHref: clearHref(),
        actionLabel: 'Clear filters'
      }) %>
    </div>
    <% } else { %>
    <ul class="bb-ba-content-cards" data-bb-content-page-cards="1">
      <% filteredPages.forEach(function (page) {
        var label = pageLabel(page);
      %>
      <li class="bb-ba-content-card" data-bb-content-page="<%= page.pageKey %>" data-bb-content-page-status="<%= page.status %>">
        <div class="bb-ba-content-card__icon" aria-hidden="true">
          <span class="material-symbols-outlined"><%= pageIcon(page.pageKey) %></span>
        </div>
        <div class="bb-ba-content-card__body">
          <div class="bb-ba-content-card__title-row">
            <h3 class="bb-ba-content-card__title"><%= label %></h3>
            <span class="bb-ba-chip <%= statusChip(page.status) %>"><%= statusLabel(page.status) %></span>
          </div>
          <p class="bb-ba-content-card__blurb"><%= pageBlurb(page.pageKey) %></p>
          <p class="bb-ba-content-card__meta">
            Sections are edited on the page detail screen — no completion percentage is shown here.
          </p>
        </div>
        <div class="bb-ba-content-card__actions">
          <a
            class="bb-ba-btn bb-ba-btn--primary bb-ba-btn--sm"
            href="<%= scope.basePath %>/pages/<%= page.pageKey %>"
            data-bb-content-action="edit"
          >Edit</a>
          <a
            class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm"
            href="<%= scope.basePath %>/preview/<%= page.pageKey %>"
            data-bb-content-action="preview"
          >Preview</a>
        </div>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </section>

  <section class="bb-ba-content-block" data-bb-content-entities="1" aria-labelledby="bb-content-entities-heading">
    <div class="bb-ba-content-block__head">
      <h2 id="bb-content-entities-heading" class="bb-ba-section-title">Structured content</h2>
      <p class="bb-ba-hint">Directories and methods that feed public pages. Counts are not fabricated on this overview.</p>
    </div>
    <ul class="bb-ba-content-cards bb-ba-content-cards--modules" data-bb-content-entity-cards="1">
      <% entityModules.forEach(function (mod) { %>
      <li class="bb-ba-content-card" data-bb-content-entity="<%= mod.key %>">
        <div class="bb-ba-content-card__icon" aria-hidden="true">
          <span class="material-symbols-outlined"><%= mod.icon %></span>
        </div>
        <div class="bb-ba-content-card__body">
          <h3 class="bb-ba-content-card__title"><%= mod.label %></h3>
          <p class="bb-ba-content-card__blurb"><%= mod.blurb %></p>
        </div>
        <div class="bb-ba-content-card__actions">
          <a
            class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm"
            href="<%= mod.href %>"
            data-bb-content-action="manage"
          >Manage</a>
        </div>
      </li>
      <% }) %>
    </ul>
  </section>

  <section class="bb-ba-content-block" data-bb-content-media="1" aria-labelledby="bb-content-media-heading">
    <div class="bb-ba-content-block__head">
      <h2 id="bb-content-media-heading" class="bb-ba-section-title">Media</h2>
    </div>
    <div class="bb-ba-panel bb-ba-content-media">
      <p class="bb-ba-hint">
        Upload images from page and section editors (HTTPS public URLs or uploaded assets).
        Announcements may attach an asset id from this church’s media library.
      </p>
    </div>
  </section>

  <section
    class="bb-ba-content-block"
    data-bb-content-unavailable-modules="1"
    aria-labelledby="bb-content-unavailable-heading"
  >
    <div class="bb-ba-content-block__head">
      <h2 id="bb-content-unavailable-heading" class="bb-ba-section-title">Not available in V5</h2>
      <p class="bb-ba-hint">Stitch website-editor features without a V5 product route stay unavailable.</p>
    </div>
    <ul class="bb-ba-content-unavailable-list">
      <% unavailableModules.forEach(function (mod) { %>
      <li class="bb-ba-content-unavailable" data-bb-content-unavailable="<%= mod.key %>">
        <span class="material-symbols-outlined" aria-hidden="true">block</span>
        <span>
          <strong><%= mod.label %></strong>
          <span class="bb-ba-muted"> — <%= mod.reason %></span>
        </span>
      </li>
      <% }) %>
    </ul>
  </section>
</section>

<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-end') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-end') %>
<% } %>
