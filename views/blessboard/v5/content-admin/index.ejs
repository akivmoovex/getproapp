<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-start') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-start') %>
<% } %>

<section class="bb-ca-home" data-bb-content-admin="1">
  <header class="bb-hq-page-head bb-hq-page-head--split">
    <div>
      <h1 class="bb-hq-page-head__title">Website content</h1>
      <p class="bb-hq-lede">
        Edit public pages and structured content for
        <strong><%= scope.scopeLabel %></strong>.
        Publish requires confirmation. Content is archived, never hard-deleted.
      </p>
    </div>
  </header>

  <% if (saved) { %>
  <p class="bb-ca-ok" role="status">Changes saved.</p>
  <% } %>
  <% if (error) { %>
  <p class="bb-ca-error" role="alert"><%= error %></p>
  <% } %>

  <% if (shellKind === 'hq' && !scope.branchId && branches && branches.length) { %>
  <section class="bb-hq-panel" data-bb-hq-content-branches="1" aria-labelledby="hq-content-branch-heading">
    <h2 id="hq-content-branch-heading" class="bb-hq-section-title">Branch content</h2>
    <p class="bb-ca-hint">Manage website content scoped to a specific branch.</p>
    <ul class="bb-ca-branch-list">
      <% branches.forEach(function (branch) { %>
      <li>
        <a href="/hq/content/b/<%= branch.key %>"><%= branch.displayName %></a>
        <% if (branch.isPrimary) { %><span class="bb-ca-pill">Primary</span><% } %>
        <code class="bb-hq-key"><%= branch.key %></code>
      </li>
      <% }) %>
    </ul>
  </section>
  <% } %>

  <% if (shellKind === 'hq' && scope.branchId) { %>
  <p class="bb-ca-hint"><a href="/hq/content">← Church-wide content</a></p>
  <% } %>

  <section class="bb-ca-block" data-bb-content-pages="1">
    <h2 class="bb-hq-section-title">Pages</h2>
    <% if (!pages || !pages.length) { %>
      <p class="bb-ca-empty">No pages yet. Refresh to provision empty draft pages.</p>
    <% } else { %>
    <ul class="bb-ca-page-list">
      <% pages.forEach(function (page) { %>
      <li>
        <span class="bb-ca-page-title"><%= page.title %></span>
        <span class="bb-ca-pill bb-ca-pill--<%= page.status %>"><%= page.status %></span>
        <span class="bb-ca-links">
          <a href="<%= scope.basePath %>/pages/<%= page.pageKey %>">Edit</a>
          <a href="<%= scope.basePath %>/preview/<%= page.pageKey %>">Preview</a>
        </span>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </section>

  <section class="bb-ca-block" data-bb-content-entities="1">
    <h2 class="bb-hq-section-title">Structured content</h2>
    <ul class="bb-ca-entity-nav">
      <li><a href="<%= scope.basePath %>/leadership">Leadership</a></li>
      <li><a href="<%= scope.basePath %>/ministries">Ministries</a></li>
      <li><a href="<%= scope.basePath %>/events">Events</a></li>
      <li><a href="<%= scope.basePath %>/sermons">Sermons</a></li>
      <li><a href="<%= scope.basePath %>/contact">Contact channels</a></li>
      <li><a href="<%= scope.basePath %>/giving">Giving methods</a></li>
    </ul>
  </section>

  <section class="bb-ca-block" data-bb-content-media="1">
    <h2 class="bb-hq-section-title">Media</h2>
    <p class="bb-ca-hint">
      Upload images from page and section editors (HTTPS public URLs or uploaded assets).
      Announcements may attach an asset id from this church’s media library.
    </p>
  </section>
</section>

<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-end') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-end') %>
<% } %>
