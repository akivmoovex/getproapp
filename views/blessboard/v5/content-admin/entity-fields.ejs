<% var val = function (snake, camel, fallback) {
  if (item && item[snake] != null && item[snake] !== '') return item[snake];
  if (item && item[camel] != null && item[camel] !== '') return item[camel];
  return fallback != null ? fallback : '';
}; %>

<% if (entityKind === 'leadership') { %>
  <label for="<%= mode %>_display_name">Display name</label>
  <input id="<%= mode %>_display_name" name="display_name" type="text" required maxlength="200" value="<%= val('display_name', 'displayName', '') %>" />
  <label for="<%= mode %>_role_title">Role title</label>
  <input id="<%= mode %>_role_title" name="role_title" type="text" required maxlength="120" value="<%= val('role_title', 'roleTitle', '') %>" />
  <label for="<%= mode %>_biography">Biography</label>
  <textarea id="<%= mode %>_biography" name="biography" rows="3" maxlength="10000"><%= val('biography', 'biography', '') %></textarea>
  <label for="<%= mode %>_image_url">Image URL (HTTPS or uploaded)</label>
  <input id="<%= mode %>_image_url" name="image_url" type="text" maxlength="2000" value="<%= val('image_url', 'imageUrl', '') %>" />
  <%- include('media-upload', { uploadUrl: scope.basePath + '/media/upload', targetInputId: mode + '_image_url', csrfToken: csrfToken, visibility: 'public' }) %>
<% } %>

<% if (entityKind === 'ministries') { %>
  <label for="<%= mode %>_name">Name</label>
  <input id="<%= mode %>_name" name="name" type="text" required maxlength="200" value="<%= val('name', 'name', '') %>" />
  <label for="<%= mode %>_summary">Summary</label>
  <input id="<%= mode %>_summary" name="summary" type="text" maxlength="500" value="<%= val('summary', 'summary', '') %>" />
  <label for="<%= mode %>_description">Description</label>
  <textarea id="<%= mode %>_description" name="description" rows="4" maxlength="20000"><%= val('description', 'description', '') %></textarea>
  <label for="<%= mode %>_meeting_day">Meeting day</label>
  <input id="<%= mode %>_meeting_day" name="meeting_day" type="text" maxlength="64" value="<%= val('meeting_day', 'meetingDay', '') %>" />
  <label for="<%= mode %>_contact_email">Contact email</label>
  <input id="<%= mode %>_contact_email" name="contact_email" type="email" maxlength="254" value="<%= val('contact_email', 'contactEmail', '') %>" />
  <label for="<%= mode %>_image_url">Image URL (HTTPS or uploaded)</label>
  <input id="<%= mode %>_image_url" name="image_url" type="text" maxlength="2000" value="<%= val('image_url', 'imageUrl', '') %>" />
  <%- include('media-upload', { uploadUrl: scope.basePath + '/media/upload', targetInputId: mode + '_image_url', csrfToken: csrfToken, visibility: 'public' }) %>
<% } %>

<% if (entityKind === 'events') { %>
