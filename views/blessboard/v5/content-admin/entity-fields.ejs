  <label for="<%= mode %>_location">Location</label>
  <input id="<%= mode %>_location" name="location" type="text" maxlength="300" value="<%= val('location', 'location', '') %>" />
  <label for="<%= mode %>_registration_url">Registration URL (HTTPS)</label>
  <input id="<%= mode %>_registration_url" name="registration_url" type="url" maxlength="2000" value="<%= val('registration_url', 'registrationUrl', '') %>" />
  <label for="<%= mode %>_image_url">Image URL (HTTPS or uploaded)</label>
  <input id="<%= mode %>_image_url" name="image_url" type="text" maxlength="2000" value="<%= val('image_url', 'imageUrl', '') %>" />
  <%- include('media-upload', { uploadUrl: scope.basePath + '/media/upload', targetInputId: mode + '_image_url', csrfToken: csrfToken, visibility: 'public' }) %>
