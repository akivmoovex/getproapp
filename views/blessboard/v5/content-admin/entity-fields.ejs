<% if (entityKind === 'contact') { %>
  <label for="<%= mode %>_channel_type">Channel type</label>
  <input id="<%= mode %>_channel_type" name="channel_type" type="text" required maxlength="32" pattern="[a-z][a-z0-9_-]*" value="<%= val('channel_type', 'channelType', 'email') %>" />
  <label for="<%= mode %>_label">Label</label>
  <input id="<%= mode %>_label" name="label" type="text" required maxlength="120" value="<%= val('label', 'label', '') %>" />
  <label for="<%= mode %>_value">Value</label>
  <input id="<%= mode %>_value" name="value" type="text" required maxlength="500" value="<%= val('value', 'value', '') %>" />
<% } %>

<% if (entityKind === 'giving') { %>
  <label for="<%= mode %>_method_type">Method type</label>
  <input id="<%= mode %>_method_type" name="method_type" type="text" required maxlength="32" pattern="[a-z][a-z0-9_-]*" value="<%= val('method_type', 'methodType', 'online') %>" />
  <label for="<%= mode %>_label">Label</label>
  <input id="<%= mode %>_label" name="label" type="text" required maxlength="120" value="<%= val('label', 'label', '') %>" />
  <label for="<%= mode %>_instructions">Instructions</label>
  <textarea id="<%= mode %>_instructions" name="instructions" rows="3" maxlength="5000"><%= val('instructions', 'instructions', '') %></textarea>
  <label for="<%= mode %>_external_url">External URL (HTTPS)</label>
  <input id="<%= mode %>_external_url" name="external_url" type="url" maxlength="2000" value="<%= val('external_url', 'externalUrl', '') %>" />
<% } %>

<label for="<%= mode %>_sort_order">Sort order</label>
<input id="<%= mode %>_sort_order" name="sort_order" type="number" value="<%= val('sort_order', 'sortOrder', '0') %>" />

<label for="<%= mode %>_status">Status</label>
<select id="<%= mode %>_status" name="status">
  <% var statusOpts = entityKind === 'events' ? ['draft','published','cancelled','archived'] : ['draft','published','archived']; %>
  <% statusOpts.forEach(function (st) { %>
  <option value="<%= st %>" <%= val('status', 'status', 'draft') === st ? 'selected' : '' %>><%= st %></option>
  <% }) %>
</select>

<label class="bb-ca-confirm">
  <input type="checkbox" name="confirm_publish" value="1" />
  I confirm this item should be published on the public website.
</label>
