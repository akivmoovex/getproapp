  <input id="<%= mode %>_starts_at" name="starts_at" type="text" required value="<%= val('starts_at', 'startsAt', '') %>" placeholder="2026-07-18T10:00:00Z" />
  <label for="<%= mode %>_ends_at">Ends at</label>
  <input id="<%= mode %>_ends_at" name="ends_at" type="text" value="<%= val('ends_at', 'endsAt', '') %>" />
