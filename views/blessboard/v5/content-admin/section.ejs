<!DOCTYPE html>
<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-start') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-start') %>
<% } %>
  <p class="bb-ca-hint"><a href="<%= scope.basePath %>/pages/<%= page.pageKey %>">← Back to page</a></p>
  <h1>Edit section: <%= section.sectionKey %></h1>
  <% if (typeof error !== 'undefined' && error) { %>
    <p class="bb-ca-error" role="alert"><%= error %></p>
  <% } %>
  <% if (typeof saved !== 'undefined' && saved) { %>
    <p class="bb-ca-ok" role="status">Section saved.</p>
  <% } %>

  <form method="post" action="<%= scope.basePath %>/pages/<%= page.pageKey %>/sections/<%= section.sectionKey %>" class="<%= formClass %> bb-ca-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="expected_updated_at" value="<%= section.updatedAt instanceof Date ? section.updatedAt.toISOString() : section.updatedAt %>" />

    <label for="section_type">Section type</label>
    <input id="section_type" name="section_type" type="text" required maxlength="64" pattern="[a-z][a-z0-9_-]*" value="<%= submitted && submitted.section_type != null ? submitted.section_type : section.sectionType %>" />

    <label for="heading">Heading</label>
    <input id="heading" name="heading" type="text" maxlength="200" value="<%= submitted && submitted.heading != null ? submitted.heading : (section.heading || '') %>" />

    <label for="body_text">Body text</label>
    <textarea id="body_text" name="body_text" rows="6" maxlength="20000"><%= submitted && submitted.body_text != null ? submitted.body_text : (section.bodyText || '') %></textarea>

    <label for="media_url">Media URL (HTTPS or uploaded)</label>
    <input id="media_url" name="media_url" type="text" maxlength="2000" value="<%= submitted && submitted.media_url != null ? submitted.media_url : (section.mediaUrl || '') %>" />
    <%- include('media-upload', { uploadUrl: scope.basePath + '/media/upload', targetInputId: 'media_url', csrfToken: csrfToken, visibility: 'public' }) %>

    <label for="sort_order">Sort order</label>
    <input id="sort_order" name="sort_order" type="number" value="<%= submitted && submitted.sort_order != null ? submitted.sort_order : section.sortOrder %>" />

    <label for="status">Status</label>
    <select id="status" name="status">
      <% ['draft','published','archived'].forEach(function (st) { %>
      <option value="<%= st %>" <%= (submitted && submitted.status != null ? submitted.status : section.status) === st ? 'selected' : '' %>><%= st %></option>
      <% }) %>
    </select>

    <label class="bb-ca-confirm">
      <input type="checkbox" name="confirm_publish" value="1" />
      I confirm this section should be published on the public website.
    </label>

    <button type="submit">Save section</button>
  </form>
<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-end') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-end') %>
<% } %>
