<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-start') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-start') %>
<% } %>
  <h1>Forms</h1>
  <% if (saved) { %><p class="bb-ann-saved" role="status">Saved.</p><% } %>
  <% if (canCreate) { %>
    <form method="post" action="<%= basePath %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>Title <input type="text" name="title" maxlength="200" required /></label>
      <label>Description <input type="text" name="description" maxlength="5000" /></label>
      <label>Schema JSON
        <textarea name="schema_json" rows="8" required>{"version":1,"fields":[{"key":"full_name","type":"text","label":"Full name","required":true,"maxLength":100}]}</textarea>
      </label>
      <button type="submit">Create draft</button>
    </form>
  <% } %>
  <ul>
    <% forms.forEach(function (f) { %>
      <li data-bb-status="<%= f.status %>">
        <a href="<%= basePath %>/<%= f.id %>"><%= f.title %></a> · <%= f.status %>
      </li>
    <% }) %>
  </ul>
<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-end') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-end') %>
<% } %>
