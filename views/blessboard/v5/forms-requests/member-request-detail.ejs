<%- include('../partials/member-shell-start') %>
<%
  var reqItem = request || {};
  var history = Array.isArray(reqItem.history) ? reqItem.history : [];
  var isSaved = saved === '1';
%>

<section
  class="bb-mp-req-detail"
  data-bb-member-request-detail="1"
  data-bb-stitch-request-detail="22-member-request-status"
>
  <p class="bb-mp-back">
    <a href="/member/requests">
      <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
      Back to requests
    </a>
  </p>

  <% if (isSaved) { %>
  <div class="bb-mp-ok bb-mp-req-success" role="status" data-bb-request-success="1">
    <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
    <div>
      <p class="bb-mp-req-success__title">Request submitted</p>
      <p>Your request was sent to church leadership. You can track status updates below.</p>
    </div>
  </div>
  <% } %>

  <article class="bb-mp-part-detail bb-mp-req-detail__card" data-bb-status="<%= reqItem.status %>">
    <div class="bb-mp-ann-chips" aria-label="Request status">
      <span class="bb-mp-chip <%= reqItem.statusChipClass || 'bb-mp-chip--request' %>"><%= reqItem.statusLabel || reqItem.status %></span>
      <span class="bb-mp-chip bb-mp-chip--request"><%= reqItem.categoryLabel || reqItem.category %></span>
    </div>

    <h1 class="bb-mp-part-detail__title"><%= reqItem.subject %></h1>

    <% if (reqItem.createdAtLabel || reqItem.updatedAtLabel) { %>
    <p class="bb-mp-req-detail__when">
      <% if (reqItem.createdAtLabel) { %>
      <span>Submitted <%= reqItem.createdAtLabel %></span>
      <% } %>
      <% if (reqItem.updatedAtLabel && reqItem.updatedAtLabel !== reqItem.createdAtLabel) { %>
      <span aria-hidden="true">·</span>
      <span>Updated <%= reqItem.updatedAtLabel %></span>
      <% } %>
    </p>
    <% } %>

    <% if (reqItem.message) { %>
    <p class="bb-mp-part-detail__summary"><%= reqItem.message %></p>
    <% } %>

    <% if (reqItem.mediaAssetId) { %>
    <p class="bb-mp-part-detail__actions">
      <a
        class="bb-mp-btn bb-mp-btn--ghost"
        href="/member/requests/<%= reqItem.id %>/file"
        data-bb-request-download="1"
      >
        <span class="material-symbols-outlined" aria-hidden="true">attach_file</span>
        Download attachment
      </a>
    </p>
    <% } %>
  </article>

  <section class="bb-mp-req-history" aria-labelledby="status-history-heading" data-bb-request-history="1">
    <h2 id="status-history-heading" class="bb-mp-section-title">Status history</h2>
    <% if (!history.length) { %>
    <div class="bb-mp-empty bb-mp-empty--compact" role="status" data-bb-request-history-empty="1">
      <span class="material-symbols-outlined" aria-hidden="true">timeline</span>
      <p>No status updates yet.</p>
    </div>
    <% } else { %>
    <ol class="bb-mp-timeline">
      <% history.forEach(function (h) { %>
      <li class="bb-mp-timeline__item" data-bb-history-to="<%= h.toStatus %>">
        <span class="bb-mp-timeline__dot" aria-hidden="true"></span>
        <div class="bb-mp-timeline__body">
          <p class="bb-mp-timeline__status">
            <% if (h.fromStatus) { %>
            <span class="bb-mp-timeline__from"><%= h.fromStatusLabel || h.fromStatus %></span>
            <span aria-hidden="true"> → </span>
            <% } %>
            <span class="bb-mp-timeline__to"><%= h.toStatusLabel || h.toStatus %></span>
          </p>
          <% if (h.note) { %>
          <p class="bb-mp-timeline__note"><%= h.note %></p>
          <% } %>
          <% if (h.createdAtLabel || h.createdAt) { %>
          <p class="bb-mp-timeline__when"><%= h.createdAtLabel || h.createdAt %></p>
          <% } %>
        </div>
      </li>
      <% }) %>
    </ol>
    <% } %>
    <p class="bb-mp-hint">Only member-visible updates appear here. Internal staff review notes are not shown.</p>
  </section>
</section>

<%- include('../partials/member-shell-end') %>
