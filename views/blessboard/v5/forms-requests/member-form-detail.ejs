<%- include('../partials/member-shell-start') %>
  <p><a href="/member/forms">Back</a></p>
  <h1><%= form.title %></h1>
  <% if (error) { %><p class="bb-ann-error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/member/forms/<%= form.id %>/submit">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <% (form.schema && form.schema.fields ? form.schema.fields : []).forEach(function (field) { %>
      <label><%= field.label %>
        <% if (field.type === 'textarea') { %>
          <textarea name="<%= field.key %>" <%= field.required ? 'required' : '' %>></textarea>
        <% } else if (field.type === 'select') { %>
          <select name="<%= field.key %>" <%= field.required ? 'required' : '' %>>
            <option value="">Choose…</option>
            <% (field.options || []).forEach(function (o) { %>
              <option value="<%= o %>"><%= o %></option>
            <% }) %>
          </select>
        <% } else if (field.type === 'checkbox') { %>
          <input type="checkbox" name="<%= field.key %>" value="true" />
        <% } else { %>
          <input type="<%= field.type === 'email' ? 'email' : field.type === 'number' ? 'number' : field.type === 'date' ? 'date' : 'text' %>"
                 name="<%= field.key %>" <%= field.required ? 'required' : '' %> />
        <% } %>
      </label>
    <% }) %>
    <button type="submit">Submit</button>
  </form>
<%- include('../partials/member-shell-end') %>
