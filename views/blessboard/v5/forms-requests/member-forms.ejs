<%- include('../partials/member-shell-start') %>
<%
  var allFormList = typeof allForms !== 'undefined' && allForms ? allForms : (forms || []);
  var allSubmissionList = typeof allSubmissions !== 'undefined' && allSubmissions ? allSubmissions : (submissions || []);
  var formList = forms || [];
  var submissionList = submissions || [];
  var activeFilter = typeof filter !== 'undefined' && filter ? String(filter) : 'all';
  var searchQ = typeof q !== 'undefined' && q ? String(q) : '';
  var flash = saved === '1' ? 'Your form was submitted.' : '';
  var showAvailable = activeFilter !== 'history';
  var showHistory = activeFilter !== 'available';
  var isEmptyCatalog = !allFormList.length && !allSubmissionList.length;
  var isEmptyFormsCatalog = !allFormList.length;
  var isEmptyHistoryCatalog = !allSubmissionList.length;
  var isNoFormResults = showAvailable && !isEmptyFormsCatalog && !formList.length;
  var isNoHistoryResults = showHistory && !isEmptyHistoryCatalog && !submissionList.length && (searchQ || activeFilter === 'history');

  function filterHref(nextFilter, nextQ) {
    var parts = [];
    if (nextFilter && nextFilter !== 'all') parts.push('filter=' + encodeURIComponent(nextFilter));
    if (nextQ) parts.push('q=' + encodeURIComponent(nextQ));
    return parts.length ? ('/member/forms?' + parts.join('&')) : '/member/forms';
  }

  var filters = [
    { key: 'all', label: 'All' },
    { key: 'available', label: 'Available' },
    { key: 'history', label: 'History' },
  ];
%>

<section
  class="bb-mp-fr bb-mp-forms"
  data-bb-member-forms="1"
  data-bb-stitch-forms="20-member-forms-documents"
  data-bb-forms-filter="<%= activeFilter %>"
>
  <header class="bb-mp-page-head bb-mp-page-head--split">
    <div>
      <h1 class="bb-mp-page-head__title">Forms &amp; Documents</h1>
      <p class="bb-mp-lede">Fill out church forms online. Your submissions stay private to you and church leadership.</p>
    </div>
  </header>

  <% if (flash) { %>
  <p class="bb-mp-ok" role="status"><%= flash %></p>
  <% } %>

  <% if (!isEmptyCatalog) { %>
  <div class="bb-mp-ann-toolbar bb-mp-forms-toolbar" data-bb-forms-toolbar="1">
    <nav class="bb-mp-ann-filters" aria-label="Filter forms">
      <% filters.forEach(function (f) { %>
      <a
        class="bb-mp-ann-filter<%= activeFilter === f.key ? ' is-active' : '' %>"
        href="<%= filterHref(f.key, searchQ) %>"
        data-bb-forms-filter-link="<%= f.key %>"
        <%= activeFilter === f.key ? 'aria-current="page"' : '' %>
      ><%= f.label %></a>
      <% }) %>
    </nav>
    <form method="get" action="/member/forms" class="bb-mp-ann-search" role="search" data-bb-forms-search="1">
      <% if (activeFilter !== 'all') { %>
      <input type="hidden" name="filter" value="<%= activeFilter %>" />
      <% } %>
      <label class="bb-ds-sr-only" for="bb-mp-forms-q">Search forms</label>
      <span class="material-symbols-outlined bb-mp-ann-search__icon" aria-hidden="true">search</span>
      <input
        id="bb-mp-forms-q"
        type="search"
        name="q"
        value="<%= searchQ %>"
        maxlength="100"
        placeholder="Search forms or history"
        autocomplete="off"
      />
      <button type="submit" class="bb-mp-btn bb-mp-btn--ghost bb-mp-ann-search__submit">Search</button>
    </form>
  </div>
  <% } %>

  <% if (isEmptyCatalog) { %>
  <div class="bb-mp-empty" role="status" data-bb-forms-empty="catalog">
    <span class="material-symbols-outlined" aria-hidden="true">description</span>
    <p>No forms are available right now. When your church publishes a form, it will appear here.</p>
  </div>
  <% } else { %>

  <% if (showAvailable) { %>
  <section class="bb-mp-part-section" aria-label="Available forms" data-bb-forms-available="1">
    <h2 class="bb-mp-section-title">Available forms</h2>
    <% if (isEmptyFormsCatalog) { %>
    <div class="bb-mp-empty" role="status" data-bb-forms-empty="available">
      <span class="material-symbols-outlined" aria-hidden="true">edit_document</span>
      <p>No online forms are published for members yet.</p>
    </div>
    <% } else if (isNoFormResults) { %>
    <div class="bb-mp-empty" role="status" data-bb-forms-empty="no-results">
      <span class="material-symbols-outlined" aria-hidden="true">search_off</span>
      <p>No forms match this filter<%= searchQ ? ' or search' : '' %>.</p>
      <a class="bb-mp-btn bb-mp-btn--ghost" href="/member/forms">Clear filters</a>
    </div>
    <% } else { %>
    <ul class="bb-mp-part-list bb-mp-forms-grid" aria-label="Form library">
      <% formList.forEach(function (f) { %>
      <li>
        <a
          class="bb-mp-part-card bb-mp-form-card"
          href="/member/forms/<%= f.id %>"
          data-bb-form="<%= f.id %>"
          data-bb-form-fields="<%= typeof f.fieldCount === 'number' ? f.fieldCount : 0 %>"
        >
          <div class="bb-mp-fr-icon" aria-hidden="true">
            <span class="material-symbols-outlined">edit_document</span>
          </div>
          <div class="bb-mp-part-card__body">
            <div class="bb-mp-part-card__top">
              <h3 class="bb-mp-part-card__title"><%= f.title %></h3>
              <span class="bb-mp-chip bb-mp-chip--open" aria-label="Online form">Online form</span>
            </div>
            <% if (f.description) { %>
            <p class="bb-mp-part-card__excerpt"><%= f.description.length > 120 ? f.description.slice(0, 119) + '…' : f.description %></p>
            <% } %>
            <% if (typeof f.fieldCount === 'number' && f.fieldCount > 0) { %>
            <p class="bb-mp-part-card__meta">
              <span class="material-symbols-outlined" aria-hidden="true">list_alt</span>
              <span><%= f.fieldCountLabel || (f.fieldCount + ' fields') %></span>
            </p>
            <% } %>
            <p class="bb-mp-part-card__cta">Fill online</p>
          </div>
          <span class="bb-mp-ann-card__chevron material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </a>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </section>
  <% } %>

  <% if (showHistory) { %>
  <section class="bb-mp-part-section" aria-label="Your submissions" data-bb-forms-history="1">
    <h2 class="bb-mp-section-title">Submission history</h2>
    <% if (isEmptyHistoryCatalog) { %>
    <div class="bb-mp-empty bb-mp-empty--compact" role="status" data-bb-forms-empty="history">
      <span class="material-symbols-outlined" aria-hidden="true">task_alt</span>
      <p>You have not submitted any forms yet.</p>
    </div>
    <% } else if (isNoHistoryResults) { %>
    <div class="bb-mp-empty bb-mp-empty--compact" role="status" data-bb-forms-empty="history-no-results">
      <span class="material-symbols-outlined" aria-hidden="true">search_off</span>
      <p>No submissions match this filter<%= searchQ ? ' or search' : '' %>.</p>
      <a class="bb-mp-btn bb-mp-btn--ghost" href="/member/forms?filter=history">Clear search</a>
    </div>
    <% } else { %>
    <ul class="bb-mp-part-list bb-mp-forms-history" aria-label="Submission history">
      <% submissionList.forEach(function (s) { %>
      <li>
        <a
          class="bb-mp-part-card is-registered bb-mp-form-history-card"
          href="/member/forms/submissions/<%= s.id %>"
          data-bb-submission="<%= s.id %>"
          data-bb-submission-status="<%= s.status %>"
        >
          <div class="bb-mp-fr-icon" aria-hidden="true">
            <span class="material-symbols-outlined"><%= s.status === 'archived' ? 'inventory_2' : 'check_circle' %></span>
          </div>
          <div class="bb-mp-part-card__body">
            <div class="bb-mp-part-card__top">
              <h3 class="bb-mp-part-card__title"><%= s.formTitle || 'Submission' %></h3>
              <% if (s.statusLabel) { %>
              <span
                class="bb-mp-chip <%= s.status === 'archived' ? 'bb-mp-chip--request' : 'bb-mp-chip--active' %>"
                aria-label="<%= s.statusLabel %>"
              ><%= s.statusLabel %></span>
              <% } %>
            </div>
            <% if (s.submittedAtLabel) { %>
            <p class="bb-mp-part-card__meta">
              <span class="material-symbols-outlined" aria-hidden="true">event</span>
              <span>Submitted <%= s.submittedAtLabel %></span>
            </p>
            <% } %>
            <p class="bb-mp-part-card__cta">View submission</p>
          </div>
          <span class="bb-mp-ann-card__chevron material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </a>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </section>
  <% } %>

  <% } %>
</section>

<%- include('../partials/member-shell-end') %>
