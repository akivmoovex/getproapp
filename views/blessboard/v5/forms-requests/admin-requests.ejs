<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-start') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-start') %>
<% } %>
<%
  var rows = requests || [];
  var isHq = shellKind === 'hq';
  var activeStatus = typeof statusFilter !== 'undefined' && statusFilter ? String(statusFilter) : '';
  var searchQ = typeof q !== 'undefined' && q ? String(q).trim() : '';
  var hasFilter = Boolean(activeStatus || searchQ);
  var statuses = typeof requestStatuses !== 'undefined' && requestStatuses && requestStatuses.length
    ? requestStatuses
    : ['submitted', 'in_review', 'resolved', 'closed'];
  var submittedCount = 0;
  var inReviewCount = 0;
  var resolvedCount = 0;
  var closedCount = 0;
  rows.forEach(function (r) {
    var st = String(r.status || '').toLowerCase();
    if (st === 'submitted') submittedCount += 1;
    else if (st === 'in_review') inReviewCount += 1;
    else if (st === 'resolved') resolvedCount += 1;
    else if (st === 'closed') closedCount += 1;
  });
  function categoryLabel(c) {
    var key = String(c || '').toLowerCase();
    if (key === 'prayer') return 'Prayer';
    if (key === 'pastoral') return 'Care';
    if (key === 'practical') return 'Support';
    if (key === 'other') return 'Other';
    return c || 'Request';
  }
  function statusLabel(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'submitted') return 'Submitted';
    if (key === 'in_review') return 'In review';
    if (key === 'resolved') return 'Resolved';
    if (key === 'closed') return 'Closed';
    return s || '—';
  }
  function statusChip(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'submitted') return 'bb-ba-chip--pending';
    if (key === 'in_review') return 'bb-ba-chip--pending';
    if (key === 'resolved') return 'bb-ba-chip--ok';
    if (key === 'closed') return 'bb-ba-chip--muted';
    return 'bb-ba-chip--muted';
  }
  function formatWhen(value) {
    if (!value) return '—';
    var d = value instanceof Date ? value : new Date(value);
    if (isNaN(d.getTime())) return String(value).slice(0, 10);
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
  }
  function filterHref(opts) {
    var params = [];
    var st = opts && Object.prototype.hasOwnProperty.call(opts, 'status') ? opts.status : activeStatus;
    var qq = opts && Object.prototype.hasOwnProperty.call(opts, 'q') ? opts.q : searchQ;
    if (qq) params.push('q=' + encodeURIComponent(qq));
    if (st) params.push('status=' + encodeURIComponent(st));
    return basePath + (params.length ? '?' + params.join('&') : '');
  }
%>

<section
  class="bb-fr-admin bb-fr-req-list<%= isHq ? ' bb-hq-requests' : '' %>"
  data-bb-request-admin-list="1"
  data-bb-stitch-requests="44-branch-request-workflow-queue"
  <% if (isHq) { %>data-bb-hq-requests="1"<% } %>
  data-bb-req-scope="<%= typeof isHqChurchWide !== 'undefined' && isHqChurchWide ? 'church-wide' : 'branch' %>"
  aria-label="<%= isHq ? 'Requests oversight' : 'Request workflow queue' %>"
>
  <header class="bb-ba-page-head bb-ba-page-head--split">
    <div>
      <p class="bb-ba-breadcrumb">
        <% if (isHq) { %>
        <a href="/hq">HQ</a>
        <% } else { %>
        <a href="/branch-admin">Dashboard</a>
        <% } %>
        <span aria-hidden="true">›</span>
        <span>Requests</span>
      </p>
      <div class="bb-fr-req-list__title-row">
        <h1 class="bb-ba-page-head__title"><%= isHq ? 'Requests oversight' : 'Request workflow queue' %></h1>
        <% if (rows.length || !hasFilter) { %>
        <span class="bb-fr-req-list__count" data-bb-req-total="<%= rows.length %>"><%= rows.length %></span>
        <% } %>
      </div>
      <p class="bb-ba-lede">
        <% if (typeof isHqChurchWide !== 'undefined' && isHqChurchWide) { %>
        Church-wide member-request oversight for
        <strong><%= churchDisplayName %></strong>.
        Open a branch queue for campus scope. Member refs are truncated; contact details are not listed here.
        <% } else if (isHq) { %>
        Branch request oversight for
        <strong><%= typeof branchDisplayName !== 'undefined' && branchDisplayName ? branchDisplayName : churchDisplayName %></strong>.
        Status updates stay on this campus. Contact details are not listed here — open a request to respond.
        <% } else { %>
        Review member requests for
        <strong><%= typeof branchDisplayName !== 'undefined' && branchDisplayName ? branchDisplayName : churchDisplayName %></strong>.
        Status updates stay on this branch. Contact details are not listed here — open a request to respond.
        <% } %>
      </p>
      <p class="bb-ba-hint bb-fr-req-privacy" data-bb-req-privacy="1" role="note">
        <%= isHq ? 'Church-scoped queue only.' : 'Branch-scoped queue only.' %>
        Full member profiles and contact directories are not shown.
      </p>
    </div>
  </header>

  <% if (typeof isHqBranchScoped !== 'undefined' && isHqBranchScoped) { %>
  <p class="bb-ba-hint">
    <a href="/hq/requests">← Church-wide requests</a>
  </p>
  <% } %>

  <% if (typeof isHqChurchWide !== 'undefined' && isHqChurchWide && branches && branches.length) { %>
  <section class="bb-hq-panel bb-hq-requests-branches" data-bb-hq-requests-branches="1" aria-labelledby="hq-requests-branch-heading">
    <div class="bb-hq-requests-branches__head">
      <h2 id="hq-requests-branch-heading" class="bb-hq-section-title">Branch request queues</h2>
      <span class="bb-fr-req-list__count" data-bb-req-branch-total="<%= branches.length %>"><%= branches.length %></span>
    </div>
    <p class="bb-ba-hint">Open a branch to review and update requests scoped to that campus only.</p>
    <div class="bb-hq-requests-branch-table-wrap" data-bb-req-branch-table="1">
      <table class="bb-hq-requests-branch-table">
        <thead>
          <tr>
            <th scope="col">Branch</th>
            <th scope="col">Key</th>
            <th scope="col">Role</th>
            <th scope="col"><span class="bb-hq-sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          <% branches.forEach(function (branch) { %>
          <tr data-bb-req-branch="<%= branch.key %>">
            <td><%= branch.displayName %></td>
            <td><code class="bb-hq-key"><%= branch.key %></code></td>
            <td><% if (branch.isPrimary) { %><span class="bb-ca-pill">Primary</span><% } else { %>—<% } %></td>
            <td>
              <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="/hq/requests/b/<%= branch.key %>" data-bb-req-action="open-branch">Open</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <ul class="bb-hq-requests-branch-cards" data-bb-req-branch-cards="1">
      <% branches.forEach(function (branch) { %>
      <li class="bb-hq-requests-branch-card" data-bb-req-branch="<%= branch.key %>">
        <div>
          <h3 class="bb-hq-requests-branch-card__title"><%= branch.displayName %></h3>
          <p class="bb-hq-requests-branch-card__meta">
            <code class="bb-hq-key"><%= branch.key %></code>
            <% if (branch.isPrimary) { %><span class="bb-ca-pill">Primary</span><% } %>
          </p>
        </div>
        <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="/hq/requests/b/<%= branch.key %>" data-bb-req-action="open-branch">Open</a>
      </li>
      <% }) %>
    </ul>
  </section>
  <% } %>

  <% if (saved === 'status' || saved === '1') { %>
  <%- include('../partials/flash-message', {
    type: 'success',
    title: 'Updated',
    message: 'Request updated.'
  }) %>
  <% } %>

  <% if (isHq || rows.length || hasFilter) { %>
  <section class="bb-fr-req-summary" data-bb-req-summary="1" aria-label="Request status summary">
    <div class="bb-fr-req-summary__card" data-bb-req-stat="listed">
      <p class="bb-fr-req-summary__label">Listed</p>
      <p class="bb-fr-req-summary__value"><%= rows.length %></p>
    </div>
    <div class="bb-fr-req-summary__card" data-bb-req-stat="submitted">
      <p class="bb-fr-req-summary__label">Submitted</p>
      <p class="bb-fr-req-summary__value"><%= submittedCount %></p>
    </div>
    <div class="bb-fr-req-summary__card" data-bb-req-stat="in_review">
      <p class="bb-fr-req-summary__label">In review</p>
      <p class="bb-fr-req-summary__value"><%= inReviewCount %></p>
    </div>
    <div class="bb-fr-req-summary__card" data-bb-req-stat="resolved">
      <p class="bb-fr-req-summary__label">Resolved</p>
      <p class="bb-fr-req-summary__value"><%= resolvedCount %></p>
    </div>
    <div class="bb-fr-req-summary__card" data-bb-req-stat="closed">
      <p class="bb-fr-req-summary__label">Closed</p>
      <p class="bb-fr-req-summary__value"><%= closedCount %></p>
    </div>
  </section>
  <% } %>

  <% if (isHq) { %>
  <form
    method="get"
    action="<%= basePath %>"
    class="bb-hq-filter bb-fr-req-filter"
    data-bb-req-filter="1"
    role="search"
  >
    <div class="bb-hq-field">
      <label for="bb-req-q">Search</label>
      <input
        id="bb-req-q"
        name="q"
        type="search"
        maxlength="100"
        value="<%= searchQ %>"
        placeholder="Subject or category"
        autocomplete="off"
      />
    </div>
    <div class="bb-hq-field">
      <label for="bb-req-status">Status</label>
      <select id="bb-req-status" name="status">
        <option value="">All statuses</option>
        <% statuses.forEach(function (st) { %>
        <option value="<%= st %>" <%= activeStatus === st ? 'selected' : '' %>><%= statusLabel(st) %></option>
        <% }) %>
      </select>
    </div>
    <div class="bb-hq-filter__actions">
      <button type="submit" class="bb-hq-btn bb-hq-btn--primary">
        <span class="material-symbols-outlined" aria-hidden="true">filter_list</span>
        Filter
      </button>
      <% if (hasFilter) { %>
      <a class="bb-hq-btn bb-hq-btn--ghost" href="<%= basePath %>">Clear</a>
      <% } %>
    </div>
  </form>
  <% } %>

  <nav class="bb-fr-tabs" aria-label="Request status" data-bb-req-tabs="1">
    <a
      class="bb-fr-tabs__link<%= !activeStatus ? ' is-active' : '' %>"
      href="<%= filterHref({ status: '' }) %>"
      <%= !activeStatus ? 'aria-current="page"' : '' %>
      data-bb-req-tab="all"
    >All</a>
    <% statuses.forEach(function (st) { %>
    <a
      class="bb-fr-tabs__link<%= activeStatus === st ? ' is-active' : '' %>"
      href="<%= filterHref({ status: st }) %>"
      <%= activeStatus === st ? 'aria-current="page"' : '' %>
      data-bb-req-tab="<%= st %>"
    ><%= statusLabel(st) %></a>
    <% }) %>
  </nav>

  <% if (!rows.length && !hasFilter) { %>
  <div class="bb-fr-req-empty" data-bb-req-empty="catalog" role="status">
    <%- include('../partials/empty-state', {
      title: 'No requests yet',
      body: isHq
        ? 'When members submit prayer, care, or support requests in this church, they appear here for oversight.'
        : 'When members submit prayer, care, or support requests on this branch, they appear here for review.',
      icon: 'inbox'
    }) %>
  </div>
  <% } else if (!rows.length && hasFilter) { %>
  <div class="bb-fr-req-empty" data-bb-req-empty="no-results" role="status">
    <%- include('../partials/empty-state', {
      title: 'No matching requests',
      body: 'Try a different search or status filter, or clear filters to see the full queue in this scope.',
      icon: 'search_off',
      actionHref: basePath,
      actionLabel: 'Clear filters'
    }) %>
  </div>
  <% } else { %>

  <section class="bb-ba-panel bb-fr-req-panel" data-bb-req-catalog="1" aria-labelledby="bb-fr-req-heading">
    <div class="bb-fr-req-panel__head">
      <h2 id="bb-fr-req-heading" class="bb-ba-section-title">Requests</h2>
      <p class="bb-ba-hint" data-bb-req-count="<%= rows.length %>">
        <%= rows.length %> request<%= rows.length === 1 ? '' : 's' %>
        <% if (hasFilter) { %> · filtered<% } %>
      </p>
    </div>

    <div class="bb-ba-table-wrap bb-fr-req-table-wrap" role="region" aria-label="Requests table" tabindex="0" data-bb-req-table-desktop="1">
      <table class="bb-ba-table bb-fr-req-table" data-bb-req-table="1">
        <thead>
          <tr>
            <th scope="col">Category</th>
            <th scope="col">Subject</th>
            <th scope="col">Submitted</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="bb-ba-sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function (r) { %>
          <tr data-bb-req-status="<%= r.status %>" data-bb-req-category="<%= r.category %>" data-bb-req-row="<%= r.id %>">
            <td>
              <span class="bb-fr-cat"><%= categoryLabel(r.category) %></span>
              <% if (r.hasAttachment) { %>
              <span class="bb-fr-attach-flag" title="Has private attachment" aria-label="Has private attachment">
                <span class="material-symbols-outlined" aria-hidden="true">attach_file</span>
              </span>
              <% } %>
            </td>
            <td>
              <a href="<%= basePath %>/<%= r.id %>" class="bb-fr-title-link"><%= r.subject %></a>
              <% if (r.memberRef) { %>
              <span class="bb-ba-muted bb-fr-member-ref">Member · <%= r.memberRef %></span>
              <% } %>
            </td>
            <td><%= formatWhen(r.createdAt) %></td>
            <td><span class="bb-ba-chip <%= statusChip(r.status) %>"><%= statusLabel(r.status) %></span></td>
            <td class="bb-ba-table__actions">
              <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="<%= basePath %>/<%= r.id %>" data-bb-req-open="1">
                <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
                Review
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="bb-fr-req-cards" data-bb-req-cards="1">
      <% rows.forEach(function (r) { %>
      <article class="bb-fr-req-card bb-ba-panel" data-bb-req-card="<%= r.id %>" data-bb-req-status="<%= r.status %>" data-bb-req-category="<%= r.category %>">
        <div class="bb-fr-req-card__top">
          <span class="bb-fr-cat"><%= categoryLabel(r.category) %></span>
          <span class="bb-ba-chip <%= statusChip(r.status) %>"><%= statusLabel(r.status) %></span>
        </div>
        <h3 class="bb-fr-req-card__title">
          <a href="<%= basePath %>/<%= r.id %>"><%= r.subject %></a>
          <% if (r.hasAttachment) { %>
          <span class="bb-fr-attach-flag" title="Has private attachment" aria-label="Has private attachment">
            <span class="material-symbols-outlined" aria-hidden="true">attach_file</span>
          </span>
          <% } %>
        </h3>
        <p class="bb-fr-req-card__meta">
          <%= formatWhen(r.createdAt) %>
          <% if (r.memberRef) { %> · Member · <%= r.memberRef %><% } %>
        </p>
        <p class="bb-fr-req-card__actions">
          <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="<%= basePath %>/<%= r.id %>">Review</a>
        </p>
      </article>
      <% }) %>
    </div>
  </section>
  <% } %>

  <aside class="bb-ba-entities-unavailable" data-bb-req-unavailable="1" aria-label="Unavailable in V5">
    <p data-bb-req-unavailable-row="metrics">Queue KPI cards, processing-time averages, and trend comparisons are not shown.</p>
    <p data-bb-req-unavailable-row="assignment">Staff assignment queues, SLA timers, and chat threads are not available.</p>
    <p data-bb-req-unavailable-row="escalation">Escalation automation and unsupported assignment workflows are not available.</p>
    <p data-bb-req-unavailable-row="privacy">Donor badges and member contact directories are not loaded on this queue.</p>
  </aside>
</section>

<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-end') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-end') %>
<% } %>
