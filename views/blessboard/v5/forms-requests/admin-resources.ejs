<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-start') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-start') %>
<% } %>
<%
  var rows = resources || [];
  var isHq = shellKind === 'hq';
  var activeStatus = typeof statusFilter !== 'undefined' && statusFilter ? String(statusFilter) : '';
  var searchQ = typeof q !== 'undefined' && q ? String(q).trim() : '';
  var hasFilter = Boolean(activeStatus || searchQ);
  var statusOptions = [
    { key: '', label: 'All' },
    { key: 'draft', label: 'Draft' },
    { key: 'published', label: 'Published' },
    { key: 'archived', label: 'Archived' }
  ];
  var audienceOptions = typeof audiences !== 'undefined' && audiences && audiences.length
    ? audiences
    : ['public', 'members', 'leaders'];
  var draftCount = 0;
  var publishedCount = 0;
  var archivedCount = 0;
  rows.forEach(function (r) {
    var st = String(r.status || '').toLowerCase();
    if (st === 'draft') draftCount += 1;
    else if (st === 'published') publishedCount += 1;
    else if (st === 'archived') archivedCount += 1;
  });
  function statusLabel(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'draft') return 'Draft';
    if (key === 'published') return 'Published';
    if (key === 'archived') return 'Archived';
    return s || '—';
  }
  function statusChip(s) {
    var key = String(s || '').toLowerCase();
    if (key === 'published') return 'bb-ba-chip--ok';
    if (key === 'draft') return 'bb-ba-chip--pending';
    return 'bb-ba-chip--muted';
  }
  function audienceLabel(a) {
    var key = String(a || '').toLowerCase();
    if (key === 'public') return 'Public';
    if (key === 'members') return 'Members';
    if (key === 'leaders') return 'Leaders';
    return a || '—';
  }
  function snippet(text) {
    var t = String(text || '').replace(/\s+/g, ' ').trim();
    if (!t) return '';
    if (t.length <= 90) return t;
    return t.slice(0, 87) + '…';
  }
  function filterHref(opts) {
    var params = [];
    var st = opts && Object.prototype.hasOwnProperty.call(opts, 'status') ? opts.status : activeStatus;
    var qq = opts && Object.prototype.hasOwnProperty.call(opts, 'q') ? opts.q : searchQ;
    if (qq) params.push('q=' + encodeURIComponent(qq));
    if (st) params.push('status=' + encodeURIComponent(st));
    return basePath + (params.length ? '?' + params.join('&') : '');
  }
%>

<section
  class="bb-fr-admin bb-fr-resources-list<%= isHq ? ' bb-hq-resources' : '' %>"
  data-bb-resources-admin-list="1"
  data-bb-stitch-resources="19-member-resources-study"
  <% if (isHq) { %>data-bb-hq-resources="1"<% } %>
  data-bb-resources-scope="<%= typeof isHqChurchWide !== 'undefined' && isHqChurchWide ? 'church-wide' : 'branch' %>"
  aria-label="<%= isHq ? 'Resources oversight' : 'Resources management' %>"
>
  <header class="bb-ba-page-head bb-ba-page-head--split">
    <div>
      <p class="bb-ba-breadcrumb">
        <% if (isHq) { %>
        <a href="/hq">HQ</a>
        <% } else { %>
        <a href="/branch-admin">Dashboard</a>
        <% } %>
        <span aria-hidden="true">›</span>
        <span>Resources</span>
      </p>
      <div class="bb-fr-resources-list__title-row">
        <h1 class="bb-ba-page-head__title"><%= isHq ? 'Resources oversight' : 'Resources' %></h1>
        <span class="bb-fr-resources-list__count" data-bb-resources-total="<%= rows.length %>"><%= rows.length %></span>
      </div>
      <p class="bb-ba-lede">
        <% if (typeof isHqChurchWide !== 'undefined' && isHqChurchWide) { %>
        Church-wide resource oversight for
        <strong><%= churchDisplayName %></strong>.
        Open a branch to manage campus-scoped drafts. Private attachments download only through authenticated routes — never public CDN paths.
        <% } else if (isHq) { %>
        Branch resource oversight for
        <strong><%= typeof branchDisplayName !== 'undefined' && branchDisplayName ? branchDisplayName : churchDisplayName %></strong>.
        Member downloads stay private when attachments are private.
        <% } else { %>
        Publish study and care resources for
        <strong><%= typeof branchDisplayName !== 'undefined' && branchDisplayName ? branchDisplayName : churchDisplayName %></strong>.
        Private media is never exposed on public CDN paths.
        <% } %>
      </p>
    </div>
    <p class="bb-ba-page-head__actions">
      <% if (canCreate) { %>
      <a class="bb-ba-btn bb-ba-btn--primary" href="#bb-fr-resource-create" data-bb-resources-create-jump="1">
        <span class="material-symbols-outlined" aria-hidden="true">add</span>
        Create draft
      </a>
      <% } %>
      <% if (isHq) { %>
      <a class="bb-ba-btn bb-ba-btn--ghost" href="/hq/forms" data-bb-resources-action="forms">Forms</a>
      <% } %>
    </p>
  </header>

  <% if (typeof isHqBranchScoped !== 'undefined' && isHqBranchScoped) { %>
  <p class="bb-ba-hint">
    <a href="/hq/resources">← Church-wide resources</a>
  </p>
  <% } %>

  <% if (typeof isHqChurchWide !== 'undefined' && isHqChurchWide && branches && branches.length) { %>
  <section class="bb-hq-panel bb-hq-resources-branches" data-bb-hq-resources-branches="1" aria-labelledby="hq-resources-branch-heading">
    <div class="bb-hq-resources-branches__head">
      <h2 id="hq-resources-branch-heading" class="bb-hq-section-title">Branch resources</h2>
      <span class="bb-fr-resources-list__count" data-bb-resources-branch-total="<%= branches.length %>"><%= branches.length %></span>
    </div>
    <p class="bb-ba-hint">Open a branch to manage resources scoped to that campus only.</p>
    <div class="bb-hq-resources-branch-table-wrap" data-bb-resources-branch-table="1">
      <table class="bb-hq-resources-branch-table">
        <thead>
          <tr>
            <th scope="col">Branch</th>
            <th scope="col">Key</th>
            <th scope="col">Role</th>
            <th scope="col"><span class="bb-hq-sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          <% branches.forEach(function (branch) { %>
          <tr data-bb-resources-branch="<%= branch.key %>">
            <td><%= branch.displayName %></td>
            <td><code class="bb-hq-key"><%= branch.key %></code></td>
            <td><% if (branch.isPrimary) { %><span class="bb-ca-pill">Primary</span><% } else { %>—<% } %></td>
            <td>
              <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="/hq/resources/b/<%= branch.key %>" data-bb-resources-action="open-branch">Open</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <ul class="bb-hq-resources-branch-cards" data-bb-resources-branch-cards="1">
      <% branches.forEach(function (branch) { %>
      <li class="bb-hq-resources-branch-card" data-bb-resources-branch="<%= branch.key %>">
        <div>
          <h3 class="bb-hq-resources-branch-card__title"><%= branch.displayName %></h3>
          <p class="bb-hq-resources-branch-card__meta">
            <code class="bb-hq-key"><%= branch.key %></code>
            <% if (branch.isPrimary) { %><span class="bb-ca-pill">Primary</span><% } %>
          </p>
        </div>
        <a class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm" href="/hq/resources/b/<%= branch.key %>" data-bb-resources-action="open-branch">Open</a>
      </li>
      <% }) %>
    </ul>
  </section>
  <% } %>

  <% if (saved === '1' || saved === 'published') { %>
  <%- include('../partials/flash-message', {
    type: 'success',
    title: 'Updated',
    message: saved === 'published' ? 'Resource published.' : 'Resource saved.'
  }) %>
  <% } %>

  <% if (canCreate) { %>
  <section class="bb-ba-panel bb-fr-create" id="bb-fr-resource-create" data-bb-resources-create="1" aria-labelledby="bb-fr-resource-create-heading">
    <h2 id="bb-fr-resource-create-heading" class="bb-ba-section-title">Create draft resource</h2>
    <form method="post" action="<%= basePath %>" class="bb-fr-form-create" data-bb-resources-editor="1">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="bb-fr-form-create__grid">
        <div class="bb-ba-field">
          <label for="title">Title</label>
          <input id="title" type="text" name="title" maxlength="200" required autocomplete="off" />
        </div>
        <div class="bb-ba-field">
          <label for="description">Description</label>
          <input id="description" type="text" name="description" maxlength="5000" autocomplete="off" />
        </div>
        <div class="bb-ba-field">
          <label for="audience">Audience</label>
          <select id="audience" name="audience">
            <% audienceOptions.forEach(function (a) { %>
            <option value="<%= a %>"><%= audienceLabel(a) %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="bb-ba-field">
        <label for="media_asset_id">Media attachment (optional)</label>
        <input id="media_asset_id" type="text" name="media_asset_id" maxlength="36" autocomplete="off" placeholder="Optional — use picker" />
        <% if (typeof mediaUploadUrl !== 'undefined' && mediaUploadUrl) { %>
        <%- include('../content-admin/media-upload', {
              uploadUrl: mediaUploadUrl,
              targetInputId: 'media_asset_id',
              csrfToken: csrfToken,
              visibility: 'private',
              fillField: 'assetId'
            }) %>
        <p class="bb-ba-hint">Private media only. Member downloads use the authenticated resource file route — never public CDN for private assets.</p>
        <% } else { %>
        <p class="bb-ba-hint">Use a private media asset id when the resource includes a downloadable file.</p>
        <% } %>
      </div>
      <div class="bb-fr-form-create__actions">
        <button type="submit" class="bb-ba-btn bb-ba-btn--primary">Create draft</button>
      </div>
    </form>
  </section>
  <% } %>

  <section class="bb-fr-resources-summary" data-bb-resources-summary="1" aria-label="Resource status summary">
    <div class="bb-fr-resources-summary__card" data-bb-resources-stat="listed">
      <p class="bb-fr-resources-summary__label">Listed</p>
      <p class="bb-fr-resources-summary__value"><%= rows.length %></p>
    </div>
    <div class="bb-fr-resources-summary__card" data-bb-resources-stat="published">
      <p class="bb-fr-resources-summary__label">Published</p>
      <p class="bb-fr-resources-summary__value"><%= publishedCount %></p>
    </div>
    <div class="bb-fr-resources-summary__card" data-bb-resources-stat="draft">
      <p class="bb-fr-resources-summary__label">Draft</p>
      <p class="bb-fr-resources-summary__value"><%= draftCount %></p>
    </div>
    <div class="bb-fr-resources-summary__card" data-bb-resources-stat="archived">
      <p class="bb-fr-resources-summary__label">Archived</p>
      <p class="bb-fr-resources-summary__value"><%= archivedCount %></p>
    </div>
  </section>

  <% if (isHq) { %>
  <form
    method="get"
    action="<%= basePath %>"
    class="bb-hq-filter bb-fr-resources-filter"
    data-bb-resources-filter="1"
    role="search"
  >
    <div class="bb-hq-field">
      <label for="bb-resources-q">Search</label>
      <input
        id="bb-resources-q"
        name="q"
        type="search"
        maxlength="100"
        value="<%= searchQ %>"
        placeholder="Title or description"
        autocomplete="off"
      />
    </div>
    <div class="bb-hq-field">
      <label for="bb-resources-status">Status</label>
      <select id="bb-resources-status" name="status">
        <option value="">All statuses</option>
        <% ['published','draft','archived'].forEach(function (st) { %>
        <option value="<%= st %>" <%= activeStatus === st ? 'selected' : '' %>><%= statusLabel(st) %></option>
        <% }) %>
      </select>
    </div>
    <div class="bb-hq-filter__actions">
      <button type="submit" class="bb-hq-btn bb-hq-btn--primary">
        <span class="material-symbols-outlined" aria-hidden="true">filter_list</span>
        Filter
      </button>
      <% if (hasFilter) { %>
      <a class="bb-hq-btn bb-hq-btn--ghost" href="<%= basePath %>">Clear</a>
      <% } %>
    </div>
  </form>
  <% } %>

  <nav class="bb-ba-entities-chips" aria-label="Resource status filters" data-bb-resources-status-chips="1">
    <% statusOptions.forEach(function (opt) { %>
    <a
      class="bb-ba-entities-chip<%= activeStatus === opt.key ? ' is-active' : '' %>"
      href="<%= filterHref({ status: opt.key }) %>"
      <%= activeStatus === opt.key ? 'aria-current="page"' : '' %>
      data-bb-resources-status-filter="<%= opt.key || 'all' %>"
    ><%= opt.label %></a>
    <% }) %>
  </nav>

  <% if (!rows.length && !hasFilter) { %>
  <div class="bb-fr-resources-empty" data-bb-resources-empty="catalog" role="status">
    <%- include('../partials/empty-state', {
      title: 'No resources yet',
      body: canCreate
        ? 'Create a draft resource, optionally attach private media, then publish for the selected audience.'
        : 'Open a branch to create campus-scoped resources.',
      icon: 'menu_book',
      actionHref: canCreate ? '#bb-fr-resource-create' : null,
      actionLabel: canCreate ? 'Create draft' : null
    }) %>
  </div>
  <% } else if (!rows.length && hasFilter) { %>
  <div class="bb-fr-resources-empty" data-bb-resources-empty="no-results" role="status">
    <%- include('../partials/empty-state', {
      title: 'No matching resources',
      body: 'Try a different search or status filter, or clear filters to see all resources in this scope.',
      icon: 'search_off',
      actionHref: basePath,
      actionLabel: 'Clear filters'
    }) %>
  </div>
  <% } else { %>

  <section class="bb-ba-panel bb-fr-resources-panel" data-bb-resources-catalog="1" aria-labelledby="bb-fr-resources-heading">
    <div class="bb-fr-resources-panel__head">
      <h2 id="bb-fr-resources-heading" class="bb-ba-section-title">Resources</h2>
      <p class="bb-ba-hint"><%= rows.length %> resource<%= rows.length === 1 ? '' : 's' %>. File downloads use authenticated routes when media is private.</p>
    </div>

    <div class="bb-ba-table-wrap bb-fr-resources-table-wrap" role="region" aria-label="Resources table" tabindex="0" data-bb-resources-table-desktop="1">
      <table class="bb-ba-table bb-fr-resources-table" data-bb-resources-table="1">
        <thead>
          <tr>
            <th scope="col">Title</th>
            <th scope="col">Audience</th>
            <th scope="col">Attachment</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="bb-ba-sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function (r) { %>
          <tr data-bb-status="<%= r.status %>" data-bb-resource-row="<%= r.id %>">
            <td>
              <strong><%= r.title %></strong>
              <% if (r.description) { %>
              <p class="bb-fr-snippet"><%= snippet(r.description) %></p>
              <% } %>
            </td>
            <td><%= audienceLabel(r.audience) %></td>
            <td data-bb-resource-attachment="<%= r.mediaAssetId ? '1' : '0' %>">
              <%= r.mediaAssetId ? 'Private file' : '—' %>
            </td>
            <td><span class="bb-ba-chip <%= statusChip(r.status) %>"><%= statusLabel(r.status) %></span></td>
            <td class="bb-ba-table__actions">
              <% if (r.status === 'draft' && canCreate) { %>
              <form method="post" action="<%= basePath %>/<%= r.id %>/publish" class="bb-fr-inline-form" data-bb-resources-publish="1">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm">Publish</button>
              </form>
              <% } else { %>
              <span class="bb-ba-muted">—</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="bb-fr-resources-cards" data-bb-resources-cards="1">
      <% rows.forEach(function (r) { %>
      <article class="bb-fr-resource-card bb-ba-panel" data-bb-resource-card="<%= r.id %>" data-bb-status="<%= r.status %>">
        <div class="bb-fr-resource-card__top">
          <h3 class="bb-fr-resource-card__title"><%= r.title %></h3>
          <span class="bb-ba-chip <%= statusChip(r.status) %>"><%= statusLabel(r.status) %></span>
        </div>
        <% if (r.description) { %>
        <p class="bb-fr-resource-card__meta"><%= snippet(r.description) %></p>
        <% } %>
        <p class="bb-fr-resource-card__meta">
          <%= audienceLabel(r.audience) %>
          · <%= r.mediaAssetId ? 'Private file' : 'No attachment' %>
        </p>
        <% if (r.status === 'draft' && canCreate) { %>
        <p class="bb-fr-resource-card__actions">
          <form method="post" action="<%= basePath %>/<%= r.id %>/publish" class="bb-fr-inline-form" data-bb-resources-publish="1">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="bb-ba-btn bb-ba-btn--ghost bb-ba-btn--sm">Publish</button>
          </form>
        </p>
        <% } %>
      </article>
      <% }) %>
    </div>
  </section>
  <% } %>

  <aside class="bb-ba-entities-unavailable" data-bb-resources-unavailable="1" aria-label="Unavailable in V5">
    <p data-bb-resources-unavailable-row="progress">Course progress, certificates, and learning paths are not available.</p>
    <p data-bb-resources-unavailable-row="categories">Resource category taxonomies and collections are not available.</p>
    <p data-bb-resources-unavailable-row="cdn">Public CDN links for private attachments are not available.</p>
  </aside>
</section>

<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-end') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-end') %>
<% } %>
