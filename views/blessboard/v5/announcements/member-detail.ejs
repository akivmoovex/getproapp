<%- include('../partials/member-shell-start') %>
<%
  function formatPublished(value) {
    if (!value) return '';
    try {
      var d = value instanceof Date ? value : new Date(value);
      if (isNaN(d.getTime())) return '';
      return d.toLocaleString('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    } catch (e) {
      return '';
    }
  }

  function isRenderableAttachment(att) {
    if (!att || !att.mediaAssetId) return false;
    var id = String(att.mediaAssetId);
    if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(id)) {
      return false;
    }
    if (att.mediaStatus && String(att.mediaStatus) !== 'active') return false;
    return true;
  }

  var publishedLabel = formatPublished(item.publishedAt);
  var attachments = (item.attachments || []).filter(isRenderableAttachment);
%>

<section
  class="bb-mp-ann-detail-page"
  data-bb-member-announcement-detail="1"
  data-bb-stitch-announcements="16-member-announcements"
>
  <p class="bb-mp-back">
    <a href="/member/announcements">
      <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
      Back to announcements
    </a>
  </p>

  <% if (marked) { %>
  <p class="bb-mp-ok" role="status">Marked as read.</p>
  <% } %>

  <article
    class="bb-mp-ann-detail<%= item.isUnread ? ' is-unread' : ' is-read' %>"
    data-bb-announcement="<%= item.id %>"
    data-bb-unread="<%= item.isUnread ? '1' : '0' %>"
    data-bb-pinned="<%= item.isPinned ? '1' : '0' %>"
    data-bb-featured="<%= item.isFeatured ? '1' : '0' %>"
  >
    <div class="bb-mp-ann-chips" aria-label="Announcement status">
      <% if (item.isPinned) { %>
      <span class="bb-mp-chip bb-mp-chip--pinned">Pinned</span>
      <% } %>
      <% if (item.isFeatured) { %>
      <span class="bb-mp-chip bb-mp-chip--featured">Featured</span>
      <% } %>
      <% if (item.isUnread) { %>
      <span class="bb-mp-chip bb-mp-chip--unread" data-bb-read-status="unread">
        <span class="bb-mp-ann__unread-dot" aria-hidden="true"></span>
        Unread
      </span>
      <% } else { %>
      <span class="bb-mp-chip bb-mp-chip--read" data-bb-read-status="read">
        <span class="material-symbols-outlined" aria-hidden="true">done_all</span>
        Read
      </span>
      <% } %>
    </div>

    <h1 class="bb-mp-ann-detail__title"><%= item.title %></h1>
    <% if (publishedLabel) { %>
    <p class="bb-mp-ann-detail__meta">
      <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
      <%= publishedLabel %>
    </p>
    <% } %>

    <div class="bb-mp-ann-body"><%= item.body %></div>

    <% if (item.actionUrl && item.actionLabel) { %>
    <p class="bb-mp-ann-detail__action">
      <a class="bb-mp-btn bb-mp-btn--primary" href="<%= item.actionUrl %>" rel="noopener noreferrer" target="_blank">
        <%= item.actionLabel %>
        <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
      </a>
    </p>
    <% } %>

    <% if (attachments.length) { %>
    <section class="bb-mp-ann-attachments" aria-label="Attachments" data-bb-ann-attachments="1">
      <h2 class="bb-mp-section-title">Attachments</h2>
      <ul class="bb-mp-ann-attachments__list">
        <% attachments.forEach(function (att) { %>
        <li>
          <a
            class="bb-mp-ann-attachment"
            href="/member/announcements/<%= item.id %>/attachments/<%= att.id %>/file"
            data-bb-ann-attachment="<%= att.mediaAssetId %>"
            data-bb-ann-attachment-download="1"
          >
            <span class="material-symbols-outlined" aria-hidden="true">attach_file</span>
            <span class="bb-mp-ann-attachment__name"><%= att.originalFilename || 'Attachment' %></span>
            <span class="material-symbols-outlined bb-mp-ann-attachment__open" aria-hidden="true">open_in_new</span>
          </a>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <div class="bb-mp-ann-detail__read">
      <% if (item.isUnread) { %>
      <form
        method="post"
        action="/member/announcements/<%= item.id %>/read"
        class="bb-mp-ann-read-form"
        data-bb-mark-read-form="1"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="bb-mp-btn bb-mp-btn--outline">
          <span class="material-symbols-outlined" aria-hidden="true">mark_email_read</span>
          Mark as read
        </button>
      </form>
      <% } else { %>
      <p class="bb-mp-ann-detail__read-state" role="status">
        <span class="material-symbols-outlined" aria-hidden="true">done_all</span>
        You have read this announcement.
      </p>
      <% } %>
    </div>
  </article>
</section>

<%- include('../partials/member-shell-end') %>
