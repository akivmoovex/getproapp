<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-start') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-start') %>
<% } %>
<%
  var isHq = shellKind === 'hq';
  var stitchKey = isHq ? '61-hq-broadcast-center' : '35-branch-announcements-management';
  var scopeName = typeof branchDisplayName !== 'undefined' && branchDisplayName
    ? branchDisplayName
    : (typeof churchDisplayName !== 'undefined' && churchDisplayName ? churchDisplayName : (scopeLabel || 'this church'));
  var scopeKind = typeof isHqBranchScoped !== 'undefined' && isHqBranchScoped
    ? 'Branch'
    : (typeof isHqChurchWide !== 'undefined' && isHqChurchWide ? 'Church-wide' : (item && item.branchId ? 'Branch' : 'Church-wide'));
  function audienceLabel(list) {
    if (!list || !list.length) return '—';
    return list.map(function (k) {
      if (k === 'members') return 'Members';
      if (k === 'admins') return 'Admins';
      if (k === 'public') return 'Website';
      return k;
    }).join(', ');
  }
  function dtLocal(value) {
    if (!value) return '';
    var d = value instanceof Date ? value : new Date(value);
    if (isNaN(d.getTime())) return '';
    return d.toISOString().slice(0, 16);
  }
%>

<section
  class="bb-ann-admin bb-ba-ann-publish<%= isHq ? ' bb-hq-ann-publish' : '' %>"
  data-bb-announcement-admin-publish="1"
  data-bb-stitch-announcement-publish="<%= stitchKey %>"
  data-bb-stitch="BB20"
  data-bb-screen-desktop="BB20-D"
  data-bb-screen-mobile="BB20-M"
  <% if (isHq) { %>data-bb-hq-announcement-publish="1"<% } %>
>
  <%- include('./_testing-platform-admin-banner') %>
  <header class="bb-ba-page-head">
    <p class="bb-ba-breadcrumb">
      <a href="<%= basePath %>">Announcements</a>
      <span aria-hidden="true">›</span>
      <a href="<%= basePath %>/<%= item.id %>"><%= item.title %></a>
      <span aria-hidden="true">›</span>
      <span>Confirm publish</span>
    </p>
    <h1 class="bb-ba-page-head__title">Confirm publish</h1>
    <p class="bb-ba-lede">
      Review audience and scope before publishing
      <% if (isHq) { %>
      for <strong><%= scopeName %></strong> (<%= scopeKind %>).
      <% } %>
      This does not create member accounts or send messages on other channels.
    </p>
  </header>

  <% if (error) { %>
  <%- include('../partials/form-errors', { errors: [error], id: 'bb-ann-publish-errors' }) %>
  <% } %>

  <section class="bb-ba-panel" data-bb-ann-publish-review="1">
    <h2 class="bb-ba-section-title"><%= item.title %></h2>
    <p class="bb-ann-body"><%= item.body %></p>
    <dl class="bb-ann-dl">
      <div><dt>Audience</dt><dd><%= audienceLabel(item.audiences) %></dd></div>
      <div>
        <dt>Scope</dt>
        <dd data-bb-ann-publish-scope="<%= scopeKind === 'Church-wide' ? 'church' : 'branch' %>">
          <%= scopeKind %>
          <% if (typeof branchKey !== 'undefined' && branchKey) { %>
          <code class="bb-hq-key"><%= branchKey %></code>
          <% } %>
        </dd>
      </div>
      <% if (item.delivery) { %>
      <div>
        <dt>Estimated eligible members</dt>
        <dd data-bb-delivery="eligible" data-bb-ann-audience-estimate="1"><%= item.delivery.eligibleCount %></dd>
      </div>
      <% } %>
    </dl>
  </section>

  <form
    method="post"
    action="<%= basePath %>/<%= item.id %>/publish"
    class="bb-ba-decision bb-ba-ann-publish__form"
    data-bb-ann-publish-form="1"
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="expected_updated_at" value="<%= item.updatedAt && item.updatedAt.toISOString ? item.updatedAt.toISOString() : item.updatedAt %>" />
    <fieldset class="bb-ann-fieldset">
      <legend>Publication mode</legend>
      <label class="bb-ann-check">
        <input type="radio" name="publish_mode" value="now" checked />
        Publish now
      </label>
      <label class="bb-ann-check">
        <input type="radio" name="publish_mode" value="timed" />
        Set start time for later visibility (lazy — no background worker)
      </label>
    </fieldset>
    <div class="bb-ba-field">
      <label for="timezone">Timezone</label>
      <input id="timezone" type="text" name="timezone" value="<%= item.timezone || 'UTC' %>" />
    </div>
    <div class="bb-ba-field">
      <label for="starts_at">Starts at (required for timed mode)</label>
      <input id="starts_at" type="datetime-local" name="starts_at" value="<%= dtLocal(item.startsAt) %>" />
    </div>
    <div class="bb-ba-field">
      <label for="ends_at">Ends at (optional)</label>
      <input id="ends_at" type="datetime-local" name="ends_at" value="<%= dtLocal(item.endsAt) %>" />
    </div>
    <p class="bb-ba-hint" data-lazy-visibility="1">Live notifications are not sent. Unpublished and expired notices never appear on the public website.</p>
    <label class="bb-ann-check">
      <input type="checkbox" name="confirm_publish" value="1" />
      I confirm publishing now (required for publish-now; optional for timed mode)
    </label>
    <div class="bb-ba-decision__actions">
      <a class="bb-ba-btn bb-ba-btn--ghost" href="<%= basePath %>/<%= item.id %>" data-bb-ann-cancel="1">Cancel</a>
      <button type="submit" class="bb-ba-btn bb-ba-btn--primary" data-bb-ann-confirm-publish-submit="1">
        <span class="material-symbols-outlined" aria-hidden="true">campaign</span>
        Confirm publish
      </button>
    </div>
  </form>
</section>

<% if (shellKind === 'hq') { %>
<%- include('../partials/hq-shell-end') %>
<% } else { %>
<%- include('../partials/branch-admin-shell-end') %>
<% } %>
