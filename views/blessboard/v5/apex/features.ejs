<%#
  Apex Features — FG-01
  Canonical Stitch: desktop 7ef3518f23a0400098d810f617dd0cc0 · mobile 5ac1e1b0600b4bc78f945e36b56aaece
  Capabilities limited to V5 (or clearly labeled). No fabricated metrics / checkout.
%>
<%- include('../partials/apex-shell-start') %>

<div class="bb-apex-features-page" data-bb-apex-page="features" data-bb-batch="fg-01">
  <section class="bb-apex-features__hero" aria-labelledby="bb-features-hero-title">
    <div class="bb-apex-container bb-apex-features__hero-inner">
      <p class="bb-apex-mkt-hero__eyebrow">Features</p>
      <h1 class="bb-apex-features__title" id="bb-features-hero-title">
        Built for the <span class="bb-apex-hero__title-accent">Modern Ministry</span>
      </h1>
      <p class="bb-apex-features__lead">
        Explore the tools that help churches connect and grow. Digital stewardship designed for your community — websites, member engagement, and administration in one place.
      </p>
      <div class="bb-apex-features__cta">
        <a class="bb-apex-btn bb-apex-btn--primary" href="/register-church">Register Your Church</a>
        <a class="bb-apex-btn bb-apex-btn--secondary" href="/pricing">View pricing</a>
      </div>
    </div>
  </section>

  <section class="bb-apex-section bb-apex-mkt-split" aria-labelledby="bb-features-web">
    <div class="bb-apex-container bb-apex-mkt-split__grid">
      <div class="bb-apex-mkt-split__media bb-apex-features__media">
        <img
          src="/church/images/homepage/apex-feature-website.jpg"
          alt="Church website layout preview"
          width="640"
          height="480"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="bb-apex-mkt-split__copy">
        <span class="bb-apex-mkt-icon material-symbols-outlined" aria-hidden="true">public</span>
        <h2 class="bb-apex-section__title" id="bb-features-web">Website &amp; Public Presence</h2>
        <p class="bb-apex-mkt-split__lead">
          Your digital front door should be as welcoming as your physical one. Publish about, leadership, ministries, events, sermons, giving information, and contact — without coding.
        </p>
        <ul class="bb-apex-mkt-checks">
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span><strong>Church website CMS</strong> — publish pages and sections from branch administration.</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span><strong>BlessBoard subdomain</strong> — each active branch can publish on its own hostname.</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span><strong>Mobile-responsive design</strong> — layouts that work on phones, tablets, and desktops.</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
            <span><strong>Custom domains</strong> — Network-only; assisted onboarding with manual DNS/TLS (not automated).</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bb-apex-section bb-apex-section--surface bb-apex-mkt-split" aria-labelledby="bb-features-engage">
    <div class="bb-apex-container bb-apex-mkt-split__grid bb-apex-mkt-split__grid--reverse">
      <div class="bb-apex-mkt-split__media bb-apex-features__media">
        <img
          src="/church/images/homepage/apex-feature-engagement.jpg"
          alt="Congregation gathered in a church sanctuary"
          width="640"
          height="480"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="bb-apex-mkt-split__copy">
        <span class="bb-apex-mkt-icon material-symbols-outlined" aria-hidden="true">volunteer_activism</span>
        <h2 class="bb-apex-section__title" id="bb-features-engage">Member Engagement</h2>
        <p class="bb-apex-mkt-split__lead">
          Give members a signed-in home for announcements, events, ministries, resources, forms, and requests — according to what each church enables.
        </p>
        <ul class="bb-apex-mkt-card-grid bb-apex-features__cards">
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>
            <h3>Member portal</h3>
            <p>Personalized dashboards after branch verification.</p>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">event_available</span>
            <h3>Events &amp; ministries</h3>
            <p>Published lists and member participation tools.</p>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">payments</span>
            <h3>Giving information</h3>
            <p>Published methods only — <em>no payment gateway in V5</em>.</p>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">assignment</span>
            <h3>Forms &amp; requests</h3>
            <p>Submit and track requests your church has enabled.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bb-apex-section bb-apex-mkt-split" aria-labelledby="bb-features-ops">
    <div class="bb-apex-container bb-apex-mkt-split__grid">
      <div class="bb-apex-mkt-split__media bb-apex-features__media">
        <img
          src="/church/images/homepage/apex-feature-admin.jpg"
          alt="Church administration workspace"
          width="640"
          height="480"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="bb-apex-mkt-split__copy">
        <span class="bb-apex-mkt-icon material-symbols-outlined" aria-hidden="true">insights</span>
        <h2 class="bb-apex-section__title" id="bb-features-ops">Operational Excellence</h2>
        <p class="bb-apex-mkt-split__lead">
          Branch and HQ tools help leaders steward attendance, giving summaries, announcements, and member verification with live counts — not invented dashboards.
        </p>
        <ul class="bb-apex-mkt-checks">
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span><strong>Attendance tracking</strong> — record and review aggregate attendance for enabled branches.</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span><strong>Admin roles</strong> — branch, HQ, and platform roles with scoped access.</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span><strong>Registration review</strong> — verify members before portal access.</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span><strong>Advanced attendance &amp; giving reports</strong> — Growth and Network unlock detailed HQ reports with cross-branch views.</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span><strong>Executive dashboard &amp; governance audit</strong> — implemented on <em>Network</em> for entitled churches.</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
            <span><strong>SSO</strong> — <em>not included in the current product</em>.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bb-apex-section bb-apex-section--surface bb-apex-mkt-split" aria-labelledby="bb-features-scale">
    <div class="bb-apex-container bb-apex-mkt-split__grid bb-apex-mkt-split__grid--reverse">
      <div class="bb-apex-mkt-split__media bb-apex-features__media">
        <img
          src="/church/images/homepage/apex-feature-multibranch.jpg"
          alt="Multi-branch church coordination"
          width="640"
          height="480"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="bb-apex-mkt-split__copy">
        <span class="bb-apex-mkt-icon material-symbols-outlined" aria-hidden="true">account_tree</span>
        <h2 class="bb-apex-section__title" id="bb-features-scale">Enterprise Scaling</h2>
        <p class="bb-apex-mkt-split__lead">
          Designed for multi-site churches: unified HQ oversight with local branch flexibility, within your organization’s plan limits (unlimited branches on Growth and Network).
        </p>
        <ul class="bb-apex-mkt-checks">
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span><strong>Multi-branch support</strong> — each branch keeps its own site and admin team.</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span><strong>HQ oversight</strong> — branch registry, reports, and church-wide member views.</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span><strong>Platform administration</strong> — organization catalogue, plans, and deployments for BlessBoard operators.</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
            <span><strong>Hosted mailboxes, API &amp; webhooks</strong> — Network-positioned; by arrangement / external provider — <em>not self-serve live features today</em>.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bb-apex-section bb-apex-section--cta bb-apex-features__cta-band" aria-labelledby="bb-features-cta">
    <div class="bb-apex-container">
      <div class="bb-apex-cta-band">
        <h2 class="bb-apex-cta-band__title" id="bb-features-cta">Ready to transform your church operations?</h2>
        <p class="bb-apex-cta-band__lead">
          Request access for your congregation, or sign in if you already have a BlessBoard account.
        </p>
        <div class="bb-apex-cta-band__actions">
          <a class="bb-apex-btn bb-apex-btn--on-dark" href="/register-church">Register Your Church</a>
          <% if (authenticated) { %>
          <a class="bb-apex-btn bb-apex-btn--secondary bb-apex-btn--on-dark-outline" href="/account">Open Account</a>
          <% } else { %>
          <a class="bb-apex-btn bb-apex-btn--secondary bb-apex-btn--on-dark-outline" href="/login">Login</a>
          <% } %>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('../partials/apex-shell-end') %>
