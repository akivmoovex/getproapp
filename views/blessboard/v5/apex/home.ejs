<%#
  Apex home — canonical Stitch desktop:
    46081ff8f3d04090b9de33020bdf1530
  Mobile viewport stacks the same content (mobile Stitch HTML currently diverges;
  see BATCH_02 doc). No fabricated metrics/testimonials. No dead marketing routes.
%>
<%- include('../partials/apex-shell-start') %>

<section class="bb-apex-hero" data-bb-apex-hero="1" aria-label="BlessBoard home">
  <div class="bb-apex-container bb-apex-hero__grid">
    <div class="bb-apex-hero__copy">
      <h1 class="bb-apex-hero__title">
        One digital home for <span class="bb-apex-hero__title-accent">your church</span>
      </h1>
      <p class="bb-apex-hero__lead">
        Everything you need to grow your congregation, engage your members, and manage your ministry in one simple, powerful platform.
      </p>
      <div class="bb-apex-hero__cta">
        <% if (authenticated) { %>
        <a class="bb-apex-btn bb-apex-btn--primary" href="/account">Go to Account</a>
        <a class="bb-apex-btn bb-apex-btn--secondary" href="#capabilities">Explore capabilities</a>
        <% } else { %>
        <a class="bb-apex-btn bb-apex-btn--primary" href="/register-church">Register Your Church</a>
        <a class="bb-apex-btn bb-apex-btn--secondary" href="/login">Login</a>
        <% } %>
      </div>
    </div>
    <div class="bb-apex-hero__visual">
      <div class="bb-apex-hero__frame">
        <picture>
          <source media="(max-width: 767px)" srcset="/church/images/homepage/apex-hero-mobile.jpg" />
          <img
            src="/church/images/homepage/desktop-hero-auditorium.jpg"
            alt="People gathering in a warmly lit church sanctuary"
            width="960"
            height="720"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>
      <span class="bb-apex-hero__glow bb-apex-hero__glow--a" aria-hidden="true"></span>
      <span class="bb-apex-hero__glow bb-apex-hero__glow--b" aria-hidden="true"></span>
    </div>
  </div>
</section>

<section class="bb-apex-section bb-apex-section--surface" aria-labelledby="bb-apex-audience-heading">
  <div class="bb-apex-container">
    <div class="bb-apex-section__intro bb-apex-section__intro--center">
      <h2 class="bb-apex-section__title" id="bb-apex-audience-heading">Designed for every member of your community</h2>
      <div class="bb-apex-section__rule" aria-hidden="true"></div>
    </div>
    <ul class="bb-apex-audience">
      <li class="bb-apex-audience__card">
        <span class="bb-apex-audience__icon" aria-hidden="true"><span class="material-symbols-outlined">person_add</span></span>
        <h3 class="bb-apex-audience__title">For Visitors</h3>
        <p class="bb-apex-audience__body">Find your place and stay connected.</p>
      </li>
      <li class="bb-apex-audience__card">
        <span class="bb-apex-audience__icon" aria-hidden="true"><span class="material-symbols-outlined">favorite</span></span>
        <h3 class="bb-apex-audience__title">For Members</h3>
        <p class="bb-apex-audience__body">Deepen your faith and fellowship.</p>
      </li>
      <li class="bb-apex-audience__card">
        <span class="bb-apex-audience__icon" aria-hidden="true"><span class="material-symbols-outlined">auto_graph</span></span>
        <h3 class="bb-apex-audience__title">For Leaders</h3>
        <p class="bb-apex-audience__body">Empower your ministry with the right tools.</p>
      </li>
      <li class="bb-apex-audience__card">
        <span class="bb-apex-audience__icon" aria-hidden="true"><span class="material-symbols-outlined">account_tree</span></span>
        <h3 class="bb-apex-audience__title">For Multi-Branch</h3>
        <p class="bb-apex-audience__body">Unity and oversight for growing organizations.</p>
      </li>
    </ul>
  </div>
</section>

<section class="bb-apex-section" id="capabilities" aria-labelledby="bb-apex-features-heading">
  <div class="bb-apex-container">
    <div class="bb-apex-section__intro">
      <p class="bb-apex-section__eyebrow">Platform Capabilities</p>
      <h2 class="bb-apex-section__title" id="bb-apex-features-heading">Powerful tools built for modern ministry</h2>
    </div>
    <ul class="bb-apex-features">
      <li class="bb-apex-feature">
        <div class="bb-apex-feature__media">
          <img
            src="/church/images/homepage/apex-feature-website.jpg"
            alt=""
            width="640"
            height="400"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="bb-apex-feature__copy">
          <h3 class="bb-apex-feature__title">Public Church Website</h3>
          <p class="bb-apex-feature__body">A beautiful, data-driven home for your online presence.</p>
        </div>
      </li>
      <li class="bb-apex-feature">
        <div class="bb-apex-feature__media">
          <img
            src="/church/images/homepage/apex-feature-engagement.jpg"
            alt=""
            width="640"
            height="400"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="bb-apex-feature__copy">
          <h3 class="bb-apex-feature__title">Member Engagement</h3>
          <p class="bb-apex-feature__body">Tools for prayer requests, giving, and community growth.</p>
        </div>
      </li>
      <li class="bb-apex-feature">
        <div class="bb-apex-feature__media">
          <img
            src="/church/images/homepage/apex-feature-admin.jpg"
            alt=""
            width="640"
            height="400"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="bb-apex-feature__copy">
          <h3 class="bb-apex-feature__title">Church Administration</h3>
          <p class="bb-apex-feature__body">Streamlined attendance, reporting, and management.</p>
        </div>
      </li>
      <li class="bb-apex-feature">
        <div class="bb-apex-feature__media">
          <img
            src="/church/images/homepage/apex-feature-multibranch.jpg"
            alt=""
            width="640"
            height="400"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="bb-apex-feature__copy">
          <h3 class="bb-apex-feature__title">Multi-Branch Management</h3>
          <p class="bb-apex-feature__body">Consolidated oversight for complex organizations.</p>
        </div>
      </li>
    </ul>
  </div>
</section>

<section class="bb-apex-section bb-apex-section--cta" aria-labelledby="bb-apex-cta-heading">
  <div class="bb-apex-container">
    <div class="bb-apex-cta-band">
      <h2 class="bb-apex-cta-band__title" id="bb-apex-cta-heading">Ready to empower your ministry?</h2>
      <p class="bb-apex-cta-band__lead">
        Sign in to your BlessBoard account to continue. Church sites are available on each congregation’s hostname.
      </p>
      <div class="bb-apex-cta-band__actions">
        <% if (authenticated) { %>
        <a class="bb-apex-btn bb-apex-btn--on-dark" href="/account">Open Account</a>
        <% } else { %>
        <a class="bb-apex-btn bb-apex-btn--on-dark" href="/register-church">Register Your Church</a>
        <a class="bb-apex-btn bb-apex-btn--secondary bb-apex-btn--on-dark-outline" href="/login">Login</a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/apex-shell-end') %>
