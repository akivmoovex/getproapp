<%#
  Apex account — STITCH_MISSING; Sacred Modernity shell + auth-card chrome.
  Locals: displayName, rolesLabel, roleBadges[], hostKind, churchDisplayName,
          branchDisplayName, csrfToken, showPlatformAdminLink (+ apex-shell locals)
  No UUIDs, session tokens, billing, editing, or password change.
%>
<%- include('../partials/apex-shell-start') %>

<section class="bb-apex-account" data-bb-apex-account="1" aria-labelledby="bb-apex-account-heading">
  <div class="bb-apex-account__card">
    <div class="bb-apex-account__icon" aria-hidden="true">
      <span class="material-symbols-outlined">account_circle</span>
    </div>
    <h1 class="bb-apex-account__title" id="bb-apex-account-heading">Account</h1>
    <p class="bb-apex-account__lead">You are signed in to BlessBoard.</p>

    <div class="bb-apex-account__identity">
      <p class="bb-apex-account__name"><%= displayName %></p>
      <% if (typeof roleBadges !== 'undefined' && roleBadges && roleBadges.length) { %>
      <ul class="bb-apex-account__badges" aria-label="Roles">
        <% roleBadges.forEach(function (badge) { %>
        <li><span class="bb-ds-badge"><%= badge %></span></li>
        <% }) %>
      </ul>
      <% } else { %>
      <p class="bb-apex-account__roles"><%= rolesLabel %></p>
      <% } %>
    </div>

    <% if ((hostKind === 'tenant' && churchDisplayName) || (hostKind === 'tenant' && branchDisplayName)) { %>
    <div class="bb-apex-account__access" aria-label="Church access">
      <% if (churchDisplayName) { %>
      <article class="bb-apex-account__access-card">
        <span class="bb-apex-account__access-icon material-symbols-outlined" aria-hidden="true">church</span>
        <div>
          <h2 class="bb-apex-account__access-title">Church</h2>
          <p class="bb-apex-account__access-body"><%= churchDisplayName %></p>
        </div>
      </article>
      <% } %>
      <% if (branchDisplayName) { %>
      <article class="bb-apex-account__access-card">
        <span class="bb-apex-account__access-icon material-symbols-outlined" aria-hidden="true">location_on</span>
        <div>
          <h2 class="bb-apex-account__access-title">Branch</h2>
          <p class="bb-apex-account__access-body"><%= branchDisplayName %></p>
        </div>
      </article>
      <% } %>
    </div>
    <% } %>

    <% if (hostKind === 'apex') { %>
    <p class="bb-apex-account__note">
      Tenant administration requires signing in on the church hostname.
    </p>
    <% if (typeof showPlatformAdminLink !== 'undefined' && showPlatformAdminLink) { %>
    <p class="bb-apex-account__note">
      <a href="/admin" data-bb-platform-admin-link="1">Open Platform Admin</a>
    </p>
    <% } %>
    <% } else { %>
    <p class="bb-apex-account__note">
      <a href="/hq">Church HQ</a> · <a href="/branch-admin">Branch admin</a>
    </p>
    <% } %>

    <form class="bb-apex-account__logout" method="post" action="/logout" data-bb-auth-logout="1">
      <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
      <button type="submit" class="bb-apex-btn bb-apex-btn--primary">
        <span class="material-symbols-outlined" aria-hidden="true">logout</span>
        Sign out
      </button>
    </form>
  </div>
</section>

<%- include('../partials/apex-shell-end') %>
