<%#
  Forgot password — request reset email (enumeration-safe).
  Locals: csrfToken, message, error, emailValue, loginHref
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Forgot password · BlessBoard</title>
  <%- include('../partials/head-design-system') %>
  <link rel="stylesheet" href="/blessboard/v5/tenant-auth.css?v=15" />
  <link rel="stylesheet" href="/blessboard/v5/apex-auth.css?v=6" />
  <link rel="stylesheet" href="/activeclinic/ac-phone-field.css?v=bb-phone-1" />
</head>
<body class="bb-auth-body bb-auth-login" data-bb-shell="apex-auth" data-bb-page="forgot-password">
  <a class="bb-auth-skip" href="#bb-auth-forgot-form">Skip to form</a>
  <div class="bb-auth-layout">
    <aside class="bb-auth-panel" aria-hidden="true">
      <div class="bb-auth-panel__inner">
        <p class="bb-auth-panel__eyebrow">Secure access</p>
        <p class="bb-auth-panel__title">Reset your password</p>
        <p class="bb-auth-panel__lead">Check your phone for a code when phone recovery is used. Email recovery remains available for existing accounts.</p>
      </div>
    </aside>
    <main class="bb-auth-main">
      <header class="bb-auth-main__header">
        <a class="bb-auth-brand" href="/">
          <span class="bb-platform-brand__lockup">
            <span class="bb-auth-brand__name">BlessBoard</span>
            <%- include('../partials/platform-brand-subtitle') %>
          </span>
        </a>
        <a class="bb-auth-main__header-link" href="<%= loginHref || '/login' %>">Sign in</a>
      </header>
      <div class="bb-auth-main__body">
        <div class="bb-auth-card bb-auth-card--login">
          <div class="bb-auth-card__intro">
            <h1 class="bb-auth-card__title">Forgot password?</h1>
            <p class="bb-auth-card__lead">Enter your phone number for SMS recovery, or use email recovery for existing accounts.</p>
          </div>
          <% if (message) { %>
          <p class="bb-auth-success" role="status" data-bb-auth-reset-requested="1"><%= message %></p>
          <% } %>
          <% if (error) { %>
          <div class="bb-auth-error" role="alert"><p class="bb-auth-error__body"><%= error %></p></div>
          <% } %>
          <% if (!message) { %>
          <form method="post" action="/forgot-password" class="bb-auth-form" id="bb-auth-forgot-form" autocomplete="on" data-bb-auth-recovery="phone-or-email">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <%- include('../partials/phone-field', {
              id: 'phone',
              label: 'Mobile phone number',
              required: false,
              defaultCountry: 'ZM',
              selectedCountry: (typeof phoneCountryValue !== 'undefined' && phoneCountryValue) || 'ZM',
              nationalValue: (typeof phoneNationalValue !== 'undefined' && phoneNationalValue) || '',
              e164Value: '',
              countries: (typeof phoneCountries !== 'undefined' && phoneCountries) || [],
              showLegacyHidden: false,
              hint: 'Preferred. Enter the 6-digit code when prompted.',
              error: null,
              placeholder: '97 123 4567'
            }) %>
            <div class="bb-auth-field">
              <label for="email">Email address, optional recovery</label>
              <input id="email" name="email" type="email" autocomplete="username" inputmode="email" spellcheck="false" value="<%= emailValue || '' %>" />
              <p class="bb-auth-hint">Use email recovery instead when your account is email-only.</p>
            </div>
            <div class="bb-auth-actions">
              <button class="bb-auth-btn bb-auth-btn--primary" type="submit">Send recovery instructions</button>
            </div>
          </form>
          <% } %>
          <p class="bb-auth-footnote"><a href="<%= loginHref || '/login' %>">Back to sign in</a></p>
        </div>
      </div>
    </main>
  </div>
  <script src="/activeclinic/ac-phone-field.js?v=bb-phone-1" defer></script>
</body>
</html>
