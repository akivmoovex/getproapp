<%#
  Reset password with one-time token.
  Locals: csrfToken, token, tokenValid, tokenStatus, error, message, loginHref, forgotHref
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Reset password · BlessBoard</title>
  <%- include('../partials/head-design-system') %>
  <link rel="stylesheet" href="/blessboard/v5/tenant-auth.css?v=14" />
  <link rel="stylesheet" href="/blessboard/v5/apex-auth.css?v=6" />
</head>
<body class="bb-auth-body bb-auth-login" data-bb-shell="apex-auth" data-bb-page="reset-password">
  <div class="bb-auth-layout">
    <aside class="bb-auth-panel" aria-hidden="true">
      <div class="bb-auth-panel__inner">
        <p class="bb-auth-panel__eyebrow">Secure access</p>
        <p class="bb-auth-panel__title">Choose a new password</p>
        <p class="bb-auth-panel__lead">Use 10–200 characters. The reset link works only once.</p>
      </div>
    </aside>
    <main class="bb-auth-main">
      <header class="bb-auth-main__header">
        <a class="bb-auth-brand" href="/">
          <span class="bb-platform-brand__lockup">
            <span class="bb-auth-brand__name">BlessBoard</span>
            <%- include('../partials/platform-brand-subtitle') %>
          </span>
        </a>
        <a class="bb-auth-main__header-link" href="<%= loginHref || '/login' %>">Sign in</a>
      </header>
      <div class="bb-auth-main__body">
        <div class="bb-auth-card bb-auth-card--login">
          <div class="bb-auth-card__intro">
            <h1 class="bb-auth-card__title">Reset password</h1>
          </div>
          <% if (error) { %>
          <div class="bb-auth-error" role="alert"><p class="bb-auth-error__body"><%= error %></p></div>
          <% } %>
          <% if (!tokenValid) { %>
          <p class="bb-auth-card__lead">This reset link is invalid or no longer available.</p>
          <p class="bb-auth-footnote"><a href="<%= forgotHref || '/forgot-password' %>">Request a new link</a></p>
          <% } else { %>
          <form method="post" class="bb-auth-form" autocomplete="on">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="token" value="<%= token %>" />
            <div class="bb-auth-field">
              <label for="password">New password</label>
              <input id="password" name="password" type="password" required minlength="10" maxlength="200" autocomplete="new-password" />
            </div>
            <div class="bb-auth-field">
              <label for="password_confirm">Confirm password</label>
              <input id="password_confirm" name="password_confirm" type="password" required minlength="10" maxlength="200" autocomplete="new-password" />
            </div>
            <div class="bb-auth-actions">
              <button class="bb-auth-btn bb-auth-btn--primary" type="submit">Update password</button>
            </div>
          </form>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
