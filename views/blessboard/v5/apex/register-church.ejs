<%#
  Apex Register Your Church — Stitch 8640e853… / 515da582…
  Automatic Foundation + Growth trial provisioning by default (emergency env disable → enquiry).
  Network remains support-contact / enquiry only (no auto tenant).
  Locals: authenticated, csrfToken, csrfField, submitted, networkSupportSuccess, workspaceReady, loginFallback,
          review, organizationKeyPreview, form, formError, fieldError, selectedPlan,
          instantFreeEnabled
%>
<%
  var formData = typeof form !== 'undefined' && form ? form : {};
  var activeFieldError = typeof fieldError !== 'undefined' ? fieldError : null;
  var planValue = formData.selected_plan || (typeof selectedPlan !== 'undefined' && selectedPlan ? selectedPlan : '');
  var instantOn = typeof instantFreeEnabled !== 'undefined' && instantFreeEnabled;
  var orgKeyPreview = typeof organizationKeyPreview !== 'undefined' && organizationKeyPreview
    ? String(organizationKeyPreview) : (formData.organization_key || '');
  function fieldHasError(name) { return activeFieldError === name; }
  var showSuccessEnquiry = typeof submitted !== 'undefined' && submitted;
  var showNetworkSupportSuccess = typeof networkSupportSuccess !== 'undefined' && networkSupportSuccess;
  var showSuccessWorkspace = typeof workspaceReady !== 'undefined' && workspaceReady;
  var showReview = typeof review !== 'undefined' && review;
  var showLoginFallback = typeof loginFallback !== 'undefined' && loginFallback;
%>
<%- include('../partials/apex-shell-start') %>

<section class="bb-apex-register" data-bb-apex-page="register-church" data-bb-register-mode="<%= instantOn ? 'instant-free' : 'application' %>">
  <div class="bb-apex-container bb-apex-register__grid">
    <aside class="bb-apex-register__aside" aria-labelledby="bb-register-aside-title">
      <p class="bb-apex-mkt-hero__eyebrow">Join BlessBoard</p>
      <h1 class="bb-apex-register__aside-title" id="bb-register-aside-title">Nurture Your Community.</h1>
      <p class="bb-apex-register__aside-lead">
        BlessBoard helps congregations publish a church website, engage verified members, and administer branch and HQ operations on GetPro.
      </p>
      <ul class="bb-apex-mkt-checks">
        <li>
          <span class="material-symbols-outlined" aria-hidden="true">verified</span>
          <span><strong>Unified ministry tools</strong> — public site, member portal, and admin workspaces.</span>
        </li>
        <li>
          <span class="material-symbols-outlined" aria-hidden="true">favorite</span>
          <span><strong>Stewardship first</strong> — designed for clarity, not checkout gimmicks.</span>
        </li>
        <li>
          <span class="material-symbols-outlined" aria-hidden="true">diversity_3</span>
          <span><strong>Multi-branch ready</strong> — capacity depends on your approved plan and setup.</span>
        </li>
      </ul>
      <% if (instantOn) { %>
      <p class="bb-apex-register__aside-note">
        Choosing <strong>Foundation — Free</strong> or <strong>Growth</strong> creates your church workspace and administrator account immediately (Growth includes a 30-day trial).
        Your public church website stays unpublished until you choose to publish. Network requests stay pending until BlessBoard follows up.
        BlessBoard may contact you to offer optional onboarding help — a callback is not required to keep portal access.
      </p>
      <% } else { %>
      <p class="bb-apex-register__aside-note">
        Submitting this form creates a pending application for platform-admin review. It does not create a live church, branch, administrator account, or paid subscription.
      </p>
      <% } %>
    </aside>

    <div class="bb-apex-register__panel">
      <div class="bb-apex-register__card">
        <h2 class="bb-apex-register__card-title">Register Your Church</h2>

        <% if (showReview) { %>
        <div class="bb-apex-register-success" role="status" data-bb-register-review="1">
          <span class="material-symbols-outlined" aria-hidden="true">support_agent</span>
          <div>
            <p class="bb-apex-register-success__title">We received your registration.</p>
            <p class="bb-apex-register-success__body">
              Your request needs a short review before we can continue. BlessBoard will assist you —
              no further action is required right now.
            </p>
          </div>
        </div>
        <div class="bb-apex-register__actions">
          <a class="bb-apex-btn bb-apex-btn--secondary" href="/">Back to home</a>
        </div>

        <% } else if (showSuccessWorkspace) { %>
        <div class="bb-apex-register-success" role="status" data-bb-register-workspace="1">
          <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
          <div>
            <p class="bb-apex-register-success__title">Your church workspace has been created.</p>
            <p class="bb-apex-register-success__body">
              The <strong>Free</strong> plan is active. Your public church website is <strong>not published yet</strong>.
              Your administrator account is ready so you can begin setup.
            </p>
            <% if (orgKeyPreview) { %>
            <p class="bb-apex-register-success__body">
              Organization key: <code><%= orgKeyPreview %></code>
              — future public path preview: <code>/c/<%= orgKeyPreview %></code>
              (the public site stays unpublished until you publish it).
            </p>
            <% } %>
            <p class="bb-apex-register-success__body">
              BlessBoard may contact you to offer optional onboarding assistance. A callback is not required to keep portal access.
            </p>
            <% if (showLoginFallback) { %>
            <p class="bb-apex-register-success__body">
              Sign in with the email and password you just created to continue.
            </p>
            <% } %>
          </div>
        </div>
        <div class="bb-apex-register__actions">
          <% if (showLoginFallback) { %>
          <a class="bb-apex-btn bb-apex-btn--primary" href="/login?next=%2Faccount">Sign in</a>
          <% } else { %>
          <a class="bb-apex-btn bb-apex-btn--primary" href="/account">Go to your account</a>
          <% } %>
          <a class="bb-apex-btn bb-apex-btn--secondary" href="/">Back to home</a>
        </div>

        <% } else if (showNetworkSupportSuccess) { %>
        <div class="bb-apex-register-success" role="status" data-bb-register-success="1" data-bb-register-network-support="1">
          <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
          <div>
            <p class="bb-apex-register-success__body" data-bb-network-success-message="1">
              Thank you for your interest in the BlessBoard Network plan. Your registration has been received successfully. Our customer support team will contact you shortly to validate your organization's requirements and guide you through the next steps.
            </p>
          </div>
        </div>
        <div class="bb-apex-register__actions">
          <a class="bb-apex-btn bb-apex-btn--primary" href="/pricing">Review plans</a>
          <a class="bb-apex-btn bb-apex-btn--secondary" href="/">Back to home</a>
        </div>

        <% } else if (showSuccessEnquiry) { %>
        <div class="bb-apex-register-success" role="status" data-bb-register-success="1">
          <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
          <div>
            <p class="bb-apex-register-success__title">Thank you — your application was received.</p>
            <p class="bb-apex-register-success__body">
              Your church registration is <strong>pending review</strong>. BlessBoard platform administrators will follow up about onboarding. Your church is not activated yet.
            </p>
            <p class="bb-apex-register-success__body">
              You can prepare preferred subdomain ideas and administrator contacts while you wait.
            </p>
          </div>
        </div>
        <div class="bb-apex-register__actions">
          <a class="bb-apex-btn bb-apex-btn--primary" href="/pricing">Review plans</a>
          <a class="bb-apex-btn bb-apex-btn--secondary" href="/">Back to home</a>
        </div>

        <% } else { %>
        <p class="bb-apex-register__card-lead">
          <% if (instantOn) { %>
          Choose <strong>Foundation — Free</strong> or <strong>Growth</strong> to create your workspace now (Growth includes a 30-day trial), or select <strong>Network</strong> to request a conversation with BlessBoard.
          <% } else { %>
          Provide your church details to request an invitation. Platform administrators review applications before any church is provisioned.
          <% } %>
        </p>

        <% if (formError && !activeFieldError) { %>
        <div class="bb-apex-register-alert" role="alert">
          <p><%= formError %></p>
          <% if (typeof showCsrfRetry !== 'undefined' && showCsrfRetry) { %>
          <p class="bb-apex-register-alert__retry">
            <a href="/register-church<%= planValue ? ('?plan=' + encodeURIComponent(planValue)) : '' %>">Reload the registration form</a>
            to continue with a fresh security token.
          </p>
          <% } %>
        </div>
        <% } %>

        <form
          class="bb-apex-register-form"
          action="/register-church"
          method="post"
          novalidate
          data-bb-register-form="1"
          autocomplete="on"
        >
          <% if (!csrfToken) { %>
          <div class="bb-apex-register-alert" role="alert">
            Security token missing. <a href="/register-church">Reload this page</a> before submitting.
          </div>
          <% } %>
          <input type="hidden" name="<%= typeof csrfField !== 'undefined' && csrfField ? csrfField : '_csrf' %>" value="<%= csrfToken || '' %>" />

          <div class="visually-hidden" aria-hidden="true">
            <label for="register_company_website">Company website</label>
            <input id="register_company_website" type="text" name="company_website" tabindex="-1" autocomplete="off" />
          </div>

          <fieldset class="bb-apex-register-form__section">
            <legend class="bb-apex-register-form__section-head">
              <span class="material-symbols-outlined" aria-hidden="true">person</span>
              Contact person
            </legend>
            <div class="bb-apex-register-form__grid bb-apex-register-form__grid--two">
              <div class="bb-apex-field">
                <label class="bb-apex-register-label" for="register_contact_name">Full name</label>
                <input
                  class="bb-apex-register-input<%= fieldHasError('contact_name') ? ' is-error' : '' %>"
                  id="register_contact_name"
                  name="contact_name"
                  type="text"
                  required
                  autocomplete="name"
                  value="<%= formData.contact_name || '' %>"
                  <%= fieldHasError('contact_name') ? 'aria-invalid="true"' : '' %>
                />
                <% if (fieldHasError('contact_name') && formError) { %>
                <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
                <% } %>
              </div>
              <div class="bb-apex-field">
                <label class="bb-apex-register-label" for="register_email">Email address</label>
                <input
                  class="bb-apex-register-input<%= fieldHasError('email') ? ' is-error' : '' %>"
                  id="register_email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  value="<%= formData.email || '' %>"
                  <%= fieldHasError('email') ? 'aria-invalid="true"' : '' %>
                />
                <% if (fieldHasError('email') && formError) { %>
                <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
                <% } %>
              </div>
            </div>
            <div class="bb-apex-field bb-apex-field--phone<%= fieldHasError('phone') ? ' is-error' : '' %>">
              <%- include('../partials/phone-field', {
                id: 'register_phone',
                label: 'Phone number',
                labelClass: 'bb-apex-register-label',
                required: true,
                defaultCountry: (typeof defaultCountry !== 'undefined' && defaultCountry) || (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || 'ZM',
                selectedCountry: formData.phone_country || (typeof selectedCountry !== 'undefined' && selectedCountry) || (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || 'ZM',
                nationalValue: formData.phone_national || '',
                e164Value: formData.phone_national ? '' : (formData.phone || ''),
                countries: (typeof phoneCountries !== 'undefined' && phoneCountries) || (typeof countries !== 'undefined' && countries) || [],
                phoneValidationRelaxed: typeof phoneValidationRelaxed !== 'undefined' && phoneValidationRelaxed,
                countryFieldName: 'phone_country',
                nationalFieldName: 'phone_national',
                legacyFieldName: 'phone',
                showLegacyHidden: true,
                showCountryName: true,
                error: fieldHasError('phone') ? (formError || 'Please enter a valid phone number.') : null,
                placeholder: '97 1234567'
              }) %>
            </div>
            <div class="bb-apex-field">
              <label class="bb-apex-register-label" for="register_role">Role in church</label>
              <input
                class="bb-apex-register-input<%= fieldHasError('role_in_church') ? ' is-error' : '' %>"
                id="register_role"
                name="role_in_church"
                type="text"
                required
                placeholder="Pastor, administrator, elder, etc."
                value="<%= formData.role_in_church || '' %>"
                <%= fieldHasError('role_in_church') ? 'aria-invalid="true"' : '' %>
              />
              <% if (fieldHasError('role_in_church') && formError) { %>
              <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
              <% } %>
            </div>
          </fieldset>

          <fieldset class="bb-apex-register-form__section">
            <legend class="bb-apex-register-form__section-head">
              <span class="material-symbols-outlined" aria-hidden="true">church</span>
              Church details
            </legend>
            <div class="bb-apex-field">
              <label class="bb-apex-register-label" for="register_church_name">Church or organization name</label>
              <input
                class="bb-apex-register-input<%= fieldHasError('church_name') ? ' is-error' : '' %>"
                id="register_church_name"
                name="church_name"
                type="text"
                required
                value="<%= formData.church_name || '' %>"
                <%= fieldHasError('church_name') ? 'aria-invalid="true"' : '' %>
              />
              <% if (fieldHasError('church_name') && formError) { %>
              <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
              <% } %>
            </div>
            <div class="bb-apex-register-form__grid bb-apex-register-form__grid--two">
              <div class="bb-apex-field">
                <label class="bb-apex-register-label" for="register_country">Country</label>
                <select
                  class="bb-apex-register-input<%= fieldHasError('country') ? ' is-error' : '' %>"
                  id="register_country"
                  name="country"
                  required
                  autocomplete="country-name"
                  <%= fieldHasError('country') ? 'aria-invalid="true"' : '' %>
                >
                  <%
                    var churchCountryList = (typeof phoneCountries !== 'undefined' && phoneCountries) || (typeof countries !== 'undefined' && countries) || [];
                    var selectedChurchCountry = String(formData.country || defaultCountry || 'ZM').toUpperCase();
                    churchCountryList.forEach(function (c) {
                  %>
                  <option value="<%= c.iso %>"<%= selectedChurchCountry === c.iso ? ' selected' : '' %>><%= c.name %></option>
                  <% }); %>
                </select>
                <% if (fieldHasError('country') && formError) { %>
                <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
                <% } %>
              </div>
              <div class="bb-apex-field">
                <label class="bb-apex-register-label" for="register_city">Town or city</label>
                <input
                  class="bb-apex-register-input<%= fieldHasError('city') ? ' is-error' : '' %>"
                  id="register_city"
                  name="city"
                  type="text"
                  required
                  autocomplete="address-level2"
                  value="<%= formData.city || '' %>"
                  <%= fieldHasError('city') ? 'aria-invalid="true"' : '' %>
                />
                <% if (fieldHasError('city') && formError) { %>
                <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
                <% } %>
              </div>
            </div>
            <div class="bb-apex-register-form__grid bb-apex-register-form__grid--two">
              <div class="bb-apex-field">
                <label class="bb-apex-register-label" for="register_branch_name">Branch name <span class="bb-apex-register-label__meta">(optional)</span></label>
                <input class="bb-apex-register-input" id="register_branch_name" name="branch_name" type="text" value="<%= formData.branch_name || '' %>" />
              </div>
              <div class="bb-apex-field">
                <label class="bb-apex-register-label" for="register_branch_count">Approximate number of branches <span class="bb-apex-register-label__meta">(optional)</span></label>
                <input
                  class="bb-apex-register-input<%= fieldHasError('branch_count') ? ' is-error' : '' %>"
                  id="register_branch_count"
                  name="branch_count"
                  type="number"
                  min="1"
                  max="999"
                  inputmode="numeric"
                  value="<%= formData.branch_count || '' %>"
                  <%= fieldHasError('branch_count') ? 'aria-invalid="true"' : '' %>
                />
                <% if (fieldHasError('branch_count') && formError) { %>
                <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
                <% } %>
              </div>
            </div>
          </fieldset>

          <fieldset class="bb-apex-register-form__section">
            <legend class="bb-apex-register-form__section-head">
              <span class="material-symbols-outlined" aria-hidden="true">payments</span>
              Plan
            </legend>
            <div class="bb-apex-field">
              <label class="bb-apex-register-label" for="register_selected_plan">
                <%= instantOn ? 'Selected plan' : 'Interested plan' %>
                <% if (!instantOn) { %><span class="bb-apex-register-label__meta">(optional)</span><% } %>
              </label>
              <select
                class="bb-apex-register-input<%= fieldHasError('selected_plan') ? ' is-error' : '' %>"
                id="register_selected_plan"
                name="selected_plan"
                <%= fieldHasError('selected_plan') ? 'aria-invalid="true"' : '' %>
                data-bb-register-plan="1"
              >
                <% if (!instantOn) { %>
                <option value=""<%= !planValue ? ' selected' : '' %>>Not sure yet</option>
                <% } %>
                <option value="foundation"<%= planValue === 'foundation' || (instantOn && !planValue) ? ' selected' : '' %>>Foundation — Free</option>
                <option value="growth"<%= planValue === 'growth' ? ' selected' : '' %>>Growth</option>
                <option value="network"<%= planValue === 'network' ? ' selected' : '' %>>Network</option>
              </select>
              <% if (fieldHasError('selected_plan') && formError) { %>
              <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
              <% } %>
            </div>
            <div class="bb-apex-field">
              <label class="bb-apex-register-label" for="register_message">Message <span class="bb-apex-register-label__meta">(optional)</span></label>
              <textarea
                class="bb-apex-register-input bb-apex-register-input--textarea"
                id="register_message"
                name="message"
                rows="4"
                placeholder="Tell us briefly about your church and what you hope to use BlessBoard for."
              ><%= formData.message || '' %></textarea>
            </div>
          </fieldset>

          <% if (instantOn) { %>
          <fieldset class="bb-apex-register-form__section" data-bb-instant-free-fields="1">
            <legend class="bb-apex-register-form__section-head">
              <span class="material-symbols-outlined" aria-hidden="true">vpn_key</span>
              Workspace setup
            </legend>
            <p class="bb-apex-register__card-lead">
              Required for <strong>Foundation — Free</strong> and <strong>Growth</strong> (30-day trial).
              Your administrator portal is available immediately after creation.
              The public path below is a preview only — the website is not published automatically.
            </p>
            <div class="bb-apex-field">
              <label class="bb-apex-register-label" for="register_church_url">Your church URL</label>
              <p
                class="bb-apex-register-input bb-apex-register-input--readonly"
                id="register_church_url"
                data-bb-church-url="1"
                tabindex="0"
              ><span data-bb-church-url-base><%= typeof churchPublicUrlBase !== 'undefined' && churchPublicUrlBase ? churchPublicUrlBase : 'blessboard.com/c/' %></span><span data-bb-org-key-preview><%= orgKeyPreview || 'your-church' %></span></p>
              <input type="hidden" name="organization_key" id="register_organization_key" value="<%= orgKeyPreview || '' %>" autocomplete="off"/>
              <p class="bb-apex-mkt-footnote" id="register_organization_key_hint">
                Your church URL is created automatically from your church name.
              </p>
              <% if (fieldHasError('organization_key') && formError) { %>
              <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
              <% } %>
              <% if (fieldHasError('church_name') && formError && /church URL/i.test(String(formError))) { %>
              <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
              <% } %>
            </div>
            <div class="bb-apex-register-form__grid bb-apex-register-form__grid--two">
              <div class="bb-apex-field">
                <label class="bb-apex-register-label" for="register_password">Administrator password</label>
                <input
                  class="bb-apex-register-input<%= fieldHasError('password') ? ' is-error' : '' %>"
                  id="register_password"
                  name="password"
                  type="password"
                  autocomplete="new-password"
                  <%= fieldHasError('password') ? 'aria-invalid="true"' : '' %>
                />
                <% if (fieldHasError('password') && formError) { %>
                <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
                <% } %>
              </div>
              <div class="bb-apex-field">
                <label class="bb-apex-register-label" for="register_password_confirm">Confirm password</label>
                <input
                  class="bb-apex-register-input<%= fieldHasError('password_confirm') ? ' is-error' : '' %>"
                  id="register_password_confirm"
                  name="password_confirm"
                  type="password"
                  autocomplete="new-password"
                  <%= fieldHasError('password_confirm') ? 'aria-invalid="true"' : '' %>
                />
                <% if (fieldHasError('password_confirm') && formError) { %>
                <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
                <% } %>
              </div>
            </div>
          </fieldset>
          <% } %>

          <div class="bb-apex-register-form__footer">
            <div class="bb-apex-field<%= fieldHasError('consent_contact') ? ' is-error' : '' %>">
              <label class="bb-apex-register-checkbox">
                <input
                  type="checkbox"
                  name="consent_contact"
                  value="on"
                  <%= formData.consent_contact ? ' checked' : '' %>
                  required
                  <%= fieldHasError('consent_contact') ? ' aria-invalid="true"' : '' %>
                />
                <span>
                  I agree to the <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>,
                  and consent to BlessBoard contacting me about this request.
                </span>
              </label>
              <% if (fieldHasError('consent_contact') && formError) { %>
              <p class="bb-apex-register-field-error" role="alert"><%= formError %></p>
              <% } %>
            </div>

            <div class="bb-apex-register__actions">
              <button class="bb-apex-btn bb-apex-btn--primary bb-apex-register-submit" type="submit">
                <%= instantOn ? 'Create church workspace' : 'Submit registration request' %>
              </button>
              <a class="bb-apex-btn bb-apex-btn--secondary" href="/pricing">Review plans</a>
            </div>
            <p class="bb-apex-mkt-footnote">
              <% if (instantOn) { %>
              Foundation and Growth workspaces activate immediately (Growth includes a 30-day trial).
              Network requests remain pending until BlessBoard follows up.
              Callbacks are optional assistance — not required for portal access.
              <% } else { %>
              Applications remain pending until a platform administrator reviews them. No live church is created automatically.
              <% } %>
            </p>
          </div>
        </form>
        <% } %>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var form = document.querySelector("[data-bb-register-form]");
  if (!form) return;
  form.addEventListener("submit", function () {
    var btn = form.querySelector(".bb-apex-register-submit");
    if (!btn || btn.disabled) return;
    btn.disabled = true;
    btn.setAttribute("aria-busy", "true");
    btn.textContent = "Submitting…";
  });
  var nameInput = document.getElementById("register_church_name");
  var keyInput = document.getElementById("register_organization_key");
  var preview = document.querySelector("[data-bb-org-key-preview]");
  var reserved = <%- JSON.stringify((typeof reservedOrganizationKeys !== 'undefined' && reservedOrganizationKeys) || []) %>;
  function slugifyKey(raw) {
    var s = String(raw || "")
      .toLowerCase()
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")
      .replace(/-{2,}/g, "-")
      .slice(0, 64);
    if (!s) return "your-church";
    if (!/^[a-z]/.test(s)) s = ("c-" + s).slice(0, 64);
    if (reserved.indexOf(s) !== -1) {
      var alt = (s + "-church").slice(0, 64);
      if (reserved.indexOf(alt) === -1) return alt;
    }
    return s;
  }
  function syncChurchUrl() {
    if (!preview) return;
    var slug = slugifyKey(nameInput ? nameInput.value : "");
    preview.textContent = slug;
    if (keyInput) keyInput.value = slug === "your-church" ? "" : slug;
  }
  if (nameInput) {
    nameInput.addEventListener("input", syncChurchUrl);
    if (!preview || !preview.textContent || preview.textContent === "your-key" || preview.textContent === "your-church") {
      syncChurchUrl();
    }
  }
})();
</script>

