<%#
  Apex login — Stitch 09-auth-member-login desktop/mobile.
  V5 keeps apex dual-pane + email/password fields (not tenant-centered Stitch mock).
  Locals: csrfToken, error, errorState, errorTitle, emailValue, transferHostname,
          hostKind, subtitle, panelTitle, panelLead, loggedOut, passwordReset
  Raw transfer tokens must never appear in HTML. Form posts to current URL so ?tr= is preserved by the browser.
  Forgot-password is available via /forgot-password. No OAuth providers or user-controlled redirect fields.
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="referrer" content="no-referrer" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Sign in · BlessBoard</title>
  <%- include('../partials/head-design-system') %>
  <link rel="stylesheet" href="/blessboard/v5/tenant-auth.css?v=15" />
  <link rel="stylesheet" href="/blessboard/v5/apex-auth.css?v=7" />
  <link rel="stylesheet" href="/platform/gp-auth-reg.css?v=9" />
  <link rel="stylesheet" href="/activeclinic/ac-phone-field.css?v=7" />
</head>
<body
  class="bb-auth-body bb-auth-login<%= transferHostname ? ' bb-auth-login--transfer' : '' %>"
  data-bb-shell="apex-auth"
  data-bb-product="blessboard-v5"
  data-gp-product="blessboard"
  data-bb-page="login"
  data-bb-stitch-login="09-auth-member-login"
  <% if (errorState) { %>data-bb-auth-error="<%= errorState %>"<% } %>
  <% if (transferHostname) { %>data-bb-auth-transfer="1"<% } %>
>
  <a class="bb-auth-skip" href="#bb-auth-login-form">Skip to sign-in form</a>

  <div class="bb-auth-layout">
    <%- include('../../../platform/auth/login-feature-panel', {
      mode: 'desktop',
      icon: 'auto_awesome',
      title: 'Manage everything',
      lead: 'Members, events, giving, and more in one place.',
      features: [
        { icon: 'groups', text: 'Member directory and engagement tools' },
        { icon: 'event', text: 'Events and fellowship coordination' },
        { icon: 'volunteer_activism', text: 'Giving and stewardship workflows' }
      ]
    }) %>

    <main class="bb-auth-main">
      <header class="bb-auth-main__header">
        <a class="bb-auth-brand" href="/">
          <img
            class="bb-auth-brand__mark"
            src="/church/images/brand/blessboard-small-church-logo.png"
            alt=""
            width="32"
            height="32"
            decoding="async"
          />
          <span class="bb-platform-brand__lockup">
            <span class="bb-auth-brand__name">BlessBoard</span>
            <%- include('../partials/platform-brand-subtitle') %>
          </span>
        </a>
        <a class="bb-auth-main__header-link" href="/">Home</a>
      </header>

      <div class="bb-auth-main__body">
        <%- include('../../../platform/auth/login-feature-panel', {
          mode: 'mobile',
          mobileIcon: 'groups',
          mobileTitle: 'Connect with your community',
          mobileLead: 'Access sermons, events, and fellowship all in one place.'
        }) %>
        <div class="bb-auth-card bb-auth-card--login<%= transferHostname ? ' bb-auth-card--transfer' : '' %>">
          <div class="bb-auth-card__intro">
            <div class="bb-auth-card__brand-mark" aria-hidden="true">
              <img
                src="/church/images/brand/blessboard-small-church-logo.png"
                alt=""
                width="56"
                height="56"
                decoding="async"
              />
            </div>
            <h1 class="bb-auth-card__title"><%= transferHostname ? 'Member Access' : 'Welcome Back' %></h1>
            <p class="bb-auth-card__lead"><%= transferHostname ? subtitle : 'Sign in to manage your church.' %></p>
          </div>

          <% if (loggedOut) { %>
          <p class="bb-auth-success" role="status" data-bb-auth-logged-out="1">
            You have been signed out.
          </p>
          <% } %>
          <% if (typeof passwordReset !== 'undefined' && passwordReset) { %>
          <p class="bb-auth-success" role="status" data-bb-auth-password-reset="1">
            Your password was updated. Sign in with your new password.
          </p>
          <% } %>

          <% if (transferHostname) { %>
          <div
            class="bb-auth-transfer-status"
            role="status"
            data-bb-auth-transfer-host="1"
            data-bb-auth-transfer-status="continue"
          >
            <span class="material-symbols-outlined" aria-hidden="true">domain</span>
            <div class="bb-auth-transfer-status__copy">
              <p class="bb-auth-transfer-status__title">Continue sign-in for your church site</p>
              <p class="bb-auth-transfer-status__body">
                <strong class="bb-auth-transfer-status__host"><%= transferHostname %></strong>
              </p>
            </div>
          </div>
          <% } %>

          <% if (error) { %>
          <div
            class="bb-auth-error bb-auth-error--<%= errorState || 'generic' %>"
            id="bb-auth-error-summary"
            role="alert"
            tabindex="-1"
            aria-live="assertive"
            data-bb-auth-error-banner="<%= errorState || 'generic' %>"
          >
            <p class="bb-auth-error__title"><%= errorTitle %></p>
            <p class="bb-auth-error__body"><%= error %></p>
            <% if (errorState === 'credentials') { %>
            <ul class="bb-auth-error__list">
              <li><a href="#login_email">Phone or email</a></li>
              <li><a href="#password">Password</a></li>
            </ul>
            <% } %>
          </div>
          <% } %>

          <form
            method="post"
            class="bb-auth-form"
            id="bb-auth-login-form"
            tabindex="-1"
            autocomplete="on"
            data-gp-auth-identifier="1"
            data-gp-auth-id-initial="<%= typeof loginMode !== 'undefined' ? loginMode : 'email' %>"
            <% if (error) { %>aria-describedby="bb-auth-error-summary"<% } %>
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

            <%- include('../../../platform/auth/identifier-tabs', {
              loginMode: typeof loginMode !== 'undefined' ? loginMode : 'email',
              tabIdPrefix: 'bb-login-id',
              modeEmailHref: typeof modeEmailHref !== 'undefined' ? modeEmailHref : '/login?mode=email',
              modePhoneHref: typeof modePhoneHref !== 'undefined' ? modePhoneHref : '/login?mode=phone'
            }) %>

            <div
              class="gp-auth-id-panel bb-auth-field"
              id="bb-login-id-panel-email"
              role="tabpanel"
              aria-labelledby="bb-login-id-tab-email"
              data-gp-auth-id-panel="email"
              <% if (typeof loginMode !== 'undefined' && loginMode === 'phone') { %>hidden<% } %>
            >
              <label for="login_email">Email address</label>
              <div class="bb-auth-input-wrap">
                <span class="bb-auth-input-wrap__icon material-symbols-outlined" aria-hidden="true">mail</span>
                <input
                  id="login_email"
                  name="login_email"
                  type="email"
                  autocomplete="username"
                  inputmode="email"
                  placeholder="name@church.example"
                  value="<%= typeof loginEmail !== 'undefined' ? loginEmail : (emailValue || '') %>"
                  <% if (typeof loginMode === 'undefined' || loginMode !== 'phone') { %>required<% } else { %>disabled<% } %>
                  <% if (errorState === 'credentials' || errorState === 'generic' || errorState === 'throttled') { %>
                  aria-invalid="true"
                  <% } %>
                />
              </div>
              <% if (errorState === 'credentials') { %>
              <p class="bb-auth-field__error" id="email-error">Check your email or phone and try again.</p>
              <% } %>
            </div>

            <div
              class="gp-auth-id-panel bb-auth-field"
              id="bb-login-id-panel-phone"
              role="tabpanel"
              aria-labelledby="bb-login-id-tab-phone"
              data-gp-auth-id-panel="phone"
              <% if (typeof loginMode === 'undefined' || loginMode !== 'phone') { %>hidden<% } %>
            >
              <%- include('../partials/phone-field', {
                id: 'login_phone',
                label: 'Phone number',
                labelClass: '',
                required: typeof loginMode !== 'undefined' && loginMode === 'phone',
                disabled: typeof loginMode === 'undefined' || loginMode !== 'phone',
                defaultCountry: (typeof defaultPhoneCountry !== 'undefined' && defaultPhoneCountry) || 'ZM',
                selectedCountry: (typeof phoneCountry !== 'undefined' && phoneCountry) || 'ZM',
                nationalValue: (typeof loginMode !== 'undefined' && loginMode === 'phone') ? (phoneNational || '') : '',
                countries: (typeof phoneCountries !== 'undefined' && phoneCountries) || [],
                phoneValidationRelaxed: typeof phoneValidationRelaxed !== 'undefined' && phoneValidationRelaxed,
                countryFieldName: 'phone_country',
                nationalFieldName: 'phone_national',
                showLegacyHidden: false,
                showCountryName: true,
                placeholder: '97 123 4567'
              }) %>
            </div>

            <div class="bb-auth-field">
              <label for="password">Password</label>
              <div class="bb-auth-password bb-auth-input-wrap">
                <span class="bb-auth-input-wrap__icon material-symbols-outlined" aria-hidden="true">lock</span>
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  autocomplete="current-password"
                  placeholder="••••••••"
                  <% if (errorState === 'credentials' || errorState === 'generic' || errorState === 'throttled') { %>
                  aria-invalid="true"
                  aria-describedby="<%= errorState === 'credentials' ? 'password-error bb-auth-error-summary' : 'bb-auth-error-summary' %>"
                  <% } %>
                />
                <button
                  type="button"
                  class="bb-auth-password__toggle"
                  data-bb-auth-password-toggle
                  aria-controls="password"
                  aria-pressed="false"
                  aria-label="Show password"
                >
                  <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
                  <span class="bb-auth-password__toggle-label bb-auth-sr-only">Show password</span>
                </button>
              </div>
              <% if (errorState === 'credentials') { %>
              <p class="bb-auth-field__error" id="password-error">Check your password and try again.</p>
              <% } %>
              <p class="bb-auth-field__hint">
                <a href="/forgot-password" data-bb-auth-forgot="1">Forgot password?</a>
              </p>
            </div>

            <div class="bb-auth-actions">
              <button class="bb-auth-btn bb-auth-btn--primary" type="submit">
                <span class="material-symbols-outlined" aria-hidden="true">login</span>
                Sign in
              </button>
            </div>
          </form>

          <% if (!transferHostname) { %>
          <p class="bb-auth-register-hint">
            Don't have an account? <a href="/register-church">Register church</a>
          </p>
          <% } %>

          <p class="bb-auth-footnote">
            <span class="material-symbols-outlined" aria-hidden="true">verified_user</span>
            Access to church workspaces follows your BlessBoard roles after sign-in.
            <% if (transferHostname) { %>
            Passwords are never collected on the church hostname.
            <% } %>
          </p>
        </div>
      </div>

      <footer class="bb-auth-footer">
        <%- include('../partials/powered-by-getpro') %>
      </footer>
    </main>
  </div>

  <script src="/blessboard/v5/design-system.js?v=3" defer></script>
  <script src="/blessboard/v5/tenant-auth.js?v=2" defer></script>
  <script src="/platform/gp-auth-reg.js?v=11" defer></script>
  <script src="/activeclinic/ac-phone-field.js?v=7" defer></script>
</body>
</html>
