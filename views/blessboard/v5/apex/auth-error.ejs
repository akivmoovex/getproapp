<%#
  Apex / tenant auth error — callback failure, expired/consumed/unauthorized transfer.
  Locals: message, errorState, pageTitle
  Never includes transfer tokens, session tokens, tenant secrets, or user-controlled redirect URLs.
  STITCH_MISSING — reuses apex dual-pane auth chrome with safe generic wording.
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="referrer" content="no-referrer" />
  <meta name="robots" content="noindex, nofollow" />
  <title><%= pageTitle || 'Sign in' %> · BlessBoard</title>
  <%- include('../partials/head-design-system') %>
  <link rel="stylesheet" href="/blessboard/v5/tenant-auth.css?v=10" />
  <link rel="stylesheet" href="/blessboard/v5/apex-auth.css?v=5" />
</head>
<body
  class="bb-auth-body bb-auth-login bb-auth-error-page"
  data-bb-shell="apex-auth"
  data-bb-product="blessboard-v5"
  data-bb-page="auth-error"
  data-bb-auth-error="<%= errorState || 'generic' %>"
>
<%
  var icon = 'error';
  var badge = 'Sign-in issue';
  if (errorState === 'expired') { icon = 'schedule'; badge = 'Link expired'; }
  else if (errorState === 'consumed') { icon = 'link_off'; badge = 'Link already used'; }
  else if (errorState === 'unauthorized') { icon = 'block'; badge = 'Access unavailable'; }
  else if (errorState === 'throttled') { icon = 'hourglass_top'; badge = 'Please wait'; }
%>
  <a class="bb-auth-skip" href="#bb-auth-error-main">Skip to content</a>
  <div class="bb-auth-layout">
    <aside class="bb-auth-panel" aria-hidden="true">
      <div class="bb-auth-panel__inner">
        <p class="bb-auth-panel__eyebrow">
          <span class="material-symbols-outlined" aria-hidden="true">shield</span>
          Secure sign-in
        </p>
        <p class="bb-auth-panel__title">We could not continue</p>
        <p class="bb-auth-panel__lead">
          Sign-in links are single-use and short-lived. Start again from your church site when needed.
        </p>
      </div>
    </aside>

    <div class="bb-auth-main" id="bb-auth-error-main">
      <header class="bb-auth-main__header">
        <a class="bb-auth-brand" href="/">
          <img
            class="bb-auth-brand__mark"
            src="/church/images/brand/blessboard-small-church-logo.png"
            alt=""
            width="32"
            height="32"
            decoding="async"
          />
          <span class="bb-auth-brand__name">BlessBoard</span>
        </a>
        <a class="bb-auth-main__header-link" href="/">Home</a>
      </header>

      <div class="bb-auth-main__body">
        <div
          class="bb-auth-card bb-auth-card--error bb-auth-card--error-<%= errorState || 'generic' %>"
          id="bb-auth-error-card"
          data-bb-auth-error-card="<%= errorState || 'generic' %>"
        >
          <p class="bb-auth-badge bb-auth-badge--error" data-bb-auth-error-badge="1">
            <span class="material-symbols-outlined" aria-hidden="true"><%= icon %></span>
            <%= badge %>
          </p>
          <div class="bb-auth-card__icon bb-auth-card__icon--error" aria-hidden="true">
            <span class="material-symbols-outlined"><%= icon %></span>
          </div>
          <h1 class="bb-auth-card__title"><%= pageTitle %></h1>
          <div
            class="bb-auth-error bb-auth-error--<%= errorState || 'generic' %>"
            id="bb-auth-error-summary"
            role="alert"
            tabindex="-1"
            aria-live="assertive"
          >
            <p class="bb-auth-error__body"><%= message %></p>
          </div>
          <p class="bb-auth-card__lead bb-auth-error-hint">
            <% if (errorState === 'unauthorized') { %>
            Sign in from your church site only if your account is authorized for that congregation.
            <% } else if (errorState === 'expired' || errorState === 'consumed') { %>
            Start sign-in again from your church site’s Login link. Sign-in links are single-use and short-lived.
            <% } else if (errorState === 'throttled') { %>
            Wait a few minutes, then try again from your church site’s Login link.
            <% } else { %>
            You can try again, or return home.
            <% } %>
          </p>
          <div class="bb-auth-actions bb-auth-actions--stack">
            <a class="bb-auth-btn bb-auth-btn--primary" href="/login">Try again</a>
            <a class="bb-auth-btn bb-auth-btn--ghost" href="/">Home</a>
          </div>
        </div>
      </div>

      <footer class="bb-auth-footer">
        <%- include('../partials/powered-by-getpro') %>
      </footer>
    </div>
  </div>
  <script src="/blessboard/v5/design-system.js?v=2" defer></script>
</body>
</html>
