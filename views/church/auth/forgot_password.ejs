<%- include('../partials/auth_shell_start', { authBodyClass: 'church-body--auth-forgot' }) %>
  <div class="church-auth-stage church-auth-stage--forgot">
    <div class="church-auth-forgot-layout">
      <div class="church-auth-forgot__visual home-desktop-design" aria-hidden="true">
        <img src="/church/images/auth/forgot-password.jpg" alt=""/>
      </div>

      <div class="church-auth-card church-auth-card--stitch church-auth-forgot" data-auth-screen="forgot-password">
        <div class="church-auth-forgot__icon" aria-hidden="true">
          <span class="material-symbols-outlined">lock_reset</span>
        </div>
        <h1 class="church-auth-card__title">Forgot Password?</h1>
        <p class="church-auth-card__subtitle">
          Enter your details and we will submit a password reset request for branch leadership to review.
          If a matching member account is found, they will contact you.
        </p>

        <% if (error) { %>
        <div class="church-alert church-alert--error" role="alert"><%= error %></div>
        <% } %>

        <form class="church-auth-form" method="post" action="/forgot-password">
          <div class="church-auth-field">
            <label class="church-auth-label" for="identifier">Email or Phone Number</label>
            <div class="church-auth-input-wrap">
              <span class="material-symbols-outlined church-auth-input-wrap__icon" aria-hidden="true">alternate_email</span>
              <input class="church-auth-input" id="identifier" name="identifier" type="text" autocomplete="username" required maxlength="120" placeholder="name@example.com" value="<%= typeof form !== 'undefined' && form.identifier ? form.identifier : '' %>"/>
            </div>
          </div>
          <div class="church-auth-field">
            <label class="church-auth-label" for="full_name">Full name <span class="church-label__optional">(optional)</span></label>
            <input class="church-auth-input church-auth-input--plain" id="full_name" name="full_name" type="text" maxlength="150" value="<%= typeof form !== 'undefined' && form.full_name ? form.full_name : '' %>"/>
          </div>
          <div class="church-auth-field">
            <label class="church-auth-label" for="phone">Phone <span class="church-label__optional">(optional)</span></label>
            <input class="church-auth-input church-auth-input--plain" id="phone" name="phone" type="tel" value="<%= typeof form !== 'undefined' && form.phone ? form.phone : '' %>"/>
          </div>
          <div class="church-auth-field">
            <label class="church-auth-label" for="email">Email <span class="church-label__optional">(optional)</span></label>
            <input class="church-auth-input church-auth-input--plain" id="email" name="email" type="email" maxlength="254" value="<%= typeof form !== 'undefined' && form.email ? form.email : '' %>"/>
          </div>

          <button class="church-btn church-btn--primary church-btn--block church-auth-submit" type="submit">
            Submit Reset Request
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </button>
        </form>

        <p class="church-auth-card__footer">
          <a class="church-auth-link" href="/login">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
            Back to Login
          </a>
        </p>

        <div class="church-auth-forgot__tips home-mobile-design">
          <div class="church-auth-tip">
            <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
            <div>
              <strong>Fast Response</strong>
              <p>Branch leadership usually reviews reset requests within 1–2 business days.</p>
            </div>
          </div>
          <div class="church-auth-tip">
            <span class="material-symbols-outlined" aria-hidden="true">admin_panel_settings</span>
            <div>
              <strong>Need help sooner?</strong>
              <p><a href="/contact">Contact branch admin</a> if you need urgent access.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<%- include('../partials/auth_shell_end') %>
