<%- include('../partials/auth_shell_start', { authBodyClass: 'church-body--auth-waiting' }) %>
  <div class="church-auth-stage">
    <div class="church-auth-card church-auth-card--stitch church-auth-card--state church-auth-waiting" data-auth-screen="waiting-verification">
      <div class="church-auth-waiting__visual home-mobile-design">
        <img src="/church/images/auth/waiting-verification.jpg" alt="" width="1024" height="559"/>
      </div>

      <div class="church-auth-waiting__icon" aria-hidden="true">
        <span class="material-symbols-outlined">pending_actions</span>
      </div>

      <h1 class="church-auth-card__title home-desktop-design">Verification in Progress</h1>
      <h1 class="church-auth-card__title home-mobile-design">Pending Verification</h1>
      <span class="church-auth-badge church-auth-badge--pending">Account Pending</span>

      <p class="church-auth-card__subtitle">
        Hello<%= typeof memberName !== 'undefined' && memberName ? ', ' + memberName : '' %> —
        thank you for registering with <strong><%= churchName %></strong>. Your membership application is being reviewed.
      </p>

      <div class="church-auth-waiting__grid">
        <div class="church-auth-waiting__cell">
          <span class="church-auth-waiting__label">Assigned Branch</span>
          <div class="church-auth-waiting__box">
            <span class="material-symbols-outlined" aria-hidden="true">church</span>
            <div>
              <strong><%= churchName %></strong>
              <% if (branch && branch.location_text) { %>
              <span><%= branch.location_text %></span>
              <% } %>
            </div>
          </div>
        </div>
        <div class="church-auth-waiting__cell">
          <span class="church-auth-waiting__label">Status</span>
          <div class="church-auth-waiting__box">
            <span class="material-symbols-outlined" aria-hidden="true">verified_user</span>
            <div>
              <strong>Verification in Progress</strong>
              <span>Usually 24–48 business hours</span>
            </div>
          </div>
        </div>
      </div>

      <div class="church-auth-next-steps church-auth-next-steps--list">
        <div class="church-auth-next-steps__title">
          <span class="material-symbols-outlined" aria-hidden="true">info</span>
          What happens next?
        </div>
        <ol class="church-auth-steps">
          <li>Our administrative team is reviewing your membership details.</li>
          <li>A branch representative may contact you if additional information is required.</li>
          <li>Once verified, you will receive confirmation and full member portal access.</li>
        </ol>
      </div>

      <div class="church-auth-card__actions church-auth-card__actions--pair">
        <a class="church-btn church-btn--primary" href="/contact">
          <span class="material-symbols-outlined" aria-hidden="true">contact_support</span>
          Contact Branch
        </a>
        <a class="church-btn church-btn--outline" href="/">
          <span class="material-symbols-outlined" aria-hidden="true">home</span>
          Return Home
        </a>
      </div>

      <form class="church-auth-waiting__logout" method="post" action="/logout">
        <button class="church-btn church-btn--ghost church-btn--block" type="submit">Sign out</button>
      </form>

      <p class="church-auth-card__footer church-auth-waiting__note">
        Verification usually takes between 24–48 business hours.
      </p>
    </div>
  </div>
<%- include('../partials/auth_shell_end') %>
