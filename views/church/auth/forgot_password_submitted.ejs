<%- include('../partials/auth_shell_start', { authBodyClass: 'church-body--auth-forgot' }) %>
  <div class="church-auth-stage">
    <div class="church-auth-card church-auth-card--stitch church-auth-card--state church-auth-forgot" data-auth-screen="forgot-password-submitted">
      <div class="church-auth-forgot__icon church-auth-forgot__icon--success" aria-hidden="true">
        <span class="material-symbols-outlined">check_circle</span>
      </div>
      <h1 class="church-auth-card__title">Request submitted</h1>
      <p class="church-auth-card__subtitle"><%= successMessage %></p>
      <div class="church-auth-card__actions church-auth-card__actions--pair">
        <a class="church-btn church-btn--primary" href="/login">Back to member login</a>
        <a class="church-btn church-btn--outline" href="/">Return home</a>
      </div>
    </div>
  </div>
<%- include('../partials/auth_shell_end') %>
