<%- include('../partials/hq_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <a class="church-branch-back" href="/hq/giving-summary">&larr; Back to giving summaries</a>
          <h1 class="church-branch-topbar__title">Giving summary — <%= summary.period_label %></h1>
          <p class="church-branch-topbar__subtitle"><%= churchName %><% if (summary.branch_name) { %> · <%= summary.branch_name %><% } %></p>
        </div>
      </header>
      <div class="church-alert church-alert--info" role="note">
        HQ view is read-only. Branch admins record and submit monthly giving summaries.
      </div>
      <section class="church-branch-panel">
        <h2 class="church-branch-panel__title">Summary totals (<%= summary.currency_code || 'ZMW' %>)</h2>
        <dl class="church-branch-dl">
          <div><dt>Tithes</dt><dd><%= formatMoney(summary.tithes_total) %></dd></div>
          <div><dt>Offerings</dt><dd><%= formatMoney(summary.offerings_total) %></dd></div>
          <div><dt>Building fund</dt><dd><%= formatMoney(summary.building_fund_total) %></dd></div>
          <div><dt>Missions fund</dt><dd><%= formatMoney(summary.missions_fund_total) %></dd></div>
          <div><dt>Special offerings</dt><dd><%= formatMoney(summary.special_offerings_total) %></dd></div>
          <div><dt>Other giving</dt><dd><%= formatMoney(summary.other_giving_total) %></dd></div>
          <div><dt>Grand total</dt><dd><strong><%= formatMoney(summary.grand_total) %></strong></dd></div>
          <div><dt>Status</dt><dd><span class="church-status-chip church-status-chip--<%= summary.status === 'draft' ? 'pending' : 'verified' %>"><%= summary.status_label || summary.status %></span></dd></div>
        </dl>
        <% if (summary.notes) { %>
        <div class="church-branch-review-note">
          <strong>Notes</strong>
          <p><%= summary.notes %></p>
        </div>
        <% } %>
      </section>
<%- include('../partials/hq_shell_end') %>
