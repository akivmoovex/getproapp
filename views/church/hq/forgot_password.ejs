<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= pageTitle %> — HQ Admin Forgot Password</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=40"/>
</head>
<body class="church-body church-body--auth">
  <header class="church-header church-header--auth">
    <div class="church-header__inner">
      <%- include('../partials/brand_lockup') %>
    </div>
  </header>
  <main class="church-auth-main">
    <div class="church-auth-card">
      <p class="church-eyebrow">HQ admin</p>
      <h1 class="church-auth-card__title">Forgot password</h1>
      <p class="church-auth-card__subtitle">
        Submit a password reset request for <%= organizationName %>. GetPro support will review your details.
      </p>
      <% if (error) { %>
      <div class="church-alert church-alert--error" role="alert"><%= error %></div>
      <% } %>
      <form class="church-form" method="post" action="/hq/forgot-password">
        <div class="church-field">
          <label class="church-label" for="identifier">Email or phone</label>
          <input class="church-input" id="identifier" name="identifier" type="text" autocomplete="username" required maxlength="120" value="<%= typeof form !== 'undefined' && form.identifier ? form.identifier : '' %>"/>
        </div>
        <div class="church-field">
          <label class="church-label" for="full_name">Full name <span class="church-label__optional">(optional)</span></label>
          <input class="church-input" id="full_name" name="full_name" type="text" maxlength="150" value="<%= typeof form !== 'undefined' && form.full_name ? form.full_name : '' %>"/>
        </div>
        <div class="church-field">
          <label class="church-label" for="phone">Phone <span class="church-label__optional">(optional)</span></label>
          <input class="church-input" id="phone" name="phone" type="tel" value="<%= typeof form !== 'undefined' && form.phone ? form.phone : '' %>"/>
        </div>
        <div class="church-field">
          <label class="church-label" for="email">Email <span class="church-label__optional">(optional)</span></label>
          <input class="church-input" id="email" name="email" type="email" maxlength="254" value="<%= typeof form !== 'undefined' && form.email ? form.email : '' %>"/>
        </div>
        <button class="church-btn church-btn--primary church-btn--block" type="submit">Submit request</button>
      </form>
      <p class="church-auth-card__footer">
        <a href="/hq/login">Back to HQ admin login</a>
      </p>
    </div>
  </main>
</body>
</html>
