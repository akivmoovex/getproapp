<%- include('../partials/hq_shell_start') %>
      <header class="church-hq-page-header" data-hq-audit-detail-header>
        <div>
          <a class="church-branch-back" href="/hq/audit">&larr; Back to audit trail</a>
          <h1 class="church-hq-page-header__title">Audit detail</h1>
          <p class="church-hq-page-header__subtitle">Event #<%= log.id %></p>
        </div>
      </header>
      <section class="church-branch-panel church-hq-panel" data-hq-audit-detail>
        <div class="church-hq-audit-detail-badges">
          <span class="church-hq-action-badge"><%= actionLabel(log.action) %></span>
          <span class="church-hq-actor-type"><%= actorTypeLabel(log.actor_type) %></span>
        </div>
        <dl class="church-branch-dl church-hq-meta-dl">
          <div><dt>Event ID</dt><dd><%= log.id %></dd></div>
          <div><dt>Organization</dt><dd class="church-hq-wrap"><%= log.organization_name || organizationName %></dd></div>
          <div><dt>Branch</dt><dd class="church-hq-wrap"><%= log.branch_name || '—' %></dd></div>
          <div><dt>Action</dt><dd><%= actionLabel(log.action) %></dd></div>
          <div><dt>Actor type</dt><dd><%= actorTypeLabel(log.actor_type) %></dd></div>
          <div><dt>Actor ID</dt><dd><%= log.actor_id != null ? log.actor_id : '—' %></dd></div>
          <div><dt>Actor label</dt><dd class="church-hq-wrap"><%= actorDisplayFromRow(log) %></dd></div>
          <div><dt>Entity type</dt><dd><%= targetTypeLabel(log.entity_type) %></dd></div>
          <div><dt>Entity ID</dt><dd><%= entityIdentifierFromRow(log) %></dd></div>
          <div><dt>Entity label</dt><dd class="church-hq-wrap"><%= targetLabelFromRow(log) %></dd></div>
          <div><dt>Package / entitlement</dt><dd class="church-hq-wrap"><%= packageChangeFromRow(log) %></dd></div>
          <div><dt>Reason</dt><dd class="church-hq-wrap"><%= reasonFromRow(log) %></dd></div>
          <div><dt>Result</dt><dd class="church-hq-wrap"><%= resultFromRow(log) %></dd></div>
          <div><dt>Timestamp</dt><dd><time datetime="<%= new Date(log.created_at).toISOString() %>"><%= new Date(log.created_at).toLocaleString('en-GB') %></time></dd></div>
          <% if (log.ip_address) { %><div><dt>IP address</dt><dd class="church-hq-wrap"><%= log.ip_address %></dd></div><% } %>
          <% if (log.user_agent) { %><div><dt>User agent</dt><dd class="church-hq-wrap"><%= log.user_agent %></dd></div><% } %>
        </dl>
        <h2 class="church-branch-panel__title">Metadata</h2>
        <pre class="church-audit-metadata church-hq-wrap" data-hq-audit-metadata><%= metadataDisplay %></pre>
      </section>
<%- include('../partials/hq_shell_end') %>
