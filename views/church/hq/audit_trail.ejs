<%- include('../partials/hq_shell_start') %>
      <header class="church-hq-page-header" data-hq-audit-header>
        <div>
          <p class="church-hq-page-header__eyebrow"><%= organizationName %></p>
          <h1 class="church-hq-page-header__title">Global audit trail</h1>
          <p class="church-hq-page-header__subtitle">Organization-wide activity log</p>
        </div>
        <% if (typeof canExport !== 'undefined' && canExport && exportUrl) { %>
        <div>
          <a class="church-btn church-btn--ghost" href="<%= exportUrl %>">Export CSV</a>
        </div>
        <% } %>
      </header>

      <form class="church-form church-hq-filter-panel" method="get" action="/hq/audit" data-hq-audit-filters>
        <div class="church-hq-filter-panel__grid">
          <div class="church-field church-field--grow">
            <label class="church-label" for="q">Search</label>
            <input class="church-input" id="q" name="q" type="search" value="<%= filters.q || '' %>" placeholder="Action, target, metadata"/>
          </div>
          <div class="church-field">
            <label class="church-label" for="branch_id">Branch</label>
            <select class="church-input" id="branch_id" name="branch_id">
              <option value="">All branches</option>
              <% (branches || []).forEach(function (b) { %>
              <option value="<%= b.id %>" <%= filters.branchId === b.id ? 'selected' : '' %>><%= b.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="church-field">
            <label class="church-label" for="action_group">Action group</label>
            <select class="church-input" id="action_group" name="action_group">
              <% auditActionGroups.forEach(function (g) { %>
              <option value="<%= g.id %>" <%= filters.actionGroup === g.id ? 'selected' : '' %>><%= g.label %></option>
              <% }); %>
            </select>
          </div>
          <div class="church-field">
            <label class="church-label" for="action">Action type</label>
            <input class="church-input" id="action" name="action" type="text" value="<%= filters.action || '' %>" placeholder="e.g. member_verified_by_admin"/>
          </div>
          <div class="church-field">
            <label class="church-label" for="actor_type">Actor type</label>
            <select class="church-input" id="actor_type" name="actor_type">
              <option value="">All</option>
              <% auditActorTypes.forEach(function (t) { %>
              <option value="<%= t %>" <%= filters.actorType === t ? 'selected' : '' %>><%= actorTypeLabel(t) %></option>
              <% }); %>
            </select>
          </div>
          <div class="church-field">
            <label class="church-label" for="actor_id">User (actor ID)</label>
            <input class="church-input" id="actor_id" name="actor_id" type="number" min="1" value="<%= filters.actorId || '' %>" placeholder="Actor ID"/>
          </div>
          <div class="church-field">
            <label class="church-label" for="target_type">Target type</label>
            <input class="church-input" id="target_type" name="target_type" type="text" value="<%= filters.targetType || '' %>" placeholder="e.g. member"/>
          </div>
          <div class="church-field">
            <label class="church-label" for="date_from">From</label>
            <input class="church-input" id="date_from" name="date_from" type="date" value="<%= filters.dateFrom || '' %>"/>
          </div>
          <div class="church-field">
            <label class="church-label" for="date_to">To</label>
            <input class="church-input" id="date_to" name="date_to" type="date" value="<%= filters.dateTo || '' %>"/>
          </div>
        </div>
        <div class="church-hq-filter-panel__actions">
          <button class="church-btn church-btn--primary" type="submit">Apply filters</button>
          <a class="church-btn church-btn--ghost" href="/hq/audit">Clear</a>
        </div>
      </form>

      <section class="church-branch-panel church-hq-panel" data-hq-audit-list>
        <div class="church-hq-panel__meta">
          <p class="church-branch-panel__hint"><%= total %> event(s) · page <%= filters.page %> of <%= totalPages %></p>
        </div>
        <% if ((logs || []).length === 0) { %>
          <p class="church-branch-empty" data-hq-empty="audit">No audit events match these filters.</p>
        <% } else { %>
          <div class="church-branch-table-wrap church-show-desktop-only" data-hq-audit-desktop>
            <table class="church-branch-table church-audit-table">
              <thead>
                <tr>
                  <th scope="col">Timestamp</th>
                  <th scope="col">Branch</th>
                  <th scope="col">Acting user</th>
                  <th scope="col">Action</th>
                  <th scope="col">Entity type</th>
                  <th scope="col">Entity ID</th>
                  <th scope="col">Package</th>
                  <th scope="col">Reason</th>
                  <th scope="col">Result</th>
                  <th scope="col">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% logs.forEach(function (log) { %>
                <tr>
                  <td><time datetime="<%= new Date(log.created_at).toISOString() %>"><%= new Date(log.created_at).toLocaleString('en-GB') %></time></td>
                  <td class="church-hq-wrap"><%= log.branch_name || '—' %></td>
                  <td>
                    <span class="church-hq-actor-type"><%= actorTypeLabel(log.actor_type) %></span>
                    <span class="church-hq-wrap church-hq-muted"><%= actorDisplayFromRow(log) %></span>
                  </td>
                  <td><span class="church-hq-action-badge"><%= actionLabel(log.action) %></span></td>
                  <td class="church-hq-wrap"><%= targetTypeLabel(log.entity_type) %></td>
                  <td class="church-hq-wrap church-hq-muted"><%= entityIdentifierFromRow(log) %></td>
                  <td class="church-hq-wrap"><%= packageChangeFromRow(log) %></td>
                  <td class="church-hq-wrap"><%= reasonFromRow(log) %></td>
                  <td class="church-hq-wrap"><%= resultFromRow(log) %></td>
                  <td><a class="church-btn church-btn--ghost church-btn--sm" href="/hq/audit/<%= log.id %>" aria-label="View audit event <%= actionLabel(log.action) %> at <%= new Date(log.created_at).toLocaleString('en-GB') %>">View</a></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <ul class="church-hq-audit-cards church-show-mobile-only" data-hq-audit-mobile>
            <% logs.forEach(function (log) { %>
            <li class="church-hq-audit-card">
              <div class="church-hq-audit-card__top">
                <span class="church-hq-action-badge"><%= actionLabel(log.action) %></span>
                <time class="church-hq-muted" datetime="<%= new Date(log.created_at).toISOString() %>"><%= new Date(log.created_at).toLocaleString('en-GB') %></time>
              </div>
              <p class="church-hq-audit-card__actor church-hq-wrap">
                <strong><%= actorDisplayFromRow(log) %></strong>
                <span class="church-hq-muted"><%= actorTypeLabel(log.actor_type) %><% if (log.branch_name) { %> · <%= log.branch_name %><% } %></span>
              </p>
              <p class="church-hq-audit-card__target church-hq-wrap">
                Entity type: <%= targetTypeLabel(log.entity_type) %> · Entity ID: <%= entityIdentifierFromRow(log) %>
              </p>
              <p class="church-hq-audit-card__summary church-hq-wrap"><%= auditSummary(log) %></p>
              <a class="church-member-link" href="/hq/audit/<%= log.id %>">View detail</a>
            </li>
            <% }); %>
          </ul>

          <% if (totalPages > 1) { %>
          <div class="church-hq-pagination" data-hq-audit-pagination>
            <% if (prevUrl) { %>
            <a class="church-btn church-btn--outline church-btn--sm" href="<%= prevUrl %>">Previous</a>
            <% } %>
            <span class="church-hq-pagination__status">Page <%= filters.page %> of <%= totalPages %></span>
            <% if (nextUrl) { %>
            <a class="church-btn church-btn--outline church-btn--sm" href="<%= nextUrl %>">Next</a>
            <% } %>
          </div>
          <% } %>
        <% } %>
      </section>
<%- include('../partials/hq_shell_end') %>
