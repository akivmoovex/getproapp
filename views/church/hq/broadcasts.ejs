<%- include('../partials/hq_shell_start') %>
      <header class="church-hq-page-header" data-hq-broadcasts-header>
        <div>
          <p class="church-hq-page-header__eyebrow"><%= organizationName %></p>
          <h1 class="church-hq-page-header__title">Broadcast Center</h1>
          <p class="church-hq-page-header__subtitle">Create and publish organization-wide announcements</p>
        </div>
        <a class="church-btn church-btn--primary" href="/hq/broadcasts/new">New broadcast</a>
      </header>
      <%- include('../partials/plan_premium_notice', { premiumNotice: typeof premiumNotice !== 'undefined' ? premiumNotice : null }) %>
      <% if (notice) { %>
      <div class="church-alert church-alert--success" role="status" data-hq-broadcast-notice><%= notice %></div>
      <% } %>
      <% var lf = typeof listFilters !== 'undefined' && listFilters ? listFilters : { status: statusFilter || 'all', q: searchQuery || '', priority: '', audience: '', target_scope: '', date_from: '', date_to: '', page: page || 1 }; %>

      <form class="church-form church-hq-filter-panel" method="get" action="/hq/broadcasts" data-hq-broadcast-filters>
        <div class="church-hq-filter-panel__grid">
          <div class="church-field church-field--grow">
            <label class="church-label" for="q">Search</label>
            <input class="church-input" id="q" name="q" type="search" value="<%= lf.q || '' %>" placeholder="Title or body"/>
          </div>
          <div class="church-field">
            <label class="church-label" for="priority">Priority</label>
            <select class="church-input" id="priority" name="priority">
              <option value="">All priorities</option>
              <% (priorities || []).forEach(function (p) { %>
              <option value="<%= p %>" <%= lf.priority === p ? 'selected' : '' %>><%= priorityLabel(p) %></option>
              <% }); %>
            </select>
          </div>
          <div class="church-field">
            <label class="church-label" for="audience">Audience</label>
            <select class="church-input" id="audience" name="audience">
              <option value="">All audiences</option>
              <% (audiences || []).forEach(function (a) { %>
              <option value="<%= a %>" <%= lf.audience === a ? 'selected' : '' %>><%= broadcastAudienceLabel(a) %></option>
              <% }); %>
            </select>
          </div>
          <div class="church-field">
            <label class="church-label" for="target_scope">Target scope</label>
            <select class="church-input" id="target_scope" name="target_scope">
              <option value="">All scopes</option>
              <% (targetScopes || []).forEach(function (s) { %>
              <option value="<%= s %>" <%= lf.target_scope === s ? 'selected' : '' %>><%= targetScopeLabel(s) %></option>
              <% }); %>
            </select>
          </div>
          <div class="church-field">
            <label class="church-label" for="date_from">From date</label>
            <input class="church-input" id="date_from" name="date_from" type="date" value="<%= lf.date_from || '' %>"/>
          </div>
          <div class="church-field">
            <label class="church-label" for="date_to">To date</label>
            <input class="church-input" id="date_to" name="date_to" type="date" value="<%= lf.date_to || '' %>"/>
          </div>
        </div>
        <% if (lf.status && lf.status !== 'all') { %>
        <input type="hidden" name="status" value="<%= lf.status %>"/>
        <% } %>
        <div class="church-hq-filter-panel__actions">
          <button class="church-btn church-btn--outline" type="submit">Apply filters</button>
          <a class="church-btn church-btn--ghost" href="/hq/broadcasts">Clear</a>
        </div>
      </form>

      <div class="church-branch-filter-tabs" data-hq-broadcast-status-tabs>
        <% broadcastFilters.forEach(function (f) { %>
        <a class="church-branch-filter-tab <%= lf.status === f ? 'church-branch-filter-tab--active' : '' %>" href="/hq/broadcasts<%= buildListQuery(Object.assign({}, lf, { status: f }), 1) %>"><%= f === 'all' ? 'All' : broadcastStatusLabel(f) %></a>
        <% }); %>
      </div>

      <section class="church-branch-panel church-hq-panel" data-hq-broadcast-list>
        <p class="church-branch-panel__hint"><%= totalCount %> broadcast(s) · page <%= page %> of <%= totalPages %></p>
        <% if ((broadcasts || []).length === 0) { %>
          <p class="church-branch-empty" data-hq-empty="broadcasts">No broadcasts in this filter.</p>
        <% } else { %>
          <div class="church-branch-table-wrap church-show-desktop-only" data-hq-broadcast-desktop>
            <table class="church-branch-table">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Priority</th>
                  <th>Audience</th>
                  <th>Target</th>
                  <th>Status</th>
                  <th>Publish</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% broadcasts.forEach(function (b) { %>
                <tr>
                  <td>
                    <strong class="church-hq-wrap"><%= b.title %></strong>
                    <span class="church-hq-broadcast-flags">
                      <% if (b.is_featured) { %><span class="church-hq-flag church-hq-flag--featured">Featured</span><% } %>
                      <% if (b.is_pinned) { %><span class="church-hq-flag church-hq-flag--pinned">Pinned</span><% } %>
                    </span>
                    <span class="church-hq-muted church-hq-wrap"><%= b.category %></span>
                  </td>
                  <td><span class="church-hq-priority church-hq-priority--<%= b.priority || 'normal' %>"><%= priorityLabel(b.priority || 'normal') %></span></td>
                  <td class="church-hq-wrap"><%= broadcastAudienceLabel(b.audience) %></td>
                  <td class="church-hq-wrap"><%= targetScopeLabel(b.target_scope) %> · <%= b.target_scope === 'all_branches' ? 'All' : (b.target_branch_count || 0) %></td>
                  <td>
                    <span class="church-hq-status church-hq-status--<%= b.status %>">
                      <span class="church-hq-status__dot" aria-hidden="true"></span>
                      <span class="church-hq-status__label"><%= broadcastStatusLabel(b.status) %></span>
                    </span>
                  </td>
                  <td><%= b.publish_at ? new Date(b.publish_at).toLocaleDateString('en-GB') : '—' %></td>
                  <td>
                    <a class="church-btn church-btn--ghost church-btn--sm" href="/hq/broadcasts/<%= b.id %>">View</a>
                    <% if (b.status !== 'archived') { %>
                    <a class="church-btn church-btn--ghost church-btn--sm" href="/hq/broadcasts/<%= b.id %>/edit">Edit</a>
                    <% } %>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <ul class="church-hq-broadcast-cards church-show-mobile-only" data-hq-broadcast-mobile>
            <% broadcasts.forEach(function (b) { %>
            <li class="church-hq-broadcast-card">
              <div class="church-hq-broadcast-card__top">
                <span class="church-hq-status church-hq-status--<%= b.status %>">
                  <span class="church-hq-status__dot" aria-hidden="true"></span>
                  <span class="church-hq-status__label"><%= broadcastStatusLabel(b.status) %></span>
                </span>
                <span class="church-hq-priority church-hq-priority--<%= b.priority || 'normal' %>"><%= priorityLabel(b.priority || 'normal') %></span>
              </div>
              <h2 class="church-hq-broadcast-card__title church-hq-wrap"><%= b.title %></h2>
              <p class="church-hq-muted church-hq-wrap">
                <%= broadcastAudienceLabel(b.audience) %> · <%= targetScopeLabel(b.target_scope) %>
                <% if (b.is_featured) { %> · Featured<% } %>
                <% if (b.is_pinned) { %> · Pinned<% } %>
              </p>
              <p class="church-hq-muted"><%= b.publish_at ? new Date(b.publish_at).toLocaleDateString('en-GB') : 'No publish date' %></p>
              <div class="church-hq-broadcast-card__actions">
                <a class="church-btn church-btn--outline church-btn--sm" href="/hq/broadcasts/<%= b.id %>">View</a>
                <% if (b.status !== 'archived') { %>
                <a class="church-btn church-btn--ghost church-btn--sm" href="/hq/broadcasts/<%= b.id %>/edit">Edit</a>
                <% } %>
              </div>
            </li>
            <% }); %>
          </ul>

          <% if (totalPages > 1) { %>
          <div class="church-hq-pagination" data-hq-broadcast-pagination>
            <% if (page > 1) { %>
            <a class="church-btn church-btn--outline church-btn--sm" href="/hq/broadcasts<%= buildListQuery(lf, page - 1) %>">Previous</a>
            <% } %>
            <span class="church-hq-pagination__status">Page <%= page %> of <%= totalPages %></span>
            <% if (page < totalPages) { %>
            <a class="church-btn church-btn--outline church-btn--sm" href="/hq/broadcasts<%= buildListQuery(lf, page + 1) %>">Next</a>
            <% } %>
          </div>
          <% } %>
        <% } %>
      </section>
<%- include('../partials/hq_shell_end') %>
