<%- include('../partials/hq_shell_start') %>
      <section class="church-branch-panel church-branch-panel--glass">
        <% if (packageFeatureUi.state === 'upgrade') { %>
          <%- include('../partials/package_feature_upgrade', { packageFeatureUi: packageFeatureUi }) %>
        <% } else if (packageFeatureUi.state === 'available') { %>
          <%- include('../partials/package_feature_available', { packageFeatureUi: packageFeatureUi }) %>
        <% } else { %>
          <%- include('../partials/package_feature_unavailable', { packageFeatureUi: packageFeatureUi }) %>
        <% } %>
      </section>
<%- include('../partials/hq_shell_end') %>
