<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= pageTitle %> — Request Submitted</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=31"/>
</head>
<body class="church-body church-body--auth">
  <header class="church-header church-header--auth">
    <div class="church-header__inner">
      <%- include('../partials/brand_lockup') %>
    </div>
  </header>
  <main class="church-auth-main">
    <div class="church-auth-card church-auth-card--state">
      <div class="church-state-icon" aria-hidden="true">
        <span class="material-symbols-outlined">lock_reset</span>
      </div>
      <h1 class="church-auth-card__title">Request submitted</h1>
      <p class="church-auth-card__subtitle"><%= successMessage %></p>
      <div class="church-auth-card__actions">
        <a class="church-btn church-btn--primary" href="/hq/login">Back to HQ admin login</a>
        <a class="church-btn church-btn--outline" href="/">Return home</a>
      </div>
    </div>
  </main>
</body>
</html>
