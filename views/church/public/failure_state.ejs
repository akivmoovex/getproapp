<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= typeof failureTitle !== 'undefined' && failureTitle ? failureTitle : pageTitle %> | BlessBoard</title>
  <meta name="description" content="<%= typeof failureLead !== 'undefined' && failureLead ? failureLead : 'BlessBoard could not complete this request.' %>"/>
  <meta name="robots" content="noindex, nofollow"/>
  <% if (typeof correlationId !== 'undefined' && correlationId) { %>
  <meta name="x-request-id" content="<%= correlationId %>"/>
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=47"/>
</head>
<body class="church-body church-body--unavailable">
  <header class="church-header church-header--auth">
    <div class="church-header__inner">
      <%- include('../partials/brand_lockup', { href: 'https://blessboard.com' }) %>
    </div>
  </header>
  <main class="church-unavailable">
    <%- include('../partials/failure_state_card') %>
  </main>
</body>
</html>
