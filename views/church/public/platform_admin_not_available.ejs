<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Platform admin not available | BlessBoard</title>
  <meta name="description" content="BlessBoard platform admin is only available at blessboard.com."/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=44"/>
</head>
<body class="church-body church-body--unavailable">
  <header class="church-header church-header--auth">
    <div class="church-header__inner">
      <%- include('../partials/brand_lockup', { href: 'https://blessboard.com' }) %>
    </div>
  </header>
  <main class="church-unavailable">
    <div class="church-unavailable__card">
      <span class="material-symbols-outlined church-unavailable__icon" aria-hidden="true">admin_panel_settings</span>
      <h1 class="church-unavailable__title">Platform admin is only on blessboard.com</h1>
      <p class="church-unavailable__lead">
        BlessBoard platform admin is only available at <strong>blessboard.com</strong>.
        Church branch administrators should use Church Admin on this site instead.
      </p>
      <p class="church-unavailable__actions" style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
        <a class="church-btn church-btn--primary" href="https://blessboard.com/admin/login">Go to BlessBoard Admin</a>
        <a class="church-btn church-btn--outline" href="/branch/login">Go to Church Admin</a>
      </p>
    </div>
  </main>
</body>
</html>
