<%- include('../partials/public_shell_start') %>
<%
  function leaderInitials(name) {
    return String(name || '')
      .split(/\s+/)
      .filter(Boolean)
      .map(function (w) { return w.charAt(0); })
      .slice(0, 2)
      .join('')
      .toUpperCase() || '?';
  }

  var pastor = (leadership && leadership.pastor) || {};
  var assistant = (leadership && leadership.assistant_pastor) || {};
  var elders = (leadership && leadership.elders) || [];
  var hasPastor = !!(pastor && String(pastor.name || '').trim());
  var hasAssistant = !!(assistant && String(assistant.name || '').trim());
  var elderList = Array.isArray(elders)
    ? elders.map(function (entry) {
        if (typeof entry === 'string') return { name: entry.trim(), role: 'Elder' };
        if (entry && typeof entry === 'object' && entry.name) {
          return {
            name: String(entry.name).trim(),
            role: String(entry.role || entry.title || 'Elder').trim() || 'Elder',
            bio: String(entry.bio || '').trim(),
            photoUrl: String(entry.photo_url || entry.photoUrl || '').trim(),
          };
        }
        return null;
      }).filter(function (e) { return e && e.name; })
    : [];
  var hasElders = elderList.length > 0;
  var hasAny = hasPastor || hasAssistant || hasElders;
  var pastorTitle = String((pastor && pastor.title) || '').trim() || 'Lead Pastor';
  var pastorBio = String((pastor && pastor.bio) || '').trim();
  var assistantTitle = String((assistant && assistant.title) || '').trim() || 'Assistant Pastor';
  var assistantBio = String((assistant && assistant.bio) || '').trim();
  var pastorPhoto = String((pastor && (pastor.photo_url || pastor.photoUrl)) || '').trim();
  var assistantPhoto = String((assistant && (assistant.photo_url || assistant.photoUrl)) || '').trim();
%>

<section class="church-leadership-page church-leadership-desktop church-leadership-mobile" data-leadership-page="1">
  <header class="church-leadership-page__hero church-leadership-intro">
    <div class="church-public-container">
      <span class="church-public-eyebrow church-leadership-page__eyebrow">Leadership</span>
      <h1 class="church-public-page-title church-leadership-page__title">Meet Our Church Leadership</h1>
      <p class="church-public-body church-leadership-page__lead">
        Dedicated servants committed to shepherd, teach, and empower our congregation at <%= churchName %>.
      </p>
    </div>
  </header>

  <div class="church-public-container church-leadership-page__body">
    <% if (!hasAny) { %>
    <div class="church-empty-state church-public-empty-state">
      <span class="material-symbols-outlined church-empty-state__icon" aria-hidden="true">groups</span>
      <p class="church-empty-state__title">Leadership details coming soon</p>
      <p class="church-empty-state__body">Published leadership information will appear here when branch leadership adds it.</p>
    </div>
    <% } else { %>

    <% if (hasPastor || hasAssistant) { %>
    <section class="church-leadership-page__pastoral" aria-labelledby="leadership-pastoral-heading">
      <div class="church-leadership-page__section-head">
        <span class="church-leadership-page__rule" aria-hidden="true"></span>
        <h2 id="leadership-pastoral-heading" class="church-public-section-title">Pastoral Team</h2>
      </div>

      <% if (hasPastor) { %>
      <article class="church-public-card church-leadership-page__featured">
        <div class="church-leadership-page__featured-media" aria-hidden="<%= pastorPhoto ? 'false' : 'true' %>">
          <% if (pastorPhoto) { %>
          <img src="<%= pastorPhoto %>" alt="<%= pastor.name %>" width="480" height="600" decoding="async"/>
          <% } else { %>
          <div class="church-leadership-page__avatar church-leadership-page__avatar--featured" role="img" aria-label="<%= pastor.name %>">
            <span><%= leaderInitials(pastor.name) %></span>
          </div>
          <% } %>
        </div>
        <div class="church-leadership-page__featured-body">
          <h3 class="church-leadership-page__name"><%= pastor.name %></h3>
          <p class="church-leadership-page__role-badge"><%= pastorTitle %></p>
          <% if (pastorBio) { %>
          <p class="church-public-body"><%= pastorBio %></p>
          <% } %>
        </div>
      </article>
      <% } %>

      <% if (hasAssistant) { %>
      <article class="church-public-card church-leadership-page__assistant">
        <div class="church-leadership-page__assistant-media" aria-hidden="<%= assistantPhoto ? 'false' : 'true' %>">
          <% if (assistantPhoto) { %>
          <img src="<%= assistantPhoto %>" alt="<%= assistant.name %>" width="240" height="300" decoding="async"/>
          <% } else { %>
          <div class="church-leadership-page__avatar" role="img" aria-label="<%= assistant.name %>">
            <span><%= leaderInitials(assistant.name) %></span>
          </div>
          <% } %>
        </div>
        <div class="church-leadership-page__assistant-body">
          <p class="church-public-meta church-leadership-page__assistant-label"><%= assistantTitle %></p>
          <h3 class="church-leadership-page__name"><%= assistant.name %></h3>
          <% if (assistantBio) { %>
          <p class="church-public-body"><%= assistantBio %></p>
          <% } %>
        </div>
      </article>
      <% } %>
    </section>
    <% } %>

    <% if (hasElders) { %>
    <section class="church-leadership-page__elders" aria-labelledby="leadership-elders-heading">
      <div class="church-leadership-page__section-head">
        <span class="church-leadership-page__rule" aria-hidden="true"></span>
        <h2 id="leadership-elders-heading" class="church-public-section-title">Church Elders</h2>
      </div>
      <div class="church-leadership-page__elders-grid">
        <% elderList.forEach(function (elder) { %>
        <article class="church-public-card church-leadership-page__elder-card">
          <% if (elder.photoUrl) { %>
          <div class="church-leadership-page__elder-photo">
            <img src="<%= elder.photoUrl %>" alt="<%= elder.name %>" width="160" height="160" decoding="async"/>
          </div>
          <% } else { %>
          <div class="church-leadership-page__avatar church-leadership-page__avatar--circle" role="img" aria-label="<%= elder.name %>">
            <span><%= leaderInitials(elder.name) %></span>
          </div>
          <% } %>
          <div class="church-leadership-page__elder-copy">
            <h3 class="church-leadership-page__name"><%= elder.name %></h3>
            <p class="church-public-meta"><%= elder.role %></p>
            <% if (elder.bio) { %><p class="church-public-body"><%= elder.bio %></p><% } %>
          </div>
        </article>
        <% }); %>
      </div>
    </section>
    <% } %>

    <% } %>

    <aside class="church-leadership-page__cta" aria-labelledby="leadership-cta-heading">
      <div class="church-leadership-page__cta-copy">
        <h2 id="leadership-cta-heading" class="church-leadership-page__cta-title">Want to serve with us?</h2>
        <p class="church-leadership-page__cta-body">Discover how you can use your gifts to support our ministry goals.</p>
      </div>
      <a class="church-btn church-btn--public-secondary church-leadership-page__cta-btn" href="/ministries">Join a Ministry</a>
    </aside>
  </div>
</section>
<%- include('../partials/public_shell_end') %>
