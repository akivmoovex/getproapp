<%- include('../partials/public_shell_start') %>
<%
  function isSafeHttpUrl(raw) {
    var value = String(raw || '').trim();
    return /^https?:\/\//i.test(value);
  }

  var sermons = Array.isArray(sermonSamples) ? sermonSamples : [];
  var featured = sermons.length ? sermons[0] : null;
  var rest = sermons.length > 1 ? sermons.slice(1) : [];
  var videoEmbed = featured && (featured.videoEmbedUrl || featured.videoUrl) ? String(featured.videoEmbedUrl || featured.videoUrl) : '';
  var audioSrc = featured && featured.audioUrl && isSafeHttpUrl(featured.audioUrl) ? String(featured.audioUrl) : '';
  var pdfSrc = featured && featured.pdfUrl && isSafeHttpUrl(featured.pdfUrl) ? String(featured.pdfUrl) : '';
  var featuredMediaUrl = featured && featured.media_url ? String(featured.media_url) : '';
  var featuredExternal = !videoEmbed && isSafeHttpUrl(featuredMediaUrl) ? featuredMediaUrl : '';
%>

<section class="church-sermons-page church-sermons-desktop church-sermons-mobile" data-sermons-page="1">
  <header class="church-sermons-page__hero">
    <div class="church-public-container">
      <span class="church-public-eyebrow church-sermons-page__eyebrow">Sermons</span>
      <h1 class="church-public-page-title church-sermons-page__title">Sermons</h1>
      <p class="church-public-body church-sermons-page__lead">
        Faith-building messages and teaching resources from <%= churchName %>.
      </p>
    </div>
  </header>

  <div class="church-public-container church-sermons-page__body">
    <% if (!featured) { %>
    <div class="church-empty-state church-public-empty-state">
      <span class="material-symbols-outlined church-empty-state__icon" aria-hidden="true">menu_book</span>
      <p class="church-empty-state__title">Sermons coming soon</p>
      <p class="church-empty-state__body">Published sermons will appear here when branch leadership adds them.</p>
    </div>
    <% } else { %>

    <article class="church-public-card church-sermons-page__featured">
      <% if (videoEmbed) { %>
      <div class="church-sermons-page__player church-sermon-video">
        <div class="church-sermons-page__frame church-sermon-video__frame">
          <iframe
            src="<%= videoEmbed %>"
            title="<%= featured.title %> video"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </div>
      <% } else { %>
      <div class="church-sermons-page__featured-visual" aria-hidden="true">
        <span class="material-symbols-outlined">menu_book</span>
      </div>
      <% } %>
      <div class="church-sermons-page__featured-copy">
        <span class="church-sermons-page__badge"><%= videoEmbed ? 'Latest video' : 'Latest sermon' %></span>
        <h2 class="church-sermons-page__featured-title"><%= featured.title %></h2>
        <p class="church-public-meta church-sermons-page__meta">
          <% if (featured.speaker) { %>
          <span><span class="material-symbols-outlined" aria-hidden="true">person</span> <%= featured.speaker %></span>
          <% } %>
          <% if (featured.date) { %>
          <span><span class="material-symbols-outlined" aria-hidden="true">calendar_today</span> <%= featured.date %></span>
          <% } %>
          <% if (featured.scripture) { %>
          <span><span class="material-symbols-outlined" aria-hidden="true">menu_book</span> <%= featured.scripture %></span>
          <% } %>
        </p>
        <% if (featured.description) { %>
        <p class="church-public-body"><%= featured.description %></p>
        <% } %>
        <div class="church-sermons-page__featured-actions">
          <% if (videoEmbed) { %>
          <a class="church-btn church-btn--public-primary" href="<%= videoEmbed %>" target="_blank" rel="noopener noreferrer">Watch sermon</a>
          <% } else if (featuredExternal) { %>
          <a class="church-btn church-btn--public-primary" href="<%= featuredExternal %>" target="_blank" rel="noopener noreferrer">Open media</a>
          <% } %>
          <% if (audioSrc) { %>
          <a class="church-btn church-btn--public-secondary" href="<%= audioSrc %>" target="_blank" rel="noopener noreferrer">Listen</a>
          <% } %>
          <% if (pdfSrc) { %>
          <a class="church-btn church-btn--public-secondary" href="<%= pdfSrc %>" target="_blank" rel="noopener noreferrer">Study notes</a>
          <% } %>
        </div>
        <% if (audioSrc) { %>
        <div class="church-sermons-page__audio">
          <audio class="church-sermon-audio" controls preload="metadata">
            <source src="<%= audioSrc %>" type="audio/mpeg"/>
          </audio>
        </div>
        <% } %>
      </div>
    </article>

    <% if (rest.length) { %>
    <section class="church-sermons-page__list" aria-labelledby="sermons-recent-heading">
      <div class="church-sermons-page__list-head">
        <h2 id="sermons-recent-heading" class="church-public-section-title">Recent Sermons</h2>
        <p class="church-public-body">Explore our library of weekly teachings and spiritual resources.</p>
      </div>
      <div class="church-sermons-page__grid">
        <% rest.forEach(function (item) {
          var itemVideo = item.videoEmbedUrl || item.videoUrl || '';
          var itemAudio = item.audioUrl && isSafeHttpUrl(item.audioUrl) ? item.audioUrl : '';
          var itemPdf = item.pdfUrl && isSafeHttpUrl(item.pdfUrl) ? item.pdfUrl : '';
          var itemMedia = item.media_url && isSafeHttpUrl(item.media_url) ? item.media_url : '';
          var itemLink = itemVideo || itemAudio || itemPdf || itemMedia || '';
          var mediaLabel = item.mediaType || (itemVideo ? 'Video' : itemAudio ? 'Audio' : itemPdf ? 'PDF' : item.category || 'Sermon');
        %>
        <article class="church-public-card church-sermons-page__card">
          <div class="church-sermons-page__card-media" aria-hidden="true">
            <span class="material-symbols-outlined"><%= item.icon || 'play_circle' %></span>
            <% if (mediaLabel) { %><span class="church-sermons-page__type"><%= mediaLabel %></span><% } %>
          </div>
          <div class="church-sermons-page__card-body">
            <% if (item.category) { %>
            <p class="church-public-meta church-sermons-page__category"><%= item.category %></p>
            <% } %>
            <h3 class="church-sermons-page__card-title"><%= item.title %></h3>
            <p class="church-public-meta church-sermons-page__card-meta">
              <% if (item.speaker) { %><span><%= item.speaker %></span><% } %>
              <% if (item.date) { %><span><%= item.date %></span><% } %>
            </p>
            <% if (item.scripture) { %>
            <p class="church-public-meta"><%= item.scripture %></p>
            <% } %>
            <% if (itemLink) { %>
            <a
              class="church-btn church-btn--public-text church-sermons-page__card-link"
              href="<%= itemLink %>"
              target="_blank"
              rel="noopener noreferrer"
            >Open <%= mediaLabel %></a>
            <% } %>
          </div>
        </article>
        <% }); %>
      </div>
    </section>
    <% } %>

    <% } %>

    <aside class="church-sermons-page__cta" aria-labelledby="sermons-cta-heading">
      <p id="sermons-cta-heading" class="church-sermons-page__cta-body">Need a specific resource? Reach out to the church office.</p>
      <a class="church-btn church-btn--public-primary" href="/contact">Contact Church</a>
    </aside>
  </div>
</section>
<%- include('../partials/public_shell_end') %>
