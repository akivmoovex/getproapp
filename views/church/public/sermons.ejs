<%- include('../partials/public_shell_start') %>
<%
  var sermons = sermonSamples || [];
  var featured = sermons[0] || null;
  var rest = sermons.slice(1);
  var showingDemoSermons = typeof hasDbSermons !== 'undefined' ? !hasDbSermons : true;
  var demoMedia = typeof sermonDemoMedia !== 'undefined' && sermonDemoMedia ? sermonDemoMedia : {
    videoEmbedUrl: 'https://www.youtube-nocookie.com/embed/M7lc1UVf-VE',
    audioUrl: '/church/demo-media/sermon-demo.mp3',
    pdfUrl: '/church/demo-media/sermon-notes-demo.pdf'
  };
  var videoEmbed = (featured && (featured.videoEmbedUrl || featured.videoUrl)) || demoMedia.videoEmbedUrl;
  var audioSrc = (featured && featured.audioUrl) || demoMedia.audioUrl;
  var pdfSrc = (featured && featured.pdfUrl) || demoMedia.pdfUrl;
  var resourceCards = (typeof sermonResourceCards !== 'undefined' && sermonResourceCards && sermonResourceCards.length)
    ? sermonResourceCards
    : [
        { title: 'Video Sermon', mediaType: 'Video', description: 'Watch the featured message with an embedded player.', actionLabel: 'Watch', href: '#sermon-video', icon: 'play_circle' },
        { title: 'Audio Sermon', mediaType: 'Audio', description: 'Listen on this page or download the MP3 for offline use.', actionLabel: 'Listen', href: '#sermon-audio', icon: 'headphones' },
        { title: 'PDF Study Notes', mediaType: 'PDF', description: 'Download printable notes with scripture and reflection prompts.', actionLabel: 'Download', href: pdfSrc, download: true, icon: 'picture_as_pdf' }
      ];
  var thumbs = [
    '/church/images/sermons/sermon-1.jpg',
    '/church/images/sermons/sermon-2.jpg',
    '/church/images/sermons/sermon-3.jpg'
  ];
  var mobileThumbs = [
    '/church/images/sermons/sermon-thumb-1.jpg',
    '/church/images/sermons/sermon-thumb-2.jpg',
    '/church/images/sermons/sermon-1.jpg'
  ];
  var studyResources = [
    { title: 'Weekly Study Guide', meta: 'PDF · 1.2 MB', icon: 'picture_as_pdf', tone: 'pdf', href: pdfSrc },
    { title: 'John 1:1-18 Notes', meta: 'PDF · Notes', icon: 'description', tone: 'doc', href: pdfSrc },
    { title: 'Ministry Overview', meta: 'PDF · Study', icon: 'slideshow', tone: 'ppt', href: pdfSrc }
  ];
%>

<section class="church-sermons-page">
  <header class="church-sermons-page__intro">
    <h1 class="home-desktop-design">Media Library</h1>
    <h1 class="home-mobile-design">Sermons &amp; Resources</h1>
    <p class="home-desktop-design">Watch, listen, and grow with messages and study materials from <%= churchName %>.</p>
    <p class="home-mobile-design">Growing together through Word and Spirit.</p>
  </header>

  <div class="church-sermons-filters home-desktop-design" aria-hidden="true">
    <button type="button">Series <span class="material-symbols-outlined">expand_more</span></button>
    <button type="button">Topic <span class="material-symbols-outlined">expand_more</span></button>
    <button type="button">Speaker <span class="material-symbols-outlined">expand_more</span></button>
    <label class="church-sermons-search">
      <span class="material-symbols-outlined" aria-hidden="true">search</span>
      <input type="search" placeholder="Search sermons..." aria-label="Search sermons"/>
    </label>
  </div>

  <label class="church-sermons-series-select home-mobile-design">
    <span class="material-symbols-outlined" aria-hidden="true">filter_list</span>
    <span>All Series</span>
    <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
  </label>

  <% if (!featured) { %>
  <div class="church-empty-state">
    <span class="material-symbols-outlined church-empty-state__icon" aria-hidden="true">menu_book</span>
    <p class="church-empty-state__title">Sermons coming soon</p>
    <p class="church-empty-state__body">Published sermons will appear here when branch leadership adds them.</p>
  </div>
  <% } else { %>

  <%# Shared hash targets (mobile/desktop featured are both in DOM; avoid duplicate IDs) %>
  <div id="sermon-video" class="church-sermon-hash-target" tabindex="-1"></div>
  <div id="sermon-audio" class="church-sermon-hash-target" tabindex="-1"></div>

  <%# Mobile featured with live media %>
  <article class="church-sermon-featured-mobile home-mobile-design church-sermon-featured--media">
    <div class="church-sermon-featured-mobile__media church-sermon-video">
      <div class="church-sermon-video__frame">
        <iframe
          src="<%= videoEmbed %>"
          title="<%= featured.title %> video"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
      <span class="church-sermon-badge">LATEST SERMON</span>
    </div>
    <div class="church-sermon-featured-mobile__body">
      <h2><%= featured.title %></h2>
      <p class="church-sermon-meta">
        <% if (featured.speaker) { %><span class="material-symbols-outlined" aria-hidden="true">person</span> <%= featured.speaker %><% } %>
        <% if (featured.date) { %> · <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span> <%= featured.date %><% } %>
      </p>
      <% if (featured.description) { %><p><%= featured.description %></p><% } %>
      <div class="church-sermon-media-panel">
        <p class="church-sermon-media-panel__label"><span class="material-symbols-outlined" aria-hidden="true">headphones</span> Listen to audio</p>
        <audio class="church-sermon-audio" controls preload="metadata">
          <source src="<%= audioSrc %>" type="audio/mpeg"/>
        </audio>
        <div class="church-sermon-download-row">
          <a class="church-btn church-btn--outline church-btn--sm" href="<%= audioSrc %>" download>
            <span class="material-symbols-outlined" aria-hidden="true">download</span> Download MP3
          </a>
          <a class="church-btn church-btn--outline church-btn--sm" href="<%= pdfSrc %>" download>
            <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span> Download PDF Notes
          </a>
        </div>
      </div>
    </div>
  </article>

  <%# Desktop featured with live media %>
  <article class="church-sermon-featured-desktop home-desktop-design church-sermon-featured--media">
    <div class="church-sermon-featured-desktop__grid">
      <div class="church-sermon-video">
        <div class="church-sermon-video__frame">
          <iframe
            src="<%= videoEmbed %>"
            title="<%= featured.title %> video"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </div>
      <div class="church-sermon-featured-desktop__copy">
        <span class="church-sermon-badge">LATEST SERMON</span>
        <h2><%= featured.title %></h2>
        <p class="church-sermon-meta">
          <% if (featured.speaker) { %><span class="material-symbols-outlined" aria-hidden="true">person</span> <%= featured.speaker %><% } %>
          <% if (featured.date) { %> · <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span> <%= featured.date %><% } %>
        </p>
        <% if (featured.description) { %><p class="church-sermon-featured-desktop__desc"><%= featured.description %></p><% } %>
        <div class="church-sermon-media-panel">
          <p class="church-sermon-media-panel__label"><span class="material-symbols-outlined" aria-hidden="true">headphones</span> Listen to audio</p>
          <audio class="church-sermon-audio" controls preload="metadata">
            <source src="<%= audioSrc %>" type="audio/mpeg"/>
          </audio>
          <div class="church-sermon-download-row">
            <a class="church-btn church-btn--outline church-btn--sm" href="<%= audioSrc %>" download>
              <span class="material-symbols-outlined" aria-hidden="true">download</span> Download MP3
            </a>
            <a class="church-btn church-btn--outline church-btn--sm" href="<%= pdfSrc %>" download>
              <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span> Download PDF Notes
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <div class="church-sermon-resource-cards" aria-label="Resource types">
    <% resourceCards.forEach(function (card) { %>
    <article class="church-sermon-resource-card">
      <div class="church-sermon-resource-card__head">
        <span class="material-symbols-outlined" aria-hidden="true"><%= card.icon || 'folder' %></span>
        <span class="church-sermon-type-badge church-sermon-type-badge--<%= String(card.mediaType || '').toLowerCase() %>"><%= card.mediaType %></span>
      </div>
      <h3><%= card.title %></h3>
      <p><%= card.description %></p>
      <% if (card.download) { %>
      <a class="church-btn church-btn--primary church-btn--sm" href="<%= card.href %>" download><%= card.actionLabel %></a>
      <% } else { %>
      <a class="church-btn church-btn--primary church-btn--sm" href="<%= card.href %>"><%= card.actionLabel %></a>
      <% } %>
    </article>
    <% }); %>
  </div>

  <div class="church-sermons-layout">
    <div class="church-sermons-main">
      <div class="church-sermons-section-head home-desktop-design">
        <h2>Sermons</h2>
        <a href="/sermons">View All →</a>
      </div>
      <div class="church-sermons-section-head home-mobile-design">
        <h2><span class="material-symbols-outlined" aria-hidden="true">schedule</span> Recent Sermons</h2>
      </div>

      <div class="church-sermon-grid home-desktop-design church-sermon-grid--page">
        <% (rest.length ? rest : sermons).slice(0, 3).forEach(function (item, idx) { %>
        <article class="church-sermon-card church-sermon-card--photo">
          <div class="church-sermon-card__media">
            <img src="<%= thumbs[idx % thumbs.length] %>" alt="" width="512" height="279"/>
          </div>
          <div class="church-sermon-card__body">
            <% if (item.category) { %><p class="church-sermon-card__meta"><%= item.category %></p><% } %>
            <h3 class="church-sermon-card__title"><%= item.title %></h3>
            <p class="church-sermon-card__speaker">
              <% if (item.speaker) { %><span class="material-symbols-outlined" aria-hidden="true">person</span> <%= item.speaker %><% } %>
              <% if (item.date) { %> · <%= item.date %><% } %>
            </p>
          </div>
        </article>
        <% }); %>
      </div>

      <div class="church-sermon-recent home-mobile-design">
        <% (rest.length ? rest : sermons).slice(0, 2).forEach(function (item, idx) { %>
        <article class="church-sermon-recent__row">
          <img src="<%= mobileThumbs[idx % mobileThumbs.length] %>" alt="" width="96" height="96"/>
          <div>
            <h3><%= item.title %></h3>
            <p><%= [item.date, item.category].filter(Boolean).join(' · ') %></p>
            <div class="church-sermon-recent__actions">
              <a href="#sermon-audio"><span class="material-symbols-outlined" aria-hidden="true">headphones</span> LISTEN</a>
              <a href="<%= item.audioUrl || audioSrc %>" download><span class="material-symbols-outlined" aria-hidden="true">download</span> MP3</a>
            </div>
          </div>
        </article>
        <% }); %>
      </div>
    </div>

    <aside class="church-sermons-sidebar">
      <h2 class="home-desktop-design">Study Resources</h2>
      <h2 class="home-mobile-design"><span class="material-symbols-outlined" aria-hidden="true">description</span> Study Resources</h2>
      <div class="church-study-resources">
        <% studyResources.forEach(function (r) { %>
        <article class="church-study-resource church-study-resource--<%= r.tone %>">
          <span class="material-symbols-outlined" aria-hidden="true"><%= r.icon %></span>
          <div>
            <h3><%= r.title %></h3>
            <p><%= r.meta %></p>
          </div>
          <a href="<%= r.href || pdfSrc %>" download aria-label="Download <%= r.title %>"><span class="material-symbols-outlined" aria-hidden="true">download</span></a>
        </article>
        <% }); %>
      </div>
      <article class="church-sermon-podcast home-desktop-design">
        <h3>Sermon Audio Podcast</h3>
        <p>Listen on the go with our Spotify and Apple Podcasts channels.</p>
        <div class="church-sermon-podcast__icons">
          <span class="material-symbols-outlined" aria-hidden="true">podcasts</span>
          <span class="material-symbols-outlined" aria-hidden="true">headphones</span>
        </div>
      </article>
    </aside>
  </div>

  <div class="church-sermons-cta home-desktop-design">
    <p>Need a specific resource? Can't find what you're looking for? Reach out to our ministry office.</p>
    <a class="church-btn church-btn--primary" href="/contact"><span class="material-symbols-outlined" aria-hidden="true">mail</span> Contact Office</a>
  </div>
  <% if (showingDemoSermons) { %>
  <p class="church-leadership-fallback-note">Showing sample sermon layout with demo media. Publish sermons in branch admin to replace demo messages. Phase 2: upload/storage for video_url, audio_url, and pdf_url.</p>
  <% } %>
  <% } %>
</section>
<%- include('../partials/public_shell_end') %>
