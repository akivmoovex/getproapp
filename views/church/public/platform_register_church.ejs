<%- include('../partials/public_shell_start') %>

<section class="bb-apex-register" aria-labelledby="register-page-title">
  <%# Mobile hero (Stitch: Register Your Church Mobile) %>
  <div class="bb-apex-register__mobile-hero home-mobile-design">
    <div class="bb-apex-register__mobile-hero-inner">
      <p class="bb-apex-eyebrow bb-apex-eyebrow--inverse">Church onboarding</p>
      <p class="bb-apex-register__mobile-display">Equipping your ministry for digital connection.</p>
      <p class="bb-apex-register__mobile-lead">Request BlessBoard access for your congregation. This form asks for contact only — it does not create a church site or administrator accounts automatically.</p>
      <div class="bb-apex-register__mobile-chips" aria-hidden="true">
        <div class="bb-apex-register__mobile-chip">
          <span class="material-symbols-outlined">language</span>
          <span>Public website</span>
        </div>
        <div class="bb-apex-register__mobile-chip">
          <span class="material-symbols-outlined">groups</span>
          <span>Member portal</span>
        </div>
        <div class="bb-apex-register__mobile-chip">
          <span class="material-symbols-outlined">admin_panel_settings</span>
          <span>Branch admin</span>
        </div>
      </div>
    </div>
  </div>

  <%# Desktop benefits panel (Stitch: Register Your Church Desktop left column) %>
  <aside class="bb-apex-register__aside home-desktop-design" aria-label="Why register with BlessBoard">
    <div class="bb-apex-register__aside-inner">
      <h2 class="bb-apex-register__aside-title">Bring your church online with clarity.</h2>
      <p class="bb-apex-register__aside-lead">BlessBoard connects public pages, member sign-in, and branch administration on one platform — so leaders spend less time juggling tools.</p>
      <ul class="bb-apex-register__benefits">
        <li class="bb-apex-register__benefit">
          <span class="bb-apex-register__benefit-icon" aria-hidden="true"><span class="material-symbols-outlined">verified</span></span>
          <div>
            <h3>Unified ministry tools</h3>
            <p>Public website, member portal, and branch administration on each branch subdomain.</p>
          </div>
        </li>
        <li class="bb-apex-register__benefit">
          <span class="bb-apex-register__benefit-icon" aria-hidden="true"><span class="material-symbols-outlined">favorite</span></span>
          <div>
            <h3>Practical onboarding</h3>
            <p>BlessBoard is currently onboarding selected churches with setup support from platform administrators.</p>
          </div>
        </li>
        <li class="bb-apex-register__benefit">
          <span class="bb-apex-register__benefit-icon" aria-hidden="true"><span class="material-symbols-outlined">account_tree</span></span>
          <div>
            <h3>Multi-branch ready</h3>
            <p>HQ oversight and branch registry when your organization spans multiple locations.</p>
          </div>
        </li>
      </ul>
      <p class="bb-apex-register__aside-note">Plans and available services may vary according to church size, branch structure, and setup requirements.</p>
    </div>
  </aside>

  <%# Shared form panel %>
  <div class="bb-apex-register__main">
    <div class="bb-apex-register__main-inner">
      <header class="bb-apex-register__header">
        <p class="bb-apex-eyebrow">BlessBoard</p>
        <h1 class="bb-apex-register__title" id="register-page-title">Register Your Church</h1>
        <p class="bb-apex-register__lead">Request BlessBoard access for your congregation. This form asks for contact only — it does not create a church site or administrator accounts automatically.</p>
        <p class="bb-apex-register__lead bb-apex-register__lead--secondary home-desktop-design">BlessBoard is currently onboarding selected churches. Plans and available services may vary according to church size, branch structure and setup requirements. Contact the BlessBoard team to discuss access.</p>
      </header>

      <% if (submitted) { %>
      <div class="bb-apex-register-success church-alert church-alert--success" role="status">
        <span class="bb-apex-register-success__icon material-symbols-outlined" aria-hidden="true">check_circle</span>
        <div>
          <strong>Thank you — your request was received.</strong>
          <p>BlessBoard platform administrators will review your details and follow up about onboarding. You can prepare branch names, preferred subdomain, and admin contacts while you wait.</p>
          <p>Already on BlessBoard? Use <a href="/churches?for=admin">Church Administrator Login</a> to sign in on your church site.</p>
        </div>
      </div>
      <% } else { %>
      <% if (formError && !(typeof fieldError !== 'undefined' && fieldError)) { %>
      <div class="church-alert church-alert--error bb-apex-register__alert" role="alert"><%= formError %></div>
      <% } %>

      <%- include('../partials/platform_register_church_form', {
        form: form,
        fieldError: typeof fieldError !== 'undefined' ? fieldError : null,
        formError: formError,
        registerChurchPath: registerChurchPath
      }) %>
      <% } %>
    </div>
  </div>
</section>

<link rel="stylesheet" href="/platform/location-autocomplete.css?v=1" />
<script src="/platform/location-autocomplete.js?v=1" defer></script>
<script src="/platform/gp-location-field-init.js?v=1" defer></script>

<script>
(function () {
  var form = document.querySelector(".bb-apex-register-form");
  if (!form) return;
  form.addEventListener("submit", function () {
    var btn = form.querySelector(".bb-apex-register-submit");
    if (!btn || btn.disabled) return;
    btn.disabled = true;
    btn.setAttribute("aria-busy", "true");
    btn.classList.add("bb-apex-register-submit--submitting");
    btn.textContent = "Submitting…";
  });
})();
</script>

<%- include('../partials/public_shell_end') %>
