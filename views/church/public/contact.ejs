<%- include('../partials/public_shell_start') %>
<%
  function isSafeHttpUrl(raw) {
    var value = String(raw || '').trim();
    return /^https?:\/\//i.test(value);
  }

  function splitScheduleLine(line) {
    var text = String(line || '').trim();
    if (!text) return { label: '', value: '' };
    if (/[·|]/.test(text)) {
      var parts = text.split(/[·|]/);
      var label = (parts[0] || '').trim();
      var value = parts.slice(1).join('·').trim();
      return value ? { label: label, value: value } : { label: '', value: text };
    }
    var colon = text.indexOf(':');
    if (colon > 0 && colon <= 40) {
      var label = text.slice(0, colon).trim();
      var value = text.slice(colon + 1).trim();
      // Avoid mangling clock times like "Open 9:00 AM" into label/value pairs.
      if (value && label && !/\d/.test(label)) {
        return { label: label, value: value };
      }
    }
    return { label: '', value: text };
  }

  var findAddress = String(address || locationText || '').trim();
  var hoursText = String(officeHours || '').trim();
  var hoursLines = hoursText ? hoursText.split('\n').map(function (l) { return l.trim(); }).filter(Boolean) : [];
  var phonePrimary = String(contactPhone || '').trim();
  var emailPrimary = String(contactEmail || '').trim();
  var serviceText = String(typeof serviceTimes !== 'undefined' ? serviceTimes : '').trim();
  var serviceLines = serviceText ? serviceText.split('\n').map(function (l) { return l.trim(); }).filter(Boolean) : [];
  var directionsRaw = String(typeof mapEmbedPlaceholder !== 'undefined' ? mapEmbedPlaceholder : '').trim();
  var directionsUrl = isSafeHttpUrl(directionsRaw) ? directionsRaw : '';
  var hasContactDetails = !!(findAddress || phonePrimary || emailPrimary || hoursLines.length || serviceLines.length || directionsUrl);
  var form = contactForm || {};
%>

<section class="church-contact-page church-contact-desktop church-contact-mobile" data-contact-page="1">
  <header class="church-contact-page__hero">
    <div class="church-public-container">
      <span class="church-public-eyebrow church-contact-page__eyebrow">Contact</span>
      <h1 class="church-public-page-title church-contact-page__title">Get in Touch</h1>
      <p class="church-public-body church-contact-page__lead">
        We would love to hear from you. Reach out for prayer, information, or to connect with <%= churchName %>.
      </p>
    </div>
  </header>

  <div class="church-public-container church-contact-page__body">
    <% if (contactSubmitted) { %>
    <div class="church-alert church-alert--success church-contact-alert" role="status">
      Thank you for your message. The church office will respond as soon as possible.
    </div>
    <% } %>
    <% if (contactError) { %>
    <div class="church-alert church-alert--error church-contact-alert" role="alert"><%= contactError %></div>
    <% } %>

    <% if (hasContactDetails) { %>
    <div class="church-contact-page__info-grid">
      <% if (phonePrimary) { %>
      <article class="church-public-card church-contact-page__info-card">
        <span class="church-contact-page__info-icon" aria-hidden="true"><span class="material-symbols-outlined">call</span></span>
        <h2 class="church-contact-page__info-title">Phone</h2>
        <a class="church-contact-page__info-value" href="tel:<%= phonePrimary %>"><%= phonePrimary %></a>
      </article>
      <% } %>
      <% if (emailPrimary) { %>
      <article class="church-public-card church-contact-page__info-card">
        <span class="church-contact-page__info-icon" aria-hidden="true"><span class="material-symbols-outlined">mail</span></span>
        <h2 class="church-contact-page__info-title">Email</h2>
        <a class="church-contact-page__info-value" href="mailto:<%= emailPrimary %>"><%= emailPrimary %></a>
      </article>
      <% } %>
      <% if (findAddress) { %>
      <article class="church-public-card church-contact-page__info-card">
        <span class="church-contact-page__info-icon" aria-hidden="true"><span class="material-symbols-outlined">location_on</span></span>
        <h2 class="church-contact-page__info-title">Location</h2>
        <p class="church-contact-page__info-value"><%= findAddress %></p>
      </article>
      <% } %>
    </div>
    <% } else { %>
    <div class="church-empty-state church-public-empty-state church-contact-page__reduced">
      <span class="material-symbols-outlined church-empty-state__icon" aria-hidden="true">contact_mail</span>
      <p class="church-empty-state__title">Contact details coming soon</p>
      <p class="church-empty-state__body">Published address, phone, and email will appear here when branch leadership adds them. You can still send a message below.</p>
    </div>
    <% } %>

    <div class="church-contact-page__main">
      <aside class="church-public-card church-contact-page__form-card church-contact-form-panel" aria-labelledby="contact-form-heading">
        <h2 id="contact-form-heading" class="church-public-section-title church-contact-form-panel__title">Send a Message</h2>
        <p class="church-public-body church-contact-form-panel__note">Fill out the form below and our ministry team will reach out shortly.</p>
        <form class="church-form" action="/contact" method="post" novalidate>
          <div class="church-field">
            <label class="church-label" for="contact_full_name">Full Name</label>
            <input class="church-input" id="contact_full_name" name="full_name" type="text" required autocomplete="name" placeholder="Your name" value="<%= form.full_name || '' %>"/>
          </div>
          <div class="church-field">
            <label class="church-label" for="contact_email">Email Address</label>
            <input class="church-input" id="contact_email" name="email" type="email" autocomplete="email" placeholder="you@example.com" value="<%= form.email || '' %>"/>
          </div>
          <div class="church-field">
            <label class="church-label" for="contact_phone">Phone <span class="church-public-meta">(optional if email provided)</span></label>
            <input class="church-input" id="contact_phone" name="phone" type="tel" autocomplete="tel" placeholder="+260 ..." value="<%= form.phone || '' %>"/>
          </div>
          <div class="church-field">
            <label class="church-label" for="contact_message">Message</label>
            <textarea class="church-input church-input--textarea" id="contact_message" name="message" rows="5" required placeholder="How can we help or pray for you today?"><%= form.message || '' %></textarea>
          </div>
          <button class="church-btn church-btn--public-primary church-btn--block" type="submit">
            <span class="material-symbols-outlined" aria-hidden="true">send</span>
            Send Message
          </button>
        </form>
      </aside>

      <div class="church-contact-page__side">
        <% if (serviceLines.length) { %>
        <article class="church-public-card church-contact-page__side-card church-contact-page__side-card--services">
          <h2 class="church-public-section-title">Service Times</h2>
          <ul class="church-contact-page__schedule">
            <% serviceLines.forEach(function (line) {
              var item = splitScheduleLine(line);
            %>
            <li>
              <% if (item.label && item.value) { %>
              <span><%= item.label %></span>
              <strong><%= item.value %></strong>
              <% } else { %>
              <strong><%= item.value || line %></strong>
              <% } %>
            </li>
            <% }); %>
          </ul>
        </article>
        <% } %>

        <% if (hoursLines.length) { %>
        <article class="church-public-card church-contact-page__side-card">
          <h2 class="church-public-section-title">Office Hours</h2>
          <ul class="church-contact-page__schedule">
            <% hoursLines.forEach(function (line) {
              var item = splitScheduleLine(line);
            %>
            <li>
              <% if (item.label && item.value) { %>
              <span><%= item.label %></span>
              <strong><%= item.value %></strong>
              <% } else { %>
              <strong><%= item.value || line %></strong>
              <% } %>
            </li>
            <% }); %>
          </ul>
        </article>
        <% } %>

        <% if (findAddress || directionsUrl) { %>
        <article class="church-public-card church-contact-page__side-card church-contact-page__location">
          <div class="church-contact-page__location-fallback" aria-hidden="true">
            <span class="material-symbols-outlined">map</span>
          </div>
          <div class="church-contact-page__location-body">
            <h2 class="church-public-section-title"><%= churchName %></h2>
            <% if (branchName && branchName !== churchName) { %>
            <p class="church-public-meta"><%= branchName %></p>
            <% } %>
            <% if (findAddress) { %>
            <p class="church-public-body"><%= findAddress %></p>
            <% } %>
            <% if (directionsUrl) { %>
            <a class="church-btn church-btn--public-secondary" href="<%= directionsUrl %>" target="_blank" rel="noopener noreferrer">
              Get Directions
              <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
            </a>
            <% } %>
          </div>
        </article>
        <% } %>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/public_shell_end') %>
