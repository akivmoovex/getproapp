<%- include('../partials/public_shell_start') %>
    <%- include('../partials/public_page_hero', { heroTitle: 'Get in Touch', heroSubtitle: 'We would love to hear from you.' }) %>
    <section class="church-section church-section--page church-section--content">
      <div class="church-section__inner">
        <% if (contactSubmitted) { %>
        <div class="church-alert church-alert--success church-contact-alert" role="status">
          Thank you for your message. The church office will respond as soon as possible.
        </div>
        <% } %>
        <% if (contactError) { %>
        <div class="church-alert church-alert--error church-contact-alert" role="alert"><%= contactError %></div>
        <% } %>
        <div class="church-contact-quick">
          <% if (contactPhone) { %>
          <a class="church-contact-quick__btn church-contact-quick__btn--primary" href="tel:<%= contactPhone %>">
            <span class="material-symbols-outlined" aria-hidden="true">call</span>
            <span>Call Us</span>
          </a>
          <% } %>
          <% if (contactEmail) { %>
          <a class="church-contact-quick__btn" href="mailto:<%= contactEmail %>">
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            <span>Email Us</span>
          </a>
          <% } %>
        </div>
        <div class="church-contact-layout">
          <div class="church-contact-info">
            <% if (address || locationText) { %>
            <div class="church-location-card church-location-card--compact">
              <div class="church-location-card__map church-location-card__map--short" aria-hidden="true">
                <span class="church-location-card__pin material-symbols-outlined">location_on</span>
              </div>
              <div class="church-location-card__body">
                <h3 class="church-location-card__name"><%= churchName %></h3>
                <p class="church-location-card__address"><%= address || locationText %></p>
              </div>
            </div>
            <% } %>
            <% if (officeHours) { %>
            <article class="church-content-card">
              <div class="church-content-card__head">
                <span class="church-content-card__icon" aria-hidden="true"><span class="material-symbols-outlined">schedule</span></span>
                <h2 class="church-content-card__title">Office Hours</h2>
              </div>
              <p class="church-content-card__body church-card__body--pre"><%= officeHours %></p>
            </article>
            <% } %>
          </div>
          <aside class="church-contact-form-panel">
            <h2 class="church-contact-form-panel__title">Send a Message</h2>
            <form class="church-form" action="/contact" method="post">
              <div class="church-field">
                <label class="church-label" for="full_name">Full Name</label>
                <input class="church-input" id="full_name" name="full_name" type="text" required placeholder="Your name" value="<%= (contactForm && contactForm.full_name) || '' %>"/>
              </div>
              <div class="church-field">
                <label class="church-label" for="email">Email Address</label>
                <input class="church-input" id="email" name="email" type="email" placeholder="example@email.com" value="<%= (contactForm && contactForm.email) || '' %>"/>
              </div>
              <div class="church-field">
                <label class="church-label" for="phone">Phone (optional if email provided)</label>
                <input class="church-input" id="phone" name="phone" type="tel" placeholder="+260 ..." value="<%= (contactForm && contactForm.phone) || '' %>"/>
              </div>
              <div class="church-field">
                <label class="church-label" for="message">Message</label>
                <textarea class="church-input church-input--textarea" id="message" name="message" rows="4" required placeholder="How can we help you?"><%= (contactForm && contactForm.message) || '' %></textarea>
              </div>
              <button class="church-btn church-btn--primary church-btn--block church-btn--mobile-pill" type="submit">
                <span class="material-symbols-outlined" aria-hidden="true">send</span>
                Send Message
              </button>
            </form>
          </aside>
        </div>
        <% if (!contactPhone && !contactEmail && !address && !locationText) { %>
        <div class="church-empty-state">
          <span class="material-symbols-outlined church-empty-state__icon" aria-hidden="true">mail</span>
          <p class="church-empty-state__title">Contact details coming soon</p>
          <p class="church-empty-state__body">Phone, email, and office hours will be posted here.</p>
        </div>
        <% } %>
      </div>
    </section>
<%- include('../partials/public_shell_end') %>
