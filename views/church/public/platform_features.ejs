<%- include('../partials/public_shell_start') %>

<%- include('../partials/platform_info_hero', {
  heroTitle: 'Everything your church needs in one connected platform',
  heroLead: 'BlessBoard brings your public website, member communication, and day-to-day church administration together — so leaders spend less time juggling tools and more time serving people.'
}) %>

<section class="bb-platform-info-section home-desktop-design" aria-labelledby="features-public-web">
  <div class="bb-platform-info-section__inner">
    <article class="bb-platform-info-section__card">
      <div class="bb-saas-bento__icon bb-saas-bento__icon--primary" aria-hidden="true">
        <span class="material-symbols-outlined">language</span>
      </div>
      <h2 id="features-public-web">Public Church Website</h2>
      <p>Give every branch a welcoming online front door that members and visitors can reach from any device.</p>
      <ul class="bb-saas-bento__checks">
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Church homepage with service times and welcome messaging</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> About and leadership pages</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Ministries and events listings</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Sermons and resources</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Contact information and message submissions</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Mobile-friendly public pages on each branch subdomain</li>
      </ul>
    </article>
  </div>
</section>

<section class="bb-platform-info-section bb-platform-info-section--alt home-desktop-design" aria-labelledby="features-member-portal">
  <div class="bb-platform-info-section__inner">
    <article class="bb-platform-info-section__card">
      <div class="bb-saas-bento__icon bb-saas-bento__icon--secondary" aria-hidden="true">
        <span class="material-symbols-outlined">groups</span>
      </div>
      <h2 id="features-member-portal">Member Portal</h2>
      <p>Help members stay connected after they register — with one sign-in on their church site.</p>
      <ul class="bb-saas-bento__checks">
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Member registration and login</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Profile and account management</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Announcements and events</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Ministries and my-ministries views</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Resources and church forms</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Online requests and prayer requests</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Request tracking in the member portal</li>
      </ul>
    </article>
  </div>
</section>

<section class="bb-platform-info-section home-desktop-design" aria-labelledby="features-branch-admin">
  <div class="bb-platform-info-section__inner">
    <article class="bb-platform-info-section__card">
      <div class="bb-saas-bento__icon bb-saas-bento__icon--tertiary" aria-hidden="true">
        <span class="material-symbols-outlined">admin_panel_settings</span>
      </div>
      <h2 id="features-branch-admin">Branch Administration</h2>
      <p>Equip branch leaders to publish content, support members, and run day-to-day ministry operations.</p>
      <ul class="bb-saas-bento__checks">
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Member verification and member management</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Website content publishing and site settings</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Events and ministries administration</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Announcements, sermons, and resources</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Member, prayer, and password-reset request queues</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Role-based branch admin and ministry leader access</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Branch dashboard with operational overview</li>
      </ul>
    </article>
  </div>
</section>

<section class="bb-platform-info-section bb-platform-info-section--alt home-desktop-design" aria-labelledby="features-hq">
  <div class="bb-platform-info-section__inner">
    <article class="bb-platform-info-section__card">
      <div class="bb-saas-bento__icon bb-saas-bento__icon--primary" aria-hidden="true">
        <span class="material-symbols-outlined">account_tree</span>
      </div>
      <h2 id="features-hq">Headquarters and Multi-Branch Management</h2>
      <p>Organizations with multiple branches can coordinate from HQ while each location keeps its own site and admin team.</p>
      <ul class="bb-saas-bento__checks">
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> HQ dashboard and branch registry</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Monthly branch report review</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> HQ broadcasts to branches and members on supported plans</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Consolidated analytics on supported plans</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> HQ audit log for organization activity</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> BlessBoard directory to route people to the correct branch</li>
      </ul>
    </article>
  </div>
</section>

<%- include('../partials/platform_info_cta', {
  ctaTitle: 'Ready to see BlessBoard for your church?',
  ctaLead: 'Take the guided demo, read the FAQ, or request access for your congregation.',
  primaryHref: '/demo',
  primaryLabel: 'See BlessBoard in action',
  secondaryHref: '/faq',
  secondaryLabel: 'Read FAQ'
}) %>

<p class="bb-platform-page__note" style="max-width:var(--church-max-width);margin:0 auto 3rem;padding:0 var(--church-margin-mobile);text-align:center;">
  <a href="<%= registerChurchPath %>">Register Your Church</a> · <a href="/contact">Contact BlessBoard</a>
</p>

<%- include('../partials/public_shell_end') %>
