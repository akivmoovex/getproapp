<%- include('../partials/public_shell_start') %>

<section class="bb-apex-directory bb-finder" aria-labelledby="directory-page-title">
  <div class="bb-apex-directory__inner bb-finder__inner">
    <header class="bb-apex-directory__header bb-finder__header home-desktop-design">
      <p class="bb-finder__eyebrow"><%= intent === 'admin' ? 'Church administrators' : 'Members & visitors' %></p>
      <h1 class="bb-apex-directory__title bb-finder__title" id="directory-page-title"><%= intent === 'admin' ? 'Find your church to sign in' : 'Find Your Church' %></h1>
      <p class="bb-apex-directory__lead bb-finder__lead">
        <% if (intent === 'admin') { %>
          Search for your church, then continue to the branch administrator login on your church site.
        <% } else { %>
          Search by church name, branch name, town, or slug. We only show active churches that are available online.
        <% } %>
      </p>
    </header>

    <header class="bb-apex-directory__header bb-apex-directory__header--mobile home-mobile-design">
      <p class="bb-apex-directory__title bb-apex-directory__title--mobile" id="directory-page-title-mobile"><%= intent === 'admin' ? 'Find your church' : 'Church Directory' %></p>
      <p class="bb-apex-directory__lead bb-apex-directory__lead--mobile">
        <% if (intent === 'admin') { %>
          Search, then continue to your branch administrator login.
        <% } else { %>
          Find your community nearby.
        <% } %>
      </p>
    </header>

    <div class="bb-apex-directory__search-card">
      <form class="bb-apex-directory__form bb-finder__form" method="get" action="/churches" role="search">
        <% if (intent === 'admin') { %>
        <input type="hidden" name="for" value="admin"/>
        <% } %>
        <label class="bb-finder__label visually-hidden" for="church-search-q">Search churches</label>
        <div class="bb-apex-directory__search-field">
          <span class="material-symbols-outlined bb-apex-directory__search-icon" aria-hidden="true">search</span>
          <input
            id="church-search-q"
            class="bb-apex-directory__input bb-finder__input"
            type="search"
            name="q"
            value="<%= searchQuery || '' %>"
            placeholder="Church name, branch, town, or slug"
            maxlength="80"
            autocomplete="organization"
          />
        </div>
        <button type="submit" class="bb-apex-directory__submit church-btn church-btn--primary church-btn--pill">Search</button>
      </form>
    </div>

    <% if (dbUnavailable) { %>
    <div class="bb-apex-directory__empty bb-finder__empty" role="status">
      <div class="bb-apex-directory__empty-icon" aria-hidden="true">
        <span class="material-symbols-outlined">cloud_off</span>
      </div>
      <h2>Directory temporarily unavailable</h2>
      <p>Please try again shortly.</p>
    </div>
    <% } else if (noResults) { %>
    <div class="bb-apex-directory__empty bb-finder__empty" role="status">
      <div class="bb-apex-directory__empty-icon" aria-hidden="true">
        <span class="material-symbols-outlined">search_off</span>
      </div>
      <h2>No churches matched your search</h2>
      <p>Try a different spelling or search by town, branch name, or church slug.</p>
      <ul class="bb-finder__hints">
        <li>Church name</li>
        <li>Branch name</li>
        <li>Town or city</li>
        <li>Church or branch slug</li>
      </ul>
      <div class="bb-finder__empty-actions">
        <a class="church-btn church-btn--outline church-btn--pill" href="/churches<%= intent === 'admin' ? '?for=admin' : '' %>">Clear search</a>
        <a class="church-btn church-btn--ghost church-btn--pill" href="/">Return home</a>
      </div>
    </div>
    <% } else if (typeof emptyDirectory !== 'undefined' && emptyDirectory) { %>
    <div class="bb-apex-directory__empty bb-finder__empty" role="status">
      <div class="bb-apex-directory__empty-icon" aria-hidden="true">
        <span class="material-symbols-outlined">church</span>
      </div>
      <h2>No churches are published yet</h2>
      <p>When congregations go live on BlessBoard, they will appear here. Ask your church administrator whether your congregation is on the platform.</p>
      <div class="bb-finder__empty-actions">
        <a class="church-btn church-btn--primary church-btn--pill" href="/register-church">Register Your Church</a>
        <a class="church-btn church-btn--outline church-btn--pill" href="/contact">Contact BlessBoard</a>
      </div>
    </div>
    <% } else if (churches.length) { %>
    <div class="bb-apex-directory__stats home-mobile-design" role="status">
      <div class="bb-apex-directory__stats-icon" aria-hidden="true">
        <span class="material-symbols-outlined">explore</span>
      </div>
      <div class="bb-apex-directory__stats-copy">
        <p class="bb-apex-directory__stats-count"><%= total %> church<%= total === 1 ? '' : 'es' %> found</p>
        <% if (searchQuery) { %>
        <p class="bb-apex-directory__stats-query">Showing results for &ldquo;<%= searchQuery %>&rdquo;</p>
        <% } %>
      </div>
    </div>
    <p class="bb-apex-directory__count bb-finder__count home-desktop-design"><%= total %> church<%= total === 1 ? '' : 'es' %> found</p>
    <div class="bb-apex-directory__list bb-finder__list" role="list">
      <% churches.forEach(function (church) { %>
      <div role="listitem">
        <%- include('../partials/finder_org_card', { church: church, intent: intent }) %>
      </div>
      <% }); %>
    </div>
    <% if (prevUrl || nextUrl) { %>
    <nav class="bb-apex-directory__pager bb-finder__pager" aria-label="Search results pages">
      <% if (prevUrl) { %><a class="bb-apex-directory__pager-link" href="<%= prevUrl %>">Previous</a><% } else { %><span></span><% } %>
      <span>Page <%= page %> of <%= totalPages %></span>
      <% if (nextUrl) { %><a class="bb-apex-directory__pager-link" href="<%= nextUrl %>">Next</a><% } else { %><span></span><% } %>
    </nav>
    <% } %>
    <% } %>

    <p class="bb-apex-directory__back bb-finder__back"><a href="/">Back to BlessBoard home</a></p>
  </div>
</section>

<%- include('../partials/public_shell_end') %>
