<%- include('../partials/public_shell_start') %>
<%
  var events = Array.isArray(upcomingEvents) ? upcomingEvents : [];
%>

<section class="church-events-page church-events-desktop church-events-mobile" data-events-page="1">
  <header class="church-events-page__hero">
    <div class="church-public-container">
      <span class="church-public-eyebrow church-events-page__eyebrow">Events</span>
      <h1 class="church-public-page-title church-events-page__title">Church Events</h1>
      <p class="church-public-body church-events-page__lead">
        Join our community in worship, fellowship, and service at <%= churchName %>.
      </p>
    </div>
  </header>

  <div class="church-public-container church-events-page__body">
    <% if (events.length === 0) { %>
    <div class="church-empty-state church-public-empty-state">
      <span class="material-symbols-outlined church-empty-state__icon" aria-hidden="true">event</span>
      <p class="church-empty-state__title">No upcoming events yet</p>
      <p class="church-empty-state__body">New events will appear here when published by church leadership.</p>
    </div>
    <% } else { %>
    <div class="church-events-page__grid" role="list">
      <% events.forEach(function (event) { %>
      <article class="church-public-card church-events-page__card" role="listitem">
        <% if (event.image) { %>
        <div class="church-events-page__media">
          <img src="<%= event.image %>" alt="" width="640" height="360" decoding="async"/>
          <% if (event.day && event.month) { %>
          <div class="church-events-page__date-badge" aria-hidden="true">
            <strong><%= event.day %></strong>
            <span><%= event.month %></span>
          </div>
          <% } %>
          <% if (event.category) { %>
          <span class="church-events-page__tag"><%= event.category %></span>
          <% } %>
        </div>
        <% } else { %>
        <div class="church-events-page__media church-events-page__media--fallback" aria-hidden="true">
          <% if (event.day && event.month) { %>
          <div class="church-events-page__date-badge church-events-page__date-badge--large">
            <span><%= event.month %></span>
            <strong><%= event.day %></strong>
          </div>
          <% } else { %>
          <span class="material-symbols-outlined">event</span>
          <% } %>
          <% if (event.category) { %>
          <span class="church-events-page__tag"><%= event.category %></span>
          <% } %>
        </div>
        <% } %>
        <div class="church-events-page__card-body">
          <h2 class="church-events-page__card-title"><%= event.title %></h2>
          <% if (event.time) { %>
          <p class="church-public-meta church-events-page__meta">
            <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
            <span><%= event.time %></span>
          </p>
          <% } %>
          <% if (event.location) { %>
          <p class="church-public-meta church-events-page__meta">
            <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
            <span><%= event.location %></span>
          </p>
          <% } %>
          <% if (event.description) { %>
          <p class="church-public-body church-events-page__summary"><%= event.description %></p>
          <% } %>
        </div>
      </article>
      <% }); %>
    </div>
    <% } %>

    <aside class="church-events-page__cta" aria-labelledby="events-cta-heading">
      <div class="church-events-page__cta-copy">
        <h2 id="events-cta-heading" class="church-events-page__cta-title">Want to stay connected?</h2>
        <p class="church-events-page__cta-body">Register as a member or contact the church office for gathering details.</p>
      </div>
      <div class="church-events-page__cta-actions">
        <a class="church-btn church-btn--public-primary" href="/register">Register as a Member</a>
        <a class="church-btn church-btn--public-secondary" href="/contact">Contact Church</a>
      </div>
    </aside>
  </div>
</section>
<%- include('../partials/public_shell_end') %>
