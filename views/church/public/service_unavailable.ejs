<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>BlessBoard temporarily unavailable</title>
  <meta name="description" content="BlessBoard is temporarily unavailable. Please try again shortly."/>
  <meta name="robots" content="noindex, nofollow"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=47"/>
</head>
<body class="church-body church-body--unavailable">
  <header class="church-header church-header--auth">
    <div class="church-header__inner">
      <%- include('../partials/brand_lockup', { href: 'https://blessboard.com' }) %>
    </div>
  </header>
  <main class="church-unavailable">
    <div class="church-unavailable__card">
      <span class="material-symbols-outlined church-unavailable__icon" aria-hidden="true">cloud_off</span>
      <h1 class="church-unavailable__title">BlessBoard is temporarily unavailable</h1>
      <p class="church-unavailable__lead">
        BlessBoard is temporarily unavailable. Please try again shortly.
      </p>
      <% if (typeof requestedHost !== 'undefined' && requestedHost) { %>
      <p class="muted" style="margin-top:0.75rem;font-size:0.9rem;">
        If this continues, contact your church office or platform support.
      </p>
      <% } %>
      <p class="church-unavailable__actions">
        <a class="church-btn church-btn--primary" href="https://blessboard.com">Go to BlessBoard home</a>
      </p>
    </div>
  </main>
</body>
</html>
