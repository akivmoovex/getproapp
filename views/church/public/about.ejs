<%- include('../partials/public_shell_start') %>
<%
  var storyBody = String(aboutBody || '').trim();
  var missionBody = String(missionText || '').trim();
  var visionBody = String(visionText || '').trim();
  var findAddress = String(address || locationText || '').trim();
  var welcomeLead = String(typeof welcomeMessage !== 'undefined' ? welcomeMessage : '').trim();
  var pageHeading = String(aboutTitle || '').trim() || ('About ' + churchName);
  var heroLead = welcomeLead || ('Discover ' + churchName + (branchName && branchName !== churchName ? (' · ' + branchName) : '') + '.');
  var valueRows = [];
  if (valuesText) {
    String(valuesText).split('\n').map(function (line) { return line.trim(); }).filter(Boolean).forEach(function (line) {
      var parts = line.split('|').map(function (p) { return p.trim(); });
      valueRows.push({ title: parts[0] || line, body: parts[1] || '' });
    });
  }
  var valueIcons = ['auto_awesome', 'groups', 'menu_book', 'volunteer_activism', 'favorite', 'diversity_3'];
  var hasStory = !!storyBody;
  var hasMission = !!missionBody;
  var hasVision = !!visionBody;
  var hasValues = valueRows.length > 0;
  var hasLocation = !!findAddress;
  var hasPurpose = hasMission || hasVision;
  var hasBodyContent = hasStory || hasPurpose || hasValues || hasLocation;
%>

<section class="church-about-page church-about-desktop church-about-mobile" data-about-page="1">
  <header class="church-about-page__hero church-about-desktop-hero church-about-mobile-hero">
    <div class="church-public-container church-about-page__hero-inner">
      <div class="church-about-page__hero-copy">
        <span class="church-public-eyebrow church-about-page__eyebrow">About Us</span>
        <h1 class="church-public-page-title church-about-page__title"><%= pageHeading %></h1>
        <p class="church-public-body church-about-page__lead"><%= heroLead %></p>
        <div class="church-about-page__hero-actions">
          <a class="church-btn church-btn--public-primary" href="/contact">
            Contact Church
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
          <a class="church-btn church-btn--public-secondary" href="/register">Register as a Member</a>
        </div>
      </div>
      <div class="church-about-page__hero-media" aria-hidden="true">
        <div class="church-about-page__hero-fallback">
          <img
            src="/church/images/about/about-branch-building.jpg"
            alt=""
            width="640"
            height="480"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </header>

  <% if (!hasBodyContent) { %>
  <div class="church-public-container">
    <div class="church-empty-state church-public-empty-state">
      <span class="material-symbols-outlined church-empty-state__icon" aria-hidden="true">info</span>
      <p class="church-empty-state__title">About details coming soon</p>
      <p class="church-empty-state__body">Published church story, mission, and values will appear here when branch leadership adds them.</p>
    </div>
  </div>
  <% } else { %>

  <% if (hasStory) { %>
  <section class="church-about-page__story" aria-labelledby="about-story-heading">
    <div class="church-public-container church-about-page__story-inner">
      <div class="church-about-page__story-visual" aria-hidden="true">
        <div class="church-about-page__story-panel church-about-page__story-panel--primary"></div>
        <div class="church-about-page__story-panel church-about-page__story-panel--accent"></div>
      </div>
      <div class="church-about-page__story-copy">
        <h2 id="about-story-heading" class="church-public-section-title">Our Story</h2>
        <p class="church-public-body"><%= storyBody %></p>
      </div>
    </div>
  </section>
  <% } %>

  <% if (hasPurpose) { %>
  <section class="church-about-page__purpose" aria-labelledby="about-purpose-heading">
    <div class="church-public-container">
      <h2 id="about-purpose-heading" class="church-public-section-title church-about-page__purpose-title">Our Purpose</h2>
      <div class="church-about-page__purpose-grid<%= hasMission && hasVision ? '' : ' church-about-page__purpose-grid--single' %>">
        <% if (hasMission) { %>
        <article class="church-public-card church-about-page__mission church-mission-card">
          <span class="church-about-page__card-icon" aria-hidden="true">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">flag</span>
          </span>
          <h3 class="church-about-page__card-title">Our Mission</h3>
          <p class="church-public-body"><%= missionBody %></p>
        </article>
        <% } %>
        <% if (hasVision) { %>
        <article class="church-public-card church-about-page__vision church-mission-card church-mission-card--primary">
          <span class="church-about-page__card-icon church-about-page__card-icon--on-primary" aria-hidden="true">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">visibility</span>
          </span>
          <h3 class="church-about-page__card-title">Our Vision</h3>
          <p class="church-public-body church-about-page__vision-body"><%= visionBody %></p>
        </article>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (hasValues) { %>
  <section class="church-about-page__values church-about-values church-values-section" aria-labelledby="about-values-heading">
    <div class="church-public-container">
      <h2 id="about-values-heading" class="church-public-section-title">Core Values</h2>
      <div class="church-about-page__values-grid church-about-values__grid church-values-list">
        <% valueRows.forEach(function (row, idx) { %>
        <article class="church-public-card church-about-page__value-card church-about-value-card church-value-row">
          <span class="church-about-page__value-icon material-symbols-outlined" style="font-variation-settings: 'FILL' 1;" aria-hidden="true"><%= valueIcons[idx % valueIcons.length] %></span>
          <div>
            <h3 class="church-about-page__value-title church-value-row__title"><%= row.title %></h3>
            <% if (row.body) { %><p class="church-public-meta church-value-row__body"><%= row.body %></p><% } %>
          </div>
        </article>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (hasLocation) { %>
  <section class="church-about-page__visit" aria-labelledby="about-visit-heading">
    <div class="church-public-container">
      <article class="church-public-card church-about-page__visit-card">
        <div class="church-about-page__visit-copy">
          <h2 id="about-visit-heading" class="church-public-section-title">Visit Us</h2>
          <h3 class="church-about-page__visit-name"><%= churchName %></h3>
          <% if (branchName && branchName !== churchName) { %>
          <p class="church-public-meta"><%= branchName %></p>
          <% } %>
          <p class="church-public-body"><%= findAddress %></p>
          <a class="church-btn church-btn--public-primary" href="/contact">Contact Church</a>
        </div>
        <div class="church-about-page__visit-visual" aria-hidden="true">
          <div class="church-about-page__visit-fallback"></div>
        </div>
      </article>
    </div>
  </section>
  <% } %>

  <% } %>

  <section class="church-about-page__cta church-about-cta" aria-labelledby="about-cta-heading">
    <div class="church-public-container church-about-page__cta-inner">
      <h2 id="about-cta-heading" class="church-about-page__cta-title">Join Our Community</h2>
      <p class="church-about-page__cta-body">Become part of <%= churchName %> and stay connected with our church family.</p>
      <div class="church-about-page__cta-actions church-about-cta__actions">
        <a class="church-btn church-btn--public-primary church-about-cta__primary" href="/login">Member Login</a>
        <a class="church-btn church-btn--public-secondary church-about-cta__outline" href="/register">Register as a Member</a>
      </div>
    </div>
  </section>
</section>
<%- include('../partials/public_shell_end') %>
