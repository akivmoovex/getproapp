<%- include('../partials/public_shell_start') %>
<%
  var gd = typeof givingDisplay !== 'undefined' && givingDisplay ? givingDisplay : { source: 'generic', categories: [] };
  var intro = gd.source === 'generic' ? '' : String(gd.givingInstructions || '').trim();
  var bank = gd.bank || null;
  var bankText = String(gd.givingBankDetails || '').trim();
  var mobileMoney = (gd.mobileMoney && gd.mobileMoney.length) ? gd.mobileMoney : [];
  if (mobileMoney.length === 0 && gd.givingMobileMoney) {
    String(gd.givingMobileMoney).split('\n').map(function (l) { return l.trim(); }).filter(Boolean).forEach(function (line) {
      var parts = line.split(':');
      var number = parts.slice(1).join(':').trim() || line;
      if (!number) return;
      mobileMoney.push({
        provider: (parts[0] || 'Mobile Money').trim(),
        number: number,
        name: ''
      });
    });
  }
  var categories = (gd.categories && gd.categories.length) ? gd.categories : [];
  if (categories.length === 0 && gd.givingCategories) {
    categories = String(gd.givingCategories).split(/[\n,]/).map(function (c) { return c.trim(); }).filter(Boolean);
  }

  var bankName = bank && bank.bank_name ? String(bank.bank_name).trim() : '';
  var accountName = bank && bank.account_name ? String(bank.account_name).trim() : '';
  var accountNumber = bank && bank.account_number ? String(bank.account_number).trim() : '';
  var branchCode = bank && bank.branch_code ? String(bank.branch_code).trim() : '';
  var swiftCode = bank && bank.swift_code ? String(bank.swift_code).trim() : '';
  var branchSwift = [branchCode, swiftCode].filter(Boolean).join(' / ');

  if (!bank && bankText) {
    var lines = bankText.split('\n').map(function (l) { return l.trim(); }).filter(Boolean);
    if (lines[0]) bankName = lines[0].replace(/^Bank[:\s]*/i, '');
    if (lines[1]) accountName = lines[1].replace(/^Account(?:\s*name)?[:\s]*/i, '');
    if (lines[2]) accountNumber = lines[2].replace(/^Account(?:\s*number)?[:\s]*/i, '');
    if (lines[3]) branchSwift = lines[3].replace(/^(?:Branch|SWIFT)[:\s]*/i, '');
  }

  var hasBank = !!(bankName || accountName || accountNumber);
  var qrSrc = String(gd.qrImageUrl || '').trim();
  var hasQr = !!(qrSrc && (qrSrc.charAt(0) === '/' || /^https?:\/\//i.test(qrSrc)));
  var hasMm = mobileMoney.length > 0;
  var hasCategories = categories.length > 0;
  var financeName = String(gd.financeContactName || '').trim();
  var financePhone = String(gd.financeContactPhone || '').trim();
  var hasFinance = !!(financeName || financePhone);
  var hasInstructionsOnly = !!intro;
  var hasGivingDetails = hasBank || hasMm || hasQr || hasCategories || !!gd.hasPublishedSettings || hasInstructionsOnly;
  var qrLabel = String(gd.qrCodeLabel || '').trim() || 'Scan to give';
  var methodCount = (hasBank ? 1 : 0) + (hasMm ? 1 : 0) + (hasQr ? 1 : 0);
%>

<section class="church-giving-page church-giving-desktop church-giving-mobile" data-giving-page="1">
  <header class="church-giving-page__hero">
    <div class="church-public-container">
      <span class="church-public-eyebrow church-giving-page__eyebrow">Giving</span>
      <h1 class="church-public-page-title church-giving-page__title">Ways to Give</h1>
      <% if (intro) { %>
      <p class="church-public-body church-giving-page__lead"><%= intro %></p>
      <% } else { %>
      <p class="church-public-body church-giving-page__lead">
        Support the ministry of <%= churchName %> through the giving channels published by branch leadership.
      </p>
      <% } %>
    </div>
  </header>

  <div class="church-public-container church-giving-page__body">
    <% if (!hasGivingDetails) { %>
    <div class="church-empty-state church-public-empty-state">
      <span class="material-symbols-outlined church-empty-state__icon" aria-hidden="true">volunteer_activism</span>
      <p class="church-empty-state__title">Giving details coming soon</p>
      <p class="church-empty-state__body">Published giving information will appear here when branch leadership adds it.</p>
      <a class="church-btn church-btn--public-primary" href="/contact">Contact Church</a>
    </div>
    <% } else { %>

    <div class="church-giving-page__methods-head">
      <h2 class="church-public-section-title">Ways to Give</h2>
      <% if (methodCount > 0) { %>
      <span class="church-giving-page__method-count"><%= methodCount %> method<%= methodCount === 1 ? '' : 's' %> available</span>
      <% } %>
    </div>

    <div class="church-giving-page__grid">
      <% if (hasBank) { %>
      <article class="church-public-card church-giving-page__card church-giving-page__card--bank">
        <div class="church-giving-page__card-head">
          <span class="church-giving-page__icon" aria-hidden="true">
            <span class="material-symbols-outlined">account_balance</span>
          </span>
          <div>
            <h3 class="church-giving-page__card-title">Bank Transfer</h3>
            <p class="church-public-meta">Direct deposit / wire transfer</p>
          </div>
        </div>
        <dl class="church-giving-page__details">
          <% if (bankName) { %>
          <div><dt>Bank name</dt><dd><%= bankName %></dd></div>
          <% } %>
          <% if (accountName) { %>
          <div><dt>Account name</dt><dd><%= accountName %></dd></div>
          <% } %>
          <% if (accountNumber) { %>
          <div>
            <dt>Account number</dt>
            <dd class="church-giving-page__copy-row">
              <span class="church-giving-page__value"><%= accountNumber %></span>
              <button type="button" class="church-giving-copy church-btn church-btn--public-text" data-copy="<%= accountNumber %>" aria-label="Copy account number">
                <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
              </button>
            </dd>
          </div>
          <% } %>
          <% if (branchSwift) { %>
          <div><dt>Branch / SWIFT</dt><dd class="church-giving-page__value"><%= branchSwift %></dd></div>
          <% } %>
        </dl>
      </article>
      <% } %>

      <% if (hasMm) { %>
      <article class="church-public-card church-giving-page__card church-giving-page__card--mm">
        <div class="church-giving-page__card-head">
          <span class="church-giving-page__icon church-giving-page__icon--mm" aria-hidden="true">
            <span class="material-symbols-outlined">smartphone</span>
          </span>
          <div>
            <h3 class="church-giving-page__card-title">Mobile Money</h3>
            <p class="church-public-meta">Send using your mobile money app</p>
          </div>
        </div>
        <ul class="church-giving-page__mm-list">
          <% mobileMoney.forEach(function (mm) { %>
          <li class="church-giving-page__mm-row">
            <div>
              <% if (mm.provider) { %><span class="church-public-meta"><%= mm.provider %></span><% } %>
              <strong class="church-giving-page__value"><%= mm.number %></strong>
              <% if (mm.name) { %><span class="church-public-meta">Registered as: <%= mm.name %></span><% } %>
            </div>
            <button type="button" class="church-giving-copy church-btn church-btn--public-text" data-copy="<%= mm.number %>" aria-label="Copy <%= mm.provider || 'mobile money' %> number">
              <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
            </button>
          </li>
          <% }); %>
        </ul>
      </article>
      <% } %>

      <% if (hasQr) { %>
      <article class="church-public-card church-giving-page__card church-giving-page__card--qr" aria-label="Giving QR code">
        <div class="church-giving-page__card-head">
          <span class="church-giving-page__icon" aria-hidden="true">
            <span class="material-symbols-outlined">qr_code_2</span>
          </span>
          <div>
            <h3 class="church-giving-page__card-title"><%= qrLabel %></h3>
            <p class="church-public-meta">Scan with your banking or mobile money app</p>
          </div>
        </div>
        <div class="church-giving-page__qr-frame">
          <img class="giving-qr-image" src="<%= qrSrc %>" alt="Giving QR code for <%= churchName %>" width="220" height="220" decoding="async"/>
        </div>
      </article>
      <% } %>

      <% if (hasCategories) { %>
      <article class="church-public-card church-giving-page__card church-giving-page__card--cats">
        <div class="church-giving-page__card-head">
          <span class="church-giving-page__icon" aria-hidden="true">
            <span class="material-symbols-outlined">category</span>
          </span>
          <div>
            <h3 class="church-giving-page__card-title">Giving Categories</h3>
            <p class="church-public-meta">Include the category in your payment reference when possible</p>
          </div>
        </div>
        <ul class="church-giving-page__cats">
          <% categories.forEach(function (cat) { %>
          <li><%= cat %></li>
          <% }); %>
        </ul>
      </article>
      <% } %>
    </div>

    <% if (intro && (hasBank || hasMm || hasQr)) { %>
    <article class="church-public-card church-giving-page__instructions">
      <h2 class="church-public-section-title">Giving instructions</h2>
      <p class="church-public-body church-card__body--pre"><%= intro %></p>
    </article>
    <% } %>

    <aside class="church-giving-page__cta" aria-labelledby="giving-cta-heading">
      <div class="church-giving-page__cta-copy">
        <h2 id="giving-cta-heading" class="church-giving-page__cta-title">Need help with giving?</h2>
        <p class="church-giving-page__cta-body">
          <% if (hasFinance) { %>
          Contact the finance office for questions about receipts or references.
          <% } else { %>
          Contact the church office for questions about giving or receipts.
          <% } %>
        </p>
        <% if (financeName) { %><p class="church-public-meta"><%= financeName %></p><% } %>
        <% if (financePhone) { %><p class="church-public-meta"><a href="tel:<%= financePhone %>"><%= financePhone %></a></p><% } %>
      </div>
      <a class="church-btn church-btn--public-primary" href="/contact">Contact Church</a>
    </aside>

    <% } %>
  </div>
</section>

<% if (hasGivingDetails) { %>
<script>
  (function () {
    document.querySelectorAll(".church-giving-copy").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var value = btn.getAttribute("data-copy") || "";
        if (!value || !navigator.clipboard) return;
        navigator.clipboard.writeText(value).catch(function () {});
      });
    });
  })();
</script>
<% } %>
<%- include('../partials/public_shell_end') %>
