<%- include('../partials/public_shell_start') %>
<%
  var orgLabel = (typeof organizationName !== 'undefined' && organizationName) ? organizationName : churchName;
  var ministryList = Array.isArray(ministries) ? ministries : [];
  var hasRealMinistries = ministryList.length > 0;
  var iconFor = function (name) {
    var n = String(name || '').toLowerCase();
    if (n.indexOf('worship') >= 0 || n.indexOf('music') >= 0 || n.indexOf('choir') >= 0) return 'music_note';
    if (n.indexOf('prayer') >= 0) return 'volunteer_activism';
    if (n.indexOf('youth') >= 0 || n.indexOf('teen') >= 0) return 'rocket_launch';
    if (n.indexOf('children') >= 0 || n.indexOf('kids') >= 0 || n.indexOf('sunday school') >= 0) return 'child_care';
    if (n.indexOf('women') >= 0) return 'auto_awesome';
    if (n.indexOf('men') >= 0) return 'fitness_center';
    if (n.indexOf('outreach') >= 0 || n.indexOf('mission') >= 0) return 'public';
    if (n.indexOf('hospital') >= 0 || n.indexOf('welcome') >= 0) return 'restaurant';
    return 'groups';
  };
  var shortDesc = function (text, max) {
    var raw = String(text || '').trim();
    if (!raw) return '';
    if (raw.length <= max) return raw;
    return raw.slice(0, Math.max(0, max - 1)).replace(/\s+\S*$/, '') + '…';
  };
  var dayTag = function (m) {
    return String(m.meeting_day || '').trim();
  };
  var scheduleLabel = function (m) {
    var parts = [];
    if (m.meeting_day) parts.push(m.meeting_day);
    if (m.meeting_time) parts.push(m.meeting_time);
    return parts.join(', ');
  };
  var featured = hasRealMinistries ? ministryList[0] : null;
  var secondary = hasRealMinistries ? ministryList.slice(1) : [];
  var filters = (typeof ministryFilters !== 'undefined' && Array.isArray(ministryFilters)) ? ministryFilters : [];
  var showFilters = hasRealMinistries && filters.length > 1;
%>

<section class="bb-public-ministries church-ministries-page-root church-ministries-desktop church-ministries-mobile" data-ministries-page="1">
  <section class="bb-ministries-hero" aria-label="Ministries introduction">
    <div class="bb-ministries-hero__inner">
      <span class="bb-ministries-hero__eyebrow">
        <span class="bb-ministries-hero__eyebrow-desktop">Our Impact</span>
        <span class="bb-ministries-hero__eyebrow-mobile">Our Community</span>
      </span>
      <h1 class="bb-ministries-hero__title">
        <span class="bb-ministries-hero__title-desktop">Growing Together in Faith and Community</span>
        <span class="bb-ministries-hero__title-mobile">Ministries for Everyone</span>
      </h1>
      <p class="bb-ministries-hero__lead">
        <span class="bb-ministries-hero__lead-desktop">
          Explore our ministries designed to serve every member of our spiritual family at <%= orgLabel || churchName %>.
        </span>
        <span class="bb-ministries-hero__lead-mobile">
          Find your place in our community and grow your faith through our dedicated ministry groups.
        </span>
      </p>
      <div class="bb-ministries-hero__actions">
        <a class="church-btn church-btn--public-primary" href="/contact">
          <span class="material-symbols-outlined" aria-hidden="true">person_add</span>
          Contact Church
        </a>
        <a class="church-btn church-btn--public-secondary" href="/events">
          <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
          View Schedule
        </a>
      </div>
    </div>
  </section>

  <section class="bb-ministries-page church-ministries-page">
    <% if (showFilters) { %>
    <div class="bb-ministries-filters church-ministry-filters" role="tablist" aria-label="Filter ministries">
      <% filters.forEach(function (filter) { %>
      <button
        class="bb-ministries-filter church-ministry-filter<%= filter.key === 'all' ? ' is-active' : '' %>"
        type="button"
        data-ministry-filter="<%= filter.key %>"
      ><%= filter.label %></button>
      <% }); %>
    </div>
    <% } %>

    <% if (!hasRealMinistries) { %>
    <div class="bb-ministries-empty church-empty-state church-public-empty-state">
      <span class="material-symbols-outlined church-empty-state__icon" aria-hidden="true">groups</span>
      <p class="church-empty-state__title">Ministry information will be available soon</p>
      <p class="church-empty-state__body">Published ministries will appear here when branch leadership adds them.</p>
      <a class="church-btn church-btn--public-primary" href="/contact">Contact Church</a>
    </div>
    <% } else { %>

    <div class="bb-ministries-grid church-ministry-grid" id="ministry-grid" data-ministries-layout="responsive">
      <% if (featured) { %>
      <article
        class="bb-ministries-feature church-ministry-feature bb-ministries-feature--featured"
        data-ministry-filter="<%= (featured.meeting_day || 'general').toLowerCase().replace(/\s+/g, '-') %>"
      >
        <div class="bb-ministries-feature__media" aria-hidden="true">
          <span class="material-symbols-outlined"><%= iconFor(featured.name) %></span>
        </div>
        <div class="bb-ministries-feature__body">
          <div class="bb-ministries-feature__topline">
            <h2 class="bb-ministries-feature__title"><%= featured.name %></h2>
            <% if (dayTag(featured)) { %>
            <span class="bb-ministries-feature__tag"><%= dayTag(featured) %></span>
            <% } %>
          </div>
          <% if (featured.description) { %>
          <p class="bb-ministries-feature__desc"><%= shortDesc(featured.description, 180) %></p>
          <% } %>
          <div class="bb-ministries-feature__foot">
            <% if (scheduleLabel(featured)) { %>
            <span class="bb-ministries-feature__meta">
              <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
              <%= scheduleLabel(featured) %>
            </span>
            <% } %>
            <a class="bb-ministries-feature__link" href="/contact">
              Learn More <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
          </div>
        </div>
      </article>
      <% } %>

      <% secondary.forEach(function (m, idx) { %>
      <article
        class="bb-ministries-card church-ministry-mini<%= idx === 0 ? ' bb-ministries-card--accent' : '' %>"
        data-ministry-filter="<%= (m.meeting_day || 'general').toLowerCase().replace(/\s+/g, '-') %>"
      >
        <div class="bb-ministries-card__media" aria-hidden="true">
          <span class="material-symbols-outlined"><%= iconFor(m.name) %></span>
        </div>
        <div class="bb-ministries-card__body">
          <div class="bb-ministries-card__topline">
            <h3 class="bb-ministries-card__title"><%= m.name %></h3>
            <% if (dayTag(m)) { %>
            <span class="bb-ministries-card__tag"><%= dayTag(m) %></span>
            <% } %>
          </div>
          <% if (m.description) { %>
          <p class="bb-ministries-card__desc"><%= shortDesc(m.description, 120) %></p>
          <% } %>
          <div class="bb-ministries-card__foot">
            <% if (scheduleLabel(m)) { %>
            <span class="bb-ministries-card__meta">
              <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
              <%= scheduleLabel(m) %>
            </span>
            <% } %>
            <a class="bb-ministries-card__link" href="/contact">
              Learn More <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
          </div>
        </div>
      </article>
      <% }); %>
    </div>
    <% } %>

    <div class="bb-ministries-cta church-ministries-cta">
      <h2 class="bb-ministries-cta__title">
        <span class="bb-ministries-cta__title-desktop">Still looking for your place?</span>
        <span class="bb-ministries-cta__title-mobile">Ready to Get Involved?</span>
      </h2>
      <p class="bb-ministries-cta__lead">
        <span class="bb-ministries-cta__lead-desktop">
          Our team is here to help you find the right group or ministry where your gifts can flourish.
        </span>
        <span class="bb-ministries-cta__lead-mobile">
          Register as a member or contact the church team to find the best fit for your journey.
        </span>
      </p>
      <div class="bb-ministries-cta__actions church-ministries-cta__actions">
        <a class="church-btn church-btn--public-primary bb-ministries-cta__register" href="/register">Register to Join</a>
        <a class="church-btn church-btn--public-secondary bb-ministries-cta__contact" href="/contact">
          <span class="material-symbols-outlined" aria-hidden="true">mail</span>
          Contact Church
        </a>
      </div>
    </div>
  </section>
</section>

<% if (showFilters) { %>
<script>
  (function () {
    var buttons = document.querySelectorAll(".bb-ministries-filter[data-ministry-filter]");
    var tiles = document.querySelectorAll(
      ".bb-ministries-feature[data-ministry-filter], .bb-ministries-card[data-ministry-filter]"
    );
    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var key = btn.getAttribute("data-ministry-filter");
        buttons.forEach(function (b) { b.classList.toggle("is-active", b === btn); });
        tiles.forEach(function (tile) {
          var match = key === "all" || tile.getAttribute("data-ministry-filter") === key;
          tile.style.display = match ? "" : "none";
        });
      });
    });
  })();
</script>
<% } %>
<%- include('../partials/public_shell_end') %>
