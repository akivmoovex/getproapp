<%- include('../partials/public_shell_start') %>
<%
  var orgLabel = (typeof organizationName !== 'undefined' && organizationName) ? organizationName : churchName;
  var ministryList = Array.isArray(ministries) ? ministries : [];
  var hasRealMinistries = ministryList.length > 0;
  var iconFor = function (name) {
    var n = String(name || '').toLowerCase();
    if (n.indexOf('worship') >= 0 || n.indexOf('music') >= 0 || n.indexOf('choir') >= 0) return 'music_note';
    if (n.indexOf('prayer') >= 0) return 'volunteer_activism';
    if (n.indexOf('youth') >= 0 || n.indexOf('teen') >= 0) return 'rocket_launch';
    if (n.indexOf('children') >= 0 || n.indexOf('kids') >= 0 || n.indexOf('sunday school') >= 0) return 'child_care';
    if (n.indexOf('women') >= 0) return 'auto_awesome';
    if (n.indexOf('men') >= 0) return 'fitness_center';
    if (n.indexOf('outreach') >= 0 || n.indexOf('mission') >= 0) return 'public';
    if (n.indexOf('hospital') >= 0 || n.indexOf('welcome') >= 0) return 'restaurant';
    return 'groups';
  };
  var shortDesc = function (text, max) {
    var raw = String(text || '').trim();
    if (!raw) return '';
    if (raw.length <= max) return raw;
    return raw.slice(0, Math.max(0, max - 1)).replace(/\s+\S*$/, '') + '…';
  };
  var featured = hasRealMinistries ? ministryList.slice(0, 2) : [];
  var rest = hasRealMinistries ? ministryList.slice(2) : [];
  var filters = (typeof ministryFilters !== 'undefined' && Array.isArray(ministryFilters)) ? ministryFilters : [];
  var showFilters = hasRealMinistries && filters.length > 1;
%>

<section class="bb-public-ministries" data-ministries-page="1">
  <section class="bb-ministries-hero" aria-label="Ministries introduction">
    <div class="bb-ministries-hero__inner">
      <span class="bb-ministries-hero__eyebrow">Our Community</span>
      <h1 class="bb-ministries-hero__title bb-ministries-hero__title--desktop">
        Growing Together in <span class="bb-ministries-hero__accent">Faith</span>
      </h1>
      <h1 class="bb-ministries-hero__title bb-ministries-hero__title--mobile">Our Ministries</h1>
      <p class="bb-ministries-hero__lead bb-ministries-hero__lead--desktop">
        Explore the various ministries at <%= orgLabel || churchName %>. Whether you're looking to serve, connect, or grow, there's a place for you here.
      </p>
      <p class="bb-ministries-hero__lead bb-ministries-hero__lead--mobile">
        Find your place in our community and grow your faith through our dedicated ministry groups.
      </p>
    </div>
  </section>

  <section class="bb-ministries-page church-ministries-page">
    <% if (showFilters) { %>
    <div class="bb-ministries-filters church-ministry-filters" role="tablist" aria-label="Filter ministries">
      <% filters.forEach(function (filter) { %>
      <button
        class="bb-ministries-filter church-ministry-filter<%= filter.key === 'all' ? ' is-active' : '' %>"
        type="button"
        data-ministry-filter="<%= filter.key %>"
      ><%= filter.label %></button>
      <% }); %>
    </div>
    <% } %>

    <% if (!hasRealMinistries) { %>
    <div class="bb-ministries-empty">
      <p>Ministry information will be available soon.</p>
      <a class="church-btn church-btn--primary" href="/contact">Contact Us</a>
    </div>
    <% } else { %>

    <%# Desktop Stitch bento %>
    <div class="bb-ministries-desktop church-ministries-bento church-ministry-grid" id="ministry-grid" data-ministries-layout="desktop">
      <div class="bb-ministries-desktop__featured church-ministries-bento__featured">
        <% featured.forEach(function (m, idx) { %>
        <article
          class="bb-ministries-feature church-ministry-feature<%= idx === 1 ? ' bb-ministries-feature--accent church-ministry-feature--accent' : '' %>"
          data-ministry-filter="<%= (m.meeting_day || 'general').toLowerCase().replace(/\s+/g, '-') %>"
        >
          <span class="bb-ministries-feature__icon church-ministry-feature__icon material-symbols-outlined" aria-hidden="true"><%= iconFor(m.name) %></span>
          <h2 class="bb-ministries-feature__title"><%= m.name %></h2>
          <% if (m.description) { %>
          <p class="bb-ministries-feature__desc"><%= shortDesc(m.description, 220) %></p>
          <% } %>
          <% if (m.meeting_time || m.meeting_day || m.location) { %>
          <p class="bb-ministries-feature__meta">
            <% if (m.meeting_day) { %><span><%= m.meeting_day %></span><% } %>
            <% if (m.meeting_time) { %><span><%= m.meeting_time %></span><% } %>
            <% if (m.location) { %><span><%= m.location %></span><% } %>
          </p>
          <% } %>
          <% if (idx === 1) { %>
          <a class="church-btn church-btn--on-primary bb-ministries-feature__btn" href="/contact">Contact Us</a>
          <% } else { %>
          <a class="bb-ministries-feature__link church-ministry-feature__link" href="/contact">
            Learn More <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
          <% } %>
        </article>
        <% }); %>
      </div>
      <% if (rest.length > 0) { %>
      <div class="bb-ministries-desktop__grid church-ministries-bento__grid">
        <% rest.forEach(function (m) { %>
        <article
          class="bb-ministries-mini church-ministry-mini"
          data-ministry-filter="<%= (m.meeting_day || 'general').toLowerCase().replace(/\s+/g, '-') %>"
        >
          <span class="bb-ministries-mini__icon church-ministry-mini__icon material-symbols-outlined" aria-hidden="true"><%= iconFor(m.name) %></span>
          <h3 class="bb-ministries-mini__title"><%= m.name %></h3>
          <% if (m.description) { %>
          <p class="bb-ministries-mini__desc"><%= shortDesc(m.description, 110) %></p>
          <% } %>
          <a class="bb-ministries-mini__link" href="/contact">
            Learn More <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
          </a>
        </article>
        <% }); %>
      </div>
      <% } %>
    </div>

    <%# Mobile Stitch list %>
    <div class="bb-ministries-mobile" data-ministries-layout="mobile" aria-label="Ministry list">
      <% ministryList.forEach(function (m) { %>
      <a
        class="bb-ministries-list-card"
        href="/contact"
        data-ministry-filter="<%= (m.meeting_day || 'general').toLowerCase().replace(/\s+/g, '-') %>"
      >
        <span class="bb-ministries-list-card__icon material-symbols-outlined" aria-hidden="true"><%= iconFor(m.name) %></span>
        <span class="bb-ministries-list-card__body">
          <span class="bb-ministries-list-card__title"><%= m.name %></span>
          <% if (m.description) { %>
          <span class="bb-ministries-list-card__desc"><%= shortDesc(m.description, 72) %></span>
          <% } %>
        </span>
        <span class="bb-ministries-list-card__chevron material-symbols-outlined" aria-hidden="true">chevron_right</span>
      </a>
      <% }); %>
    </div>
    <% } %>

    <div class="bb-ministries-cta church-ministries-cta">
      <h2 class="bb-ministries-cta__title bb-ministries-cta__title--desktop">Not sure where to start?</h2>
      <h2 class="bb-ministries-cta__title bb-ministries-cta__title--mobile">Not sure where you fit?</h2>
      <p class="bb-ministries-cta__lead bb-ministries-cta__lead--desktop">
        Our team is here to help you find the right group or ministry where your talents can flourish.
      </p>
      <p class="bb-ministries-cta__lead bb-ministries-cta__lead--mobile">
        Talk with our church team to find the best group for your spiritual journey.
      </p>
      <div class="bb-ministries-cta__actions church-ministries-cta__actions">
        <a class="church-btn church-btn--primary bb-ministries-cta__primary" href="/contact">Contact Us</a>
        <a class="church-btn church-btn--outline bb-ministries-cta__secondary bb-ministries-cta__secondary--desktop" href="/register">Register as a Member</a>
        <a class="church-btn church-btn--primary bb-ministries-cta__guidance" href="/contact">Get Guidance</a>
      </div>
    </div>
  </section>
</section>

<% if (showFilters) { %>
<script>
  (function () {
    var buttons = document.querySelectorAll(".bb-ministries-filter[data-ministry-filter]");
    var tiles = document.querySelectorAll(
      ".bb-ministries-feature[data-ministry-filter], .bb-ministries-mini[data-ministry-filter], .bb-ministries-list-card[data-ministry-filter]"
    );
    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var key = btn.getAttribute("data-ministry-filter");
        buttons.forEach(function (b) { b.classList.toggle("is-active", b === btn); });
        tiles.forEach(function (tile) {
          var match = key === "all" || tile.getAttribute("data-ministry-filter") === key;
          tile.style.display = match ? "" : "none";
        });
      });
    });
  })();
</script>
<% } %>
<%- include('../partials/public_shell_end') %>
