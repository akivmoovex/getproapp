<%- include('../partials/public_shell_start') %>

<%# --- Desktop hero (Stitch: For Churches Desktop) --- %>
<section class="bb-apex-for-churches-hero home-desktop-design" aria-labelledby="fc-hero-title">
  <div class="bb-apex-for-churches-hero__inner">
    <div class="bb-apex-for-churches-hero__copy">
      <p class="bb-apex-eyebrow">FOR MODERN CHURCHES</p>
      <h1 class="bb-apex-for-churches-hero__title" id="fc-hero-title">Empowering your congregation with <span class="bb-apex-hero__accent">Sacred Clarity</span>.</h1>
      <p class="bb-apex-for-churches-hero__lead">BlessBoard bridges the gap between digital management and spiritual mission, offering an intuitive platform designed specifically for the unique needs of ministry.</p>
      <div class="bb-apex-hero__cta">
        <a class="church-btn church-btn--public-primary" href="<%= registerChurchPath %>">Begin Onboarding</a>
        <a class="church-btn church-btn--public-secondary" href="/demo">Watch Demo</a>
      </div>
    </div>
    <div class="bb-apex-for-churches-hero__visual">
      <div class="bb-apex-for-churches-hero__frame">
        <img src="/church/images/homepage/desktop-hero-auditorium.jpg" alt="A serene modern church interior with natural light and minimalist wooden pews" width="640" height="640" />
      </div>
      <div class="bb-apex-for-churches-hero__glow" aria-hidden="true"></div>
    </div>
  </div>
</section>

<%# --- Mobile hero (Stitch: For Churches Mobile) --- %>
<section class="bb-apex-for-churches-hero bb-apex-for-churches-hero--mobile home-mobile-design" aria-labelledby="fc-hero-title-mobile">
  <div class="bb-apex-for-churches-hero__inner bb-apex-for-churches-hero__inner--mobile">
    <p class="bb-apex-eyebrow">For Churches</p>
    <p class="bb-apex-for-churches-hero__title bb-apex-for-churches-hero__title--mobile" id="fc-hero-title-mobile">Steward your ministry with clarity.</p>
    <p class="bb-apex-for-churches-hero__lead">Empower your leadership with tools built for community, not just data. BlessBoard bridges the gap between digital management and spiritual growth.</p>
    <div class="bb-apex-hero__cta bb-apex-hero__cta--stack">
      <a class="church-btn church-btn--public-primary church-btn--block" href="<%= registerChurchPath %>">Begin Onboarding</a>
      <a class="church-btn church-btn--public-secondary church-btn--block" href="/features">View Solutions</a>
    </div>
    <div class="bb-apex-for-churches-hero__frame bb-apex-for-churches-hero__frame--mobile">
      <img src="/church/images/homepage/apex-hero-mobile.jpg" alt="Church leadership team collaborating around a tablet in a sunlit modern office" width="640" height="640" />
      <div class="bb-apex-for-churches-hero__gradient" aria-hidden="true"></div>
    </div>
  </div>
</section>

<%# --- Desktop body --- %>
<div class="home-desktop-design">
  <section class="bb-apex-for-churches-challenges" aria-labelledby="fc-challenges">
    <div class="bb-apex-for-churches-challenges__inner">
      <div class="bb-apex-page-band__head bb-apex-page-band__head--center">
        <h2 class="bb-apex-page-band__title" id="fc-challenges">The Burden of Fragmentation</h2>
        <p class="bb-apex-page-band__lead">Ministry is about people, but administrative friction often gets in the way of meaningful connection.</p>
      </div>
      <div class="bb-apex-for-churches-challenges__grid">
        <article class="bb-apex-for-churches-challenge-card">
          <div class="bb-apex-for-churches-challenge-card__icon bb-apex-for-churches-challenge-card__icon--red" aria-hidden="true">
            <span class="material-symbols-outlined">cloud_off</span>
          </div>
          <h3>Disconnected Tools</h3>
          <p>Switching between multiple apps for giving, emails, and scheduling wastes precious time and fractures your data.</p>
        </article>
        <article class="bb-apex-for-churches-challenge-card">
          <div class="bb-apex-for-churches-challenge-card__icon bb-apex-for-churches-challenge-card__icon--amber" aria-hidden="true">
            <span class="material-symbols-outlined">edit_note</span>
          </div>
          <h3>Manual Tracking</h3>
          <p>Relying on paper sign-ups or outdated spreadsheets makes it impossible to see the real growth of your congregation.</p>
        </article>
        <article class="bb-apex-for-churches-challenge-card">
          <div class="bb-apex-for-churches-challenge-card__icon bb-apex-for-churches-challenge-card__icon--blue" aria-hidden="true">
            <span class="material-symbols-outlined">group_off</span>
          </div>
          <h3>Member Disengagement</h3>
          <p>When members feel like another number in a database, spiritual intimacy and active participation decline.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="bb-apex-for-churches-unified" aria-labelledby="fc-unified">
    <div class="bb-apex-for-churches-unified__inner">
      <div class="bb-apex-for-churches-unified__media">
        <div class="bb-apex-for-churches-unified__frame">
          <img src="/church/images/homepage/apex-feature-admin.jpg" alt="A clean church software dashboard on a tablet with soft violet accents" width="640" height="360" />
          <div class="bb-apex-for-churches-unified__badge" aria-hidden="true">
            <span class="bb-apex-for-churches-unified__badge-dot"></span>
            <span>Live Member Sync</span>
          </div>
        </div>
      </div>
      <div class="bb-apex-for-churches-unified__copy">
        <h2 class="bb-apex-page-split__title" id="fc-unified">A Unified Ministry Heartbeat</h2>
        <p class="bb-apex-page-split__lead">BlessBoard isn't just another database. It's a living ecosystem that centers your technology around your mission. We consolidate your workflows so you can focus on the shepherd's work.</p>
        <ul class="bb-apex-for-churches-feature-list">
          <li>
            <div class="bb-apex-for-churches-feature-list__icon" aria-hidden="true"><span class="material-symbols-outlined">hub</span></div>
            <div>
              <h3>Centralized Command</h3>
              <p>One login for everything—from first-time visitor tracking to long-term stewardship reporting.</p>
            </div>
          </li>
          <li>
            <div class="bb-apex-for-churches-feature-list__icon" aria-hidden="true"><span class="material-symbols-outlined">volunteer_activism</span></div>
            <div>
              <h3>Radical Member Focus</h3>
              <p>Profiles that tell a story of growth, serving gifts, and community involvement, not just contact info.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bb-apex-for-churches-toolkit" aria-labelledby="fc-toolkit">
    <div class="bb-apex-for-churches-toolkit__inner">
      <div class="bb-apex-page-band__head bb-apex-page-band__head--center">
        <h2 class="bb-apex-page-band__title" id="fc-toolkit">The Complete Ministry Toolkit</h2>
        <p class="bb-apex-page-band__lead">Three powerful interfaces, one seamless experience.</p>
      </div>
      <div class="bb-apex-for-churches-toolkit__grid">
        <article class="bb-apex-for-churches-toolkit-card">
          <div class="bb-apex-for-churches-toolkit-card__media">
            <img src="/church/images/homepage/apex-feature-website.jpg" alt="A mobile-friendly church website on a smartphone screen" width="400" height="256" />
          </div>
          <h3>Public Member Site</h3>
          <p>A beautiful, branded web presence where new visitors find your heart and current members stay informed about events and giving.</p>
        </article>
        <article class="bb-apex-for-churches-toolkit-card bb-apex-for-churches-toolkit-card--offset">
          <div class="bb-apex-for-churches-toolkit-card__media">
            <img src="/church/images/homepage/apex-feature-engagement.jpg" alt="A smartphone showing the BlessBoard member app in a church setting" width="400" height="256" />
          </div>
          <h3>Private Member App</h3>
          <p>A dedicated space for your congregation to engage. Prayer walls, small group messaging, and digital check-ins right in their pockets.</p>
        </article>
        <article class="bb-apex-for-churches-toolkit-card">
          <div class="bb-apex-for-churches-toolkit-card__media">
            <img src="/church/images/homepage/apex-feature-admin.jpg" alt="A church administrator reviewing analytics on a desktop monitor" width="400" height="256" />
          </div>
          <h3>Admin Portal</h3>
          <p>Comprehensive tools for your staff. Manage attendance, process gifts, and generate spiritual health reports with ease.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="bb-apex-for-churches-onboarding" aria-labelledby="fc-onboarding">
    <div class="bb-apex-for-churches-onboarding__inner">
      <div class="bb-apex-for-churches-onboarding__panel">
        <span class="material-symbols-outlined bb-apex-for-churches-onboarding__watermark" aria-hidden="true">steps</span>
        <h2 class="bb-apex-page-band__title" id="fc-onboarding">Launching Your New Board</h2>
        <ol class="bb-apex-for-churches-onboarding__steps">
          <li>
            <span class="bb-apex-for-churches-onboarding__num" aria-hidden="true">1</span>
            <h3>Sync Your Records</h3>
            <p>Our concierge service handles the migration of your existing member data, ensuring no one is left behind.</p>
          </li>
          <li>
            <span class="bb-apex-for-churches-onboarding__num" aria-hidden="true">2</span>
            <h3>Customize Branding</h3>
            <p>Apply your colors, logo, and unique ministry voice to create a seamless experience for your members.</p>
          </li>
          <li>
            <span class="bb-apex-for-churches-onboarding__num" aria-hidden="true">3</span>
            <h3>Go Live Together</h3>
            <p>Invite your team and launch to the congregation with our built-in announcement toolkit and training.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="bb-apex-for-churches-stewardship" aria-labelledby="fc-stewardship">
    <div class="bb-apex-for-churches-stewardship__inner">
      <div class="bb-apex-for-churches-stewardship__intro">
        <h2 class="bb-apex-page-split__title" id="fc-stewardship">Excellence in Stewardship</h2>
        <p class="bb-apex-page-split__lead">Every tool in BlessBoard is built to make the "boring stuff" efficient so the "eternal stuff" can flourish.</p>
        <a class="bb-apex-for-churches-stewardship__link" href="/features">
          Explore All Features
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
      <div class="bb-apex-for-churches-stewardship__grid">
        <article class="bb-apex-page-icon-card">
          <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
          <h3>Attendance Insights</h3>
          <p>Visual trends that help you see who's showing up and who might need a pastoral check-in.</p>
        </article>
        <article class="bb-apex-page-icon-card">
          <span class="material-symbols-outlined" aria-hidden="true">payments</span>
          <h3>Automated Giving</h3>
          <p>Secure, recurring giving options that integrate directly with your financial reporting.</p>
        </article>
        <article class="bb-apex-page-icon-card">
          <span class="material-symbols-outlined" aria-hidden="true">insights</span>
          <h3>Spiritual Reporting</h3>
          <p>Go beyond numbers. Track spiritual milestones like baptisms, group joins, and service hours.</p>
        </article>
        <article class="bb-apex-page-icon-card">
          <span class="material-symbols-outlined" aria-hidden="true">notifications_active</span>
          <h3>Smart Comms</h3>
          <p>Segmented email and SMS messaging to ensure the right people get the right message at the right time.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="bb-apex-for-churches-cta" aria-labelledby="fc-desktop-cta">
    <div class="bb-apex-for-churches-cta__inner">
      <div class="bb-apex-for-churches-cta__panel">
        <h2 class="bb-apex-for-churches-cta__title" id="fc-desktop-cta">Ready to transform your church's <span class="bb-apex-hero__accent">digital stewardship?</span></h2>
        <div class="bb-apex-hero__cta bb-apex-for-churches-cta__actions">
          <a class="church-btn church-btn--public-primary" href="<%= registerChurchPath %>">Begin Onboarding</a>
          <a class="church-btn church-btn--public-secondary" href="/contact">Schedule a Call</a>
        </div>
      </div>
    </div>
  </section>
</div>

<%# --- Mobile body --- %>
<div class="home-mobile-design">
  <section class="bb-apex-for-churches-mobile-bento" aria-labelledby="fc-mobile-touchpoints">
    <div class="bb-apex-for-churches-mobile-bento__inner">
      <div class="bb-apex-page-band__head bb-apex-page-band__head--center">
        <h2 class="bb-apex-page-stack__title" id="fc-mobile-touchpoints">Tools for every touchpoint</h2>
        <p class="bb-apex-page-stack__lead">Comprehensive modules designed for modern church life.</p>
      </div>
      <div class="bb-apex-for-churches-mobile-bento__stack">
        <article class="bb-apex-for-churches-mobile-bento-card">
          <div class="bb-apex-for-churches-mobile-bento-card__icon" aria-hidden="true">
            <span class="material-symbols-outlined">groups</span>
          </div>
          <h3>Community Connect</h3>
          <p>Streamline new member onboarding and small group coordination with automated workflows that feel personal.</p>
        </article>
        <article class="bb-apex-for-churches-mobile-bento-card">
          <div class="bb-apex-for-churches-mobile-bento-card__icon" aria-hidden="true">
            <span class="material-symbols-outlined">payments</span>
          </div>
          <h3>Smart Stewardship</h3>
          <p>Simplified giving reports and financial tracking that keeps your mission transparent and your donors engaged.</p>
        </article>
        <article class="bb-apex-for-churches-mobile-bento-card bb-apex-for-churches-mobile-bento-card--accent">
          <h3>Real-time Analytics</h3>
          <p>Understand your church's health with pulse dashboards that measure more than just attendance.</p>
          <div class="bb-apex-for-churches-mobile-bento-card__bars" role="img" aria-label="Illustrative example of an analytics bar chart. Sample values are not real church data.">
            <span style="--bar-height: 50%"></span>
            <span style="--bar-height: 75%"></span>
            <span style="--bar-height: 100%"></span>
            <span style="--bar-height: 66%"></span>
            <span style="--bar-height: 80%"></span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="bb-apex-for-churches-mobile-faithful" aria-labelledby="fc-mobile-faithful">
    <div class="bb-apex-for-churches-mobile-faithful__inner">
      <div class="bb-apex-for-churches-mobile-faithful__media">
        <img src="/church/images/giving/giving-qr-mobile.jpg" alt="Hands holding a smartphone with a church donation interface above a wooden pew" width="640" height="480" />
      </div>
      <div class="bb-apex-for-churches-mobile-faithful__copy">
        <h2 class="bb-apex-page-stack__title" id="fc-mobile-faithful">Faithful Management</h2>
        <p class="bb-apex-page-stack__lead">Our platform respects the sacred nature of your data. BlessBoard offers a user interface that anyone can master, from the tech team to the volunteer greeters.</p>
        <ul class="bb-apex-page-checks">
          <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> One-click tax receipt generation</li>
          <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Cross-platform access for staff on the go</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bb-apex-for-churches-mobile-cta" aria-labelledby="fc-mobile-cta">
    <div class="bb-apex-for-churches-mobile-cta__inner">
      <h2 class="bb-apex-for-churches-mobile-cta__title" id="fc-mobile-cta">Ready to grow your community?</h2>
      <div class="bb-apex-hero__cta bb-apex-hero__cta--stack">
        <a class="church-btn church-btn--public-primary church-btn--block" href="<%= registerChurchPath %>">Get Started Today</a>
        <a class="bb-apex-for-churches-mobile-cta__link" href="/contact">Schedule a personalized demo</a>
      </div>
    </div>
  </section>
</div>

<%- include('../partials/public_shell_end') %>
