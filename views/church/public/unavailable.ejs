<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= pageTitle || churchName %> | BlessBoard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=46"/>
</head>
<body class="church-body church-body--unavailable">
  <main class="church-unavailable">
    <div class="church-unavailable__card">
      <span class="material-symbols-outlined church-unavailable__icon" aria-hidden="true">info</span>
      <h1 class="church-unavailable__title">This church site is temporarily unavailable.</h1>
      <p class="church-unavailable__lead">
        <%= churchName %> is not accessible right now. Please check back later or contact the church office if you need assistance.
      </p>
    </div>
  </main>
</body>
</html>
