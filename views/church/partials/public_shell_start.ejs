<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= pageTitle %> | BlessBoard</title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : welcomeMessage %>"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=32"/>
</head>
<body class="church-body">
  <% if (typeof isPreview !== 'undefined' && isPreview) { %>
  <div class="church-preview-banner" role="status">Preview only — not visible to public until published.</div>
  <% } %>
  <header class="church-header">
    <div class="church-header__inner">
      <% if (isVerticalApex) { %>
      <%- include('./brand_lockup', { href: typeof isPreview !== 'undefined' && isPreview ? '/branch/website-preview' : '/' }) %>
      <% } else { %>
      <a class="church-brand church-brand--branch" href="<%= typeof isPreview !== 'undefined' && isPreview ? '/branch/website-preview' : '/' %>">
        <span class="church-brand-mark" aria-hidden="true">
          <span class="material-symbols-outlined">church</span>
        </span>
        <span class="church-brand__text"><%= churchName %></span>
      </a>
      <% } %>
      <nav class="church-nav" aria-label="Primary">
        <% if (!isVerticalApex) { %>
        <a href="<%= isPreview ? '/branch/website-preview' : '/' %>" class="<%= activePage === 'home' ? 'church-nav__active' : '' %>">Home</a>
        <a href="/about" class="<%= activePage === 'about' ? 'church-nav__active' : '' %>">About</a>
        <a href="/leadership" class="<%= activePage === 'leadership' ? 'church-nav__active' : '' %>">Leadership</a>
        <a href="/ministries" class="<%= activePage === 'ministries' ? 'church-nav__active' : '' %>">Ministries</a>
        <a href="/events" class="<%= activePage === 'events' ? 'church-nav__active' : '' %>">Events</a>
        <a href="/giving" class="<%= activePage === 'giving' ? 'church-nav__active' : '' %>">Giving</a>
        <a href="/contact" class="<%= activePage === 'contact' ? 'church-nav__active' : '' %>">Contact</a>
        <% } else { %>
        <a href="#welcome">Welcome</a>
        <a href="#events">Events</a>
        <a href="#giving">Giving</a>
        <% } %>
      </nav>
      <div class="church-header__actions">
        <% if (!isVerticalApex && !(typeof isPreview !== 'undefined' && isPreview)) { %>
        <a class="church-btn church-btn--ghost" href="/login">Member Login</a>
        <a class="church-btn church-btn--primary" href="/register">Register as Member</a>
        <% } %>
      </div>
      <% if (!isVerticalApex && !(typeof isPreview !== 'undefined' && isPreview)) { %>
      <button type="button" class="church-menu-btn" id="church-mobile-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="church-mobile-drawer">
        <span class="material-symbols-outlined" aria-hidden="true">menu</span>
      </button>
      <% } %>
    </div>
  </header>
  <% if (!isVerticalApex && !(typeof isPreview !== 'undefined' && isPreview)) { %>
  <div class="church-drawer-overlay" id="church-drawer-overlay" hidden></div>
  <aside class="church-drawer" id="church-mobile-drawer" aria-label="Mobile navigation" aria-hidden="true">
    <div class="church-drawer__head">
      <p class="church-drawer__title"><%= churchName %></p>
      <button type="button" class="church-drawer__close" id="church-drawer-close" aria-label="Close menu">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>
    <nav class="church-drawer__nav">
      <a href="/" class="<%= activePage === 'home' ? 'church-drawer__link--active' : '' %>">Home</a>
      <a href="/about" class="<%= activePage === 'about' ? 'church-drawer__link--active' : '' %>">About</a>
      <a href="/leadership" class="<%= activePage === 'leadership' ? 'church-drawer__link--active' : '' %>">Leadership</a>
      <a href="/ministries" class="<%= activePage === 'ministries' ? 'church-drawer__link--active' : '' %>">Ministries</a>
      <a href="/events" class="<%= activePage === 'events' ? 'church-drawer__link--active' : '' %>">Events</a>
      <a href="/sermons" class="<%= activePage === 'sermons' ? 'church-drawer__link--active' : '' %>">Sermons &amp; Resources</a>
      <a href="/giving" class="<%= activePage === 'giving' ? 'church-drawer__link--active' : '' %>">Giving</a>
      <a href="/contact" class="<%= activePage === 'contact' ? 'church-drawer__link--active' : '' %>">Contact</a>
    </nav>
    <div class="church-drawer__actions">
      <a class="church-btn church-btn--primary church-btn--block church-btn--mobile-pill" href="/register">Register as Member</a>
      <a class="church-btn church-btn--outline church-btn--block church-btn--mobile-pill" href="/login">Member Login</a>
      <p class="church-footer__powered">BlessBoard<span class="church-footer__powered-sub">Powered by GetPro</span></p>
    </div>
  </aside>
  <% } %>
  <main>
