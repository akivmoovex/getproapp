<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= pageTitle %> | GetPro Church</title>
  <meta name="description" content="<%= welcomeMessage %>"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=10"/>
</head>
<body class="church-body">
  <% if (typeof isPreview !== 'undefined' && isPreview) { %>
  <div class="church-preview-banner" role="status">Preview only — not visible to public until published.</div>
  <% } %>
  <header class="church-header">
    <div class="church-header__inner">
      <a class="church-brand" href="<%= typeof isPreview !== 'undefined' && isPreview ? '/branch/website-preview' : '/' %>">
        <span class="material-symbols-outlined church-brand__icon" aria-hidden="true">church</span>
        <span class="church-brand__text"><%= churchName %></span>
      </a>
      <nav class="church-nav" aria-label="Primary">
        <% if (!isVerticalApex) { %>
        <a href="<%= isPreview ? '/branch/website-preview' : '/' %>" class="<%= activePage === 'home' ? 'church-nav__active' : '' %>">Home</a>
        <a href="/about" class="<%= activePage === 'about' ? 'church-nav__active' : '' %>">About</a>
        <a href="/leadership" class="<%= activePage === 'leadership' ? 'church-nav__active' : '' %>">Leadership</a>
        <a href="/ministries" class="<%= activePage === 'ministries' ? 'church-nav__active' : '' %>">Ministries</a>
        <a href="/giving" class="<%= activePage === 'giving' ? 'church-nav__active' : '' %>">Giving</a>
        <a href="/contact" class="<%= activePage === 'contact' ? 'church-nav__active' : '' %>">Contact</a>
        <% } else { %>
        <a href="#welcome">Welcome</a>
        <a href="#events">Events</a>
        <a href="#giving">Giving</a>
        <% } %>
      </nav>
      <div class="church-header__actions">
        <% if (!isVerticalApex && !(typeof isPreview !== 'undefined' && isPreview)) { %>
        <a class="church-btn church-btn--ghost" href="/login">Member Login</a>
        <a class="church-btn church-btn--primary" href="/register">Register as Member</a>
        <% } %>
      </div>
    </div>
  </header>
  <% if (!isVerticalApex && !(typeof isPreview !== 'undefined' && isPreview)) { %>
  <nav class="church-public-mobile-nav" aria-label="Mobile section links">
    <a href="/" class="<%= activePage === 'home' ? 'church-public-mobile-nav__active' : '' %>">Home</a>
    <a href="/about" class="<%= activePage === 'about' ? 'church-public-mobile-nav__active' : '' %>">About</a>
    <a href="/leadership" class="<%= activePage === 'leadership' ? 'church-public-mobile-nav__active' : '' %>">Leadership</a>
    <a href="/ministries" class="<%= activePage === 'ministries' ? 'church-public-mobile-nav__active' : '' %>">Ministries</a>
    <a href="/giving" class="<%= activePage === 'giving' ? 'church-public-mobile-nav__active' : '' %>">Giving</a>
    <a href="/contact" class="<%= activePage === 'contact' ? 'church-public-mobile-nav__active' : '' %>">Contact</a>
  </nav>
  <% } %>
  <main>
