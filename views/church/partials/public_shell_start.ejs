<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <%
    var isPreviewMode = typeof isPreview !== 'undefined' && isPreview;
    var isApexMarketing = typeof isVerticalApex !== 'undefined' && isVerticalApex;
  %>
  <% if (isApexMarketing) { %>
  <%- include('./platform_public_seo') %>
  <% } else if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
  <%- include('./platform_public_seo') %>
  <% } else { %>
  <title><%= pageTitle %> | BlessBoard</title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : welcomeMessage %>"/>
  <% if (isPreviewMode || (typeof noindex !== 'undefined' && noindex)) { %>
  <meta name="robots" content="noindex, nofollow"/>
  <% } else { %>
  <meta name="robots" content="index, follow"/>
  <% } %>
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=63"/>
</head>
<%
  var isBranchHome = !isVerticalApex && activePage === 'home' && !isPreviewMode;
  var homeHref = isPreviewMode ? '/branch/website-preview' : '/';
%>
<body class="church-body<%= isVerticalApex ? ' church-body--apex' : ' church-body--branch' %><%= isBranchHome ? ' church-body--branch-home' : '' %>">
  <% if (isPreviewMode) { %>
  <div class="church-preview-banner" role="status">Preview only — not visible to public until published.</div>
  <% } %>

  <% if (isVerticalApex) { %>
  <header class="church-header church-header--apex">
    <div class="church-header__inner">
      <%- include('./brand_lockup', { href: '/' }) %>
      <nav class="church-nav church-nav--apex" aria-label="Primary">
        <%- include('./platform_nav_desktop') %>
      </nav>
      <div class="church-header__actions">
        <a class="church-header__admin-link" href="/churches?for=admin">Church Admin Login</a>
        <a class="church-btn church-btn--primary church-btn--pill church-header__cta" href="<%= typeof registerChurchPath !== 'undefined' ? registerChurchPath : '/register-church' %>">Register Your Church</a>
      </div>
      <button type="button" class="church-menu-btn" id="church-mobile-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="church-mobile-drawer">
        <span class="material-symbols-outlined" aria-hidden="true">menu</span>
      </button>
    </div>
  </header>
  <div class="church-drawer-overlay" id="church-drawer-overlay" hidden></div>
  <aside class="church-drawer church-drawer--apex" id="church-mobile-drawer" aria-label="Mobile navigation" aria-hidden="true">
    <div class="church-drawer__head">
      <p class="church-drawer__title">BlessBoard</p>
      <button type="button" class="church-drawer__close" id="church-drawer-close" aria-label="Close menu">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>
    <nav class="church-drawer__nav">
      <%- include('./platform_nav_drawer') %>
    </nav>
    <div class="church-drawer__actions">
      <a class="church-btn church-btn--primary church-btn--block church-btn--mobile-pill" href="<%= typeof registerChurchPath !== 'undefined' ? registerChurchPath : '/register-church' %>">Register Your Church</a>
      <a class="church-btn church-btn--outline church-btn--block church-btn--mobile-pill" href="/churches">Find a Church</a>
      <a class="church-btn church-btn--outline church-btn--block church-btn--mobile-pill" href="/churches?for=admin">Church Administrator Login</a>
      <p class="church-footer__powered">BlessBoard<span class="church-footer__powered-sub"><%- include('./powered_by_getpro') %></span></p>
    </div>
  </aside>
  <% } %>

  <% if (!isVerticalApex) { %>
  <header class="church-header church-header--branch<%= isBranchHome ? ' church-header--branch-home' : '' %>" data-tenant-header="1">
    <div class="church-header__inner church-header__inner--tenant">
      <%- include('./tenant_brand_lockup', { href: homeHref, compact: false }) %>
      <nav class="church-nav church-nav--branch" aria-label="Primary">
        <a href="<%= homeHref %>" class="<%= activePage === 'home' ? 'church-nav__active' : '' %>">Home</a>
        <a href="/about" class="<%= activePage === 'about' ? 'church-nav__active' : '' %>">About</a>
        <a href="/leadership" class="<%= activePage === 'leadership' ? 'church-nav__active' : '' %>">Leadership</a>
        <a href="/ministries" class="<%= activePage === 'ministries' ? 'church-nav__active' : '' %>">Ministries</a>
        <a href="/events" class="<%= activePage === 'events' ? 'church-nav__active' : '' %>">Events</a>
        <a href="/sermons" class="<%= activePage === 'sermons' ? 'church-nav__active' : '' %>">Sermons</a>
        <a href="/contact" class="<%= activePage === 'contact' ? 'church-nav__active' : '' %>">Contact</a>
        <a href="/giving" class="<%= activePage === 'giving' ? 'church-nav__active' : '' %>">Giving</a>
      </nav>
      <div class="church-header__actions">
        <% if (!isPreviewMode) { %>
        <a class="church-btn church-btn--ghost" href="/login">Member Login</a>
        <a class="church-btn church-btn--primary church-btn--pill" href="/register">Register as a Member</a>
        <% } %>
      </div>
      <% if (!isPreviewMode) { %>
      <button type="button" class="church-menu-btn church-menu-btn--tenant" id="church-mobile-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="church-mobile-drawer">
        <span class="material-symbols-outlined" aria-hidden="true">menu</span>
      </button>
      <% } %>
    </div>
  </header>
  <% } %>

  <% if (!isVerticalApex && !isPreviewMode) { %>
  <div class="church-drawer-overlay" id="church-drawer-overlay" hidden></div>
  <aside class="church-drawer" id="church-mobile-drawer" aria-label="Mobile navigation" aria-hidden="true">
    <div class="church-drawer__head church-drawer__head--tenant">
      <%- include('./tenant_brand_lockup', { href: '/', compact: true, showBranchOnCompact: true }) %>
      <button type="button" class="church-drawer__close" id="church-drawer-close" aria-label="Close menu">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>
    <nav class="church-drawer__nav">
      <a href="/" class="<%= activePage === 'home' ? 'church-drawer__link--active' : '' %>">Home</a>
      <a href="/about" class="<%= activePage === 'about' ? 'church-drawer__link--active' : '' %>">About</a>
      <a href="/leadership" class="<%= activePage === 'leadership' ? 'church-drawer__link--active' : '' %>">Leadership</a>
      <a href="/ministries" class="<%= activePage === 'ministries' ? 'church-drawer__link--active' : '' %>">Ministries</a>
      <a href="/events" class="<%= activePage === 'events' ? 'church-drawer__link--active' : '' %>">Events</a>
      <a href="/sermons" class="<%= activePage === 'sermons' ? 'church-drawer__link--active' : '' %>">Sermons &amp; Resources</a>
      <a href="/giving" class="<%= activePage === 'giving' ? 'church-drawer__link--active' : '' %>">Giving</a>
      <a href="/contact" class="<%= activePage === 'contact' ? 'church-drawer__link--active' : '' %>">Contact</a>
    </nav>
    <div class="church-drawer__actions">
      <a class="church-btn church-btn--primary church-btn--block church-btn--mobile-pill" href="/register">Register as a Member</a>
      <a class="church-btn church-btn--outline church-btn--block church-btn--mobile-pill" href="/login">Member Login</a>
    </div>
  </aside>
  <% } %>
  <main>
