<% if (typeof planContext !== 'undefined' && planContext && (planContext.warnings || []).length > 0) { %>
  <% planContext.warnings.forEach(function (warning) { %>
  <div class="church-alert <%= warning.level === 'limit' ? 'church-alert--warning' : 'church-alert--info' %>" role="status">
    <%= warning.message %>
  </div>
  <% }); %>
<% } %>
<% if (typeof planContext !== 'undefined' && planContext && planContext.seatUsage) { %>
  <p class="church-branch-panel__hint" style="margin-top:0.5rem;">
    Package seats (<%= planContext.seatUsage.packageLabel %>):
    members <%= planContext.seatUsage.membersDisplay %>;
    administrators/leadership <%= planContext.seatUsage.adminsDisplay %>.
  </p>
<% } %>
