<%#
  Branch directory card.
  Locals: branch, church, intent ('admin' | 'member')
%>
<% var visitAria = intent === 'admin'
  ? 'Continue to administrator login for ' + church.name + ', ' + branch.name
  : 'Visit ' + church.name + ', ' + branch.name; %>
<article class="bb-finder__card bb-finder__card--branch bb-apex-directory-card">
  <div class="bb-apex-directory-card__top">
    <div class="bb-finder__logo bb-apex-directory-card__logo" aria-hidden="true">
      <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
    </div>
  </div>
  <div class="bb-finder__card-main">
    <p class="bb-finder__org-name"><%= church.name %></p>
    <h2 class="bb-finder__name bb-apex-directory-card__name"><%= branch.name %></h2>
    <% if (branch.location_line) { %>
    <p class="bb-apex-directory-card__location bb-finder__meta">
      <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
      <span><%= branch.location_line %></span>
    </p>
    <% } %>
    <% if (branch.short_description) { %>
    <p class="bb-finder__desc bb-apex-directory-card__desc"><%= branch.short_description %></p>
    <% } %>
    <dl class="bb-finder__facts bb-apex-directory-card__facts home-desktop-design">
      <% if (branch.service_times_label) { %>
      <dt>Service times</dt>
      <dd><%= branch.service_times_label %></dd>
      <% } %>
      <% if (branch.registration_label) { %>
      <dt>Registration</dt>
      <dd><%= branch.registration_label %></dd>
      <% } %>
    </dl>
  </div>
  <div class="bb-apex-directory-card__actions">
    <% if (branch.service_times_label || branch.registration_label) { %>
    <div class="bb-apex-directory-card__footer home-mobile-design">
      <% if (branch.service_times_label) { %>
      <div class="bb-apex-directory-card__footer-detail">
        <p class="bb-apex-directory-card__footer-label">Service times</p>
        <p class="bb-apex-directory-card__footer-value"><%= branch.service_times_label %></p>
      </div>
      <% } else if (branch.registration_label) { %>
      <div class="bb-apex-directory-card__footer-detail">
        <p class="bb-apex-directory-card__footer-label">Registration</p>
        <p class="bb-apex-directory-card__footer-value"><%= branch.registration_label %></p>
      </div>
      <% } %>
    </div>
    <% } %>
    <form method="post" action="/churches/<%= encodeURIComponent(church.slug) %>/branches/<%= encodeURIComponent(branch.slug) %>/open">
      <% if (intent === 'admin') { %>
      <input type="hidden" name="for" value="admin"/>
      <% } %>
      <button type="submit" class="bb-apex-directory-card__cta church-btn church-btn--primary church-btn--pill bb-finder__visit" aria-label="<%= visitAria %>">
        <%= intent === 'admin' ? 'Continue to Admin Login' : branch.visit_label %>
      </button>
    </form>
  </div>
</article>
