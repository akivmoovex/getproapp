  </main>
  <%
    var isPreviewMode = typeof isPreview !== 'undefined' && isPreview;
    var isBranchHome = !isVerticalApex && activePage === 'home' && !isPreviewMode;
  %>
  <% if (isVerticalApex) { %>
  <footer class="church-footer church-footer--apex">
    <div class="church-footer__inner church-footer__inner--apex">
      <div class="church-footer__grid">
        <div class="church-footer__brand-block">
          <div class="church-footer__brand-row">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">church</span>
            <span>BlessBoard</span>
          </div>
          <p class="church-footer__tagline">Building the digital foundation for the global church community.</p>
          <p class="church-footer__powered-line"><%- include('./powered_by_getpro') %></p>
        </div>
        <nav class="church-footer__col" aria-label="Product">
          <h2 class="church-footer__col-title">Product</h2>
          <a href="/features">Features</a>
          <a href="/pricing">Pricing</a>
          <a href="/for-churches">For Churches</a>
          <a href="/multi-branch">Multi-Branch</a>
          <a href="/faq">FAQ</a>
        </nav>
        <nav class="church-footer__col" aria-label="Company">
          <h2 class="church-footer__col-title">Company</h2>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </nav>
        <div class="church-footer__col church-footer__col--support">
          <h2 class="church-footer__col-title">Support</h2>
          <a href="/support">Support</a>
          <a href="/security">Security</a>
          <a href="/demo">Demo</a>
          <a href="/churches">Find a Church</a>
        </div>
      </div>
      <p class="church-footer__legal">© <%= new Date().getFullYear() %> BlessBoard. <%- include('./powered_by_getpro') %>. All rights reserved.</p>
    </div>
  </footer>
  <% } %>
  <% if (!isVerticalApex) { %>
  <footer class="church-footer church-footer--branch">
    <div class="church-footer__inner church-footer__inner--branch">
      <div class="church-footer__branch-brand">
        <span class="church-footer__branch-icon" aria-hidden="true">
          <span class="material-symbols-outlined">church</span>
        </span>
        <span><%= churchName %></span>
      </div>
      <div class="church-footer__branch-links">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </div>
      <div class="church-footer__branch-meta">
        <p>© <%= new Date().getFullYear() %> <%= churchName %>. All rights reserved.</p>
        <p class="church-footer__powered-line"><%- include('./powered_by_getpro') %></p>
      </div>
    </div>
  </footer>
  <% if (!isPreviewMode && isBranchHome) { %>
  <a class="church-fab-chat home-mobile-design" href="/contact" aria-label="Contact us">
    <span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span>
  </a>
  <% } %>
  <% } %>
  <script>
    (function () {
      var menuBtn = document.getElementById("church-mobile-menu-btn");
      var drawer = document.getElementById("church-mobile-drawer");
      var overlay = document.getElementById("church-drawer-overlay");
      var closeBtn = document.getElementById("church-drawer-close");
      if (!menuBtn || !drawer || !overlay) return;

      function openDrawer() {
        drawer.classList.add("is-open");
        overlay.classList.add("is-open");
        overlay.hidden = false;
        drawer.setAttribute("aria-hidden", "false");
        menuBtn.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      }

      function closeDrawer() {
        drawer.classList.remove("is-open");
        overlay.classList.remove("is-open");
        drawer.setAttribute("aria-hidden", "true");
        menuBtn.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
        window.setTimeout(function () {
          if (!drawer.classList.contains("is-open")) overlay.hidden = true;
        }, 250);
      }

      menuBtn.addEventListener("click", openDrawer);
      if (closeBtn) closeBtn.addEventListener("click", closeDrawer);
      overlay.addEventListener("click", closeDrawer);
      drawer.querySelectorAll("a").forEach(function (link) {
        link.addEventListener("click", closeDrawer);
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeDrawer();
      });
    })();
  </script>
  <script>
    (function () {
      var dropdowns = document.querySelectorAll("[data-nav-dropdown]");
      if (!dropdowns.length) return;

      dropdowns.forEach(function (dropdown) {
        var trigger = dropdown.querySelector(".church-nav-dropdown__trigger");
        var menu = dropdown.querySelector(".church-nav-dropdown__menu");
        if (!trigger || !menu) return;

        function menuItems() {
          return Array.prototype.slice.call(menu.querySelectorAll('[role="menuitem"]'));
        }

        function openMenu() {
          dropdown.classList.add("is-open");
          trigger.setAttribute("aria-expanded", "true");
          menu.removeAttribute("hidden");
        }

        function closeMenu() {
          dropdown.classList.remove("is-open");
          trigger.setAttribute("aria-expanded", "false");
          menu.setAttribute("hidden", "");
        }

        function isOpen() {
          return dropdown.classList.contains("is-open");
        }

        trigger.addEventListener("click", function () {
          if (isOpen()) closeMenu();
          else openMenu();
        });

        trigger.addEventListener("keydown", function (e) {
          if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            openMenu();
            var first = menuItems()[0];
            if (first) first.focus();
          }
          if (e.key === "Escape") {
            closeMenu();
          }
        });

        menu.addEventListener("keydown", function (e) {
          var items = menuItems();
          var index = items.indexOf(document.activeElement);
          if (e.key === "Escape") {
            e.preventDefault();
            closeMenu();
            trigger.focus();
          }
          if (e.key === "ArrowDown" && index < items.length - 1) {
            e.preventDefault();
            items[index + 1].focus();
          }
          if (e.key === "ArrowUp") {
            e.preventDefault();
            if (index <= 0) {
              closeMenu();
              trigger.focus();
            } else {
              items[index - 1].focus();
            }
          }
        });

        dropdown.addEventListener("focusout", function (e) {
          var next = e.relatedTarget;
          if (next && dropdown.contains(next)) return;
          closeMenu();
        });

        document.addEventListener("click", function (e) {
          if (!dropdown.contains(e.target)) closeMenu();
        });
      });
    })();
  </script>
</body>
</html>
