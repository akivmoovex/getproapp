<%
  var _active = typeof activePage !== 'undefined' ? activePage : '';
  var _compact = typeof compactNav !== 'undefined' && compactNav;
  var _homeClass = _active === 'home' ? ' church-nav__active' : '';
  var _featuresClass = _active === 'features' ? ' church-nav__active' : '';
  var _forChurchesClass = _active === 'for-churches' ? ' church-nav__active' : '';
  var _multiBranchClass = _active === 'multi-branch' ? ' church-nav__active' : '';
  var _churchesClass = _active === 'churches' ? ' church-nav__active' : '';
  var _aboutClass = _active === 'about' ? ' church-nav__active' : '';
  var _contactClass = _active === 'contact' ? ' church-nav__active' : '';
%>
<a href="/" class="<%= _homeClass.trim() %>">Home</a>
<a href="/features" class="<%= _featuresClass.trim() %>">Features</a>
<a href="/for-churches" class="<%= _forChurchesClass.trim() %>">For Churches</a>
<% if (!_compact) { %>
<a href="/multi-branch" class="<%= _multiBranchClass.trim() %>">Multi-Branch</a>
<% } %>
<a href="/churches" class="<%= _churchesClass.trim() %>">Find a Church</a>
<a href="/about" class="<%= _aboutClass.trim() %>">About</a>
<a href="/contact" class="<%= _contactClass.trim() %>">Contact</a>
