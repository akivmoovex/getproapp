</a>
<a href="/branch/prayer-requests" class="<%= navClass('prayer') %>">
  <span class="material-symbols-outlined" aria-hidden="true">volunteer_activism</span>
  <span>Prayer</span>
</a>
<a href="/branch/reset-requests" class="<%= navClass('reset') %>">
  <span class="material-symbols-outlined" aria-hidden="true">lock_reset</span>
  <span>Reset Inbox<% if (_resetInboxPending > 0) { %><span class="church-nav-count"><%= _resetInboxPending %></span><% } %></span>
</a>
<a href="/branch/leaders" class="<%= navClass('leaders') %>">
