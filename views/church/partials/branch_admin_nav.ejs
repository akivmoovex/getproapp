<%
  var _nav = typeof navActive !== 'undefined' ? navActive : '';
  var _resetInboxPending = typeof branchResetInboxPendingCount !== 'undefined' ? branchResetInboxPendingCount : 0;
  function navClass(key) {
    return 'church-branch-nav-link' + (_nav === key ? ' church-branch-nav-link--active' : '');
  }
%>
<a href="/branch/dashboard" class="<%= navClass('dashboard') %>">
  <span class="material-symbols-outlined" aria-hidden="true">dashboard</span>
  <span>Dashboard</span>
</a>
<a href="/branch/member-verification" class="<%= navClass('verification') %>">
  <span class="material-symbols-outlined" aria-hidden="true">how_to_reg</span>
  <span>Verification</span>
</a>
<a href="/branch/members" class="<%= navClass('members') %>">
  <span class="material-symbols-outlined" aria-hidden="true">group</span>
  <span>Members</span>
</a>
<a href="/branch/ministries" class="<%= navClass('ministries') %>">
  <span class="material-symbols-outlined" aria-hidden="true">church</span>
  <span>Ministries</span>
</a>
<a href="/branch/events" class="<%= navClass('events') %>">
  <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
  <span>Events</span>
</a>
<a href="/branch/attendance" class="<%= navClass('attendance') %>">
  <span class="material-symbols-outlined" aria-hidden="true">fact_check</span>
  <span>Attendance</span>
</a>
<% if (typeof packageFeatureNav !== 'undefined' && packageFeatureNav && packageFeatureNav.length) { %>
  <% packageFeatureNav.forEach(function (item) { %>
<a href="<%= item.path %>" class="<%= navClass(item.navKey) %>">
  <span class="material-symbols-outlined" aria-hidden="true"><%= item.state === 'upgrade' ? 'lock_open' : 'verified' %></span>
  <span><%= item.label %></span><% if (item.state === 'upgrade') { %> <span class="church-plan-lock">Upgrade</span><% } %>
</a>
  <% }); %>
<% } %>
<a href="/branch/reports" class="<%= navClass('reports') %>">
  <span class="material-symbols-outlined" aria-hidden="true">analytics</span>
  <span>Reports</span>
</a>
<a href="/branch/announcements" class="<%= navClass('announcements') %>">
  <span class="material-symbols-outlined" aria-hidden="true">campaign</span>
  <span>Announcements</span>
</a>
<a href="/branch/website-editor" class="<%= navClass('website') %>">
  <span class="material-symbols-outlined" aria-hidden="true">web</span>
  <span>Website Editor</span>
</a>
<a href="/branch/requests" class="<%= navClass('requests') %>">
  <span class="material-symbols-outlined" aria-hidden="true">inbox</span>
  <span>Requests</span>
</a>
<a href="/branch/departments" class="<%= navClass('departments') %>">
  <span class="material-symbols-outlined" aria-hidden="true">account_tree</span>
  <span>Departments</span>
</a>
<a href="/branch/duty-roster" class="<%= navClass('duty') %>">
  <span class="material-symbols-outlined" aria-hidden="true">assignment_ind</span>
  <span>Duty Roster</span>
</a>
<a href="/branch/sermons" class="<%= navClass('sermons') %>">
  <span class="material-symbols-outlined" aria-hidden="true">mic</span>
  <span>Sermons</span>
</a>
<a href="/branch/resources" class="<%= navClass('resources') %>">
  <span class="material-symbols-outlined" aria-hidden="true">folder</span>
  <span>Resources</span>
</a>
<a href="/branch/contact-submissions" class="<%= navClass('contact') %>">
  <span class="material-symbols-outlined" aria-hidden="true">mail</span>
  <span>Contact</span>
</a>
<a href="/branch/giving-summary" class="<%= navClass('giving-summary') %>">
