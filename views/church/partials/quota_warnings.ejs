<%
  var _quotaWarnings = [];
  if (typeof quotaWarnings !== 'undefined' && quotaWarnings && quotaWarnings.length) {
    _quotaWarnings = quotaWarnings;
  } else if (typeof packageUsage !== 'undefined' && packageUsage && packageUsage.quotaWarnings) {
    _quotaWarnings = packageUsage.quotaWarnings;
  } else if (typeof planContext !== 'undefined' && planContext && planContext.quotaWarnings) {
    _quotaWarnings = planContext.quotaWarnings;
  }
%>
<% if (_quotaWarnings && _quotaWarnings.length) { %>
  <% _quotaWarnings.forEach(function (w) { %>
  <div class="church-alert <%= w.alertClass || (w.band >= 90 ? 'church-alert--warning' : 'church-alert--info') %>" role="<%= w.role || (w.band >= 100 ? 'alert' : 'status') %>" data-quota-band="<%= w.band %>" data-quota-meter="<%= w.meterKey %>">
    <strong><%= w.title %></strong>
    <span> <%= w.message %></span>
    <% if (w.band != null) { %><span class="visually-hidden"> Usage band <%= w.band %> percent.</span><% } %>
    <% if (w.existingDataNote) { %><span> <%= w.existingDataNote %></span><% } %>
    <% if (w.guidance) { %><span> <%= w.guidance %></span><% } %>
  </div>
  <% }); %>
<% } %>
