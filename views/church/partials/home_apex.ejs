<%# BlessBoard apex platform entrance — Find Your Church flow %>
<%
  var isApex = typeof isVerticalApex !== 'undefined' && isVerticalApex;
  var remembered = typeof rememberedChurch !== 'undefined' ? rememberedChurch : null;
%>
<% if (isApex) { %>
<section class="bb-saas-hero home-desktop-design bb-apex-hero" id="welcome">
  <div class="bb-saas-hero__inner">
    <div class="bb-saas-hero__copy">
      <span class="bb-saas-pill">BlessBoard</span>
      <h1 class="bb-saas-hero__title">
        Find and connect with <span class="bb-saas-hero__brand">your church</span>
      </h1>
      <p class="bb-saas-hero__lead">
        BlessBoard helps members find their church, open the right branch homepage, and sign in or register with their congregation.
      </p>

      <% if (remembered) { %>
      <div class="bb-remembered" data-remembered-church="1">
        <p class="bb-remembered__label">Continue to your church</p>
        <p class="bb-remembered__church"><%= remembered.churchName %></p>
        <p class="bb-remembered__branch"><%= remembered.branchName %></p>
        <div class="bb-saas-hero__cta">
          <a class="church-btn church-btn--primary church-btn--lg bb-saas-btn--pill" href="<%= remembered.continueUrl %>">
            Continue
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
          <a class="church-btn church-btn--outline church-btn--lg bb-saas-btn--pill" href="/churches">Choose another church</a>
        </div>
        <form method="post" action="/churches/preference/clear" class="bb-remembered__clear">
          <button type="submit" class="bb-remembered__clear-btn">Forget this church</button>
        </form>
      </div>
      <% } else { %>
      <div class="bb-saas-hero__cta">
        <a class="church-btn church-btn--primary church-btn--lg bb-saas-btn--pill" href="/churches">
          Find Your Church
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>
        <a class="church-btn church-btn--outline church-btn--lg bb-saas-btn--pill" href="/churches?for=admin">Church Administrator Login</a>
      </div>
      <% } %>
    </div>
    <div class="bb-saas-hero__visual">
      <div class="bb-saas-hero__glow" aria-hidden="true"></div>
      <div class="bb-saas-hero__frame">
        <img
          class="bb-saas-hero__img"
          src="/church/images/homepage/desktop-hero-auditorium.jpg"
          alt="Welcoming church congregation during a modern service"
          width="800"
          height="600"
        />
      </div>
    </div>
  </div>
</section>

<section class="bb-saas-features home-desktop-design" id="features">
  <div class="bb-saas-features__inner">
    <div class="bb-saas-features__header">
      <h2 class="bb-saas-features__title">How BlessBoard helps</h2>
      <p class="bb-saas-features__subtitle">
        Find your church, open your branch site, then log in or register as a member — without guessing the right address.
      </p>
    </div>
    <div class="bb-saas-bento">
      <article class="bb-saas-bento__card">
        <div class="bb-saas-bento__icon bb-saas-bento__icon--primary">
          <span class="material-symbols-outlined" aria-hidden="true">search</span>
        </div>
        <h3>Find your church</h3>
        <p>Search by church name, branch, or town among active congregations on BlessBoard.</p>
      </article>
      <article class="bb-saas-bento__card">
        <div class="bb-saas-bento__icon bb-saas-bento__icon--secondary">
          <span class="material-symbols-outlined" aria-hidden="true">home</span>
        </div>
        <h3>Open your branch</h3>
        <p>Go straight to your church’s public homepage with the right branch context.</p>
      </article>
      <article class="bb-saas-bento__card">
        <div class="bb-saas-bento__icon bb-saas-bento__icon--tertiary">
          <span class="material-symbols-outlined" aria-hidden="true">login</span>
        </div>
        <h3>Sign in or register</h3>
        <p>Use Member Login or Register as a Member on your church site — your congregation stays in context.</p>
      </article>
    </div>
  </div>
</section>

<section class="bb-saas-cta home-desktop-design" id="pricing">
  <div class="bb-saas-cta__inner">
    <div class="bb-saas-cta__card">
      <h2>Ready to connect with your church?</h2>
      <p>Search the BlessBoard directory and open your congregation’s homepage.</p>
      <div class="bb-saas-cta__actions">
        <a class="church-btn church-btn--lg bb-saas-btn--pill bb-saas-btn--cta-primary" href="/churches">Find Your Church</a>
        <a class="church-btn church-btn--lg bb-saas-btn--pill bb-saas-btn--cta-outline" href="/churches?for=admin">Church Administrator Login</a>
      </div>
    </div>
  </div>
</section>
<% } else { %>
<%# Tenant desktop fallback — keep relative member actions on the branch host %>
<section class="bb-saas-hero home-desktop-design" id="welcome-desktop">
  <div class="bb-saas-hero__inner">
    <div class="bb-saas-hero__copy">
      <span class="bb-saas-pill"><%= typeof organizationName !== 'undefined' && organizationName ? organizationName : churchName %></span>
      <h1 class="bb-saas-hero__title"><%= heroTitle || churchName %></h1>
      <p class="bb-saas-hero__lead"><%= welcomeMessage %></p>
      <% if (typeof branchName !== 'undefined' && branchName) { %>
      <p class="bb-tenant-branch-label">Branch: <%= branchName %></p>
      <% } %>
      <div class="bb-saas-hero__cta">
        <a class="church-btn church-btn--primary church-btn--lg bb-saas-btn--pill" href="/login">Member Login</a>
        <a class="church-btn church-btn--outline church-btn--lg bb-saas-btn--pill" href="/register">Register as a Member</a>
      </div>
    </div>
    <div class="bb-saas-hero__visual">
      <div class="bb-saas-hero__glow" aria-hidden="true"></div>
      <div class="bb-saas-hero__frame">
        <img
          class="bb-saas-hero__img"
          src="/church/images/homepage/desktop-hero-auditorium.jpg"
          alt="Welcoming church congregation during a modern service"
          width="800"
          height="600"
        />
      </div>
    </div>
  </div>
</section>
<% } %>
