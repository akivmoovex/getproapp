<div class="church-package-feature-upgrade" role="status">
  <h2 class="church-branch-panel__title"><%= packageFeatureUi.feature.name %></h2>
  <p class="church-branch-panel__hint">
    Current package: <strong><%= packageFeatureUi.packageLabel %></strong>.
    Required: <strong><%= packageFeatureUi.requiredPackageLabel %></strong>.
  </p>
  <p><%= packageFeatureUi.feature.benefit %></p>
  <p>
    <a class="church-btn church-btn--primary" href="<%= packageFeatureUi.accountPath %>">View package &amp; account</a>
  </p>
</div>
