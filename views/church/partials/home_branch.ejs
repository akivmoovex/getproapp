<%
  var isPreviewMode = typeof isPreview !== 'undefined' && isPreview;
  var orgLabel = (typeof organizationName !== 'undefined' && organizationName) ? organizationName : churchName;
  var branchLabel = (typeof branchName !== 'undefined' && branchName) ? branchName : '';
  var showBranchDistinct = branchLabel && orgLabel && String(branchLabel) !== String(orgLabel);
  var heroHeading = heroTitle || (orgLabel ? ('Welcome to ' + orgLabel) : churchName);
  var heroLead = welcomeMessage || '';
  var heroEyebrow = heroSubtitle || (showBranchDistinct ? branchLabel : (orgLabel || 'Welcome'));
  var events = (typeof upcomingEvents !== 'undefined' && Array.isArray(upcomingEvents)) ? upcomingEvents.slice(0, 6) : [];
  var hasRealEvents = typeof hasDbEvents !== 'undefined' ? !!hasDbEvents : false;
  var announcements = (typeof publicAnnouncements !== 'undefined' && Array.isArray(publicAnnouncements)) ? publicAnnouncements.slice(0, 3) : [];
  var homeMinistriesList = [];
  if (typeof publicMinistries !== 'undefined' && publicMinistries && publicMinistries.length) {
    homeMinistriesList = publicMinistries.slice(0, 4);
  } else if (typeof ministries !== 'undefined' && Array.isArray(ministries) && ministries.length) {
    homeMinistriesList = ministries.slice(0, 4);
  }
  var ministryIcons = ['groups', 'child_care', 'volunteer_activism', 'music_note', 'menu_book', 'favorite'];
  var homeFeaturedSermon = (typeof featuredSermon !== 'undefined' && featuredSermon) ? featuredSermon : null;
  var hasRealSermons = typeof hasDbSermons !== 'undefined' ? !!hasDbSermons : false;
  var serviceInfo = (typeof serviceTimes !== 'undefined' && serviceTimes) ? String(serviceTimes).trim() : '';
  var visitLocation = (typeof locationText !== 'undefined' && locationText) ? locationText : ((typeof address !== 'undefined' && address) ? address : '');
  var visitPhone = (typeof contactPhone !== 'undefined' && contactPhone) ? contactPhone : '';
  var visitEmail = (typeof contactEmail !== 'undefined' && contactEmail) ? contactEmail : '';
  var givingIntro = (typeof givingTeaser !== 'undefined' && givingTeaser) ? String(givingTeaser).trim() : '';
  var hasVisitDetails = !!(visitLocation || visitPhone || visitEmail);
  var heroImageUrl = (typeof heroImageUrl !== 'undefined' && heroImageUrl) ? String(heroImageUrl).trim() : '';
  var hasHeroImage = !!heroImageUrl;
  var serviceLines = serviceInfo ? serviceInfo.split('\n').map(function (l) { return l.trim(); }).filter(Boolean) : [];
%>

<section class="bb-tenant-home church-home-page church-home-desktop church-home-mobile" data-tenant-home="1" data-home-layout="responsive">
  <span class="bb-tenant-home__desktop-marker home-desktop-design" hidden aria-hidden="true"></span>
  <span class="bb-tenant-home__mobile-marker home-mobile-design" hidden aria-hidden="true"></span>

  <%# —— Hero —— %>
  <section class="bb-tenant-hero" id="welcome" aria-label="Welcome">
    <div class="bb-tenant-hero__inner">
      <div class="bb-tenant-hero__copy">
        <span class="bb-tenant-hero__badge"><%= heroEyebrow %></span>
        <h1 class="bb-tenant-hero__title"><%= heroHeading %></h1>
        <% if (heroLead) { %>
        <p class="bb-tenant-hero__lead"><%= heroLead %></p>
        <% } %>
        <% if (!isPreviewMode) { %>
        <div class="bb-tenant-hero__cta">
          <a class="church-btn church-btn--public-primary bb-tenant-hero__cta-primary" href="/events">
            <span class="bb-tenant-hero__cta-label bb-tenant-hero__cta-label--desktop">Join a Service</span>
            <span class="bb-tenant-hero__cta-label bb-tenant-hero__cta-label--mobile">Join Our Next Service</span>
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
          <a class="church-btn church-btn--public-secondary bb-tenant-hero__cta-giving" href="/giving">
            <span class="material-symbols-outlined" aria-hidden="true">favorite</span>
            Giving
          </a>
          <a class="church-btn church-btn--public-secondary bb-tenant-hero__cta-ministries" href="/ministries">Explore Ministries</a>
        </div>
        <% } %>
      </div>
      <div class="bb-tenant-hero__visual<%= hasHeroImage ? ' bb-tenant-hero__visual--has-image' : ' bb-tenant-hero__visual--fallback' %>">
        <% if (hasHeroImage) { %>
        <img class="bb-tenant-hero__img" src="<%= heroImageUrl %>" alt="" width="960" height="720"/>
        <% } else { %>
        <div class="bb-tenant-hero__fallback" aria-hidden="true"></div>
        <% } %>
      </div>
    </div>
  </section>

  <%# —— Weekly service times (mobile early; desktop via hub rail) —— %>
  <% if (serviceInfo) { %>
  <section class="bb-tenant-service" aria-label="Weekly service times">
    <div class="bb-tenant-section__inner">
      <article class="bb-tenant-service__card bb-tenant-service__card--schedule">
        <div class="bb-tenant-service__icon" aria-hidden="true"><span class="material-symbols-outlined">calendar_month</span></div>
        <div class="bb-tenant-service__content">
          <h2 class="bb-tenant-service__title">Weekly Service Times</h2>
          <ul class="bb-tenant-service__list">
            <% serviceLines.forEach(function (line) { %>
            <li><%= line %></li>
            <% }); %>
          </ul>
          <% if (!isPreviewMode && visitLocation) { %>
          <a class="bb-tenant-inline-link" href="/contact">Get Directions <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
          <% } else if (!isPreviewMode) { %>
          <a class="bb-tenant-inline-link" href="/contact">Contact for directions <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
          <% } %>
        </div>
      </article>
    </div>
  </section>
  <% } %>

  <%# —— Connected community shortcuts (mobile Stitch; compact on desktop) —— %>
  <% if (!isPreviewMode) { %>
  <section class="bb-tenant-community" id="giving" aria-label="Connected community">
    <div class="bb-tenant-section__inner">
      <h2 class="bb-tenant-section__title bb-tenant-community__title">Connected Community</h2>
      <div class="bb-tenant-community__grid">
        <a class="bb-tenant-community__card bb-tenant-community__card--giving" href="/giving">
          <span class="material-symbols-outlined" aria-hidden="true">volunteer_activism</span>
          <h3>Digital Giving</h3>
          <p><%= givingIntro || 'Support our mission safely and securely.' %></p>
          <span class="church-btn church-btn--on-primary church-btn--sm">Give Now</span>
        </a>
        <a class="bb-tenant-community__card" href="/events">
          <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
          <h3>Events</h3>
          <p>Stay updated on our latest gatherings.</p>
        </a>
        <a class="bb-tenant-community__card" href="/sermons">
          <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
          <h3>Resources</h3>
          <p>Sermon notes and digital materials.</p>
        </a>
      </div>
    </div>
  </section>
  <% } %>

  <%# —— Hub: announcements/events + desktop rail —— %>
  <div class="bb-tenant-hub">
    <div class="bb-tenant-hub__main">
      <section class="bb-tenant-announcements" id="announcements" aria-label="Announcements">
        <div class="bb-tenant-section__head">
          <div>
            <h2 class="bb-tenant-section__title">Announcements</h2>
            <p class="bb-tenant-section__subtitle">Stay updated with the latest from our community.</p>
          </div>
        </div>
        <% if (announcements.length === 0) { %>
        <div class="bb-tenant-empty church-public-empty-state">
          <span class="material-symbols-outlined church-empty-state__icon" aria-hidden="true">info</span>
          <p class="church-empty-state__title">No Active Notices</p>
          <p class="church-empty-state__body">There are no public announcements at this time.</p>
        </div>
        <% } else { %>
        <div class="bb-tenant-announcements__list" role="list">
          <% announcements.forEach(function (a) { %>
          <article class="bb-tenant-announcement-card" role="listitem">
            <div class="bb-tenant-announcement-card__meta">
              <% if (a.priority && a.priority !== 'normal') { %>
              <span class="bb-tenant-chip bb-tenant-chip--priority"><%= a.priority %></span>
              <% } %>
              <% if (a.source === 'hq') { %>
              <span class="bb-tenant-chip">HQ</span>
              <% } %>
              <% if (a.category) { %>
              <span class="bb-tenant-chip"><%= a.category %></span>
              <% } %>
              <% if (a.published_at || a.date) { %>
              <span class="bb-tenant-announcement-card__date"><%= a.published_at || a.date %></span>
              <% } %>
            </div>
            <h3 class="bb-tenant-announcement-card__title"><%= a.title %></h3>
            <% if (a.body) { %>
            <p class="bb-tenant-announcement-card__body"><%= String(a.body).length > 180 ? String(a.body).slice(0, 177) + '…' : a.body %></p>
            <% } %>
          </article>
          <% }); %>
        </div>
        <% } %>
      </section>

      <section class="bb-tenant-events" id="events" aria-label="Upcoming events">
        <div class="bb-tenant-section__head">
          <div>
            <h2 class="bb-tenant-section__title">Upcoming Events</h2>
            <p class="bb-tenant-section__subtitle">Join us for these special community gatherings.</p>
          </div>
          <% if (!isPreviewMode && hasRealEvents && events.length) { %>
          <a class="bb-tenant-inline-link" href="/events">See All Events <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
          <% } %>
        </div>
        <% if (!hasRealEvents || events.length === 0) { %>
        <div class="bb-tenant-empty">
          <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
          <p>No upcoming events have been published yet.</p>
          <% if (!isPreviewMode) { %>
          <a class="bb-tenant-inline-link" href="/events">See events page</a>
          <% } %>
        </div>
        <% } else { %>
        <div class="bb-tenant-events__grid">
          <% events.slice(0, 3).forEach(function (event) { %>
          <a class="bb-tenant-event-card" href="/events">
            <div class="bb-tenant-event-card__date">
              <span><%= event.month || 'SOON' %></span>
              <strong><%= event.day || '—' %></strong>
            </div>
            <h3 class="bb-tenant-event-card__title"><%= event.title %></h3>
            <% if (event.description) { %>
            <p class="bb-tenant-event-card__desc"><%= String(event.description).length > 120 ? String(event.description).slice(0, 117) + '…' : event.description %></p>
            <% } %>
            <div class="bb-tenant-event-card__meta">
              <% if (event.location) { %>
              <span><span class="material-symbols-outlined" aria-hidden="true">location_on</span> <%= event.location %></span>
              <% } %>
              <% if (event.time) { %>
              <span><%= event.time %></span>
              <% } else if (event.when) { %>
              <span><%= event.when %></span>
              <% } %>
            </div>
          </a>
          <% }); %>
        </div>
        <% } %>
      </section>
    </div>

    <aside class="bb-tenant-rail" aria-label="Service and resources">
      <% if (serviceInfo) { %>
      <article class="bb-tenant-rail__card bb-tenant-rail__card--service">
        <h2 class="bb-tenant-rail__title">
          <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
          Service Times
        </h2>
        <ul class="bb-tenant-rail__list">
          <% serviceLines.forEach(function (line) { %>
          <li><%= line %></li>
          <% }); %>
        </ul>
        <% if (!isPreviewMode) { %>
        <a class="church-btn church-btn--on-primary church-btn--block" href="/contact">Request a Visit</a>
        <% } %>
      </article>
      <% } %>

      <% if (!isPreviewMode) { %>
      <article class="bb-tenant-rail__card bb-tenant-rail__card--prayer">
        <h2 class="bb-tenant-rail__title">Need Prayer?</h2>
        <p>Share a prayer need with the church team. We would be glad to pray with you.</p>
        <a class="church-btn church-btn--public-secondary church-btn--block" href="/contact">Ask for Prayer</a>
      </article>
      <% } %>

      <article class="bb-tenant-rail__card bb-tenant-rail__card--resources" id="sermons">
        <h2 class="bb-tenant-rail__title">Digital Resources</h2>
        <% if (hasRealSermons && homeFeaturedSermon) { %>
        <a class="bb-tenant-rail__link" href="/sermons">
          <span class="material-symbols-outlined" aria-hidden="true">auto_stories</span>
          <span>
            <strong>Latest Sermon</strong>
            <em><%= homeFeaturedSermon.title %></em>
          </span>
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </a>
        <% } else { %>
        <a class="bb-tenant-rail__link" href="/sermons">
          <span class="material-symbols-outlined" aria-hidden="true">auto_stories</span>
          <span>
            <strong>Sermons &amp; Resources</strong>
            <em>Browse published messages and study resources.</em>
          </span>
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </a>
        <% } %>
        <a class="bb-tenant-rail__link" href="/sermons">
          <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
          <span>
            <strong>Reading &amp; Study</strong>
            <em>Notes and digital materials from <%= orgLabel || churchName %>.</em>
          </span>
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </a>
      </article>
    </aside>
  </div>

  <%# —— Ministries —— %>
  <section class="bb-tenant-ministries" id="ministries" aria-label="Ministries">
    <div class="bb-tenant-section__inner">
      <div class="bb-tenant-section__head">
        <div>
          <h2 class="bb-tenant-section__title">Ministries</h2>
          <p class="bb-tenant-section__subtitle">Finding your place in the family.</p>
        </div>
        <% if (!isPreviewMode) { %>
        <a class="bb-tenant-inline-link" href="/ministries">View All <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
        <% } %>
      </div>
      <% if (homeMinistriesList.length === 0) { %>
      <div class="bb-tenant-empty">
        <p>Ministry information will be available soon.</p>
      </div>
      <% } else { %>
      <div class="bb-tenant-ministries__grid">
        <% homeMinistriesList.forEach(function (m, idx) { %>
        <a class="bb-tenant-ministry-card<%= idx === 0 ? ' bb-tenant-ministry-card--featured' : '' %>" href="<%= isPreviewMode ? '#' : '/ministries' %>">
          <div class="bb-tenant-ministry-card__icon" aria-hidden="true">
            <span class="material-symbols-outlined"><%= ministryIcons[idx % ministryIcons.length] %></span>
          </div>
          <h3 class="bb-tenant-ministry-card__title"><%= m.name %></h3>
          <% if (m.description) { %>
          <p class="bb-tenant-ministry-card__desc"><%= String(m.description).length > 140 ? String(m.description).slice(0, 137) + '…' : m.description %></p>
          <% } %>
          <span class="bb-tenant-ministry-card__arrow material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>
        <% }); %>
      </div>
      <% } %>
    </div>
  </section>

  <%# —— Member portal CTA —— %>
  <% if (!isPreviewMode) { %>
  <section class="bb-tenant-member" aria-label="Member portal">
    <div class="bb-tenant-section__inner">
      <div class="bb-tenant-member__card">
        <div>
          <h2 class="bb-tenant-member__title">Already a Member?</h2>
          <p class="bb-tenant-member__lead">Access your profile and ministry schedules in the Member Portal.</p>
        </div>
        <div class="bb-tenant-member__actions">
          <a class="church-btn church-btn--public-primary" href="/login">Member Portal Login</a>
          <a class="bb-tenant-inline-link bb-tenant-inline-link--on-dark" href="/register">First time? Register here</a>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <%# —— Visit / contact —— %>
  <section class="bb-tenant-visit" id="visit" aria-label="Visit us">
    <div class="bb-tenant-section__inner bb-tenant-visit__grid">
      <div class="bb-tenant-visit__copy">
        <h2 class="bb-tenant-section__title">Visit Us</h2>
        <p class="bb-tenant-section__subtitle">We would love to welcome you. Come as you are.</p>
        <% if (!hasVisitDetails) { %>
        <div class="bb-tenant-empty bb-tenant-empty--inline">
          <p>Contact details will be available soon.</p>
        </div>
        <% } else { %>
        <ul class="bb-tenant-visit__list">
          <% if (visitLocation) { %>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
            <div>
              <p class="bb-tenant-visit__label">Location</p>
              <p class="bb-tenant-visit__value"><%= visitLocation %></p>
            </div>
          </li>
          <% } %>
          <% if (visitEmail) { %>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            <div>
              <p class="bb-tenant-visit__label">Email Address</p>
              <p class="bb-tenant-visit__value"><a href="mailto:<%= visitEmail %>"><%= visitEmail %></a></p>
            </div>
          </li>
          <% } %>
          <% if (visitPhone) { %>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">phone_in_talk</span>
            <div>
              <p class="bb-tenant-visit__label">Phone Number</p>
              <p class="bb-tenant-visit__value"><a href="tel:<%= String(visitPhone).replace(/[^\d+]/g, '') %>"><%= visitPhone %></a></p>
            </div>
          </li>
          <% } %>
        </ul>
        <% } %>
        <% if (!isPreviewMode) { %>
        <a class="church-btn church-btn--public-primary" href="/contact">Contact Us</a>
        <% } %>
      </div>
      <div class="bb-tenant-visit__panel">
        <div class="bb-tenant-visit__panel-body">
          <span class="material-symbols-outlined" aria-hidden="true">map</span>
          <p>Find visit details and send a message on our contact page.</p>
          <% if (!isPreviewMode) { %>
          <a class="bb-tenant-inline-link" href="/contact">Open contact page <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span></a>
          <% } %>
        </div>
      </div>
    </div>
  </section>
</section>
