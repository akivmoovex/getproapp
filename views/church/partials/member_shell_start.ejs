<%
  var _nav = typeof navActive !== 'undefined' ? navActive : '';
  var _shellTitle = typeof shellTitle !== 'undefined' ? shellTitle : 'Member Portal';
  var _memberName = typeof memberName !== 'undefined' ? memberName : 'Member';
  var _initials = typeof memberInitials !== 'undefined' ? memberInitials : 'M';
  var _avatar = typeof memberAvatarUrl !== 'undefined' ? memberAvatarUrl : '/church/images/member/avatar-member.jpg';
  var _church = typeof churchName !== 'undefined' ? churchName : 'Church';
  function navClass(key) {
    return 'church-member-nav-link' + (_nav === key ? ' church-member-nav-link--active' : '');
  }
  function bottomClass(key) {
    return 'church-member-bottom-nav__link' + (_nav === key ? ' church-member-bottom-nav__link--active' : '');
  }
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
  <title><%= pageTitle %> — BlessBoard Member Portal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=40"/>
</head>
<body class="church-body church-body--member-portal" data-member-shell="stitch-v40">
  <div class="church-member-layout">
    <aside class="church-member-sidebar" aria-label="Member navigation">
      <div class="church-member-sidebar__brand">
        <a class="church-member-brand-link" href="/member/dashboard"><%= _church %></a>
        <span class="church-member-brand-sub">Member Portal · BlessBoard</span>
      </div>
      <div class="church-member-sidebar__profile">
        <img class="church-member-sidebar__avatar" src="<%= _avatar %>" alt="" width="48" height="48"/>
        <div>
          <p class="church-member-sidebar__name"><%= _memberName %></p>
          <p class="church-member-sidebar__verified">
            <span class="material-symbols-outlined" aria-hidden="true">verified</span>
            Verified Member
          </p>
        </div>
      </div>
      <nav class="church-member-sidebar__nav">
        <a href="/member/dashboard" class="<%= navClass('dashboard') %>">
          <span class="material-symbols-outlined" aria-hidden="true">dashboard</span>
          <span>Dashboard</span>
        </a>
        <a href="/member/my-ministries" class="<%= navClass('ministries') %>">
          <span class="material-symbols-outlined" aria-hidden="true">groups</span>
          <span>Ministries</span>
        </a>
        <a href="/member/events" class="<%= navClass('events') %>">
          <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
          <span>Events</span>
        </a>
        <a href="/member/resources" class="<%= navClass('resources') %>">
          <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
          <span>Resources</span>
        </a>
        <a href="/member/requests" class="<%= navClass('requests') %>">
          <span class="material-symbols-outlined" aria-hidden="true">send</span>
          <span>Requests</span>
        </a>
        <a href="/member/giving" class="<%= navClass('giving') %>">
          <span class="material-symbols-outlined" aria-hidden="true">payments</span>
          <span>Giving</span>
        </a>
        <a href="/member/announcements" class="<%= navClass('announcements') %>">
          <span class="material-symbols-outlined" aria-hidden="true">campaign</span>
          <span>Announcements</span>
        </a>
        <a href="/member/profile" class="<%= navClass('profile') %>">
          <span class="material-symbols-outlined" aria-hidden="true">person</span>
          <span>Profile</span>
        </a>
        <a href="/member/forms" class="<%= navClass('forms') %>">
          <span class="material-symbols-outlined" aria-hidden="true">description</span>
          <span>Forms &amp; Docs</span>
        </a>
        <a href="/member/prayer-request" class="church-member-nav-link">
          <span class="material-symbols-outlined" aria-hidden="true">prayer_times</span>
          <span>Prayer Request</span>
        </a>
        <a href="/member/my-duties" class="<%= navClass('duties') %>">
          <span class="material-symbols-outlined" aria-hidden="true">assignment</span>
          <span>My Duties</span>
        </a>
        <a href="/member/account" class="church-member-nav-link">
          <span class="material-symbols-outlined" aria-hidden="true">lock</span>
          <span>Account</span>
        </a>
      </nav>
      <div class="church-member-sidebar__footer">
        <div class="church-member-sidebar__branch"><%= _church %></div>
        <a href="/" class="church-member-nav-link church-member-nav-link--muted">
          <span class="material-symbols-outlined" aria-hidden="true">public</span>
          <span>Public website</span>
        </a>
        <form method="post" action="/logout">
          <button class="church-member-nav-link church-member-nav-link--button" type="submit">
            <span class="material-symbols-outlined" aria-hidden="true">logout</span>
            <span>Sign out</span>
          </button>
        </form>
        <p class="church-member-powered">Powered by GetPro</p>
      </div>
    </aside>
    <div class="church-member-main">
      <header class="church-member-mobile-topbar" aria-label="Member portal">
        <div class="church-member-mobile-topbar__brand">
          <img class="church-member-mobile-topbar__avatar" src="<%= _avatar %>" alt="" width="40" height="40"/>
          <strong><%= _church %></strong>
        </div>
        <a class="church-member-mobile-topbar__icon-btn" href="/member/announcements" aria-label="Announcements">
          <span class="material-symbols-outlined">notifications</span>
        </a>
      </header>
      <header class="church-member-desktop-topbar" aria-label="<%= _shellTitle %>">
        <h1 class="church-member-desktop-topbar__title"><%= _shellTitle %></h1>
        <div class="church-member-desktop-topbar__actions">
          <a class="church-member-desktop-topbar__icon-btn" href="/member/announcements" aria-label="Announcements">
            <span class="material-symbols-outlined">notifications</span>
            <span class="church-member-desktop-topbar__dot" aria-hidden="true"></span>
          </a>
          <a class="church-member-desktop-topbar__avatar" href="/member/profile" aria-label="Profile"><%= _initials %></a>
        </div>
      </header>
      <nav class="church-member-bottom-nav" aria-label="Member mobile navigation">
        <a href="/member/dashboard" class="<%= bottomClass('dashboard') %>">
          <span class="material-symbols-outlined">home</span>Home
        </a>
        <a href="/member/my-ministries" class="<%= bottomClass('ministries') %>">
          <span class="material-symbols-outlined">groups</span>Groups
        </a>
        <a href="/member/events" class="<%= bottomClass('events') %>">
          <span class="material-symbols-outlined">calendar_today</span>Events
        </a>
        <a href="/member/resources" class="<%= bottomClass('resources') %>">
          <span class="material-symbols-outlined">menu_book</span>Study
        </a>
        <details class="church-member-more">
          <summary class="church-member-bottom-nav__link church-member-more__summary">
            <span class="material-symbols-outlined">more_horiz</span>More
          </summary>
          <div class="church-member-more__panel">
            <a href="/member/profile">Profile</a>
            <a href="/member/announcements">Announcements</a>
            <a href="/member/forms">Forms &amp; Docs</a>
            <a href="/member/requests">My Requests</a>
            <a href="/member/requests/new">Submit Request</a>
            <a href="/member/prayer-request">Prayer Request</a>
            <a href="/member/giving">Giving</a>
            <a href="/member/my-duties">My Duties</a>
            <a href="/member/account">Account</a>
            <a href="/">Public website</a>
            <form method="post" action="/logout">
              <button type="submit">Sign out</button>
            </form>
          </div>
        </details>
      </nav>
      <div class="church-member-content">
