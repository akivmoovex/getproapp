<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="robots" content="noindex, nofollow"/>
  <title><%= pageTitle %> — BlessBoard HQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=56"/>
</head>
<body class="church-body church-body--hq-admin" data-hq-shell="stitch-v49">
<%
  var _orgName = typeof organizationName !== 'undefined' ? organizationName : (typeof churchName !== 'undefined' ? churchName : 'HQ');
%>
  <div class="church-branch-layout church-branch-layout--hq">
    <aside class="church-branch-sidebar church-branch-sidebar--hq church-branch-sidebar--desktop" aria-label="HQ admin navigation">
      <%- include('./sidebar_brand', { sidebarIcon: 'corporate_fare', portalLabel: 'HQ', contextName: organizationName }) %>
      <nav class="church-branch-sidebar__nav">
        <%- include('./hq_admin_nav') %>
      </nav>
      <div class="church-branch-sidebar__footer">
        <a href="/" class="church-branch-nav-link">Public website</a>
        <% if (typeof hqAdmin !== 'undefined' && hqAdmin) { %>
        <form method="post" action="/hq/logout">
          <%- include('./csrf_field') %>
          <button class="church-branch-nav-link church-branch-nav-link--button" type="submit">Sign out</button>
        </form>
        <% } %>
      </div>
    </aside>
    <div class="church-branch-main church-hq-main">
      <header class="church-branch-mobile-topbar" aria-label="HQ admin mobile navigation">
        <button type="button" class="church-branch-mobile-topbar__menu" id="church-hq-menu-btn" aria-label="Open HQ menu" aria-expanded="false" aria-controls="church-hq-drawer">
          <span class="material-symbols-outlined" aria-hidden="true">menu</span>
        </button>
        <div class="church-branch-mobile-topbar__brand">
          <div>
            <strong>BlessBoard HQ</strong>
            <span><%= _orgName %></span>
          </div>
        </div>
        <a class="church-branch-mobile-topbar__icon" href="/hq/account" aria-label="Account">
          <span class="material-symbols-outlined">manage_accounts</span>
        </a>
      </header>
      <div class="church-drawer-overlay" id="church-hq-drawer-overlay" hidden></div>
      <aside class="church-drawer church-drawer--admin" id="church-hq-drawer" aria-label="HQ admin mobile menu" aria-hidden="true">
        <div class="church-drawer__head">
          <p class="church-drawer__title">HQ Admin</p>
          <button type="button" class="church-drawer__close" id="church-hq-drawer-close" aria-label="Close HQ menu">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
          </button>
        </div>
        <nav class="church-drawer__nav church-drawer__nav--admin" data-testid="hq-mobile-drawer-nav">
          <%- include('./admin_mobile_nav_groups', { idPrefix: 'church-hq' }) %>
        </nav>
        <div class="church-drawer__actions">
          <a class="church-btn church-btn--outline church-btn--block" href="/">Public website</a>
          <% if (typeof hqAdmin !== 'undefined' && hqAdmin) { %>
          <form method="post" action="/hq/logout">
            <%- include('./csrf_field') %>
            <button class="church-btn church-btn--primary church-btn--block" type="submit">Sign out</button>
          </form>
          <% } %>
        </div>
      </aside>
      <%- include('./hq_status_banner') %>
