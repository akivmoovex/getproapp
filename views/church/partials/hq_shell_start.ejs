<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= pageTitle %> — BlessBoard HQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=22"/>
</head>
<body class="church-body church-body--hq-admin">
  <div class="church-branch-layout church-branch-layout--hq">
    <aside class="church-branch-sidebar church-branch-sidebar--hq" aria-label="HQ admin navigation">
      <%- include('./sidebar_brand', { sidebarIcon: 'corporate_fare', portalLabel: 'HQ', contextName: organizationName }) %>
      <nav class="church-branch-sidebar__nav">
        <a href="/hq/dashboard" class="church-branch-nav-link">Dashboard</a>
        <a href="/hq/account" class="church-branch-nav-link">Account</a>
        <a href="/hq/branches" class="church-branch-nav-link">Branch registry</a>
        <a href="/hq/broadcasts" class="church-branch-nav-link">Broadcasts<% if (typeof planContext !== 'undefined' && planContext && !planContext.hqBroadcastsEnabled) { %> <span class="church-plan-lock">Premium</span><% } %></a>
        <a href="/hq/reports" class="church-branch-nav-link">Review Reports</a>
        <a href="/hq/analytics" class="church-branch-nav-link">Analytics<% if (typeof planContext !== 'undefined' && planContext && !planContext.consolidatedAnalyticsEnabled) { %> <span class="church-plan-lock">Premium</span><% } %></a>
        <a href="/hq/audit" class="church-branch-nav-link">Audit Trail</a>
      </nav>
      <div class="church-branch-sidebar__footer">
        <a href="/" class="church-branch-nav-link">Public website</a>
        <% if (typeof hqAdmin !== 'undefined' && hqAdmin) { %>
        <form method="post" action="/hq/logout">
          <button class="church-branch-nav-link church-branch-nav-link--button" type="submit">Sign out</button>
        </form>
        <% } %>
      </div>
    </aside>
    <div class="church-branch-main">
      <%- include('./hq_status_banner') %>
