<section class="church-page-hero" aria-label="Page header">
  <div class="church-page-hero__media" aria-hidden="true"></div>
  <div class="church-page-hero__content">
    <h1 class="church-page-hero__title"><%= heroTitle %></h1>
    <% if (typeof heroSubtitle !== 'undefined' && heroSubtitle) { %>
    <p class="church-page-hero__subtitle"><%= heroSubtitle %></p>
    <% } %>
  </div>
</section>
