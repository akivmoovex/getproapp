<%#
  Guided demo explore list.
  Locals: demoExploreLinks (array with href, label, description)
%>
<section class="bb-platform-demo-explore" aria-labelledby="<%= typeof demoExploreHeadingId !== 'undefined' ? demoExploreHeadingId : 'demo-explore-title' %>">
  <h2 class="bb-platform-section__title" id="<%= typeof demoExploreHeadingId !== 'undefined' ? demoExploreHeadingId : 'demo-explore-title' %>"><%= typeof demoExploreTitle !== 'undefined' ? demoExploreTitle : 'What you can explore' %></h2>
  <% if (typeof demoExploreLead !== 'undefined' && demoExploreLead) { %>
  <p class="bb-platform-section__subtitle"><%= demoExploreLead %></p>
  <% } %>
  <ul class="bb-platform-demo-explore__list">
    <% demoExploreLinks.forEach(function (item) { %>
    <li class="bb-platform-demo-explore__item">
      <a class="bb-platform-demo-explore__link" href="<%= item.href %>" rel="noopener noreferrer">
        <span class="bb-platform-demo-explore__label"><%= item.label %></span>
        <span class="bb-platform-demo-explore__desc"><%= item.description %></span>
      </a>
    </li>
    <% }); %>
  </ul>
  <p class="bb-platform-demo-explore__note">Member and administrator areas require church-issued credentials and are not part of this public demo tour.</p>
</section>
