<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= pageTitle %> — BlessBoard Branch Admin Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/church/church.css?v=43"/>
</head>
<body class="church-body church-body--auth">
  <header class="church-header church-header--auth">
    <div class="church-header__inner">
      <%- include('../partials/brand_lockup') %>
    </div>
  </header>
  <main class="church-auth-main">
    <div class="church-auth-card">
      <p class="church-eyebrow">Branch admin</p>
      <h1 class="church-auth-card__title"><%= churchName %></h1>
      <p class="church-auth-card__subtitle">Sign in to verify member registrations.</p>
      <% if (error) { %>
      <div class="church-alert church-alert--error" role="alert"><%= error %></div>
      <% } %>
      <form class="church-form" method="post" action="/branch/login">
        <div class="church-field">
          <label class="church-label" for="identifier">Email or phone</label>
          <input class="church-input" id="identifier" name="identifier" type="text" autocomplete="username" required value="<%= typeof identifier !== 'undefined' ? identifier : '' %>"/>
        </div>
        <div class="church-field">
          <label class="church-label" for="password">Password</label>
          <input class="church-input" id="password" name="password" type="password" autocomplete="current-password" required/>
        </div>
        <button class="church-btn church-btn--primary church-btn--block" type="submit">Login</button>
      </form>
      <p class="church-auth-card__footer">
        <a href="/branch/forgot-password">Forgot password?</a>
      </p>
      <p class="church-auth-card__footer">
        <a href="/">Back to church website</a>
      </p>
    </div>
  </main>
</body>
</html>
