<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <a class="church-branch-back" href="/branch/ministry-join-requests">&larr; Back to join requests</a>
          <h1 class="church-branch-topbar__title"><%= joinRequest.member_name %></h1>
          <p class="church-branch-topbar__subtitle"><%= joinRequest.ministry_name %></p>
        </div>
        <span class="church-status-chip church-status-chip--<%= joinRequest.status === 'approved' ? 'verified' : 'pending' %>"><%= joinRequestStatusLabel(joinRequest.status) %></span>
      </header>
      <% if (notice) { %><div class="church-alert church-alert--success" role="status"><%= notice %></div><% } %>
      <% if (error) { %><div class="church-alert church-alert--error" role="alert"><%= error %></div><% } %>
      <div class="church-branch-profile-grid">
        <section class="church-branch-panel">
          <h2 class="church-branch-panel__title">Member</h2>
          <dl class="church-branch-dl">
            <div><dt>Name</dt><dd><%= joinRequest.member_name %></dd></div>
            <div><dt>Email</dt><dd><%= joinRequest.member_email || '—' %></dd></div>
            <div><dt>Phone</dt><dd><%= joinRequest.member_phone || '—' %></dd></div>
            <div><dt>Submitted</dt><dd><%= new Date(joinRequest.created_at).toLocaleString('en-GB') %></dd></div>
          </dl>
        </section>
        <section class="church-branch-panel">
          <h2 class="church-branch-panel__title">Ministry</h2>
          <dl class="church-branch-dl">
            <div><dt>Name</dt><dd><%= joinRequest.ministry_name %></dd></div>
            <div><dt>Leader</dt><dd><%= joinRequest.ministry_leader_name || '—' %></dd></div>
          </dl>
          <% if (joinRequest.message) { %>
          <div class="church-branch-review-note">
            <strong>Member message</strong>
            <p><%= joinRequest.message %></p>
          </div>
          <% } %>
          <% if (joinRequest.admin_comment) { %>
          <div class="church-branch-review-note church-branch-review-note--hq">
            <strong>Admin comment</strong>
            <p><%= joinRequest.admin_comment %></p>
          </div>
          <% } %>
        </section>
      </div>
      <% if (['submitted', 'more_info_needed'].includes(joinRequest.status)) { %>
      <section class="church-branch-panel">
        <h2 class="church-branch-panel__title">Actions</h2>
        <div class="church-hq-review-actions">
          <form class="church-form" method="post" action="/branch/ministry-join-requests/<%= joinRequest.id %>/approve">
            <button class="church-btn church-btn--primary" type="submit">Approve</button>
          </form>
          <form class="church-form" method="post" action="/branch/ministry-join-requests/<%= joinRequest.id %>/reject">
            <div class="church-field church-field--full">
              <label class="church-label" for="reject_comment">Rejection comment (required)</label>
              <textarea class="church-input church-input--textarea" id="reject_comment" name="admin_comment" rows="2" required></textarea>
            </div>
            <button class="church-btn church-btn--outline" type="submit">Reject</button>
          </form>
          <form class="church-form" method="post" action="/branch/ministry-join-requests/<%= joinRequest.id %>/request-more-info">
            <div class="church-field church-field--full">
              <label class="church-label" for="more_info_comment">Information needed (required)</label>
              <textarea class="church-input church-input--textarea" id="more_info_comment" name="admin_comment" rows="2" required></textarea>
            </div>
            <button class="church-btn church-btn--outline" type="submit">Request more information</button>
          </form>
        </div>
      </section>
      <% } %>
<%- include('../partials/branch_admin_shell_end') %>
