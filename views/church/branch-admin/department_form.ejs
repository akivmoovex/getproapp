<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <a class="church-branch-back" href="/branch/departments">&larr; Back to departments</a>
          <h1 class="church-branch-topbar__title"><%= isEdit ? 'Edit department' : 'New department' %></h1>
        </div>
      </header>
      <% if (error) { %><div class="church-alert church-alert--error" role="alert"><%= error %></div><% } %>
      <form class="church-form" method="post" action="<%= isEdit ? '/branch/departments/' + departmentId : '/branch/departments' %>">
        <%- include('../partials/csrf_field') %>
        <section class="church-branch-panel">
          <div class="church-form-grid">
            <div class="church-field church-field--full"><label class="church-label" for="name">Name</label><input class="church-input" id="name" name="name" type="text" required value="<%= form.name || '' %>"/></div>
            <div class="church-field church-field--full"><label class="church-label" for="purpose">Purpose</label><textarea class="church-input church-input--textarea" id="purpose" name="purpose" rows="4"><%= form.purpose || '' %></textarea></div>
            <div class="church-field"><label class="church-label" for="leader_name">Leader name</label><input class="church-input" id="leader_name" name="leader_name" type="text" value="<%= form.leader_name || '' %>"/></div>
            <div class="church-field"><label class="church-label" for="leader_phone">Leader phone</label><input class="church-input" id="leader_phone" name="leader_phone" type="text" value="<%= form.leader_phone || '' %>"/></div>
          </div>
        </section>
        <div class="church-branch-actions">
          <button class="church-btn church-btn--primary" type="submit" name="_intent" value="save">Save</button>
          <% if (isEdit) { %>
          <button class="church-btn church-btn--outline" type="submit" name="_intent" value="activate">Activate</button>
          <% } %>
        </div>
      </form>
<%- include('../partials/branch_admin_shell_end') %>
