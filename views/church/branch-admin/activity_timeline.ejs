<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <h1 class="church-branch-topbar__title">Activity timeline</h1>
          <p class="church-branch-topbar__subtitle">Audit trail for <%= churchName %></p>
        </div>
      </header>
      <form class="church-form church-form--inline" method="get" action="/branch/activity">
        <div class="church-field church-field--grow">
          <label class="church-label" for="q">Search</label>
          <input class="church-input" id="q" name="q" type="search" value="<%= filters.q || '' %>" placeholder="Action, target, metadata"/>
        </div>
        <div class="church-field">
          <label class="church-label" for="action_group">Action group</label>
          <select class="church-input" id="action_group" name="action_group">
            <% auditActionGroups.forEach(function (g) { %>
            <option value="<%= g.id %>" <%= filters.actionGroup === g.id ? 'selected' : '' %>><%= g.label %></option>
            <% }); %>
          </select>
        </div>
        <div class="church-field">
          <label class="church-label" for="actor_type">Actor type</label>
          <select class="church-input" id="actor_type" name="actor_type">
            <option value="">All</option>
            <% auditActorTypes.forEach(function (t) { %>
            <option value="<%= t %>" <%= filters.actorType === t ? 'selected' : '' %>><%= actorTypeLabel(t) %></option>
            <% }); %>
          </select>
        </div>
        <div class="church-field">
          <label class="church-label" for="target_type">Target type</label>
          <input class="church-input" id="target_type" name="target_type" type="text" value="<%= filters.targetType || '' %>" placeholder="e.g. member"/>
        </div>
        <div class="church-field">
          <label class="church-label" for="date_from">From</label>
          <input class="church-input" id="date_from" name="date_from" type="date" value="<%= filters.dateFrom || '' %>"/>
        </div>
        <div class="church-field">
          <label class="church-label" for="date_to">To</label>
          <input class="church-input" id="date_to" name="date_to" type="date" value="<%= filters.dateTo || '' %>"/>
        </div>
        <button class="church-btn church-btn--primary" type="submit">Apply</button>
      </form>
      <section class="church-branch-panel">
        <p class="church-branch-panel__hint"><%= total %> event(s) · page <%= filters.page %> of <%= totalPages %></p>
        <% if ((logs || []).length === 0) { %>
        <p class="church-branch-empty">No activity matches these filters.</p>
        <% } else { %>
        <div class="church-branch-table-wrap">
          <table class="church-branch-table church-audit-table">
            <thead>
              <tr>
                <th>Date/time</th>
                <th>Actor</th>
                <th>Action</th>
                <th>Target</th>
                <th>Summary</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% logs.forEach(function (log) { %>
              <tr>
                <td><%= new Date(log.created_at).toLocaleString('en-GB') %></td>
                <td><%= actorTypeLabel(log.actor_type) %><br/><%= actorDisplayFromRow(log) %></td>
                <td><%= actionLabel(log.action) %></td>
                <td><%= targetTypeLabel(log.entity_type) %><br/><%= targetLabelFromRow(log) %></td>
                <td><%= auditSummary(log) %></td>
                <td><a class="church-btn church-btn--ghost church-btn--sm" href="/branch/activity/<%= log.id %>">View</a></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% if (totalPages > 1) { %>
        <div class="church-branch-actions">
          <% if (prevUrl) { %>
          <a class="church-btn church-btn--outline church-btn--sm" href="<%= prevUrl %>">Previous</a>
          <% } %>
          <% if (nextUrl) { %>
          <a class="church-btn church-btn--outline church-btn--sm" href="<%= nextUrl %>">Next</a>
          <% } %>
        </div>
        <% } %>
        <% } %>
      </section>
<%- include('../partials/branch_admin_shell_end') %>
