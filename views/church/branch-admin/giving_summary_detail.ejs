<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <a class="church-branch-back" href="/branch/giving-summary">&larr; Back to giving summaries</a>
          <h1 class="church-branch-topbar__title">Giving summary — <%= summary.period_label %></h1>
          <p class="church-branch-topbar__subtitle"><%= churchName %></p>
        </div>
      </header>
      <div class="church-alert church-alert--info" role="note">
        This is a summary for reporting only. GetPro Church does not process payments or provide full accounting in this MVP.
      </div>
      <% if (notice) { %>
      <div class="church-alert church-alert--success" role="status"><%= notice %></div>
      <% } %>
      <section class="church-branch-panel">
        <h2 class="church-branch-panel__title">Summary totals (ZMW)</h2>
        <dl class="church-branch-dl">
          <div><dt>Tithes</dt><dd><%= formatMoney(summary.tithes_total) %></dd></div>
          <div><dt>Offerings</dt><dd><%= formatMoney(summary.offerings_total) %></dd></div>
          <div><dt>Building fund</dt><dd><%= formatMoney(summary.building_fund_total) %></dd></div>
          <div><dt>Missions fund</dt><dd><%= formatMoney(summary.missions_fund_total) %></dd></div>
          <div><dt>Special offerings</dt><dd><%= formatMoney(summary.special_offerings_total) %></dd></div>
          <div><dt>Other giving</dt><dd><%= formatMoney(summary.other_giving_total) %></dd></div>
          <div><dt>Grand total</dt><dd><strong><%= formatMoney(summary.grand_total) %></strong></dd></div>
          <div><dt>Status</dt><dd><span class="church-status-chip church-status-chip--<%= summary.status === 'submitted' ? 'verified' : 'pending' %>"><%= summary.status %></span></dd></div>
          <div><dt>Recorded by</dt><dd><%= summary.created_by_name || 'Branch admin' %></dd></div>
          <div><dt>Created</dt><dd><%= new Date(summary.created_at).toLocaleString('en-GB') %></dd></div>
          <div><dt>Updated</dt><dd><%= new Date(summary.updated_at).toLocaleString('en-GB') %></dd></div>
        </dl>
        <% if (summary.notes) { %>
        <div class="church-branch-review-note">
          <strong>Notes</strong>
          <p><%= summary.notes %></p>
        </div>
        <% } %>
      </section>
<%- include('../partials/branch_admin_shell_end') %>
