<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <a class="church-branch-back" href="/branch/reset-requests">&larr; Back to Reset Inbox</a>
          <h1 class="church-branch-topbar__title">Leader password reset request #<%= requestItem.id %></h1>
          <p class="church-branch-topbar__subtitle">Submitted <%= new Date(requestItem.created_at).toLocaleString('en-GB') %></p>
        </div>
        <%- include('../../partials/reset_request_status_badge', { status: requestItem.status }) %>
      </header>
      <% if (notice) { %>
      <div class="church-alert church-alert--success" role="status"><%= notice %></div>
      <% } %>
      <% if (error) { %>
      <div class="church-alert church-alert--error" role="alert"><%= error %></div>
      <% } %>
      <div class="church-branch-profile-grid">
        <section class="church-branch-panel">
          <h2 class="church-branch-panel__title">Submitted details</h2>
          <dl class="church-branch-dl">
            <div><dt>Identifier</dt><dd><%= maskIdentifier(requestItem.identifier_submitted) %></dd></div>
            <div><dt>Full name</dt><dd><%= requestItem.full_name_submitted || '—' %></dd></div>
            <div><dt>Phone</dt><dd><%= requestItem.phone_submitted || '—' %></dd></div>
            <div><dt>Email</dt><dd><%= requestItem.email_submitted || '—' %></dd></div>
            <div><dt>Submitted</dt><dd><%= new Date(requestItem.created_at).toLocaleString('en-GB') %></dd></div>
            <div><dt>Last updated</dt><dd><%= new Date(requestItem.updated_at).toLocaleString('en-GB') %></dd></div>
            <% if (requestItem.resolved_at) { %>
            <div><dt>Resolved</dt><dd><%= new Date(requestItem.resolved_at).toLocaleString('en-GB') %><% if (requestItem.resolved_by_name) { %> by <%= requestItem.resolved_by_name %><% } %></dd></div>
            <% } %>
            <% if (requestItem.review_comment) { %>
            <div><dt>Review comment</dt><dd><%= requestItem.review_comment %></dd></div>
            <% } %>
          </dl>
        </section>
        <% if (requestItem.ministry_leader_id) { %>
        <section class="church-branch-panel">
          <h2 class="church-branch-panel__title">Matched ministry leader</h2>
          <dl class="church-branch-dl">
            <div><dt>Name</dt><dd><%= requestItem.leader_name %></dd></div>
            <div><dt>Email</dt><dd><%= requestItem.leader_email || '—' %></dd></div>
            <div><dt>Phone</dt><dd><%= requestItem.leader_phone || '—' %></dd></div>
            <div><dt>Status</dt><dd><%= requestItem.leader_status %></dd></div>
            <% if (requestItem.ministry_name) { %>
            <div><dt>Ministry</dt><dd><%= requestItem.ministry_name %></dd></div>
            <% } %>
          </dl>
        </section>
        <% } else { %>
        <section class="church-branch-panel church-branch-panel--warning">
          <h2 class="church-branch-panel__title">No leader match</h2>
          <p class="church-branch-panel__hint">No matching ministry leader account was found. Do not disclose this publicly.</p>
        </section>
        <% } %>
      </div>
      <section class="church-branch-panel">
        <%- include('../../partials/reset_request_timeline', { resetTimeline: resetTimeline, resetTimelineError: resetTimelineError, formatDateTime: formatDateTime }) %>
      </section>
      <% if (requestItem.status !== 'reset_completed' && requestItem.status !== 'rejected') { %>
      <section class="church-branch-panel">
        <h2 class="church-branch-panel__title">Actions</h2>
        <div class="church-hq-review-actions">
          <% if (requestItem.status === 'submitted') { %>
          <form class="church-form" method="post" action="/branch/leader-password-reset-requests/<%= requestItem.id %>/mark-reviewed">
        <%- include('../partials/csrf_field') %>
            <button class="church-btn church-btn--outline" type="submit">Mark reviewed</button>
          </form>
          <% } %>
          <% if (requestItem.ministry_leader_id) { %>
          <form class="church-form" method="post" action="/branch/leader-password-reset-requests/<%= requestItem.id %>/reset-password">
        <%- include('../partials/csrf_field') %>
            <div class="church-field">
              <label class="church-label" for="new_password">New password</label>
              <input class="church-input" id="new_password" name="new_password" type="password" autocomplete="new-password" required minlength="8"/>
            </div>
            <div class="church-field">
              <label class="church-label" for="confirm_password">Confirm password</label>
              <input class="church-input" id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required minlength="8"/>
            </div>
            <button class="church-btn church-btn--primary" type="submit">Reset password</button>
          </form>
          <% } %>
          <form class="church-form" method="post" action="/branch/leader-password-reset-requests/<%= requestItem.id %>/reject">
        <%- include('../partials/csrf_field') %>
            <div class="church-field church-field--full">
              <label class="church-label" for="review_comment">Rejection comment (required)</label>
              <textarea class="church-input church-input--textarea" id="review_comment" name="review_comment" rows="2" required minlength="3"></textarea>
            </div>
            <button class="church-btn church-btn--outline" type="submit">Reject request</button>
          </form>
        </div>
      </section>
      <% } %>
<%- include('../partials/branch_admin_shell_end') %>
