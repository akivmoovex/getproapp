<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <a class="church-branch-back" href="/branch/attendance">&larr; Back to attendance tracker</a>
          <h1 class="church-branch-topbar__title">Attendance record</h1>
          <p class="church-branch-topbar__subtitle"><%= record.service_name %> · <%= record.service_date_display %></p>
        </div>
      </header>
      <% if (notice) { %>
      <div class="church-alert church-alert--success" role="status"><%= notice %></div>
      <% } %>
      <% if (error) { %>
      <div class="church-alert church-alert--error" role="alert"><%= error %></div>
      <% } %>
      <div class="church-branch-profile-grid">
        <section class="church-branch-panel">
          <h2 class="church-branch-panel__title">Summary</h2>
          <dl class="church-branch-dl">
            <div><dt>Type</dt><dd><%= record.attendance_type %></dd></div>
            <div><dt>Service / meeting</dt><dd><%= record.service_name %></dd></div>
            <div><dt>Date</dt><dd><%= record.service_date_display %></dd></div>
            <div><dt>Total attendance</dt><dd><%= record.total_attendance %></dd></div>
            <div><dt>Status</dt><dd><span class="church-status-chip church-status-chip--<%= record.status === 'submitted' ? 'verified' : 'pending' %>"><%= record.status %></span></dd></div>
            <div><dt>Created by</dt><dd><%= record.created_by_name || 'Branch admin' %></dd></div>
            <div><dt>Created</dt><dd><%= new Date(record.created_at).toLocaleString('en-GB') %></dd></div>
            <div><dt>Updated</dt><dd><%= new Date(record.updated_at).toLocaleString('en-GB') %></dd></div>
          </dl>
        </section>
        <section class="church-branch-panel">
          <h2 class="church-branch-panel__title">Breakdown</h2>
          <dl class="church-branch-dl">
            <div><dt>Adults</dt><dd><%= record.adults_count %></dd></div>
            <div><dt>Youth</dt><dd><%= record.youth_count %></dd></div>
            <div><dt>Children</dt><dd><%= record.children_count %></dd></div>
            <div><dt>First-time visitors</dt><dd><%= record.first_time_visitors_count %></dd></div>
            <div><dt>New members</dt><dd><%= record.new_members_count %></dd></div>
            <div><dt>Volunteers</dt><dd><%= record.volunteers_count %></dd></div>
          </dl>
          <% if (record.notes) { %>
          <div class="church-branch-review-note">
            <strong>Notes</strong>
            <p><%= record.notes %></p>
          </div>
          <% } %>
          <% if (record.status === 'draft') { %>
          <form class="church-form church-form--spaced" method="post" action="/branch/attendance/<%= record.id %>/update-status">
        <%- include('../partials/csrf_field') %>
            <input type="hidden" name="status" value="submitted"/>
            <button class="church-btn church-btn--primary church-btn--block" type="submit">Mark as submitted</button>
          </form>
          <% } %>
        </section>
      </div>
<%- include('../partials/branch_admin_shell_end') %>
