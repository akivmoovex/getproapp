<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <a class="church-branch-back" href="/branch/requests">&larr; Back to requests</a>
          <h1 class="church-branch-topbar__title"><%= requestItem.subject %></h1>
          <p class="church-branch-topbar__subtitle"><%= requestItem.request_type %></p>
        </div>
        <span class="church-status-chip church-status-chip--<%= requestItem.status === 'approved' || requestItem.status === 'completed' ? 'verified' : 'pending' %>"><%= requestStatusLabel(requestItem.status) %></span>
      </header>
      <% if (notice) { %>
      <div class="church-alert church-alert--success" role="status"><%= notice %></div>
      <% } %>
      <% if (error) { %>
      <div class="church-alert church-alert--error" role="alert"><%= error %></div>
      <% } %>
      <div class="church-branch-profile-grid">
        <section class="church-branch-panel">
          <h2 class="church-branch-panel__title">Member</h2>
          <dl class="church-branch-dl">
            <div><dt>Name</dt><dd><%= requestItem.member_name %></dd></div>
            <div><dt>Email</dt><dd><%= requestItem.member_email || '—' %></dd></div>
            <div><dt>Phone</dt><dd><%= requestItem.member_phone || '—' %></dd></div>
            <div><dt>Submitted</dt><dd><%= new Date(requestItem.created_at).toLocaleString('en-GB') %></dd></div>
            <div><dt>Updated</dt><dd><%= new Date(requestItem.updated_at).toLocaleString('en-GB') %></dd></div>
          </dl>
        </section>
        <section class="church-branch-panel">
          <h2 class="church-branch-panel__title">Request</h2>
          <div class="church-branch-review-note">
            <strong>Description</strong>
            <p><%= requestItem.description %></p>
          </div>
          <% if (requestItem.admin_comment) { %>
          <div class="church-branch-review-note church-branch-review-note--hq">
            <strong>Admin comment</strong>
            <p><%= requestItem.admin_comment %></p>
          </div>
          <% } %>
        </section>
      </div>
      <% if (requestItem.status !== 'rejected' && requestItem.status !== 'completed') { %>
      <section class="church-branch-panel">
        <h2 class="church-branch-panel__title">Actions</h2>
        <div class="church-hq-review-actions">
          <% if (requestItem.status === 'submitted' || requestItem.status === 'more_info_needed') { %>
          <form class="church-form" method="post" action="/branch/requests/<%= requestItem.id %>/start-review">
        <%- include('../partials/csrf_field') %>
            <button class="church-btn church-btn--outline" type="submit">Start Review</button>
          </form>
          <% } %>
          <% if (['submitted', 'in_review'].includes(requestItem.status)) { %>
          <form class="church-form" method="post" action="/branch/requests/<%= requestItem.id %>/approve">
        <%- include('../partials/csrf_field') %>
            <div class="church-field church-field--full">
              <label class="church-label" for="approve_comment">Comment (optional)</label>
              <textarea class="church-input church-input--textarea" id="approve_comment" name="admin_comment" rows="2"></textarea>
            </div>
            <button class="church-btn church-btn--primary" type="submit">Approve</button>
          </form>
          <form class="church-form" method="post" action="/branch/requests/<%= requestItem.id %>/reject">
        <%- include('../partials/csrf_field') %>
            <div class="church-field church-field--full">
              <label class="church-label" for="reject_comment">Rejection comment (required)</label>
              <textarea class="church-input church-input--textarea" id="reject_comment" name="admin_comment" rows="2" required></textarea>
            </div>
            <button class="church-btn church-btn--outline" type="submit">Reject</button>
          </form>
          <form class="church-form" method="post" action="/branch/requests/<%= requestItem.id %>/request-more-info">
        <%- include('../partials/csrf_field') %>
            <div class="church-field church-field--full">
              <label class="church-label" for="more_info_comment">Information needed (required)</label>
              <textarea class="church-input church-input--textarea" id="more_info_comment" name="admin_comment" rows="2" required></textarea>
            </div>
            <button class="church-btn church-btn--outline" type="submit">Request More Information</button>
          </form>
          <% } %>
          <% if (requestItem.status === 'approved') { %>
          <form class="church-form" method="post" action="/branch/requests/<%= requestItem.id %>/complete">
        <%- include('../partials/csrf_field') %>
            <div class="church-field church-field--full">
              <label class="church-label" for="complete_comment">Completion note (optional)</label>
              <textarea class="church-input church-input--textarea" id="complete_comment" name="admin_comment" rows="2"></textarea>
            </div>
            <button class="church-btn church-btn--primary" type="submit">Mark Completed</button>
          </form>
          <% } %>
        </div>
      </section>
      <% } %>
<%- include('../partials/branch_admin_shell_end') %>
