<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <h1 class="church-branch-topbar__title">Events</h1>
          <p class="church-branch-topbar__subtitle">Manage branch events and calendar items</p>
        </div>
        <a class="church-btn church-btn--primary" href="/branch/events/new">Create event</a>
      </header>
      <% if (notice) { %>
      <div class="church-alert church-alert--success" role="status"><%= notice %></div>
      <% } %>
      <div class="church-branch-filter-tabs">
        <% eventFilters.forEach(function (f) { %>
        <a class="church-branch-filter-tab <%= statusFilter === f ? 'church-branch-filter-tab--active' : '' %>" href="/branch/events<%= f === 'all' ? '' : '?status=' + f %>"><%= f === 'all' ? 'All' : eventStatusLabel(f) %></a>
        <% }); %>
      </div>
      <section class="church-branch-panel">
        <% if ((events || []).length === 0) { %>
        <p class="church-branch-empty">No events in this filter.</p>
        <% } else { %>
        <div class="church-branch-table-wrap">
          <table class="church-branch-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Time</th>
                <th>Location</th>
                <th>Visibility</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% events.forEach(function (ev) { %>
              <tr>
                <td><%= ev.title %></td>
                <td><%= new Date(ev.event_date).toLocaleDateString('en-GB') %></td>
                <td><%= formatEventTimeRange(ev) %></td>
                <td><%= ev.location || '—' %></td>
                <td><%= visibilityLabel(ev.visibility) %></td>
                <td><span class="church-status-chip church-status-chip--<%= ev.status === 'published' ? 'verified' : 'pending' %>"><%= eventStatusLabel(ev.status) %></span></td>
                <td>
                  <a class="church-btn church-btn--ghost church-btn--sm" href="/branch/events/<%= ev.id %>">View</a>
                  <% if (ev.status !== 'cancelled') { %>
                  <a class="church-btn church-btn--ghost church-btn--sm" href="/branch/events/<%= ev.id %>/edit">Edit</a>
                  <% } %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
      </section>
<%- include('../partials/branch_admin_shell_end') %>
