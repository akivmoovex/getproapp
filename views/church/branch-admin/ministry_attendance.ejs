<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <h1 class="church-branch-topbar__title">Ministry attendance</h1>
          <p class="church-branch-topbar__subtitle">Attendance records linked to ministries</p>
        </div>
      </header>
      <section class="church-branch-panel">
        <% if ((records || []).length === 0) { %>
        <p class="church-branch-empty">No ministry-linked attendance records yet.</p>
        <% } else { %>
        <div class="church-branch-table-wrap">
          <table class="church-branch-table">
            <thead><tr><th>Date</th><th>Ministry</th><th>Created by</th><th>Meeting</th><th>Total</th><th>Adults</th><th>Youth</th><th>Children</th><th>Visitors</th><th>Volunteers</th><th>Status</th><th></th></tr></thead>
            <tbody>
              <% records.forEach(function (r) { %>
              <tr>
                <td><%= r.service_date_display %></td>
                <td><%= r.ministry_name || '—' %></td>
                <td><%= r.created_by_display || '—' %></td>
                <td><%= r.service_name %></td>
                <td><%= r.total_attendance %></td>
                <td><%= r.adults_count %></td>
                <td><%= r.youth_count %></td>
                <td><%= r.children_count %></td>
                <td><%= r.first_time_visitors_count %></td>
                <td><%= r.volunteers_count %></td>
                <td><%= r.status %></td>
                <td><a class="church-btn church-btn--ghost church-btn--sm" href="/branch/attendance/<%= r.id %>">View</a></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
      </section>
<%- include('../partials/branch_admin_shell_end') %>
