<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-page-hero">
        <div>
          <h1 class="church-branch-page-hero__title church-show-mobile-only">Members</h1>
          <p class="church-branch-page-hero__subtitle">Directory for <%= churchName %></p>
        </div>
        <a class="church-btn church-btn--outline" href="/branch/member-verification">Verification queue</a>
      </header>
      <% if (notice) { %><div class="church-alert church-alert--success" role="status"><%= notice %></div><% } %>
      <form class="church-form church-form--inline" method="get" action="/branch/members">
        <div class="church-field church-field--grow">
          <label class="church-label" for="q">Search</label>
          <input class="church-input" id="q" name="q" type="search" value="<%= searchQuery || '' %>" placeholder="Name, email, or phone"/>
        </div>
        <% if (statusFilter && statusFilter !== 'all') { %>
        <input type="hidden" name="status" value="<%= statusFilter %>"/>
        <% } %>
        <button class="church-btn church-btn--primary" type="submit">Search</button>
      </form>
      <div class="church-branch-filter-tabs">
        <% memberFilters.forEach(function (f) { %>
        <a class="church-branch-filter-tab <%= statusFilter === f ? 'church-branch-filter-tab--active' : '' %>" href="/branch/members<%= f === 'all' && !searchQuery ? '' : '?' + (f !== 'all' ? 'status=' + f : '') + (searchQuery ? (f !== 'all' ? '&' : '') + 'q=' + encodeURIComponent(searchQuery) : '') %>"><%= f === 'all' ? 'All' : memberStatusLabel(f) %></a>
        <% }); %>
      </div>
      <section class="church-branch-panel">
        <% if ((members || []).length === 0) { %>
        <p class="church-branch-empty">No members match this filter.</p>
        <% } else { %>
        <div class="church-branch-table-wrap">
          <table class="church-branch-table">
            <thead><tr><th>Name</th><th>Phone</th><th>Email</th><th>Age group</th><th>Ministry interest</th><th>Status</th><th>Submitted</th><th>Updated</th><th></th></tr></thead>
            <tbody>
              <% members.forEach(function (m) { %>
              <tr>
                <td><%= m.full_name %></td>
                <td><%= m.phone %></td>
                <td><%= m.email %></td>
                <td><%= m.age_group %></td>
                <td><%= m.ministry_interest || '—' %></td>
                <td><span class="church-status-chip church-status-chip--<%= m.status %>"><%= memberStatusLabel(m.status) %></span></td>
                <td><%= new Date(m.created_at).toLocaleDateString('en-GB') %></td>
                <td><%= m.updated_at ? new Date(m.updated_at).toLocaleDateString('en-GB') : '—' %></td>
                <td><a class="church-btn church-btn--ghost church-btn--sm" href="/branch/members/<%= m.id %>">View</a></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
      </section>
<%- include('../partials/branch_admin_shell_end') %>
