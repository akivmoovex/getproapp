<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <a class="church-branch-back" href="/branch/reset-requests">&larr; Reset Inbox</a>
          <h1 class="church-branch-topbar__title">Member Reset Queue</h1>
          <p class="church-branch-topbar__subtitle">Review member forgot-password requests and reset passwords manually</p>
        </div>
        <div class="church-branch-topbar__actions">
          <a class="church-btn church-btn--outline church-btn--sm" href="/branch/leader-password-reset-requests">Ministry Leader Reset Queue</a>
        </div>
      </header>
      <% if (notice) { %>
      <div class="church-alert church-alert--success" role="status"><%= notice %></div>
      <% } %>
      <div class="church-branch-filter-tabs">
        <% passwordResetFilters.forEach(function (f) { %>
        <a class="church-branch-filter-tab <%= statusFilter === f ? 'church-branch-filter-tab--active' : '' %>" href="/branch/password-reset-requests<%= f === 'all' ? '' : '?status=' + f %>"><%= f === 'all' ? 'All' : passwordResetStatusLabel(f) %></a>
        <% }); %>
      </div>
      <section class="church-branch-panel">
        <% if ((requests || []).length === 0) { %>
        <p class="church-branch-empty">No password reset requests in this filter.</p>
        <% } else { %>
        <div class="church-branch-table-wrap">
          <table class="church-branch-table">
            <thead>
              <tr>
                <th>Submitted</th>
                <th>Identifier</th>
                <th>Name / contact</th>
                <th>Matched member</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% requests.forEach(function (r) { %>
              <tr>
                <td><%= new Date(r.created_at).toLocaleDateString('en-GB') %></td>
                <td><%= maskIdentifier(r.identifier_submitted) %></td>
                <td>
                  <% if (r.full_name_submitted) { %><%= r.full_name_submitted %><br/><% } %>
                  <% if (r.phone_submitted) { %><%= r.phone_submitted %><br/><% } %>
                  <% if (r.email_submitted) { %><%= r.email_submitted %><% } %>
                  <% if (!r.full_name_submitted && !r.phone_submitted && !r.email_submitted) { %>—<% } %>
                </td>
                <td><%= r.member_id ? (r.member_name || 'Member #' + r.member_id) : '—' %></td>
                <td><%- include('../../partials/reset_request_status_badge', { status: r.status }) %></td>
                <td><a class="church-btn church-btn--ghost church-btn--sm" href="/branch/password-reset-requests/<%= r.id %>">View</a></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
      </section>
<%- include('../partials/branch_admin_shell_end') %>
