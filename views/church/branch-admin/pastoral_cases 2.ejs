<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <h1 class="church-branch-topbar__title">Pastoral cases</h1>
          <p class="church-branch-topbar__subtitle">Simple pastoral care cases for <%= churchName %></p>
        </div>
      </header>
      <% if (notice) { %>
      <div class="church-alert church-alert--success" role="status"><%= notice %></div>
      <% } %>
      <% if (error) { %>
      <div class="church-alert church-alert--error" role="alert"><%= error %></div>
      <% } %>
      <section class="church-branch-panel">
        <h2 class="church-branch-panel__title">Open pastoral case</h2>
        <form class="church-form" method="post" action="/branch/pastoral-cases">
          <%- include('../partials/csrf_field') %>
          <div class="church-form-grid">
            <div class="church-field church-field--full">
              <label class="church-label" for="member_id">Member</label>
              <select class="church-input" id="member_id" name="member_id" required>
                <option value="" disabled <%= !form.member_id ? 'selected' : '' %>>Select member</option>
                <% members.forEach(function (m) { %>
                <option value="<%= m.id %>" <%= String(form.member_id) === String(m.id) ? 'selected' : '' %>><%= m.full_name %></option>
                <% }); %>
              </select>
            </div>
            <div class="church-field church-field--full">
              <label class="church-label" for="title">Case title</label>
              <input class="church-input" id="title" name="title" type="text" required value="<%= form.title || '' %>"/>
            </div>
            <div class="church-field church-field--full">
              <label class="church-label" for="summary">Summary</label>
              <textarea class="church-input church-input--textarea" id="summary" name="summary" rows="3"><%= form.summary || '' %></textarea>
            </div>
            <div class="church-field">
              <label class="church-label" for="assigned_admin_id">Assignee</label>
              <select class="church-input" id="assigned_admin_id" name="assigned_admin_id">
                <option value="">Unassigned</option>
                <% pastoralAdmins.forEach(function (a) { %>
                <option value="<%= a.id %>" <%= String(form.assigned_admin_id) === String(a.id) ? 'selected' : '' %>><%= a.full_name %></option>
                <% }); %>
              </select>
            </div>
            <div class="church-field">
              <label class="church-label" for="due_date">Due date</label>
              <input class="church-input" id="due_date" name="due_date" type="date" value="<%= form.due_date || '' %>"/>
            </div>
            <div class="church-field church-field--full">
              <label class="church-label" for="next_action">Next action</label>
              <input class="church-input" id="next_action" name="next_action" type="text" value="<%= form.next_action || '' %>"/>
            </div>
            <% if (form.prayer_request_id) { %>
            <input type="hidden" name="prayer_request_id" value="<%= form.prayer_request_id %>"/>
            <% } %>
          </div>
          <button class="church-btn church-btn--primary" type="submit">Open case</button>
        </form>
      </section>
      <section class="church-branch-panel">
        <h2 class="church-branch-panel__title">Cases</h2>
        <% if ((cases || []).length === 0) { %>
        <p class="church-branch-empty">No pastoral cases yet.</p>
        <% } else { %>
        <div class="church-branch-table-wrap">
          <table class="church-branch-table">
            <thead>
              <tr><th>Member</th><th>Title</th><th>Status</th><th>Assignee</th><th>Due</th><th></th></tr>
            </thead>
            <tbody>
              <% cases.forEach(function (c) { %>
              <tr>
                <td><%= c.member_name %></td>
                <td><%= c.title %></td>
                <td><%= pastoralCaseStatusLabel(c.status) %></td>
                <td><%= c.assigned_admin_name || '—' %></td>
                <td><%= c.due_date || '—' %></td>
                <td><a class="church-btn church-btn--ghost church-btn--sm" href="/branch/pastoral-cases/<%= c.id %>">View</a></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
      </section>
<%- include('../partials/branch_admin_shell_end') %>
