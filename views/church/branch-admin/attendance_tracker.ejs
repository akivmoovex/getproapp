<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <h1 class="church-branch-topbar__title">Attendance tracker</h1>
          <p class="church-branch-topbar__subtitle">Record service and meeting attendance for <%= churchName %></p>
        </div>
        <a class="church-btn church-btn--primary church-btn--sm" href="/branch/attendance/check-in">Service check-in</a>
      </header>
      <% if (notice) { %>
      <div class="church-alert church-alert--success" role="status"><%= notice %></div>
      <% } %>
      <section class="church-branch-panel">
        <h2 class="church-branch-panel__title">New attendance record</h2>
        <% if (error) { %>
        <div class="church-alert church-alert--error" role="alert"><%= error %></div>
        <% } %>
        <form class="church-form" method="post" action="/branch/attendance">
        <%- include('../partials/csrf_field') %>
          <div class="church-form-grid">
            <div class="church-field">
              <label class="church-label" for="attendance_type">Attendance type</label>
              <select class="church-input" id="attendance_type" name="attendance_type" required>
                <option value="" disabled <%= !form.attendance_type ? 'selected' : '' %>>Select type</option>
                <% attendanceTypes.forEach(function (t) { %>
                <option value="<%= t %>" <%= form.attendance_type === t ? 'selected' : '' %>><%= t %></option>
                <% }); %>
              </select>
            </div>
            <div class="church-field">
              <label class="church-label" for="service_name">Service / meeting name</label>
              <input class="church-input" id="service_name" name="service_name" type="text" required value="<%= form.service_name || '' %>"/>
            </div>
            <div class="church-field">
              <label class="church-label" for="attendance_date">Date</label>
              <input class="church-input" id="attendance_date" name="attendance_date" type="date" required value="<%= form.attendance_date || '' %>"/>
            </div>
            <% ['adults_count','youth_count','children_count','first_time_visitors_count','new_members_count','volunteers_count'].forEach(function (field) { %>
            <% var labels = { adults_count: 'Adults', youth_count: 'Youth', children_count: 'Children', first_time_visitors_count: 'First-time visitors', new_members_count: 'New members', volunteers_count: 'Volunteers' }; %>
            <div class="church-field">
              <label class="church-label" for="<%= field %>"><%= labels[field] %></label>
              <input class="church-input" id="<%= field %>" name="<%= field %>" type="number" min="0" step="1" value="<%= form[field] != null ? form[field] : 0 %>"/>
            </div>
            <% }); %>
            <div class="church-field church-field--full">
              <label class="church-label" for="notes">Notes</label>
              <textarea class="church-input church-input--textarea" id="notes" name="notes" rows="3"><%= form.notes || '' %></textarea>
            </div>
          </div>
          <div class="church-branch-form-actions">
            <button class="church-btn church-btn--outline" type="submit" name="submit_action" value="save_draft">Save draft</button>
            <button class="church-btn church-btn--primary" type="submit" name="submit_action" value="submit">Submit record</button>
          </div>
        </form>
      </section>
      <section class="church-branch-panel">
        <h2 class="church-branch-panel__title">Attendance records</h2>
        <% if ((records || []).length === 0) { %>
        <p class="church-branch-empty">No attendance records yet.</p>
        <% } else { %>
        <div class="church-branch-table-wrap">
          <table class="church-branch-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Service</th>
                <th>Total</th>
                <th>Adults</th>
                <th>Youth</th>
                <th>Children</th>
                <th>Visitors</th>
                <th>New members</th>
                <th>Volunteers</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% records.forEach(function (r) { %>
              <tr>
                <td><%= r.service_date_display %></td>
                <td><%= r.attendance_type %></td>
                <td><%= r.service_name %></td>
                <td><%= r.total_attendance %></td>
                <td><%= r.adults_count %></td>
                <td><%= r.youth_count %></td>
                <td><%= r.children_count %></td>
                <td><%= r.first_time_visitors_count %></td>
                <td><%= r.new_members_count %></td>
                <td><%= r.volunteers_count %></td>
                <td><span class="church-status-chip church-status-chip--<%= r.status === 'submitted' ? 'verified' : 'pending' %>"><%= r.status %></span></td>
                <td><a class="church-btn church-btn--ghost church-btn--sm" href="/branch/attendance/<%= r.id %>">View</a></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
      </section>
<%- include('../partials/branch_admin_shell_end') %>
