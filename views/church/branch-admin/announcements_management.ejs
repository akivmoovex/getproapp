<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <h1 class="church-branch-topbar__title">Announcements</h1>
          <p class="church-branch-topbar__subtitle">Create and publish branch announcements</p>
        </div>
        <a class="church-btn church-btn--primary" href="/branch/announcements/new">Add announcement</a>
      </header>
      <% if (notice) { %>
      <div class="church-alert church-alert--success" role="status"><%= notice %></div>
      <% } %>
      <%- include('../partials/quota_warnings') %>
      <form class="church-form church-form--inline" method="get" action="/branch/announcements">
        <% if (statusFilter && statusFilter !== 'all') { %>
        <input type="hidden" name="status" value="<%= statusFilter %>"/>
        <% } %>
        <div class="church-field">
          <label class="church-label" for="q">Search</label>
          <input class="church-input" id="q" name="q" type="search" value="<%= searchQuery || '' %>" placeholder="Title, body, or category"/>
        </div>
        <button class="church-btn church-btn--outline" type="submit">Search</button>
      </form>
      <div class="church-branch-filter-tabs">
        <% announcementFilters.forEach(function (f) { %>
        <a class="church-branch-filter-tab <%= statusFilter === f ? 'church-branch-filter-tab--active' : '' %>" href="/branch/announcements<%= buildListQuery(f, searchQuery, 1) %>"><%= f === 'all' ? 'All' : announcementStatusLabel(f) %></a>
        <% }); %>
      </div>
      <section class="church-branch-panel">
        <p class="church-branch-panel__hint"><%= totalCount %> announcement(s) · page <%= page %> of <%= totalPages %></p>
        <% if ((announcements || []).length === 0) { %>
        <p class="church-branch-empty">No announcements in this filter.</p>
        <% } else { %>
        <div class="church-branch-table-wrap">
          <table class="church-branch-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Priority</th>
                <th>Category</th>
                <th>Audience</th>
                <th>Status</th>
                <th>Publish</th>
                <th>Expires</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% announcements.forEach(function (a) { %>
              <tr>
                <td>
                  <%= a.title %>
                  <% if (a.is_featured) { %><span class="church-status-chip">Featured</span><% } %>
                  <% if (a.is_pinned) { %><span class="church-status-chip">Pinned</span><% } %>
                </td>
                <td><%= priorityLabel(a.priority || 'normal') %></td>
                <td><%= a.category %></td>
                <td><%= audienceLabel(a.audience) %></td>
                <td><span class="church-status-chip church-status-chip--<%= a.status === 'published' ? 'verified' : 'pending' %>"><%= announcementStatusLabel(a.status) %></span></td>
                <td><%= a.publish_at ? new Date(a.publish_at).toLocaleDateString('en-GB') : '—' %></td>
                <td><%= a.expires_at ? new Date(a.expires_at).toLocaleDateString('en-GB') : '—' %></td>
                <td>
                  <a class="church-btn church-btn--ghost church-btn--sm" href="/branch/announcements/<%= a.id %>">View</a>
                  <% if (a.status !== 'archived') { %>
                  <a class="church-btn church-btn--ghost church-btn--sm" href="/branch/announcements/<%= a.id %>/edit">Edit</a>
                  <% } %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% if (totalPages > 1) { %>
        <div class="church-branch-actions">
          <% if (page > 1) { %>
          <a class="church-btn church-btn--outline church-btn--sm" href="/branch/announcements<%= buildListQuery(statusFilter, searchQuery, page - 1) %>">Previous</a>
          <% } %>
          <% if (page < totalPages) { %>
          <a class="church-btn church-btn--outline church-btn--sm" href="/branch/announcements<%= buildListQuery(statusFilter, searchQuery, page + 1) %>">Next</a>
          <% } %>
        </div>
        <% } %>
        <% } %>
      </section>
<%- include('../partials/branch_admin_shell_end') %>
