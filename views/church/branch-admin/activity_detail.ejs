<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <a class="church-branch-back" href="/branch/activity">&larr; Back to activity timeline</a>
          <h1 class="church-branch-topbar__title">Activity detail</h1>
          <p class="church-branch-topbar__subtitle">Event #<%= log.id %></p>
        </div>
      </header>
      <section class="church-branch-panel">
        <dl class="church-branch-dl">
          <div><dt>Event ID</dt><dd><%= log.id %></dd></div>
          <div><dt>Organization</dt><dd><%= log.organization_name || churchName %></dd></div>
          <div><dt>Branch</dt><dd><%= log.branch_name || churchName %></dd></div>
          <div><dt>Action</dt><dd><%= actionLabel(log.action) %></dd></div>
          <div><dt>Actor type</dt><dd><%= actorTypeLabel(log.actor_type) %></dd></div>
          <div><dt>Actor ID</dt><dd><%= log.actor_id != null ? log.actor_id : '—' %></dd></div>
          <div><dt>Actor label</dt><dd><%= actorDisplayFromRow(log) %></dd></div>
          <div><dt>Target type</dt><dd><%= targetTypeLabel(log.entity_type) %></dd></div>
          <div><dt>Target ID</dt><dd><%= log.entity_id != null ? log.entity_id : '—' %></dd></div>
          <div><dt>Target label</dt><dd><%= targetLabelFromRow(log) %></dd></div>
          <div><dt>Timestamp</dt><dd><%= new Date(log.created_at).toLocaleString('en-GB') %></dd></div>
          <% if (log.ip_address) { %><div><dt>IP address</dt><dd><%= log.ip_address %></dd></div><% } %>
          <% if (log.user_agent) { %><div><dt>User agent</dt><dd><%= log.user_agent %></dd></div><% } %>
        </dl>
        <h2 class="church-branch-panel__title">Metadata</h2>
        <pre class="church-audit-metadata"><%= metadataDisplay %></pre>
      </section>
<%- include('../partials/branch_admin_shell_end') %>
