<%- include('../partials/branch_admin_shell_start') %>
      <header class="church-branch-topbar">
        <div>
          <a class="church-branch-back" href="/branch/announcements">&larr; Back to announcements</a>
          <h1 class="church-branch-topbar__title"><%= isEdit ? 'Edit announcement' : 'New announcement' %></h1>
        </div>
      </header>
      <% if (error) { %>
      <div class="church-alert church-alert--error" role="alert"><%= error %></div>
      <% } %>
      <form class="church-form" method="post" action="<%= isEdit ? '/branch/announcements/' + announcementId : '/branch/announcements' %>" enctype="multipart/form-data" data-branch-announcement-form>
        <%- include('../partials/csrf_field') %>
        <section class="church-branch-panel">
          <div class="church-field church-field--full">
            <label class="church-label" for="title">Title</label>
            <input class="church-input" id="title" name="title" type="text" required maxlength="200" value="<%= form.title || '' %>"/>
          </div>
          <div class="church-field church-field--full">
            <label class="church-label" for="body">Body</label>
            <textarea class="church-input church-input--textarea" id="body" name="body" rows="6" required><%= form.body || '' %></textarea>
          </div>
          <div class="church-form-grid">
            <div class="church-field">
              <label class="church-label" for="category">Category</label>
              <select class="church-input" id="category" name="category">
                <% categories.forEach(function (c) { %>
                <option value="<%= c %>" <%= form.category === c ? 'selected' : '' %>><%= c %></option>
                <% }); %>
              </select>
            </div>
            <div class="church-field">
              <label class="church-label" for="priority">Priority</label>
              <select class="church-input" id="priority" name="priority">
                <% priorities.forEach(function (p) { %>
                <option value="<%= p %>" <%= form.priority === p ? 'selected' : '' %>><%= priorityLabel(p) %></option>
                <% }); %>
              </select>
            </div>
            <div class="church-field">
              <label class="church-label" for="audience">Audience</label>
              <select class="church-input" id="audience" name="audience">
                <% audiences.forEach(function (a) { %>
                <option value="<%= a %>" <%= form.audience === a ? 'selected' : '' %>><%= audienceLabel(a) %></option>
                <% }); %>
              </select>
            </div>
            <div class="church-field">
              <label class="church-label" for="publish_at">Publish at (optional)</label>
              <input class="church-input" id="publish_at" name="publish_at" type="datetime-local" value="<%= form.publish_at || '' %>"/>
            </div>
            <div class="church-field">
              <label class="church-label" for="expires_at">Expires at (optional)</label>
              <input class="church-input" id="expires_at" name="expires_at" type="datetime-local" value="<%= form.expires_at || '' %>"/>
            </div>
          </div>
          <div class="church-form-grid">
            <div class="church-field">
              <label class="church-checkbox-row">
                <input type="checkbox" name="is_pinned" value="1" <%= form.is_pinned ? 'checked' : '' %>/>
                <span>Pinned</span>
              </label>
            </div>
            <div class="church-field">
              <label class="church-checkbox-row">
                <input type="checkbox" name="is_featured" value="1" <%= form.is_featured ? 'checked' : '' %>/>
                <span>Featured</span>
              </label>
            </div>
            <div class="church-field">
              <label class="church-label" for="featured_until">Featured until (optional)</label>
              <input class="church-input" id="featured_until" name="featured_until" type="datetime-local" value="<%= form.featured_until || '' %>"/>
            </div>
          </div>
          <div class="church-form-grid">
            <div class="church-field">
              <label class="church-label" for="action_url">Action link URL (optional)</label>
              <input class="church-input" id="action_url" name="action_url" type="url" maxlength="2000" placeholder="https://" value="<%= form.action_url || '' %>"/>
            </div>
            <div class="church-field">
              <label class="church-label" for="action_label">Action link label</label>
              <input class="church-input" id="action_label" name="action_label" type="text" maxlength="200" value="<%= form.action_label || '' %>"/>
            </div>
          </div>
        </section>

        <section class="church-branch-panel" data-branch-attachments>
          <h2 class="church-branch-panel__title">Attachments</h2>
          <% if (attachmentError) { %>
          <div class="church-alert church-alert--error" role="alert" data-branch-attachment-error><%= attachmentError %></div>
          <% } %>
          <div class="church-field church-field--full">
            <label class="church-label" for="attachments">Upload files</label>
            <p class="church-branch-panel__hint">PDF, PNG, JPG, DOC, or DOCX · up to <%= maxAttachmentMb %> MB each · max <%= maxAttachments %> files</p>
            <input class="church-input" id="attachments" name="attachments" type="file" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,application/pdf,image/png,image/jpeg,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" multiple/>
          </div>
          <% if ((attachments || []).length) { %>
          <ul class="church-branch-attachment-list" data-branch-attachment-list>
            <% attachments.forEach(function (file) { %>
            <li class="church-branch-attachment-item">
              <div class="church-branch-attachment-item__meta">
                <a class="church-hq-wrap" href="/branch/announcements/<%= announcementId %>/attachments/<%= file.id %>/download"><%= file.original_filename %></a>
                <p class="church-branch-panel__hint church-hq-wrap">
                  <%= file.mime_type %> · <%= formatAttachmentBytes(file.file_size) %>
                  <% if (file.created_at) { %> · <%= new Date(file.created_at).toLocaleString('en-GB') %><% } %>
                </p>
              </div>
              <form class="church-inline-form" method="post" action="/branch/announcements/<%= announcementId %>/attachments/<%= file.id %>/delete" onsubmit="return confirm('Remove this attachment?');">
                <%- include('../partials/csrf_field') %>
                <input type="hidden" name="_return" value="edit"/>
                <button class="church-btn church-btn--ghost church-btn--sm" type="submit">Remove</button>
              </form>
            </li>
            <% }); %>
          </ul>
          <% } else { %>
          <p class="church-branch-empty" data-branch-attachments-empty>No attachments yet.</p>
          <% } %>
        </section>

        <div class="church-branch-actions">
          <button class="church-btn church-btn--outline" type="submit" name="_intent" value="draft">Save draft</button>
          <button class="church-btn church-btn--primary" type="submit" name="_intent" value="review">Review &amp; publish</button>
        </div>
      </form>
<%- include('../partials/branch_admin_shell_end') %>
