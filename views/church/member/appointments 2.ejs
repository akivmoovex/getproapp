<%- include('../partials/member_shell_start') %>
      <header class="church-member-header church-member-header--page">
        <div>
          <h1 class="church-member-header__title">Appointments</h1>
          <p class="church-member-header__subtitle">Request or cancel pastoral appointments</p>
        </div>
      </header>
      <% if (notice) { %><div class="church-alert church-alert--success"><%= notice %></div><% } %>
      <section class="church-member-panel">
        <h2>Request appointment</h2>
        <form class="church-form" method="post" action="/member/appointments/request">
          <%- include('../partials/csrf_field') %>
          <div class="church-field">
            <label class="church-label" for="minister_admin_id">Minister</label>
            <select class="church-input" id="minister_admin_id" name="minister_admin_id" required>
              <%
                var seen = {};
                (availability || []).forEach(function (a) {
                  if (!seen[a.minister_admin_id]) {
                    seen[a.minister_admin_id] = true;
              %>
              <option value="<%= a.minister_admin_id %>"><%= a.minister_name %></option>
              <% } }); %>
            </select>
          </div>
          <div class="church-field">
            <label class="church-label" for="starts_at">Preferred time</label>
            <input class="church-input" id="starts_at" name="starts_at" type="datetime-local" required/>
          </div>
          <div class="church-field">
            <label class="church-label" for="purpose">Purpose</label>
            <input class="church-input" id="purpose" name="purpose"/>
          </div>
          <button class="church-btn church-btn--primary" type="submit">Request</button>
        </form>
      </section>
      <section class="church-member-panel">
        <h2>Your appointments</h2>
        <ul class="church-list">
          <% (appointments || []).forEach(function (a) { %>
          <li>
            <%= a.minister_name %> · <%= new Date(a.starts_at).toLocaleString('en-GB') %> · <%= a.status %>
            <% if (a.status === 'requested' || a.status === 'approved') { %>
            <form class="church-form church-form--inline" method="post" action="/member/appointments/<%= a.id %>/cancel">
              <%- include('../partials/csrf_field') %>
              <button class="church-btn church-btn--ghost" type="submit">Cancel</button>
            </form>
            <% } %>
          </li>
          <% }) %>
        </ul>
      </section>
<%- include('../partials/member_shell_end') %>
