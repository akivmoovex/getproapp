<%- include('../partials/member_shell_start') %>
<%
  var filled = 0;
  var fields = ['full_name','email','phone','gender','age_group','address_area','ministry_interest','emergency_contact_name','emergency_contact_phone'];
  fields.forEach(function (f) { if (profile && profile[f]) filled += 1; });
  var completion = Math.round((filled / fields.length) * 100);
%>
      <% if (notice) { %>
      <div class="church-alert church-alert--success" role="status"><%= notice %></div>
      <% } %>
      <% if (error) { %>
      <div class="church-alert church-alert--error" role="alert"><%= error %></div>
      <% } %>

      <section class="church-member-profile-hero">
        <div class="church-member-profile-hero__avatar-wrap">
          <div class="church-member-profile-ring" style="--profile-pct: <%= completion %>">
            <img class="church-member-profile-hero__avatar" src="<%= typeof memberAvatarUrl !== 'undefined' ? memberAvatarUrl : '/church/images/member/avatar-member.jpg' %>" alt="" width="120" height="120"/>
          </div>
          <span class="church-member-profile-hero__pct"><%= completion %>%</span>
        </div>
        <div>
          <h1 class="church-member-header__title"><%= profile.full_name || memberName %></h1>
          <p class="church-member-header__subtitle">
            <span class="material-symbols-outlined" aria-hidden="true">verified</span>
            Verified member · <%= churchName %>
          </p>
          <a class="church-btn church-btn--primary church-btn--sm church-show-desktop-only" href="#profile-form">Edit Profile</a>
        </div>
      </section>

      <div class="church-member-profile-bento">
        <article class="church-member-panel church-member-panel--glass">
          <h2 class="church-member-panel__title">Contact</h2>
          <ul class="church-member-kv">
            <li><span>Email</span><strong><%= profile.email || '—' %></strong></li>
            <li><span>Phone</span><strong><%= profile.phone || '—' %></strong></li>
            <li><span>Gender</span><strong><%= profile.gender || '—' %></strong></li>
            <li><span>Age group</span><strong><%= profile.age_group || '—' %></strong></li>
          </ul>
        </article>
        <article class="church-member-panel church-member-panel--glass">
          <h2 class="church-member-panel__title">Ministry interest</h2>
          <p class="church-member-empty"><%= profile.ministry_interest || 'Not set yet' %></p>
          <a class="church-member-link" href="/member/my-ministries">View my ministries</a>
        </article>
        <article class="church-member-panel church-member-panel--glass">
          <h2 class="church-member-panel__title">Emergency contact</h2>
          <ul class="church-member-kv">
            <li><span>Name</span><strong><%= profile.emergency_contact_name || '—' %></strong></li>
            <li><span>Phone</span><strong><%= profile.emergency_contact_phone || '—' %></strong></li>
          </ul>
        </article>
        <article class="church-member-panel church-member-panel--glass">
          <h2 class="church-member-panel__title">Address area</h2>
          <p><%= profile.address_area || '—' %></p>
          <img class="church-member-profile-map" src="/church/images/member/profile-map-kafue.jpg" alt="Area map" width="640" height="320"/>
        </article>
        <% if (typeof attendanceQr !== 'undefined' && attendanceQr && attendanceQr.token) { %>
        <article class="church-member-panel church-member-panel--glass">
          <h2 class="church-member-panel__title">Service check-in QR</h2>
          <p class="church-member-empty">Show this code at the usher desk. It does not contain your member ID.</p>
          <p class="church-member-kv"><strong>Code</strong> <code><%= attendanceQr.token %></code></p>
        </article>
        <% } %>
      </div>

      <section class="church-member-panel" id="profile-form">
        <h2 class="church-member-panel__title">Update profile</h2>
        <form class="church-form" method="post" action="/member/profile">
          <%- include('../partials/csrf_field') %>
          <div class="church-form-grid">
            <div class="church-field church-field--full">
              <label class="church-label" for="full_name">Full name</label>
              <input class="church-input" id="full_name" name="full_name" type="text" required value="<%= profile.full_name || '' %>"/>
            </div>
            <div class="church-field">
              <label class="church-label" for="email">Email</label>
              <input class="church-input" id="email" name="email" type="email" required value="<%= profile.email || '' %>"/>
            </div>
            <div class="church-field">
              <label class="church-label" for="phone">Phone</label>
              <input class="church-input" id="phone" name="phone" type="tel" required value="<%= profile.phone || '' %>"/>
            </div>
            <div class="church-field">
              <label class="church-label" for="gender">Gender</label>
              <select class="church-input" id="gender" name="gender" required>
                <option value="male" <%= profile.gender === 'male' ? 'selected' : '' %>>Male</option>
                <option value="female" <%= profile.gender === 'female' ? 'selected' : '' %>>Female</option>
              </select>
            </div>
            <div class="church-field">
              <label class="church-label" for="age_group">Age group</label>
              <select class="church-input" id="age_group" name="age_group" required>
                <% ageGroupOptions.forEach(function (opt) { %>
                <option value="<%= opt %>" <%= profile.age_group === opt ? 'selected' : '' %>><%= opt %></option>
                <% }); %>
              </select>
            </div>
            <div class="church-field church-field--full">
              <label class="church-label" for="address_area">Address area</label>
              <input class="church-input" id="address_area" name="address_area" type="text" required value="<%= profile.address_area || '' %>"/>
            </div>
            <div class="church-field church-field--full">
              <label class="church-label" for="ministry_interest">Ministry interest</label>
              <input class="church-input" id="ministry_interest" name="ministry_interest" type="text" value="<%= profile.ministry_interest || '' %>"/>
            </div>
            <div class="church-field">
              <label class="church-label" for="emergency_contact_name">Emergency contact name</label>
              <input class="church-input" id="emergency_contact_name" name="emergency_contact_name" type="text" value="<%= profile.emergency_contact_name || '' %>"/>
            </div>
            <div class="church-field">
              <label class="church-label" for="emergency_contact_phone">Emergency contact phone</label>
              <input class="church-input" id="emergency_contact_phone" name="emergency_contact_phone" type="tel" value="<%= profile.emergency_contact_phone || '' %>"/>
            </div>
            <div class="church-field">
              <label class="church-label">
                <input type="checkbox" name="communication_consent" value="1" <%= profile.communication_consent !== false ? 'checked' : '' %>/>
                Allow church email communications (you can opt out anytime)
              </label>
              <p class="church-branch-panel__hint">In-app announcements may still appear. Opting out skips external email broadcasts.</p>
            </div>
          </div>
          <button class="church-btn church-btn--primary" type="submit">Save profile</button>
        </form>
        <p class="church-member-panel__hint" style="margin-top: 1rem;">
          Need to update your password?
          <a class="church-member-link" href="/member/account">Account &amp; security</a>
        </p>
      </section>
<%- include('../partials/member_shell_end') %>
