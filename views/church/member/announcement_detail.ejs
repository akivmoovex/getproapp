<%- include('../partials/member_shell_start') %>
      <header class="church-member-header church-member-header--page">
        <div>
          <a class="church-branch-back" href="/member/announcements">&larr; Back to announcements</a>
          <h1 class="church-member-header__title"><%= announcement.title %></h1>
          <p class="church-member-header__subtitle"><%= churchName %></p>
        </div>
      </header>

      <% if (typeof notice !== 'undefined' && notice) { %>
      <div class="church-alert church-alert--success" role="status"><%= notice %></div>
      <% } %>

      <section class="church-member-panel" data-member-announcement-detail data-announcement-read="<%= announcement.is_read ? '1' : '0' %>">
        <div class="church-member-list__meta" style="margin-bottom:0.75rem">
          <span class="church-status-chip"><%= announcement.source === 'hq' ? 'HQ' : 'Branch' %></span>
          <% if (announcement.is_actively_featured) { %><span class="church-status-chip" aria-label="Featured">Featured</span><% } %>
          <% if (announcement.is_pinned) { %><span class="church-status-chip" aria-label="Pinned">Pinned</span><% } %>
          <% if (announcement.is_read) { %>
          <span class="church-status-chip church-status-chip--verified" aria-label="Read" data-announcement-read-status>Read</span>
          <% } else { %>
          <span class="church-status-chip" aria-label="Unread" data-announcement-read-status>Unread</span>
          <% } %>
          <% var pm = announcement.priority_meta || priorityDisplay(announcement.priority); %>
          <span class="church-status-chip" aria-label="Priority <%= pm.label %>">
            <span class="material-symbols-outlined" aria-hidden="true" style="font-size:1rem;vertical-align:middle"><%= pm.icon %></span>
            <%= pm.label %>
          </span>
          <% if (announcement.category) { %><span class="church-status-chip"><%= announcement.category %></span><% } %>
        </div>

        <p><%= announcement.body %></p>

        <% if (!announcement.is_read) { %>
        <form
          class="church-form"
          method="post"
          action="/member/announcements/<%= announcement.source %>/<%= announcement.id %>/read"
          data-member-mark-read-form
          style="margin-top:1rem"
        >
          <%- include('../partials/csrf_field') %>
          <input type="hidden" name="return_to" value="/member/announcements/<%= announcement.source %>/<%= announcement.id %>"/>
          <button class="church-btn church-btn--outline church-btn--sm" type="submit" data-member-mark-read-button>
            Mark as read
          </button>
        </form>
        <% } %>

        <% if (announcement.action_url) { %>
        <p style="margin-top:1rem">
          <a class="church-btn church-btn--primary" href="<%= announcement.action_url %>" target="_blank" rel="noopener noreferrer">
            <%= announcement.action_label || 'Open link' %>
          </a>
        </p>
        <% } %>

        <% if ((announcement.attachments || []).length) { %>
        <div style="margin-top:1.25rem">
          <h2 class="church-member-section__title" style="font-size:1rem">Attachments</h2>
          <ul class="church-member-list">
            <% announcement.attachments.forEach(function (file) { %>
            <li>
              <a href="/member/announcements/<%= announcement.source %>/<%= announcement.id %>/attachments/<%= file.id %>/download">
                <%= file.original_filename %>
              </a>
              <span class="church-member-list__meta"><%= file.file_type_label %></span>
            </li>
            <% }); %>
          </ul>
        </div>
        <% } %>

        <p class="church-member-list__meta" style="margin-top:1rem">
          <%= announcement.publish_at ? new Date(announcement.publish_at).toLocaleString('en-GB') : '' %>
        </p>
      </section>
      <% if (!announcement.is_read) { %>
      <script>
        (function () {
          var form = document.querySelector("[data-member-mark-read-form]");
          if (!form || form.getAttribute("data-auto-submitted") === "1") return;
          // Progressive enhancement: after the member intentionally opens detail, mark read once.
          // Does not run on list rendering or link prefetch of the GET page alone beyond this open.
          form.setAttribute("data-auto-submitted", "1");
          var btn = form.querySelector("[data-member-mark-read-button]");
          if (btn) {
            btn.disabled = true;
            btn.textContent = "Marking as read…";
          }
          window.setTimeout(function () {
            if (typeof form.requestSubmit === "function") form.requestSubmit();
            else form.submit();
          }, 0);
        })();
      </script>
      <% } %>
<%- include('../partials/member_shell_end') %>
