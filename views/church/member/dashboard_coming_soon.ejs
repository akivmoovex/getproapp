<%- include('../partials/auth_shell_start') %>
  <div class="church-auth-card church-auth-card--state">
    <div class="church-state-icon" aria-hidden="true">
      <span class="material-symbols-outlined">dashboard</span>
    </div>
    <h1 class="church-auth-card__title">Member dashboard</h1>
    <p class="church-auth-card__subtitle">
      Welcome<%= typeof memberName !== 'undefined' && memberName ? ', ' + memberName : '' %> — your account is verified.
    </p>
    <p class="church-auth-card__body">
      The full member portal is coming in the next phase. Announcements, events, ministries, and resources will appear here soon.
    </p>
    <form method="post" action="/logout">
      <button class="church-btn church-btn--outline church-btn--block" type="submit">Sign out</button>
    </form>
    <p class="church-auth-card__footer">
      <a href="/">Return home</a>
    </p>
  </div>
<%- include('../partials/auth_shell_end') %>
