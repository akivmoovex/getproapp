<%- include('../partials/member_shell_start') %>
      <header class="church-member-header">
        <h1 class="church-member-header__title">Resources &amp; Study</h1>
        <p class="church-member-header__subtitle">Study notes, devotionals, and church resources</p>
      </header>
      <section class="church-member-panel">
        <% if ((resources || []).length === 0) { %>
        <div class="church-empty-state church-empty-state--compact">
          <span class="material-symbols-outlined church-empty-state__icon" aria-hidden="true">folder_open</span>
          <p class="church-empty-state__body">Study notes and devotionals will appear here when published by branch leadership.</p>
        </div>
        <% } else { %>
        <div class="church-resource-list">
          <% resources.forEach(function (item) { %>
          <article class="church-resource-row">
            <span class="church-resource-row__icon material-symbols-outlined" aria-hidden="true"><%= item.icon %></span>
            <div class="church-resource-row__body">
              <h2 class="church-resource-row__title"><%= item.title %></h2>
              <p class="church-resource-row__meta"><%= item.meta %></p>
            </div>
            <% if (item.file_url || item.external_url) { %>
            <a class="church-member-link" href="<%= item.file_url || item.external_url %>" target="_blank" rel="noopener noreferrer">Open</a>
            <% } else { %>
            <span class="church-resource-row__badge">Available</span>
            <% } %>
          </article>
          <% }); %>
        </div>
        <% } %>
      </section>
<%- include('../partials/member_shell_end') %>
