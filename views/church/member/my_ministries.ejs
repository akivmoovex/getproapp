<%- include('../partials/member_shell_start') %>
<%
  var ministryCovers = [
    '/church/images/member/ministry-worship.jpg',
    '/church/images/member/ministry-hospitality.jpg',
    '/church/images/member/ministry-bible-study.jpg',
    '/church/images/member/ministry-youth.jpg',
    '/church/images/member/ministry-children.jpg'
  ];
  var leaderAvatars = [
    '/church/images/member/avatar-leader-1.jpg',
    '/church/images/member/avatar-leader-2.jpg',
    '/church/images/member/avatar-member.jpg'
  ];
%>
      <header class="church-member-header church-member-header--page">
        <div>
          <h1 class="church-member-header__title church-show-mobile-only">My ministries</h1>
          <p class="church-member-header__subtitle">Your ministry connections at <%= churchName %></p>
        </div>
        <a class="church-btn church-btn--outline church-btn--sm" href="/member/ministries">Browse ministries</a>
      </header>
      <% if (ministryInterest) { %>
      <div class="church-alert church-alert--info" role="note">Profile ministry interest: <%= ministryInterest %></div>
      <% } %>

      <section class="church-member-section">
        <h2 class="church-member-section__title">Active ministries</h2>
        <% if ((activeMinistries || []).length === 0) { %>
        <p class="church-member-empty">No approved ministry assignments yet.</p>
        <% } else { %>
        <div class="church-member-ministry-cards">
          <% activeMinistries.forEach(function (m, i) { %>
          <article class="church-member-ministry-card">
            <div class="church-member-ministry-card__media" style="background-image:url('<%= ministryCovers[i % ministryCovers.length] %>')"></div>
            <div class="church-member-ministry-card__body">
              <div class="church-member-ministry-card__leader">
                <img src="<%= leaderAvatars[i % leaderAvatars.length] %>" alt="" width="36" height="36"/>
                <span><%= m.leader_name || 'Ministry leader' %></span>
              </div>
              <h3><%= m.name %></h3>
              <span class="church-member-ministry-tile__badge"><%= memberRelationshipStatusLabel('active') %></span>
              <% if (m.meeting_schedule || m.schedule_text) { %>
              <p class="church-member-list__meta"><%= m.meeting_schedule || m.schedule_text %></p>
              <% } %>
              <a class="church-btn church-btn--outline church-btn--sm" href="/member/ministries/<%= m.id %>">View Details</a>
            </div>
          </article>
          <% }); %>
        </div>
        <% } %>
      </section>

      <section class="church-member-panel">
        <h2 class="church-member-panel__title">Pending join requests</h2>
        <% if ((pendingRequests || []).length === 0) { %>
        <p class="church-member-empty">No pending join requests.</p>
        <% } else { %>
        <ul class="church-member-list">
          <% pendingRequests.forEach(function (r) { %>
          <li class="church-member-list__item">
            <strong><a href="/member/ministries/<%= r.ministry_id %>"><%= r.ministry_name %></a></strong>
            · <%= joinRequestStatusLabel(r.status) %>
            · <%= new Date(r.created_at).toLocaleDateString('en-GB') %>
            <% if (r.message) { %><p><%= r.message %></p><% } %>
            <% if (r.admin_comment) { %><p class="church-member-list__meta">Admin note: <%= r.admin_comment %></p><% } %>
          </li>
          <% }); %>
        </ul>
        <% } %>
      </section>

      <% if ((closedRequests || []).length > 0) { %>
      <section class="church-member-panel">
        <h2 class="church-member-panel__title">Previous requests</h2>
        <ul class="church-member-list">
          <% closedRequests.forEach(function (r) { %>
          <li class="church-member-list__item">
            <strong><a href="/member/ministries/<%= r.ministry_id %>"><%= r.ministry_name %></a></strong>
            · <%= joinRequestStatusLabel(r.status) %>
            <% if (r.admin_comment) { %> · <%= r.admin_comment %><% } %>
          </li>
          <% }); %>
        </ul>
      </section>
      <% } %>

      <% if ((interestMatches || []).length > 0) { %>
      <section class="church-member-section">
        <h2 class="church-member-section__title">Suggested by your profile interest</h2>
        <div class="church-member-ministry-cards">
          <% interestMatches.forEach(function (m, i) { %>
          <article class="church-member-ministry-card">
            <div class="church-member-ministry-card__media" style="background-image:url('<%= ministryCovers[(i + 2) % ministryCovers.length] %>')"></div>
            <div class="church-member-ministry-card__body">
              <h3><%= m.name %></h3>
              <span class="church-member-ministry-tile__badge">Suggested</span>
              <a class="church-btn church-btn--primary church-btn--sm" href="/member/ministries/<%= m.id %>">View Details</a>
            </div>
          </article>
          <% }); %>
        </div>
      </section>
      <% } %>
<%- include('../partials/member_shell_end') %>
