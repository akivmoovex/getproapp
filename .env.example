# GetPro — environment template (no secrets here)
#
# Quick start (local): copy this file to `.env` and fill in values.
#
# Two hosted environments (recommended):
#   - Development / staging on pronline.org  → see `.env.development.example`
#   - Production on getproapp.org            → see `.env.production.example`
#
# Hostinger production: set variables in the panel only (NODE_ENV=production does not load this file).
# See docs/CONFIG_AND_DEPLOYMENT.md. Local dev: copy this file to `.env` when NODE_ENV is not production.

# --- PostgreSQL (required at runtime) ---
DATABASE_URL=
GETPRO_DATABASE_URL=

# V4 → V5 migration tooling (explicit names only — never fall back to DATABASE_URL):
# V4_SOURCE_DATABASE_URL=
# V5_TARGET_DATABASE_URL=
# DATABASE_IDENTITY_EXPECTED=blessboard-platform-v5
# V4_TO_V5_OUTPUT_DIR=tmp/migration-v4-to-v5
# V4_TO_V5_CANONICAL_DOMAIN_SUFFIX=blessboard.org
# V4_TO_V5_DEPLOYMENT_CODE=blessboard-org-v5
# V4_TO_V5_DATA_ENVIRONMENT=pilot
# V4_TO_V5_BATCH_SIZE=50

# Isolated automated tests only (never point at production). See env.test.example.
# When NODE_ENV=test or GETPRO_TEST_DB=1, only TEST_DATABASE_URL is used.
# GETPRO_TEST_DB=1
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/getpro_test
# ALLOW_TEST_DB_RESET=true

GETPRO_PG_SSL=no-verify
GETPRO_PG_POOL_MAX=10
GETPRO_PG_IDLE_MS=30000
GETPRO_PG_CONNECT_TIMEOUT_MS=10000

# GETPRO_SKIP_DOTENV=0

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# No scheme; must match the site’s public apex (e.g. pronline.org vs getproapp.org)
BASE_DOMAIN=
PUBLIC_SCHEME=https

# BlessBoard deployment isolation (defaults preserve blessboard.com / V4 behaviour)
# CHURCH_HOST_DOMAIN=blessboard.com
# BLESSBOARD_CANONICAL_DOMAIN=blessboard.com
# BLESSBOARD_PUBLIC_URL=https://blessboard.com
# BLESSBOARD_ADMIN_URL=https://blessboard.com
# BLESSBOARD_APEX_DOMAINS=blessboard.com,www.blessboard.com,blessboard.org,www.blessboard.org
# BLESSBOARD_CANONICAL_REDIRECT=1
# SESSION_COOKIE_NAME=getpro_sid
# UPLOAD_ROOT=
# BLESSBOARD_MEDIA_ROOT=
# BLESSBOARD_MEDIA_FORCE_LOCAL=1
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# BLESSBOARD_MEDIA_PUBLIC_BUCKET=blessboard-public
# BLESSBOARD_MEDIA_PRIVATE_BUCKET=blessboard-private
# BLESSBOARD_JOBS_ENABLED=1
# DEPLOYMENT_ENV=production
#
# Demo tenant visibility (directory / church selector):
#   DEPLOYMENT_ENV=testing     → show catalogue demos (demo + demo2)
#   DEPLOYMENT_ENV=production  → hide demo/demo2 from directory/selector (records are not deleted)
#   unset / invalid            → safe fallback = production (demos hidden); warning logged
# NODE_ENV is not used for this gate. Explicit seed: npm run church:seed-demos
#
# --- BlessBoard.org / V5 minimal Hostinger set (authoritative deployment profile) ---
# PLATFORM_DEPLOYMENT_CODE=blessboard-org-v5
# NODE_ENV=production
# DATABASE_URL=postgres://…   # testing DB only — GETPRO_DATABASE_URL must stay unset
# SESSION_SECRET=…            # unique ≥32 chars
# # Optional: GETPRO_PG_SSL=no-verify
#
# Domains, DEPLOYMENT_ENV=testing, cookie name, jobs=off, TRUST_PROXY, HOST are derived
# from src/platform/config/deploymentProfiles.js. Do not set conflicting
# BLESSBOARD_CANONICAL_DOMAIN=blessboard.com / jobs=1 / DEPLOYMENT_ENV=production.
# Matching legacy duplicates are allowed temporarily with deprecation warnings.
# See docs/deployment/V5_ENVIRONMENT_VARIABLE_REFERENCE.md
#
# Unused (do not set): PUBLIC_URL, CANONICAL_DOMAIN, PUBLIC_SCHEMA
# CLI-only: DATABASE_IDENTITY_EXPECTED, BLESSBOARD_INITIALIZE_DB_IDENTITY, BLESSBOARD_ALLOW_TEST_USERS
# BLESSBOARD_ALLOW_TEST_USERS_IN_PRODUCTION is not honored.

TRUST_PROXY=1

SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Field agent rate limits (optional; IP-based; authed POST cap is per client IP, not per user — shared NAT/office egress uses one bucket; see docs/CONFIG_AND_DEPLOYMENT.md) ---
# GETPRO_LOGIN_RATE_WINDOW_MS=900000
# GETPRO_FIELD_AGENT_LOGIN_RATE_MAX=30
# GETPRO_FIELD_AGENT_AUTHED_POST_RATE_MAX=30

# Visible product names + tagline (required for correct deployment branding; defaults exist)
GETPRO_PRODUCT_NAME=Pro-online
GETPRO_PRODUCT_NAME_GETPRO=GetPro
# GETPRO_PUBLIC_TAGLINE=

# Which lockup line + theme tokens: getpro | proonline (optional; omit = client prefs / default Pro-online line)
# Alias: APP_BRAND (same values as GETPRO_HTML_DATA_BRAND)
# GETPRO_HTML_DATA_BRAND=
# GETPRO_EMAIL=
# GETPRO_ADDRESS=
# CALL_CENTER_PHONE=

# GETPRO_MARKETING_OPERATIONS_SLUG=zm
# SEED_BUILTIN_USERS=0
# SEED_MANAGER_USERS=0
# GETPRO_STYLES_V=
# GETPRO_USE_BUILD_ASSETS=
# GETPRO_SUPER_ADMIN_DEFAULT_TENANT_SLUG=
# DEBUG_HOST=1
# GETPRO_PG_HEALTH_ROUTE=1
# ISRAEL_COMING_SOON=true
# GETPRO_FORCE_CLIENT_COUNTRY=

# --- Admin → DB tools (seed/clear) — see src/admin/dbFixturesEnv.js ---
# pronline.org (test/demo): either NODE_ENV=development (or staging), with BASE_DOMAIN=pronline.org — tools on;
#   OR NODE_ENV=production with BOTH flags below set to 1 — tools on.
# getproapp.org (real production): NODE_ENV=production — do NOT set the two flags; tools stay off.
# GETPRO_ALLOW_DB_FIXTURES=1
# GETPRO_ALLOW_DB_FIXTURES_IN_PRODUCTION=1
